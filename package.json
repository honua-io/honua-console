{
  "name": "@honua/console",
  "version": "0.0.0",
  "private": true,
  "description": "Honua Console: unified web shell for Studio, Catalog, Operate, and Share.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "playwright test",
    "smoke:app-builder-proof": "playwright test -c tests/smoke/app-builder-proof.config.ts",
    "smoke:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@honua/sdk-js": "file:../../../honua-sdk-js",
    "@tanstack/react-query": "5.62.0",
    "maplibre-gl": "4.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "vega": "5.30.0",
    "vega-lite": "5.21.0",
    "vega-embed": "6.26.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.48.2",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
