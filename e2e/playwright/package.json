{
  "name": "@honua/console-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Thin real-browser Playwright smoke for the Honua Console Blazor Web host.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "e2e:smoke": "playwright test",
    "e2e:aws": "playwright test --config playwright.aws.config.ts",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "e2e:zero-to-map": "playwright test --config playwright.live.config.ts console-receipt-producer.live.spec.ts",
    "e2e:console-receipt": "playwright test --config playwright.receipt.config.ts",
    "e2e:console-receipt:live": "playwright test --config playwright.live.config.ts console-receipt-producer.live.spec.ts",
    "receipt:console": "node live/console-receipt-cli.mjs",
    "e2e:live-auth": "playwright test --config playwright.live-auth.config.ts",
    "e2e:live-llm": "playwright test --config playwright.live-llm.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
