# Test fixture for legacy server-auth and Studio regressions; never a release artifact.
FROM mcr.microsoft.com/dotnet/aspnet:10.0.13@sha256:d5633778c754e89a386882eddf8dbee6942447a8a4b8267c19cf1e1158d0b0ac
ARG HONUA_CONSOLE_COMMIT_SHA=unknown
LABEL org.opencontainers.image.revision=$HONUA_CONSOLE_COMMIT_SHA
WORKDIR /app
COPY --chown=app:app artifacts/legacy-console-fixture/ ./
ENV ASPNETCORE_URLS=http://+:8080 DOTNET_EnableDiagnostics=0
EXPOSE 8080
USER app
ENTRYPOINT ["dotnet", "Honua.Console.LegacyHost.dll"]
