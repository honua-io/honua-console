@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Honua.Console.Shell.Services.IConsoleHostCapabilities Host
@inject Honua.Console.Shell.Services.IConsoleCapabilityManifest Capabilities

<div class="console-shell">
    @* CSS-only collapse: the checkbox state drives the rail width + label visibility via :has(). *@
    <input type="checkbox" id="console-collapse" class="console-collapse-toggle" aria-hidden="true" />
    <aside class="console-sidebar" aria-label="Honua Console navigation">
        <div class="console-sidebar-head">
            <a class="console-brand" href="/" title="Honua Console">
                <span class="console-brand-mark">H</span>
                <span class="console-brand-label">
                    <strong>Honua Console</strong>
                    <small>Unified surface</small>
                </span>
            </a>
            <label for="console-collapse" class="console-collapse-button" title="Collapse navigation" aria-label="Toggle navigation">
                @Icon("collapse")
            </label>
        </div>

        <nav class="console-nav" aria-label="Primary">
            @* The approval inbox (#193) is the human-in-the-loop centerpiece: the GIS
               department's work queue. It is a top-level surface, not Operate-scoped. *@
            <NavLink href="/inbox" Match="NavLinkMatch.Prefix" title="Approval inbox">
                <span class="console-nav-icon">@Icon("inbox")</span>
                <span class="console-nav-label">
                    <span>Inbox</span>
                    <small>Approvals</small>
                </span>
            </NavLink>
            @foreach (var area in ConsoleRouteMap.Areas)
            {
                <NavLink href="@area.Path" Match="NavLinkMatch.Prefix" title="@area.Name">
                    <span class="console-nav-icon">@Icon(area.Name)</span>
                    <span class="console-nav-label">
                        <span>@area.Name</span>
                        <small>@area.WorkflowBoundary</small>
                    </span>
                </NavLink>
            }
        </nav>

        @if (ShowOperateNavigation)
        {
            <nav class="console-nav console-nav-secondary" aria-label="Operate sections">
                @foreach (var (path, label, icon) in VisibleOperateSections)
                {
                    <NavLink href="@path" Match="NavLinkMatch.Prefix" title="@label">
                        <span class="console-nav-icon">@Icon(icon)</span>
                        <span class="console-nav-label"><span>@label</span></span>
                    </NavLink>
                }
            </nav>
        }

        <nav class="console-nav console-nav-secondary" aria-label="Native host">
            <NavLink href="/environments" Match="NavLinkMatch.Prefix" title="Environments">
                <span class="console-nav-icon">@Icon("environments")</span>
                <span class="console-nav-label"><span>Environments</span></span>
            </NavLink>
            @* Native Stream is the gRPC streaming proof — only meaningful on a host that registers native
               transports. Hide it on the browser host (where it can only ever show "native unavailable")
               rather than leaving a nav item that dead-ends on an explainer. *@
            @if (Host.SupportsNativeTransports)
            {
                <NavLink href="/operate/native-stream" Match="NavLinkMatch.Prefix" title="Native Stream">
                    <span class="console-nav-icon">@Icon("native-stream")</span>
                    <span class="console-nav-label"><span>Native Stream</span></span>
                </NavLink>
            }
        </nav>

        <nav class="console-nav console-nav-secondary console-nav-help" aria-label="Help">
            <NavLink href="/support" Match="NavLinkMatch.Prefix" title="Contact support">
                <span class="console-nav-icon">@Icon("support")</span>
                <span class="console-nav-label"><span>Contact support</span></span>
            </NavLink>
        </nav>
    </aside>

    <main class="console-main">
        @Body
    </main>

    @* Shell-owned toast surface — rendered once so every page raises notifications through
       IConsoleNotificationService instead of inventing its own inline status. *@
    <ConsoleNotificationHost />
</div>

@code {
    private bool ShowOperateNavigation =>
        ConsoleRouteMap.IsOperateRoute(Navigation.ToBaseRelativePath(Navigation.Uri));

    // Capability-gated depth surfaces (first-release cut-line) are hidden from the Operate nav until the
    // deployment advertises the capability, so the rail never links to a surface that only renders the
    // "unsupported" state. The gated page still renders that first-class state if reached by URL.
    private IEnumerable<(string Path, string Label, string Icon)> VisibleOperateSections =>
        OperateSections.Where(section => section.Path switch
        {
            "/operate/temporal" => Capabilities.IsAdvertised(ConsoleCapabilityKeys.Temporal),
            "/operate/sync" => Capabilities.IsAdvertised(ConsoleCapabilityKeys.DisconnectedSync),
            "/operate/alerts/rules" => Capabilities.IsAdvertised(ConsoleCapabilityKeys.RealtimeAlerting),
            "/operate/releases" => Capabilities.IsAdvertised(ConsoleCapabilityKeys.CrossEnvironmentPromotion),
            _ => true,
        });

    // Operate section nav — ordered Data → Services → Monitor → Access/Admin → Deploy → AI.
    // AI (Ask Honua) is intentionally last: it is an accelerator, not the required entry point.
    // Capability-gated entries (sync, alerts/rules, releases, temporal) are hidden until the
    // connected deployment advertises the capability; ungated entries are always visible.
    private static readonly (string Path, string Label, string Icon)[] OperateSections =
    [
        // Data
        ("/operate/data", "Data & Layers", "layers"),
        ("/operate/connections", "Connections", "connections"),
        ("/operate/import/esri", "Import from Esri", "import"),
        ("/operate/publishing", "Publishing", "services"),
        ("/operate/versions", "Versions", "versions"),
        ("/operate/sync", "Sync", "sync"),                          // capability-gated: disconnected-sync
        // Services
        ("/operate/sensors", "SensorThings", "sensors"),
        ("/operate/scenes", "3D Scenes", "scenes"),
        ("/operate/geoprocessing", "Geoprocessing", "geoprocessing"),
        // Monitor
        ("/operate/observability", "Observability", "observability"),
        ("/operate/metrics", "Metrics", "metrics"),
        ("/operate/alerts/rules", "Alert Rules", "alert-rules"),    // capability-gated: realtime-alerting
        ("/operate/temporal", "Temporal", "temporal"),              // capability-gated: temporal
        // Access & Admin
        ("/operate/access", "Access", "access"),
        ("/operate/catalogs", "Catalogs", "catalogs"),
        ("/operate/settings", "Settings", "settings"),
        // Deploy
        ("/operate/deploy", "Deploy", "deploy"),
        ("/operate/releases", "Releases", "releases"),              // capability-gated: cross-environment-promotion
        // AI accelerator — always last so the manual surfaces read as the foundation
        ("/operate/ai", "Ask Honua (AI)", "studio"),
    ];

    // Minimal inline line-icon set (24x24, currentColor). Subpaths separated by '|'.
