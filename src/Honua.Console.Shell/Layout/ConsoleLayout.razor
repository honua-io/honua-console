            "observability" => "M3 12h4l3 8 4-16 3 8h4",
            "sensors" => "M12 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0|M7.8 7.8a6 6 0 0 0 0 8.4|M16.2 16.2a6 6 0 0 0 0-8.4|M5 5a9 9 0 0 0 0 14|M19 19a9 9 0 0 0 0-14",
            "scenes" => "M12 2 2 7l10 5 10-5-10-5Z|M2 17l10 5 10-5|M2 12l10 5 10-5",
            "metrics" => "M3 3v18h18|M8 16v-5|M13 16V8|M18 16v-9",
