@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject Honua.Console.Shell.Services.IConsoleCapabilityManifest Capabilities
@inject Honua.Console.Shell.Services.IConsoleProductMode ProductMode

@* Every Console route needs a descriptive document title (WCAG 2.4.2). The shell owns it rather than
   each of the ~100 pages repeating one, and names the area the operator is in so tabs and screen
   reader announcements are distinguishable: "Operate — Honua Console". *@
<PageTitle>@DocumentTitle</PageTitle>

<div class="console-shell" data-console-mode="@ModeName">
    <a class="console-skip-link" href="#console-main">Skip to content</a>
    <ConsoleTopNavigation />
    <div class="console-workspace">
        <ConsoleBreadcrumbs />
        <div class="console-workspace-panes">
    <main id="console-main" class="console-main" tabindex="-1">
        @if (!ConsolePresentation.IsFocusedRoute(Navigation.ToBaseRelativePath(Navigation.Uri)))
        {
            <p class="console-muted" role="status" data-focused-preview>
                Preview — this surface is outside the focused 2026.1 inspect, approve, operate and recover client.
            </p>
        }
        <AuthorizeView>
            <Authorized>
                <LicenseExpiryBanner />
            </Authorized>
        </AuthorizeView>
        @Body
    </main>
        <details class="console-panel console-conversation" data-agent-workspace>
            <summary>Conversation</summary>
            <p data-workspace-target>Start a conversation in your selected environment.</p>
            <p data-workspace-selection>
                <span data-workspace-selection-label>No map or object selected.</span>
                <button type="button" class="console-button console-button-secondary" data-workspace-change-selection>Change selection</button>
                <button type="button" class="console-button console-button-secondary" data-workspace-clear-selection hidden>Clear selection</button>
            </p>
            <label>Deployment target
                <select class="console-input" data-workspace-deploy-target aria-label="Deployment target">
                    <option value="">No deployment selected</option>
                </select>
            </label>
            <button type="button" class="console-button" data-workspace-start>Start conversation</button>
            <div data-workspace-messages role="log" aria-label="Workspace conversation"></div>
            <div data-workspace-executions hidden aria-label="Agent request progress" aria-live="polite"></div>
            <button type="button" class="console-button console-button-secondary" data-workspace-check-executions>Check request progress</button>
            <form>
                <section data-workspace-reply hidden aria-label="Reply to agent question">
                    <p data-workspace-reply-description></p>
                    <button type="button" class="console-button console-button-secondary" data-workspace-reply-open>Open original task</button>
                    <button type="button" class="console-button console-button-secondary" data-workspace-reply-review>Review current target</button>
                    <button type="button" class="console-button console-button-secondary" data-workspace-reply-cancel>Cancel reply</button>
                </section>
                <label>Message <textarea class="console-input" data-workspace-prompt maxlength="16000"></textarea></label>
                <p data-workspace-working role="status" hidden>Working on this turn.</p>
                <p data-workspace-partial hidden></p>
                <button class="console-button" type="submit">Send</button>
                <button type="button" class="console-button console-button-secondary" data-workspace-cancel hidden aria-describedby="workspace-cancel-note">Cancel</button>
                <p id="workspace-cancel-note" data-workspace-cancel-note hidden>Cancel stops this turn. It does not roll back a server job that already started.</p>
            </form>
            <section data-ga-spec-review hidden aria-label="Server change review">
                <p>Review a layer publication plan. Apply uses your current permissions.</p>
                <button type="button" class="console-button" data-ga-plan-current>Review layer publication</button>
                <details>
                    <summary>Open a review from another agent</summary>
                    <label>Plan ID <input class="console-input" data-ga-plan-id maxlength="128" /></label>
                    <label>Exact plan revision <input class="console-input" data-ga-plan-revision maxlength="256" /></label>
                    <button type="button" class="console-button" data-ga-plan-open>Open review</button>
                </details>
                <div data-ga-plan-summary style="white-space: pre-line"></div>
                <details>
                    <summary>Pinned context and technical details</summary>
                    <pre data-ga-plan-details></pre>
                </details>
                <button type="button" class="console-button" data-ga-plan-apply disabled>Apply server change</button>
                <button type="button" class="console-button" data-ga-plan-refresh>Check progress</button>
            </section>
            <label><input type="checkbox" checked data-workspace-follow /> Follow proposed task views</label>
            <p role="status" data-workspace-status>Start a conversation, or join an existing workspace.</p>
            <details class="console-conversation-connection">
                <summary>Join an existing workspace</summary>
                <label>Workspace ID <input class="console-input" data-workspace-id maxlength="128" /></label>
                <button type="button" class="console-button" data-workspace-connect>Connect workspace</button>
                <p class="console-muted">Use the workspace ID shared by your agent.</p>
            </details>
            <details class="console-conversation-handoff">
            <summary>Continue with an external agent</summary>
            <button type="button" class="console-button console-button-secondary" data-workspace-copy-context>Copy context for my agent</button>
            <p class="console-muted">Share this tab's context with your external agent. If you change the selected task, copy a new reference.</p>
            <pre data-workspace-context-reference hidden></pre>
            </details>
        </details>
        </div>
    </div>

    <ConsoleNotificationHost />
</div>

@code {
    private const int CapabilityRefreshTimeoutSeconds = 5;
    private CancellationTokenSource? _capabilityRefreshCancellation;
    private bool _disposed;

    protected override Task OnInitializedAsync()
    {
        Capabilities.Changed += OnCapabilitiesChanged;
        // Start fail-closed: navigation renders immediately while live capability truth is loaded.
        // A slow or unreachable server must not hold the prerendered shell behind HttpClient's long
        // default timeout.
        _capabilityRefreshCancellation = new CancellationTokenSource(
            TimeSpan.FromSeconds(CapabilityRefreshTimeoutSeconds));
        _ = RefreshCapabilitiesAsync(_capabilityRefreshCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RefreshCapabilitiesAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Capabilities.RefreshAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The initial state is deliberately fail-closed when the manifest cannot be read promptly.
            return;
        }
        catch
        {
            // Registry clients normally project failures into an unavailable snapshot. Keep the shell
            // usable and fail closed if a host-specific implementation throws before doing so.
            return;
        }

        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnCapabilitiesChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Capabilities.Changed -= OnCapabilitiesChanged;
        _disposed = true;
        _capabilityRefreshCancellation?.Cancel();
        _capabilityRefreshCancellation?.Dispose();
    }

    private const string ProductTitle = "Honua Console";

    // Area-scoped where an area owns the route, product name elsewhere (inbox, environments,
    // support, sign-in). Pages that want a more specific title can still render their own
    // <PageTitle>, which wins over the layout's.
    private string DocumentTitle =>
        ConsoleRouteMap.FindAreaForPath(Navigation.ToBaseRelativePath(Navigation.Uri)) is { } area
            ? $"{area.Name} — {ProductTitle}"
            : ProductTitle;

    private string ModeName => ProductMode.Mode.ToString().ToLowerInvariant();

}
