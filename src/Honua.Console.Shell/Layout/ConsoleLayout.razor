@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject Honua.Console.Shell.Services.IConsoleCapabilityManifest Capabilities
@inject Honua.Console.Shell.Services.IConsoleProductMode ProductMode
@inject IServiceProvider WorkspaceServices
@inject CatalogAdminOptions CatalogOptions

@* Every Console route needs a descriptive document title (WCAG 2.4.2). The shell owns it rather than
   each of the ~100 pages repeating one, and names the area the operator is in so tabs and screen
   reader announcements are distinguishable: "Operate — Honua Console". *@
<PageTitle>@DocumentTitle</PageTitle>

@{ var navigationGroups = VisibleNavigation; }

<ConsoleCommittedLocation />
<div class="console-shell" data-console-mode="@ModeName">
    <a class="console-skip-link" href="#console-main">Skip to content</a>
    <ConsoleTopNavigation Groups="navigationGroups" />
    <div class="console-service-workspace">
        <AuthorizeView><Authorized><ConsolePublicationNavigation SelectionChanged="PublicationPathChanged" /></Authorized></AuthorizeView>
    <div class="console-workspace">
        <ConsoleBreadcrumbs Groups="navigationGroups" PublicationPath="_publicationPath" />
        <div class="console-workspace-panes">
    <main id="console-main" class="console-main" tabindex="-1">
        @if (!ConsolePresentation.IsFocusedRoute(Navigation.ToBaseRelativePath(Navigation.Uri)))
        {
            <p class="console-muted" role="status" data-focused-preview>
                Preview — this surface is outside the focused 2026.1 inspect, approve, operate and recover client.
            </p>
        }
        <AuthorizeView>
            <Authorized>
                <LicenseExpiryBanner />
            </Authorized>
        </AuthorizeView>
        @Body
    </main>

        </div>
    </div>
    </div>

    <ConsoleNotificationHost />
</div>

@code {
    private IReadOnlyList<ConsoleNavigationGroup> VisibleNavigation => ConsoleNavigation.VisibleGroups(
        ProductMode, Capabilities, ConsoleNavigation.EnabledGroups(
            CatalogOptions, WorkspaceServices.GetService<Microsoft.Extensions.Configuration.IConfiguration>()));

    private const int CapabilityRefreshTimeoutSeconds = 5;
    private CancellationTokenSource? _capabilityRefreshCancellation;
    private bool _disposed;
    private AuthenticationStateProvider? _authentication;
    private int _authenticationRevision;
    private IReadOnlyList<ConsolePublicationNode> _publicationPath = [];

    private async Task PublicationPathChanged(IReadOnlyList<ConsolePublicationNode> path)
    {
        if (_disposed || _authentication is null) return;
        var revision = _authenticationRevision;
        var authentication = await _authentication.GetAuthenticationStateAsync();
        if (_disposed || revision != _authenticationRevision) return;
        _publicationPath = authentication.User.Identity?.IsAuthenticated == true ? path : [];
    }

    private void AuthenticationChanged(Task<AuthenticationState> state)
    {
        _authenticationRevision++;
        _publicationPath = [];
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    protected override Task OnInitializedAsync()
    {
        Capabilities.Changed += OnCapabilitiesChanged;
        _authentication = WorkspaceServices.GetService<AuthenticationStateProvider>();
        if (_authentication is not null) _authentication.AuthenticationStateChanged += AuthenticationChanged;
        // Start fail-closed: navigation renders immediately while live capability truth is loaded.
        // A slow or unreachable server must not hold the prerendered shell behind HttpClient's long
        // default timeout.
        _capabilityRefreshCancellation = new CancellationTokenSource(
            TimeSpan.FromSeconds(CapabilityRefreshTimeoutSeconds));
        _ = RefreshCapabilitiesAsync(_capabilityRefreshCancellation.Token);
        return Task.CompletedTask;
    }

    private async Task RefreshCapabilitiesAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Capabilities.RefreshAsync(cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The initial state is deliberately fail-closed when the manifest cannot be read promptly.
            return;
        }
        catch
        {
            // Registry clients normally project failures into an unavailable snapshot. Keep the shell
            // usable and fail closed if a host-specific implementation throws before doing so.
            return;
        }

        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnCapabilitiesChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Capabilities.Changed -= OnCapabilitiesChanged;
        if (_authentication is not null) _authentication.AuthenticationStateChanged -= AuthenticationChanged;
        _disposed = true;
        _capabilityRefreshCancellation?.Cancel();
        _capabilityRefreshCancellation?.Dispose();
    }

    private const string ProductTitle = "Honua Console";

    // Area-scoped where an area owns the route, product name elsewhere (inbox, environments,
    // support, sign-in). Pages that want a more specific title can still render their own
    // <PageTitle>, which wins over the layout's.
    private string DocumentTitle =>
        ConsoleRouteMap.FindAreaForPath(Navigation.ToBaseRelativePath(Navigation.Uri)) is { } area
            ? $"{area.Name} — {ProductTitle}"
            : ProductTitle;

    private string ModeName => ProductMode.Mode.ToString().ToLowerInvariant();

}
