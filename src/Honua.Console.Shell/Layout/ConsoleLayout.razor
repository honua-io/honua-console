@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="console-shell">
    <aside class="console-sidebar" aria-label="Honua Console navigation">
        <a class="console-brand" href="/">
            <span class="console-brand-mark">H</span>
            <span>
                <strong>Honua Console</strong>
                <small>Unified surface</small>
            </span>
        </a>

        <nav class="console-nav" aria-label="Primary">
            @foreach (var area in ConsoleRouteMap.Areas)
            {
                <NavLink href="@area.Path" Match="NavLinkMatch.Prefix">
                    <span>@area.Name</span>
                    <small>@area.WorkflowBoundary</small>
                </NavLink>
            }
        </nav>

        @if (ShowOperateNavigation)
        {
            <nav class="console-nav console-nav-secondary" aria-label="Operate sections">
                <NavLink href="/operate/connections" Match="NavLinkMatch.Prefix">Connections</NavLink>
                <NavLink href="/operate/resources" Match="NavLinkMatch.Prefix">Resources</NavLink>
                <NavLink href="/operate/services" Match="NavLinkMatch.Prefix">Services</NavLink>
                <NavLink href="/operate/layers" Match="NavLinkMatch.Prefix">Layers</NavLink>
                <NavLink href="/operate/catalogs" Match="NavLinkMatch.Prefix">Catalogs</NavLink>
                <NavLink href="/operate/settings" Match="NavLinkMatch.Prefix">Settings</NavLink>
                <NavLink href="/operate/access" Match="NavLinkMatch.Prefix">Access</NavLink>
                <NavLink href="/operate/temporal" Match="NavLinkMatch.Prefix">Temporal</NavLink>
                <NavLink href="/operate/observability" Match="NavLinkMatch.Prefix">Observability</NavLink>
                <NavLink href="/operate/metrics" Match="NavLinkMatch.Prefix">Metrics</NavLink>
            </nav>
        }

        <nav class="console-nav console-nav-secondary" aria-label="Native host">
            <NavLink href="/environments" Match="NavLinkMatch.Prefix">Environments</NavLink>
            <NavLink href="/operate/native-stream" Match="NavLinkMatch.Prefix">Native Stream</NavLink>
        </nav>

        <nav class="console-nav console-nav-secondary console-nav-help" aria-label="Help">
            <NavLink href="/support" Match="NavLinkMatch.Prefix">Contact support</NavLink>
        </nav>
    </aside>

    <main class="console-main">
        @Body
    </main>
</div>

@code {
    private bool ShowOperateNavigation =>
        ConsoleRouteMap.IsOperateRoute(Navigation.ToBaseRelativePath(Navigation.Uri));
}
