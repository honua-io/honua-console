            "share" => "M18 8a3 3 0 1 0-2.83-4M6 15a3 3 0 1 0 0-.01M18 19a3 3 0 1 0-2.83-4|M8.6 13.5l6.8 4|M15.4 6.5l-6.8 4",
            "connections" => "M9 7H7a5 5 0 0 0 0 10h2|M15 7h2a5 5 0 0 1 0 10h-2|M8 12h8",
