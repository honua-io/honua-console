@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject Honua.Console.Shell.Services.IConsoleCapabilityManifest Capabilities
@inject Honua.Console.Shell.Services.IConsoleProductMode ProductMode
@inject IServiceProvider WorkspaceServices
@inject CatalogAdminOptions CatalogOptions

@* Every Console route needs a descriptive document title (WCAG 2.4.2). The shell owns it rather than
   each of the ~100 pages repeating one, and names the area the operator is in so tabs and screen
   reader announcements are distinguishable: "Operate — Honua Console". *@
<PageTitle>@DocumentTitle</PageTitle>

@* Without a session the Console shows only the product name and the page itself (sign-in or a
   public surface): no menu, tree, breadcrumbs, inventory or admin API calls. @Body keeps one
   position in the tree, so a page is not recreated when the session becomes known. *@
@{ var navigationGroups = VisibleNavigation; }

<CascadingValue Value="_layerContext" IsFixed="true">
@if (_signedIn)
{
<ConsoleCommittedLocation />
<ConsoleAgentContextBridge />
}
<div class="console-shell" data-console-mode="@ModeName" data-console-signed-out="@(_signedIn ? null : "true")"
     data-console-v4="@(WorkspaceServices.GetService<ConsoleV4Options>()?.Enabled == true ? "true" : null)">
    <a class="console-skip-link" href="#console-main">Skip to content</a>
    @if (_signedIn)
    {
    <ConsoleTopNavigation Groups="navigationGroups" />
    }
    else
    {
    <header class="console-topbar"><span class="console-topbar-brand"><strong>@ProductTitle</strong></span><ConsoleAccountControl /></header>
    }
    <div class="console-service-workspace">
        @if (_signedIn)
        {
        <ConsolePublicationNavigation SelectionChanged="PublicationPathChanged" />
        }
    <div class="console-workspace">
        @if (_signedIn)
        {
        <ConsoleBreadcrumbs Groups="navigationGroups" PublicationPath="_publicationPath" />
        }
        <div class="console-workspace-panes">
    <main id="console-main" class="console-main" tabindex="-1">
        @if (_signedIn && !ConsolePresentation.IsFocusedRoute(Navigation.ToBaseRelativePath(Navigation.Uri)))
        {
            <p class="console-muted" role="status" data-focused-preview>
                Preview — this surface is outside the focused 2026.1 inspect, approve, operate and recover client.
            </p>
        }
        @if (_signedIn)
        {
        <LicenseExpiryBanner />
        }
        @Body
    </main>

        </div>
    </div>
    </div>

    @if (_signedIn)
    {
    <ConsoleNotificationHost />
    }
</div>

</CascadingValue>

@code {
    private readonly ConsolePublicationLayerContext _layerContext = new();
    private IConsoleEnvironmentProfileStore? _profiles;

    private void UpdatePublicationPath() =>
        _layerContext.SetPath(ConsoleNavigation.ContextForPath(Navigation.ToBaseRelativePath(Navigation.Uri), ConsoleNavigation.Groups).Path);

    private void PublicationLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        UpdatePublicationPath();
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    private void PublicationAuthorityChanged()
    {
        _layerContext.Invalidate();
        _publicationPath = [];
        StartCapabilityRefresh();
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<ConsoleNavigationGroup> VisibleNavigation => ConsoleNavigation.VisibleGroups(
        ProductMode, Capabilities, ConsoleNavigation.EnabledGroups(
            CatalogOptions, WorkspaceServices.GetService<Microsoft.Extensions.Configuration.IConfiguration>()));

    private const int CapabilityRefreshTimeoutSeconds = 5;
    private CancellationTokenSource? _capabilityRefreshCancellation;
    private bool _disposed;
    private AuthenticationStateProvider? _authentication;
    private bool _signedIn;
    private int _authenticationRevision;
    private IReadOnlyList<ConsolePublicationNode> _publicationPath = [];

    private async Task PublicationPathChanged(IReadOnlyList<ConsolePublicationNode> path)
    {
        if (_disposed || _authentication is null) return;
        var revision = _authenticationRevision;
        var authentication = await _authentication.GetAuthenticationStateAsync();
        if (_disposed || revision != _authenticationRevision) return;
        _publicationPath = authentication.User.Identity?.IsAuthenticated == true ? path : [];
    }

    private void AuthenticationChanged(Task<AuthenticationState> state)
    {
        _authenticationRevision++;
        _ = TrackSignedInAsync(state);
        PublicationAuthorityChanged();
    }

    // Fail closed: the shell stays signed out until the provider confirms a session.
    private async Task TrackSignedInAsync(Task<AuthenticationState>? state)
    {
        var revision = _authenticationRevision;
        var signedIn = false;
        try
        {
            signedIn = state is not null && (await state).User.Identity?.IsAuthenticated == true;
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or InvalidOperationException)
        {
            // An unreadable session is no session.
        }

        if (_disposed || revision != _authenticationRevision || signedIn == _signedIn) return;
        _signedIn = signedIn;
        await InvokeAsync(StateHasChanged);
    }

    protected override Task OnInitializedAsync()
    {
        UpdatePublicationPath();
        Navigation.LocationChanged += PublicationLocationChanged;
        _profiles = WorkspaceServices.GetService<IConsoleEnvironmentProfileStore>();
        if (_profiles is not null) _profiles.ActiveProfileChanged += PublicationAuthorityChanged;
        Capabilities.Changed += OnCapabilitiesChanged;
        _authentication = WorkspaceServices.GetService<AuthenticationStateProvider>();
        if (_authentication is not null) _authentication.AuthenticationStateChanged += AuthenticationChanged;
        _ = TrackSignedInAsync(_authentication?.GetAuthenticationStateAsync());
        // Start fail-closed: navigation renders immediately while live capability truth is loaded.
        // A slow or unreachable server must not hold the prerendered shell behind HttpClient's long
        // default timeout.
        StartCapabilityRefresh();
        return Task.CompletedTask;
    }

    private void StartCapabilityRefresh()
    {
        if (_disposed) return;
        _capabilityRefreshCancellation?.Cancel();
        _capabilityRefreshCancellation?.Dispose();
        _capabilityRefreshCancellation = new CancellationTokenSource();
        _ = RefreshCapabilitiesAsync(_capabilityRefreshCancellation.Token, _authentication?.GetAuthenticationStateAsync());
    }

    private async Task RefreshCapabilitiesAsync(CancellationToken cancellationToken, Task<AuthenticationState>? initialAuthentication)
    {
        using var requestCancellation = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
        try
        {
            // Restored browser credentials must be ready before the manifest request.
            if (initialAuthentication is not null) await initialAuthentication.WaitAsync(cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            requestCancellation.CancelAfter(TimeSpan.FromSeconds(CapabilityRefreshTimeoutSeconds));
            await Capabilities.RefreshAsync(requestCancellation.Token);
        }
        catch (OperationCanceledException) when (requestCancellation.IsCancellationRequested)
        {
            // The initial state is deliberately fail-closed when the manifest cannot be read promptly.
            return;
        }
        catch
        {
            // Registry clients normally project failures into an unavailable snapshot. Keep the shell
            // usable and fail closed if a host-specific implementation throws before doing so.
            return;
        }

        if (!_disposed)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnCapabilitiesChanged()
    {
        if (!_disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= PublicationLocationChanged;
        if (_profiles is not null) _profiles.ActiveProfileChanged -= PublicationAuthorityChanged;
        Capabilities.Changed -= OnCapabilitiesChanged;
        if (_authentication is not null) _authentication.AuthenticationStateChanged -= AuthenticationChanged;
        _disposed = true;
        _capabilityRefreshCancellation?.Cancel();
        _capabilityRefreshCancellation?.Dispose();
    }

    private const string ProductTitle = "Honua Console";

    // Area-scoped where an area owns the route, product name elsewhere (inbox, environments,
    // support, sign-in). Pages that want a more specific title can still render their own
    // <PageTitle>, which wins over the layout's.
    private string DocumentTitle =>
        ConsoleRouteMap.FindAreaForPath(Navigation.ToBaseRelativePath(Navigation.Uri)) is { } area
            ? $"{area.Name} — {ProductTitle}"
            : ProductTitle;

    private string ModeName => ProductMode.Mode.ToString().ToLowerInvariant();

}
