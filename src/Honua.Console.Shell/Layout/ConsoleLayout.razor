@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="console-shell">
    @* CSS-only collapse: the checkbox state drives the rail width + label visibility via :has(). *@
    <input type="checkbox" id="console-collapse" class="console-collapse-toggle" aria-hidden="true" />
    <aside class="console-sidebar" aria-label="Honua Console navigation">
        <div class="console-sidebar-head">
            <a class="console-brand" href="/" title="Honua Console">
                <span class="console-brand-mark">H</span>
                <span class="console-brand-label">
                    <strong>Honua Console</strong>
                    <small>Unified surface</small>
                </span>
            </a>
            <label for="console-collapse" class="console-collapse-button" title="Collapse navigation" aria-label="Toggle navigation">
                @Icon("collapse")
            </label>
        </div>

        <nav class="console-nav" aria-label="Primary">
            @foreach (var area in ConsoleRouteMap.Areas)
            {
                <NavLink href="@area.Path" Match="NavLinkMatch.Prefix" title="@area.Name">
                    <span class="console-nav-icon">@Icon(area.Name)</span>
                    <span class="console-nav-label">
                        <span>@area.Name</span>
                        <small>@area.WorkflowBoundary</small>
                    </span>
                </NavLink>
            }
        </nav>

        @if (ShowOperateNavigation)
        {
            <nav class="console-nav console-nav-secondary" aria-label="Operate sections">
                @foreach (var (path, label, icon) in OperateSections)
                {
                    <NavLink href="@path" Match="NavLinkMatch.Prefix" title="@label">
                        <span class="console-nav-icon">@Icon(icon)</span>
                        <span class="console-nav-label"><span>@label</span></span>
                    </NavLink>
                }
            </nav>
        }

        <nav class="console-nav console-nav-secondary" aria-label="Native host">
            <NavLink href="/environments" Match="NavLinkMatch.Prefix" title="Environments">
                <span class="console-nav-icon">@Icon("environments")</span>
                <span class="console-nav-label"><span>Environments</span></span>
            </NavLink>
            <NavLink href="/operate/native-stream" Match="NavLinkMatch.Prefix" title="Native Stream">
                <span class="console-nav-icon">@Icon("native-stream")</span>
                <span class="console-nav-label"><span>Native Stream</span></span>
            </NavLink>
        </nav>

        <nav class="console-nav console-nav-secondary console-nav-help" aria-label="Help">
            <NavLink href="/support" Match="NavLinkMatch.Prefix" title="Contact support">
                <span class="console-nav-icon">@Icon("support")</span>
                <span class="console-nav-label"><span>Contact support</span></span>
            </NavLink>
        </nav>
    </aside>

    <main class="console-main">
        @Body
    </main>
</div>

@code {
    private bool ShowOperateNavigation =>
        ConsoleRouteMap.IsOperateRoute(Navigation.ToBaseRelativePath(Navigation.Uri));

    private static readonly (string Path, string Label, string Icon)[] OperateSections =
    [
        ("/operate/connections", "Connections", "connections"),
        ("/operate/resources", "Resources", "resources"),
        ("/operate/services", "Services", "services"),
        ("/operate/layers", "Layers", "layers"),
        ("/operate/catalogs", "Catalogs", "catalogs"),
        ("/operate/settings", "Settings", "settings"),
        ("/operate/access", "Access", "access"),
        ("/operate/temporal", "Temporal", "temporal"),
        ("/operate/observability", "Observability", "observability"),
        ("/operate/metrics", "Metrics", "metrics"),
    ];

    // Minimal inline line-icon set (24x24, currentColor). Subpaths separated by '|'.
    private static MarkupString Icon(string key)
    {
        var d = key.ToLowerInvariant() switch
        {
            "studio" => "M12 20h9|M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z",
            "catalog" => "M4 4h6v6H4z|M14 4h6v6h-6z|M4 14h6v6H4z|M14 14h6v6h-6z",
            "operate" => "M4 21v-7|M4 10V3|M12 21v-9|M12 8V3|M20 21v-5|M20 12V3|M1 14h6|M9 8h6|M17 16h6",
            "share" => "M18 8a3 3 0 1 0-2.83-4M6 15a3 3 0 1 0 0-.01M18 19a3 3 0 1 0-2.83-4|M8.6 13.5l6.8 4|M15.4 6.5l-6.8 4",
            "connections" => "M9 7H7a5 5 0 0 0 0 10h2|M15 7h2a5 5 0 0 1 0 10h-2|M8 12h8",
            "resources" => "M21 8V5a9 4 0 0 0-18 0v3|M3 8a9 4 0 0 0 18 0|M3 8v5a9 4 0 0 0 18 0V8M3 13v5a9 4 0 0 0 18 0v-5",
            "services" => "M4 5h16v5H4z|M4 14h16v5H4z|M8 7.5v.01|M8 16.5v.01",
            "layers" => "M12 3 2 9l10 6 10-6-10-6Z|M2 15l10 6 10-6",
            "catalogs" => "M4 5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2Z|M8 7h7|M8 11h7",
            "settings" => "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z|M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 0 1-4 0v-.1A1.6 1.6 0 0 0 7 19.4a1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.6 1.6 0 0 0 2.6 14H2a2 2 0 0 1 0-4h.1A1.6 1.6 0 0 0 4 7a1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.6 1.6 0 0 0 9 2.6V2a2 2 0 0 1 4 0v.1A1.6 1.6 0 0 0 17 4l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.6 1.6 0 0 0 21.4 9H22a2 2 0 0 1 0 4h-.1a1.6 1.6 0 0 0-1.5 2Z",
            "access" => "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z|M9 12l2 2 4-4",
            "temporal" => "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z|M12 7v5l3 2",
            "observability" => "M3 12h4l3 8 4-16 3 8h4",
            "metrics" => "M3 3v18h18|M8 16v-5|M13 16V8|M18 16v-9",
            "environments" => "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z|M3 12h18|M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18Z",
            "native-stream" => "M5 12a9 9 0 0 1 14 0|M8.5 15a4.5 4.5 0 0 1 7 0|M12 18.5v.01",
            "support" => "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z|M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3|M12 17h.01",
            "collapse" => "M15 18l-6-6 6-6|M9 18l-6-6 6-6",
            _ => "M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0",
        };

        var paths = string.Concat(d.Split('|').Select(p => $"<path d=\"{p}\"></path>"));
        return new MarkupString(
            $"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">{paths}</svg>");
    }
}
