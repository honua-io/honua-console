@inject IServiceProvider Services
@inject NavigationManager Navigation
@implements IDisposable

@if (Services.GetService<IConsoleBrowserAuthentication>() is { } authentication)
{
    <AuthorizeView>
        <Authorized Context="account">
            @{ var identity = account.User.Identity?.Name ?? account.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "Signed in"; }
            @if (V4Enabled)
            {
                <details class="console-account-menu" open="@(_error is not null)">
                    <summary class="console-account-avatar" aria-label="Account: @identity" title="@identity">@Initials(identity)</summary>
                    <div class="console-account-items" role="group" aria-label="Account">
                        <span class="console-account-identity" title="@identity">@identity</span>
                        <button type="button" class="console-button console-button-secondary" data-console-signout disabled="@_signingOut"
                                @onclick="() => SignOutAsync(authentication)">@(_signingOut ? "Signing out…" : "Sign out")</button>
                        @if (_error is not null)
                        {
                            <span role="alert">@_error</span>
                        }
                    </div>
                </details>
            }
            else
            {
                <div class="console-account-control">
                    <span class="console-account-identity" title="@identity">@identity</span>
                    <button type="button" class="console-button" data-console-signout disabled="@_signingOut"
                            @onclick="() => SignOutAsync(authentication)">@(_signingOut ? "Signing out…" : "Sign out")</button>
                    @if (_error is not null)
                    {
                        <span role="alert">@_error</span>
                    }
                </div>
            }
        </Authorized>
        <NotAuthorized>
            @if (!OnSignInPage)
            {
                <div class="console-account-control">
                    <a class="console-button" data-console-signin href="@SignInHref">Sign in</a>
                </div>
            }
        </NotAuthorized>
    </AuthorizeView>
}

@code {
    private bool _signingOut;
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    public static string Initials(string identity)
    {
        var words = identity.Split([' ', '.', '_', '-', '@'], StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0) return "?";
        var initials = words.Length >= 2 && !identity.Contains('@', StringComparison.Ordinal)
            ? FirstLetter(words[0]) + FirstLetter(words[1])
            : FirstLetter(words[0]) + FirstLetter(words[0][FirstLetter(words[0]).Length..]);
        return initials.ToUpperInvariant();
    }

    private static string FirstLetter(string word) => word.Length == 0 ? "" : System.Globalization.StringInfo.GetNextTextElement(word);
    private string? _error;

    protected override void OnInitialized() => Navigation.LocationChanged += LocationChanged;

    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) =>
        _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= LocationChanged;

    private string CurrentRoute => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0];
    private string CurrentPath => CurrentRoute.Split('?')[0].TrimEnd('/');
    private bool OnSignInPage => string.Equals(CurrentPath, "/auth/signin", StringComparison.OrdinalIgnoreCase);
    private string SignInHref => Navigation.ToConsoleHref(CurrentRoute == "/"
        ? "/auth/signin"
        : $"/auth/signin?returnTo={Uri.EscapeDataString(CurrentRoute)}");

    private async Task SignOutAsync(IConsoleBrowserAuthentication authentication)
    {
        if (_signingOut) return;
        _signingOut = true;
        _error = null;
        try
        {
            var providerLogout = await authentication.SignOutAsync();
            Navigation.NavigateTo(providerLogout?.AbsoluteUri ?? Navigation.ToConsoleHref("/auth/signin"), forceLoad: providerLogout is not null);
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException or InvalidOperationException)
        {
            _error = "Sign-out could not finish. Check the connection and try again.";
        }
        finally
        {
            _signingOut = false;
        }
    }
}
