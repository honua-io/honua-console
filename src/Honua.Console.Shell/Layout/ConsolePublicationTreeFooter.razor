<div class="console-tree-foot">
    @if (PageFailure is not null)
    {
        <span class="console-tree-live" data-live="partial" title="@PageFailure">Incomplete</span>
        <span>@LoadedServiceCount of @ConsolePublicationTreeContext.FormatCount(ServiceCount, "service")</span>
        <span class="console-visually-hidden" role="status">@PageFailure</span>
        <button type="button" class="console-tree-foot-action" data-tree-page-retry @onclick="RetryPages">Retry</button>
    }
    else
    {
        <span class="console-tree-live" data-live="@(Live ? "true" : "false")">@(Loading ? "Loading" : Live ? "Live" : "Unavailable")</span>
        <span>@ConsolePublicationTreeContext.FormatCount(ServiceCount, "service")</span>
    }
    @if (CanRefresh)
    {
        <button type="button" class="console-tree-foot-action console-tree-refresh" title="Refresh services" aria-disabled="@(Loading ? "true" : "false")" @onclick="Refresh"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" /></svg><span class="console-visually-hidden">Refresh services</span></button>
    }
    <button type="button" class="console-tree-foot-action" data-tree-collapse-all @onclick="CollapseAll">Collapse all</button>
</div>

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool Live { get; set; }
    [Parameter] public int ServiceCount { get; set; }
    [Parameter] public int LoadedServiceCount { get; set; }
    [Parameter] public string? PageFailure { get; set; }
    [Parameter] public bool CanRefresh { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public EventCallback RetryPages { get; set; }
    [Parameter] public EventCallback CollapseAll { get; set; }
}
