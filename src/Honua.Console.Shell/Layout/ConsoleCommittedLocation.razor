@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject CatalogAdminOptions CatalogOptions

<span hidden data-console-location="@_path" data-console-authority-revision="@_authorityRevision"
      data-console-recent-scope="@_recentScope" data-console-recent-until="@_recentUntil"
      data-console-recent-label="@ConsoleNavigation.ContextForPath(_path, ConsoleNavigation.Definitions(CatalogOptions)).Label"></span>

@code {
    private string _path = "/";
    private static readonly TimeSpan RecentScopeLifetime = TimeSpan.FromMinutes(5);
    private string _requestedPath = "/";
    private string? _recentScope;
    private long? _recentUntil;
    private IConsoleAuthorityBindingValidator? _bindings;
    private int _authorityRevision;
    private int _readRevision;
    private bool _initialized;
    private bool _disposed;
    private ConsoleEnvironmentAuthority? _authority;
    private IConsoleEnvironmentProfileStore? _profiles;
    private ConsoleEnvironmentSubscription? _environment;
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationToken _readToken;

    protected override async Task OnInitializedAsync()
    {
        _readToken = _lifetime.Token;
        _path = _requestedPath = new Uri(Navigation.Uri).AbsolutePath;
        _bindings = Services.GetService<IConsoleAuthorityBindingValidator>();
        _profiles = Services.GetService<IConsoleEnvironmentProfileStore>();
        Navigation.LocationChanged += OnLocationChanged;
        _environment = new ConsoleEnvironmentSubscription(_profiles,
            Services.GetService<AuthenticationStateProvider>(), QueueRead);
        await CheckAuthorityAsync(Interlocked.Increment(ref _readRevision));
    }

    private async Task CheckAuthorityAsync(int revision)
    {
        if (_disposed) return;
        _recentScope = null;
        _recentUntil = null;
        await InvokeAsync(StateHasChanged);
        var profile = await ConsoleReadBudget.RunAsync(ReadProfileAsync, ConsoleReadBudget.Default,
            "The active environment could not be read.", _readToken);
        if (_disposed || revision != _readRevision) return;
        _path = _requestedPath;
        var authority = profile.IsAllowed ? ConsoleEnvironmentAuthority.From(profile.Value) : null;
        if (_initialized && authority != _authority) _authorityRevision++;
        _initialized = true;
        _authority = authority;
        await InvokeAsync(StateHasChanged);
        if (_disposed || !profile.IsAllowed || profile.Value is null || _bindings is null) return;
        var scope = await ConsoleReadBudget.RunAsync(ReadRecentScopeAsync, ConsoleReadBudget.Default,
            "Recent visits could not be bound to the current operator.", _readToken);
        if (_disposed || revision != _readRevision) return;
        _recentScope = scope.IsAllowed ? scope.Value : null;
        if (_recentScope is not null) _recentUntil = DateTimeOffset.UtcNow.Add(RecentScopeLifetime).ToUnixTimeMilliseconds();
        await InvokeAsync(StateHasChanged);
    }

    private async Task<OperateSectionResult<ConsoleEnvironmentProfile?>> ReadProfileAsync(CancellationToken token) =>
        OperateSectionResult<ConsoleEnvironmentProfile?>.Allowed(
            _profiles is null ? null : await _profiles.GetActiveProfileAsync(token));

    private async Task<OperateSectionResult<string?>> ReadRecentScopeAsync(CancellationToken token)
    {
        var scope = await _bindings!.CaptureAsync(token);
        if (scope is not null && !await _bindings.IsCurrentAsync(scope, token)) scope = null;
        return OperateSectionResult<string?>.Allowed(scope);
    }

    private void QueueRead()
    {
        if (_disposed) return;
        var revision = Interlocked.Increment(ref _readRevision);
        _ = InvokeAsync(() => CheckAuthorityAsync(revision));
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        var path = new Uri(args.Location).AbsolutePath;
        if (_disposed || path == _requestedPath) return;
        _requestedPath = path;
        QueueRead();
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
        _environment?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
