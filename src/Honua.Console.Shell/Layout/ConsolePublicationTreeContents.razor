@inject NavigationManager Navigation

<div class="console-tree-branches">
    <ul role="tree" aria-label="Services and layers" class="console-publication-tree" data-publication-tree>
        <ConsolePublicationTreeItem Node="View.Tree.Root" />
    </ul>
    <ConsolePublicationTreePaging />
    @if (!string.IsNullOrWhiteSpace(View.Tree.Filter) && View.Tree.MatchingChildren(View.Tree.Root).Count == 0)
    {
        <p class="console-tree-message" role="status">No services match this filter.</p>
    }
    else if (View.Tree.ServiceCount == 0)
    {
        <p class="console-tree-message" role="status">No services returned by this server. <a href="@Navigation.ToConsoleHref("/operate/data/new")">Add data</a></p>
    }
</div>
<p class="console-tree-coverage" role="status">@($"Filtering {ConsolePublicationTreeContext.FormatCount(View.Tree.ServiceCount, "service name")} and {ConsolePublicationTreeContext.FormatCount(View.Tree.LayerTotal, "layer")}.") Expand a service to load its layers.</p>

@code {
    [CascadingParameter] public ConsolePublicationTreeContext View { get; set; } = default!;
}
