<section data-ga-spec-review hidden aria-label="Server change review">
    <p>Review a layer publication plan. Apply uses your current permissions.</p>
    <button type="button" class="console-button" data-ga-plan-current>Review layer publication</button>
    <details>
        <summary>Open a review from another agent</summary>
        <label>Plan ID <input class="console-input" data-ga-plan-id maxlength="128" /></label>
        <label>Exact plan revision <input class="console-input" data-ga-plan-revision maxlength="256" /></label>
        <button type="button" class="console-button" data-ga-plan-open>Open review</button>
    </details>
    <div data-ga-plan-summary style="white-space: pre-line"></div>
    <details>
        <summary>Pinned context and technical details</summary>
        <pre data-ga-plan-details></pre>
    </details>
    <button type="button" class="console-button" data-ga-plan-apply disabled>Apply server change</button>
    <button type="button" class="console-button" data-ga-plan-refresh>Check progress</button>
</section>
