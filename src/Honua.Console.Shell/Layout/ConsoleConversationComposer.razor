<form>
    <section data-workspace-reply hidden aria-label="Reply to agent question">
        <p data-workspace-reply-description></p>
        <button type="button" class="console-button console-button-secondary" data-workspace-reply-open>Open original task</button>
        <button type="button" class="console-button console-button-secondary" data-workspace-reply-review>Review current target</button>
        <button type="button" class="console-button console-button-secondary" data-workspace-reply-cancel>Cancel reply</button>
    </section>
    <label>Message <textarea class="console-input" data-workspace-prompt maxlength="16000"></textarea></label>
    <p data-workspace-working role="status" hidden>Working on this turn.</p>
    <p data-workspace-partial hidden></p>
    <button class="console-button" type="submit">Send</button>
    <button type="button" class="console-button console-button-secondary" data-workspace-cancel hidden aria-describedby="workspace-cancel-note">Cancel</button>
    <p id="workspace-cancel-note" data-workspace-cancel-note hidden>Cancel stops this turn. It does not roll back a server job that already started.</p>
</form>
