@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager Navigation

<CascadingValue Value="TreeContext">
    <div class="console-publication-navigation" data-publication-navigation data-tree-revision="@_locationRevision">
        <button type="button" class="console-publication-toggle console-button console-button-secondary" data-tree-toggle
                aria-expanded="false" aria-controls="console-publication-sidebar">Browse services</button>
        <button type="button" class="console-tree-backdrop" data-tree-backdrop hidden tabindex="-1" aria-label="Close service navigation"></button>
        <aside id="console-publication-sidebar" class="console-publication-sidebar" aria-label="Service navigation">
            <div class="console-tree-toolbar">
                <label for="console-tree-filter">Filter services</label>
                <input id="console-tree-filter" class="console-input" type="search" value="@_tree.Filter"
                       @oninput="FilterChanged" disabled="@(_loading || Source is UnsupportedConsolePublicationNavigationSource)" data-tree-filter />
                @if (Source is not UnsupportedConsolePublicationNavigationSource)
                {
                    <button type="button" class="console-button console-button-secondary" aria-disabled="@(_loading ? "true" : "false")" @onclick="RefreshAsync">Refresh services</button>
                }
                <button type="button" class="console-tree-close" data-tree-close aria-label="Close service navigation">Close</button>
            </div>
            <ConsolePublicationNavigationContent ReadState="ReadState" />
        </aside>
    </div>
</CascadingValue>

@code {
    [Parameter] public EventCallback<IReadOnlyList<ConsolePublicationNode>> SelectionChanged { get; set; }
    private IReadOnlyList<ConsolePublicationNode>? _reportedPath;
    private const int ConcurrentServiceExpansions = 4;
    private readonly SemaphoreSlim _serviceExpansionSlots = new(ConcurrentServiceExpansions);
    private readonly ConsolePublicationTree _tree = new();
    private CancellationTokenSource _authorityLifetime = new();
    private OperateSectionResult<HonuaAdminServicePage>? _servicesRead;
    private Task<OperateSectionResult<IReadOnlyList<string>>>? _connectionsRead;
    private ConsoleEnvironmentAuthority? _authority;
    private string _environmentLabel = "Services";
    private int _authorityRevision;
    private int _locationRevision;
    private bool _loading = true;
    private int _catalogGeneration;
    private CatalogAttempt? _inflight;
    private CatalogAttempt? _settled;
    private CatalogAttempt? _failed;
    private bool _disposed;
    private IConsoleCapabilityManifest? _capabilities;
    private IConsolePublicationNavigationSource Source => Services.GetService<IConsolePublicationNavigationSource>()
        ?? new UnsupportedConsolePublicationNavigationSource();
    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
    private string SelectedPath
    {
        get
        {
            var path = CurrentPath;
            return _tree.PathTo(path).Count > 0 ? path : "";
        }
    }
    private ConsolePublicationTreeContext TreeContext => new()
    {
        Tree = _tree, SelectedPath = SelectedPath,
        Expand = EventCallback.Factory.Create<ConsolePublicationNode>(this, ExpandAsync),
        Collapse = EventCallback.Factory.Create<ConsolePublicationNode>(this, Collapse),
        Retry = EventCallback.Factory.Create<ConsolePublicationNode>(this, LoadChildrenAsync),
        ShowFirstPage = EventCallback.Factory.Create<ConsolePublicationNode>(this, ShowFirstPage),
        ShowMore = EventCallback.Factory.Create<ConsolePublicationNode>(this, ShowMore)
    };
    private ConsolePublicationNavigationReadState ReadState => new()
    {
        Loading = _loading, ServicesRead = _servicesRead,
        CanConnectEnvironment = Source is UnsupportedConsolePublicationNavigationSource,
        Retry = EventCallback.Factory.Create(this, RetryCatalogAsync)
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += LocationChanged;
        _capabilities = Services.GetService<IConsoleCapabilityManifest>();
        if (_capabilities is not null) _capabilities.Changed += CapabilitiesChanged;
        if (Services.GetService<AuthenticationStateProvider>() is { } authentication)
            authentication.AuthenticationStateChanged += AuthenticationChanged;
        _ = CheckAuthorityAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || !SelectionChanged.HasDelegate) return;
        var contextPath = ConsoleNavigation.ContextForPath(CurrentPath.Trim('/'), ConsoleNavigation.Groups).Path;
        IReadOnlyList<ConsolePublicationNode> ancestors = !_loading && _servicesRead is { IsAllowed: true, Value: not null }
            ? _tree.PathTo(contextPath) : [];
        if (_reportedPath is not null && _reportedPath.SequenceEqual(ancestors)) return;
        _reportedPath = ancestors;
        await SelectionChanged.InvokeAsync(ancestors);
    }

    private async Task CheckAuthorityAsync()
    {
        if (_disposed) return;
        var revision = _authorityRevision;
        var profileRead = await ConsoleReadBudget.RunAsync(ReadProfileAsync, ConsoleReadBudget.Default,
            "The active environment could not be read.", _authorityLifetime.Token);
        if (_disposed || revision != _authorityRevision) return;
        if (!profileRead.IsAllowed)
        {
            RecordAuthorityFailure(revision);
            _servicesRead = OperateSectionResult<HonuaAdminServicePage>.Denied(profileRead.Status, profileRead.Message);
            _loading = false;
            await InvokeAsync(StateHasChanged);
            return;
        }
        var profile = profileRead.Value;
        var authority = ConsoleEnvironmentAuthority.From(profile);
        _environmentLabel = string.IsNullOrWhiteSpace(profile?.DisplayName) ? "Services" : profile.DisplayName;
        if (_authority != authority)
        {
            _authority = authority;
            await ReloadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        if (_disposed) return;
        ResetReadState();
        var authorityRevision = _authorityRevision;
        await InvokeAsync(StateHasChanged);
        var attempt = BeginCatalog(HonuaAdminCatalogQuery.First, CatalogApply.Replace);
        var outcome = await FinishCatalogAsync(attempt);
        if (_disposed || authorityRevision != _authorityRevision || outcome == CatalogOutcome.Obsolete) return;
        if (outcome == CatalogOutcome.Applied) _tree.RevealPath(CurrentPath);
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private CatalogAttempt BeginCatalog(HonuaAdminCatalogQuery query, CatalogApply apply)
    {
        var attempt = new CatalogAttempt(++_catalogGeneration, query, apply, _filterRevision, _authorityRevision);
        _inflight = attempt;
        return attempt;
    }

    private bool IsCurrent(CatalogAttempt attempt) =>
        !_disposed && _inflight == attempt
        && attempt.AuthorityRevision == _authorityRevision
        && attempt.FilterRevision == _filterRevision;

    private async Task<CatalogOutcome> FinishCatalogAsync(CatalogAttempt attempt)
    {
        var result = await ConsoleReadBudget.RunAsync(
            token => Source.ReadServicesAsync(attempt.Query, token), ConsoleReadBudget.Default,
            "Service navigation is unavailable. Retry when the server is reachable.", _authorityLifetime.Token);
        if (!IsCurrent(attempt)) return CatalogOutcome.Obsolete;
        _inflight = null;
        _servicesRead = result;
        if (!result.IsAllowed || result.Value is null)
        {
            _failed = attempt;
            return CatalogOutcome.Failed;
        }

        _failed = null;
        _settled = attempt;
        if (attempt.Apply == CatalogApply.Append) _tree.Append(result.Value);
        else _tree.Load(result.Value, _environmentLabel);
        return CatalogOutcome.Applied;
    }

    private void RecordAuthorityFailure(int revision)
    {
        _inflight = null;
        _failed = new CatalogAttempt(++_catalogGeneration, HonuaAdminCatalogQuery.First, CatalogApply.Authority, _filterRevision, revision);
    }

    private async Task RetryCatalogAsync()
    {
        if (_disposed || _loading || _inflight is not null || _failed is not { } failed) return;
        if (failed.FilterRevision != _filterRevision || failed.AuthorityRevision != _authorityRevision) return;
        if (failed.Apply == CatalogApply.Authority)
        {
            await ReloadAuthorityAsync();
            return;
        }
        var attempt = BeginCatalog(failed.Query, failed.Apply);
        var outcome = await FinishCatalogAsync(attempt);
        if (outcome == CatalogOutcome.Obsolete) return;
        if (outcome == CatalogOutcome.Applied && attempt.Apply == CatalogApply.Replace)
        {
            if (!string.IsNullOrWhiteSpace(attempt.Query.NameQuery))
                _tree.SetFilter(attempt.Query.NameQuery);
            _tree.RevealPath(CurrentPath);
        }
        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private enum CatalogApply { Replace, Append, Authority }

    private enum CatalogOutcome { Obsolete, Failed, Applied }

    private readonly record struct CatalogAttempt(
        int Generation, HonuaAdminCatalogQuery Query, CatalogApply Apply, int FilterRevision, int AuthorityRevision);

    private async Task<OperateSectionResult<ConsoleEnvironmentProfile?>> ReadProfileAsync(CancellationToken token)
    {
        var profiles = Services.GetService<IConsoleEnvironmentProfileStore>();
        var profile = profiles is null ? null : await profiles.GetActiveProfileAsync(token);
        return OperateSectionResult<ConsoleEnvironmentProfile?>.Allowed(profile);
    }

    private void ResetReadState()
    {
        _authorityRevision++;
        _authorityLifetime.Cancel();
        _authorityLifetime.Dispose();
        _authorityLifetime = new();
        _connectionsRead = null;
        _tree.Load(new HonuaAdminServicePage(), _environmentLabel);
        _tree.SetFilter("");
        _servicesRead = null;
        _loading = true;
    }

    private Task RefreshAsync() => _loading ? Task.CompletedTask : ReloadAuthorityAsync();

    private async Task ReloadAuthorityAsync()
    {
        if (_disposed) return;
        _authority = null;
        ResetReadState();
        await InvokeAsync(StateHasChanged);
        await CheckAuthorityAsync();
    }

    private async Task ExpandAsync(ConsolePublicationNode node)
    {
        node.Expanded = true;
        if (node.Kind == ConsolePublicationNodeKind.Service && !node.ChildrenLoaded && !node.Loading)
            await LoadChildrenAsync(node);
    }

    private static void Collapse(ConsolePublicationNode node) => node.Expanded = false;

    private async Task LoadChildrenAsync(ConsolePublicationNode node)
    {
        if (_disposed || node.ServiceName is not { } serviceName || node.Loading) return;
        var revision = _authorityRevision;
        var token = _authorityLifetime.Token;
        node.Loading = true;
        node.ReadStatus = null;
        node.ReadMessage = null;
        await InvokeAsync(StateHasChanged);
        _connectionsRead ??= ConsoleReadBudget.RunAsync(Source.ReadConnectionsAsync, ConsoleReadBudget.Default,
            "Connections could not be read.", token);
        var connections = await _connectionsRead;
        if (_disposed || revision != _authorityRevision) return;
        var result = connections.IsAllowed
            ? await ConsoleReadBudget.RunAsync(readToken => ReadServiceLayersAsync(serviceName, connections.Value ?? [], readToken),
                ConsoleReadBudget.Default, "Layers could not be read. Retry this service.", token)
            : OperateSectionResult<IReadOnlyList<ConsolePublicationLayer>>.Denied(connections.Status, connections.Message);
        if (_disposed || revision != _authorityRevision) return;
        if (!result.IsAllowed || result.PartialResult) _connectionsRead = null;
        CompleteChildren(node, result);
        await InvokeAsync(StateHasChanged);
    }

    private async Task<OperateSectionResult<IReadOnlyList<ConsolePublicationLayer>>> ReadServiceLayersAsync(
        string serviceName, IReadOnlyList<string> connections, CancellationToken token)
    {
        await _serviceExpansionSlots.WaitAsync(token);
        try { return await Source.ReadLayersAsync(serviceName, connections, token); }
        finally { _serviceExpansionSlots.Release(); }
    }

    private static void CompleteChildren(ConsolePublicationNode node, OperateSectionResult<IReadOnlyList<ConsolePublicationLayer>> result)
    {
        node.Loading = false;
        node.ChildrenLoaded = result.IsAllowed;
        node.ReadStatus = result.IsAllowed ? null : result.Status;
        node.ReadMessage = string.IsNullOrEmpty(result.Message) ? null : result.Message;
        node.Children = (result.Value ?? []).Select(layer => new ConsolePublicationNode
        {
            Key = node.Key + ":layer:" + layer.ResourceId, Label = layer.Name, Kind = ConsolePublicationNodeKind.Layer,
            GeometryType = layer.GeometryType, Href = $"/operate/layers/{Uri.EscapeDataString(layer.ResourceId)}"
        }).ToList();
    }

    private int _filterRevision;

    private async Task FilterChanged(ChangeEventArgs args)
    {
        var filter = args.Value?.ToString() ?? "";
        var revision = _authorityRevision;
        var filterRevision = ++_filterRevision;
        _tree.SetFilter(filter);
        var nameQuery = string.IsNullOrWhiteSpace(filter) ? null : filter.Trim();
        if (_disposed || revision != _authorityRevision || filterRevision != _filterRevision) return;
        var attempt = BeginCatalog(HonuaAdminCatalogQuery.First with { NameQuery = nameQuery }, CatalogApply.Replace);
        var outcome = await FinishCatalogAsync(attempt);
        if (outcome == CatalogOutcome.Obsolete) return;
        if (outcome == CatalogOutcome.Applied)
        {
            _tree.SetFilter(filter);
            _tree.RevealPath(CurrentPath);
        }
        await InvokeAsync(StateHasChanged);
    }
    private void ShowFirstPage(ConsolePublicationNode node) => _tree.ShowFirstPage(node);
    private async Task ShowMore(ConsolePublicationNode node)
    {
        if (_inflight is not null || _settled is not { } settled
            || settled.FilterRevision != _filterRevision
            || settled.AuthorityRevision != _authorityRevision)
            return;
        if (!_tree.HasHiddenLoadedChildren(node) && _tree.HasUnloadedServices)
        {
            var attempt = BeginCatalog(settled.Query.Next(), CatalogApply.Append);
            var outcome = await FinishCatalogAsync(attempt);
            if (outcome != CatalogOutcome.Applied)
            {
                if (outcome != CatalogOutcome.Obsolete) await InvokeAsync(StateHasChanged);
                return;
            }
        }
        _tree.ShowMore(node);
        await InvokeAsync(StateHasChanged);
    }
    private async Task ReconcileLocationAsync()
    {
        await CheckAuthorityAsync();
        if (_disposed) return;
        _tree.RevealPath(CurrentPath);
        await InvokeAsync(StateHasChanged);
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _locationRevision++;
        _ = InvokeAsync(ReconcileLocationAsync);
    }
    private void CapabilitiesChanged() => _ = InvokeAsync(CheckAuthorityAsync);
    private void AuthenticationChanged(Task<AuthenticationState> state) => _ = InvokeAsync(ReloadAuthorityAsync);

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= LocationChanged;
        if (_capabilities is not null) _capabilities.Changed -= CapabilitiesChanged;
        if (Services.GetService<AuthenticationStateProvider>() is { } authentication)
            authentication.AuthenticationStateChanged -= AuthenticationChanged;
        _authorityLifetime.Cancel();
        _authorityLifetime.Dispose();
    }
}
