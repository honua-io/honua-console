@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager Navigation

@if (_count is { } count)
{
    <span class="console-approval-count" data-count="@count" aria-label="@($"{count} awaiting approval{(_partial ? "; partial queue" : "")}")">@count@(_partial ? "+" : "")</span>
}

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private ConsoleProposalSubscription? _updates;
    private ConsoleEnvironmentSubscription? _environment;
    private AuthenticationStateProvider? _authentication;
    private int? _count;
    private bool _partial;
    private int _readRevision;
    private bool _disposed;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _authentication = Services.GetService<AuthenticationStateProvider>();
        _environment = new ConsoleEnvironmentSubscription(Services.GetService<IConsoleEnvironmentProfileStore>(),
            _authentication, OnAuthorityChanged);
        _updates = new ConsoleProposalSubscription(Services.GetService<IConsoleProposalRealtimeClient>(),
            new ConsoleProposalObservers(OnProposalChanged, _ => { }, OnRefreshRequiredAsync));
        _ = _updates.StartAsync(_lifetime.Token);
        _ = RefreshAndRenderAsync();
    }

    private async Task RefreshAndRenderAsync()
    {
        await RefreshAsync();
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    private async Task<bool> RefreshAsync()
    {
        if (_disposed) return false;
        var revision = ++_readRevision;
        _count = null;
        var token = _lifetime.Token;
        if (_authentication is not null)
        {
            AuthenticationState authentication;
            try
            {
                authentication = await (_environment?.AuthenticationState ?? _authentication.GetAuthenticationStateAsync()).WaitAsync(token);
            }
            catch (OperationCanceledException) when (token.IsCancellationRequested)
            {
                return false;
            }
            if (_disposed || revision != _readRevision || authentication.User.Identity?.IsAuthenticated != true) return false;
        }
        var inbox = Services.GetService<IConsoleApprovalInboxClient>();
        if (inbox is null) return false;
        var result = await ConsoleReadBudget.RunAsync(
            cancellation => inbox.GetInboxAsync(cancellationToken: cancellation), ConsoleReadBudget.Default,
            "The approval count is unavailable.", token);
        if (_disposed || revision != _readRevision) return false;
        if (result.IsAllowed && result.Value is { } snapshot)
        {
            _count = snapshot.AwaitingApprovalCount;
            _partial = result.PartialResult;
            return !result.PartialResult;
        }
        return false;
    }

    private Task OnRefreshRequiredAsync() => _disposed ? Task.CompletedTask : InvokeAsync(async () =>
    {
        var refresh = RefreshAsync();
        StateHasChanged();
        var reconciled = await refresh;
        if (!_disposed) StateHasChanged();
        if (!reconciled) throw new IOException("The approval count could not be reconciled.");
    });
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => QueueRefresh();
    private void OnProposalChanged(ConsoleProposalEvent proposal) => QueueRefresh();
    private void OnAuthorityChanged()
    {
        if (_disposed) return;
        // Invalidate before dispatching, so an earlier read cannot commit for the previous authority.
        _readRevision++;
        QueueRefresh();
    }
    private void QueueRefresh()
    {
        if (!_disposed) _ = InvokeAsync(async () =>
        {
            var refresh = RefreshAndRenderAsync();
            StateHasChanged();
            await refresh;
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
        _environment?.Dispose();
        _updates?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
