@inject IServiceProvider Services

<header class="console-topbar">
    <a class="console-topbar-brand" href="/">@if (!V4Enabled) { <span>H</span> }<strong>Honua Console</strong></a>
    <button type="button" class="console-menu-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="console-primary" data-navigation-toggle>
        <svg viewBox="0 0 24 24" width="@(V4Enabled ? 16 : 20)" height="@(V4Enabled ? 16 : 20)" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
    </button>
    <nav id="console-primary" class="console-topnav" aria-label="Primary">
        <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
        @foreach (var group in Groups)
        {
            <details class="console-navigation-menu" data-navigation-menu="@group.Name">
                <summary>@group.Name@if (group.Name == "Operate") { <ConsoleApprovalCount /> }</summary>
                <div class="console-navigation-items" role="group" aria-label="@group.Name">
                    @foreach (var entry in group.Destinations)
                    {
                        <NavLink href="@entry.Path" Match="NavLinkMatch.All">
                            @entry.Label
                            @if (entry.Path is not ("/studio" or "/studio/processes") && !ConsolePresentation.IsFocusedRoute(entry.Path)) { <small>Preview</small> }
                        </NavLink>
                    }
                </div>
            </details>
        }
    </nav>
    <a class="console-environment-link" href="/environments" data-workspace-header-target>Choose an environment</a>
    <button type="button" class="console-conversation-toggle" data-conversation-toggle aria-controls="console-conversation-drawer" aria-expanded="false" aria-label="@(V4Enabled ? "Conversation" : null)">
        @if (V4Enabled)
        {
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5H4l-3 2V11.5a10 10 0 0 1 20 0Z" /></svg>
        }
        else
        {
            <text>Conversation</text>
        }
    </button>
    <a class="console-help-link" href="/support" aria-label="@(V4Enabled ? "Help" : null)">
        @if (V4Enabled)
        {
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M9 9a3 3 0 0 1 6 0c0 2-3 2-3 4m0 3v1" /></svg>
        }
        else
        {
            <text>Help</text>
        }
    </a>
</header>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    [Parameter] public IReadOnlyList<ConsoleNavigationGroup> Groups { get; set; } = [];
}
