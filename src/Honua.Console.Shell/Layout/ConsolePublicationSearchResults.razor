@{
    var folders = Folders;
    var services = Services;
    var layers = View.LayerSearch?.Value ?? [];
}

<div class="console-tree-branches console-search-results" data-publication-search>
    <section aria-labelledby="console-search-folders">
        <h3 id="console-search-folders">Folders <span>(@FolderMatchCount)</span></h3>
        @if (folders.Count == 0)
        {
            <p class="console-search-empty">No Folders match.</p>
        }
        else
        {
            <ul role="tree" aria-labelledby="console-search-folders" class="console-publication-tree" data-publication-tree>
                @for (var index = 0; index < folders.Count; index++)
                {
                    var folder = folders[index];
                    <ConsoleSearchResultRow @key="folder.Key" Key="@folder.Key" Href="@(folder.Href!)" Icon="folder" Label="@View.Label(folder)"
                                            Path="@FolderPath(folder)" Position="index + 1" SetSize="folders.Count" />
                }
            </ul>
            @if (FolderMatchCount > folders.Count)
            {
                <p class="console-search-empty" role="status">Showing @folders.Count of @FolderMatchCount Folders. Search with more of the name to narrow the list.</p>
            }
        }
    </section>
    <section aria-labelledby="console-search-services">
        <h3 id="console-search-services">Services @if (!View.SearchPending) { <span>(@View.Tree.SearchMatchCount)</span> }</h3>
        @if (View.SearchPending)
        {
            <p class="console-search-empty" role="status">Searching…</p>
        }
        else if (services.Count == 0)
        {
            <p class="console-search-empty" role="status">No services match this search.</p>
        }
        else
        {
            <ul role="tree" aria-labelledby="console-search-services" class="console-publication-tree" data-publication-tree>
                @for (var index = 0; index < services.Count; index++)
                {
                    var service = services[index];
                    <ConsoleSearchResultRow @key="service.Key" Key="@service.Key" Href="@(service.Href!)" Icon="service" Label="@service.Label"
                                            Path="@ServicePath(service)" Position="index + 1" SetSize="View.Tree.SearchMatchCount" />
                }
            </ul>
        }
        @if (!View.SearchPending && View.Tree.HasMoreSearchResults)
        {
            <button type="button" class="console-tree-foot-action" data-search-more @onclick="View.ShowMoreSearch">Show more services</button>
        }
    </section>
    <section aria-labelledby="console-search-layers">
        <h3 id="console-search-layers">Layers @if (View.LayerSearch is { IsAllowed: true }) { <span>(@layers.Count)</span> }</h3>
        @if (View.LayerSearch is null)
        {
            <p class="console-search-empty" role="status">Searching…</p>
        }
        else if (!View.LayerSearch.IsAllowed)
        {
            <p class="console-search-empty" role="status">@View.LayerSearch.Message</p>
        }
        else if (layers.Count == 0)
        {
            <p class="console-search-empty" role="status">No layers match this search.</p>
        }
        else
        {
            <ul role="tree" aria-labelledby="console-search-layers" class="console-publication-tree" data-publication-tree>
                @for (var index = 0; index < layers.Count; index++)
                {
                    var match = layers[index];
                    <ConsoleSearchResultRow @key="match.Layer.ResourceId" Key="@("search-layer:" + match.Layer.ResourceId)" Href="@ConsolePublicationTree.LayerHref(match.Layer.ResourceId)"
                                            Icon="@ConsoleTreeIcon.ForGeometry(match.Layer.GeometryType)" Label="@match.Layer.Name"
                                            Path="@LayerPath(match)" ServiceToExpand="@match.ServiceName" Position="index + 1" SetSize="layers.Count" />
                }
            </ul>
        }
        @if (View.LayerSearch is { IsAllowed: true, PartialResult: true })
        {
            <p class="console-search-empty" role="status">@View.LayerSearch.Message</p>
        }
    </section>
    @if (!View.SearchPending)
    {
        <p class="console-search-summary" role="status">@(FolderMatchCount + View.Tree.SearchMatchCount + layers.Count) matches in @View.Tree.Root.Label · ↑↓ move · Enter open · Esc back to tree</p>
    }
</div>

@code {
    [CascadingParameter] public ConsolePublicationTreeContext View { get; set; } = default!;

    private IEnumerable<ConsolePublicationNode> MatchingFolders => View.Tree.Root.Children
        .Where(node => node.Kind == ConsolePublicationNodeKind.Folder && node.Href is not null
            && node.Label.Contains(View.Tree.Filter.Trim(), StringComparison.OrdinalIgnoreCase));

    private int FolderMatchCount => MatchingFolders.Count();

    private IReadOnlyList<ConsolePublicationNode> Folders => MatchingFolders.Take(ConsolePublicationTree.PageSize).ToArray();

    private IReadOnlyList<ConsolePublicationNode> Services => View.Tree.MatchingServices
        .OrderBy(node => node.Label, StringComparer.OrdinalIgnoreCase)
        .Take(View.Tree.SearchLimit).ToArray();


    private string FolderPath(ConsolePublicationNode folder) =>
        folder.PublicName is { } name && name != View.Label(folder) ? $"Folder · {name}" : "Folder";

    private string ServicePath(ConsolePublicationNode service)
    {
        var folder = View.Tree.Root.Children.FirstOrDefault(node => node.Children.Contains(service));
        var name = service.ServiceName ?? service.Label;
        var location = folder is null ? name : $"{folder.ShortLabel ?? folder.Label} / {name}";
        return $"{location} · {ConsolePublicationTreeContext.FormatCount(service.ReportedCount, "layer")}";
    }

    private static string LayerPath(ConsolePublicationLayerMatch match) =>
        match.ServiceName is null ? match.Layer.GeometryType : $"{match.ServiceName} · {match.Layer.GeometryType}";
}
