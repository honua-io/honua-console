<div class="console-tree-row" role="treeitem" tabindex="-1" aria-level="@Placement.Level" aria-posinset="@Placement.Position" aria-setsize="@Placement.SiblingCount"
     aria-expanded="@(Node.HasChildren ? (Node.Expanded ? "true" : "false") : null)"
     aria-busy="@(Node.Loading ? "true" : null)" aria-selected="@(Node.Href is null ? null : Node.Href == View.SelectedPath ? "true" : "false")"
     aria-label="@AccessibleLabel" aria-owns="@View.OwnedContent(Node)" aria-describedby="@(Node.HasReadStatus && Node.Expanded ? ConsolePublicationTreeContext.StatusId(Node) : null)"
     data-publication-key="@Node.Key" data-tree-parent="@Placement.ParentKey" data-tree-label="@Node.Label">
    @if (Node.HasChildren)
    {
        var node = Node;
        Func<Task> expansionCommand = Node.Expanded ? () => View.Collapse.InvokeAsync(node) : () => View.Expand.InvokeAsync(node);
        <button type="button" tabindex="-1" data-tree-expand aria-label="@($"{(Node.Expanded ? "Collapse" : "Expand")} {Node.Label}")"
                @onclick="expansionCommand"><span class="console-tree-chevron" aria-hidden="true"></span></button>
    }
    else
    {
        <span class="console-tree-spacer" aria-hidden="true"></span>
    }
    <span class="console-tree-kind" data-kind="@Node.Kind" aria-hidden="true"></span>
    @if (Node.Href is { } href)
    {
        <a href="@href" tabindex="-1" data-tree-link>@Node.Label</a>
    }
    else
    {
        <span class="console-tree-label">@Node.Label</span>
    }
    @if (Node.ChildCount is { } count)
    {
        @(" ")<span class="console-tree-count" aria-hidden="true">@count</span>
    }
    @if (Node.GeometryType is { } geometry)
    {
        @(" ")<span class="console-tree-geometry">@geometry</span>
    }
</div>

@code {
    [CascadingParameter] public ConsolePublicationTreeContext View { get; set; } = default!;
    [Parameter, EditorRequired] public ConsolePublicationNode Node { get; set; } = default!;
    [Parameter, EditorRequired] public ConsolePublicationTreePlacement Placement { get; set; } = default!;
    private string AccessibleLabel => Node.ChildCount is { } count
        ? $"{Node.Label} {ConsolePublicationTreeContext.FormatCount(count, Node.Kind == ConsolePublicationNodeKind.Folder ? "service" : "layer")}"
        : Node.GeometryType is { } geometry ? $"{Node.Label} {geometry}" : Node.Label;
}
