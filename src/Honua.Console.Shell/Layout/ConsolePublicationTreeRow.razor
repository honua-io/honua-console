@inject NavigationManager Navigation

<div class="console-tree-row" role="treeitem" tabindex="-1" aria-level="@Placement.Level" aria-posinset="@Placement.Position" aria-setsize="@Placement.SiblingCount"
     aria-expanded="@(Node.HasChildren ? (Node.Expanded ? "true" : "false") : null)"
     aria-busy="@(Node.Loading ? "true" : null)" aria-selected="@(View.Link(Node) is null ? null : View.Link(Node) == View.SelectedPath ? "true" : "false")"
     aria-label="@AccessibleLabel" aria-owns="@View.OwnedContent(Node)" aria-describedby="@(Node.HasReadStatus && Node.Expanded ? ConsolePublicationTreeContext.StatusId(Node) : null)"
     data-publication-key="@Node.Key" data-tree-parent="@Placement.ParentKey" data-tree-label="@Node.Label"
     @oncontextmenu="OnContextMenu" @oncontextmenu:preventDefault="SupportsActions">
    @if (Node.HasChildren)
    {
        var node = Node;
        Func<Task> expansionCommand = Node.Expanded ? () => View.Collapse.InvokeAsync(node) : () => View.Expand.InvokeAsync(node);
        <button type="button" tabindex="-1" data-tree-expand aria-label="@($"{(Node.Expanded ? "Collapse" : "Expand")} {Node.Label}")"
                @onclick="expansionCommand">@if (View.V4Enabled) { <ConsoleTreeIcon Name="chevron" /> } else { <span class="console-tree-chevron" aria-hidden="true"></span> }</button>
    }
    else
    {
        <span class="console-tree-spacer" aria-hidden="true"></span>
    }
    @if (View.V4Enabled)
    {
        <ConsoleTreeIcon Name="@ConsoleTreeIcon.ForNode(Node)" />
    }
    else
    {
        <span class="console-tree-kind" data-kind="@Node.Kind" aria-hidden="true"></span>
    }
    @if (View.Link(Node) is { } href)
    {
        <a href="@Navigation.ToConsoleHref(href)" tabindex="-1" title="@(View.V4Enabled ? Node.Label : null)" data-tree-link>@View.Label(Node)</a>
    }
    else
    {
        <span class="console-tree-label">@View.Label(Node)</span>
    }
    @if (View.Count(Node) is { } count)
    {
        @(" ")<span class="console-tree-count" aria-hidden="true">@count</span>
    }
    @if (SupportsActions)
    {
        <button type="button" class="console-tree-node-action" tabindex="-1"
                data-tree-action-trigger="@Node.Key"
                aria-haspopup="menu" aria-expanded="@(View.IsMenuOpen(Node) ? "true" : "false")"
                aria-label="@($"Actions for {Node.Label}")" title="@($"Actions for {Node.Label}")"
                @onclick="OnActionClick" @onclick:stopPropagation="true">
            <ConsoleTreeIcon Name="plus" />
        </button>
    }
    @if (Node.GeometryType is { } geometry && !View.V4Enabled)
    {
        @(" ")<span class="console-tree-geometry">@geometry</span>
    }
</div>

@code {
    [CascadingParameter] public ConsolePublicationTreeContext View { get; set; } = default!;
    [Parameter, EditorRequired] public ConsolePublicationNode Node { get; set; } = default!;
    [Parameter, EditorRequired] public ConsolePublicationTreePlacement Placement { get; set; } = default!;

    private bool SupportsActions =>
        View.CanOpenActions && Node.Kind is ConsolePublicationNodeKind.Environment or ConsolePublicationNodeKind.Folder;

    private string AccessibleLabel => View.Count(Node) is { } count
        ? $"{Node.Label} {ConsolePublicationTreeContext.FormatCount(count, Node.Kind is ConsolePublicationNodeKind.Service ? "layer" : "service")}"
        : Node.GeometryType is { } geometry ? $"{Node.Label} {geometry}" : Node.Label;

    private Task OnActionClick() => SupportsActions
        ? View.OpenMenu.InvokeAsync(new ConsolePublicationMenuRequest(Node))
        : Task.CompletedTask;

    private Task OnContextMenu(MouseEventArgs _) => SupportsActions
        ? View.OpenMenu.InvokeAsync(new ConsolePublicationMenuRequest(Node))
        : Task.CompletedTask;
}
