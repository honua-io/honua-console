@using Honua.Console.Shell.Security
@using Microsoft.JSInterop
@inject NavigationManager Navigation
@inject IServiceProvider Services

@* Mounted only in the signed-in shell: after identity-provider sign-in lands on Home, open the page the
   operator asked for. A saved page found anywhere else is discarded, so it never redirects later. *@

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Services.GetService<IJSRuntime>() is not { } js)
        {
            return;
        }

        try
        {
            var route = await ConsolePendingReturn.TakeAsync(js, DateTimeOffset.UtcNow);
            var onHome = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Length == 0;
            if (route is not null && onHome)
            {
                Navigation.NavigateTo(Navigation.ToConsoleHref(route), replace: true);
            }
        }
        catch (Exception exception) when (exception is JSException or ArgumentException)
        {
            // Without session storage, or with a saved page the Console refuses, the operator stays on Home.
        }
    }
}
