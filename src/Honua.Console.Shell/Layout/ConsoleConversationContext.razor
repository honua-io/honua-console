<p data-workspace-target>Start a conversation in your selected environment.</p>
<p data-workspace-selection>
    <span data-workspace-selection-label>No map or object selected.</span>
    <button type="button" class="console-button console-button-secondary" data-workspace-change-selection>Change selection</button>
    <button type="button" class="console-button console-button-secondary" data-workspace-clear-selection hidden>Clear selection</button>
</p>
<label>Deployment target
    <select class="console-input" data-workspace-deploy-target aria-label="Deployment target">
        <option value="">No deployment selected</option>
    </select>
</label>
<button type="button" class="console-button" data-workspace-start>Start conversation</button>
<div data-workspace-messages role="log" aria-label="Workspace conversation"></div>
<div data-workspace-executions hidden aria-label="Agent request progress" aria-live="polite"></div>
<button type="button" class="console-button console-button-secondary" data-workspace-check-executions>Check request progress</button>
