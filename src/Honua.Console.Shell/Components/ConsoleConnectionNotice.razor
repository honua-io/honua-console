@using Honua.Console.Shell.Models
@inject NavigationManager Navigation
@inject IServiceProvider Services

@if (Showing)
{
    <div class="console-panel console-state-warning" role="alert" data-connection-notice>
        <h2>@StatusHeading</h2>
        <p>@StatusMessage</p>
        <div class="console-action-row">
            <a class="console-button-link" href="@Navigation.ToConsoleLinkHref(ActionHref)">@ActionLabel</a>
            @if (OnRetry.HasDelegate)
            {
                @* aria-disabled, not disabled: a disabled button drops keyboard focus to the page body. *@
                <button type="button" class="console-button console-button-secondary" @onclick="RetryAsync"
                        aria-disabled="@(Reading ? "true" : null)">@(Reading ? "Reading…" : "Try again")</button>
            }
        </div>
        <details><summary>Environment details</summary>
            @if (!string.IsNullOrWhiteSpace(_error)) { <p>@_error</p> }
            @foreach (var state in _states.DistinctBy(state => state.Detail))
            {
                <p>@ConsoleVocabulary.SurfaceName(state.Surface): @state.Detail</p>
            }
        </details>
    </div>
    @* Outside the alert: a failed retry leaves the alert text unchanged, so this names each attempt. *@
    <p class="console-visually-hidden" role="status">@_retryAnnouncement</p>
}

@code {
    // The last failure shown. Callers clear their states when a retry starts; keeping this while Busy keeps
    // the notice, and the focused retry button, on screen until the read returns.
    private IReadOnlyList<OperateCapabilityState> _states = [];
    private string? _error;
    private int _failedRetries;
    private string? _retryAnnouncement;
    private bool _retrying;
    private bool _retryCompletionPending;

    private bool Showing => _states.Count > 0 || !string.IsNullOrWhiteSpace(_error);
    private bool Reading => Busy || _retrying;

    protected override void OnParametersSet()
    {
        CaptureFailure();
        CompleteRetry();
    }

    private void CaptureFailure()
    {
        if (States.Count > 0 || !string.IsNullOrWhiteSpace(Error))
        {
            _states = States;
            _error = Error;
        }
        else if (!Busy && !_retrying)
        {
            _states = [];
            _error = null;
            _failedRetries = 0;
            _retryAnnouncement = null;
        }
    }

    private async Task RetryAsync()
    {
        if (Reading)
        {
            return;
        }

        _retrying = true;
        _retryAnnouncement = null;
        try
        {
            await OnRetry.InvokeAsync();
        }
        finally
        {
            _retrying = false;
        }

        _retryCompletionPending = true;
        CaptureFailure();
        CompleteRetry();
    }

    private void CompleteRetry()
    {
        // A newer read can outlive the retry callback; announce only after that read settles.
        if (!_retryCompletionPending || Reading)
        {
            return;
        }

        _retryCompletionPending = false;
        if (Showing)
        {
            _failedRetries++;
            _retryAnnouncement = $"Attempt {_failedRetries + 1} did not complete. {StatusHeading}.";
        }
    }

    private string StateText => string.Join(" ", _states.Select(state => state.State)).ToLowerInvariant();
    private bool SignIn => _states.Any(state => state.StatusCode == 401) || StateText.Contains("unauthorized") || StateText.Contains("unauthenticated");
    private bool Forbidden => !SignIn && (_states.Any(state => state.StatusCode == 403) || StateText.Contains("forbidden") || StateText.Contains("denied") || StateText.Contains("missing permission"));
    private bool Throttled => !SignIn && !Forbidden && (_states.Any(state => state.StatusCode == 429) || StateText.Contains("throttled") || StateText.Contains("rate limit"));
    private bool Missing => StateText.Contains("missing binding") || StateText.Contains("binding") || StateText.Contains("unconfigured");
    private bool Unsupported => StateText.Contains("unsupported") && !Missing;
    private bool TemporaryUnavailable => !SignIn && !Forbidden && !Throttled && !Missing && !Unsupported
        && _states.Any(state => state.StatusCode == 503 || state.Retryable);
    private double? RetryAfterSeconds => _states.Select(state => state.RetryAfterSeconds).FirstOrDefault(seconds => seconds is > 0);
    private string StatusHeading => Forbidden ? "Access to these objects was denied"
        : SignIn ? "Sign in to read this environment"
        : Throttled ? "Too many requests"
        : TemporaryUnavailable ? "Service temporarily unavailable"
        : Missing ? "Connect an environment to continue"
        : Unsupported ? "This feature is unavailable on this deployment"
        : Heading;
    private string StatusMessage => Forbidden ? "Ask your deployment administrator for the required access, or select an environment you can use."
        : SignIn ? "Your sign-in is missing or expired. Sign in again before reading data."
        : Throttled ? $"The server is rate-limiting requests. {Honua.Console.Contracts.ConsoleFailureReceiptParser.FormatRetryWaitHint(RetryAfterSeconds)} Your data has not been confirmed empty."
        : TemporaryUnavailable ? $"The server is temporarily unavailable. {(RetryAfterSeconds is > 0 ? Honua.Console.Contracts.ConsoleFailureReceiptParser.FormatRetryWaitHint(RetryAfterSeconds) : "Try again in a moment.")} Your data has not been confirmed empty."
        : Missing ? "Select or configure your deployment before reading its data."
        : Unsupported ? "Check the deployment capabilities or choose a supported environment."
        : "The request did not complete. Check the environment and try again. Your data has not been confirmed empty.";
    private string ActionHref => Services.GetService<IConsoleBrowserAuthentication>() is null
        ? SignIn ? "/auth/login" : "/environments"
        : Navigation.ToConsoleHref(SignIn
            ? $"/auth/signin?returnTo={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}"
            : "/environments");
    private string ActionLabel => SignIn ? "Sign in" : Forbidden ? "Choose environment" : Missing ? "Connect environment" : "Review environment";
    [Parameter] public string Heading { get; set; } = "Could not read this environment";
    [Parameter] public IReadOnlyList<OperateCapabilityState> States { get; set; } = [];
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
}
