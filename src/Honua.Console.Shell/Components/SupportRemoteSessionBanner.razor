@inject NavigationManager ConsoleNavigation
@inject IServiceProvider Services
@using Honua.Console.Contracts
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@implements IDisposable

@if (ShowBanner)
{
    <article class="console-panel support-session-banner @SeverityClass" data-support-session-banner>
        <div class="console-panel-heading">
            <h2>Remote session</h2>
            <span class="support-phase-badge" data-support-session-mode>@AccessModeLabel</span>
        </div>

        @if (HasActiveWindow)
        {
            <p class="support-session-scopes" data-support-session-scopes>
                Granted scope: <span class="console-mono">@ScopeDisplay</span>
            </p>
            <p class="support-session-countdown" data-support-session-countdown>
                @if (_remaining > TimeSpan.Zero)
                {
                    <span>Access window: <strong>@FormatRemaining(_remaining)</strong> remaining</span>
                }
                else
                {
                    <span><strong>Access window elapsed</strong> — session TTL expired</span>
                }
            </p>
            <p class="console-muted support-session-expiry">
                @if (HasAuthoritativeSession)
                {
                    <span>Expires @ExpiresAt?.ToString("u")</span>
                }
                else
                {
                    <span>TTL @TtlMinutes min · best-effort expiry @ExpiresAt?.ToString("u")</span>
                }
            </p>
            @if (_remaining > TimeSpan.Zero && _supportClient is not null)
            {
                <div class="support-session-revoke-row">
                    <button type="button"
                            class="console-button console-button-danger"
                            disabled="@_revoking"
                            data-revoke-support-session
                            @onclick="RevokeSessionAsync">
                        @(_revoking ? "Revoking support session…" : "Revoke Support Session")
                    </button>
                </div>
            }
        }
        else if (IsRevoked)
        {
            <p data-support-session-revoked>
                Break-glass support session revoked. No remote credentials remain active for this ticket.
            </p>
        }
        else
        {
            <p>Read-only diagnostic access. No elevated remote session is open for this ticket.</p>
        }

        @if (!string.IsNullOrWhiteSpace(_revokeMessage))
        {
            <p class="@_revokeMessageClass" role="status" data-support-session-revoke-message>@_revokeMessage</p>
        }

        @if (_auditReceipt is { } receipt)
        {
            <div class="support-session-audit-receipt" data-support-session-audit-receipt>
                <strong>Session audit trail receipt</strong>
                <dl class="support-context-list">
                    <ContextRow Label="Transition" Value="@receipt.TransitionDisplay" />
                    <ContextRow Label="Actor" Value="@receipt.Actor" />
                    <ContextRow Label="Timestamp" Value="@receipt.OccurredAtDisplay" />
                    <ContextRow Label="Audit chain" Value="@receipt.ChainStatusLabel" />
                    @if (!string.IsNullOrWhiteSpace(receipt.AuditEntryId))
                    {
                        <ContextRow Label="Audit entry" Value="@receipt.AuditEntryId" />
                    }
                    @if (!string.IsNullOrWhiteSpace(receipt.AuditEntryHash))
                    {
                        <ContextRow Label="Entry hash" Value="@receipt.AuditEntryHash" />
                    }
                </dl>
            </div>
        }

        <p class="support-session-visibility">
            Customer-visible: <strong>@(CustomerVisible ? "yes — this activity is shown to the customer" : "follow-up")</strong>
        </p>

        @if (Boundary is { } boundary)
        {
            <dl class="support-context-list">
                <ContextRow Label="First escalation step" Value="@boundary.FirstEscalationStep" />
                <ContextRow Label="Operator-scoped requirement" Value="@boundary.OperatorScopedRequirement" />
            </dl>
            @if (boundary.Exclusions.Count > 0)
            {
                <p class="console-kicker">Hard exclusions</p>
                <ul class="support-validation-list">
                    @foreach (var exclusion in boundary.Exclusions)
                    {
                        <li>@exclusion</li>
                    }
                </ul>
            }
        }

        <p class="support-session-actions">
            <a class="support-session-link" href="@ConsoleNavigation.ToConsoleLinkHref(AuditHref)">View actions (audit / evidence) →</a>
        </p>
    </article>
}

@code {
    [Parameter]
    public SupportTicketResponse? Ticket { get; set; }

    [Parameter]
    public EventCallback<SupportTicketResponse> OnSessionRevoked { get; set; }

    private static readonly TimeSpan Tick = TimeSpan.FromSeconds(1);

    private IConsoleSupportTicketClient? _supportClient;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private TimeSpan _remaining = TimeSpan.Zero;
    private string? _trackedTicketId;
    private SupportTicketResponse? _revokedTicket;
    private bool _revoking;
    private string? _revokeMessage;
    private string _revokeMessageClass = string.Empty;
    private PolicyAuditTrailReceipt? _auditReceipt;

    private SupportTicketResponse? EffectiveTicket =>
        _revokedTicket is not null && string.Equals(_revokedTicket.Id, Ticket?.Id, StringComparison.Ordinal)
            ? _revokedTicket
            : Ticket;

    private bool ShowBanner => EffectiveTicket is not null;

    private SupportTrustDelegatedSession? Session => EffectiveTicket?.Trust?.DelegatedSession;

    private bool HasTrustSession => Session is not null;

    private bool HasAuthoritativeSession => HasTrustSession;

    private bool IsRevoked =>
        HasTrustSession && (Session!.RevokedAt is not null
            || string.Equals(Session.Mode, "revoked", StringComparison.OrdinalIgnoreCase));

    private string AccessMode =>
        HasTrustSession ? Session!.Mode : EffectiveTicket?.AllowedAccessMode ?? string.Empty;

    private int TtlMinutes => EffectiveTicket?.TtlMinutes ?? 0;

    private SupportAccessBoundary? Boundary => EffectiveTicket?.AccessBoundary;

    private string ScopeDisplay =>
        Session?.Scopes is { Count: > 0 } scopes
            ? string.Join(" + ", scopes)
            : "ops:read + ops:propose";

    private string AccessModeLabel
    {
        get
        {
            var mode = string.IsNullOrWhiteSpace(AccessMode) ? "read-only" : AccessMode;
            return Services.GetService<ConsoleV4Options>()?.Enabled == true ? SupportTicketLabels.Display(mode)! : mode;
        }
    }

    private bool HasActiveWindow =>
        !IsRevoked && (HasTrustSession
            ? Session!.Active &&
              !string.Equals(Session.Mode, "read-only", StringComparison.OrdinalIgnoreCase) &&
              !string.Equals(Session.Mode, "disabled", StringComparison.OrdinalIgnoreCase) &&
              !string.Equals(Session.Mode, "revoked", StringComparison.OrdinalIgnoreCase)
            : TtlMinutes > 0 &&
              !string.Equals(AccessMode, "read-only", StringComparison.OrdinalIgnoreCase) &&
              !string.IsNullOrWhiteSpace(AccessMode));

    private bool CustomerVisible =>
        HasTrustSession
            ? Session!.CustomerVisible
            : string.Equals(AccessMode, "operator-scoped", StringComparison.OrdinalIgnoreCase)
              || string.Equals(AccessMode, "break-glass", StringComparison.OrdinalIgnoreCase);

    private string SeverityClass => HasActiveWindow
        ? (_remaining > TimeSpan.Zero ? "support-session-active" : "support-session-expired")
        : "support-session-idle";

    private DateTimeOffset? ExpiresAt
    {
        get
        {
            if (HasTrustSession)
            {
                return Session!.ExpiresAt;
            }

            return EffectiveTicket is null || !HasActiveWindow ? null : EffectiveTicket.UpdatedAt.AddMinutes(TtlMinutes);
        }
    }

    private string AuditHref =>
        EffectiveTicket is null ? "#" : $"/support/tickets/{Uri.EscapeDataString(EffectiveTicket.Id)}#audit";

    protected override void OnInitialized()
    {
        _supportClient = Services.GetService<IConsoleSupportTicketClient>();
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(_trackedTicketId, Ticket?.Id, StringComparison.Ordinal))
        {
            _revokedTicket = null;
            _revokeMessage = null;
            _auditReceipt = null;
        }

        if (string.Equals(_trackedTicketId, Ticket?.Id, StringComparison.Ordinal) && _timer is not null)
        {
            RecomputeRemaining();
            if (!HasActiveWindow)
            {
                StopCountdown();
            }
            return;
        }

        StopCountdown();
        _trackedTicketId = Ticket?.Id;
        RecomputeRemaining();

        if (HasActiveWindow)
        {
            StartCountdown();
        }
    }

    private async Task RevokeSessionAsync()
    {
        if (_revoking || _supportClient is null || EffectiveTicket is null)
        {
            return;
        }

        var previousMode = string.IsNullOrWhiteSpace(AccessMode) ? "operator-scoped" : AccessMode;
        _revoking = true;
        _revokeMessage = null;
        try
        {
            var result = await _supportClient.RevokeSessionAsync(
                EffectiveTicket.Id,
                "Revoked by operator from Console");
            if (result.IsAllowed && result.Value is { } updated)
            {
                _revokedTicket = updated;
                StopCountdown();
                RecomputeRemaining();
                _auditReceipt = PolicyAuditTrailReceipt.FromRevokedSupportSession(updated, previousMode);
                _revokeMessage = "Support session revoked and recorded in the audit trail.";
                _revokeMessageClass = "console-state-success";
                await OnSessionRevoked.InvokeAsync(updated);
            }
            else
            {
                _revokeMessage = string.IsNullOrWhiteSpace(result.Message)
                    ? OperateSectionPresentation.FallbackMessage(result.Status)
                    : result.Message;
                _revokeMessageClass = "console-state-danger";
            }
        }
        finally
        {
            _revoking = false;
        }
    }

    private void RecomputeRemaining()
    {
        _remaining = HasActiveWindow && ExpiresAt is { } expiry
            ? expiry - DateTimeOffset.UtcNow
            : TimeSpan.Zero;
        if (_remaining < TimeSpan.Zero)
        {
            _remaining = TimeSpan.Zero;
        }
    }

    private void StartCountdown()
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(Tick);
        var token = _cts.Token;
        _ = RunAsync(token);
    }

    private async Task RunAsync(CancellationToken token)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(token).ConfigureAwait(false))
            {
                RecomputeRemaining();
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
                if (_remaining <= TimeSpan.Zero)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Disposed or re-parameterised; stop quietly.
        }
    }

    private void StopCountdown()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
        _timer = null;
        _cts = null;
    }

    private static string FormatRemaining(TimeSpan remaining) =>
        remaining.TotalHours >= 1
            ? $"{(int)remaining.TotalHours}h {remaining.Minutes:D2}m {remaining.Seconds:D2}s"
            : $"{remaining.Minutes:D2}m {remaining.Seconds:D2}s";

    public void Dispose() => StopCountdown();
}
