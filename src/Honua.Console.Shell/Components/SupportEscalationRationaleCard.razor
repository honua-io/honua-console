@using Honua.Console.Contracts

@* trust-visibility (#166): explains *why* a ticket escalated.

   DATA TRANSPORT NOTE (honua-support#23): when the ticket carries the
   authoritative `trust.escalation`, this card reads its
   trigger/signal/justification/accessScope/... directly. When that sub-object is
   ABSENT it degrades to the loose diagnosis-borne rationale
   (Diagnosis.Escalation) plus the EscalatedAt/By/Tier provenance on the ticket
   response. Renders nothing unless the ticket is actually escalated. *@
@if (IsEscalated)
{
    <article class="console-panel support-escalation-card">
        <div class="console-panel-heading">
            <h2>Why this escalated</h2>
            @if (Tier is { } tier)
            {
                <span class="support-phase-badge">Tier @tier</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(HeadlineReason))
        {
            <p class="support-escalation-headline">@HeadlineReason</p>
        }

        @if (!string.IsNullOrWhiteSpace(Justification))
        {
            <p>@Justification</p>
        }

        <dl class="support-context-list">
            <ContextRow Label="Trigger" Value="@Trigger" />
            <ContextRow Label="Signal" Value="@Signal" />
            <ContextRow Label="Access scope" Value="@AccessScope" />
            <ContextRow Label="Rollback intent" Value="@RollbackIntent" />
            <ContextRow Label="Approved by" Value="@ApprovedBy" />
            <ContextRow Label="Approved at" Value="@(ApprovedAt?.ToString("u"))" />
        </dl>

        <dl class="support-context-list">
            <ContextRow Label="Escalated by" Value="@EscalatedBy" />
            <ContextRow Label="Escalated at" Value="@(EscalatedAt?.ToString("u"))" />
        </dl>
    </article>
}

@code {
    [Parameter]
    public SupportTicketResponse? Ticket { get; set; }

    // trust-data relay (honua-support#23): authoritative escalation when present.
    private SupportTrustEscalation? Trust => Ticket?.Trust?.Escalation;

    // Loose best-effort rationale (diagnosis-borne) used when trust is absent.
    private SupportEscalationRationale? Rationale => Ticket?.Diagnosis?.Escalation;

    private int? Tier => Ticket?.EscalationTier;

    private DateTimeOffset? EscalatedAt => Ticket?.EscalatedAt;

    private string? EscalatedBy => Ticket?.EscalatedBy;

    // Prefer the authoritative trust fields; fall back to the loose rationale.
    private string? Trigger => Trust?.Trigger ?? Rationale?.Trigger;

    private string? Signal => Trust?.Signal ?? Rationale?.Signal;

    private string? Justification => Trust?.Justification is { Length: > 0 } j
        ? j
        : Rationale?.Justification;

    private string? AccessScope => Trust?.AccessScope ?? Rationale?.AccessScope;

    private string? RollbackIntent => Trust?.RollbackIntent ?? Rationale?.RollbackIntent;

    private string? ApprovedBy => Trust?.ApprovedBy ?? Rationale?.ApprovedBy;

    private DateTimeOffset? ApprovedAt => Trust?.ApprovedAt ?? Rationale?.ApprovedAt;

    // Escalated if the authoritative trust says so, or — best-effort — the ticket
    // carries any escalation provenance: a tier, a timestamp, or a rationale.
    private bool IsEscalated =>
        Ticket is not null &&
        (Trust?.Escalated == true ||
         Tier is > 0 || EscalatedAt is not null || Rationale is not null);

    // Prefer the trigger/signal codes for a crisp one-liner; otherwise none.
    private string? HeadlineReason
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Trigger))
            {
                return null;
            }

            var trigger = Humanize(Trigger);
            return string.IsNullOrWhiteSpace(Signal)
                ? $"{trigger} → escalating"
                : $"{trigger} ({Signal}) → escalating";
        }
    }

    private static string Humanize(string code) =>
        string.IsNullOrWhiteSpace(code) ? code : code.Replace('-', ' ').Replace('_', ' ');
}
