@using Honua.Console.Contracts

@* trust-visibility (#166): explains *why* a ticket escalated, from the rationale
   that travels on the honua-support ticket (Diagnosis.Escalation + the
   EscalatedAt/By/Tier provenance on the ticket response). Renders nothing unless
   the ticket is actually escalated. *@
@if (IsEscalated)
{
    <article class="console-panel support-escalation-card">
        <div class="console-panel-heading">
            <h2>Why this escalated</h2>
            @if (Tier is { } tier)
            {
                <span class="support-phase-badge">Tier @tier</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(HeadlineReason))
        {
            <p class="support-escalation-headline">@HeadlineReason</p>
        }

        @if (Rationale is { } rationale)
        {
            @if (!string.IsNullOrWhiteSpace(rationale.Justification))
            {
                <p>@rationale.Justification</p>
            }

            <dl class="support-context-list">
                <ContextRow Label="Trigger" Value="@rationale.Trigger" />
                <ContextRow Label="Signal" Value="@rationale.Signal" />
                <ContextRow Label="Access scope" Value="@rationale.AccessScope" />
                <ContextRow Label="Rollback intent" Value="@rationale.RollbackIntent" />
                <ContextRow Label="Approved by" Value="@rationale.ApprovedBy" />
                <ContextRow Label="Approved at" Value="@(rationale.ApprovedAt?.ToString("u"))" />
            </dl>
        }

        <dl class="support-context-list">
            <ContextRow Label="Escalated by" Value="@EscalatedBy" />
            <ContextRow Label="Escalated at" Value="@(EscalatedAt?.ToString("u"))" />
        </dl>
    </article>
}

@code {
    [Parameter]
    public SupportTicketResponse? Ticket { get; set; }

    private SupportEscalationRationale? Rationale => Ticket?.Diagnosis?.Escalation;

    private int? Tier => Ticket?.EscalationTier;

    private DateTimeOffset? EscalatedAt => Ticket?.EscalatedAt;

    private string? EscalatedBy => Ticket?.EscalatedBy;

    // Escalated if the ticket carries any escalation provenance: a tier, a
    // timestamp, or a diagnosis-borne rationale.
    private bool IsEscalated =>
        Ticket is not null &&
        (Tier is > 0 || EscalatedAt is not null || Rationale is not null);

    // Prefer the devops trigger/signal codes for a crisp one-liner; otherwise
    // fall back to the human justification.
    private string? HeadlineReason
    {
        get
        {
            if (Rationale is not { } rationale)
            {
                return null;
            }

            if (!string.IsNullOrWhiteSpace(rationale.Trigger))
            {
                var trigger = Humanize(rationale.Trigger);
                return string.IsNullOrWhiteSpace(rationale.Signal)
                    ? $"{trigger} → escalating"
                    : $"{trigger} ({rationale.Signal}) → escalating";
            }

            return null;
        }
    }

    private static string Humanize(string code) =>
        string.IsNullOrWhiteSpace(code) ? code : code.Replace('-', ' ').Replace('_', ' ');
}
