@namespace Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IServiceLayerPublishOperation PublishOperation
@inject IOperateTransitionDataSource OperateData
@inject IConsoleNotificationService Notifications
@inject IJSRuntime JS

@*
    The publish wizard for the Operate publishing workspace: Service → Layer → Review, wired
    end-to-end to honua-server.

    Every value this wizard shows is read from a server contract or derived from the operator's own
    selection:

      - services            IOperateTransitionDataSource.GetServicesViewAsync()
      - connections         IOperateTransitionDataSource.GetConnectionsViewAsync()
      - tables + geometry   IServiceLayerPublishOperation.ListTablesAsync(connectionId)
      - the publish itself  IServiceLayerPublishOperation.PublishAsync(command)

    It previously carried the design-handoff mockup's fixtures inline — a `prod-postgis` connection
    constant, `public.parcels_2024`, a seeded service tree, a resource table with feature counts and
    PII flags, and review panels quoting a field count, a layer slot, a cache TTL and a published
    URL. The finish action built its real publish command from those constants, so on any deployment
    without a connection named `prod-postgis` the POST 404'd, and the review step described a
    resource the operator had never chosen. Fixtures in a surface that also makes real calls are
    worse than an empty state: they are indistinguishable from live data until the request fails.

    Facts honua-server owns and does not expose before the publish lands (the layer's slot id and its
    published URL) render as an explicit "assigned on publish" rather than a plausible number, per
    the Console Patterns Charter section 11 — this surface never fabricates publication state.
*@

<PublishModeBar Mode="_mode" ModeChanged="OnModeChanged" />

@if (_mode == PublishModeBar.PublishMode.AuthorFirst)
{
    <ConsoleStateView Kind="unsupported"
                      Kicker="Author resource first"
                      Title="This flow is not wired yet"
                      Message="Authoring a resource before choosing its slot needs server contracts the console does not have yet: per-target compatibility, slot assignment, field aliasing and exposure, and a layer projection preview. Publish through Quick publish, which is bound end-to-end."
                      ActionLabel="Back to quick publish"
                      ActionHref="/operate/publishing" />
}
else if (_loadFailure is { } failure)
{
    <ConsoleStateView Kind="unsupported"
                      Kicker="Publishing"
                      Title="Couldn't read the publishing workspace"
                      Message="@failure" />
}
else
{
    <PublishWizard Steps="@QuickStepList"
                   Current="_quickCurrent"
                   CurrentChanged="OnQuickCurrentChanged"
                   Kicker="Quick publish"
                   Title="Publish a layer in three steps"
                   FinishLabel="Publish + open resource →"
                   OnFinish="OnFinish" />
}

@code {
    private PublishModeBar.PublishMode _mode = PublishModeBar.PublishMode.Quick;

    // ---- Server-owned reads. Empty until loaded; never seeded. ----
    private IReadOnlyList<OperateServiceDetail> _services = [];
    private IReadOnlyList<OperateConnectionSummary> _connections = [];
    private IReadOnlyList<ServiceLayerPublishTable> _tables = [];
    private bool _loading = true;
    private bool _loadingTables;
    private string? _loadFailure;

    // ---- Operator selection ----
    private int _quickCurrent;
    private bool _createNewService;
    private string? _selectedServiceName;
    private string _newServiceName = string.Empty;
    private string? _connectionId;
    private string? _tableKey;
    private string _layerName = string.Empty;

    private bool _published;
    private bool _publishing;
    private ServiceLayerPublishResult? _publishResult;

    private ServiceLayerPublishTable? SelectedTable =>
        _tables.FirstOrDefault(t => string.Equals(t.QualifiedName, _tableKey, StringComparison.Ordinal));

    private OperateServiceDetail? SelectedService =>
        _services.FirstOrDefault(s => string.Equals(s.Name, _selectedServiceName, StringComparison.Ordinal));

    private string EffectiveServiceName =>
        (_createNewService ? _newServiceName : _selectedServiceName ?? string.Empty).Trim();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var services = await OperateData.GetServicesViewAsync();
            var connections = await OperateData.GetConnectionsViewAsync();
            _services = services.Services;
            _connections = connections.Connections;
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidOperationException or TaskCanceledException)
        {
            // A read failure is reported as itself. Falling back to sample content here is exactly
            // how the mockup fixtures used to reach the operator.
            _loadFailure = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnModeChanged(PublishModeBar.PublishMode mode) => _mode = mode;

    private void OnQuickCurrentChanged(int next) => _quickCurrent = next;

    private async Task OnConnectionChanged(ChangeEventArgs args)
    {
        _connectionId = args.Value?.ToString();
        _tables = [];
        _tableKey = null;
        _publishResult = null;

        if (string.IsNullOrWhiteSpace(_connectionId))
        {
            return;
        }

        _loadingTables = true;
        try
        {
            _tables = await PublishOperation.ListTablesAsync(_connectionId);
        }
        finally
        {
            _loadingTables = false;
        }
    }

    private void OnTableChanged(ChangeEventArgs args)
    {
        _tableKey = args.Value?.ToString();
        _publishResult = null;

        // Seed the layer name from the table the operator picked, not from a fixture.
        if (SelectedTable is { } table && string.IsNullOrWhiteSpace(_layerName))
        {
            _layerName = table.Table;
        }
    }

    private Task OnFinish() =>
        Notifications.RunGuardedAsync(
            PublishAsync,
            setBusy: busy => { _publishing = busy; StateHasChanged(); },
            failureMessage: "Couldn't publish the layer");

    // Builds the command from the operator's actual selection. Geometry, SRID and the field list
    // come from the table honua-server reported, so the POST describes a table that exists.
    private async Task PublishAsync()
    {
        if (SelectedTable is not { } table || string.IsNullOrWhiteSpace(_connectionId))
        {
            return;
        }

        var command = new ServiceLayerPublishCommand
        {
            ConnectionId = _connectionId,
            Schema = table.Schema,
            Table = table.Table,
            LayerName = string.IsNullOrWhiteSpace(_layerName) ? table.Table : _layerName.Trim(),
            ServiceName = EffectiveServiceName,
            GeometryColumn = table.GeometryColumn,
            GeometryType = table.GeometryType,
            Srid = table.Srid,
            Fields = table.Columns,
            Enabled = true
        };

        _publishResult = await PublishOperation.PublishAsync(command);
        _published = _publishResult.Succeeded;

        if (_publishResult.Succeeded)
        {
            Notifications.Success(
                $"Published {_publishResult.LayerName ?? command.LayerName} into {_publishResult.ServiceName ?? command.ServiceName}.");
        }
        else
        {
            Notifications.Warning(_publishResult.Detail ?? "The publish did not complete.");
        }
    }

    private static string Unknown(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string RowCount(long? rows) =>
        rows is { } value ? value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) : "—";

    // ===================================================================================
    //  QUICK-PUBLISH STEPS: Service → Layer → Review
    // ===================================================================================

    private IReadOnlyList<PublishWizardStep> QuickStepList =>
    [
        new PublishWizardStep(
            "Service",
            QuickServiceBody,
            IsValid: !string.IsNullOrWhiteSpace(EffectiveServiceName),
            ContinueLabel: "Continue · Layer →"),
        new PublishWizardStep(
            "Layer",
            QuickLayerBody,
            IsValid: SelectedTable is not null,
            ContinueLabel: "Continue · Review →"),
        new PublishWizardStep("Review", QuickReviewBody, IsValid: !_publishing && SelectedTable is not null),
    ];

    private RenderFragment QuickServiceBody => __builder =>
    {
        <div class="publish-wizard-grid" data-quick-step="service">
            <div class="publish-wizard-main">
                <h3 class="publish-wizard-question">What service should this layer live in?</h3>
                <p class="console-muted">A service is the container. Service-level settings live on the service; this wizard adds a layer to it.</p>

                <div class="publish-segment" role="group" aria-label="Service mode">
                    <button type="button"
                            class="publish-segment-option @(_createNewService ? null : "publish-segment-active")"
                            aria-pressed="@(!_createNewService)"
                            @onclick="() => _createNewService = false">
                        Use existing service
                    </button>
                    <button type="button"
                            class="publish-segment-option @(_createNewService ? "publish-segment-active" : null)"
                            aria-pressed="@_createNewService"
                            @onclick="() => _createNewService = true">
                        Create new service
                    </button>
                </div>

                @if (!_createNewService)
                {
                    @ServiceTree
                }
                else
                {
                    <article class="console-panel" data-new-service>
                        <h3>New service</h3>
                        <label class="publish-field">
                            <span>Service name</span>
                            <input class="console-input" data-new-service-name @bind="_newServiceName" @bind:event="oninput" />
                        </label>
                        <p class="console-muted">honua-server creates the service when the layer publishes. Its runtime settings — CRS, capabilities, cache, output formats — are managed in Operate → Services.</p>
                    </article>
                }
            </div>

            <aside class="publish-wizard-rail">
                @if (!_createNewService && SelectedService is { } svc)
                {
                    <article class="console-panel">
                        <h3>You're publishing into</h3>
                        <dl class="console-definition-list">
                            <dt>Service</dt><dd>@svc.Name</dd>
                            <dt>Kind</dt><dd>@Unknown(svc.ServiceType)</dd>
                            <dt>Runtime status</dt><dd>@Unknown(svc.RuntimeStatus)</dd>
                            <dt>Metadata owner</dt><dd>@Unknown(svc.MetadataOwnership)</dd>
                            <dt>Layers</dt><dd>@svc.Layers.Count</dd>
                        </dl>
                    </article>
                    <p class="publish-callout publish-callout-info">Reusing a service means accepting its settings as-is; they are shared by every layer in it.</p>
                }
                else if (_createNewService)
                {
                    <article class="console-panel">
                        <h3>What gets created</h3>
                        <dl class="console-definition-list">
                            <dt>Service</dt><dd>@(string.IsNullOrWhiteSpace(_newServiceName) ? "—" : $"{_newServiceName} (new)")</dd>
                            <dt>Layer slot</dt><dd>assigned by the server on publish</dd>
                        </dl>
                    </article>
                }
            </aside>
        </div>
    };

    private RenderFragment ServiceTree => __builder =>
    {
        <div class="publish-tree" data-publish-tree>
            @if (_loading)
            {
                <p class="console-muted" data-publish-tree-loading>Loading services…</p>
            }
            else if (_services.Count == 0)
            {
                <p class="console-muted" data-publish-tree-empty>No services are bound. Create a new service instead, or check the environment binding under Environments.</p>
            }
            else
            {
                @foreach (var service in _services)
                {
                    var selected = string.Equals(service.Name, _selectedServiceName, StringComparison.Ordinal);
                    <button type="button"
                            class="publish-tree-row @(selected ? "publish-tree-row-selected" : null)"
                            data-publish-tree-row="@service.Name"
                            aria-pressed="@selected"
                            @onclick="() => _selectedServiceName = service.Name">
                        <span class="publish-tree-name">◈ @service.Name</span>
                        @if (!string.Equals(service.DisplayName, service.Name, StringComparison.Ordinal)
                             && !string.IsNullOrWhiteSpace(service.DisplayName))
                        {
                            <span class="console-muted publish-tree-display-name">@service.DisplayName</span>
                        }
                        <span class="console-muted">@Unknown(service.ServiceType) · @service.Layers.Count layers · @Unknown(service.RuntimeStatus)</span>
                    </button>
                }
            }
        </div>
    };

    private RenderFragment QuickLayerBody => __builder =>
    {
        <div class="publish-wizard-grid" data-quick-step="layer">
            <div class="publish-wizard-main">
                <div class="publish-context-bar">
                    <span>◈ @(string.IsNullOrWhiteSpace(EffectiveServiceName) ? "—" : EffectiveServiceName)</span>
                    <span class="publish-context-spacer"></span>
                    <span class="console-muted">the server assigns the layer slot on publish</span>
                </div>

                <h3 class="publish-wizard-question">What does this layer expose?</h3>
                <p class="console-muted">A layer is backed by one table on a registered connection.</p>

                <article class="console-panel">
                    <div class="publish-field-grid">
                        <label class="publish-field">
                            <span>Connection</span>
                            <select class="console-input" data-connection-picker value="@_connectionId" @onchange="OnConnectionChanged">
                                <option value="">Select a connection…</option>
                                @foreach (var connection in _connections)
                                {
                                    <option value="@connection.Id">@connection.Name (@connection.Provider)</option>
                                }
                            </select>
                        </label>
                        <label class="publish-field">
                            <span>Table</span>
                            <select class="console-input" data-table-picker value="@_tableKey" @onchange="OnTableChanged"
                                    disabled="@(_tables.Count == 0)">
                                <option value="">@(_loadingTables ? "Loading tables…" : "Select a table…")</option>
                                @foreach (var candidate in _tables)
                                {
                                    <option value="@candidate.QualifiedName">@candidate.QualifiedName</option>
                                }
                            </select>
                        </label>
                        <label class="publish-field">
                            <span>Layer name</span>
                            <input class="console-input" data-layer-name @bind="_layerName" @bind:event="oninput" />
                        </label>
                    </div>
                    @if (_connections.Count == 0 && !_loading)
                    {
                        <p class="console-muted" data-no-connections>No connections are registered on this server. Add one under Operate → Connections before publishing.</p>
                    }
                </article>
            </div>

            <aside class="publish-wizard-rail">
                <article class="console-panel">
                    <h3>Picked table</h3>
                    @if (SelectedTable is { } table)
                    {
                        <dl class="console-definition-list">
                            <dt>Source</dt><dd>@table.QualifiedName</dd>
                            <dt>Geometry</dt><dd>@Unknown(table.GeometryColumn) · @Unknown(table.GeometryType)</dd>
                            <dt>SRID</dt><dd>@(table.Srid?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</dd>
                            <dt>Estimated rows</dt><dd>@RowCount(table.EstimatedRows)</dd>
                            <dt>Fields</dt><dd>@table.Columns.Count</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="console-muted">Select a connection and table to see what will be published.</p>
                    }
                </article>
            </aside>
        </div>
    };

    private RenderFragment QuickReviewBody => __builder =>
    {
        <div class="publish-wizard-grid" data-quick-step="review">
            <div class="publish-wizard-main">
                <div class="publish-context-bar">
                    <span>◈ @(string.IsNullOrWhiteSpace(EffectiveServiceName) ? "—" : EffectiveServiceName)</span>
                    <span aria-hidden="true">›</span>
                    <span>◇ @(string.IsNullOrWhiteSpace(_layerName) ? Unknown(SelectedTable?.Table) : _layerName)</span>
                    <span class="publish-context-spacer"></span>
                    <span class="console-status @(SelectedTable is null ? "console-state-warning" : "console-state-success")">
                        @(SelectedTable is null ? "incomplete" : "ready")
                    </span>
                </div>

                <h3 class="publish-wizard-question">Ready to publish</h3>
                <p class="console-muted">This is the request the console will send. Nothing below is inferred.</p>

                <div class="publish-review-stack">
                    <article class="console-panel">
                        <h3>◇ Source table</h3>
                        <dl class="console-definition-list">
                            <dt>Connection</dt><dd>@Unknown(_connectionId)</dd>
                            <dt>Table</dt><dd>@Unknown(SelectedTable?.QualifiedName)</dd>
                            <dt>Geometry</dt><dd>@Unknown(SelectedTable?.GeometryColumn) · @Unknown(SelectedTable?.GeometryType)</dd>
                            <dt>SRID</dt><dd>@(SelectedTable?.Srid?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</dd>
                            <dt>Fields sent</dt><dd>@(SelectedTable?.Columns.Count ?? 0)</dd>
                        </dl>
                    </article>
                    <div class="publish-review-bind">↓ publishes into ↓</div>
                    <article class="console-panel publish-review-layer">
                        <h3>◈ @(string.IsNullOrWhiteSpace(EffectiveServiceName) ? "—" : EffectiveServiceName)</h3>
                        <dl class="console-definition-list">
                            <dt>Service</dt><dd>@(_createNewService ? $"{EffectiveServiceName} (created on publish)" : Unknown(EffectiveServiceName))</dd>
                            <dt>Layer name</dt><dd>@(string.IsNullOrWhiteSpace(_layerName) ? Unknown(SelectedTable?.Table) : _layerName)</dd>
                            <dt>Layer slot</dt><dd>assigned by the server on publish</dd>
                            <dt>URL</dt><dd>@PublishedUrl</dd>
                        </dl>
                    </article>
                </div>
            </div>

            <aside class="publish-wizard-rail">
                @if (_published && _publishResult?.ServiceName is { } published)
                {
                    @UrlPreviewCard($"/rest/services/{published}/FeatureServer")
                }
                @PublishResultCallout
            </aside>
        </div>
    };

    // The published route only exists once the server has assigned the slot; before that this is an
    // honest placeholder rather than a guessed path.
    private string PublishedUrl =>
        _published && _publishResult?.ServiceName is { } service
            ? $"/rest/services/{service}/FeatureServer" + (_publishResult.LayerId is { } id ? $"/{id}" : string.Empty)
            : "assigned on publish";

    private RenderFragment PublishResultCallout => __builder =>
    {
        if (_publishResult is null)
        {
            return;
        }

        if (_publishResult.Succeeded)
        {
            <p class="publish-callout publish-callout-info" data-publish-result data-publish-state="published">
                Published @(_publishResult.LayerName ?? "layer")@(_publishResult.LayerId is { } id ? $" (layer {id})" : null) into @(_publishResult.ServiceName ?? "the service").
            </p>
        }
        else
        {
            <p class="publish-callout publish-callout-warning" data-publish-result data-publish-state="@_publishResult.State.ToLowerInvariant().Replace(' ', '-')">
                @_publishResult.Detail
            </p>
            @if (_publishResult.FieldErrors.Count > 0)
            {
                <ul class="publish-field-errors" data-publish-field-errors>
                    @foreach (var error in _publishResult.FieldErrors)
                    {
                        <li><strong>@(error.Path ?? error.FieldId ?? error.Code):</strong> @error.Message</li>
                    }
                </ul>
            }
        }
    };

    private RenderFragment UrlPreviewCard(string url) => __builder =>
    {
        <article class="console-panel publish-url-preview" data-url-preview>
            <h3>URL preview</h3>
            <code class="publish-url-value">@url</code>
            <button type="button" class="console-button console-button-secondary"
                    data-url-copy disabled="@string.IsNullOrWhiteSpace(url)"
                    @onclick="() => CopyUrlAsync(url)">@(_urlCopied ? "✓ Copied" : "⧉ Copy URL")</button>
        </article>
    };

    private bool _urlCopied;
    private IJSObjectReference? _clipboardModule;

    // Copy the previewed service/layer URL to the clipboard via the shared wwwroot clipboard module (same
    // pattern as CatalogItemEditorPage). Interop failures (prerender / bUnit / torn-down circuit) are
    // swallowed so the action never throws; the button simply does not flip to "Copied".
    private async Task CopyUrlAsync(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return;
        }

        try
        {
            _clipboardModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Honua.Console.Shell/catalog-item-editor.js");
            _urlCopied = await _clipboardModule.InvokeAsync<bool>("copyText", url);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            _urlCopied = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_clipboardModule is not null)
        {
            try
            {
                await _clipboardModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
            {
                // Circuit already gone; nothing to clean up browser-side.
            }
            finally
            {
                _clipboardModule = null;
            }
        }
    }
}
