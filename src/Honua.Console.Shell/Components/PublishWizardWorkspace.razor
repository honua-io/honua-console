                            class="publish-filter-chip @(_showLabels ? "publish-filter-chip-on" : null)"
                            aria-pressed="@_showLabels"
                            @onclick="ToggleLabels">labels</button>
                    <button type="button"
                            class="publish-filter-chip @(_showPopups ? "publish-filter-chip-on" : null)"
                            aria-pressed="@_showPopups"
                            @onclick="TogglePopups">popups</button>
                    <button type="button"
                            class="publish-filter-chip @(_showHighlight ? "publish-filter-chip-on" : null)"
                            aria-pressed="@_showHighlight"
                            @onclick="ToggleHighlight">highlight</button>
                </div>
            </div>

            <aside class="publish-wizard-rail">
                <p class="publish-callout publish-callout-info"><strong>What this is.</strong> A live render of the layer Honua will publish at this slot. Style and labels come from the canonical resource; popup fields and aliases come from this slot's overrides.</p>

                <article class="console-panel">
                    <h3>This slot</h3>
                    <dl class="console-definition-list">
                        <dt>Object ID</dt><dd>gid</dd>
                        <dt>Display field</dt><dd>parcel_id</dd>
                        <dt>Popup fields</dt><dd>4 (of 23 exposed)</dd>
                        <dt>Owner redacted</dt><dd><span class="console-status console-state-warning">yes</span></dd>
                        <dt>Labels at</dt><dd>1:500 – 1:25k</dd>
                        <dt>Cache TTL</dt><dd>30 min</dd>
                    </dl>
                </article>

                <article class="console-panel">
                    <h3>Compare against</h3>
                    <div class="publish-compare-row"><span>◇ Resource canonical</span><span class="console-muted">same style, all 24 fields</span></div>
                    <div class="publish-compare-row"><span>public-works-ms / layer 2</span><span class="console-muted">MapServer · rendered tiles</span></div>
                    <div class="publish-compare-row"><span>features-public / parcels_2024</span><span class="console-muted">OGC API · GeoJSON</span></div>
                    <div class="publish-compare-row"><span>stac-public</span><span class="console-muted">collection metadata only</span></div>
                </article>
                <p class="console-muted">Map uses 1k sampled features. The published service serves all 1.28M.</p>
            </aside>
        </div>
    };

    private RenderFragment AuthorAccessBody => __builder =>
