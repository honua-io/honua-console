@namespace Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IServiceLayerPublishOperation PublishOperation
@inject IOperateTransitionDataSource OperateData
@inject NavigationManager Nav
@inject IJSRuntime JS

@*
    Functional publish wizards for the Operate publishing workspace, implementing the design-handoff
    flows in docs/design-handoff/console-canvas/screens-quick-publish.jsx (Quick publish: Service →
    Layer → Review) and screens-publish-flow.jsx (Author resource first: Target → Compatibility →
    Slot → Fields → Projection → Access → Review).

    The mode toggle (PublishModeBar) swaps which flow is active, and the stepper navigation is FULLY
    FUNCTIONAL — each forward/back control moves between real step bodies, with per-step validity
    gating (you cannot continue past a picker until a row is selected). The pickers bind to REAL
    honua-server state: the source context is the operator's selected connection + PostGIS table
    (IServiceLayerPublishOperation.ListTablesAsync), the service tree is the live services projection
    (IOperateTransitionDataSource), and the resource table is the publishable tables on the selected
    connection. None of it is fabricated — when no server is configured (or nothing is selected yet)
    each section renders an honest empty / "select a source" state instead of mock rows (Console
    Patterns Charter section 11).

    The FINISH action is wired to a REAL service-layer-publish operation (issue #144): on finish the
    flow drives IServiceLayerPublishOperation, which POSTs to honua-server's admin layer-publishing
    endpoint when a server base URL is configured, and surfaces an explicit missing-binding result
    otherwise (never a fabricated success). The live registry reads / republish / rollback stay on the
    data source the page already binds.
*@

@SourcePicker

<PublishModeBar Mode="_mode" ModeChanged="OnModeChanged" />

@if (_mode == PublishModeBar.PublishMode.Quick)
{
    <PublishWizard Steps="@QuickStepList"
                   Current="_quickCurrent"
                   CurrentChanged="OnQuickCurrentChanged"
                   Kicker="Quick publish"
                   Title="Publish a layer in three steps"
                   FinishLabel="Publish + open resource →"
                   OnFinish="OnFinish" />
}
else
{
    <PublishWizard Steps="@AuthorStepList"
                   Current="_authorCurrent"
                   CurrentChanged="OnAuthorCurrentChanged"
                   Kicker="Author resource first"
                   Title="Publish this resource into a service slot"
                   FinishLabel="Validate and publish →"
                   OnFinish="OnFinish" />
}

@code {
    // ---- Source context: the operator's selected connection + PostGIS table (REAL server state). ----
    // Nothing is fabricated; until a source is picked these stay null and the bodies render the honest
    // "select a source" state. The summary is derived from the live table metadata.
    private IReadOnlyList<OperateConnectionSummary> _connections = [];
    private IReadOnlyList<OperateServiceDetail> _services = [];
    private IReadOnlyList<ServiceLayerPublishTable> _tables = [];
    private bool _loadingTables;

    private string? _sourceConnectionId;
    private string? _sourceTableKey;        // qualified name (schema.table) of the selected table
    private ServiceLayerPublishTable? SelectedTable =>
        _sourceTableKey is null
            ? null
            : _tables.FirstOrDefault(t => t.QualifiedName == _sourceTableKey);

    private string? SourceConnection => _sourceConnectionId;
    private string? SourceTable => SelectedTable?.QualifiedName;
    private string? SourceSummary
    {
        get
        {
            if (SelectedTable is not { } t)
            {
                return null;
            }

            var parts = new List<string>();
            if (t.GeometryType is { Length: > 0 } gt) parts.Add(gt);
            if (t.Srid is { } srid) parts.Add(srid.ToString());
            if (t.EstimatedRows is { } rows) parts.Add($"~{rows:N0} rows");
            if (t.Columns.Count > 0) parts.Add($"{t.Columns.Count} fields");
            return parts.Count > 0 ? string.Join(" · ", parts) : null;
        }
    }

    private PublishModeBar.PublishMode _mode = PublishModeBar.PublishMode.Quick;

    // ---- Quick-publish flow state ----
    private int _quickCurrent;
    private bool _createNewService;          // service step: use-existing vs create-new
    private string? _selectedServiceId;
    private bool _createNewResource;         // layer step: bind-existing vs create-new
    private bool _registerCatalog = true;
    private string _newServiceName = string.Empty;   // create-new-service: real, operator-entered name

    // The selected resource is the source table chosen in the source picker.
    private string? SelectedResourceName => SelectedTable?.Table;

    // ---- Author-first flow state ----
    private int _authorCurrent;
    private bool _authorCreateNewService;
    private string? _authorTargetId;
    private bool _published;
    private ServiceLayerPublishResult? _publishResult;

    // ---- Clipboard interop (URL preview "Copy URL") — reuses the shared wwwroot clipboard module. ----
    private IJSObjectReference? _clipboardModule;

    protected override async Task OnInitializedAsync()
    {
        var connectionsView = await OperateData.GetConnectionsViewAsync();
        _connections = connectionsView.Connections;

        var servicesView = await OperateData.GetServicesViewAsync();
        _services = servicesView.Services;
    }

    private async Task OnSourceConnectionChanged(ChangeEventArgs e)
    {
        _sourceConnectionId = string.IsNullOrWhiteSpace((string?)e.Value) ? null : (string?)e.Value;
        _sourceTableKey = null;
        _tables = [];
        _publishResult = null;
        _published = false;

        if (_sourceConnectionId is null)
        {
            return;
        }

        _loadingTables = true;
        try
        {
            _tables = await PublishOperation.ListTablesAsync(_sourceConnectionId);
        }
        finally
        {
            _loadingTables = false;
        }
    }

    private void OnSourceTableChanged(ChangeEventArgs e)
    {
        _sourceTableKey = string.IsNullOrWhiteSpace((string?)e.Value) ? null : (string?)e.Value;
        _publishResult = null;
        _published = false;
    }

    private void NavigateTo(string url) => Nav.NavigateTo(url);

    // Copy the URL preview to the clipboard via the shared wwwroot clipboard module (same pattern as
    // CatalogItemEditorPage). Interop failures (prerender / bUnit / torn-down circuit) are swallowed.
    private async Task CopyUrlAsync(string url)
    {
        try
        {
            _clipboardModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Honua.Console.Shell/catalog-item-editor.js");
            await _clipboardModule.InvokeAsync<bool>("copyText", url);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            // Clipboard unavailable in this context; the action is a no-op rather than throwing.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_clipboardModule is not null)
        {
            try
            {
                await _clipboardModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
            {
                // Circuit already gone; nothing to clean up browser-side.
            }
            finally
            {
                _clipboardModule = null;
            }
        }
    }

    // ---- Projection preview controls (shared by both Projection steps) ----
    private bool _showLabels = true;
    private bool _showPopups = true;
    private bool _showHighlight;
    private string _activeBasemap = "light";

    private void OnModeChanged(PublishModeBar.PublishMode mode) => _mode = mode;

    private void OnQuickCurrentChanged(int next) => _quickCurrent = next;

    private void OnAuthorCurrentChanged(int next) => _authorCurrent = next;

    // Drives the REAL service-layer-publish operation (issue #144). The command is built from the
    // operator's selected source table + the slot picked in the active flow; when no source/service is
    // selected, or no server is configured, the operation returns a missing-binding/validation result
    // and nothing is fabricated.
    private async Task OnFinish()
    {
        if (SelectedTable is not { } table || _sourceConnectionId is null)
        {
            _publishResult = ServiceLayerPublishResult.MissingBinding(
                "Select a source connection and table before publishing.");
            _published = false;
            return;
        }

        // Build the target from the ACTIVE flow so the POST lands in the slot the review step showed:
        // quick mode reads the quick service state, author-first reads the author target. Create-new
        // uses the operator-entered service name.
        var serviceName = _mode == PublishModeBar.PublishMode.AuthorFirst
            ? (_authorCreateNewService ? _newServiceName : _authorTargetId)
            : (_createNewService ? _newServiceName : _selectedServiceId);

        if (string.IsNullOrWhiteSpace(serviceName))
        {
            _publishResult = ServiceLayerPublishResult.MissingBinding(
                _createNewService || _authorCreateNewService
                    ? "Name the new service before publishing, or pick an existing service."
                    : "Select a target service before publishing.");
            _published = false;
            return;
        }

        var command = new ServiceLayerPublishCommand
        {
            ConnectionId = _sourceConnectionId,
            Schema = table.Schema,
            Table = table.Table,
            LayerName = SelectedResourceName ?? table.Table,
            ServiceName = serviceName,
            GeometryColumn = table.GeometryColumn,
            GeometryType = table.GeometryType,
            Srid = table.Srid,
            Fields = table.Columns,
            Enabled = true
        };

        _publishResult = await PublishOperation.PublishAsync(command);
        _published = _publishResult.Succeeded;
    }

    private void ToggleLabels() => _showLabels = !_showLabels;
    private void TogglePopups() => _showPopups = !_showPopups;
    private void ToggleHighlight() => _showHighlight = !_showHighlight;

    private Task OnBasemapChanged(MapPreviewBasemap basemap)
    {
        _activeBasemap = basemap.Id;
        return Task.CompletedTask;
    }

    // ===================================================================================
    //  Shared data: the projection-preview legend / basemaps (schematic styling for the live
    //  MapPreview, not server state). The service tree and resource table bind to REAL server data
    //  loaded in OnInitializedAsync (_services / _tables); there is no fabricated tree/resource data.
    // ===================================================================================

    private static readonly IReadOnlyList<MapPreviewLegendEntry> AreaLegend =
    [
        new("0 – 740 m²", "#f7f4e8"),
        new("740 – 1,420", "#ead78a"),
        new("1,420 – 2,140", "#d9a23a"),
        new("2,140 – 3,920", "#b56b1c"),
        new("3,920+", "#612d0a"),
    ];

    private static readonly IReadOnlyList<MapPreviewBasemap> Basemaps =
    [
        new("light", "Light"),
        new("imagery", "Imagery"),
        new("terrain", "Terrain"),
    ];

    private OperateServiceDetail? SelectedService(string? name) =>
        name is null ? null : _services.FirstOrDefault(s => s.Name == name);

    // ===================================================================================
    //  QUICK-PUBLISH STEPS: Service → Layer → Review
    // ===================================================================================

    private IReadOnlyList<PublishWizardStep> QuickStepList =>
    [
        new PublishWizardStep(
            "Service",
            QuickServiceBody,
            IsValid: _createNewService || _selectedServiceId is not null,
            ContinueLabel: "Continue · Layer →"),
        new PublishWizardStep(
            "Layer",
            QuickLayerBody,
            IsValid: SelectedTable is not null,
            ContinueLabel: "Continue · Review →"),
        new PublishWizardStep("Review", QuickReviewBody),
    ];

    private RenderFragment QuickServiceBody => __builder =>
    {
        <div class="publish-wizard-grid" data-quick-step="service">
            <div class="publish-wizard-main">
                <h3 class="publish-wizard-question">What service should this layer live in?</h3>
                <p class="console-muted">A service is the container. Service-level settings (CRS, capabilities, cache) live here; layer-specific settings come next.</p>

                <div class="publish-segment" role="group" aria-label="Service mode">
                    <button type="button"
                            class="publish-segment-option @(_createNewService ? null : "publish-segment-active")"
                            aria-pressed="@(!_createNewService)"
                            @onclick="() => _createNewService = false">
                        Use existing service
                    </button>
                    <button type="button"
                            class="publish-segment-option @(_createNewService ? "publish-segment-active" : null)"
                            aria-pressed="@_createNewService"
                            @onclick="() => _createNewService = true">
                        Create new service
                    </button>
                </div>

                @if (!_createNewService)
                {
                    @ServiceTree(_selectedServiceId, name => _selectedServiceId = name)
                    <div class="publish-create-affordance">
                        <strong>Don't see what you want?</strong>
                        <button type="button" class="console-button console-button-secondary" @onclick="() => _createNewService = true">Create new service…</button>
                        <p class="console-muted">New services have their own settings step — CRS, capabilities, max record count, cache, output formats — before you get to the layer.</p>
                    </div>
                }
                else
                {
                    @NewServiceCards
                }
            </div>

            <aside class="publish-wizard-rail">
                @if (!_createNewService && SelectedService(_selectedServiceId) is { } svc)
                {
                    <article class="console-panel">
                        <h3>You're publishing into</h3>
                        <dl class="console-definition-list">
                            <dt>Service</dt><dd>@(string.IsNullOrWhiteSpace(svc.DisplayName) ? svc.Name : svc.DisplayName)</dd>
                            <dt>Kind</dt><dd>@svc.ServiceType</dd>
                            <dt>Runtime</dt><dd>@svc.RuntimeStatus</dd>
                            <dt>Layers</dt><dd>@svc.Layers.Count</dd>
                            <dt>Metadata</dt><dd>@svc.MetadataOwnership</dd>
                        </dl>
                    </article>
                    <p class="publish-callout publish-callout-info">When you reuse an existing service you accept its settings (CRS, capabilities, cache) as-is; they're shared by every layer. To use different service-level settings, create a new one.</p>
                }
                else
                {
                    <article class="console-panel">
                        <h3>What gets created</h3>
                        <p class="console-muted">A new service will be created when you publish. Its identity and runtime settings are set in the cards on the left.</p>
                    </article>
                }
            </aside>
        </div>
    };

    private RenderFragment QuickLayerBody => __builder =>
    {
        var svc = SelectedService(_selectedServiceId);
        <div class="publish-wizard-grid" data-quick-step="layer">
            <div class="publish-wizard-main">
                <div class="publish-context-bar">
                    <span>◈ @(_createNewService ? "new service" : svc is { } s ? (string.IsNullOrWhiteSpace(s.DisplayName) ? s.Name : s.DisplayName) : "select a service")</span>
                    @if (svc is { } svcDetail)
                    {
                        <span class="console-muted">@svcDetail.ServiceType · @svcDetail.RuntimeStatus</span>
                    }
                </div>

                <h3 class="publish-wizard-question">What does this layer expose?</h3>
                <p class="console-muted">A layer is backed by exactly one Data Resource.</p>

                <div class="publish-segment" role="group" aria-label="Layer resource mode">
                    <button type="button"
                            class="publish-segment-option @(_createNewResource ? null : "publish-segment-active")"
                            aria-pressed="@(!_createNewResource)"
                            @onclick="() => _createNewResource = false">
                        Bind existing resource
                    </button>
                    <button type="button"
                            class="publish-segment-option @(_createNewResource ? "publish-segment-active" : null)"
                            aria-pressed="@_createNewResource"
                            @onclick="() => _createNewResource = true">
                        Create new resource
                    </button>
                </div>

                <p class="publish-callout publish-callout-info"><strong>One resource, many layers.</strong> The same Data Resource can back layers in multiple services — all share the same canonical fields and metadata.</p>

                @if (!_createNewResource)
                {
                    @ResourceTable
                }
                else
                {
                    @NewResourceCards
                }
            </div>

            <aside class="publish-wizard-rail">
                <article class="console-panel">
                    <h3>Picked resource</h3>
                    @if (SelectedTable is { } t)
                    {
                        <dl class="console-definition-list">
                            <dt>Table</dt><dd>◇ @t.QualifiedName</dd>
                            <dt>Geometry</dt><dd>@(t.GeometryType ?? "—")@(t.Srid is { } srid ? $" · {srid}" : null)</dd>
                            <dt>Rows (est.)</dt><dd>@(t.EstimatedRows is { } rows ? rows.ToString("N0") : "—")</dd>
                            <dt>Fields</dt><dd>@(t.Columns.Count > 0 ? t.Columns.Count.ToString() : "—")</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="console-muted">Select a source table to bind this layer to.</p>
                    }
                </article>
            </aside>
        </div>
    };

    private RenderFragment QuickReviewBody => __builder =>
    {
        var svc = SelectedService(_selectedServiceId);
        var serviceLabel = _createNewService ? "new service" : svc is { } s ? (string.IsNullOrWhiteSpace(s.DisplayName) ? s.Name : s.DisplayName) : "—";
        <div class="publish-wizard-grid" data-quick-step="review">
            <div class="publish-wizard-main">
                <div class="publish-context-bar">
                    <span>◈ @serviceLabel</span>
                    <span aria-hidden="true">›</span>
                    <span>◇ @(SelectedResourceName ?? "—")</span>
                    <span class="publish-context-spacer"></span>
                    <span class="console-status @(SelectedTable is not null && (_createNewService || _selectedServiceId is not null) ? "console-state-success" : "console-state-warning")">@(SelectedTable is not null && (_createNewService || _selectedServiceId is not null) ? "ready" : "incomplete")</span>
                </div>

                <h3 class="publish-wizard-question">Ready to publish</h3>
                <p class="console-muted">The selected table is published as a new layer slot in the target service. Existing service settings are applied unchanged.</p>

                <div class="publish-review-stack">
                    <article class="console-panel">
                        <h3>◇ Data Resource · @(SelectedResourceName ?? "—")</h3>
                        @if (SelectedTable is { } t)
                        {
                            <dl class="console-definition-list">
                                <dt>Source</dt><dd>@(SourceConnection ?? "—") / @(SourceTable ?? "—")</dd>
                                <dt>Geometry</dt><dd>@(t.GeometryColumn is { Length: > 0 } gc ? $"{gc} · " : null)@(t.GeometryType ?? "—")@(t.Srid is { } srid ? $" · {srid}" : null)</dd>
                                <dt>Rows (est.)</dt><dd>@(t.EstimatedRows is { } rows ? rows.ToString("N0") : "—")</dd>
                                <dt>Fields</dt><dd>@(t.Columns.Count > 0 ? t.Columns.Count.ToString() : "—")</dd>
                            </dl>
                        }
                        else
                        {
                            <p class="console-muted">No source table selected.</p>
                        }
                    </article>
                    <div class="publish-review-bind">↓ binds to ↓</div>
                    <article class="console-panel publish-review-layer">
                        <h3>◈ @serviceLabel / @(SelectedResourceName ?? "layer") <span class="console-status console-state-success">publication</span></h3>
                        <dl class="console-definition-list">
                            <dt>Target service</dt><dd>@serviceLabel</dd>
                            <dt>Service settings</dt><dd>inherited from the target service unchanged</dd>
                        </dl>
                    </article>
                </div>
            </div>

            <aside class="publish-wizard-rail">
                <p class="publish-callout publish-callout-info"><strong>Service settings are unchanged.</strong> The target service's CRS, capabilities, cache, anonymous access, and output formats all apply to the new layer.</p>
                @PublishResultCallout
            </aside>
        </div>
    };

    private RenderFragment PublishResultCallout => __builder =>
    {
        if (_publishResult is null)
        {
            return;
        }

        if (_publishResult.Succeeded)
        {
            <p class="publish-callout publish-callout-info" data-publish-result data-publish-state="published">
                Published @(_publishResult.LayerName ?? "layer")@(_publishResult.LayerId is { } id ? $" (layer {id})" : null) into @(_publishResult.ServiceName ?? "the service"). The layer slot is now live and queryable; unpublish reverses it in one click.
            </p>
        }
        else
        {
            <p class="publish-callout publish-callout-warning" data-publish-result data-publish-state="@_publishResult.State.ToLowerInvariant().Replace(' ', '-')">
                @_publishResult.Detail
            </p>
            @if (_publishResult.FieldErrors.Count > 0)
            {
                <ul class="publish-field-errors" data-publish-field-errors>
                    @foreach (var error in _publishResult.FieldErrors)
                    {
                        <li><strong>@(error.Path ?? error.FieldId ?? error.Code):</strong> @error.Message</li>
                    }
                </ul>
            }
        }
    };

    // ===================================================================================
    //  AUTHOR-FIRST STEPS: Target → Compatibility → Slot → Fields → Projection → Access → Review
    // ===================================================================================

    private IReadOnlyList<PublishWizardStep> AuthorStepList =>
    [
        new PublishWizardStep(
            "Target",
            AuthorTargetBody,
            IsValid: _authorCreateNewService || _authorTargetId is not null,
            ContinueLabel: "Continue · Compatibility →"),
        new PublishWizardStep("Compatibility", AuthorCompatibilityBody, ContinueLabel: "Continue · Slot →"),
        new PublishWizardStep("Slot", AuthorSlotBody, ContinueLabel: "Continue · Fields →"),
        new PublishWizardStep("Fields", AuthorFieldsBody, ContinueLabel: "Continue · Projection →"),
        new PublishWizardStep("Projection", AuthorProjectionBody, ContinueLabel: "Continue · Access →"),
        new PublishWizardStep("Access", AuthorAccessBody, ContinueLabel: "Continue · Review →"),
        new PublishWizardStep("Review", AuthorReviewBody),
    ];

    private RenderFragment AuthorContext => __builder =>
    {
        <div class="publish-context-bar" data-author-context>
            <span>◇ @(SelectedResourceName ?? "select a source")</span>
            @if (SourceSummary is { } summary)
            {
                <span class="console-muted">· @summary</span>
            }
        </div>
    };

    private RenderFragment AuthorTargetBody => __builder =>
    {
        @AuthorContext
        <div class="publish-wizard-grid" data-author-step="target">
            <div class="publish-wizard-main">
                <h3 class="publish-wizard-question">Where should this resource appear?</h3>
                <p class="console-muted">Pick a folder + service to drop a new layer slot into. We'll tell you in step 2 what's compatible.</p>

                <div class="publish-segment" role="group" aria-label="Target mode">
                    <button type="button"
                            class="publish-segment-option @(_authorCreateNewService ? null : "publish-segment-active")"
                            aria-pressed="@(!_authorCreateNewService)"
                            @onclick="() => _authorCreateNewService = false">
                        Use existing service
                    </button>
                    <button type="button"
                            class="publish-segment-option @(_authorCreateNewService ? "publish-segment-active" : null)"
                            aria-pressed="@_authorCreateNewService"
                            @onclick="() => _authorCreateNewService = true">
                        Create new service
                    </button>
                </div>

                @if (!_authorCreateNewService)
                {
                    @ServiceTree(_authorTargetId, name => _authorTargetId = name)
                }
                else
                {
                    @InlineNewServiceCard
                }
            </div>

            <aside class="publish-wizard-rail">
                <p class="publish-callout publish-callout-info"><strong>One resource → many slots.</strong> A resource can sit in many services at once. Each slot overrides layer name / aliases / field exposure, but never the meaning.</p>
                <p class="console-muted">Publish creates a new publication record in the selected service; existing slots are untouched.</p>
            </aside>
        </div>
    };

    private RenderFragment AuthorCompatibilityBody => __builder =>
    {
        var target = SelectedService(_authorTargetId);
        @AuthorContext
        <div class="publish-wizard-grid" data-author-step="compatibility">
            <div class="publish-wizard-main">
                <h3 class="publish-wizard-question">What can this target carry?</h3>
                <p class="console-muted">Each output format carries the resource differently. Honua flags anything degraded before you commit.</p>
                <div class="console-table-wrap">
                    <table class="console-table">
                        <thead>
                            <tr><th>Format</th><th>Carries</th><th>Support</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>FeatureServer</td><td>Vector features + attributes</td><td><span class="console-status console-state-success">full</span></td></tr>
                            <tr><td>MapServer</td><td>Rendered tiles</td><td><span class="console-status console-state-success">full</span></td></tr>
                            <tr><td>OGC API Features</td><td>GeoJSON collections</td><td><span class="console-status console-state-success">full</span></td></tr>
                            <tr><td>OData</td><td>WKB geometry column</td><td><span class="console-status console-state-warning">degraded</span></td></tr>
                            <tr><td>ImageServer</td><td>Raster only</td><td><span class="console-status console-state-danger">incompatible</span></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <aside class="publish-wizard-rail">
                <article class="console-panel">
                    <h3>Selected target</h3>
                    @if (_authorCreateNewService)
                    {
                        <p class="console-muted">A new service (configured in the previous step) will receive this layer as its first slot.</p>
                    }
                    else if (target is { } svc)
                    {
                        <dl class="console-definition-list">
                            <dt>Service</dt><dd>@(string.IsNullOrWhiteSpace(svc.DisplayName) ? svc.Name : svc.DisplayName)</dd>
                            <dt>Kind</dt><dd>@svc.ServiceType</dd>
                            <dt>Layers</dt><dd>@svc.Layers.Count</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="console-muted">No target service selected.</p>
                    }
                </article>
                <p class="publish-callout publish-callout-info">Nothing here re-defines the resource — only how it appears in this slot.</p>
            </aside>
        </div>
    };

    private RenderFragment AuthorSlotBody => __builder =>
    {
        @AuthorContext
        <div class="publish-wizard-grid" data-author-step="slot">
            <div class="publish-wizard-main">
                <h3 class="publish-wizard-question">Configure the layer slot</h3>
                <article class="console-panel">
                    <h3>Identity</h3>
                    <div class="publish-field-grid">
                        <label class="publish-field"><span>Layer name</span><input class="console-input" value="@(SelectedResourceName ?? "")" placeholder="layer name" readonly /></label>
                        <label class="publish-field"><span>Target service</span><input class="console-input" value="@(_authorCreateNewService ? "new service" : SelectedService(_authorTargetId) is { } svc ? (string.IsNullOrWhiteSpace(svc.DisplayName) ? svc.Name : svc.DisplayName) : "")" placeholder="select a service" readonly /></label>
                    </div>
                    <p class="console-muted">The layer ID and route are assigned by honua-server when the layer is published into the service.</p>
                </article>
            </div>
            <aside class="publish-wizard-rail">
                <p class="publish-callout publish-callout-info">The layer ID is the next free slot in this service. The route is derived from the service kind + folder + name.</p>
            </aside>
        </div>
    };

    private RenderFragment AuthorFieldsBody => __builder =>
    {
        @AuthorContext
        <div class="publish-wizard-grid" data-author-step="fields">
            <div class="publish-wizard-main">
                <h3 class="publish-wizard-question">Choose field exposure &amp; aliases</h3>
                <p class="console-muted">These ride on top of the resource's canonical fields. They brand this slot only; none of it changes the resource.</p>
                @LayerFieldsCard
            </div>
            <aside class="publish-wizard-rail">
                <p class="publish-callout publish-callout-info">Field aliases &amp; hidden fields are layer-level. Canonical fields and PII flags are resource-level.</p>
            </aside>
        </div>
    };

    private RenderFragment AuthorProjectionBody => __builder =>
    {
        @AuthorContext
        <div class="publish-wizard-grid" data-author-step="projection">
            <div class="publish-wizard-main">
                <h3 class="publish-wizard-question">Preview how this layer will look</h3>

                <MapPreview Mode="MapPreviewMode.Layer"
                            Height="420"
                            ScaleText="1:500"
                            ShowLabels="_showLabels"
                            ShowPopup="_showPopups"
                            ShowHighlight="_showHighlight"
                            Legend="AreaLegend"
                            LegendTitle="Class breaks"
                            Basemaps="Basemaps"
                            ActiveBasemapId="_activeBasemap"
                            OnBasemapChanged="OnBasemapChanged"
                            AriaLabel="Layer projection preview" />

                <div class="publish-preview-controls" data-projection-controls>
                    <span class="console-muted">Preview controls</span>
                    <span class="publish-context-spacer"></span>
                    <span class="console-muted">scale</span>
                    <span>1:500</span>
                    <input type="range" min="0" max="100" value="60" aria-label="Preview scale" />
                    <span>1:15M</span>
                    <button type="button"
                            class="publish-filter-chip @(_showLabels ? "publish-filter-chip-on" : null)"
                            aria-pressed="@_showLabels"
                            @onclick="ToggleLabels">labels</button>
                    <button type="button"
                            class="publish-filter-chip @(_showPopups ? "publish-filter-chip-on" : null)"
                            aria-pressed="@_showPopups"
                            @onclick="TogglePopups">popups</button>
                    <button type="button"
                            class="publish-filter-chip @(_showHighlight ? "publish-filter-chip-on" : null)"
                            aria-pressed="@_showHighlight"
                            @onclick="ToggleHighlight">highlight</button>
                </div>
            </div>

            <aside class="publish-wizard-rail">
                <p class="publish-callout publish-callout-info"><strong>What this is.</strong> A schematic render of how the layer will be projected at this slot. Style and labels come from the canonical resource; popup fields and aliases come from this slot's overrides.</p>

                <article class="console-panel">
                    <h3>This slot</h3>
                    @if (SelectedTable is { } t)
                    {
                        <dl class="console-definition-list">
                            <dt>Resource</dt><dd>@t.QualifiedName</dd>
                            <dt>Geometry</dt><dd>@(t.GeometryType ?? "—")@(t.Srid is { } srid ? $" · {srid}" : null)</dd>
                            <dt>Fields</dt><dd>@(t.Columns.Count > 0 ? t.Columns.Count.ToString() : "—")</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="console-muted">Select a source table to preview its projection.</p>
                    }
                </article>
            </aside>
        </div>
    };

    private RenderFragment AuthorAccessBody => __builder =>
    {
        @AuthorContext
        <div class="publish-wizard-grid" data-author-step="access">
            <div class="publish-wizard-main">
                <h3 class="publish-wizard-question">Confirm access impact</h3>
                <article class="console-panel">
                    <h3>Access</h3>
                    <dl class="console-definition-list">
                        <dt>Anonymous access</dt><dd>Inherit from the target service</dd>
                        <dt>Max record count</dt><dd>Inherit from the target service</dd>
                    </dl>
                </article>
                <p class="publish-callout publish-callout-info">Public read exposes every non-hidden attribute. Fields flagged PII on the resource stay redacted in this slot.</p>
            </div>
            <aside class="publish-wizard-rail">
                <p class="publish-callout publish-callout-info">Access defaults come from the resource. Override per-slot only when this layer must differ.</p>
            </aside>
        </div>
    };

    private RenderFragment AuthorReviewBody => __builder =>
    {
        @AuthorContext
        <div class="publish-wizard-grid" data-author-step="review">
            <div class="publish-wizard-main">
                @{
                    var target = SelectedService(_authorTargetId);
                    var serviceLabel = _authorCreateNewService ? "new service" : target is { } s ? (string.IsNullOrWhiteSpace(s.DisplayName) ? s.Name : s.DisplayName) : "—";
                }
                <h3 class="publish-wizard-question">Validate &amp; publish</h3>
                <div class="publish-review-stack">
                    <article class="console-panel">
                        <h3>◇ Data Resource · @(SelectedResourceName ?? "—") <span class="console-status console-state-neutral">canonical</span></h3>
                        @if (SelectedTable is { } t)
                        {
                            <dl class="console-definition-list">
                                <dt>Source</dt><dd>@(SourceConnection ?? "—") / @(SourceTable ?? "—")</dd>
                                <dt>Geometry</dt><dd>@(t.GeometryType ?? "—")@(t.Srid is { } srid ? $" · {srid}" : null)</dd>
                            </dl>
                        }
                        else
                        {
                            <p class="console-muted">No source table selected.</p>
                        }
                    </article>
                    <div class="publish-review-bind">↓ binds to ↓</div>
                    <article class="console-panel publish-review-layer">
                        <h3>◈ @serviceLabel / @(SelectedResourceName ?? "layer") <span class="console-status console-state-success">publication</span></h3>
                        <dl class="console-definition-list">
                            <dt>Target service</dt><dd>@serviceLabel</dd>
                            <dt>Layer id / route</dt><dd>assigned by honua-server on publish</dd>
                        </dl>
                    </article>
                </div>
            </div>
            <aside class="publish-wizard-rail">
                @PublishResultCallout
            </aside>
        </div>
    };

    // ===================================================================================
    //  Shared body fragments
    // ===================================================================================

    // Source picker — the operator's real connection + PostGIS table. This is the wizard's source
    // context; everything downstream reads from the selected table (no fabricated connection/table/rows).
    private RenderFragment SourcePicker => __builder =>
    {
        <article class="console-panel" data-source-picker>
            <h3>Source</h3>
            <p class="console-muted">Pick the connection and table this layer will publish from. Geometry, SRID, row estimate, and fields come from the live table.</p>
            @if (_connections.Count == 0)
            {
                <p class="console-callout publish-callout publish-callout-warning" data-source-empty>
                    No data connections are available. <a href="/operate/connections/new">Add a connection</a> (and test it) first, then return here to publish a table from it.
                </p>
            }
            else
            {
                <div class="publish-field-grid">
                    <label class="publish-field">
                        <span>Connection</span>
                        <select class="console-input" aria-label="Source connection" value="@_sourceConnectionId" @onchange="OnSourceConnectionChanged">
                            <option value="">Select a connection…</option>
                            @foreach (var connection in _connections)
                            {
                                <option value="@connection.Id">@connection.Name (@connection.Provider)</option>
                            }
                        </select>
                    </label>
                    <label class="publish-field">
                        <span>Table</span>
                        <select class="console-input" aria-label="Source table" value="@_sourceTableKey" @onchange="OnSourceTableChanged" disabled="@(_tables.Count == 0)">
                            <option value="">@(_loadingTables ? "Loading tables…" : _sourceConnectionId is null ? "Select a connection first" : _tables.Count == 0 ? "No publishable tables on this connection" : "Select a table…")</option>
                            @foreach (var table in _tables)
                            {
                                <option value="@table.QualifiedName">@table.QualifiedName@(table.GeometryType is { Length: > 0 } gt ? $" · {gt}" : "")</option>
                            }
                        </select>
                    </label>
                </div>
                @if (SelectedTable is { } t)
                {
                    <dl class="console-definition-list" data-source-summary>
                        <dt>Geometry</dt><dd>@(t.GeometryType ?? "—")@(t.GeometryColumn is { Length: > 0 } gc ? $" ({gc})" : "")</dd>
                        <dt>SRID</dt><dd>@(t.Srid?.ToString() ?? "—")</dd>
                        <dt>Rows (estimated)</dt><dd>@(t.EstimatedRows is { } rows ? rows.ToString("N0") : "—")</dd>
                        <dt>Fields</dt><dd>@(t.Columns.Count > 0 ? t.Columns.Count.ToString() : "—")</dd>
                    </dl>
                }
            }
        </article>
    };

    // Live service tree — the real services projection from honua-server. No fabricated rows; when no
    // services exist (or no server is configured) it renders an honest empty state.
    private RenderFragment ServiceTree(string? selectedName, Action<string> onSelect) => __builder =>
    {
        if (_services.Count == 0)
        {
            <p class="publish-callout publish-callout-info" data-publish-tree-empty>
                No services are available yet. Create a new service below, or <a href="/operate/services">manage services</a> first.
            </p>
            return;
        }

        <div class="publish-tree" role="listbox" aria-label="Target services" data-publish-tree>
            @foreach (var service in _services)
            {
                var selected = service.Name == selectedName;
                <button type="button"
                        class="publish-tree-row @(selected ? "publish-tree-row-selected" : null)"
                        role="option"
                        aria-selected="@selected"
                        @onclick="() => onSelect(service.Name)">
                    <input type="radio" checked="@selected" tabindex="-1" />
                    <span class="publish-tree-glyph">◈</span>
                    <span class="publish-tree-body">
                        <span class="publish-tree-name">@(string.IsNullOrWhiteSpace(service.DisplayName) ? service.Name : service.DisplayName) <span class="console-status console-state-neutral">@service.ServiceType</span></span>
                        <span class="publish-tree-meta">@service.Layers.Count layer@(service.Layers.Count == 1 ? null : "s") · @service.RuntimeStatus</span>
                    </span>
                </button>
            }
        </div>
    };

    // Resource table — the publishable PostGIS tables on the selected source connection (REAL). No
    // fabricated rows / feature counts / PII flags; honest empty states when nothing is selected/found.
    private RenderFragment ResourceTable => __builder =>
    {
        if (_sourceConnectionId is null)
        {
            <p class="publish-callout publish-callout-info" data-resource-empty>Select a source connection above to list its publishable tables.</p>
        }
        else if (_loadingTables)
        {
            <p class="console-muted" data-resource-loading>Loading tables…</p>
        }
        else if (_tables.Count == 0)
        {
            <p class="publish-callout publish-callout-warning" data-resource-empty>No publishable (spatial) tables were found on this connection.</p>
        }
        else
        {
            <div class="console-table-wrap publish-resource-table" data-resource-table>
                <table class="console-table">
                    <thead>
                        <tr><th></th><th>Table</th><th>Geometry</th><th>SRID</th><th>Rows (est.)</th><th>Fields</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _tables)
                        {
                            var selected = r.QualifiedName == _sourceTableKey;
                            <tr class="@(selected ? "publish-resource-row-selected" : null)">
                                <td>
                                    <input type="radio"
                                           name="quick-resource"
                                           checked="@selected"
                                           @onchange="() => _sourceTableKey = r.QualifiedName" />
                                </td>
                                <td>◇ <strong>@r.QualifiedName</strong></td>
                                <td><span class="console-status console-state-neutral">@(r.GeometryType ?? "—")</span></td>
                                <td>@(r.Srid?.ToString() ?? "—")</td>
                                <td>@(r.EstimatedRows is { } rows ? rows.ToString("N0") : "—")</td>
                                <td>@(r.Columns.Count > 0 ? r.Columns.Count.ToString() : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="console-chip-row publish-resource-actions">
            <button type="button" class="console-button console-button-secondary" @onclick="@(() => NavigateTo("/operate/connections/new"))">+ Create from connection</button>
            <button type="button" class="console-button console-button-secondary" @onclick="@(() => NavigateTo("/operate/resources/import"))">+ Create from file</button>
        </div>
    };

    private RenderFragment NewServiceCards => __builder =>
    {
        <article class="console-panel" data-new-service="identity">
            <h3>Identity</h3>
            <div class="publish-field-grid">
                <label class="publish-field">
                    <span>Service name</span>
                    <input class="console-input" @bind="_newServiceName" @bind:event="oninput" placeholder="my-service (use folder/service to nest)" />
                </label>
            </div>
            <p class="console-muted">Use <code>folder/service</code> to nest under a folder. The service kind, route, and runtime defaults (CRS, capabilities, cache, output formats) are applied by honua-server when the service is created on publish.</p>
        </article>
        <article class="console-panel" data-new-service="catalog">
            <h3>Register in catalog</h3>
            <label class="publish-catalog-toggle">
                <input type="checkbox" checked="@_registerCatalog" @onchange="e => _registerCatalog = (bool)e.Value!" />
                <span>Register in Esri catalog</span>
                <span class="console-status console-state-info">default on</span>
            </label>
        </article>
    };

    private RenderFragment NewResourceCards => __builder =>
    {
        <article class="console-panel" data-new-resource="source">
            <h3>1. Where's the data?</h3>
            @if (SelectedTable is { } t)
            {
                <div class="publish-field-grid">
                    <label class="publish-field"><span>Connection</span><input class="console-input" value="@(SourceConnection ?? "")" readonly /></label>
                    <label class="publish-field"><span>Schema · table</span><input class="console-input" value="@t.QualifiedName" readonly /></label>
                    <label class="publish-field"><span>Geometry column</span><input class="console-input" value="@(t.GeometryColumn is { Length: > 0 } gc ? $"{gc} · {t.GeometryType ?? "—"}{(t.Srid is { } srid ? $" · {srid}" : "")}" : t.GeometryType ?? "—")" readonly /></label>
                </div>
            }
            else
            {
                <p class="console-muted">Select a source connection and table above first.</p>
            }
        </article>
        <article class="console-panel" data-new-resource="layer">
            <h3>2. Name the layer (this service only)</h3>
            <div class="publish-field-grid">
                <label class="publish-field"><span>Layer name</span><input class="console-input" value="@(SelectedResourceName ?? "")" placeholder="layer name" readonly /></label>
            </div>
            <p class="publish-callout publish-callout-info">The layer name defaults to the source table name. The layer id and route are assigned by honua-server on publish.</p>
        </article>
    };

    private RenderFragment InlineNewServiceCard => __builder =>
    {
        <article class="console-panel" data-inline-new-service>
            <h3>New service · runtime essentials</h3>
            <p class="console-muted">Minimum needed to start publishing. Full runtime settings can be tuned later in Services → settings.</p>
            <div class="publish-field-grid">
                <label class="publish-field">
                    <span>Service name</span>
                    <input class="console-input" @bind="_newServiceName" @bind:event="oninput" placeholder="my-service (use folder/service to nest)" />
                </label>
            </div>
            <p class="console-muted">The service kind, route, and runtime defaults are applied by honua-server when the service is created on publish. The selected table lands as its first layer.</p>
        </article>
    };

    private RenderFragment LayerFieldsCard => __builder =>
    {
        <article class="console-panel publish-fields-card" data-layer-fields>
            @if (SelectedTable is { Columns.Count: > 0 } t)
            {
                <h3>Fields exposed in this layer <span class="console-muted">@t.Columns.Count field@(t.Columns.Count == 1 ? null : "s") on the source table</span></h3>
                <div class="console-table-wrap">
                    <table class="console-table">
                        <thead><tr><th></th><th>Field</th></tr></thead>
                        <tbody>
                            @foreach (var column in t.Columns)
                            {
                                <tr><td><input type="checkbox" checked /></td><td>@column</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="console-muted">Field aliases and per-slot hidden/PII flags are applied by honua-server from the resource metadata.</p>
            }
            else
            {
                <p class="console-muted">Select a source table to choose which of its fields this layer exposes.</p>
            }
        </article>
    };

    private RenderFragment UrlPreviewCard(string url) => __builder =>
    {
        <article class="console-panel publish-url-preview" data-url-preview>
            <h3>URL preview</h3>
            <code class="publish-url-value">@url</code>
            <button type="button" class="console-button console-button-secondary" @onclick="@(() => CopyUrlAsync(url))">⧉ Copy URL</button>
        </article>
    };
}
