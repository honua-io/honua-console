    private RenderFragment AuthorReviewBody => __builder =>
    {
        @AuthorContext
        <div class="publish-wizard-grid" data-author-step="review">
            <div class="publish-wizard-main">
                <h3 class="publish-wizard-question">Validate &amp; publish</h3>
                <div class="publish-review-stack">
                    <article class="console-panel">
                        <h3>◇ Data Resource · parcels_2024 <span class="console-status console-state-neutral">canonical</span></h3>
                        <dl class="console-definition-list">
                            <dt>Source</dt><dd>@SourceConnection / @SourceTable</dd>
                            <dt>Geometry</dt><dd>MultiPolygon · 4326</dd>
                        </dl>
                    </article>
                    <div class="publish-review-bind">↓ binds to ↓</div>
                    <article class="console-panel publish-review-layer">
                        <h3>◈ @(_authorTargetId ?? "parcels-fs") / layer 8 · "Parcels" <span class="console-status console-state-success">publication</span></h3>
                        <dl class="console-definition-list">
                            <dt>URL</dt><dd>/public/pw/FeatureServer/8</dd>
                            <dt>Style</dt><dd>class breaks on area_m2</dd>
                        </dl>
                    </article>
                    <div class="publish-review-bind">↓ opt-in (checked) ↓</div>
                    <article class="console-panel publish-review-layer-catalog">
                        <h3>▤ Esri catalog registration <span class="console-status console-state-info">auto-mirror</span></h3>
                        <p class="console-muted">Esri services mirror to the Esri catalog; OGC API Features mirrors to OGC Records.</p>
                    </article>
                </div>
            </div>
            <aside class="publish-wizard-rail">
                @UrlPreviewCard("/public/pw/FeatureServer/8")
                @if (_published)
                {
                    <p class="publish-callout publish-callout-info" data-publish-result>Validated and published. A new Publication record was created; existing slots are untouched.</p>
                }
            </aside>
        </div>
    };

    // ===================================================================================
