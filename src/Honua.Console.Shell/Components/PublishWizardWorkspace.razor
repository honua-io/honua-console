    private RenderFragment ServiceTree(string? selectedId, Action<string> onSelect) => __builder =>
    {
        <div class="publish-tree" role="listbox" aria-label="Target services" data-publish-tree>
            @{
                string? lastFolder = null;
            }
            @foreach (var node in Services)
            {
                if (node.Folder != lastFolder)
                {
                    lastFolder = node.Folder;
                    <div class="publish-tree-folder">🗀 @node.Folder</div>
                }
                var selected = node.Id == selectedId;
                var incompatible = node.Compatibility == ServiceCompatibility.Incompatible;
                <button type="button"
                        class="publish-tree-row @(selected ? "publish-tree-row-selected" : null) @(incompatible ? "publish-tree-row-incompat" : null)"
                        role="option"
                        aria-selected="@selected"
                        disabled="@incompatible"
                        @onclick="() => { if (!incompatible) onSelect(node.Id); }">
                    <input type="radio" checked="@selected" disabled="@incompatible" tabindex="-1" />
                    <span class="publish-tree-glyph">◈</span>
                    <span class="publish-tree-body">
                        <span class="publish-tree-name">@node.Name <span class="console-status console-state-neutral">@node.Kind</span></span>
                        <span class="publish-tree-meta">@node.Meta@(node.Note is null ? null : $" · {node.Note}")</span>
                    </span>
                    <span class="console-status @CompatibilityClass(node.Compatibility)">@CompatibilityLabel(node.Compatibility)</span>
                </button>
            }
        </div>
    };

    private RenderFragment ResourceTable => __builder =>
    {
        <div class="console-table-wrap publish-resource-table" data-resource-table>
            <table class="console-table">
                <thead>
                    <tr><th></th><th>Resource</th><th>Type</th><th>Features</th><th>In service?</th><th>Used in</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Resources)
                    {
                        var selected = r.Id == _selectedResourceId;
                        <tr class="@(selected ? "publish-resource-row-selected" : null) @(r.Compatible ? null : "publish-resource-row-incompat")">
                            <td>
                                <input type="radio"
                                       name="quick-resource"
                                       checked="@selected"
                                       disabled="@(!r.Compatible)"
                                       @onchange="() => { if (r.Compatible) _selectedResourceId = r.Id; }" />
                            </td>
                            <td>◇ <strong>@r.Name</strong></td>
                            <td><span class="console-status console-state-neutral">@r.Type</span></td>
                            <td>@r.Features</td>
                            <td>@(r.AlreadyIn == "no" ? "—" : r.AlreadyIn)</td>
                            <td>
                                @r.UsedIn
                                @if (r.Pii)
                                {
                                    <span class="console-status console-state-warning publish-pii-flag">PII</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="console-chip-row publish-resource-actions">
            <button type="button" class="console-button console-button-secondary">+ Create from connection</button>
            <button type="button" class="console-button console-button-secondary">+ Create from file</button>
            <button type="button" class="console-button console-button-secondary">+ Migrate remote service</button>
        </div>
    };

    private RenderFragment LayerFieldsCard => __builder =>
    {
        <article class="console-panel publish-fields-card" data-layer-fields>
            <h3>Fields exposed in this layer <span class="console-muted">resource has 24 fields · pick &amp; rename for this slot</span></h3>
            <div class="console-table-wrap">
                <table class="console-table">
                    <thead><tr><th></th><th>Resource field</th><th>Alias here</th><th>Role</th></tr></thead>
                    <tbody>
                        <tr><td><input type="checkbox" checked /></td><td>gid</td><td>OBJECTID</td><td><span class="console-status console-state-info">Primary ID</span></td></tr>
                        <tr><td><input type="checkbox" checked /></td><td>parcel_id</td><td>Parcel ID</td><td>Display</td></tr>
                        <tr><td><input type="checkbox" checked /></td><td>area_m2</td><td>Area (m²)</td><td>—</td></tr>
                        <tr class="publish-field-pii"><td><input type="checkbox" /></td><td>owner_name</td><td class="console-muted">— hidden —</td><td><span class="console-status console-state-warning">PII flagged on resource</span></td></tr>
                        <tr><td colspan="4" class="console-muted publish-fields-more">+ 20 more · default = inherit from resource</td></tr>
                    </tbody>
