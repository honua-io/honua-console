<div class="console-chip-row">
    <span class="@BrowserCss(Profile.TransportCapabilities.BrowserHttp)">Browser HTTP · @Enabled(Profile.TransportCapabilities.BrowserHttp)</span>
    <span class="@BrowserCss(Profile.TransportCapabilities.BrowserRealtime)">Browser realtime · @Enabled(Profile.TransportCapabilities.BrowserRealtime)</span>
</div>

@code {
    [Parameter, EditorRequired]
    public ConsoleEnvironmentProfile Profile { get; set; } = new();

    private static string Enabled(bool on) => on ? "Available" : "Off";

    private static string BrowserCss(bool on) => on ? "console-state-success" : "console-state-neutral";
}
