@using Honua.Console.Shell.Services

<div class="console-panel operate-status-panel @StateClass">
    <HonuaState Kind="@StateKind" Kicker="@Heading" Title="@ResolvedTitle" Message="@ResolvedMessage" HeadingLevel="3">
        @if (!Loading && !Empty && !string.IsNullOrWhiteSpace(Detail))
        {
            <ConsoleDiagnostics Detail="@Detail" />
        }
    </HonuaState>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Heading { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public OperateSectionStatus Status { get; set; } = OperateSectionStatus.Unavailable;

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string? Detail { get; set; }

    [Parameter]
    public bool Empty { get; set; }

    [Parameter]
    public string EmptyTitle { get; set; } = "Nothing to show yet";

    [Parameter]
    public string EmptyMessage { get; set; } = "The connected server returned no records for this surface.";

    private string StateKind => Loading ? "loading" : Empty ? "empty" : "denied";

    private string StateClass => $"operate-status-{StateKind}";

    private string ResolvedTitle => Loading
        ? "Loading..."
        : Empty
            ? EmptyTitle
            : OperateSectionPresentation.Title(Status);

    private string ResolvedMessage => Loading
        ? "Reading live data from the connected honua-server."
        : Empty
            ? EmptyMessage
            : string.IsNullOrWhiteSpace(Message)
                ? OperateSectionPresentation.FallbackMessage(Status)
                : Message;
}
