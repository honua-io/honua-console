@inject NavigationManager ConsoleNavigation
@namespace Honua.Console.Shell.Components
@using Honua.Console.Shell.Models

<div class="publish-review-stack" data-publishing-review data-publication-id="@Review.ResourceId">
    <article class="console-panel">
        <div class="console-panel-heading">
            <div>
                <p class="console-kicker">@ConsoleVocabulary.PublishingKindName(Review.ResourceKind)</p>
                <h2>@Review.ResourceName</h2>
            </div>
            <span class="console-status console-state-success">canonical home</span>
        </div>
        <dl class="console-definition-list">
            <dt>ID</dt>
            <dd><small>@Review.ResourceId</small></dd>
            <dt>Provenance</dt>
            <dd>@Review.Provenance</dd>
        </dl>
    </article>

    <div class="publish-review-bind" aria-hidden="true">↓ binds to ↓</div>

    <article class="console-panel publish-review-layer">
        <div class="console-panel-heading">
            <div>
                <p class="console-kicker">Route</p>
                <h2>@Review.Route</h2>
            </div>
            <span class="console-status">@Review.RollbackClass</span>
        </div>

        <dl class="console-definition-list">
            <dt>Policy</dt>
            <dd>@Review.Policy</dd>
        </dl>

        @if (Review.GeneratedEndpoints.Count > 0)
        {
            <p class="console-kicker">Generated endpoints</p>
            <ul class="console-event-list">
                @foreach (var endpoint in Review.GeneratedEndpoints)
                {
                    <li><strong>@endpoint.Protocol</strong> <span>@endpoint.Url</span></li>
                }
            </ul>
        }

        @if (Review.Warnings.Count > 0)
        {
            <p class="console-kicker">Warnings</p>
            <ul class="console-event-list">
                @foreach (var warning in Review.Warnings)
                {
                    <li class="console-warning">@warning</li>
                }
            </ul>
        }

        <nav class="console-tab-row" aria-label="Evidence links">
            @if (!string.IsNullOrWhiteSpace(Review.Links.JobHref))
            {
                <a href="@ConsoleNavigation.ToConsoleLinkHref(Review.Links.JobHref)">Job</a>
            }
            @if (!string.IsNullOrWhiteSpace(Review.Links.EventsHref))
            {
                <a href="@ConsoleNavigation.ToConsoleLinkHref(Review.Links.EventsHref)">Events</a>
            }
            @if (!string.IsNullOrWhiteSpace(Review.Links.AuditHref))
            {
                <a href="@ConsoleNavigation.ToConsoleLinkHref(Review.Links.AuditHref)">Audit</a>
            }
            @if (!string.IsNullOrWhiteSpace(Review.Links.RollbackHref))
            {
                <a href="@ConsoleNavigation.ToConsoleLinkHref(Review.Links.RollbackHref)">Rollback evidence</a>
            }
        </nav>
    </article>

    <div class="publish-review-bind" aria-hidden="true">↓ mirrors to ↓</div>

    <article class="console-panel publish-review-layer-catalog">
        <div class="console-panel-heading">
            <div>
                <p class="console-kicker">Catalog entry</p>
                <h2>Catalog registration</h2>
            </div>
            @if (Review.CatalogRegistration.Registered)
            {
                <span class="console-status console-state-info">registered</span>
            }
            else
            {
                <span class="console-status console-state-neutral">not registered</span>
            }
        </div>
        <dl class="console-definition-list">
            <dt>Visibility</dt>
            <dd>
                @if (Review.CatalogRegistration.Registered && !string.IsNullOrWhiteSpace(Review.CatalogRegistration.CatalogEntryId))
                {
                    <a href="@ConsoleNavigation.ToConsoleLinkHref($"/catalog/{Review.CatalogRegistration.CatalogEntryId}")">@Review.CatalogRegistration.Visibility</a>
                }
                else
                {
                    @($"Not registered ({Review.CatalogRegistration.Visibility})")
                }
            </dd>
        </dl>
    </article>
</div>

@code {
    [Parameter, EditorRequired]
    public PublishingReview Review { get; set; } = default!;
}
