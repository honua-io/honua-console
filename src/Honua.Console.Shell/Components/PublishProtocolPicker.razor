@namespace Honua.Console.Shell.Components
@using Honua.Console.Shell.Models

<div class="publish-protocol-picker" data-publish-protocol-picker>
    <p class="console-muted">
        Pick the protocols the service serves. honua-server enables protocols per service, so every layer in
        the service is served through each protocol you pick.
    </p>

    @foreach (var (key, label) in PublishProtocolCatalog.Groups)
    {
        <fieldset class="publish-protocol-picker__group" data-protocol-group="@key">
            <legend>@label</legend>
            <div class="publish-protocol-picker__options">
                @foreach (var protocol in PublishProtocolCatalog.InGroup(key))
                {
                    <label class="publish-protocol-picker__option">
                        <input type="checkbox"
                               data-protocol="@protocol.Id"
                               checked="@Enabled.Contains(protocol.Id)"
                               @onchange="args => Toggle(protocol.Id, args)" />
                        <span class="publish-protocol-picker__option-label">@protocol.Label</span>
                        <small class="console-muted">@protocol.Hint</small>
                    </label>
                }
            </div>
        </fieldset>
    }

    <div class="publish-protocol-picker__slot">
        <span class="studio-form-label">Service slot</span>
        <code data-service-slot>@ServiceSlot</code>
        <span class="console-muted">(the service this resource is published in)</span>
    </div>

    @{
        var plans = PublishProtocolCatalog.PlanPublications(ServiceSlot, Enabled);
    }
    @if (plans.Count == 0)
    {
        <p class="console-muted" data-no-protocols>
            No protocols selected yet — pick at least one to serve this resource.
        </p>
    }
    else
    {
        <p class="console-muted" data-publication-preview>
            Will serve through: @string.Join(" · ", plans.Select(p => p.Label))
        </p>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyCollection<string> Enabled { get; set; } = PublishProtocolCatalog.DefaultEnabled;

    [Parameter]
    public EventCallback<IReadOnlyCollection<string>> EnabledChanged { get; set; }

    [Parameter]
    public string ServiceSlot { get; set; } = "service";

    private async Task Toggle(string protocolId, ChangeEventArgs args)
    {
        var on = args.Value is bool b && b;
        var next = new HashSet<string>(Enabled, StringComparer.Ordinal);
        if (on)
        {
            next.Add(protocolId);
        }
        else
        {
            next.Remove(protocolId);
        }

        // Preserve catalog order so the publication preview is stable regardless of click order.
        var ordered = PublishProtocolCatalog.All
            .Where(descriptor => next.Contains(descriptor.Id))
            .Select(descriptor => descriptor.Id)
            .ToArray();

        if (EnabledChanged.HasDelegate)
        {
            await EnabledChanged.InvokeAsync(ordered);
        }
    }
}
