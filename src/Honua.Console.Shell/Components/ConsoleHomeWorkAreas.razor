@inject NavigationManager Navigation
@inject IConsoleCapabilityManifest Capabilities
@inject IServiceProvider Services
@inject CatalogAdminOptions CatalogOptions
@implements IDisposable

<nav aria-label="Work areas" class="console-home-links">
    @foreach (var group in VisibleGroups)
    {
        <section>
            <h3>@group.Name</h3>
            <ul>
                @foreach (var entry in group.Destinations)
                {
                    <li><a href="@Navigation.ToConsoleLinkHref(entry.Path)">@entry.Label</a></li>
                }
            </ul>
        </section>
    }
</nav>

@code {
    private bool _disposed;
    protected override void OnInitialized() => Capabilities.Changed += OnCapabilitiesChanged;
    private void OnCapabilitiesChanged()
    {
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        _disposed = true;
        Capabilities.Changed -= OnCapabilitiesChanged;
    }

    private IConsoleProductMode ProductMode => Services.GetService<IConsoleProductMode>() ??
        new ConfiguredConsoleProductMode(ConsoleProductMode.Full);

    private IReadOnlyList<ConsoleNavigationGroup> VisibleGroups => ConsoleNavigation.VisibleGroups(
        ProductMode, Capabilities, ConsoleNavigation.EnabledGroups(
            CatalogOptions, Services.GetService<Microsoft.Extensions.Configuration.IConfiguration>()));
}
