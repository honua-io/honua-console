<article class="console-panel">
    <HonuaState Kind="empty" Kicker="@(string.IsNullOrWhiteSpace(Area) ? null : FormatArea(Area))"
                Title="@($"No {Subject}")" Message="@($"No {Subject} are available in this {FormatArea(Area)} environment.")"
                HeadingLevel="2" ActionHref="@ActionHref" ActionLabel="@ActionText" />
</article>

@code {
    [Parameter]
    public string Area { get; set; } = "operate";

    [Parameter]
    public string Subject { get; set; } = "items";

    [Parameter]
    public string? ActionHref { get; set; }

    [Parameter]
    public string? ActionText { get; set; }

    private static string FormatArea(string? area)
    {
        if (string.IsNullOrWhiteSpace(area))
        {
            return "Console";
        }

        return char.ToUpperInvariant(area[0]) + area[1..];
    }
}
