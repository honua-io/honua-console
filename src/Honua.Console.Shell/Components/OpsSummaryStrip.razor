@using System.Globalization
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IServiceProvider ServiceProvider
@implements IAsyncDisposable

<section class="console-panel ops-summary-strip" aria-label="Operational summary" data-ops-summary-strip>
    <a class="ops-summary-tile" href="/operate/health" data-summary-tile="health">
        <span class="console-kicker">Health</span>
        @if (!_loaded)
        {
            <strong class="console-muted" data-summary-loading="health">Loading&hellip;</strong>
        }
        else if (_overallHealth is { } overall)
        {
            <OperateStatusPill Status="@overall" />
        }
        else
        {
            <span class="console-muted" data-summary-unavailable="health">Unavailable</span>
        }
        @if (_loaded && _overallHealth is null) { <small>@ReadStatus(_healthStatus)</small> }
    </a>

    <a class="ops-summary-tile" href="/inbox" data-summary-tile="approvals">
        <span class="console-kicker">Awaiting approval</span>
        <strong data-summary-value="approvals" class="@(_awaitingApprovals is > 0 ? "is-actionable" : null)">
            @(_loaded && _awaitingApprovals is { } awaiting ? awaiting.ToString(CultureInfo.InvariantCulture) : "—")
        </strong>
        @if (_loaded && _awaitingApprovals is null) { <small>@ReadStatus(_inboxStatus)</small> }
        @if (_inboxPartial) { <small>Partial queue</small> }
    </a>

    <a class="ops-summary-tile" href="/operate/copilot" data-summary-tile="findings">
        <span class="console-kicker">Open findings</span>
        <strong data-summary-value="findings">
            @(_loaded && _openFindings is { } findings ? findings.ToString(CultureInfo.InvariantCulture) : "—")
        </strong>
        @if (_loaded && _openFindings is null) { <small>@ReadStatus(_findingsStatus)</small> }
    </a>

    <a class="ops-summary-tile" href="/operate/health" data-summary-tile="breaches">
        <span class="console-kicker">SLO breaches</span>
        <strong data-summary-value="breaches" class="@(_sloBreaches is > 0 ? "is-actionable" : null)">
            @(_loaded && _sloBreaches is { } breaches ? breaches.ToString(CultureInfo.InvariantCulture) : "—")
        </strong>
    </a>

    <span class="ops-summary-liveness @(RealtimeConnected ? "is-live" : null)" data-summary-liveness
          data-fallback-engaged="@FallbackEngaged">
        @(RealtimeConnected ? "Approvals live" : "Approvals: manual refresh")
        @if (_healthGeneratedAt is { } generated)
        {
            <text> · Last health snapshot @generated</text>
        }
        @if (_lastFindingsReadUtc is { } findingsRead)
        {
            <text> · Findings read @findingsRead.ToString("HH:mm:ss", CultureInfo.InvariantCulture) UTC</text>
        }
    </span>

    @if (_inboxPartial)
    {
        <p role="note" data-summary-partial>@_inboxPartialMessage</p>
    }
    @if (ReadError)
    {
        <span class="ops-summary-error" role="alert" data-summary-error>
            <span data-summary-error-title>Couldn't reach @ServerName</span>
            <span class="console-muted" data-summary-last-refreshed>&middot; @ConsoleFreshness.LastRefreshed(_lastRefreshedAtUtc)</span>
            <button type="button" class="console-button console-button-secondary ops-summary-retry"
                    disabled="@_busy" data-summary-retry @onclick="RetryAsync">
                Retry
            </button>
        </span>
    }
</section>

@code {
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(30);
    [Parameter] public TimeSpan LoadBudget { get; set; } = ConsoleReadBudget.Default;

    private readonly CancellationTokenSource _lifetime = new();
    private bool _loaded;
    private bool _busy;
    private bool _disposed;
    private OperateStatus? _overallHealth;
    private int? _awaitingApprovals;
    private int? _openFindings;
    private int? _sloBreaches;
    private OperateSectionStatus? _healthStatus;
    private OperateSectionStatus? _findingsStatus;
    private OperateSectionStatus? _inboxStatus;
    private bool _inboxPartial;
    private string _inboxPartialMessage = "";
    private string? _healthGeneratedAt;
    private DateTimeOffset? _lastFindingsReadUtc;
    private DateTimeOffset? _lastRefreshedAtUtc;
    private string? _serverName;
    private IOpsHealthDataSource? _healthData;
    private IConsoleOpsFindingsClient? _findings;
    private IConsoleApprovalInboxClient? _inbox;
    private IConsoleProposalRealtimeClient? _realtime;
    private IConsoleRealtimeCapabilityClient? _realtimeState;
    private PeriodicTimer? _timer;

    private bool RealtimeConnected => _realtime?.IsConnected == true;
    private bool FallbackEngaged => _realtime?.IsFallbackEngaged == true;
    private string ServerName => string.IsNullOrWhiteSpace(_serverName) ? "the connected honua-server" : _serverName;
    private bool ReadError => _healthStatus == OperateSectionStatus.Unavailable
        || _findingsStatus == OperateSectionStatus.Unavailable || _inboxStatus == OperateSectionStatus.Unavailable;
    private static string ReadStatus(OperateSectionStatus? status) => status is { } value
        ? OperateSectionPresentation.Title(value) : "Not configured";

    protected override async Task OnInitializedAsync()
    {
        _healthData = ServiceProvider.GetService<IOpsHealthDataSource>();
        _findings = ServiceProvider.GetService<IConsoleOpsFindingsClient>();
        _inbox = ServiceProvider.GetService<IConsoleApprovalInboxClient>();
        _realtime = ServiceProvider.GetService<IConsoleProposalRealtimeClient>();
        await ResolveServerNameAsync();
        if (_disposed) return;
        SubscribeRealtime();
        await RefreshAsync();
        if (_disposed) return;
        await StartRealtimeAsync();
        if (!_disposed && (_healthData is not null || _findings is not null || _inbox is not null))
        {
            _timer = new PeriodicTimer(PollInterval);
            _ = PollLoopAsync(_timer, _lifetime.Token);
        }
    }

    private void SubscribeRealtime()
    {
        if (_realtime is null) return;
        _realtime.ProposalChanged += OnProposalEvent;
        if (_realtime is IConsoleRealtimeCapabilityClient capability)
        {
            _realtimeState = capability;
            _realtimeState.ConnectionStateChanged += OnConnectionStateChanged;
        }
    }

    private async Task StartRealtimeAsync()
    {
        if (_realtime is null) return;
        try { await _realtime.StartAsync(_lifetime.Token); }
        catch (OperationCanceledException) when (_disposed) { return; }
        catch { /* A failed subscription leaves bounded reads and manual refresh available. */ }
    }

    private async Task RefreshAsync()
    {
        if (_busy || _disposed) return;
        _busy = true;
        try
        {
            await Task.WhenAll(ReadHealthAsync(), ReadFindingsAsync(), ReadInboxAsync());
            if (!_disposed) _loaded = true;
        }
        finally { _busy = false; }
    }

    private async Task ReadHealthAsync()
    {
        if (_healthData is null) return;
        var health = await ConsoleReadBudget.RunAsync(_healthData.GetSnapshotAsync, LoadBudget,
            "The server health read did not respond in time.", _lifetime.Token);
        if (_disposed) return;
        _healthStatus = health.Status;
        _overallHealth = health.IsAllowed ? health.Value!.Overall : null;
        _sloBreaches = health.IsAllowed ? health.Value!.BreachCount : null;
        if (health.IsAllowed)
        {
            _healthGeneratedAt = health.Value!.GeneratedAt;
            _lastRefreshedAtUtc = DateTimeOffset.UtcNow;
        }
    }

    private async Task ReadFindingsAsync()
    {
        if (_findings is null) return;
        var result = await ConsoleReadBudget.RunAsync(_findings.ListAsync, LoadBudget,
            "The findings read did not respond in time.", _lifetime.Token);
        if (_disposed) return;
        _findingsStatus = result.Status;
        _openFindings = result.IsAllowed ? OpsFindingsMapper.Map(result.Value!).Count : null;
        if (result.IsAllowed) _lastFindingsReadUtc = _lastRefreshedAtUtc = DateTimeOffset.UtcNow;
    }

    private async Task ReadInboxAsync()
    {
        if (_inbox is null) return;
        var result = await ConsoleReadBudget.RunAsync(token => _inbox.GetInboxAsync(cancellationToken: token), LoadBudget,
            "The approval queue read did not respond in time.", _lifetime.Token);
        if (_disposed) return;
        _inboxStatus = result.Status;
        _awaitingApprovals = result.IsAllowed ? result.Value!.AwaitingApprovalCount : null;
        _inboxPartial = result.IsAllowed && result.PartialResult;
        _inboxPartialMessage = string.IsNullOrWhiteSpace(result.Message)
            ? "Some proposal sources could not be read. This queue is incomplete." : result.Message;
        if (result.IsAllowed) _lastRefreshedAtUtc = DateTimeOffset.UtcNow;
    }

    private async Task ResolveServerNameAsync()
    {
        var profiles = ServiceProvider.GetService<IConsoleEnvironmentProfileStore>();
        if (profiles is null) return;
        var result = await ConsoleReadBudget.RunAsync(async token =>
            OperateSectionResult<ConsoleEnvironmentProfile?>.Allowed(await profiles.GetActiveProfileAsync(token)),
            LoadBudget, "The selected environment could not be read.", _lifetime.Token);
        if (!_disposed && result.IsAllowed) _serverName = result.Value?.DisplayName;
    }

    private async Task RetryAsync()
    {
        await RefreshAsync();
        if (!_disposed) StateHasChanged();
    }

    private void OnConnectionStateChanged(ConsoleRealtimeConnectionState state)
    {
        if (!_disposed) _ = InvokeAsync(StateHasChanged);
    }

    private void OnProposalEvent(ConsoleProposalEvent proposal)
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            await ReadInboxAsync();
            if (!_disposed) StateHasChanged();
        });
    }

    private async Task PollLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await RefreshAsync();
                if (!_disposed) await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_disposed) { return; }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Cancel();
        _timer?.Dispose();
        if (_realtime is not null) _realtime.ProposalChanged -= OnProposalEvent;
        if (_realtimeState is not null) _realtimeState.ConnectionStateChanged -= OnConnectionStateChanged;
        _lifetime.Dispose();
        return ValueTask.CompletedTask;
    }
}
