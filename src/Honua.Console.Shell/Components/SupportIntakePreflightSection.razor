@implements IDisposable
@using Honua.Console.Contracts
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Security
@using Honua.Console.Shell.Services
@inject IConsoleSupportPortalClient PortalClient

<section id="preflight" class="operate-section" aria-labelledby="support-preflight-heading">
    <div class="operate-support-section-header">
        <h2 id="support-preflight-heading">Preflight check &amp; new ticket</h2>
    </div>

    <div class="operate-support-intake-grid">
        <article class="console-panel" aria-labelledby="support-intake-form-heading">
            <div class="console-panel-heading">
                <h3 id="support-intake-form-heading">Describe the issue</h3>
            </div>

            <div class="studio-field-grid">
                <label>
                    <span>Severity</span>
                    <select class="console-input" disabled="@_submitting" @bind="_severity">
                        <option value="sev1">@SupportTicketLabels.Display("sev1")</option>
                        <option value="sev2">@SupportTicketLabels.Display("sev2")</option>
                        <option value="sev3">@SupportTicketLabels.Display("sev3")</option>
                    </select>
                </label>
                <label>
                    <span>Service</span>
                    <input class="console-input" disabled="@_submitting" @bind="_service" placeholder="honua-server" />
                </label>
                <label>
                    <span>Requested action</span>
                    <input class="console-input" disabled="@_submitting" @bind="_requestedAction" placeholder="Diagnose elevated 500s on FeatureServer" />
                </label>
                <label>
                    <span>Access mode</span>
                    <select class="console-input" disabled="@_submitting" @bind="_allowedAccessMode">
                        <option value="read-only">@SupportTicketLabels.Display("read-only")</option>
                        <option value="guided-fix">@SupportTicketLabels.Display("guided-fix")</option>
                        <option value="operator-scoped">@SupportTicketLabels.Display("operator-scoped")</option>
                    </select>
                </label>
                <label>
                    <span>Access TTL (minutes)</span>
                    <input class="console-input" disabled="@_submitting" type="number" min="5" @bind="_ttlMinutes" />
                </label>
            </div>

            <label class="support-symptoms-field">
                <span>Symptoms</span>
                <textarea class="console-input" disabled="@_submitting" rows="4" @bind="_symptoms"
                          placeholder="Steps, timing, affected layers or services."></textarea>
            </label>

            <div class="studio-check-row">
                <input id="operate-support-rollback" disabled="@_submitting" type="checkbox" @bind="_rollbackExpected" />
                <label for="operate-support-rollback"><span>A rollback may be expected as part of the fix</span></label>
            </div>

            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="console-validation-summary" role="alert" data-support-form-error>
                    <p>@_formError</p>
                </div>
            }

            <div class="console-action-row">
                <button type="button"
                        class="console-button console-button-secondary"
                        disabled="@(_preflightBusy || _submitting || !CanRunPreflight)"
                        data-run-preflight
                        @onclick="RunPreflightAsync">
                    @(_preflightBusy ? "Checking..." : "Run preflight check")
                </button>
                <button type="button"
                        class="console-button"
                        disabled="@(_submitting || !CanSubmitTicket)"
                        data-submit-support-ticket
                        @onclick="SubmitTicketAsync">
                    @(_submitting ? "Submitting..." : "Submit ticket")
                </button>
            </div>
        </article>

        <aside class="console-panel operate-support-preflight-panel" aria-label="Preflight results and attached context">
            <div class="console-panel-heading">
                <h3>Preflight &amp; attached context</h3>
            </div>

            @if (_preflightResult is not null)
            {
                <div class="operate-support-preflight-output" data-preflight-result>
                    <dl class="support-context-list">
                        <ContextRow Label="Product area" Value="@_preflightResult.ProductArea" />
                        <ContextRow Label="Issue kind" Value="@_preflightResult.IssueKind" />
                        <ContextRow Label="Classification" Value="@_preflightResult.ClassificationProvenance" />
                    </dl>

                    @if (_preflightResult.Compatibility is { } compat)
                    {
                        <div class="operate-support-subpanel">
                            <h4>Compatibility check</h4>
                            <p>@compat.Summary</p>
                            @if (compat.GuidedCommands.Count > 0)
                            {
                                <ol class="support-command-list">
                                    @foreach (var command in compat.GuidedCommands)
                                    {
                                        <li><code>@command</code></li>
                                    }
                                </ol>
                            }
                        </div>
                    }

                    @if (_preflightResult.KnownIssues.Count > 0)
                    {
                        <div class="operate-support-subpanel">
                            <h4>Known product issues</h4>
                            <ul class="operate-support-known-issues">
                                @foreach (var issue in _preflightResult.KnownIssues)
                                {
                                    var issueNotes = ConsoleSafeUrl.NormalizeHttpUrl(issue.ReleaseNotesUrl);
                                    <li>
                                        <span class="console-mono">@issue.Component</span>
                                        @if (!string.IsNullOrWhiteSpace(issue.FixedInServerVersion))
                                        {
                                            <span> · fixed in @issue.FixedInServerVersion</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(issue.PatchStage))
                                        {
                                            <span> (@issue.PatchStage)</span>
                                        }
                                        @if (issueNotes is not null)
                                        {
                                            <span> · <a href="@issueNotes" target="_blank" rel="noopener noreferrer">Notes</a></span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (_preflightResult.RedactionPreview is { } redaction)
                    {
                        <div class="operate-support-subpanel">
                            <h4>Redaction preview</h4>
                            <dl class="support-context-list operate-support-tabular">
                                <ContextRow Label="Headers dropped" Value="@redaction.HeadersDropped.ToString()" />
                                <ContextRow Label="Bodies redacted" Value="@redaction.BodiesRedacted.ToString()" />
                                <ContextRow Label="Scoped key brokered" Value="@(redaction.ScopedKeyWillBeBrokered ? "Yes" : "No")" />
                            </dl>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_preflightResult.RecommendedEvidenceCommand))
                    {
                        <div class="operate-support-subpanel">
                            <h4>Recommended evidence command</h4>
                            <code class="operate-support-command">@_preflightResult.RecommendedEvidenceCommand</code>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="console-muted">
                    Run a preflight check before filing a ticket to verify compatibility rules, known fixes, and exact payload redaction.
                </p>
            }

            @if (CapturedContext is not null)
            {
                <div class="operate-support-subpanel">
                    <h4>Connected environment context</h4>
                    <dl class="support-context-list">
                        <ContextRow Label="Environment" Value="@FormatEnvironment(CapturedContext)" />
                        <ContextRow Label="Server" Value="@CapturedContext.ServerUri" />
                        <ContextRow Label="Console version" Value="@CapturedContext.AppVersion" />
                    </dl>
                </div>
            }
        </aside>
    </div>
</section>

@code {
    [Parameter]
    public ConsoleSupportContext? CapturedContext { get; set; }

    [Parameter]
    public EventCallback<SupportTicketResponse> OnTicketCreated { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private bool _disposed;
    private bool _preflightBusy;
    private bool _submitting;

    private string _severity = "sev3";
    private string _service = "honua-server";
    private string _requestedAction = string.Empty;
    private string _allowedAccessMode = "read-only";
    private int _ttlMinutes = 60;
    private string _symptoms = string.Empty;
    private bool _rollbackExpected;
    private string _formError = string.Empty;
    private SupportPreflightResponse? _preflightResult;

    private bool CanRunPreflight => !string.IsNullOrWhiteSpace(_symptoms);

    private bool CanSubmitTicket =>
        !string.IsNullOrWhiteSpace(_symptoms) && !string.IsNullOrWhiteSpace(_requestedAction);

    private async Task RunPreflightAsync()
    {
        if (_disposed || _preflightBusy || !CanRunPreflight)
        {
            return;
        }

        _preflightBusy = true;
        _formError = string.Empty;
        try
        {
            var result = await PortalClient.RunPreflightAsync(BuildPreflightRequest(), _lifetime.Token);
            if (_disposed)
            {
                return;
            }

            if (result.IsAllowed)
            {
                _preflightResult = result.Value;
            }
            else
            {
                _formError = FallbackMessage(result.Status, result.Message);
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        finally
        {
            _preflightBusy = false;
        }
    }

    private async Task SubmitTicketAsync()
    {
        if (_disposed || _submitting || !CanSubmitTicket)
        {
            return;
        }

        _submitting = true;
        _formError = string.Empty;
        try
        {
            var result = await PortalClient.CreateTicketAsync(BuildCreateTicketRequest(), _lifetime.Token);
            if (_disposed)
            {
                return;
            }

            await ApplyCreationAsync(result);
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task ApplyCreationAsync(SupportPortalResult<SupportTicketResponse> result)
    {
        if (!result.IsAllowed)
        {
            _formError = FallbackMessage(result.Status, result.Message);
            return;
        }

        _requestedAction = string.Empty;
        _symptoms = string.Empty;
        await OnTicketCreated.InvokeAsync(result.Value!);
    }

    private SupportPreflightRequest BuildPreflightRequest() => new()
    {
        Severity = _severity,
        Environment = NormalizeOrDefault(CapturedContext?.EnvironmentKind, "production"),
        Service = NormalizeOrDefault(_service, "honua-server"),
        Symptoms = _symptoms.Trim(),
        Context = CapturedContext?.ToContextRequest()
    };

    private CreateSupportTicketRequest BuildCreateTicketRequest() => new()
    {
        Severity = _severity,
        Environment = NormalizeOrDefault(CapturedContext?.EnvironmentKind, "production"),
        Service = NormalizeOrDefault(_service, "honua-server"),
        Symptoms = _symptoms.Trim(),
        RequestedAction = _requestedAction.Trim(),
        AllowedAccessMode = _allowedAccessMode,
        TtlMinutes = _ttlMinutes < 5 ? 5 : _ttlMinutes,
        RollbackExpected = _rollbackExpected,
        InstanceUrl = CapturedContext?.ServerUri,
        CustomerId = string.IsNullOrWhiteSpace(CapturedContext?.TenantId) ? null : CapturedContext.TenantId,
        Context = CapturedContext?.ToContextRequest()
    };

    private static string FormatEnvironment(ConsoleSupportContext context) =>
        string.IsNullOrWhiteSpace(context.EnvironmentName)
            ? context.EnvironmentKind
            : $"{context.EnvironmentName} ({context.EnvironmentKind})";

    private static string NormalizeOrDefault(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value.Trim();

    private static string FallbackMessage(OperateSectionStatus status, string message) =>
        string.IsNullOrWhiteSpace(message) ? OperateSectionPresentation.FallbackMessage(status) : message;

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
