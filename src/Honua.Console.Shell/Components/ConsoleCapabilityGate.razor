@inject Honua.Console.Shell.Services.IConsoleCapabilityManifest Capabilities

@if (Capabilities.IsAdvertised(Capability))
{
    @ChildContent
}
else
{
    <ConsoleStateView Kind="unsupported" HeadingLevel="@HeadingLevel"
                      Kicker="@Kicker"
                      Title="@Title"
                      Message="@Message"
                      ActionHref="@ActionHref"
                      ActionLabel="@ActionLabel" />
}

@code {
    [Parameter]
    public int HeadingLevel { get; set; } = 1;

    [Parameter]
    [EditorRequired]
    public string Capability { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Kicker { get; set; } = "Not in this release";

    [Parameter]
    public string Title { get; set; } = "Capability not available in this release";

    [Parameter]
    public string? ActionHref { get; set; }

    [Parameter]
    public string? ActionLabel { get; set; }

    [Parameter]
    public string Message { get; set; } =
        "This capability is deferred for the current release and is not advertised by the connected environment. It lights up here once the capability is enabled for your account.";
}
