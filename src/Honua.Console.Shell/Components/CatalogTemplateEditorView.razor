<section class="catalog-template-editor" aria-labelledby="template-editor-heading">
    <h2 id="template-editor-heading">Template: @Template.Title</h2>
    <p>@CatalogAdminLabels.TemplateState(Template.State) · Version @(Template.Version ?? "not reported")</p>
    <p>Saving and releasing are unavailable until the server provides sanitization, version and approval contracts. Edits below stay in this page and are lost when discarded.</p>
    <UnsavedChangesGuard IsDirty="IsDirty" />
    <div class="catalog-template-layout">
        <section aria-labelledby="template-source-heading">
            <h3 id="template-source-heading">HTML</h3>
            <label for="template-source">Template source</label>
            <textarea id="template-source" @ref="_sourceInput" rows="18" spellcheck="false" @bind="_source" @bind:event="oninput" aria-describedby="template-safety">@_source</textarea>
            <p id="template-safety">Source is displayed as text. It is never executed here. The server must sanitize HTML and escape variables before a sandboxed preview or release.</p>
        </section>
        <section aria-labelledby="template-preview-heading">
            <h3 id="template-preview-heading">Preview</h3>
            <p>Preview is unavailable until the server can render sanitized HTML with the selected visitor's access. No anonymous or signed-in preview has been produced.</p>
        </section>
    </div>
    <h3>Component reference</h3>
    <p>Draft search and card attributes only. Inserting adds source text; no component bundle is loaded or published by this editor.</p>
    <div class="catalog-admin-table" role="region" aria-label="Draft component reference" tabindex="0">
        <table>
            <thead><tr><th scope="col">Component</th><th scope="col">Attributes</th><th scope="col">Insert</th></tr></thead>
            <tbody>
                @foreach (var component in Components)
                {
                    <tr>
                        <th scope="row"><code>@component.Tag</code></th><td>@component.Attributes</td>
                        <td><button type="button" class="console-button console-button-secondary" data-template-insert aria-label="@($"Insert {component.Tag}")" @onclick="() => Insert(component)">Insert</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="console-action-row">
        <p role="status" class="catalog-template-status">@(IsDirty ? "Unsaved local changes · nothing saved or released" : "Source unchanged")</p>
        <button type="button" class="console-button console-button-secondary" data-template-discard disabled="@(!IsDirty)" @onclick="() => _confirmDiscard = true">Discard local edits</button>
    </div>
    @if (_confirmDiscard && IsDirty)
    {
        <div role="group" aria-label="Discard local edits">
            <p>Discard all local edits and return to the reported source?</p>
            <button type="button" class="console-button" data-template-confirm @onclick="ConfirmDiscardAsync">Discard edits</button>
            <button type="button" class="console-button console-button-secondary" data-template-keep @onclick="KeepEditingAsync">Keep editing</button>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public CatalogTemplateDocument Template { get; set; } = default!;
    private CatalogTemplateDocument? _loaded;
    private string _source = string.Empty;
    private bool _confirmDiscard;
    private ElementReference _sourceInput;
    private bool IsDirty => _source != Template.Source;
    private sealed record ComponentReference(string Tag, string Attributes, string IdentityAttribute);
    private static readonly ComponentReference[] Components =
    [
        new("honua-catalog-search", "catalog, kind, category, limit, label", ""),
        new("honua-service-card", "catalog, service", "service"),
        new("honua-layer-card", "catalog, layer", "layer"),
        new("honua-dataset-card", "catalog, dataset", "dataset"),
        new("honua-map-card", "catalog, map", "map"),
        new("honua-app-card", "catalog, app", "app")
    ];

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loaded, Template)) return;
        _loaded = Template;
        Discard();
    }

    private void Insert(ComponentReference component)
    {
        var catalog = System.Net.WebUtility.HtmlEncode(Template.CatalogId);
        var identity = component.IdentityAttribute.Length == 0 ? string.Empty : $" {component.IdentityAttribute}=\"{{{{ item.id }}}}\"";
        _source += $"\n<{component.Tag} catalog=\"{catalog}\"{identity}></{component.Tag}>";
    }

    private async Task ConfirmDiscardAsync()
    {
        Discard();
        await _sourceInput.FocusAsync();
    }

    private async Task KeepEditingAsync()
    {
        _confirmDiscard = false;
        await _sourceInput.FocusAsync();
    }

    private void Discard()
    {
        _source = Template.Source;
        _confirmDiscard = false;
    }
}
