@namespace Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Validation
@inject IServiceProvider ServiceProvider

@* Shared source-content intake. Connected reads require a live server binding; local JSON intake is parsed in Console. *@
@if (ServiceProvider.GetService<ConsoleV4Options>()?.Enabled == true)
{
    <ConsolePanel Title="@($"Source {Noun}")" HeadingId="esri-intake-heading">@Body</ConsolePanel>
}
else
{
    @Body
}

@code {
    private RenderFragment Body => @<div class="esri-intake" data-esri-intake>
    <div class="esri-intake__bar">
        <div class="esri-intake__modes" role="tablist" aria-label="Intake mode">
            @foreach (var option in ModeOptions)
            {
                <button type="button"
                        role="tab"
                        class="esri-intake__mode @(option.Mode == _mode ? "esri-intake__mode--on" : string.Empty)"
                        aria-selected="@(option.Mode == _mode)"
                        data-intake-mode="@option.Mode"
                        @onclick="() => SetMode(option.Mode)">
                    @option.Label
                </button>
            }
        </div>
        <div class="esri-intake__spacer"></div>
        @if (Result is not null)
        {
            <span class="console-muted esri-intake__source">@Result.SourceLabel · @Result.SourceFile</span>
        }
    </div>

    @if (_mode is "paste")
    {
        <div class="esri-intake__input">
            <textarea class="console-input esri-intake__textarea"
                      rows="5"
                      placeholder="@PastePlaceholder"
                      aria-label="@($"Paste {Noun} JSON")"
                      aria-invalid="@(_validation.HasErrorsFor(EsriImportFieldKeys.Json) ? "true" : null)"
                      @bind="_pasteValue"
                      @bind:event="oninput"
                      @bind:after="OnPasteEdit"></textarea>
            <ValidationMessageInline FieldKey="@EsriImportFieldKeys.Json" State="_validation" />
            <ValidationMessageInline FieldKey="@EsriImportFieldKeys.Source" State="_validation" />
            <div class="console-button-row">
                <button type="button" class="console-button console-button-sm" @onclick="ParsePaste">Parse JSON</button>
                @if (!string.IsNullOrWhiteSpace(SampleJson))
                {
                    <button type="button" class="console-button-ghost console-button-sm" data-intake-sample @onclick="LoadSample">Load a sample</button>
                }
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <span class="console-status console-state-danger" data-intake-error>@_error</span>
                }
            </div>
        </div>
    }
    else if (_mode is "upload")
    {
        <div class="esri-intake__input">
            <InputFile class="esri-intake__file" OnChange="OnFileSelected" accept=".json,application/json" aria-label="@($"Upload {Noun} JSON file")" />
            <ValidationMessageInline FieldKey="@EsriImportFieldKeys.Source" State="_validation" />
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <span class="console-status console-state-danger" data-intake-error>@_error</span>
            }
        </div>
    }
    else if (_mode is "url")
    {
        <div class="esri-intake__input">
            <label class="studio-form-label">
                <span>@($"{Noun} URL or item id")</span>
                <input class="console-input"
                       type="text"
                       data-intake-url
                       placeholder="https://… or item id"
                       aria-label="@($"{Noun} URL or item id")"
                       aria-invalid="@(_validation.HasErrorsFor(EsriImportFieldKeys.Url) ? "true" : null)"
                       @bind="_urlValue"
                       @bind:event="oninput"
                       @bind:after="OnUrlEdit" />
                <ValidationMessageInline FieldKey="@EsriImportFieldKeys.Url" State="_validation" />
                <ValidationMessageInline FieldKey="@EsriImportFieldKeys.Source" State="_validation" />
            </label>
            <div class="esri-intake__binding" data-intake-binding>
                <span class="console-status console-state-info">binding required</span>
                <span>
                    Fetching by URL or item ID reads from a connected source GIS system through honua-server.
                    Paste or upload the @Noun JSON to convert it now without a server.
                </span>
            </div>
        </div>
    }
    else
    {
        @* connected-ArcGIS requires a live fetch -> binding-required note. *@
        <div class="esri-intake__binding" data-intake-binding>
            <span class="console-status console-state-info">binding required</span>
            <span>
                Reading from a connected source organization requires a bound honua-server.
                Paste or upload the @Noun JSON to convert it now without a server.
            </span>
        </div>
    }

    @if (Result is not null)
    {
        <div class="esri-intake__summary" data-intake-summary>
            @foreach (var chip in Result.IntakeSummary)
            {
                <span class="console-type-tag">@chip</span>
            }
        </div>
    }
</div>;

    private string _mode = "paste";
    private string _pasteValue = string.Empty;
    private string _urlValue = string.Empty;
    private string? _uploadFileName;
    private string? _error;
    private readonly ValidationState _validation = new();

    private readonly record struct ModeOption(string Mode, string Label);

    private static readonly ModeOption[] ModeOptions =
    [
        new("paste", "Paste JSON"),
        new("upload", "Upload file"),
        new("url", "From URL / item ID"),
        new("arcgis", "From connected source"),
    ];

    /// <summary>The parsed conversion result the host page is currently showing (null before any parse).</summary>
    [Parameter]
    public EsriConversionResult? Result { get; set; }

    /// <summary>The content noun used in placeholders/labels ("Web Map", "Dashboard", "StoryMap").</summary>
    [Parameter]
    public string Noun { get; set; } = "content";

    /// <summary>The content kind, used by the intake validator's shape expectation.</summary>
    [Parameter]
    public EsriContentKind Kind { get; set; } = EsriContentKind.WebMap;

    /// <summary>Parses the pasted/uploaded JSON into a conversion result; returns the outcome.</summary>
    [Parameter, EditorRequired]
    public Func<string, string?, EsriParseOutcome> Parse { get; set; } = (_, _) => EsriParseOutcome.Failure("No parser bound.");

    /// <summary>Raised with the conversion result on a successful parse.</summary>
    [Parameter]
    public EventCallback<EsriConversionResult> OnParsed { get; set; }

    /// <summary>
    /// The host editor's dirty-state holder. The intake marks it dirty on edit and clears it on a
    /// successful parse, so the host's <c>&lt;UnsavedChangesGuard/&gt;</c> warns when intake is unsaved.
    /// </summary>
    [Parameter]
    public FormDirtyState? Dirty { get; set; }

    /// <summary>
    /// Optional illustrative sample document. When set, a "Load a sample" action parses it through the same
    /// parser on an explicit user click — the page never auto-populates with the sample, so the default
    /// state is the empty intake (the sample is not presented as the user's own import).
    /// </summary>
    [Parameter]
    public string? SampleJson { get; set; }

    /// <summary>Optional file label used when loading the sample.</summary>
    [Parameter]
    public string? SampleFileName { get; set; }

    private string PastePlaceholder => $"Paste the {Noun} JSON here…";

    private EsriIntakeMode CurrentMode => _mode switch
    {
        "upload" => EsriIntakeMode.Upload,
        "url" => EsriIntakeMode.Url,
        "arcgis" => EsriIntakeMode.ConnectedArcGis,
        _ => EsriIntakeMode.Paste,
    };

    private EsriImportIntakeState BuildIntakeState() => new(
        Kind,
        CurrentMode,
        PastedJson: _pasteValue,
        UploadFileName: _uploadFileName,
        Url: _urlValue);

    private void Revalidate() =>
        _validation.SetClientErrors(EsriImportValidator.Instance.Evaluate(BuildIntakeState()));

    private void OnPasteEdit()
    {
        Dirty?.MarkDirty();
        Revalidate();
    }

    private void OnUrlEdit()
    {
        Dirty?.MarkDirty();
        Revalidate();
    }

    private async Task LoadSample()
    {
        if (string.IsNullOrWhiteSpace(SampleJson))
        {
            return;
        }

        _pasteValue = SampleJson;
        Dirty?.MarkDirty();
        await ParseAndApply(SampleJson, SampleFileName);
    }

    private void SetMode(string mode)
    {
        _mode = mode;
        _error = null;
        // A staged upload file is meaningful only in upload mode; drop it when switching away so the
        // source-required finding reflects the now-visible input rather than a hidden staged file.
        if (mode is not "upload")
        {
            _uploadFileName = null;
        }

        Revalidate();
    }

    private async Task ParsePaste()
    {
        Revalidate();
        // Don't issue the parse when the intake is structurally invalid (no source / bad JSON / bad URL).
        if (_validation.HasBlockingClientErrors
            || _validation.HasErrorsFor(EsriImportFieldKeys.Json))
        {
            return;
        }

        await ParseAndApply(_pasteValue, null);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        Dirty?.MarkDirty();
        // Record the chosen file as the intake source so the source-required finding clears even if the
        // read / parse then fails (the operator did provide a source — only the parse error should show).
        _uploadFileName = file.Name;
        Revalidate();

        string json;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 32 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            json = await reader.ReadToEndAsync();
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            _error = $"Could not read the file: {ex.Message}";
            return;
        }

        await ParseAndApply(json, file.Name);
    }

    private async Task ParseAndApply(string json, string? fileName)
    {
        var outcome = Parse(json, fileName);
        if (outcome.Succeeded)
        {
            _error = null;
            _validation.Clear();
            // A successful parse is the saved baseline for this intake.
            Dirty?.MarkClean();
            if (OnParsed.HasDelegate)
            {
                await OnParsed.InvokeAsync(outcome.Result);
            }
        }
        else
        {
            _error = outcome.Error;
        }
    }
}
