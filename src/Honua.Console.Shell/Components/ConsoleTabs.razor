@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="console-tabs" role="tablist" aria-label="@Label" @ref="_element">
    @foreach (var tab in Tabs)
    {
        <button type="button" id="@tab.Id" role="tab" aria-selected="@(tab.Id == SelectedId ? "true" : "false")"
                aria-controls="@tab.PanelId" tabindex="@(tab.Id == SelectedId ? 0 : -1)"
                @onclick="() => SelectedIdChanged.InvokeAsync(tab.Id)">@tab.Label</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ConsoleTab> Tabs { get; set; } = [];
    [Parameter, EditorRequired] public string SelectedId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SelectedIdChanged { get; set; }

    private ElementReference _element;
    private IJSObjectReference? _module;

    protected override void OnParametersSet()
    {
        if (Tabs.Count == 0 || !Tabs.Any(tab => tab.Id == SelectedId) ||
            Tabs.Any(tab => string.IsNullOrWhiteSpace(tab.Id) || string.IsNullOrWhiteSpace(tab.Label) || string.IsNullOrWhiteSpace(tab.PanelId)) ||
            Tabs.SelectMany(tab => new[] { tab.Id, tab.PanelId }).Distinct(StringComparer.Ordinal).Count() != Tabs.Count * 2)
        {
            throw new InvalidOperationException("Tabs require unique tab and panel IDs, labels, and a selected tab.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Honua.Console.Shell/console-tabs.js");
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("attach", _element);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("detach", _element);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
