@namespace Honua.Console.Shell.Components
@using Honua.Console.Shell.Interop
@using Microsoft.JSInterop
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@implements IAsyncDisposable

@if (_open)
{
    <dialog class="console-confirm-backdrop" data-console-confirm @ref="_element"
            role="alertdialog" aria-modal="true" aria-labelledby="console-confirm-title"
            @onkeydown="HandleKeyDown" @onclick="Cancel">
        <div class="console-confirm-dialog"
             @onclick:stopPropagation="true">
            <h2 id="console-confirm-title" class="console-confirm-title">@_title</h2>
            @if (!string.IsNullOrWhiteSpace(_body))
            {
                <p class="console-confirm-body">@_body</p>
            }
            <div class="console-confirm-actions">
                <button type="button"
                        class="console-button console-button-secondary"
                        autofocus
                        disabled="@_pending"
                        @onclick="Cancel">
                    @_cancelLabel
                </button>
                <button type="button"
                        class="console-button console-button-danger"
                        disabled="@_pending"
                        data-console-confirm-accept
                        @onclick="ConfirmAsync">
                    @(_pending ? "Working…" : _confirmLabel)
                </button>
            </div>
        </div>
    </dialog>
}

@code {
    private const string ModulePath = "./_content/Honua.Console.Shell/console-confirm-dialog.js";
    private readonly CancellationTokenSource _importLifetime = new();
    private readonly RetryingModuleImport _moduleImport = new(ModuleImportScriptError.Retry);
    private ElementReference _element;
    private IJSObjectReference? _module;
    private bool _importing;
    private bool _shown;
    private bool _open;
    private bool _pending;
    private string _title = "Are you sure?";
    private string? _body;
    private string _confirmLabel = "Confirm";
    private string _cancelLabel = "Cancel";
    private Func<Task>? _onConfirm;

    public void Open(
        string title,
        Func<Task> onConfirm,
        string? body = null,
        string confirmLabel = "Confirm",
        string cancelLabel = "Cancel")
    {
        _title = title;
        _body = body;
        _confirmLabel = confirmLabel;
        _cancelLabel = cancelLabel;
        _onConfirm = onConfirm;
        _pending = false;
        _open = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null && !_open)
        {
            return;
        }

        if (_module is null && !_importing)
        {
            _importing = true;
            try
            {
                _module = await _moduleImport.LoadAsync(
                    Services.GetRequiredService<IJSRuntime>(),
                    ModulePath,
                    _importLifetime.Token);
            }
            catch (TimeoutException)
            {
                return;
            }
            catch (JSDisconnectedException)
            {
                return;
            }
            catch (JSException)
            {
                return;
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch (InvalidOperationException)
            {
                return;
            }
            finally
            {
                _importing = false;
            }
        }

        if (_module is null || _open == _shown)
        {
            return;
        }

        _shown = _open;
        try
        {
            if (_open)
            {
                await _module.InvokeVoidAsync("show", _element, _element.Id);
            }
            else
            {
                await _module.InvokeVoidAsync("close", _element.Id);
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone; the dialog state already matches the request.
        }
        catch (JSException)
        {
            // The dialog stays in the tree when the browser refuses show or close.
        }
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") Cancel();
    }

    public async ValueTask DisposeAsync()
    {
        _importLifetime.Cancel();
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("close", _element.Id);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }

    private void Cancel()
    {
        if (_pending)
        {
            return;
        }

        _open = false;
        _onConfirm = null;
    }

    private async Task ConfirmAsync()
    {
        if (_pending || _onConfirm is null)
        {
            return;
        }

        var handler = _onConfirm;
        _pending = true;
        try
        {
            await handler();
        }
        finally
        {
            _pending = false;
            _open = false;
            _onConfirm = null;
        }
    }
}
