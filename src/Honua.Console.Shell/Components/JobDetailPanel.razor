<aside class="console-panel operate-detail-panel" aria-labelledby="job-detail-heading">
    <p class="console-kicker">Job detail</p>
    <h3 id="job-detail-heading">@Job.JobRunId</h3>
    <p>@Job.Status.Description</p>

    <dl class="console-definition-list">
        <dt>Source</dt>
        <dd>@Job.Source</dd>
        <dt>Type</dt>
        <dd>@Job.JobType</dd>
        <dt>Queue</dt>
        <dd>@Job.Queue</dd>
        <dt>Submitted by</dt>
        <dd>@Job.SubmittedBy</dd>
        <dt>Failure class</dt>
        <dd>@Job.FailureClassification</dd>
        @if (!string.IsNullOrWhiteSpace(Job.EffectiveIdentity.CorrelationId))
        {
            <dt>Audit correlation</dt>
            <dd data-job-correlation-id><CorrelationIdChip Value="@Job.EffectiveIdentity.CorrelationId" Kind="CorrelationIdKind.CorrelationId" /></dd>
        }
        @if (!string.IsNullOrWhiteSpace(Job.EffectiveIdentity.TraceId))
        {
            <dt>Trace</dt>
            <dd class="console-mono" data-job-trace-id>@Job.EffectiveIdentity.TraceId</dd>
        }
        @if (!string.IsNullOrWhiteSpace(Job.EffectiveIdentity.ProviderOperationId))
        {
            <dt>Provider operation</dt>
            <dd class="console-mono" data-job-provider-operation-id>@Job.EffectiveIdentity.ProviderOperationId</dd>
        }
    </dl>

    @if (Job.EffectiveIdentity.IsEsriGpServer)
    {
        <section class="operate-evidence-section" data-esri-gpserver-identity>
            <p class="console-kicker">ArcGIS migration</p>
            <h4>Esri GPServer identity</h4>
            <p class="console-muted">
                This is the Esri-compatible name for the same canonical Honua process and job.
                Console is inspecting the shared runtime; it is not running a second execution engine.
            </p>
            <dl class="console-definition-list">
                <dt>GPServer service</dt>
                <dd class="console-mono" data-gpserver-service-id>@Job.EffectiveIdentity.GpServerServiceId</dd>
                <dt>Esri task</dt>
                <dd class="console-mono" data-gpserver-task-name>@Job.EffectiveIdentity.GpServerTaskName</dd>
                @if (!string.IsNullOrWhiteSpace(Job.EffectiveIdentity.ProcessId))
                {
                    <dt>Canonical process</dt>
                    <dd class="console-mono" data-canonical-process-id>@Job.EffectiveIdentity.ProcessId</dd>
                }
                @if (!string.IsNullOrWhiteSpace(Job.EffectiveIdentity.ResultPackageId))
                {
                    <dt>Result package</dt>
                    <dd class="console-mono" data-result-package-id>@Job.EffectiveIdentity.ResultPackageId</dd>
                }
                <dt>GPServer job route</dt>
                <dd><code data-gpserver-job-route>@Job.EffectiveIdentity.GpServerJobPath(Job.JobRunId)</code></dd>
            </dl>
        </section>
    }

    @if (Job.EffectiveIdentity.SelectedMetadata.Count > 0)
    {
        <details class="operate-evidence-section" data-job-selected-metadata>
            <summary>Server-selected job metadata</summary>
            <dl class="console-definition-list">
                @foreach (var item in Job.EffectiveIdentity.SelectedMetadata)
                {
                    <dt>@item.Key</dt>
                    <dd class="console-mono">@item.Value</dd>
                }
            </dl>
        </details>
    }

    <div class="operate-progress operate-progress-large" aria-label="@($"{Job.ProgressPercent} percent complete")">
        <span style="@($"width: {Job.ProgressPercent}%")"></span>
    </div>

    <section class="operate-evidence-section">
        <h4>Stages</h4>
        <ol class="operate-stage-list">
            @foreach (var stage in Job.Stages)
            {
                <li>
                    <span class="console-status @stage.Status.CssClass">@stage.Status.Label</span>
                    <strong>@stage.Name</strong>
                    <p>@stage.Detail</p>
                    <div class="operate-progress" aria-label="@($"{stage.ProgressPercent} percent complete")">
                        <span style="@($"width: {stage.ProgressPercent}%")"></span>
                    </div>
                </li>
            }
        </ol>
    </section>

    <section class="operate-evidence-section">
        <h4>Logs</h4>
        @if (Job.LogsAllowed)
        {
            <pre class="operate-log-lines">@string.Join(Environment.NewLine, Job.Logs)</pre>
        }
        else
        {
            <div class="operate-subresource-status">
                <span class="console-status @SubresourceStatusClass(Job.LogsStatus)">@OperateSectionPresentation.Title(Job.LogsStatus)</span>
                <p class="console-muted">@SubresourceMessage(Job.LogsStatus, Job.LogsMessage)</p>
            </div>
        }
    </section>

    @if (Job.ArtifactsAllowed)
    {
        <EvidenceList Heading="Artifacts" Items="Job.Artifacts" />
    }
    else
    {
        <section class="operate-evidence-section">
            <h4>Artifacts</h4>
            <div class="operate-subresource-status">
                <span class="console-status @SubresourceStatusClass(Job.ArtifactsStatus)">@OperateSectionPresentation.Title(Job.ArtifactsStatus)</span>
                <p class="console-muted">@SubresourceMessage(Job.ArtifactsStatus, Job.ArtifactsMessage)</p>
            </div>
        </section>
    }

    <section class="operate-evidence-section">
        <h4>Metrics</h4>
        <div class="operate-metric-grid">
            @foreach (var metric in Job.Metrics)
            {
                <div>
                    <span>@metric.Name</span>
                    <strong>@metric.Value</strong>
                    <small class="@metric.Status.CssClass">@metric.Status.Label</small>
                </div>
            }
        </div>
    </section>

    <section class="operate-evidence-section">
        <h4>Allowed actions</h4>
        <div class="operate-action-row">
            @foreach (var action in Job.AllowedActions)
            {
                <button class="console-button" type="button" disabled title="@JobActionTitle(action)">@action.Label</button>
            }
        </div>
    </section>
</aside>

@code {
    [Parameter, EditorRequired]
    public required OperateJobRun Job { get; set; }

    private static string JobActionTitle(OperateJobAction action) => action.Reason;

    private static string SubresourceMessage(OperateSectionStatus status, string message) =>
        string.IsNullOrWhiteSpace(message)
            ? OperateSectionPresentation.FallbackMessage(status)
            : message;

    private static string SubresourceStatusClass(OperateSectionStatus status) => status switch
    {
        OperateSectionStatus.Forbidden => "console-state-danger",
        OperateSectionStatus.Missing or OperateSectionStatus.Unsupported => "console-state-warning",
        OperateSectionStatus.Allowed => "console-state-success",
        _ => "console-state-neutral"
    };
}
