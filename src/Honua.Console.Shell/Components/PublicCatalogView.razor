@inject NavigationManager Navigation

<section class="public-catalog" aria-label="Open data catalog" data-public-catalog>
    <header class="public-catalog-brand">
        <strong>Open data catalog</strong>
        <small>Public maps, layers, services, and documents</small>
    </header>
    <div class="public-catalog-hero">
        <h1>Explore open data</h1>
        <p>Browse @Items.Count public @(Items.Count == 1 ? "item" : "items"). Everything here is open to read; each item lists how to connect from your own software.</p>
        @if (HasMoreItems)
        {
            <p class="public-catalog-limit-note">Search and filters cover only the items shown here. The server has more public items.</p>
        }
        <form class="public-catalog-search-form" role="search" @onsubmit="Search" @onsubmit:preventDefault>
            <label class="public-catalog-search-field">
                <span class="console-visually-hidden">Search open data</span>
                <svg class="public-catalog-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.5-3.5" />
                </svg>
                <input id="public-catalog-search" class="console-input" type="search"
                       placeholder="Search public maps, layers, services, and documents"
                       @bind="_query" @bind:event="oninput" />
            </label>
            <button type="submit" class="console-button console-button-primary">Search</button>
        </form>
    </div>
    @{
        var kinds = KindFacets();
        var formats = FormatFacets();
        var results = Results();
        var totalPages = results.Length == 0 ? 1 : (results.Length - 1) / PageSize + 1;
        var hasSidebar = Items.Count > 0 && (kinds.Length > 0 || formats.Length > 0);
    }
    <div class="public-catalog-grid @(hasSidebar ? null : "public-catalog-grid-single")">
        @if (hasSidebar)
        {
            <aside class="public-catalog-facets" aria-label="Filters">
                @if (kinds.Length > 0)
                {
                    <div class="public-catalog-facet">
                        <h2>Kind</h2>
                        @foreach (var kind in kinds)
                        {
                            <button type="button" class="public-catalog-facet-btn"
                                    aria-pressed="@(_kind == kind.Key ? "true" : "false")"
                                    @onclick="() => FilterKind(kind.Key)">
                                <span>@CatalogContentTypes.LabelFor(kind.Key)</span>
                                <span class="public-catalog-facet-count">(@kind.Count)</span>
                            </button>
                        }
                    </div>
                }
                @if (formats.Length > 0)
                {
                    <div class="public-catalog-facet">
                        <h2>Connect with</h2>
                        @foreach (var format in formats)
                        {
                            <button type="button" class="public-catalog-facet-btn"
                                    aria-pressed="@(SameFormat(_format, format.Key) ? "true" : "false")"
                                    @onclick="() => FilterFormat(format.Key)">
                                <span>@ConsoleDownloadFormatLabels.Display(format.Key)</span>
                                <span class="public-catalog-facet-count" aria-hidden="true">@format.Count</span>
                            </button>
                        }
                    </div>
                }
            </aside>
        }
        <section class="public-catalog-results" aria-label="Search results">
            <div class="public-catalog-toolbar">
                <h2 aria-live="polite">@results.Length results</h2>
                <label class="public-catalog-sort">
                    <span>Sort</span>
                    <select class="console-input" @bind="_sort" @bind:after="ResetPage">
                        <option value="recent">Recently updated</option>
                        <option value="title">Title</option>
                    </select>
                </label>
            </div>
            @if (HasActiveFilters)
            {
                <div class="public-catalog-applied" aria-label="Applied filters">
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button type="button" class="public-catalog-applied-chip"
                                aria-label="Remove search filter"
                                @onclick="ClearSearch">
                            <span>Search: @_search</span>
                            <span aria-hidden="true">&times;</span>
                        </button>
                    }
                    @if (_kind is not null)
                    {
                        <button type="button" class="public-catalog-applied-chip"
                                aria-label="Remove @CatalogContentTypes.LabelFor(_kind) filter"
                                @onclick="() => FilterKind(_kind)">
                            <span>@CatalogContentTypes.LabelFor(_kind)</span>
                            <span aria-hidden="true">&times;</span>
                        </button>
                    }
                    @if (_format is not null)
                    {
                        <button type="button" class="public-catalog-applied-chip"
                                aria-label="Remove @ConsoleDownloadFormatLabels.Display(_format) filter"
                                @onclick="() => FilterFormat(_format)">
                            <span>@ConsoleDownloadFormatLabels.Display(_format)</span>
                            <span aria-hidden="true">&times;</span>
                        </button>
                    }
                    @if (ActiveFilterCount > 1)
                    {
                        <button type="button" class="public-catalog-clear-btn" @onclick="ClearAllFilters">Clear all</button>
                    }
                </div>
            }
            @if (Items.Count == 0)
            {
                <ConsoleStateView HeadingLevel="3" Kind="empty" Kicker="Open data"
                                  Title="No public open-data items"
                                  Message="Publish a service, layer, or document as public open data to expose it here." />
            }
            else if (results.Length == 0)
            {
                <ConsoleStateView HeadingLevel="3" Kind="empty" Kicker="No matches"
                                  Title="No matching public items"
                                  Message="Try a different search or remove a filter." />
            }
            else
            {
                <div class="public-catalog-cards">
                    @foreach (var item in results.Skip(_page * PageSize).Take(PageSize))
                    {
                        <article class="public-catalog-card" @key="item.Id">
                            <div class="public-catalog-thumb" data-kind="@item.Type">
                                @KindArtwork(item.Type)
                                <span class="public-catalog-kind">
                                    @KindIcon(item.Type)
                                    <span>@CatalogContentTypes.LabelFor(item.Type)</span>
                                </span>
                            </div>
                            <div class="public-catalog-card-body">
                                <h3><a href="@Navigation.ToConsoleHref($"/share/public/items/{Uri.EscapeDataString(item.Id)}")">@item.Title</a></h3>
                                @if (!string.IsNullOrWhiteSpace(item.Summary))
                                {
                                    <p class="public-catalog-summary">@item.Summary</p>
                                }
                                @if (item.Modified > DateTimeOffset.UnixEpoch || !string.IsNullOrWhiteSpace(item.Owner))
                                {
                                    <div class="public-catalog-card-meta">
                                        @if (item.Modified > DateTimeOffset.UnixEpoch)
                                        {
                                            <span>Updated <time datetime="@item.Modified.ToString("O")">@FormatDate(item.Modified)</time></span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(item.Owner))
                                        {
                                            <span>@item.Owner</span>
                                        }
                                    </div>
                                }
                                @if (item.Tags.Length > 0)
                                {
                                    <div class="public-catalog-tags">
                                        @foreach (var tag in item.Tags)
                                        {
                                            <span class="public-catalog-tag">@tag</span>
                                        }
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            @if (results.Length > PageSize)
            {
                <nav aria-label="Results pages" class="public-catalog-pager">
                    <button type="button" class="console-button console-button-secondary public-catalog-page-btn"
                            disabled="@(_page == 0)" @onclick="() => SelectPage(_page - 1)">Previous</button>
                    @foreach (var pageIndex in VisiblePages(totalPages))
                    {
                        <button type="button"
                                class="public-catalog-page-num"
                                aria-current="@(_page == pageIndex ? "page" : null)"
                                aria-label="Page @(pageIndex + 1)"
                                @onclick="() => SelectPage(pageIndex)">@(pageIndex + 1)</button>
                    }
                    <button type="button" class="console-button console-button-secondary public-catalog-page-btn"
                            disabled="@(_page + 1 >= totalPages)" @onclick="() => SelectPage(_page + 1)">Next</button>
                    <span class="public-catalog-pager-status">Page @(_page + 1) of @totalPages</span>
                </nav>
            }
        </section>
    </div>
    <section class="public-catalog-notice" aria-labelledby="public-catalog-feeds-heading">
        <svg class="public-catalog-notice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14" />
            <circle cx="6" cy="18" r="1.5" fill="currentColor" />
        </svg>
        <p>
            <strong id="public-catalog-feeds-heading">For developers and data portals:</strong>
            this catalog is served as open-data JSON at <code class="console-inline-code">/api/v1/open-data/datasets</code> alongside the server's OGC API and STAC discovery feeds.
        </p>
    </section>
    <footer class="public-catalog-footer">
        <span>Open data catalog</span>
        <span class="public-catalog-spacer"></span>
        <span>Served by this Honua server</span>
    </footer>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ConsoleContentSummary> Items { get; set; } = [];
    [Parameter] public bool HasMoreItems { get; set; }

    private const int PageSize = 12;
    private string _query = string.Empty;
    private string _search = string.Empty;
    private string _sort = "recent";
    private string? _kind;
    private string? _format;
    private int _page;

    private int ActiveFilterCount =>
        (string.IsNullOrWhiteSpace(_search) ? 0 : 1)
        + (_kind is null ? 0 : 1)
        + (_format is null ? 0 : 1);

    private bool HasActiveFilters => ActiveFilterCount > 0;

    private (string Key, int Count)[] KindFacets() =>
        Items.GroupBy(item => item.Type)
            .OrderBy(group => group.Key, StringComparer.Ordinal)
            .Select(group => (group.Key, group.Count()))
            .ToArray();

    private (string Key, int Count)[] FormatFacets() =>
        Items.SelectMany(item => item.Formats.Distinct(StringComparer.OrdinalIgnoreCase))
            .GroupBy(format => format, StringComparer.OrdinalIgnoreCase)
            .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
            .Select(group => (group.First(), group.Count()))
            .ToArray();

    private ConsoleContentSummary[] Results()
    {
        var matching = Items.Where(item => (_kind is null || item.Type == _kind)
            && (_format is null || item.Formats.Any(format => SameFormat(_format, format)))
            && (Matches(item.Title) || Matches(item.Summary) || item.Tags.Any(Matches)));
        return (_sort == "title"
            ? matching.OrderBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
            : matching.OrderByDescending(item => item.Modified))
            .ThenBy(item => item.Id, StringComparer.Ordinal)
            .ToArray();
    }

    private IEnumerable<int> VisiblePages(int totalPages)
    {
        var start = Math.Max(0, _page - 2);
        var end = Math.Min(totalPages - 1, start + 4);
        start = Math.Max(0, end - 4);
        return Enumerable.Range(start, end - start + 1);
    }

    private static string FormatDate(DateTimeOffset value) =>
        value.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    private static RenderFragment KindIcon(string? kind) => kind switch
    {
        "layer" => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M5 9l7-5 7 5-2 10H7L5 9Z" /></svg>,
        "map" => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="m3 6 6-2 6 2 6-2v14l-6 2-6-2-6 2V6Z" /><path d="M9 4v14M15 6v14" /></svg>,
        "app" => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18" /></svg>,
        "document" => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l5 5v13H6V3Z" /><path d="M14 3v5h5" /></svg>,
        _ => @<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="4" y="4" width="16" height="6" rx="1.5" /><rect x="4" y="14" width="16" height="6" rx="1.5" /></svg>
    };

    private static RenderFragment KindArtwork(string? kind) => kind switch
    {
        "layer" => @<svg viewBox="0 0 320 140" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <path d="M-10 120 C 40 64, 110 59, 180 60 C 240 34, 300 70, 340 50 L 340 150 L -10 150 Z" fill="var(--map-land)" />
            <path d="M90 48 L 188 40 L 208 112 L 106 120 Z" fill="var(--viz-2)" fill-opacity=".32" stroke="var(--viz-2)" stroke-width="2" />
            <path d="M168 72 L 290 60 L 300 130 L 178 134 Z" fill="var(--viz-1)" fill-opacity=".30" stroke="var(--viz-1)" stroke-width="2" />
        </svg>,
        "map" => @<svg viewBox="0 0 320 140" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <path d="M-10 120 C 40 64, 110 59, 180 60 C 240 34, 300 70, 340 50 L 340 150 L -10 150 Z" fill="var(--map-land)" />
            <path d="M98 50 L 188 40 L 208 110 L 108 120 Z" fill="var(--viz-5)" fill-opacity=".30" stroke="var(--viz-5)" stroke-width="2" />
            <path d="M161 70 L 290 60 L 300 130 L 171 135 Z" fill="var(--viz-1)" fill-opacity=".28" stroke="var(--viz-1)" stroke-width="2" />
        </svg>,
        "app" => @<svg viewBox="0 0 320 140" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <path d="M-10 120 C 40 63, 110 47, 180 60 C 240 33, 300 70, 340 50 L 340 150 L -10 150 Z" fill="var(--map-land)" />
            <rect x="18" y="16" width="284" height="108" rx="6" fill="var(--c-surface)" opacity=".92" />
            <rect x="18" y="16" width="284" height="16" rx="6" fill="var(--c-surface-3)" />
            <rect x="26" y="40" width="68" height="76" rx="3" fill="var(--c-surface-2)" />
            <circle cx="192" cy="78" r="6" fill="var(--viz-4)" />
            <circle cx="242" cy="94" r="6" fill="var(--viz-5)" />
        </svg>,
        "document" => @<svg viewBox="0 0 320 140" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <path d="M-10 120 C 40 66, 110 52, 180 60 C 240 36, 300 70, 340 50 L 340 150 L -10 150 Z" fill="var(--map-land)" />
            <rect x="86" y="22" width="148" height="96" rx="6" fill="var(--c-surface)" stroke="var(--c-border)" stroke-width="2" />
            <path d="M108 50h104M108 72h84M108 94h64" stroke="var(--viz-3)" stroke-width="4" stroke-linecap="round" opacity=".55" />
        </svg>,
        _ => @<svg viewBox="0 0 320 140" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <path d="M-10 120 C 40 62, 110 48, 180 60 C 240 33, 300 70, 340 50 L 340 150 L -10 150 Z" fill="var(--map-land)" />
            <path d="M0 92 C 80 72, 160 116, 330 74" stroke="var(--viz-1)" stroke-width="3.5" fill="none" />
            <circle cx="112" cy="84" r="5" fill="var(--viz-3)" stroke="var(--c-surface)" stroke-width="2" />
            <circle cx="218" cy="96" r="5" fill="var(--viz-3)" stroke="var(--c-surface)" stroke-width="2" />
        </svg>
    };

    private bool Matches(string value) => value.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private static bool SameFormat(string? left, string? right) =>
        string.Equals(left, right, StringComparison.OrdinalIgnoreCase);

    private void Search()
    {
        _search = _query.Trim();
        ResetPage();
    }

    private void ClearSearch()
    {
        _query = string.Empty;
        _search = string.Empty;
        ResetPage();
    }

    private void ClearAllFilters()
    {
        _query = string.Empty;
        _search = string.Empty;
        _kind = null;
        _format = null;
        ResetPage();
    }

    private void FilterKind(string? kind)
    {
        _kind = _kind == kind ? null : kind;
        ResetPage();
    }

    private void FilterFormat(string? format)
    {
        _format = SameFormat(_format, format) ? null : format;
        ResetPage();
    }

    private void SelectPage(int page) => _page = Math.Max(0, page);

    private void ResetPage() => _page = 0;
}
