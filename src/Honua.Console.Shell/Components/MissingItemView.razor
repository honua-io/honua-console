<div class="console-page-heading">
    <HonuaState Kind="missing" Kicker="@AreaLabel" Title="@($"{FormatKind(Kind)} Not Found")"
                HeadingLevel="@HeadingLevel" Message="@($"The requested {Kind} is not available.")" />
</div>

@code {
    [Parameter]
    public int HeadingLevel { get; set; } = 1;

    [Parameter]
    public string Kind { get; set; } = "item";

    [Parameter]
    public string? AreaLabel { get; set; }

    private static string FormatKind(string kind)
    {
        if (string.IsNullOrWhiteSpace(kind))
        {
            return "Item";
        }

        return string.Join(
            " ",
            kind.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(word => char.ToUpperInvariant(word[0]) + word[1..]));
    }
}
