@using Honua.Console.Contracts
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IConsoleDeployApprovalClient ApprovalClient
@inject IServiceProvider ServiceProvider
@implements IDisposable

@* Human-in-the-loop approval panel for a single deploy-control operation. Shows the
   proposal detail (service/env/revision/action, change summary, evidence links, required
   approvals, suggested rollback) and the governed actions:
     Approve  -> POST /operations/{id}/submit  (optional reason)
     Rollback -> POST /operations/{id}/rollback (data-affecting requires explicit confirm)
   Status polling reflects AwaitingApproval -> Submitted -> Reconciling -> Succeeded.
   The server's OperatorApprovalGate is the real gate; this panel never bypasses it.

   console#290 addendum (2026-07-07, item 2): there is no server reject endpoint for a
   deploy-control operation, so there is no "Reject" button here. Approving is the ONLY
   affirmative action a paused operation offers; the recovery lever for anything that has
   already gone wrong is Rollback (below) or, for a ManualInterventionRequired operation, the
   findings-driven recovery panel further down. A button that recorded a "rejection" while
   leaving the operation AwaitingApproval on the server would silently no-op — worse than no
   button at all — so the model is stated in prose instead (see the callout under the action
   row) rather than faked. *@

@if (_proposal is null)
{
    <OperateSectionStatusPanel Heading="Deploy approval" Status="_status" Message="@_message" />
}
else
{
    var proposal = _proposal;
    <section class="console-panel operate-deploy-approval-panel" aria-labelledby="deploy-approval-heading">
        <div class="console-panel-heading">
            <div>
                <p class="console-kicker">Deploy approval</p>
                <h3 id="deploy-approval-heading">
                    <span class="console-mono">@proposal.OperationId</span>
                </h3>
            </div>
            <span class="console-status @DeployOperationPresentation.StateClass(proposal.Lifecycle)">
                @DeployOperationPresentation.Label(proposal.Lifecycle)
            </span>
        </div>

        <dl class="console-definition-list operate-deploy-facts">
            <dt>Service</dt>
            <dd class="console-mono">@proposal.Service</dd>
            <dt>Environment</dt>
            <dd class="console-mono">@proposal.Environment</dd>
            <dt>Desired revision</dt>
            <dd class="console-mono">@proposal.DesiredRevision</dd>
            <dt>Action</dt>
            <dd>@proposal.Action</dd>
            <dt>Priority</dt>
            <dd>@proposal.Priority</dd>
            @if (!string.IsNullOrWhiteSpace(proposal.RequestedBy))
            {
                <dt>Requested by</dt>
                <dd>@proposal.RequestedBy</dd>
            }
            @if (proposal.PrUrl is { Length: > 0 } prUrl)
            {
                <dt>Pull request</dt>
                <dd><a class="console-link" href="@prUrl" rel="noopener noreferrer" target="_blank">@prUrl</a></dd>
            }
            @if (!string.IsNullOrWhiteSpace(proposal.CommitSha))
            {
                <dt>Commit</dt>
                <dd class="console-mono">@proposal.CommitSha</dd>
            }
        </dl>

        <div class="operate-deploy-change-summary">
            <h4>Change summary</h4>
            <p class="console-muted">@proposal.ChangeSummary</p>
        </div>

        @if (proposal.Evidence.Count > 0)
        {
            <div class="operate-deploy-evidence">
                <h4>Evidence</h4>
                <ul class="operate-note-list">
                    @foreach (var evidence in proposal.Evidence)
                    {
                        <li>
                            <span class="console-chip">@evidence.Kind</span>
                            @if (evidence.Uri is { Length: > 0 } uri)
                            {
                                <a class="console-link" href="@uri" rel="noopener noreferrer" target="_blank">@evidence.RefId</a>
                            }
                            else
                            {
                                <span class="console-mono">@evidence.RefId</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @if (proposal.BlockingReasons.Count > 0)
        {
            <div class="console-usage-callout operate-deploy-callout-warn">
                <strong>Blocking findings.</strong>
                <ul class="operate-note-list">
                    @foreach (var blocker in proposal.BlockingReasons)
                    {
                        <li class="console-state-danger">@blocker</li>
                    }
                </ul>
            </div>
        }

        @if (proposal.Warnings.Count > 0)
        {
            <ul class="operate-note-list operate-deploy-warnings">
                @foreach (var warning in proposal.Warnings)
                {
                    <li class="console-state-warning">@warning</li>
                }
            </ul>
        }

        @* SUGGESTED ROLLBACK — surfaced before any action so rollback readiness and the
           data-affecting confirmation requirement are visible up-front. *@
        @if (proposal.RollbackPlan is { } rollback)
        {
            <div class="operate-deploy-rollback-summary">
                <h4>Suggested rollback</h4>
                <p class="console-status @(rollback.RequiresConfirmation ? "console-state-warning" : "console-state-neutral")">
                    @GitOpsReleasePresentation.Label(rollback.Classification)
                    @if (rollback.IsDataAffecting)
                    {
                        <span> &middot; data-affecting</span>
                    }
                </p>
                <p class="console-muted">@GitOpsReleasePresentation.Description(rollback.Classification)</p>
                <dl class="console-definition-list">
                    <dt>Data-affecting</dt>
                    <dd>@(rollback.IsDataAffecting ? "yes" : "no")</dd>
                    <dt>Requires explicit approval</dt>
                    <dd>@(rollback.RequiresConfirmation ? "yes" : "no")</dd>
                    @if (!string.IsNullOrWhiteSpace(rollback.ApprovalPolicyRef))
                    {
                        <dt>Approval policy</dt>
                        <dd>@rollback.ApprovalPolicyRef</dd>
                    }
                </dl>
                @if (rollback.Steps.Count > 0)
                {
                    <ol class="operate-note-list">
                        @foreach (var step in rollback.Steps)
                        {
                            <li>@step</li>
                        }
                    </ol>
                }
            </div>
        }

        @* GOVERNED ACTIONS — reason field + approve/rollback. Approve is offered only while
           AwaitingApproval; Rollback only when rollback-eligible. There is no Reject action:
           see the "deploy operations are approved in the inbox" callout below the action row. *@
        <div class="operate-deploy-actions">
            <label class="operate-deploy-reason-label" for="deploy-approval-reason">Reason (optional)</label>
            <textarea id="deploy-approval-reason"
                      class="operate-deploy-reason"
                      rows="2"
                      placeholder="Why are you approving / rolling back?"
                      disabled="@_busy"
                      @bind="_reason"></textarea>

            <div class="operate-deploy-action-row">
                @if (proposal.IsAwaitingApproval)
                {
                    <button type="button"
                            class="console-button"
                            disabled="@(_busy || proposal.BlockingReasons.Count > 0)"
                            title="@(proposal.BlockingReasons.Count > 0
                                ? "Resolve blocking findings before approving."
                                : "Approve and submit this operation for execution.")"
                            @onclick="ApproveAsync">
                        Approve &amp; submit
                    </button>
                }

                @if (proposal.IsRollbackEligible)
                {
                    <button type="button"
                            class="console-button console-button-secondary operate-deploy-rollback-button"
                            disabled="@_busy"
                            @onclick="RequestRollbackAsync">
                        Rollback&hellip;
                    </button>
                }
            </div>

            @* DATA-AFFECTING ROLLBACK CONFIRMATION — a destructive rollback must be
               explicitly confirmed before the request is sent. The server gate also
               enforces this; the UI never weakens it. *@
            @if (_confirmingRollback)
            {
                <div class="console-usage-callout operate-deploy-confirm" role="alertdialog" aria-label="Confirm rollback">
                    @if (proposal.RollbackPlan?.RequiresConfirmation == true)
                    {
                        <p>
                            <strong>This rollback is data-affecting.</strong>
                            It may revert data and requires explicit confirmation. The server's approval gate
                            must also permit it.
                        </p>
                    }
                    else
                    {
                        <p>Roll this operation back to the prior revision?</p>
                    }
                    <div class="operate-deploy-action-row">
                        <button type="button"
                                class="console-button console-button-danger"
                                disabled="@_busy"
                                @onclick="ConfirmRollbackAsync">
                            Confirm rollback
                        </button>
                        <button type="button"
                                class="console-button console-button-secondary"
                                disabled="@_busy"
                                @onclick="CancelRollback">
                            Cancel
                        </button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_actionMessage))
            {
                <p class="operate-deploy-action-message @_actionMessageClass" role="status">@_actionMessage</p>
            }

            @* console#290 addendum item 2: state the model explicitly instead of a fake Reject.
               Declining an AwaitingApproval operation is a decision made in the approval inbox
               (the single approval seat — console#290/#292 golden path), not a local no-op here;
               once submitted, Rollback above is the recovery lever. *@
            @if (proposal.IsAwaitingApproval)
            {
                <p class="console-muted operate-deploy-no-reject" data-no-reject-note>
                    There is no separate Reject here: deploy operations are approved in the
                    <a class="console-link" href="/inbox">approval inbox</a> — declining one is
                    done there (or by leaving it unsubmitted, where it stays AwaitingApproval until it expires or is
                    cancelled out of band). Once submitted, <strong>Rollback</strong> is the recovery lever.
                </p>
            }
        </div>

        @* MANUAL-INTERVENTION RECOVERY — console#290 acceptance criterion 4: surfaces the
           EXISTING findings recovery (forward-deploy to the recorded prior revision), proposed
           through the same findings/propose flow Copilot Findings already uses, rather than
           rebuilding a bespoke recovery action. Converge/preflight-override style approvals land
           in the inbox only (single-approval-seat rule); this panel only surfaces the option and
           links to where it is decided. *@
        @if (proposal.Lifecycle == DeployOperationLifecycle.ManualInterventionRequired && _findingsClient is not null)
        {
            <div class="operate-deploy-manual-intervention" data-manual-intervention-panel>
                <h4>Manual intervention required</h4>
                @if (!_recoveryLoaded)
                {
                    <p class="console-muted">Looking for a recorded recovery finding&hellip;</p>
                }
                else if (_recoveryFinding is { } finding)
                {
                    <p class="console-muted">
                        A recorded recovery finding is available for this operation: forward-deploy to the last
                        known-good revision.
                    </p>
                    <p><strong>@finding.RecommendedAction!.Summary</strong></p>
                    <button type="button" class="console-button" disabled="@_busy" data-propose-recovery
                            @onclick="ProposeRecoveryAsync">
                        Propose recovery
                    </button>
                    @if (_recoveryOutcome is { } outcome)
                    {
                        @if (outcome.ProposalId is { Length: > 0 } recoveryProposalId)
                        {
                            <p class="console-state-success" data-recovery-proposal>
                                Proposal created &mdash;
                                <CorrelationIdChip Value="@recoveryProposalId" Kind="CorrelationIdKind.ProposalId" />
                                approve it in the inbox to actuate the forward deploy.
                            </p>
                        }
                        else if (outcome.ExecutionOperationId is { Length: > 0 } execId)
                        {
                            <p class="console-state-success" data-recovery-executed>
                                Executed directly &mdash;
                                <CorrelationIdChip Value="@execId" Kind="CorrelationIdKind.OperationId" />
                            </p>
                        }
                        else
                        {
                            <p class="console-state-warning" data-recovery-message>
                                @(string.IsNullOrWhiteSpace(outcome.Message) ? "The propose call did not create a proposal or execute directly." : outcome.Message)
                            </p>
                        }
                    }
                }
                else
                {
                    @* Honest guidance for the no-recorded-revision case (issue #290 AC4): there is
                       nothing to propose, so no button pretends otherwise. *@
                    <p class="console-muted" data-no-recovery-finding>
                        No recorded prior revision is available for this operation, so there is no forward-deploy
                        recovery to propose. <strong>Supersede with a new operation:</strong> create a fresh deploy
                        operation targeting this same target id through your devops/agent tooling, then track its
                        operation id on the <a class="console-link" href="@GitOpsReleaseRoutes.Deploy">Deploy page</a>.
                    </p>
                }
            </div>
        }

        <p class="operate-deploy-governed console-state-danger">
            Governed operation &middot; routed through the server's deploy-control approval gate;
            emits an audit event.
        </p>
    </section>
}

@code {
    /// <summary>The deploy-control operation id under review.</summary>
    [Parameter, EditorRequired]
    public required string OperationId { get; set; }

    /// <summary>
    /// Poll interval for reflecting lifecycle transitions. Disabled when null/zero.
    /// </summary>
    [Parameter]
    public TimeSpan? PollInterval { get; set; } = TimeSpan.FromSeconds(5);

    /// <summary>Raised after a successful approve/rollback so the parent can refresh its list.</summary>
    [Parameter]
    public EventCallback<DeployOperationProposal> OnActioned { get; set; }

    /// <summary>
    /// Raised every time the loaded proposal changes (initial load, poll tick, or action
    /// result) — including background poll ticks that never call <see cref="OnActioned"/>. Lets
    /// a parent (the upgrade card's post-upgrade verify summary) react to a lifecycle
    /// transition — most importantly reaching a terminal state — without duplicating the
    /// polling loop.
    /// </summary>
    [Parameter]
    public EventCallback<DeployOperationProposal?> OnStatusChanged { get; set; }

    private DeployOperationProposal? _proposal;
    private OperateSectionStatus _status = OperateSectionStatus.Unavailable;
    private string _message = string.Empty;
    private string? _reason;
    private bool _busy;
    private bool _confirmingRollback;
    private string? _actionMessage;
    private string _actionMessageClass = string.Empty;
    private string? _loadedOperationId;

    // Resolved OPTIONALLY (GetService, never a required inject — mirrors OpsSummaryStrip /
    // OperateServerUpgradeCard): a host that has not wired up Copilot Findings degrades by
    // skipping the manual-intervention recovery lookup, never throwing at render time.
    private IConsoleOpsFindingsClient? _findingsClient;

    private bool _recoveryLoaded;
    private OpsFindingResponse? _recoveryFinding;
    private OpsFindingProposeResponse? _recoveryOutcome;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _pollCts;

    protected override void OnInitialized()
    {
        _findingsClient = ServiceProvider.GetService<IConsoleOpsFindingsClient>();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_loadedOperationId, OperationId, StringComparison.Ordinal))
        {
            _loadedOperationId = OperationId;
            _confirmingRollback = false;
            _actionMessage = null;
            _recoveryLoaded = false;
            _recoveryFinding = null;
            _recoveryOutcome = null;
            await LoadAsync();
            StartPolling();
        }

        if (_findingsClient is not null
            && _proposal?.Lifecycle == DeployOperationLifecycle.ManualInterventionRequired
            && !_recoveryLoaded)
        {
            await LoadRecoveryFindingAsync();
        }
    }

    private async Task LoadAsync()
    {
        var result = await ApprovalClient.GetOperationAsync(OperationId);
        await ApplyAsync(result);
    }

    private async Task ApplyAsync(OperateSectionResult<DeployOperationProposal> result)
    {
        Apply(result);
        await OnStatusChanged.InvokeAsync(_proposal);
    }

    private void Apply(OperateSectionResult<DeployOperationProposal> result)
    {
        _status = result.Status;
        _message = result.Message;
        _proposal = result.IsAllowed ? result.Value : null;
    }

    // console#290 acceptance criterion 4: surfaces the EXISTING findings recovery rather than
    // rebuilding it. A finding whose subject pins this operation id and carries a recommended
    // action is the recorded forward-deploy-to-prior-revision recovery; its absence is the
    // honest "no recorded prior revision" case (no button, no fabricated recovery).
    private async Task LoadRecoveryFindingAsync()
    {
        if (_findingsClient is null)
        {
            _recoveryLoaded = true;
            return;
        }

        try
        {
            var result = await _findingsClient.ListAsync();
            _recoveryFinding = result.IsAllowed
                ? result.Value?.Findings?.FirstOrDefault(f =>
                    string.Equals(f.Subject?.OperationId, OperationId, StringComparison.Ordinal)
                    && f.RecommendedAction is not null)
                : null;
        }
        finally
        {
            _recoveryLoaded = true;
        }
    }

    private async Task ProposeRecoveryAsync()
    {
        if (_findingsClient is null || _busy || _recoveryFinding?.Id is not { Length: > 0 } findingId)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await _findingsClient.ProposeAsync(findingId);
            _recoveryOutcome = result.IsAllowed ? result.Value : new OpsFindingProposeResponse
            {
                FindingId = findingId,
                Message = string.IsNullOrWhiteSpace(result.Message)
                    ? OperateSectionPresentation.FallbackMessage(result.Status)
                    : result.Message,
            };
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApproveAsync()
    {
        await RunActionAsync(
            () => ApprovalClient.SubmitAsync(OperationId, _reason),
            successMessage: "Approved — operation submitted for execution.");
    }

    private void RequestRollbackAsync()
    {
        // Always require an explicit confirm step before a rollback request is sent, and make
        // the data-affecting case loud. The confirm dialog gates the actual POST.
        _actionMessage = null;
        _confirmingRollback = true;
    }

    private void CancelRollback() => _confirmingRollback = false;

    private async Task ConfirmRollbackAsync()
    {
        _confirmingRollback = false;
        await RunActionAsync(
            () => ApprovalClient.RollbackAsync(OperationId, _reason),
            successMessage: "Rollback requested.");
    }

    private async Task RunActionAsync(
        Func<Task<OperateSectionResult<DeployOperationProposal>>> action,
        string successMessage)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _actionMessage = null;
        try
        {
            var result = await action();
            if (result.IsAllowed && result.Value is not null)
            {
                await ApplyAsync(result);
                _actionMessage = successMessage;
                _actionMessageClass = "console-state-success";
                await OnActioned.InvokeAsync(result.Value);
            }
            else
            {
                _actionMessage = string.IsNullOrWhiteSpace(result.Message)
                    ? OperateSectionPresentation.FallbackMessage(result.Status)
                    : result.Message;
                _actionMessageClass = "console-state-danger";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartPolling()
    {
        StopPolling();
        if (PollInterval is not { } interval || interval <= TimeSpan.Zero)
        {
            return;
        }

        _pollCts = new CancellationTokenSource();
        _timer = new PeriodicTimer(interval);
        _ = PollLoopAsync(_timer, _pollCts.Token);
    }

    private async Task PollLoopAsync(PeriodicTimer timer, CancellationToken cancellationToken)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                // Stop polling once the operation is terminal; nothing further changes.
                if (_proposal is { IsTerminal: true })
                {
                    break;
                }

                if (_busy)
                {
                    continue;
                }

                var result = await ApprovalClient.GetOperationAsync(OperationId, cancellationToken);
                await InvokeAsync(async () =>
                {
                    await ApplyAsync(result);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed or operation id changed; expected.
        }
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
        _timer?.Dispose();
        _timer = null;
    }

    public void Dispose() => StopPolling();
}
