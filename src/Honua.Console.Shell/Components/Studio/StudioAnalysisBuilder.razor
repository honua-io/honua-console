    private CreateAnalysisContentItemRequest BuildCreateRequest()
    {
        if (_draftKind == AnalysisContentKind.SavedQuery)
        {
            return new CreateAnalysisContentItemRequest
            {
                Kind = AnalysisContentKind.SavedQuery,
                Name = _draftName,
                Title = string.IsNullOrWhiteSpace(_draftTitle) ? null : _draftTitle,
                SavedQuery = new SavedQueryContent
                {
                    LayerId = _draftLayerId,
                    ServiceName = string.IsNullOrWhiteSpace(_draftServiceName) ? null : _draftServiceName,
                    NaturalLanguageQuery = string.IsNullOrWhiteSpace(_draftNaturalLanguage) ? null : _draftNaturalLanguage,
                    PreviewLimit = _draftPreviewLimit,
                    OutFields = SplitCsv(_draftOutFields)
                }
            };
        }

        var parameters = ParseKeyValues(_draftParameters);
        var requested = _draftRequestedArtifacts
            .Select(value => Enum.TryParse<ArtifactKind>(value, out var kind) ? kind : (ArtifactKind?)null)
            .Where(kind => kind is not null)
            .Select(kind => kind!.Value)
            .ToArray();
        var intentId = "intent-1";
        var steps = _draftSteps
            .Where(step => !string.IsNullOrWhiteSpace(step.StepId))
            .Select(step => new AnalysisPlanStep
            {
                StepId = step.StepId.Trim(),
                Kind = step.Kind,
                ProcessId = string.IsNullOrWhiteSpace(step.ProcessId) ? null : step.ProcessId.Trim(),
                Inputs = ParseKeyValues(step.Inputs),
                DependsOn = SplitCsv(step.DependsOn)
            })
            .ToArray();

        return new CreateAnalysisContentItemRequest
        {
            Kind = AnalysisContentKind.AnalysisPackage,
            Name = _draftName,
            Title = string.IsNullOrWhiteSpace(_draftTitle) ? null : _draftTitle,
            AnalysisPackage = new AnalysisPackageContent
            {
                Intent = new AnalysisIntent
                {
                    IntentId = intentId,
                    Goal = _draftGoal,
                    RequestedOutputs = requested
                },
                Plan = new AnalysisPlan
                {
                    PlanId = "plan-1",
                    IntentId = intentId,
                    Steps = steps,
                    Outputs = requested
                },
                Parameters = parameters,
                RequestedArtifacts = requested
            }
        };
    }

