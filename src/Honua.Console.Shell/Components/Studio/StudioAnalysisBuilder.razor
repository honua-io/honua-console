                hasGeometry = feature.HasGeometry,
                attributes = feature.Attributes.ToDictionary(pair => pair.Key, pair => pair.Value.ToString())
            }),
            PreviewJsonOptions);

    private static string FormatLogs(AnalysisJobLogs logs) =>
        logs.Entries.Count == 0
            ? "(no log entries)"
            : string.Join(
                "\n",
                logs.Entries.Select(entry =>
                    $"{entry.Timestamp:O} [{entry.Level}]{(entry.Phase is null ? string.Empty : $" ({entry.Phase})")} {entry.Message}"));

    private string DownstreamHref(string editor)
    {
        var binding = _binding;
        if (binding is null)
        {
            return $"/studio/{editor}";
        }

        var query = $"?source=analysis&artifact={Uri.EscapeDataString(binding.ArtifactId)}";
        if (!string.IsNullOrWhiteSpace(binding.SourceItemId))
        {
            query += $"&item={Uri.EscapeDataString(binding.SourceItemId)}";
        }

        if (binding.SourceVersion is { } version)
        {
            query += $"&version={version.ToString(CultureInfo.InvariantCulture)}";
        }

        return $"/studio/{editor}{query}";
    }

    private string WorkflowHref() => DownstreamHref("workflows/new");

    private RenderFragment RenderCoverageAside => builder =>
    {
        // Reuse the editor catalog's analysis coverage descriptors so the builder's "what this editor covers"
        // copy stays in step with the shared Studio catalog.
        if (_definition is null)
        {
            return;
        }

        builder.OpenElement(0, "aside");
        builder.AddAttribute(1, "class", "studio-editor-side");
        builder.OpenElement(2, "article");
        builder.AddAttribute(3, "class", "console-panel");
        builder.OpenElement(4, "h2");
        builder.AddContent(5, "Editor Coverage");
        builder.CloseElement();
        builder.OpenElement(6, "div");
        builder.AddAttribute(7, "class", "studio-capability-list");
        var seq = 8;
        foreach (var capability in _definition.RequiredEditors)
        {
            builder.OpenElement(seq++, "section");
            builder.OpenElement(seq++, "h3");
            builder.AddContent(seq++, capability.Title);
            builder.CloseElement();
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "class", "console-muted");
            builder.AddContent(seq++, capability.Summary);
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

