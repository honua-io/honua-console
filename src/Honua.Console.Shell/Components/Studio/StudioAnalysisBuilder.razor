    private static IReadOnlyList<string> DeclaredOutputs(AnalysisContentVersion version) =>
        version.AnalysisPackage is { } package
            ? package.RequestedArtifacts.Count > 0
                ? package.RequestedArtifacts.Select(kind => kind.ToString()).ToArray()
                : package.Plan.Outputs.Select(kind => kind.ToString()).ToArray()
            : [];

    // Topologically levels the plan steps so the DAG renders left-to-right by dependency depth. Missing
    // dependency ids are treated as depth 0; cycles are capped so a malformed plan still renders.
    private static IReadOnlyList<IReadOnlyList<AnalysisPlanStep>> BuildDagLevels(IReadOnlyList<AnalysisPlanStep> steps)
    {
        var byId = steps
            .Where(step => !string.IsNullOrWhiteSpace(step.StepId))
            .GroupBy(step => step.StepId)
            .ToDictionary(group => group.Key, group => group.First());
        var depth = new Dictionary<string, int>();

        int ResolveDepth(AnalysisPlanStep step, HashSet<string> visiting)
        {
            if (depth.TryGetValue(step.StepId, out var cached))
            {
                return cached;
            }

            if (!visiting.Add(step.StepId))
            {
                return 0; // cycle guard
            }

            var level = 0;
            foreach (var dependency in step.DependsOn)
            {
                if (byId.TryGetValue(dependency, out var parent))
                {
                    level = Math.Max(level, ResolveDepth(parent, visiting) + 1);
                }
            }

            visiting.Remove(step.StepId);
            depth[step.StepId] = level;
            return level;
        }

        foreach (var step in steps)
        {
            if (!string.IsNullOrWhiteSpace(step.StepId))
            {
                ResolveDepth(step, []);
            }
        }

        return steps
            .Where(step => !string.IsNullOrWhiteSpace(step.StepId))
            .GroupBy(step => depth.TryGetValue(step.StepId, out var level) ? level : 0)
            .OrderBy(group => group.Key)
            .Select(group => (IReadOnlyList<AnalysisPlanStep>)group.ToArray())
            .ToArray();
    }

    private static string PreviewJson(SavedQueryPreviewResult preview) =>
        JsonSerializer.Serialize(
            preview.Features.Take(5).Select(feature => new
            {
