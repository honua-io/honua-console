<section class="approval-request-next" aria-labelledby="approval-request-next-title" data-approval-request-next>
    <h2 id="approval-request-next-title">What happens next</h2>
    <ol>
        <li>Your decision is recorded in Activity, with you as the approver.</li>
        <li>The requester can check this proposal for the decision and execution status.</li>
        @if (Waiting)
        {
            <li>If you do nothing, the proposal stays waiting in Approvals.</li>
        }
    </ol>
    <button type="button" class="console-button console-button-secondary" data-show-all-approvals @onclick="OnShowAll">
        Show all approvals
    </button>
</section>

@code {
    [Parameter]
    public bool Waiting { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnShowAll { get; set; }
}
