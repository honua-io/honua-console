<span class="console-name-identifier">
    <span class="console-name-identifier-name">@if (ChildContent is not null) { @ChildContent } else { @Name }</span>
    @if (!string.IsNullOrWhiteSpace(Identifier))
    {
        <span class="console-name-identifier-id">@Identifier</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public string? Identifier { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
