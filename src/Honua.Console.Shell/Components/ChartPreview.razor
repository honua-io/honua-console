@namespace Honua.Console.Shell.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Shared live chart (graphs) preview — the dashboard/report/analysis analog of MapPreview.

    An inline SVG bar-chart schematic ALWAYS renders first as a no-backend placeholder, so the
    component is fully usable in bUnit and in the missing-binding (no spec / no data) state. When a
    Vega-Lite Spec is supplied AND a browser Vega runtime is reachable, a live Vega-Lite chart mounts
    over the placeholder via JS interop, plotting the bound layer's REAL rows fetched from FeaturesUrl
    (the console /map-proxy/features proxy). Otherwise the schematic stays. This preserves the no-mock
    contract — a real chart appears only when a real spec is bound to real data.
*@

<figure class="chart-preview"
        style="@HeightStyle"
        data-chart-bound="@(_liveChartBound ? "true" : "false")"
        aria-label="@AriaLabel">

    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <figcaption class="chart-preview-title">@Title</figcaption>
    }

    <div class="chart-preview-stage">
        <div class="chart-preview-canvas" @ref="_canvas" data-chart-preview-canvas></div>

        @* No-backend schematic placeholder. Always present; hidden by the live chart when one mounts. *@
        <svg class="chart-preview-schematic"
             viewBox="0 0 320 180"
             preserveAspectRatio="xMidYMid meet"
             role="img"
             aria-hidden="true"
             focusable="false">
            <line x1="36" y1="150" x2="300" y2="150" stroke="#c2cdc0" stroke-width="1.5" />
            <line x1="36" y1="20" x2="36" y2="150" stroke="#c2cdc0" stroke-width="1.5" />
            @foreach (var bar in SchematicBars)
            {
                <rect x="@bar.X" y="@bar.Y" width="26" height="@bar.H" fill="@bar.Fill" rx="2" />
            }
        </svg>
    </div>
</figure>

@code {
    private static readonly (int X, int Y, int H, string Fill)[] DefaultBars =
    [
        (52, 92, 58, "#d9a23a"), (96, 64, 86, "#b56b1c"), (140, 110, 40, "#ead78a"),
        (184, 48, 102, "#612d0a"), (228, 80, 70, "#d9a23a"), (272, 120, 30, "#ead78a"),
    ];

    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private bool _liveChartBound;
    private ChartBinding? _requestedBinding;
    private ChartBinding? _boundBinding;
    private Task<IJSObjectReference?>? _moduleTask;
    private int _bindingVersion;
    private int _initializingVersion = -1;
    private bool _needsCleanup;
    private bool _disposed;

    private sealed record ChartBinding(string Spec, string? FeaturesUrl);

    /// <summary>Optional chart caption.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Pixel height of the chart stage.</summary>
    [Parameter]
    public int Height { get; set; } = 240;

    /// <summary>Accessible label for the figure.</summary>
    [Parameter]
    public string AriaLabel { get; set; } = "Chart preview";

    /// <summary>
    /// Vega-Lite chart spec (JSON). When set AND a browser Vega runtime is reachable, a live chart
    /// mounts over the schematic. When null/blank (missing-binding) the schematic placeholder is used
    /// and no chart backend is contacted.
    /// </summary>
    [Parameter]
    public string? Spec { get; set; }

    /// <summary>
    /// Optional URL serving the bound layer's real rows (the console /map-proxy/features proxy). When
    /// set, the live chart plots those rows; when null it falls back to any inline data in the spec.
    /// </summary>
    [Parameter]
    public string? FeaturesUrl { get; set; }

    private string HeightStyle => $"--chart-preview-height:{Height}px;";

    private static IReadOnlyList<(int X, int Y, int H, string Fill)> SchematicBars => DefaultBars;

    protected override void OnParametersSet()
    {
        var binding = string.IsNullOrWhiteSpace(Spec) ? null : new ChartBinding(Spec, FeaturesUrl);
        if (binding != _requestedBinding)
        {
            _requestedBinding = binding;
            _boundBinding = null;
            _liveChartBound = false;
            ++_bindingVersion;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        var binding = _requestedBinding;
        var version = _bindingVersion;
        if (binding is null)
        {
            _boundBinding = null;
            _liveChartBound = false;
            await ClearChartAsync();
            return;
        }

        if (binding == _boundBinding || version == _initializingVersion)
        {
            return;
        }

        _initializingVersion = version;
        try
        {
            await BindChartAsync(binding, version);
        }
        catch (JSException)
        {
            // A failed preview leaves the schematic available.
        }
        catch (InvalidOperationException)
        {
            // Interop is unavailable during prerender.
        }
        finally
        {
            if (_initializingVersion == version)
            {
                _initializingVersion = -1;
            }
        }
    }

    private async Task BindChartAsync(ChartBinding binding, int version)
    {
        if (_moduleTask is null || _moduleTask.IsFaulted)
        {
            _moduleTask = ImportModuleAsync();
        }

        var module = await _moduleTask;
        if (module is null || !IsCurrent(version))
        {
            return;
        }

        await ClearChartAsync();
        if (!IsCurrent(version))
        {
            return;
        }

        _liveChartBound = false;
        _boundBinding = null;
        _needsCleanup = true;
        var bound = await module.InvokeAsync<bool>(
            "init", _canvas, new { spec = binding.Spec, featuresUrl = binding.FeaturesUrl });
        if (bound && IsCurrent(version))
        {
            _boundBinding = binding;
            _liveChartBound = true;
            StateHasChanged();
        }
    }

    private bool IsCurrent(int version) => !_disposed && version == _bindingVersion;

    private async Task<IJSObjectReference?> ImportModuleAsync()
    {
        var module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./_content/Honua.Console.Shell/chart-preview.js");
        if (_disposed)
        {
            await module.DisposeAsync();
            return null;
        }

        _module = module;
        return module;
    }

    private async Task ClearChartAsync()
    {
        if (!_needsCleanup || _module is null)
        {
            return;
        }

        _needsCleanup = false;
        try
        {
            await _module.InvokeVoidAsync("dispose", _canvas);
        }
        catch (JSException)
        {
            // A removed binding still returns to the schematic after teardown failure.
        }
        catch (InvalidOperationException)
        {
            // Interop may be unavailable during teardown.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        ++_bindingVersion;
        await ClearChartAsync();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSException)
            {
                // The browser may have disconnected during teardown.
            }
            catch (InvalidOperationException)
            {
                // Interop may be unavailable during teardown.
            }
        }
    }
}
