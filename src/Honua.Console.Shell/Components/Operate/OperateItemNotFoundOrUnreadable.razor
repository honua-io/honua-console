@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services

@if (Failure is null)
{
    <MissingItemView Kind="@Kind" AreaLabel="@AreaLabel" />
}
else
{
    <div class="console-page-heading" data-item-read-failure="@Failure.State">
        <OperateSectionStatusPanel Heading="@AreaLabel" HeadingLevel="1" Status="@Status" Message="@Failure.ReadFailureMessage()" />
        @if (Status == OperateSectionStatus.Unavailable)
        {
            <button class="console-button" type="button" @onclick="OnRetry" data-item-read-retry>Retry</button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public string Kind { get; set; } = "item";

    [Parameter, EditorRequired]
    public string AreaLabel { get; set; } = string.Empty;

    // The failed read from OperateLayerLookup.ReadFailure; null when the read succeeded and the item is absent.
    [Parameter]
    public OperateCapabilityState? Failure { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }

    private OperateSectionStatus Status => Failure?.State == OperateLayerLookup.MissingPermissionState
        ? OperateSectionStatus.Forbidden
        : OperateSectionStatus.Unavailable;
}
