@namespace Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Models

@*
    The AI driver's single surface (redesign Phase 3): an OUTCOME + one approval, NOT a plan/spec/tool-call
    dump (the founder's "exposes too much plumbing" critique). It leads with one sentence —

        "I'll publish Maui Parcels as FeatureServer + STAC, styled by zoning."

    — and three actions: Approve / Edit / Reject. Everything else (the per-protocol publication plan, grounding
    gaps, the AI provider/model) lives behind the "Details ▸" disclosure only. The human always approves before
    anything applies; this card never applies — it raises OnApprove/OnEdit/OnReject to the flow host.
*@

@if (Proposal is { } proposal)
{
    <article class="console-panel ai-publish-card" role="group" aria-label="AI publish proposal" data-ai-outcome-card>
        <p class="console-kicker">AI proposal</p>
        <h2 class="ai-publish-card__headline" data-ai-outcome-headline>@proposal.OutcomeHeadline</h2>
        @if (!string.IsNullOrWhiteSpace(proposal.Rationale))
        {
            <p class="console-muted ai-publish-card__rationale" data-ai-outcome-rationale>@proposal.Rationale</p>
        }

        <div class="console-action-row ai-publish-card__actions">
            <button type="button" class="console-button" disabled="@Busy" @onclick="OnApprove" data-ai-approve>
                @(Busy ? "Publishing…" : "Approve")
            </button>
            <button type="button" disabled="@Busy" @onclick="OnEdit" data-ai-edit>Edit</button>
            <button type="button" disabled="@Busy" @onclick="OnReject" data-ai-reject>Reject</button>
            <button type="button" class="console-link ai-publish-card__details-toggle"
                    aria-expanded="@_detailsOpen" @onclick="ToggleDetails" data-ai-details-toggle>
                @(_detailsOpen ? "Hide details ▴" : "Details ▸")
            </button>
        </div>

        @if (_detailsOpen)
        {
            @* The plumbing: only ever behind the disclosure. Never the headline. *@
            <div class="ai-publish-card__details" data-ai-outcome-details>
                <dl class="console-definition-list">
                    <dt>Resource</dt>
                    <dd data-ai-detail-resource>@proposal.ResourceName</dd>
                    <dt>Service slot</dt>
                    <dd class="console-mono">@proposal.ServiceSlot</dd>
                    <dt>Visibility</dt>
                    <dd>@proposal.Visibility</dd>
                    @if (!string.IsNullOrWhiteSpace(proposal.StyleIntent))
                    {
                        <dt>Style</dt>
                        <dd>styled @proposal.StyleIntent</dd>
                    }
                </dl>
                <table class="console-table" data-ai-detail-publications>
                    <thead><tr><th>Protocol</th><th>Route</th></tr></thead>
                    <tbody>
                        @foreach (var plan in proposal.PlannedPublications)
                        {
                            <tr><td>@plan.Label</td><td class="console-mono">@plan.Route</td></tr>
                        }
                    </tbody>
                </table>
                @if (proposal.UnmappedRequests.Count > 0)
                {
                    <div class="console-validation-summary" role="note" data-ai-detail-unmapped>
                        <p class="console-kicker">Not mapped</p>
                        <ul>@foreach (var item in proposal.UnmappedRequests){<li>@item</li>}</ul>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(proposal.Provider) || !string.IsNullOrWhiteSpace(proposal.Model))
                {
                    <p class="console-muted" data-ai-detail-provider>
                        Generated by @(proposal.Provider ?? "the server AI")@(string.IsNullOrWhiteSpace(proposal.Model) ? "" : $" · {proposal.Model}").
                    </p>
                }
            </div>
        }
    </article>
}

@code {
    /// <summary>The proposal to render as outcome + one approval. Null renders nothing (host shows the prompt).</summary>
    [Parameter] public AiPublishProposal? Proposal { get; set; }

    /// <summary>Disables the actions while the host is applying the approved publish.</summary>
    [Parameter] public bool Busy { get; set; }

    [Parameter] public EventCallback OnApprove { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnReject { get; set; }

    private bool _detailsOpen;

    private void ToggleDetails() => _detailsOpen = !_detailsOpen;
}
