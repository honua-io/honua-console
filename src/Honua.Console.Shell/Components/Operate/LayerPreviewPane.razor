@namespace Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Models

@*
    The Layer Preview pane renders the selected publication's served layer through the Console map proxy
    and lists its served route, so what an operator previews is what the service publishes.
*@
<aside class="layer-preview-pane" data-layer-preview aria-label="Layer preview">
    <div class="layer-preview-pane__heading">
        <p class="console-kicker">Layer preview</p>
        @if (Selection is { } selection)
        {
            <h2>@selection.ResourceName · @selection.ProtocolLabel</h2>
        }
        else
        {
            <h2>Select a layer</h2>
        }
    </div>

    @if (Selection is { } sel)
    {
        <div class="layer-preview-pane__frame" data-preview-frame>
            @if (Layer is { } layer)
            {
                <LayerMapPreview Layer="layer" EnvironmentId="@EnvironmentId" />
            }
            else
            {
                <p class="console-muted" data-preview-unrendered>This dataset has no served layer to render yet.</p>
            }
        </div>
        <dl class="console-definition-list">
            <dt>Route</dt>
            <dd class="console-mono" data-preview-route>@sel.Route</dd>
        </dl>
        @if (Protocols.Count > 1)
        {
            <label class="studio-form-label">
                <span>Open in</span>
                <select class="console-input" value="@sel.ProtocolId" @onchange="OnProtocolChanged" data-preview-open-in>
                    @foreach (var protocol in Protocols)
                    {
                        <option value="@protocol.ProtocolId">@protocol.ProtocolLabel</option>
                    }
                </select>
            </label>
        }
        <div class="console-action-row">
            <a class="console-button" href="@sel.Route" target="_blank" data-preview-open-route>Open route</a>
        </div>
    }
    else
    {
        <p class="console-muted" data-preview-empty>
            Pick a dataset&rsquo;s layer in the tree to preview its served endpoint here.
        </p>
    }
</aside>

@code {
    /// <summary>The currently-previewed publication, or null when nothing is selected.</summary>
    [Parameter] public PreviewSelection? Selection { get; set; }

    /// <summary>The served layer behind the selected publication, or null when it has none to render.</summary>
    [Parameter] public OperateServiceLayerProjection? Layer { get; set; }

    /// <summary>The active environment the map proxy URLs are pinned to.</summary>
    [Parameter] public string? EnvironmentId { get; set; }

    /// <summary>The other publications on the same resource, for the "open in" protocol picker.</summary>
    [Parameter] public IReadOnlyList<PreviewSelection> Protocols { get; set; } = [];

    /// <summary>Raised when the user switches which protocol to preview the selected resource in.</summary>
    [Parameter] public EventCallback<string> OnProtocolSelected { get; set; }

    private async Task OnProtocolChanged(ChangeEventArgs args)
    {
        if (args.Value is string protocolId && OnProtocolSelected.HasDelegate)
        {
            await OnProtocolSelected.InvokeAsync(protocolId);
        }
    }

    /// <summary>A previewable publication: the resource it belongs to, the protocol, and the served route.</summary>
    public sealed record PreviewSelection(
        string ResourceId,
        string ResourceName,
        string ProtocolId,
        string ProtocolLabel,
        string Route);
}
