@inject NavigationManager ConsoleNavigation
@namespace Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Models

<div class="resource-tree" data-resource-tree>
    <div class="resource-tree__toolbar">
        <input class="console-input" type="search" placeholder="filter…" aria-label="Filter datasets"
               @bind="_filter" @bind:event="oninput" />
    </div>

    @if (FilteredNodes.Count == 0)
    {
        <p class="console-muted" data-tree-empty>
            @if (Nodes.Count > 0)
            {
                <span>No datasets match this filter.</span> <button type="button" class="console-button console-button-secondary" @onclick="() => _filter = string.Empty">Clear filter</button>
            }
            else
            {
                <span>No datasets yet.</span> <a href="@ConsoleNavigation.ToConsoleHref("/operate/data/new")">Add data</a><span> — it becomes a dataset you can publish as a layer.</span>
            }
        </p>
    }
    else
    {
        <ul class="resource-tree__list" aria-label="Datasets">
            @foreach (var node in FilteredNodes)
            {
                <li class="resource-tree__node @(node.HasPublications ? "resource-tree__node--running" : "resource-tree__node--draft")"
                    data-resource-node="@node.ResourceId">
                    <div class="resource-tree__row">
                        <button type="button" class="resource-tree__toggle" @onclick="() => ToggleExpand(node.ResourceId)"
                                aria-expanded="@(_expanded.Contains(node.ResourceId) ? "true" : "false")"
                                aria-label="@(_expanded.Contains(node.ResourceId) ? "Collapse" : "Expand") @node.Name">
                            @(node.HasPublications ? (_expanded.Contains(node.ResourceId) ? "▼" : "▶") : "○")
                        </button>
                        <button type="button" class="resource-tree__name" aria-expanded="@(_expanded.Contains(node.ResourceId) ? "true" : "false")"
                                @onclick="() => SelectResource(node)">@node.Name</button>
                        <span class="resource-tree__meta console-muted">@node.Source</span>
                        <span class="console-status @(node.HasPublications ? "console-status-success" : "console-status-warning")">@node.Status</span>
                    </div>

                    @if (_expanded.Contains(node.ResourceId))
                    {
                        <ul class="resource-tree__publications" aria-label="Layers">
                            @foreach (var publication in node.Publications)
                            {
                                <li class="resource-tree__publication" data-publication="@publication.ProtocolId">
                                    <button type="button" class="resource-tree__publication-row" disabled="@(publication.Route is null)"
                                            @onclick="() => SelectPublication(node, publication)">
                                        <span class="resource-tree__publication-check">✓</span>
                                        <span class="resource-tree__publication-label">@publication.ProtocolLabel</span>
                                        <span class="resource-tree__publication-route console-mono">@(publication.Route ?? "No single service URL")</span>
                                    </button>
                                </li>
                            }
                            <li class="resource-tree__expose">
                                <a class="console-link" href="@ConsoleNavigation.ToConsoleLinkHref(ExposeHref(node))" data-expose>+ expose another protocol…</a>
                            </li>
                        </ul>
                    }

                    @if (!node.HasPublications)
                    {
                        <div class="resource-tree__draft-actions">
                            <a class="console-button" href="@ConsoleNavigation.ToConsoleLinkHref(PublishHref(node))" data-publish>Publish →</a>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<ResourceTreeNode> Nodes { get; set; } = [];

    [Parameter] public EventCallback<ResourceTreeNode> OnResourceSelected { get; set; }

    [Parameter] public EventCallback<LayerPreviewPane.PreviewSelection> OnPublicationSelected { get; set; }

    [Parameter] public string? FocusResourceId { get; set; }

    private string _filter = string.Empty;
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private bool _focusApplied;

    protected override void OnParametersSet()
    {
        if (!_focusApplied && !string.IsNullOrWhiteSpace(FocusResourceId))
        {
            _expanded.Add(FocusResourceId);
            _focusApplied = true;
        }
    }

    private IReadOnlyList<ResourceTreeNode> FilteredNodes =>
        string.IsNullOrWhiteSpace(_filter)
            ? Nodes
            : Nodes.Where(node => node.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToArray();

    private void ToggleExpand(string resourceId)
    {
        if (!_expanded.Remove(resourceId))
        {
            _expanded.Add(resourceId);
        }
    }

    private async Task SelectResource(ResourceTreeNode node)
    {
        ToggleExpand(node.ResourceId);
        if (OnResourceSelected.HasDelegate)
        {
            await OnResourceSelected.InvokeAsync(node);
        }
    }

    private async Task SelectPublication(ResourceTreeNode node, PublicationTreeNode publication)
    {
        if (publication.Route is null) return;
        if (OnPublicationSelected.HasDelegate)
        {
            await OnPublicationSelected.InvokeAsync(new LayerPreviewPane.PreviewSelection(
                node.ResourceId, node.Name, publication.ProtocolId, publication.ProtocolLabel, publication.Route));
        }
    }

    internal static string PublishHref(ResourceTreeNode node) =>
        $"/operate/data/new?source=existingresource&resource={Uri.EscapeDataString(node.ResourceId)}";

    internal static string ExposeHref(ResourceTreeNode node) =>
        $"/operate/data/new?source=existingresource&resource={Uri.EscapeDataString(node.ResourceId)}&step=publish";
}
