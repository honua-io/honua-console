<section class="console-service-web-services" aria-labelledby="service-web-services-heading" data-service-web-services>
    <h2 id="service-web-services-heading">Web services for this service</h2>
    <p>Enabled on <code>@Service.Name</code>. @(Service.IsLayerService ? $"Changing a protocol here affects all {ConsolePublicationTreeContext.FormatCount(Service.LayerCount, "layer")}." : $"Protocol endpoints exposed by this {ConsoleServiceKind.SummaryLabel(Service.ServiceCategory).ToLowerInvariant()}.") <button type="button" class="console-link-button" @onclick="ChangeProtocols">Change protocols</button></p>
    @if (Service.Endpoints.Count == 0)
    {
        <p>No protocol endpoints were reported for this service.</p>
    }
    else
    {
        <ul class="console-service-web-service-list">
            @foreach (var endpoint in Service.Endpoints)
            {
                <li><ServiceWebServiceCardV4 Endpoint="endpoint" /></li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public OperateServiceDetail Service { get; set; } = default!;
    [Parameter] public EventCallback ChangeProtocols { get; set; }
}
