@inject NavigationManager ConsoleNavigation
@namespace Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IServiceConfigurationOperation ServiceConfiguration
@inject IConsoleNotificationService Notifications

<article class="console-panel" data-step-body="GoLive">
    <p class="console-kicker">⑤ Go live — review &amp; approve</p>
    <h2>@Flow.Resource.Name → @Flow.TargetService</h2>
    <p class="console-muted">
        Apply &amp; publish sets the protocols of <code>@Flow.TargetService</code> to exactly the ones below and
        applies the visibility. Protocols and visibility are per service: every layer in
        <code>@Flow.TargetService</code> is served the same way.
    </p>
    <fieldset class="data-publish-flow__visibility" data-visibility disabled="@_busy">
        <legend class="studio-form-label"><span>Visibility</span></legend>
        @foreach (var visibility in Enum.GetValues<PublishVisibility>())
        {
            <label class="publish-protocol-picker__option">
                <input type="radio" name="visibility" value="@visibility" checked="@(Flow.Visibility == visibility)" @onchange="() => Flow.Visibility = visibility" />
                <span>@visibility</span>
                <small class="console-muted">@VisibilityHint(visibility)</small>
            </label>
        }
    </fieldset>
    <p class="console-muted" data-style-not-applied>
        Style: Go live does not apply a style. honua-server has no operation that binds a catalog style to a
        layer, so the layer serves with its default renderer. Author its drawing info on the
        <a href="@ConsoleNavigation.ToConsoleLinkHref(LayerStyleHref)">layer style page</a> after it is live.
    </p>
    @if (_outcome is null)
    {
        <table class="console-table" data-route-preview>
            <thead><tr><th>Protocol</th><th>Route</th></tr></thead>
            <tbody>
                @foreach (var plan in Flow.PlannedPublications)
                {
                    <tr><td>@plan.Label</td><td class="console-mono">@plan.Route</td></tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <section data-publish-results>
            <table class="console-table">
                <thead><tr><th>Protocol</th><th>State</th><th>Route or detail</th></tr></thead>
                <tbody>
                    @foreach (var protocol in _outcome.Protocols)
                    {
                        <tr data-protocol-result="@protocol.Plan.ProtocolId" data-state="@ResultState(protocol.Result)">
                            <td>@protocol.Plan.Label</td>
                            <td>@protocol.Result.State</td>
                            @if (protocol.Result.Succeeded)
                            {
                                <td class="console-mono" data-live-route>@protocol.Plan.Route</td>
                            }
                            else
                            {
                                <td>@protocol.Result.Detail</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            <p data-visibility-result data-state="@ResultState(_outcome.Visibility)">Visibility: <strong>@_outcome.Visibility.State</strong> @_outcome.Visibility.Detail</p>
            <p data-layer-result data-state="@ResultState(_outcome.Layer)">Layer: <strong>@_outcome.Layer.State</strong> @_outcome.Layer.Detail</p>
            @if (_outcome.AllLive)
            {
                <p role="status" data-go-live-done>Live on honua-server.</p>
            }
            else
            {
                <div class="console-validation-summary" role="alert" data-step-error="true">Not everything went live. Each row shows what honua-server returned.</div>
            }
        </section>
    }
    <div class="console-action-row">
        <button type="button" disabled="@_busy" @onclick="OnBack">Back</button>
        <button type="button" class="console-button" data-go-live-apply disabled="@(_busy || Flow.EnabledProtocols.Count == 0)" @onclick="ApplyAsync">
            @(_busy ? "Publishing…" : "Apply & publish")
        </button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public DataToPublishFlowState Flow { get; set; } = default!;

    [Parameter] public EventCallback OnBack { get; set; }

    private GoLiveOutcome? _outcome;
    private bool _busy;

    private string LayerStyleHref => $"/operate/layers/{Uri.EscapeDataString(Flow.Resource.ResourceId ?? string.Empty)}/style";

    private Task ApplyAsync()
    {
        _outcome = null;
        var intent = GoLiveIntent.From(Flow);
        var publisher = new GoLivePublisher(ServiceConfiguration);
        return Notifications.RunGuardedAsync(
            async () => { _outcome = await publisher.ApplyAsync(intent); },
            setBusy: busy => { _busy = busy; StateHasChanged(); },
            failureMessage: "Couldn't publish");
    }

    private static string ResultState(GoLiveStepResult result) => result.Succeeded ? "succeeded" : "failed";

    private static string VisibilityHint(PublishVisibility visibility) => visibility switch
    {
        PublishVisibility.Public => "anyone, no sign-in",
        PublishVisibility.Org => "any signed-in user",
        _ => "admin role only",
    };
}
