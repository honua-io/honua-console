@inject NavigationManager ConsoleNavigation
@namespace Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Models

<div class="resource-tree" data-resource-tree>
    <div class="resource-tree__toolbar">
        <input class="console-input" type="search" placeholder="filter…" aria-label="Filter datasets"
               @bind="_filter" @bind:event="oninput" />
    </div>

    @if (FilteredNodes.Count == 0)
    {
        <p class="console-muted" data-tree-empty>
            @if (Nodes.Count > 0)
            {
                <span>No datasets match this filter.</span> <button type="button" class="console-button console-button-secondary" @onclick="() => _filter = string.Empty">Clear filter</button>
            }
            else
            {
                <span>No datasets yet.</span> <a href="@ConsoleNavigation.ToConsoleHref("/operate/data/new")">Add data</a><span> — it becomes a dataset you can publish as a layer.</span>
            }
        </p>
    }
    else
    {
        <ul class="resource-tree__list" aria-label="Datasets">
            @foreach (var node in FilteredNodes)
            {
                <li class="resource-tree__node @(node.HasEndpoints ? "resource-tree__node--running" : "resource-tree__node--draft")"
                    data-resource-node="@node.DatasetId">
                    <div class="resource-tree__row">
                        <button type="button" class="resource-tree__toggle" @onclick="() => ToggleExpand(node.DatasetId)"
                                aria-expanded="@(_expanded.Contains(node.DatasetId) ? "true" : "false")"
                                aria-label="@(_expanded.Contains(node.DatasetId) ? "Collapse" : "Expand") @node.Name">
                            @(node.HasEndpoints ? (_expanded.Contains(node.DatasetId) ? "▼" : "▶") : "○")
                        </button>
                        <button type="button" class="resource-tree__name" aria-expanded="@(_expanded.Contains(node.DatasetId) ? "true" : "false")"
                                @onclick="() => SelectDataset(node)">@node.Name</button>
                        <span class="resource-tree__meta console-muted">@node.Source</span>
                        <span class="console-status @(node.HasEndpoints ? "console-status-success" : "console-status-warning")">@node.Status</span>
                    </div>

                    @if (_expanded.Contains(node.DatasetId))
                    {
                        <ul class="resource-tree__publications" aria-label="Layers">
                            @foreach (var endpoint in node.Endpoints)
                            {
                                <li class="resource-tree__publication" data-publication="@endpoint.ProtocolId">
                                    <button type="button" class="resource-tree__publication-row" disabled="@(endpoint.Route is null)"
                                            @onclick="() => SelectEndpoint(node, endpoint)">
                                        <span class="resource-tree__publication-check">✓</span>
                                        <span class="resource-tree__publication-label">@endpoint.ProtocolLabel</span>
                                        <span class="resource-tree__publication-route console-mono">@(endpoint.Route ?? "No single service URL")</span>
                                    </button>
                                </li>
                            }
                            <li class="resource-tree__expose">
                                <a class="console-link" href="@ConsoleNavigation.ToConsoleLinkHref(ExposeHref(node))" data-expose>+ expose another protocol…</a>
                            </li>
                        </ul>
                    }

                    @if (!node.HasEndpoints)
                    {
                        <div class="resource-tree__draft-actions">
                            <a class="console-button" href="@ConsoleNavigation.ToConsoleLinkHref(PublishHref(node))" data-publish>Publish →</a>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<DatasetTreeNode> Nodes { get; set; } = [];

    [Parameter] public EventCallback<DatasetTreeNode> OnDatasetSelected { get; set; }

    [Parameter] public EventCallback<LayerPreviewPane.PreviewSelection> OnEndpointSelected { get; set; }

    [Parameter] public string? FocusDatasetId { get; set; }

    private string _filter = string.Empty;
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private bool _focusApplied;

    protected override void OnParametersSet()
    {
        if (!_focusApplied && !string.IsNullOrWhiteSpace(FocusDatasetId))
        {
            _expanded.Add(FocusDatasetId);
            _focusApplied = true;
        }
    }

    private IReadOnlyList<DatasetTreeNode> FilteredNodes =>
        string.IsNullOrWhiteSpace(_filter)
            ? Nodes
            : Nodes.Where(node => node.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)).ToArray();

    private void ToggleExpand(string datasetId)
    {
        if (!_expanded.Remove(datasetId))
        {
            _expanded.Add(datasetId);
        }
    }

    private async Task SelectDataset(DatasetTreeNode node)
    {
        ToggleExpand(node.DatasetId);
        if (OnDatasetSelected.HasDelegate)
        {
            await OnDatasetSelected.InvokeAsync(node);
        }
    }

    private Task SelectEndpoint(DatasetTreeNode node, DatasetEndpointNode endpoint) =>
        LayerPreviewPane.SelectAsync(OnEndpointSelected, node, endpoint);

    internal static string PublishHref(DatasetTreeNode node) =>
        $"/operate/data/new?source=existingresource&resource={Uri.EscapeDataString(node.DatasetId)}";

    internal static string ExposeHref(DatasetTreeNode node) =>
        $"/operate/data/new?source=existingresource&resource={Uri.EscapeDataString(node.DatasetId)}&step=publish";
}
