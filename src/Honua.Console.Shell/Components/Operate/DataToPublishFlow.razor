@namespace Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Pages
@using Honua.Console.Shell.Services
@inject IConsoleFileImportOperation FileImport
@inject IOperateTransitionDataSource OperateData
@inject IStudioMapStyleCatalogDataSource StyleData
@inject NavigationManager Nav

<section class="console-page data-publish-flow" data-data-publish-flow>
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Add data</p>
        <h1>Add data &amp; publish</h1>
        <p>One journey: add data → it becomes a resource → publish it as the services/protocols you choose → style → live.</p>
    </div>

    <div class="data-publish-flow__header">
        <ol class="data-publish-flow__rail" data-step-rail>
            @foreach (var step in RailSteps)
            {
                <li class="data-publish-flow__rail-step @RailStateClass(step)" data-step="@step.ToString()">
                    <span class="data-publish-flow__rail-dot"></span>
                    <span class="data-publish-flow__rail-label">@StepLabel(step)</span>
                </li>
            }
        </ol>

        <button type="button" class="console-button console-button-secondary" data-workspace-open>Ask in the conversation</button>
    </div>

    @if (_missingBinding is { } binding)
    {
        <article class="console-panel console-state-warning" role="note" data-flow-missing-binding>
            <p class="console-kicker">Connect to your data</p>
            <h2>Check the data connection</h2>
            <p>@binding</p>
            <a class="console-button-link" href="/environments">Review connection</a>
        </article>
    }

    @switch (_flow.Step)
    {
        case FlowStep.AddData:
            <article class="console-panel" data-step-body="AddData">
                <AddDataIntake Connections="_connectionOptions"
                               ExistingResources="_resourceOptions"
                               SupportedExtensions="_supportedExtensions"
                               InitialMode="_flow.Source.Mode"
                               Loaded="@_intakeLoaded"
                               OnSourceChosen="OnSourceChosen" />
                @if (_flow.Source.Mode == AddDataMode.File)
                {
                    <p>Choose the original dataset, then describe its destination in the shared conversation.</p>
                    <a class="console-button" href="/operate/resources/import/task">Choose dataset file</a>
                }
                @if (_flow.Source.Mode == AddDataMode.RemoteService)
                {
                    <div data-remote-service-import>
                        <OperateImportServicePage />
                        <p class="console-muted">Imported services land as resources — <a href="/operate/data">open the resource tree</a> to publish them as the protocols you want.</p>
                    </div>
                }
                <div class="console-action-row">
                    <a href="/operate/data">Cancel</a>
                    @if (_flow.Source.Mode is AddDataMode.Table or AddDataMode.ExistingResource)
                    {
                        <button type="button" class="console-button" disabled="@(!CanContinueToPublish)" @onclick="ContinueToPublish">
                            Continue →
                        </button>
                    }
                </div>
            </article>
            break;

        case FlowStep.Publish:
            <article class="console-panel" data-step-body="Publish">
                <p class="console-kicker">③ Publish "@_flow.Resource.Name"</p>
                <h2>Choose how to expose this resource</h2>
                <PublishProtocolPicker Enabled="_flow.EnabledProtocols"
                                       EnabledChanged="OnProtocolsChanged"
                                       ServiceSlot="_flow.ServiceSlot"
                                       OnRequestSlotChange="RequestSlotChange" />
                @if (_slotChanging)
                {
                    <label class="studio-form-label">
                        <span>Service slot</span>
                        <input class="console-input" @bind="_flow.ServiceSlot" @bind:event="oninput" placeholder="city/parcels" />
                        <small class="console-muted">Use <code>folder/service</code> to nest under a folder.</small>
                    </label>
                }
                <div class="console-action-row">
                    <button type="button" @onclick="() => GoToStep(FlowStep.AddData)">Back</button>
                    <button type="button" class="console-button" disabled="@(_flow.EnabledProtocols.Count == 0)" @onclick="() => GoToStep(FlowStep.Style)">Continue to style →</button>
                </div>
            </article>
            break;

        case FlowStep.Style:
            <article class="console-panel" data-step-body="Style">
                <p class="console-kicker">④ Style</p>
                <h2>Style this resource</h2>
                <p class="console-muted">Dual-mode: author in MapLibre (canonical) or Esri drawingInfo — the server converts between encodings (ADR-0002). Styling is optional; you can publish first and refine later.</p>
                <div class="studio-field-grid">
                    <label class="studio-form-label">
                        <span>Style</span>
                        <select class="console-input" @bind="_flow.StyleId">
                            <option value="">Default style</option>
                            @foreach (var style in _styles)
                            {
                                <option value="@style.StyleId">@style.Label</option>
                            }
                        </select>
                    </label>
                    <fieldset class="data-publish-flow__encoding" data-style-encoding>
                        <legend class="studio-form-label"><span>Encoding</span></legend>
                        <label class="publish-protocol-picker__option">
                            <input type="radio" name="style-encoding" checked="@(_flow.StyleEncoding == StyleEncoding.MapLibre)" @onchange="() => _flow.StyleEncoding = StyleEncoding.MapLibre" />
                            <span>MapLibre</span>
                        </label>
                        <label class="publish-protocol-picker__option">
                            <input type="radio" name="style-encoding" checked="@(_flow.StyleEncoding == StyleEncoding.Esri)" @onchange="() => _flow.StyleEncoding = StyleEncoding.Esri" />
                            <span>Esri drawingInfo</span>
                        </label>
                    </fieldset>
                </div>
                @if (_styleBinding is { } sb)
                {
                    <p class="console-muted" data-style-binding>@sb</p>
                }
                @if (!string.IsNullOrWhiteSpace(_flow.StyleId))
                {
                    <p><a class="console-link" href="@StyleEditorHref">Edit this shared catalog style →</a></p>
                }
                <div class="console-action-row">
                    <button type="button" @onclick="() => GoToStep(FlowStep.Publish)">Back</button>
                    <button type="button" class="console-button" @onclick="() => GoToStep(FlowStep.GoLive)">Continue to go live →</button>
                </div>
            </article>
            break;

        case FlowStep.GoLive:
            <article class="console-panel" data-step-body="GoLive">
                <p class="console-kicker">⑤ Go live — review &amp; approve</p>
                <h2>@_flow.Resource.Name → @_flow.PlannedPublications.Count publication@(_flow.PlannedPublications.Count == 1 ? "" : "s")</h2>
                <fieldset class="data-publish-flow__visibility" data-visibility>
                    <legend class="studio-form-label"><span>Visibility</span></legend>
                    @foreach (var visibility in Enum.GetValues<PublishVisibility>())
                    {
                        <label class="publish-protocol-picker__option">
                            <input type="radio" name="visibility" checked="@(_flow.Visibility == visibility)" @onchange="() => _flow.Visibility = visibility" />
                            <span>@visibility</span>
                        </label>
                    }
                </fieldset>
                <table class="console-table" data-route-preview>
                    <thead><tr><th>Protocol</th><th>Route</th></tr></thead>
                    <tbody>
                        @foreach (var plan in _flow.PlannedPublications)
                        {
                            <tr><td>@plan.Label</td><td class="console-mono">@plan.Route</td></tr>
                        }
                    </tbody>
                </table>
                @if (_serverSidePublications.Count > 0)
                {
                    <div class="console-panel-grid" data-publish-results>
                        @foreach (var plan in _serverSidePublications)
                        {
                            <article class="console-panel console-state-danger" role="alert">
                                <p class="console-kicker">@plan.Label — Unsupported here</p>
                                <p>@ServerSidePublishDetail</p>
                            </article>
                        }
                    </div>
                }
                @if (_stepError is not null)
                {
                    <div class="console-validation-summary" role="alert" data-step-error="true">@_stepError</div>
                }
                <div class="console-action-row">
                    <button type="button" @onclick="() => GoToStep(FlowStep.Style)">Back</button>
                    <button type="button" class="console-button" disabled="@(_flow.EnabledProtocols.Count == 0)" @onclick="Apply">
                        Apply &amp; publish
                    </button>
                </div>
            </article>
            break;
    }
</section>

@code {
    private const string ServerSidePublishDetail =
        "Publishing this source's protocols runs server-side after ingest; the console publishes table sources directly. (Resource is staged; protocol bindings pending server materialization.)";

    [Parameter] public string? InitialSource { get; set; }

    private readonly DataToPublishFlowState _flow = new();

    private IReadOnlyList<AddDataIntake.IntakeOption> _connectionOptions = [];
    private IReadOnlyList<AddDataIntake.IntakeOption> _resourceOptions = [];
    private IReadOnlyList<string> _supportedExtensions = [];
    private IReadOnlyList<StudioMapStyleOption> _styles = [];
    private bool _intakeLoaded;
    private bool _slotChanging;

    private string? _stepError;
    private string? _missingBinding;
    private string? _styleBinding;
    private IReadOnlyList<PublishProtocolPlan> _serverSidePublications = [];

    private static readonly FlowStep[] RailSteps =
        [FlowStep.AddData, FlowStep.Resource, FlowStep.Publish, FlowStep.Style, FlowStep.GoLive];

    protected override async Task OnInitializedAsync()
    {
        ApplyInitialSource(InitialSource);

        _supportedExtensions = await FileImport.GetSupportedExtensionsAsync();

        var connectionsView = await OperateData.GetConnectionsViewAsync();
        _connectionOptions = connectionsView.Connections
            .Select(connection => new AddDataIntake.IntakeOption(connection.Id, $"{connection.Name} ({connection.Provider})"))
            .ToArray();

        var resourcesView = await OperateData.GetResourcesViewAsync();
        _resourceOptions = resourcesView.ResourceEdits
            .Select(resource => new AddDataIntake.IntakeOption(resource.ResourceId, resource.Name))
            .ToArray();

        _intakeLoaded = connectionsView.CapabilityStates.Count == 0 && resourcesView.CapabilityStates.Count == 0;
        if (!_intakeLoaded) _missingBinding = "The data sources could not be read. Review your connection or sign in again before choosing data.";

        var styleCatalog = await StyleData.GetStyleCatalogAsync();
        _styles = styleCatalog.Styles;
        if (styleCatalog.Issue is { } issue)
        {
            _styleBinding = $"{issue.State}: {issue.Detail}";
        }
    }

    private void ApplyInitialSource(string? source)
    {
        _flow.Source.Mode = source?.ToLowerInvariant() switch
        {
            "file" => AddDataMode.File,
            "table" => AddDataMode.Table,
            "remoteservice" or "remote" or "service" => AddDataMode.RemoteService,
            "existingresource" or "existing" or "resource" => AddDataMode.ExistingResource,
            _ => _flow.Source.Mode,
        };
    }

    private void OnSourceChosen(AddDataIntake.DataSourceIntake intake)
    {
        if (intake.Mode == AddDataMode.Table)
        {
            // The canonical publish-layer form is bound to the same server draft as chat.
            Nav.NavigateTo("/operate/publishing/quick");
            return;
        }

        _flow.Source.Mode = intake.Mode;
        _flow.Source.Reference = intake.Reference;
    }

    private bool CanContinueToPublish =>
        _flow.Source.Mode == AddDataMode.ExistingResource && !string.IsNullOrWhiteSpace(_flow.Source.Reference);

    private void ContinueToPublish()
    {
        var resourceId = _flow.Source.Reference!;
        var option = _resourceOptions.FirstOrDefault(o => string.Equals(o.Id, resourceId, StringComparison.Ordinal));
        _missingBinding = null;
        _flow.Resource = new ResourceStaging
        {
            ResourceId = resourceId,
            Name = option.Label ?? resourceId,
        };
        _flow.Step = FlowStep.Publish;
        SeedServiceSlot();
    }

    private void SeedServiceSlot()
    {
        if (_flow.ServiceSlot == "service" && !string.IsNullOrWhiteSpace(_flow.Resource.Name))
        {
            _flow.ServiceSlot = SanitizeTableName(_flow.Resource.Name);
        }
    }

    private void OnProtocolsChanged(IReadOnlyCollection<string> protocols)
    {
        _flow.EnabledProtocols = protocols.ToList();
    }

    private void RequestSlotChange() => _slotChanging = true;

    // An existing resource carries no connection + table for the admin publish-layer operation, so its
    // protocol publications are reported as server-side work rather than faked as live.
    private void Apply()
    {
        _serverSidePublications = _flow.PlannedPublications;
        _stepError = _serverSidePublications.Count > 0
            ? "No publications landed. Review the per-protocol results above."
            : null;
    }

    private void GoToStep(FlowStep step)
    {
        _stepError = null;
        _flow.Step = step;
    }

    private string StyleEditorHref =>
        string.IsNullOrWhiteSpace(_flow.StyleId)
            ? "/studio/styles"
            : $"/studio/styles/{Uri.EscapeDataString(_flow.StyleId)}";

    private string RailStateClass(FlowStep step)
    {
        var currentIndex = Array.IndexOf(RailSteps, _flow.Step);
        var stepIndex = Array.IndexOf(RailSteps, step);
        if (stepIndex < currentIndex)
        {
            return "data-publish-flow__rail-step--done";
        }

        return step == _flow.Step ? "data-publish-flow__rail-step--current" : string.Empty;
    }

    private static string StepLabel(FlowStep step) => step switch
    {
        FlowStep.AddData => "Add data",
        FlowStep.Resource => "Resource",
        FlowStep.Publish => "Publish",
        FlowStep.Style => "Style",
        FlowStep.GoLive => "Go live",
        _ => step.ToString(),
    };

    private static string SanitizeTableName(string value)
    {
        var sanitized = new string(value.Trim().ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : '_')
            .ToArray());
        return string.IsNullOrWhiteSpace(sanitized) ? "imported_resource" : sanitized;
    }
}
