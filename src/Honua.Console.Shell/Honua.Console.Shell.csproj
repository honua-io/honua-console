<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Honua.Console.Shell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <!-- AuthorizeRouteView / CascadingAuthenticationState for fail-closed route authorization
         (honua-console#233). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.9" />
    <!-- SignalR client for the approval-inbox live updates: the console connects to the
         honua-server admin realtime hub's proposals group (honua-server #1695, issue #193). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <!-- Server-owned Studio capability-manifest projection (GET /api/v1/capabilities/manifest).
         The registry-driven Studio-AI intent resolver (honua-console#266) binds this SDK client so
         deferred/unavailable capabilities are gated out of Studio AI. -->
    <PackageReference Include="Honua.Sdk.Studio" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Honua.Console.Contracts\Honua.Console.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Console.Native.Core.Tests" />
    <InternalsVisibleTo Include="Honua.Console.Web" />
  </ItemGroup>

  <!-- L0 deflection (honua-console#165): bundle the honua-gis-llm support KB
       seed next to the Shell assembly so FileConsoleSupportKnowledgeBase can
       load it at runtime. The README documents provenance + the embeddings
       TODO and is excluded from output. -->
  <ItemGroup>
    <Content Include="SupportKb\support-kb.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SupportKb\README.md" />
  </ItemGroup>

</Project>
