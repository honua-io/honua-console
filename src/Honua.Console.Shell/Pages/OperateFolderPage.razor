@page "/operate/folders/{FolderId}"
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@inject IServiceProvider Services

<section class="console-page console-folder-page">
    @if (Services.GetService<ConsoleV4Options>()?.Enabled == true)
    {
        <ConsoleFolderContents FolderId="@FolderId" @key="(FolderId, _generation)" />
    }
    else
    {
        <ConsolePageHeading Title="Folders" />
        <p><a href="/operate/services#folders">Manage Folders in Services</a></p>
    }
</section>

@code {
    [Parameter] public string FolderId { get; set; } = string.Empty;
    private IConsoleEnvironmentProfileStore? _profiles;
    private AuthenticationStateProvider? _authentication;
    private int _generation;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _profiles = Services.GetService<IConsoleEnvironmentProfileStore>();
        _authentication = Services.GetService<AuthenticationStateProvider>();
        if (_profiles is not null) _profiles.ActiveProfileChanged += Refresh;
        if (_authentication is not null) _authentication.AuthenticationStateChanged += OnAuthenticationChanged;
    }

    private void OnAuthenticationChanged(Task<AuthenticationState> state) => Refresh();

    private void Refresh()
    {
        if (_disposed) return;
        _ = InvokeAsync(() => { _generation++; StateHasChanged(); });
    }

    public void Dispose()
    {
        _disposed = true;
        if (_profiles is not null) _profiles.ActiveProfileChanged -= Refresh;
        if (_authentication is not null) _authentication.AuthenticationStateChanged -= OnAuthenticationChanged;
    }
}
