@inject IServiceProvider Services
@inject NavigationManager ConsoleNavigation
@page "/catalogs"
@page "/catalogs/{CatalogId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@implements IDisposable
@inject CatalogAdminOptions Options
@inject ICatalogAdminSource Catalogs

<section class="console-page catalog-admin">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="@(_read?.Overview is { } heading && heading.CatalogId == CatalogId ? heading.Title : "Catalogs")">
            <ChildContent>
                @if (CatalogId is not null) { <a href="@ConsoleNavigation.ToConsoleHref("/catalogs")">Catalogs</a> }
                <p>Present services, layers, datasets, maps and apps to the audiences that may read them.</p>
            </ChildContent>
        </ConsolePageHeading>
    }
    else
    {
    <header class="console-detail-heading">
        <div>
            @if (CatalogId is not null) { <a href="@ConsoleNavigation.ToConsoleHref("/catalogs")">Catalogs</a> }
            <h1>@(_read?.Overview is { } heading && heading.CatalogId == CatalogId ? heading.Title : "Catalogs")</h1>
            <p class="console-muted">Present services, layers, datasets, maps and apps to the audiences that may read them.</p>
        </div>
    </header>
    }
    @{
        RenderFragment AdministrationContent = @<text>
    @if (!Options.Enabled)
    {
        <ConsoleStateView HeadingLevel="2" Kind="disabled" Title="Catalogs are not enabled"
                          Message="The catalog preview is disabled for this Console." />
    }
    else if (_loading)
    {
        <ConsoleStateView HeadingLevel="2" Kind="loading" Title="Loading catalogs" Message="Reading catalog administration." />
    }
    else if (_read is { State: "missing" or "unsupported" or "unavailable" or "forbidden" } unavailable)
    {
        <ConsoleStateView HeadingLevel="2" Kind="@(unavailable.State is "missing" or "unsupported" ? unavailable.State : "denied")"
                          Title="@(unavailable.State == "unsupported" ? "Catalog contract is not supported" : "Catalogs are unavailable")"
                          Message="@unavailable.Message" />
    }
    else if (_read is { } read)
    {
        <div class="console-toolbar console-toolbar-spread">
            <p role="status">@(read.State == "fixture" ? "Fixture preview · synthetic data" : "Live sync is unavailable")</p>
            <a href="@ConsoleNavigation.ToConsoleHref("/operate/catalogs")">Discovery endpoints</a>
        </div>
        @if (CatalogId is null)
        {
            <div class="catalog-admin-filters">
                <label for="catalog-query">Search catalogs
                    <input id="catalog-query" type="search" value="@_query" @oninput="SearchChanged" />
                </label>
                <label for="catalog-audience">Audience
                    <select id="catalog-audience" value="@_audience" @onchange="AudienceChanged">
                        <option value="">All audiences</option><option value="public">Public</option>
                        <option value="signed-in">Signed-in users</option><option value="roles">Roles</option>
                    </select>
                </label>
                <label for="catalog-sort">Sort by
                    <select id="catalog-sort" value="@(_descending ? "true" : "false")" @onchange="SortChanged">
                        <option value="false">Title A–Z</option><option value="true">Title Z–A</option>
                    </select>
                </label>
            </div>
            @if (FilteredCatalogs.Count == 0)
            {
                <ConsoleStateView HeadingLevel="2" Kind="empty" Title="No matching catalogs" Message="Change the search or audience filter." />
            }
            else
            {
                <div class="catalog-admin-table" role="region" aria-label="Catalog list" tabindex="0">
                    <table>
                        <thead><tr><th scope="col">Catalog</th><th scope="col">Audience</th><th scope="col">Scope</th><th scope="col">Proposal</th></tr></thead>
                        <tbody>
                            @foreach (var catalog in FilteredCatalogs.Skip(_offset).Take(PageSize))
                            {
                                <tr @key="catalog.Id">
                                    <td><a href="@ConsoleNavigation.ToConsoleLinkHref($"/catalogs/{Uri.EscapeDataString(catalog.Id)}")">@catalog.Title</a></td>
                                    <td>@CatalogAdminLabels.Audience(catalog.Audience)</td><td>@catalog.ScopeLabel</td>
                                    <td>
                                        @if (ProposalHref(catalog.ProposalHref) is { } proposal) { <a href="@ConsoleNavigation.ToConsoleLinkHref(proposal)">Review proposal for @catalog.Title</a> }
                                        else { <span>Not reported</span> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <CatalogAdminPager Label="Catalog pages" Offset="_offset" Total="FilteredCatalogs.Count"
                                   PageSize="PageSize" OffsetChanged="value => _offset = value" />
            }
        }
        else if (read.Overview is { } overview && overview.CatalogId == CatalogId)
        {
            <nav class="catalog-admin-tabs" aria-label="Catalog sections">
                <a href="@ConsoleNavigation.ToConsoleLinkHref($"/catalogs/{Uri.EscapeDataString(CatalogId)}")" aria-current="@(Section is null ? "page" : null)">Overview</a>
                <a href="@ConsoleNavigation.ToConsoleLinkHref($"/catalogs/{Uri.EscapeDataString(CatalogId)}/settings")" aria-current="@(Section == "settings" ? "page" : null)">Settings and scope</a>
                <a href="@ConsoleNavigation.ToConsoleLinkHref($"/catalogs/{Uri.EscapeDataString(CatalogId)}/categories")" aria-current="@(Section == "categories" ? "page" : null)">Categories and featured</a>
                <a href="@ConsoleNavigation.ToConsoleLinkHref($"/catalogs/{Uri.EscapeDataString(CatalogId)}/templates")" aria-current="@(Section is "templates" or "template" ? "page" : null)">Templates</a>
            </nav>
            @if (Section == "settings")
            {
                @if (read.Settings is { } settings && settings.CatalogId == CatalogId)
                { <CatalogSettingsView Settings="settings" /> }
                else
                { <ConsoleStateView HeadingLevel="2" Kind="unsupported" Title="Catalog settings are unavailable" Message="The server has not reported settings for this catalog." /> }
            }
            else if (Section == "categories")
            {
                @if (read.Arrangement is { } arrangement && arrangement.CatalogId == CatalogId)
                { <CatalogCategoriesView @key="arrangement" Arrangement="arrangement" /> }
                else
                { <ConsoleStateView HeadingLevel="2" Kind="unsupported" Title="Categories and featured are unavailable" Message="The server has not reported categories and featured items for this catalog." /> }
            }
            else if (Section == "templates")
            {
                @if (read.Templates is { } templates && templates.CatalogId == CatalogId)
                { <CatalogTemplatesView @key="templates" Templates="templates" /> }
                else
                { <ConsoleStateView HeadingLevel="2" Kind="unsupported" Title="Templates are unavailable" Message="The server has not reported templates for this catalog." /> }
            }
            else if (Section == "template")
            {
                @if (read.Template is { } template && template.CatalogId == CatalogId && template.TemplateId == TemplateId)
                { <CatalogTemplateEditorView @key="template" Template="template" /> }
                else
                { <ConsoleStateView HeadingLevel="2" Kind="unsupported" Title="Template is unavailable" Message="The server has not reported this template." /> }
            }
            else if (Section == "listing")
            {
                @if (read.Listing is { } listing && listing.CatalogId == CatalogId && listing.ItemId == ItemId)
                { <CatalogListingView @key="listing" Listing="listing" /> }
                else
                { <ConsoleStateView HeadingLevel="2" Kind="unsupported" Title="Item listing is unavailable" Message="The server has not reported this item listing." /> }
            }
            else
            {
            <h2>Admin visibility counts</h2>
            <p class="console-muted">These counts include administration states. Public search only counts items its visitor may read.</p>
            <dl class="catalog-admin-counts">
                <div data-catalog-count="listed"><dt>@CatalogAdminLabels.Visibility("listed")</dt><dd>@overview.Visibility.Listed</dd></div>
                <div><dt>@CatalogAdminLabels.Visibility("restricted")</dt><dd>@overview.Visibility.AudienceRestricted</dd></div>
                <div><dt>@CatalogAdminLabels.Visibility("hidden")</dt><dd>@overview.Visibility.HiddenHere</dd></div>
                <div><dt>@CatalogAdminLabels.Visibility("opted-out")</dt><dd>@overview.Visibility.OptedOut</dd></div>
                <div><dt>Matched</dt><dd>@overview.Visibility.Matched</dd></div>
            </dl>
            <h2>Counts by kind</h2>
            @if (overview.KindVisibility.Count == 0) { <p>Kind breakdown is not reported.</p> }
            else
            {
                <div class="catalog-admin-table catalog-kind-counts" role="region" aria-label="Visibility by kind" tabindex="0">
                    <table>
                        <thead><tr><th scope="col">Kind</th><th scope="col">Listed</th><th scope="col">Audience-restricted</th><th scope="col">Hidden here</th><th scope="col">Opted out</th><th scope="col">Matched</th></tr></thead>
                        <tbody>
                            @foreach (var row in overview.KindVisibility)
                            {
                                <tr><th scope="row">@KindLabel(row.Kind)</th><td>@row.Visibility.Listed</td><td>@row.Visibility.AudienceRestricted</td><td>@row.Visibility.HiddenHere</td><td>@row.Visibility.OptedOut</td><td>@row.Visibility.Matched</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <h2>Needs attention</h2>
            @if (overview.Attention.Count == 0) { <p>No attention items reported.</p> }
            else
            {
                <div class="catalog-admin-filters">
                    <label for="attention-query">Search attention items<input id="attention-query" type="search" value="@_attentionQuery" @oninput="AttentionSearchChanged" /></label>
                    <label for="attention-issue">Issue
                        <select id="attention-issue" value="@_attentionReason" @onchange="AttentionReasonChanged">
                            <option value="">All issues</option>
                            @foreach (var reason in overview.Attention.Select(item => item.Reason).Distinct().Order(StringComparer.OrdinalIgnoreCase))
                            { <option value="@reason">@reason</option> }
                        </select>
                    </label>
                    <label for="attention-sort">Sort attention items
                        <select id="attention-sort" value="@_attentionSort" @onchange="AttentionSortChanged">
                            <option value="title">Item title</option><option value="issue">Issue</option>
                        </select>
                    </label>
                </div>
                @if (FilteredAttention.Count == 0) { <p role="status">No matching attention items.</p> }
                else
                {
                    <ul class="catalog-attention-list">@foreach (var item in FilteredAttention.Skip(_attentionOffset).Take(PageSize)) { <li>@item.Title · @item.Reason</li> }</ul>
                    <CatalogAdminPager Label="Attention pages" Offset="_attentionOffset" Total="FilteredAttention.Count"
                                       PageSize="PageSize" OffsetChanged="value => _attentionOffset = value" />
                }
            }
            <h2>Health, usage and feeds</h2>
            <p>Not reported. The connected server has not reported these observations.</p>
            }
        }
        else
        {
            <ConsoleStateView HeadingLevel="2" Kind="denied" Title="Catalog is unavailable" Message="This catalog could not be read." />
        }
    }
        </text>;
    }
    @if (V4Enabled)
    {
        <section class="console-section console-summary" aria-label="Catalog administration">
            @if (CatalogId is null && _read is { State: "fixture" or "success" })
            {
                <ConsoleMetricTile Label="Matching catalogs" Value="@FilteredCatalogs.Count" />
            }
            @AdministrationContent
        </section>
    }
    else
    {
        @AdministrationContent
    }

</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    [Parameter] public string? CatalogId { get; set; }
    [Parameter] public string? Section { get; set; }
    [Parameter] public string? TemplateId { get; set; }
    [Parameter] public string? ItemId { get; set; }

    private const int PageSize = 12;
    private CatalogAdminRead? _read;
    private CancellationTokenSource? _load;
    private string _query = string.Empty;
    private string _audience = string.Empty;
    private bool _descending;
    private int _offset;
    private bool _loading;
    private string _attentionQuery = string.Empty;
    private string _attentionReason = string.Empty;
    private string _attentionSort = "title";
    private int _attentionOffset;

    private IReadOnlyList<CatalogAdminRow> FilteredCatalogs => (_read?.Catalogs ?? [])
        .Where(row => row.Title.Contains(_query, StringComparison.OrdinalIgnoreCase) && (_audience.Length == 0 || row.Audience == _audience))
        .OrderBy(row => _descending ? null : row.Title, StringComparer.OrdinalIgnoreCase)
        .ThenByDescending(row => _descending ? row.Title : null, StringComparer.OrdinalIgnoreCase)
        .ThenBy(row => row.Id, StringComparer.Ordinal).ToArray();

    private IReadOnlyList<CatalogAdminAttention> FilteredAttention => (_read?.Overview?.Attention ?? [])
        .Where(item => item.Title.Contains(_attentionQuery, StringComparison.OrdinalIgnoreCase)
            && (_attentionReason.Length == 0 || item.Reason == _attentionReason))
        .OrderBy(item => _attentionSort == "issue" ? item.Reason : item.Title, StringComparer.OrdinalIgnoreCase)
        .ThenBy(item => item.Title, StringComparer.OrdinalIgnoreCase)
        .ThenBy(item => item.Reason, StringComparer.OrdinalIgnoreCase).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        _load?.Cancel();
        _load?.Dispose();
        _read = null;
        _offset = 0;
        _attentionOffset = 0;
        _attentionQuery = _attentionReason = string.Empty;
        _attentionSort = "title";
        _loading = Options.Enabled;
        if (!Options.Enabled) return;
        var load = _load = new CancellationTokenSource();
        try
        {
            var request = new CatalogAdminRequest(CatalogId) { Section = Section, TemplateId = TemplateId, ItemId = ItemId };
            var read = await Catalogs.ReadAsync(request, load.Token);
            if (ReferenceEquals(_load, load) && !load.IsCancellationRequested) _read = read;
        }
        catch (OperationCanceledException) when (load.IsCancellationRequested) { }
        catch
        {
            if (ReferenceEquals(_load, load) && !load.IsCancellationRequested)
                _read = new([], null, "unavailable", "Catalogs could not be read. Refresh to try again.");
        }
        finally
        {
            if (ReferenceEquals(_load, load)) _loading = false;
        }
    }

    private void SearchChanged(ChangeEventArgs args) { _query = args.Value?.ToString() ?? string.Empty; _offset = 0; }
    private void AudienceChanged(ChangeEventArgs args) { _audience = args.Value?.ToString() ?? string.Empty; _offset = 0; }
    private void SortChanged(ChangeEventArgs args) { _descending = bool.TryParse(args.Value?.ToString(), out var descending) && descending; _offset = 0; }
    private void AttentionSearchChanged(ChangeEventArgs args) { _attentionQuery = args.Value?.ToString() ?? string.Empty; _attentionOffset = 0; }
    private void AttentionReasonChanged(ChangeEventArgs args) { _attentionReason = args.Value?.ToString() ?? string.Empty; _attentionOffset = 0; }
    private void AttentionSortChanged(ChangeEventArgs args) { _attentionSort = args.Value?.ToString() ?? "title"; _attentionOffset = 0; }
    private static string KindLabel(string kind) => kind switch { "dataset" => "Dataset", "layer" => "Layer", "service" => "Service", "map" => "Map", "app" => "App", _ => "Not reported" };
    private static string? ProposalHref(string? href) => href?.StartsWith("/inbox?proposalId=", StringComparison.Ordinal) == true && !href.Contains('#') && !href.Contains('\\') ? href : null;

    public void Dispose()
    {
        _load?.Cancel();
        _load?.Dispose();
        _load = null;
        _read = null;
    }
}
