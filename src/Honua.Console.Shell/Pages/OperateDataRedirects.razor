@* Route redirects folding the old disconnected Operate list/entry routes into the unified treeview or
   the unified resource-first flow (redesign §5.2 route delta). Routes that have a dedicated page
   component (import-file, quick-publish, import-service, layers) keep their own @page directives
   and are NOT listed here — only the pure list aliases that have no standalone page body are
   redirected. *@
@page "/operate/resources"
@page "/operate/services"
@page "/operate/resources/new"
@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var path = relative.Split('?', '#')[0].TrimEnd('/');
        var target = path switch
        {
            "/operate/resources" => "/operate/data",
            "/operate/services" => "/operate/data?view=services",
            "/operate/resources/new" => "/operate/data/new",
            _ => "/operate/data",
        };

        Nav.NavigateTo(target, replace: true);
    }
}
