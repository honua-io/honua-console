@page "/operate/layers/{ResourceId}/style"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Services
@inject IOperateLayerStyleOverrideDataSource OverrideData
@inject IStudioMapStyleCatalogDataSource StyleCatalog
@inject IConsoleNotificationService Notifications
@inject IServiceProvider Services
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page operate-layer-style" data-layer-style="@ResourceId">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Layer presentation">
            <ChildContent><p>@Intro</p></ChildContent>
            <Actions><a class="console-button-link console-button-secondary" href="@LayerHref">Back to layer</a></Actions>
        </ConsolePageHeading>
        <ConsolePanel Title="Base styles" HeadingId="layer-base-styles">@CatalogContent</ConsolePanel>
        <ConsolePanel Title="Layer overrides" HeadingId="layer-overrides">@OverrideContent</ConsolePanel>
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Operate / Layers</p>
            <h1>Layer presentation</h1>
            <p>@Intro</p>
            <p><a href="@LayerHref">Back to layer</a></p>
        </div>

        <article class="console-panel">
            <p class="console-kicker">Available base styles</p>
            <h2>Server style list</h2>
            @CatalogContent
        </article>
        <section class="console-section" aria-label="Layer style overrides">
            <div class="console-page-heading">
                <p class="console-kicker">Layer presentation</p>
                <h2>Layer style overrides</h2>
            </div>
            @OverrideContent
        </section>
    }
</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
    private const string Intro = "Edit this layer's drawing and popup settings. Every service exposing the layer uses these shared settings. Author shared catalog Styles in Studio.";
    private string LayerRoute => $"/operate/layers/{Uri.EscapeDataString(_overrides.CanonicalResourceId ?? ResourceId)}";
    private string LayerHref => Navigation.ToConsoleHref(LayerRoute);
    private ConsoleAgentEntity? LayerEntity => !_loading && _overrides.BindingState is null && _overrides.LayerId is { } id && _overrides.CanonicalResourceId is { } resource
        ? ConsoleAgentEntity.ForLayer(id, resource)
        : null;
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = $"{LayerRoute}/style",
        Entities = LayerEntity is { } entity ? [entity] : [],
        Unsaved = new()
        {
            ChangedFieldCount = _overrides.Slots.Sum(slot =>
                (PopupValue(slot.SlotId) != (slot.PopupInfoJson ?? string.Empty) ? 1 : 0) +
                (DrawingValue(slot.SlotId) != (slot.DrawingInfoJson ?? string.Empty) ? 1 : 0)),
            PendingOperationCount = (_loading ? 1 : 0) + (_saving ? 1 : 0)
        }
    };

    private RenderFragment CatalogContent => @<div data-layer-style-catalog>
        @if (_catalog.Issue is { } catalogState)
        {
            <div class="console-panel console-state-warning" role="status" data-style-catalog-state>
                <p class="console-kicker">@catalogState.State</p>
                <p>@catalogState.Detail</p>
            </div>
        }
        else if (_catalog.Styles.Count == 0)
        {
            <p class="console-muted">The connected server advertises no styles on /ogc/styles.</p>
        }
        else
        {
            <ul class="console-chip-row" data-style-catalog-list>
                @foreach (var style in _catalog.Styles)
                {
                    <li><span class="console-status console-state-neutral">@style.Label</span></li>
                }
            </ul>
        }
    </div>;

    private RenderFragment OverrideContent => @<text>
        @if (_loading)
        {
            <ConsoleStateView HeadingLevel="@(V4Enabled ? 3 : 2)" Kind="loading"
                              Kicker="Layer presentation"
                              Title="Loading layer overrides"
                              Message="Reading layer style and popup overrides from honua-server." />
        }
        else if (_overrides.BindingState is { } binding)
        {
            <ConsoleStateView HeadingLevel="@(V4Enabled ? 3 : 2)" Kind="@StateKind(binding.State)"
                              Kicker="@binding.State"
                              Title="Layer overrides are not available"
                              Message="@(binding.Detail + " (contract: " + binding.Contract + ")")" />
        }
        else if (_overrides.Slots.Count == 0)
        {
            <EmptyState Area="operate" Subject="layer overrides" />
        }
        else
        {
            @foreach (var slot in _overrides.Slots)
            {
                <article class="@(V4Enabled ? "console-section" : "console-panel")" data-style-slot="@slot.SlotId">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">@slot.ServiceName</p>
                            <h3>@slot.ServiceDisplayName</h3>
                        </div>
                    </div>
                    <div class="studio-field-grid">
                        <label>
                            <span>Popup info (GeoServices popupInfo JSON — e.g. <code>{"title":"{name}","fieldInfos":[…]}</code>)</span>
                            <textarea class="console-input console-mono" rows="6" data-slot-popup
                                      value="@PopupValue(slot.SlotId)"
                                      @onchange="e => SetPopup(slot.SlotId, e)"></textarea>
                        </label>
                        <label>
                            <span>Drawing info (renderer JSON — e.g. <code>{"renderer":{"type":"uniqueValue",…}}</code>)</span>
                            <textarea class="console-input console-mono" rows="6" data-slot-drawing
                                      value="@DrawingValue(slot.SlotId)"
                                      @onchange="e => SetDrawing(slot.SlotId, e)"></textarea>
                        </label>
                    </div>
                    <div class="console-action-row">
                        <button class="console-button" type="button" disabled="@_saving"
                                @onclick="() => SaveSlotAsync(slot)" data-slot-save>
                            @(_saving ? "Saving..." : "Save override")
                        </button>
                    </div>
                </article>
            }

            @if (_saveResult is { } result && result.BindingState is { } saveBinding)
            {
                <ConsoleStateView HeadingLevel="@(V4Enabled ? 3 : 2)" Kind="@StateKind(saveBinding.State)"
                                  Kicker="@saveBinding.State"
                                  Title="Override save is not bound"
                                  Message="@(saveBinding.Detail + " (contract: " + saveBinding.Contract + ")")" />
            }
            else if (_saveResult is { Succeeded: true })
            {
                <div class="console-panel console-state-success" role="status" data-slot-saved>
                    <p class="console-kicker">Saved</p>
                    <p>The layer presentation override was saved in the environment.</p>
                </div>
            }
        }
    </text>;

    [CascadingParameter] public ConsolePublicationLayerContext? PublicationContext { get; set; }

    [Parameter]
    public string ResourceId { get; set; } = string.Empty;

    private bool _loading = true;
    private bool _saving;
    private StudioMapStyleCatalog _catalog = StudioMapStyleCatalog.Empty;
    private OperateLayerStyleOverrideView _overrides = new(string.Empty, []);
    private OperateLayerStyleOverrideSaveResult? _saveResult;

    // Per-slot edit state, keyed by slot id, seeded from the loaded overrides. popupInfo + drawingInfo are
    // authored as the raw GeoServices JSON documents that honua-server stores and emits back.
    private readonly Dictionary<string, string> _popupEdits = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _drawingEdits = new(StringComparer.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        var attempt = PublicationContext?.BeginRead(ResourceId);
        _loading = true;
        _saveResult = null;
        _catalog = await StyleCatalog.GetStyleCatalogAsync();
        _overrides = await OverrideData.GetOverridesAsync(ResourceId);
        if (attempt is { } read) PublicationContext!.CompleteStyleRead(read, _overrides);
        _popupEdits.Clear();
        _drawingEdits.Clear();
        foreach (var slot in _overrides.Slots)
        {
            _popupEdits[slot.SlotId] = slot.PopupInfoJson ?? string.Empty;
            _drawingEdits[slot.SlotId] = slot.DrawingInfoJson ?? string.Empty;
        }

        _loading = false;
    }

    private string PopupValue(string slotId) =>
        _popupEdits.TryGetValue(slotId, out var value) ? value : string.Empty;

    private string DrawingValue(string slotId) =>
        _drawingEdits.TryGetValue(slotId, out var value) ? value : string.Empty;

    private void SetPopup(string slotId, ChangeEventArgs e) =>
        _popupEdits[slotId] = e.Value?.ToString() ?? string.Empty;

    private void SetDrawing(string slotId, ChangeEventArgs e) =>
        _drawingEdits[slotId] = e.Value?.ToString() ?? string.Empty;

    private Task SaveSlotAsync(OperateLayerSlotStyleOverride slot)
    {
        _saveResult = null;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                var edit = new OperateLayerSlotStyleOverrideEdit(
                    ResourceId,
                    slot.SlotId,
                    PopupInfoJson: PopupValue(slot.SlotId),
                    DrawingInfoJson: DrawingValue(slot.SlotId));
                _saveResult = await OverrideData.SaveOverrideAsync(edit);
                if (_saveResult.Succeeded)
                {
                    _overrides = _overrides with
                    {
                        Slots = _overrides.Slots.Select(current => current.SlotId == slot.SlotId
                            ? current with { PopupInfoJson = edit.PopupInfoJson, DrawingInfoJson = edit.DrawingInfoJson }
                            : current).ToArray()
                    };
                }
            },
            setBusy: busy => { _saving = busy; StateHasChanged(); },
            failureMessage: "Couldn't save style override");
    }

    private static string StateKind(string state) => state switch
    {
        OperateLayerStyleBindingState.Forbidden => "forbidden",
        OperateLayerStyleBindingState.Unsupported => "unsupported",
        _ => "missing"
    };
}
