@inject NavigationManager ConsoleNavigation
@page "/share/public"
@page "/public"
@* The "/public" and "/share/public" routes are the open-web open-data / public-link hub
   (host-allow-listed anonymous in ConsolePublicSurfaces), so this page allows anonymous visitors.
   The operator "/share" route is ShareHomePage, which requires sign-in and renders this page. *@
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IConsoleCatalogClient Catalog
@inject IServiceProvider Services

<CatalogAvailabilityGate>
@if (V4Enabled && !OperatorView)
{
    @if (!_missingBinding && _failureMessage is null && _items is not null)
    {
        <PublicCatalogView Items="_items" HasMoreItems="_hasMoreItems" />
    }
    else
    {
        <section class="public-catalog" aria-label="Open data catalog" data-public-catalog>
            <header class="public-catalog-brand">
                <strong>Open data catalog</strong>
                <small>Public maps, layers, services, and documents</small>
            </header>
            <div class="public-catalog-state">
                @if (_missingBinding)
                {
                    <ConsoleStateView HeadingLevel="1" Kind="error"
                                      Kicker="Missing binding"
                                      Title="Share is not bound to honua-server"
                                      Message="@MissingBindingMessage" />
                }
                else if (_items is null)
                {
                    <ConsoleStateView HeadingLevel="1" Kind="loading"
                                      Kicker="Loading"
                                      Title="Loading public items"
                                      Message="Open-data catalog items are loading." />
                }
                else if (_failureMessage is not null)
                {
                    <ConsoleStateView HeadingLevel="1" Kind="error"
                                      Kicker="Share unavailable"
                                      Title="Public items could not load"
                                      Message="@_failureMessage"
                                      ActionHref="@ConsoleNavigation.Uri"
                                      ActionLabel="Retry" />
                }
            </div>
            <footer class="public-catalog-footer">
                <span>Open data catalog</span>
                <span class="public-catalog-spacer"></span>
                <span>Served by this Honua server</span>
            </footer>
        </section>
    }
}
else
{
<section class="console-page share-home">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Share">
            <p>Public links, embeds, open-data pages, and downloads.</p>
        </ConsolePageHeading>
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Share workflow</p>
            <h1>Share</h1>
            <p>Everything this server publishes to the outside world — public links, embeds, open-data pages, and exports.</p>
        </div>
    }

    @if (_hasMoreItems)
    {
        <p>The server has more public items than this page can show.</p>
    }

    @if (_missingBinding)
    {
        <ConsoleStateView HeadingLevel="2" Kind="error"
                          Kicker="Missing binding"
                          Title="Share is not bound to honua-server"
                          Message="@MissingBindingMessage" />
    }
    else if (_items is null)
    {
        <ConsoleStateView HeadingLevel="2" Kind="loading" Kicker="Loading" Title="Loading public items" Message="Open-data catalog items are loading." />
    }
    else if (_failureMessage is not null)
    {
        <ConsoleStateView HeadingLevel="2" Kind="error" Kicker="Share unavailable" Title="Public items could not load" Message="@_failureMessage" ActionHref="@ConsoleNavigation.Uri" ActionLabel="Retry" />
    }
    else if (_items.Count == 0)
    {
        <ConsoleStateView HeadingLevel="2" Kind="empty" Kicker="Open data" Title="No public open-data items" Message="Publish a service, layer, or document as public open data to expose it here." ActionHref="@(OperatorView ? "/operate/publishing" : null)" ActionLabel="@(OperatorView ? "Open Publishing" : null)" />
    }
    else
    {
        @if (V4Enabled)
        {
            <ConsolePanel Title="Public sharing" HeadingId="share-summary-heading" Class="console-share-summary console-summary">
                <div data-share-kpis>
                    <div data-share-kpi="shared-items">
                        <ConsoleMetricTile Label="Shared items" Value="@_items.Count">Published as open data</ConsoleMetricTile>
                    </div>
                    <dl class="console-share-summary-details console-summary-details">
                        <div data-share-kpi="open-data-pages"><dt>Open-data pages</dt><dd>@_openDataCount</dd></div>
                        <div data-share-kpi="formats"><dt>Download formats</dt><dd>@_formatCount</dd></div>
                    </dl>
                </div>
            </ConsolePanel>
        }
        else
        {
            <div class="console-kpi-strip" data-share-kpis>
                <div class="console-kpi" data-share-kpi="shared-items">
                    <span class="console-kpi-label">Shared items</span>
                    <span class="console-kpi-value">@_items.Count</span>
                    <span class="console-kpi-sub">open-data published</span>
                </div>
                <div class="console-kpi" data-share-kpi="open-data-pages">
                    <span class="console-kpi-label">Open-data pages</span>
                    <span class="console-kpi-value">@_openDataCount</span>
                    <span class="console-kpi-sub">public landing</span>
                </div>
                <div class="console-kpi" data-share-kpi="formats">
                    <span class="console-kpi-label">Download formats</span>
                    <span class="console-kpi-value">@_formatCount</span>
                    <span class="console-kpi-sub">across all items</span>
                </div>
            </div>
        }

        <div class="console-toolbar console-toolbar-spread" data-share-toolbar>
            <span class="console-muted">@_items.Count shared items</span>
        </div>

        <ConsoleTableRegion Class="console-table-wrap" Label="Public open-data items" data-share-home-table>
            <table class="console-content-table console-table">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Type</th>
                        <th scope="col">Visibility</th>
                        <th scope="col">Link</th>
                        <th scope="col">Open data</th>
                        <th scope="col">Formats</th>
                        <th scope="col"><span class="console-visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr data-share-row="@PublicItemKey(item)">
                            <th scope="row"><a href="@ConsoleNavigation.ToConsoleHref($"/share/public/items/{Uri.EscapeDataString(PublicItemKey(item))}")">@item.Title</a></th>
                            <td><span class="console-status console-state-neutral">@CatalogContentTypes.LabelFor(item.Type)</span></td>
                            <td><span class="console-status console-state-success" data-share-visibility>public</span></td>
                            <td><code class="console-inline-code">/share/public/items/@PublicItemKey(item)</code></td>
                            <td>
                                @if (item.Access.OpenData)
                                {
                                    <span class="console-status console-state-success">live</span>
                                }
                                else
                                {
                                    <span class="console-status console-state-neutral">off</span>
                                }
                            </td>
                            <td>
                                <div class="console-chip-row">
                                    @foreach (var format in item.Formats)
                                    {
                                        <span>@format</span>
                                    }
                                </div>
                            </td>
                            <td><a class="console-button console-button-secondary" href="@ConsoleNavigation.ToConsoleHref($"/share/manage?itemId={Uri.EscapeDataString(item.Id)}")">Configure</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </ConsoleTableRegion>
    }
</section>
}
</CatalogAvailabilityGate>

@code {
    internal const string MissingBindingMessage =
        "Open data is temporarily unavailable because this portal is not connected to a data server. "
        + "Please try again later or contact the site administrator.";

    [Parameter] public bool OperatorView { get; set; }

    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    private IReadOnlyList<ConsoleContentSummary>? _items;
    private bool _missingBinding;
    private bool _hasMoreItems;
    private string? _failureMessage;
    private int _openDataCount;
    private int _formatCount;

    protected override async Task OnParametersSetAsync()
    {
        if (Catalog is UnsupportedConsoleCatalogClient)
        {
            _missingBinding = true;
            _items = Array.Empty<ConsoleContentSummary>();
            return;
        }

        // The server lists only items an anonymous reader may open, so every row here is live open data.
        var result = await Catalog.ListOpenDataItemsAsync();
        _hasMoreItems = result.HasMoreItems;
        _failureMessage = result.Succeeded ? null : result.FailureMessage;
        var items = result.Items
            .Where(item => string.Equals(item.Type, "service", StringComparison.Ordinal)
                || string.Equals(item.Type, "layer", StringComparison.Ordinal)
                || string.Equals(item.Type, "document", StringComparison.Ordinal))
            .ToArray();
        _items = items;
        _openDataCount = items.Count(item => item.Access.OpenData);
        _formatCount = items.Sum(item => item.Formats.Count());
    }

    // The public item page reads the server's open-data route by item id, so links use the id.
    private static string PublicItemKey(ConsoleContentSummary item) => item.Id;
}
