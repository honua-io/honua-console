@page "/share"
@page "/share/public"
@page "/public"
@* The "/public" and "/share/public" routes are the open-web open-data / public-link hub
   (host-allow-listed anonymous in ConsolePublicSurfaces). They must also opt the interactive
   render path out of the fail-closed fallback, or AuthorizeRouteView redirects anonymous
   visitors to sign-in. The "/share" route stays operator-only: the host fallback policy does
   not allow-list it, so it remains fail-closed regardless of this page-level attribute.
   Enforced by ConsoleRouteAuthorizationAuditTests (honua-console#254). *@
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IConsoleCatalogClient Catalog

<section class="console-page share-home">
    <div class="console-page-heading">
        <p class="console-kicker">Share workflow</p>
        <h1>Share</h1>
        <p>Everything this workspace publishes to the outside world — public links, embeds, open-data pages, and exports.</p>
    </div>

    @if (_missingBinding)
    {
        <ConsoleStateView Kind="error"
                          Kicker="Missing binding"
                          Title="Share is not bound to honua-server"
                          Message="@MissingBindingMessage" />
    }
    else if (_items is null)
    {
        <ConsoleStateView Kind="loading" Kicker="Loading" Title="Loading public items" Message="Open-data catalog items are loading." />
    }
    else if (_items.Count == 0)
    {
        <ConsoleStateView Kind="empty" Kicker="Empty share" Title="No public open-data items" Message="Publish a service, layer, or document as public open data to expose it here." />
    }
    else
    {
        <div class="console-kpi-strip" data-share-kpis>
            <div class="console-kpi" data-share-kpi="shared-items">
                <span class="console-kpi-label">Shared items</span>
                <span class="console-kpi-value">@_items.Count</span>
                <span class="console-kpi-sub">open-data published</span>
            </div>
            <div class="console-kpi" data-share-kpi="open-data-pages">
                <span class="console-kpi-label">Open-data pages</span>
                <span class="console-kpi-value">@_openDataCount</span>
                <span class="console-kpi-sub">public landing</span>
            </div>
            <div class="console-kpi" data-share-kpi="embed-enabled">
                <span class="console-kpi-label">Embed-enabled</span>
                <span class="console-kpi-value">@_embedCount</span>
                <span class="console-kpi-sub">iframe-ready</span>
            </div>
            <div class="console-kpi" data-share-kpi="public-links">
                <span class="console-kpi-label">Public links</span>
                <span class="console-kpi-value">@_publicLinkCount</span>
                <span class="console-kpi-sub">link or indexed</span>
            </div>
            <div class="console-kpi" data-share-kpi="formats">
                <span class="console-kpi-label">Download formats</span>
                <span class="console-kpi-value">@_formatCount</span>
                <span class="console-kpi-sub">across all items</span>
            </div>
        </div>

        <div class="console-toolbar console-toolbar-spread" data-share-toolbar>
            <span class="console-muted">@_items.Count shared items</span>
        </div>

        <div class="console-table-wrap" data-share-home-table>
            <table class="console-content-table console-table">
                <thead>
                    <tr>
                        <th scope="col">Item</th>
                        <th scope="col">Type</th>
                        <th scope="col">Visibility</th>
                        <th scope="col">Link</th>
                        <th scope="col">Open data</th>
                        <th scope="col">Formats</th>
                        <th scope="col"><span class="console-visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr data-share-row="@SlugOrId(item)">
                            <th scope="row"><a href="/share/public/items/@SlugOrId(item)">@item.Title</a></th>
                            <td><span class="console-status console-state-neutral">@CatalogContentTypes.LabelFor(item.Type)</span></td>
                            <td><span class="console-status console-state-success" data-share-visibility>public</span></td>
                            <td><code class="console-inline-code">/share/public/items/@SlugOrId(item)</code></td>
                            <td>
                                @if (item.Access.OpenData)
                                {
                                    <span class="console-status console-state-success">live</span>
                                }
                                else
                                {
                                    <span class="console-status console-state-neutral">off</span>
                                }
                            </td>
                            <td>
                                <div class="console-chip-row">
                                    @foreach (var format in item.Formats)
                                    {
                                        <span>@format</span>
                                    }
                                </div>
                            </td>
                            <td><a class="console-button console-button-secondary" href="/share/manage?itemId=@item.Id">Configure</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    internal const string MissingBindingMessage =
        "Configure Honua:Server:BaseUrl or HONUA_SERVER_BASE_URL so Console can bind the server-owned "
        + "catalog/content metadata projection from honua-server. The merged runtime never renders seeded "
        + "or demo share content (Console Patterns Charter section 11).";

    private IReadOnlyList<ConsoleContentSummary>? _items;
    private bool _missingBinding;
    private int _openDataCount;
    private int _embedCount;
    private int _publicLinkCount;
    private int _formatCount;

    protected override async Task OnParametersSetAsync()
    {
        if (Catalog is UnsupportedConsoleCatalogClient)
        {
            _missingBinding = true;
            _items = Array.Empty<ConsoleContentSummary>();
            return;
        }

        var result = await Catalog.SearchAsync(new CatalogListRequest
        {
            Sharing = CatalogSharingTiers.Public,
            Sort = CatalogSortOptions.ModifiedDesc
        }, CatalogReadContext.AnonymousPublicLink(token: null));
        var items = result.Items
            .Where(item => item.Access.OpenData
                && (string.Equals(item.Type, "service", StringComparison.Ordinal)
                    || string.Equals(item.Type, "layer", StringComparison.Ordinal)
                    || string.Equals(item.Type, "document", StringComparison.Ordinal)))
            .ToArray();
        _items = items;
        _openDataCount = items.Count(item => item.Access.OpenData);
        _embedCount = items.Count(item => item.Access.Embeddable);
        _publicLinkCount = items.Count(item =>
            string.Equals(item.Access.Sharing, CatalogSharingTiers.Public, StringComparison.Ordinal)
            || string.Equals(item.Access.Sharing, CatalogSharingTiers.PublicLink, StringComparison.Ordinal));
        _formatCount = items.Sum(item => item.Formats.Count());
    }

    private static string SlugOrId(ConsoleContentSummary item) =>
        string.IsNullOrWhiteSpace(item.Slug) ? item.Id : item.Slug;
}
