@* /studio/query is served by the functional, server-bound SavedQueryEditorPage (honua-console#52).
   The remaining families keep the shared descriptive editor until their server contracts bind. *@
@page "/studio/analysis"
@page "/studio/map"
@page "/studio/dashboard"
@page "/studio/report"
@page "/studio/form"
@page "/studio/app"
@inject NavigationManager Navigation

@if (_editor is null)
{
    <section class="console-page">
        <div class="console-page-heading">
            <p class="console-kicker">Unsupported package</p>
            <h1>Studio Package Not Found</h1>
            <p class="console-muted">This package family is not registered in the Studio editor catalog.</p>
        </div>
        <a class="console-button-link" href="/studio">Return to Studio</a>
    </section>
}
else
{
    <StudioPackageEditor Editor="_editor" />
}

@code {
    private StudioPackageEditorDefinition? _editor;

    protected override void OnParametersSet()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split(new[] { '?', '#' }, StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault() ?? string.Empty;
        var routeSegment = relativePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
        _editor = StudioPackageEditorCatalog.Find(routeSegment);
    }
}
