@page "/studio/query"
@page "/studio/analysis"
@page "/studio/map"
@page "/studio/dashboard"
@page "/studio/report"
@page "/studio/form"
@page "/studio/app"
@inject NavigationManager Navigation

@if (_isAnalysis)
{
    @* honua-console#53 carved the analysis editor out to a real honua-server binding (#1182). The other six
       package editors stay on the shared StudioPackageEditor + local lifecycle simulator until their own
       backend contracts land. *@
    <StudioAnalysisBuilder ItemId="AnalysisItemId" Version="AnalysisVersion" />
}
else if (_editor is null)
{
    <section class="console-page">
        <div class="console-page-heading">
            <p class="console-kicker">Unsupported package</p>
            <h1>Studio Package Not Found</h1>
            <p class="console-muted">This package family is not registered in the Studio editor catalog.</p>
        </div>
        <a class="console-button-link" href="/studio">Return to Studio</a>
    </section>
}
else
{
    <StudioPackageEditor Editor="_editor" />
}

@code {
    [Parameter, SupplyParameterFromQuery(Name = "item")]
    public string? AnalysisItemId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = "version")]
    public int? AnalysisVersion { get; set; }

    private StudioPackageEditorDefinition? _editor;
    private bool _isAnalysis;

    protected override void OnParametersSet()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split(new[] { '?', '#' }, StringSplitOptions.RemoveEmptyEntries)
            .FirstOrDefault() ?? string.Empty;
        var routeSegment = relativePath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
        _isAnalysis = string.Equals(routeSegment, "analysis", StringComparison.OrdinalIgnoreCase);
        _editor = _isAnalysis ? null : StudioPackageEditorCatalog.Find(routeSegment);
    }
}
