@page "/operate/layers/{ResourceId}"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IOperateTransitionDataSource OperateData
@inject IConsoleLayerFieldsOperation LayerFields

<section class="console-page">
    @if (_exposures.Count == 0)
    {
        <MissingItemView Kind="layer" AreaLabel="Operate / Layers" />
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Operate / Layers</p>
            <h1>@_exposures[0].Layer.Name</h1>
            <p>Layer @_exposures[0].Layer.LayerId is exposed by @_serviceSummary and reads metadata from @_exposures[0].Layer.CanonicalResourceName.</p>
            <div class="console-detail-actions">
                <a class="console-button-link" href="@($"/operate/layers/{ResourceId}/style")" data-layer-style-link>Resource presentation / style</a>
                <a class="console-button-link" href="@($"/operate/layers/{ResourceId}/relationships")" data-layer-relationships-link>Relationships</a>
                <a class="console-button-link" href="@($"/operate/layers/{ResourceId}/metadata")" data-layer-metadata-link>Edit metadata →</a>
            </div>
        </div>

        <div class="console-panel-grid">
            @foreach (var exposure in _exposures)
            {
                <article class="console-panel">
                    <p class="console-kicker">Exposure</p>
                    <h2>@exposure.Service.DisplayName</h2>
                    <dl class="console-definition-list">
                        <dt>Service</dt>
                        <dd><a href="@($"/operate/services/{exposure.Service.Name}/settings")">@exposure.Service.DisplayName</a></dd>
                        <dt>Geometry</dt>
                        <dd>@exposure.Layer.Geometry</dd>
                        <dt>Runtime</dt>
                        <dd>@exposure.Service.RuntimeStatus</dd>
                    </dl>
                </article>
            }

            <article class="console-panel">
                <p class="console-kicker">Canonical Metadata</p>
                <h2>Resource Owner</h2>
                <dl class="console-definition-list">
                    <dt>Resource</dt>
                    <dd><a href="@($"/operate/resources/{_exposures[0].Layer.CanonicalResourceId}")">@_exposures[0].Layer.CanonicalResourceName</a></dd>
                    <dt>Resource ID</dt>
                    <dd>@_exposures[0].Layer.CanonicalResourceId</dd>
                    <dt>Ownership</dt>
                    <dd>@_exposures[0].Service.MetadataOwnership</dd>
                </dl>
            </article>
        </div>

        <article class="console-panel" data-layer-preview>
            <p class="console-kicker">Preview</p>
            <h2>Rendered map</h2>
            <p class="console-muted">Live render of this layer using honua-server's own MapLibre style and vector tiles, proxied through the console so the server credentials stay server-side.</p>
            <MapPreview Mode="MapPreviewMode.Layer"
                        StyleUrl="@($"/map-proxy/styles/{_exposures[0].Layer.LayerId}.json")"
                        Center="_previewCenter"
                        Zoom="1"
                        Bounds="_exposures[0].Layer.Extent"
                        ShowLabels="false"
                        ShowHighlight="false"
                        ShowPopup="false"
                        Crs="EPSG:3857"
                        AriaLabel="@($"Map preview of layer {_exposures[0].Layer.Name}")" />
        </article>

        <section class="console-section" data-fields-panel>
            <div class="console-page-heading">
                <p class="console-kicker">Fields &amp; domains</p>
                <h2>Attribute fields</h2>
                <p>Author a coded-value domain on a field (code → label). honua-server emits it in the layer's field metadata across FeatureServer, OGC API, and OData.</p>
            </div>

            @if (!_fields.Bound)
            {
                <article class="console-panel console-state-warning" role="status">
                    <p class="console-kicker">Unavailable</p>
                    <p>@_fields.Detail</p>
                </article>
            }
            else
            {
                <p class="console-muted">Edit a field's display alias and visibility, then Save to persist it through honua-server's field metadata. After saving, the table re-reads from the server.</p>
                <div class="console-table-wrap">
                    <table class="console-table">
                        <thead>
                            <tr><th>Field</th><th>Type</th><th>Alias</th><th>Hidden</th><th>Domain</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var field in _fields.Fields)
                            {
                                var edit = EditFor(field.Name);
                                <tr data-field-row data-field-name="@field.Name">
                                    <td class="console-mono">@field.Name</td>
                                    <td>@(field.Type ?? "—")</td>
                                    <td>
                                        <input class="console-input" @bind="edit.Alias" data-field-alias
                                               aria-label="@($"Alias for {field.Name}")" placeholder="@field.Name" />
                                    </td>
                                    <td>
                                        <input type="checkbox" @bind="edit.Hidden" data-field-hidden
                                               aria-label="@($"Hidden for {field.Name}")" />
                                    </td>
                                    <td data-field-domain>
                                        @if (field.DomainKind == ConsoleDomainKind.CodedValue)
                                        {
                                            <span>@(field.DomainName ?? "domain") <small class="console-muted">(@field.CodedValues.Count value(s))</small></span>
                                        }
                                        else if (field.DomainKind == ConsoleDomainKind.Range)
                                        {
                                            <span>@(field.DomainName ?? "domain") <small class="console-muted">(range @field.RangeMin – @field.RangeMax)</small></span>
                                        }
                                        else
                                        {
                                            <span class="console-muted">—</span>
                                        }
                                        @if (field.DefaultValueText is { } dv)
                                        {
                                            <br /><small class="console-muted" data-field-default>default: @dv</small>
                                        }
                                    </td>
                                    <td>
                                        <button class="console-button" type="button" disabled="@_savingField"
                                                @onclick="() => SaveFieldAsync(field.Name)" data-field-save>
                                            Save
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (_fieldResult is { } fr)
                {
                    <div class="console-panel @(fr.Succeeded ? "console-state-success" : "console-state-danger")" role="status" data-field-result>
                        <p class="console-kicker">@fr.State</p>
                        <p>@fr.Detail</p>
                    </div>
                }
                <article class="console-panel">
                    <p class="console-kicker">Domain &amp; default value</p>
                    <div class="studio-field-grid">
                        <label>
                            <span>Field</span>
                            <select class="console-input" aria-label="Domain field" @bind="_domainField" data-domain-field>
                                @foreach (var field in _fields.Fields)
                                {
                                    <option value="@field.Name">@field.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Domain type</span>
                            <select class="console-input" aria-label="Domain type" @bind="_domainKind" data-domain-type>
                                <option value="@ConsoleDomainKind.None">None (clear)</option>
                                <option value="@ConsoleDomainKind.CodedValue">Coded value</option>
                                <option value="@ConsoleDomainKind.Range">Range</option>
                            </select>
                        </label>
                        <label>
                            <span>Domain name</span>
                            <input class="console-input" @bind="_domainName" data-domain-name placeholder="status_codes" />
                        </label>
                    </div>

                    @if (_domainKind == ConsoleDomainKind.CodedValue)
                    {
                        <label>
                            <span>Coded values (one <code>code=label</code> per line)</span>
                            <textarea class="console-input" rows="4" @bind="_domainCodes" data-domain-codes
                                      placeholder="1=Active&#10;2=Inactive"></textarea>
                        </label>
                    }
                    else if (_domainKind == ConsoleDomainKind.Range)
                    {
                        <div class="studio-field-grid">
                            <label>
                                <span>Minimum</span>
                                <input class="console-input" type="number" step="any" @bind="_domainRangeMin"
                                       data-domain-range-min placeholder="0" />
                            </label>
                            <label>
                                <span>Maximum</span>
                                <input class="console-input" type="number" step="any" @bind="_domainRangeMax"
                                       data-domain-range-max placeholder="100" />
                            </label>
                        </div>
                    }

                    <div class="studio-field-grid">
                        <label>
                            <span>Merge policy</span>
                            <input class="console-input" @bind="_domainMergePolicy" data-domain-merge-policy
                                   placeholder="esriMPTDefaultValue" />
                        </label>
                        <label>
                            <span>Split policy</span>
                            <input class="console-input" @bind="_domainSplitPolicy" data-domain-split-policy
                                   placeholder="esriSPTDuplicate" />
                        </label>
                    </div>

                    <div class="studio-field-grid">
                        <label>
                            <span>Default value</span>
                            <input class="console-input" @bind="_defaultValueText" data-domain-default-value
                                   placeholder="(JSON scalar, e.g. 1 or Active)" />
                        </label>
                        <label class="console-checkbox-label">
                            <input type="checkbox" @bind="_clearDefaultValue" data-domain-default-clear />
                            <span>Clear default value</span>
                        </label>
                    </div>

                    <div class="console-action-row">
                        <button class="console-button" type="button" disabled="@_savingDomain" @onclick="SaveDomainAsync" data-domain-save>
                            @(_savingDomain ? "Saving…" : "Save domain")
                        </button>
                    </div>
                    @if (_domainResult is { } dr)
                    {
                        <div class="console-panel @(dr.Succeeded ? "console-state-success" : "console-state-danger")" role="status" data-domain-result>
                            <p class="console-kicker">@dr.State</p>
                            <p>@dr.Detail</p>
                        </div>
                    }
                </article>
            }
        </section>
    }

    <OperateCapabilityStateList States="@_states" />
</section>

@code {
    [Parameter]
    public string ResourceId { get; set; } = string.Empty;

    // A raw layer id is only unique within its connection, so the route keys on the canonical resource
    // id ({connection}-layer-{layerId}) instead — matching the route-map's /operate/layers/:id. That id
    // is shared across every service exposing the same layer (honua-server stores service exposure
    // separately in honua.service_layers) but differs per connection, so grouping by it renders all of
    // this layer's exposures without conflating a same-numbered layer from another connection.
    private IReadOnlyList<(OperateServiceDetail Service, OperateServiceLayerProjection Layer)> _exposures =
        Array.Empty<(OperateServiceDetail, OperateServiceLayerProjection)>();
    private string _serviceSummary = string.Empty;
    private IReadOnlyList<OperateCapabilityState> _states = Array.Empty<OperateCapabilityState>();
    // Web-Mercator origin; a low zoom shows the whole world so the layer's features render wherever they sit.
    private readonly double[] _previewCenter = { 0, 0 };

    private ConsoleLayerFields _fields = ConsoleLayerFields.Unbound("Loading…");
    private string _domainField = string.Empty;
    private string _domainName = string.Empty;
    private ConsoleDomainKind _domainKind = ConsoleDomainKind.CodedValue;
    private string _domainCodes = string.Empty;
    private double? _domainRangeMin;
    private double? _domainRangeMax;
    private string _domainMergePolicy = string.Empty;
    private string _domainSplitPolicy = string.Empty;
    private string _defaultValueText = string.Empty;
    private bool _clearDefaultValue;
    private bool _savingDomain;
    private ConsoleSetDomainResult? _domainResult;

    // Per-field alias/hidden edit state, keyed by field name and seeded from the last server read so the inputs
    // reflect persisted values (and round-trip after a save). Rebuilt on every LoadFieldsAsync.
    private readonly Dictionary<string, FieldEdit> _fieldEdits = new(StringComparer.Ordinal);
    private bool _savingField;
    private ConsoleSetDomainResult? _fieldResult;

    private FieldEdit EditFor(string fieldName) =>
        _fieldEdits.TryGetValue(fieldName, out var edit) ? edit : new FieldEdit();

    private sealed class FieldEdit
    {
        public string? Alias { get; set; }
        public bool Hidden { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        var view = await OperateData.GetLayersViewAsync();
        _exposures = view.Services
            .SelectMany(service => service.Layers.Select(layer => (Service: service, Layer: layer)))
            .Where(row => string.Equals(row.Layer.CanonicalResourceId, ResourceId, StringComparison.OrdinalIgnoreCase))
            .OrderBy(row => row.Service.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();
        _serviceSummary = string.Join(", ", _exposures.Select(exposure => exposure.Service.DisplayName));
        _states = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Layers", "Services");

        if (_exposures.Count > 0)
        {
            await LoadFieldsAsync();
        }
    }

    private async Task LoadFieldsAsync()
    {
        _fields = await LayerFields.GetFieldsAsync(_exposures[0].Layer.LayerId);
        if (_fields.Bound && _fields.Fields.Count > 0 && string.IsNullOrEmpty(_domainField))
        {
            _domainField = _fields.Fields[0].Name;
        }

        // Reseed the editable alias/hidden state from the server read so the inputs (and any re-read after a
        // save) reflect what is actually persisted.
        _fieldEdits.Clear();
        foreach (var field in _fields.Fields)
        {
            _fieldEdits[field.Name] = new FieldEdit { Alias = field.Alias, Hidden = field.Hidden };
        }
    }

    private async Task SaveFieldAsync(string fieldName)
    {
        if (string.IsNullOrWhiteSpace(fieldName) || !_fieldEdits.TryGetValue(fieldName, out var edit))
        {
            return;
        }

        _savingField = true;
        _fieldResult = null;
        try
        {
            _fieldResult = await LayerFields.SetFieldConfigurationAsync(
                _exposures[0].Layer.LayerId,
                fieldName,
                edit.Alias,
                edit.Hidden);
            if (_fieldResult.Succeeded)
            {
                await LoadFieldsAsync();
            }
        }
        finally
        {
            _savingField = false;
        }
    }

    private async Task SaveDomainAsync()
    {
        if (string.IsNullOrWhiteSpace(_domainField))
        {
            return;
        }

        // A "Clear default value" check wins over typed text; otherwise typed text sets the default, and an
        // untouched/empty box leaves the persisted default alone.
        var defaultIntent = _clearDefaultValue
            ? ConsoleDefaultValueIntent.Clear
            : string.IsNullOrWhiteSpace(_defaultValueText)
                ? ConsoleDefaultValueIntent.Unchanged
                : ConsoleDefaultValueIntent.Set;

        var authoring = new ConsoleDomainAuthoring
        {
            FieldName = _domainField,
            DomainName = _domainName,
            Kind = _domainKind,
            CodedValues = _domainKind == ConsoleDomainKind.CodedValue ? ParseCodedValues(_domainCodes) : [],
            RangeMin = _domainKind == ConsoleDomainKind.Range ? _domainRangeMin : null,
            RangeMax = _domainKind == ConsoleDomainKind.Range ? _domainRangeMax : null,
            MergePolicy = _domainMergePolicy,
            SplitPolicy = _domainSplitPolicy,
            DefaultValueIntent = defaultIntent,
            DefaultValueText = _defaultValueText,
        };

        _savingDomain = true;
        _domainResult = null;
        try
        {
            _domainResult = await LayerFields.SetDomainAsync(_exposures[0].Layer.LayerId, authoring);
            if (_domainResult.Succeeded)
            {
                await LoadFieldsAsync();
            }
        }
        finally
        {
            _savingDomain = false;
        }
    }

    // Parses "code=label" lines into coded values; lines without "=" use the whole line as both code and label.
    private static IReadOnlyList<ConsoleCodedValue> ParseCodedValues(string text)
    {
        var values = new List<ConsoleCodedValue>();
        foreach (var rawLine in (text ?? string.Empty).Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length == 0)
            {
                continue;
            }

            var idx = line.IndexOf('=');
            if (idx > 0)
            {
                values.Add(new ConsoleCodedValue(line[..idx].Trim(), line[(idx + 1)..].Trim()));
            }
            else
            {
                values.Add(new ConsoleCodedValue(line, line));
            }
        }

        return values;
    }
}
