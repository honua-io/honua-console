@page "/operate/layers/{ResourceId}"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IOperateTransitionDataSource OperateData
@inject IConsoleLayerFieldsOperation LayerFields
@inject IConsoleNotificationService Notifications
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page" data-layer-resource-id="@ResourceId" data-layer-loaded="@(_exposures.Count > 0)">
    @if (_ambiguousResourceIds.Count > 1)
    {
        <div class="console-page-heading" data-layer-ambiguous>
            <p class="console-kicker">Operate / Layers</p>
            <h1>Choose a layer</h1>
            <p>Layer id @ResourceId exists on more than one connection. Open the one you mean:</p>
            <ul>
                @foreach (var canonicalResourceId in _ambiguousResourceIds)
                {
                    <li><a href="@Navigation.ToConsoleHref($"/operate/layers/{Uri.EscapeDataString(canonicalResourceId)}")">@canonicalResourceId</a></li>
                }
            </ul>
        </div>
    }
    else if (_exposures.Count == 0)
    {
        <MissingItemView Kind="layer" AreaLabel="Operate / Layers" />
    }
    else
    {
        @if (V4Enabled)
        {
            <ConsolePageHeading Title="@_exposures[0].Layer.Name">
                <ChildContent><p><code>@CanonicalResourceId</code> · @_exposures[0].Layer.Geometry · @_serviceSummary</p></ChildContent>
                <Actions>@LayerActions</Actions>
            </ConsolePageHeading>
            <ConsolePanel Title="Layer preview" HeadingId="layer-preview-heading">
                <div data-layer-preview><p class="console-muted">Live map rendered by honua-server through the Console map proxy.</p>
                        <LayerMapPreview Layer="_exposures[0].Layer" EnvironmentId="@_environmentId" /></div>
            </ConsolePanel>
            @LayerOverview
            <ConsolePanel Title="Fields and domains" HeadingId="layer-fields-heading">
                @Fields
            </ConsolePanel>
        }
        else
        {
            <div class="console-page-heading">
                <p class="console-kicker">Operate / Layers</p>
                <h1>@_exposures[0].Layer.Name</h1>
                <p>Admin layer @_exposures[0].Layer.LayerId is exposed by @_serviceSummary and reads metadata from @_exposures[0].Layer.CanonicalResourceName.</p>
                @LayerActions
            </div>
            <div class="console-panel-grid">
                @foreach (var exposure in _exposures)
                {
                    <article class="console-panel">
                        <p class="console-kicker">Exposure</p>
                        <h2>@exposure.Service.DisplayName</h2>
                        <dl class="console-definition-list">
                            <dt>Service</dt>
                            <dd><a href="@Navigation.ToConsoleHref(ConsoleAgentRoutes.ForEntity(ConsoleAgentEntity.ForService(exposure.Service.Name)))">@exposure.Service.DisplayName</a></dd>
                            <dt>Geometry</dt>
                            <dd>@exposure.Layer.Geometry</dd>
                            <dt>Runtime</dt>
                            <dd>@exposure.Service.RuntimeStatus</dd>
                        </dl>
                    </article>
                }

                <article class="console-panel">
                    <p class="console-kicker">Canonical Metadata</p>
                    <h2>Resource Owner</h2>
                    <dl class="console-definition-list">
                        <dt>Resource</dt>
                        <dd><a href="@Navigation.ToConsoleHref($"/operate/resources/{Uri.EscapeDataString(CanonicalResourceId)}")">@_exposures[0].Layer.CanonicalResourceName</a></dd>
                        <dt>Console layer reference</dt>
                        <dd>@_exposures[0].Layer.CanonicalResourceId</dd>
                        <dt>Ownership</dt>
                        <dd>@_exposures[0].Service.MetadataOwnership</dd>
                    </dl>
                </article>
            </div>

            <DiscoveryMetadataEditor Address="@Honua.Console.Contracts.DiscoveryMetadataAddress.ForLayer(_exposures[0].Layer.LayerId)" />
            <article class="console-panel" data-layer-preview>
                <p class="console-kicker">Preview</p>
                <h2>Rendered map</h2>
                <p class="console-muted">Live render of this layer using honua-server's own MapLibre style and vector tiles, proxied through the console so the server credentials stay server-side.</p>
                <LayerMapPreview Layer="_exposures[0].Layer" EnvironmentId="@_environmentId" />
            </article>
            @Fields
        }

    }

    <OperateCapabilityStateList States="@_states" />
</section>

@code {

    private RenderFragment LayerActions => @<text>            <div class="console-detail-actions">
                <a class="console-button-link @(V4Enabled ? "console-button-secondary" : null)" href="@Navigation.ToConsoleHref($"/operate/layers/{Uri.EscapeDataString(CanonicalResourceId)}/style")" data-layer-style-link>Resource presentation / style</a>
                <a class="console-button-link @(V4Enabled ? "console-button-secondary" : null)" href="@Navigation.ToConsoleHref($"/operate/layers/{Uri.EscapeDataString(CanonicalResourceId)}/relationships")" data-layer-relationships-link>Relationships</a>
                <a class="console-button-link @(V4Enabled ? "console-button-secondary" : null)" href="@Navigation.ToConsoleHref($"/operate/layers/{Uri.EscapeDataString(CanonicalResourceId)}/filter")" data-layer-filter-link>Permanent filter</a>
                <a class="console-button-link @(V4Enabled ? "console-button-secondary" : null)" href="@Navigation.ToConsoleHref($"/operate/layers/{Uri.EscapeDataString(CanonicalResourceId)}/metadata")" data-layer-metadata-link>Editing policy →</a>
            </div></text>;
    private RenderFragment Fields => @<text>        <section class="console-section @(V4Enabled ? "console-data-controls" : null)" data-fields-panel>
            @if (!V4Enabled)
            {
                <div class="console-page-heading">
                    <p class="console-kicker">Fields &amp; domains</p>
                    <h2>Attribute fields</h2>
                    <p>Author a coded-value domain on a field (code → label). honua-server emits it in the layer's field metadata across FeatureServer, OGC API, and OData.</p>
                </div>
            }

            @if (!_fields.Bound)
            {
                <div class="console-panel @(V4Enabled ? "console-state-neutral" : "console-state-warning")" role="status">
                    <p class="console-kicker">Unavailable</p>
                    <p>@_fields.Detail</p>
                </div>
            }
            else
            {
                <p class="console-muted">Edit a field's display alias and visibility, then Save to persist it through honua-server's field metadata. After saving, the table re-reads from the server.</p>
                <ConsoleTableRegion Class="console-table-wrap" Label="Layer fields">
                    <table class="console-table">
                        <thead>
                            <tr><th>Field</th><th>Type</th><th>Alias</th><th>Hidden</th><th>Domain</th><th>@(V4Enabled ? "Actions" : null)</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var layerField in _fields.Fields)
                            {
                                var edit = EditFor(layerField.Name);
                                <tr data-field-row data-field-name="@layerField.Name">
                                    <td class="console-mono">@layerField.Name</td>
                                    <td>@(layerField.Type ?? "—")</td>
                                    <td>
                                        <input class="console-input" @bind="edit.Alias" data-field-alias
                                               aria-label="@($"Alias for {layerField.Name}")" placeholder="@layerField.Name" />
                                    </td>
                                    <td>
                                        <input type="checkbox" @bind="edit.Hidden" data-field-hidden
                                               aria-label="@($"Hidden for {layerField.Name}")" />
                                    </td>
                                    <td data-field-domain>
                                        @if (layerField.DomainKind == ConsoleDomainKind.CodedValue)
                                        {
                                            <span>@(layerField.DomainName ?? "domain") <small class="console-muted">(@layerField.CodedValues.Count value(s))</small></span>
                                        }
                                        else if (layerField.DomainKind == ConsoleDomainKind.Range)
                                        {
                                            <span>@(layerField.DomainName ?? "domain") <small class="console-muted">(range @layerField.RangeMin – @layerField.RangeMax)</small></span>
                                        }
                                        else
                                        {
                                            <span class="console-muted">—</span>
                                        }
                                        @if (layerField.DefaultValueText is { } dv)
                                        {
                                            <br /><small class="console-muted" data-field-default>default: @dv</small>
                                        }
                                    </td>
                                    <td>
                                        <button class="console-button" type="button" disabled="@_savingField"
                                                @onclick="() => SaveFieldAsync(layerField.Name)" data-field-save>
                                            Save
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </ConsoleTableRegion>
                @if (_fieldResult is { } fr)
                {
                    <div class="console-panel @(fr.Succeeded ? "console-state-success" : "console-state-danger")" role="status" data-field-result>
                        <p class="console-kicker">@fr.State</p>
                        <p>@fr.Detail</p>
                    </div>
                }
                <article class="console-panel">
                    <p class="console-kicker">Domain &amp; default value</p>
                    <div class="studio-field-grid">
                        <label>
                            <span>Field</span>
                            <select class="console-input" aria-label="Domain field" @bind="_domainField" data-domain-field>
                                @foreach (var layerField in _fields.Fields)
                                {
                                    <option value="@layerField.Name">@layerField.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Domain type</span>
                            <select class="console-input" aria-label="Domain type" @bind="_domainKind" data-domain-type>
                                <option value="@ConsoleDomainKind.None">None (clear)</option>
                                <option value="@ConsoleDomainKind.CodedValue">Coded value</option>
                                <option value="@ConsoleDomainKind.Range">Range</option>
                            </select>
                        </label>
                        <label>
                            <span>Domain name</span>
                            <input class="console-input" @bind="_domainName" data-domain-name placeholder="status_codes" />
                        </label>
                    </div>

                    @if (_domainKind == ConsoleDomainKind.CodedValue)
                    {
                        <label>
                            <span>Coded values (one <code>code=label</code> per line)</span>
                            <textarea class="console-input" rows="4" @bind="_domainCodes" data-domain-codes
                                      placeholder="1=Active&#10;2=Inactive"></textarea>
                        </label>
                    }
                    else if (_domainKind == ConsoleDomainKind.Range)
                    {
                        <div class="studio-field-grid">
                            <label>
                                <span>Minimum</span>
                                <input class="console-input" type="number" step="any" @bind="_domainRangeMin"
                                       data-domain-range-min placeholder="0" />
                            </label>
                            <label>
                                <span>Maximum</span>
                                <input class="console-input" type="number" step="any" @bind="_domainRangeMax"
                                       data-domain-range-max placeholder="100" />
                            </label>
                        </div>
                    }

                    <div class="studio-field-grid">
                        <label>
                            <span>Merge policy</span>
                            <input class="console-input" @bind="_domainMergePolicy" data-domain-merge-policy
                                   placeholder="esriMPTDefaultValue" />
                        </label>
                        <label>
                            <span>Split policy</span>
                            <input class="console-input" @bind="_domainSplitPolicy" data-domain-split-policy
                                   placeholder="esriSPTDuplicate" />
                        </label>
                    </div>

                    <div class="studio-field-grid">
                        <label>
                            <span>Default value</span>
                            <input class="console-input" @bind="_defaultValueText" data-domain-default-value
                                   placeholder="(JSON scalar, e.g. 1 or Active)" />
                        </label>
                        <label class="console-checkbox-label">
                            <input type="checkbox" @bind="_clearDefaultValue" data-domain-default-clear />
                            <span>Clear default value</span>
                        </label>
                    </div>

                    <div class="console-action-row">
                        <button class="console-button" type="button" disabled="@_savingDomain" @onclick="SaveDomainAsync" data-domain-save>
                            @(_savingDomain ? "Saving…" : "Save domain")
                        </button>
                    </div>
                    @if (_domainResult is { } dr)
                    {
                        <div class="console-panel @(dr.Succeeded ? "console-state-success" : "console-state-danger")" role="status" data-domain-result>
                            <p class="console-kicker">@dr.State</p>
                            <p>@dr.Detail</p>
                        </div>
                    }
                </article>
            }
        </section></text>;

    private RenderFragment LayerOverview => @<text>
        <div class="console-panel-grid">
            @for (var i = 0; i < _exposures.Count; i++)
            {
                var exposure = _exposures[i];
                <ConsolePanel Title="@exposure.Service.DisplayName" HeadingId="@($"layer-exposure-{i}-heading")">
                    <dl class="console-definition-list">
                        <dt>Service</dt>
                        <dd><ConsoleNameIdentifier Name="@exposure.Service.DisplayName" Identifier="@exposure.Service.Name"
                            Href="@ConsoleAgentRoutes.ForEntity(ConsoleAgentEntity.ForService(exposure.Service.Name))" /></dd>
                        <dt>Geometry</dt><dd>@exposure.Layer.Geometry</dd>
                        <dt>Runtime</dt><dd>@exposure.Service.RuntimeStatus</dd>
                    </dl>
                </ConsolePanel>
            }
            <ConsolePanel Title="Resource owner" HeadingId="layer-resource-heading">
                <dl class="console-definition-list">
                    <dt>Resource</dt><dd><ConsoleNameIdentifier Name="@_exposures[0].Layer.CanonicalResourceName" Identifier="@CanonicalResourceId"
                        Href="@($"/operate/resources/{Uri.EscapeDataString(CanonicalResourceId)}")" /></dd>
                    <dt>Ownership</dt><dd>@_exposures[0].Service.MetadataOwnership</dd>
                </dl>
            </ConsolePanel>
        </div>
        <DiscoveryMetadataEditor Address="@Honua.Console.Contracts.DiscoveryMetadataAddress.ForLayer(_exposures[0].Layer.LayerId)"
            UnsavedChanged="@(summary => _metadataUnsaved = summary)" />
    </text>;


    private bool V4Enabled => ServiceProvider.GetService<ConsoleV4Options>()?.Enabled == true;
    private ConsoleAgentUnsavedSummary _metadataUnsaved = new();
    private bool _loading = true;
    private object?[]? _savedDomainDraft;
    private object?[] DomainDraft => [_domainField, _domainKind, _domainName, _domainCodes, _domainRangeMin, _domainRangeMax,
        _domainMergePolicy, _domainSplitPolicy, _defaultValueText, _clearDefaultValue];
    private ConsoleAgentEntity? SelectedLayer => _exposures.Count == 0 ? null : ConsoleAgentEntity.ForLayer(_exposures[0].Layer);
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = SelectedLayer is { } layer ? ConsoleAgentRoutes.ForEntity(layer) : ConsoleAgentRoutes.ForRequestedLayer(ResourceId),
        Entities = SelectedLayer is { } entity ? [entity] : [],
        Selection = SelectedLayer is { } selected ? [selected] : [],
        Unsaved = new()
        {
            ChangedFieldCount = _exposures.Count == 0 ? 0 : _metadataUnsaved.ChangedFieldCount +
                _fields.Fields.Sum(layerField => _fieldEdits.TryGetValue(layerField.Name, out var edit)
                    ? (edit.Alias != layerField.Alias ? 1 : 0) + (edit.Hidden != layerField.Hidden ? 1 : 0) : 0) +
                (_savedDomainDraft is null ? 0 : DomainDraft.Zip(_savedDomainDraft).Count(pair => !Equals(pair.First, pair.Second))),
            PendingOperationCount = _metadataUnsaved.PendingOperationCount + (_loading ? 1 : 0) + (_savingField ? 1 : 0) + (_savingDomain ? 1 : 0)
        }
    };

    [CascadingParameter] public ConsolePublicationLayerContext? PublicationContext { get; set; }

    [Parameter]
    public string ResourceId { get; set; } = string.Empty;

    private IReadOnlyList<OperateLayerExposure> _exposures = [];
    private IReadOnlyList<string> _ambiguousResourceIds = [];
    private string CanonicalResourceId => _exposures[0].Layer.CanonicalResourceId;
    private string _serviceSummary = string.Empty;
    private IReadOnlyList<OperateCapabilityState> _states = Array.Empty<OperateCapabilityState>();

    private ConsoleLayerFields _fields = ConsoleLayerFields.Unbound("Loading…");
    private string _domainField = string.Empty;
    private string _domainName = string.Empty;
    private ConsoleDomainKind _domainKind = ConsoleDomainKind.CodedValue;
    private string _domainCodes = string.Empty;
    private double? _domainRangeMin;
    private double? _domainRangeMax;
    private string _domainMergePolicy = string.Empty;
    private string _domainSplitPolicy = string.Empty;
    private string _defaultValueText = string.Empty;
    private bool _clearDefaultValue;
    private bool _savingDomain;
    private ConsoleSetDomainResult? _domainResult;

    // Per-field alias/hidden edit state, keyed by field name and seeded from the last server read so the inputs
    // reflect persisted values (and round-trip after a save). Rebuilt on every LoadFieldsAsync.
    private readonly Dictionary<string, FieldEdit> _fieldEdits = new(StringComparer.Ordinal);
    private bool _savingField;
    private ConsoleSetDomainResult? _fieldResult;

    private FieldEdit EditFor(string fieldName) =>
        _fieldEdits.TryGetValue(fieldName, out var edit) ? edit : new FieldEdit();

    private sealed class FieldEdit
    {
        public string? Alias { get; set; }
        public bool Hidden { get; set; }
    }

    // Active environment profile id the page's proxy URLs are pinned to (null renders the schematic).
    private string? _environmentId;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var attempt = PublicationContext?.BeginRead(ResourceId);
        // Pin proxy URLs to the environment this view renders, so a later switch elsewhere fails them closed.
        _environmentId = await ConsoleProxyRoutes.ResolveActiveEnvironmentIdAsync(
            ServiceProvider.GetService<IConsoleEnvironmentProfileStore>());
        var view = await OperateData.GetLayersViewAsync();
        _exposures = view.FindExposures(ResourceId);
        if (attempt is { } read) PublicationContext!.CompleteRead(read, _exposures);
        _ambiguousResourceIds = view.MatchingCanonicalResourceIds(ResourceId);
        _serviceSummary = string.Join(", ", _exposures.Select(exposure => exposure.Service.DisplayName));
        _states = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Layers", "Services");

        if (_exposures.Count > 0)
        {
            await LoadFieldsAsync();
            _savedDomainDraft = DomainDraft;
        }
        _loading = false;
    }

    private async Task LoadFieldsAsync()
    {
        _fields = await LayerFields.GetFieldsAsync(_exposures[0].Layer.LayerId);
        if (_fields.Bound && _fields.Fields.Count > 0 && string.IsNullOrEmpty(_domainField))
        {
            _domainField = _fields.Fields[0].Name;
        }

        // Reseed the editable alias/hidden state from the server read so the inputs (and any re-read after a
        // save) reflect what is actually persisted.
        _fieldEdits.Clear();
        foreach (var layerField in _fields.Fields)
        {
            _fieldEdits[layerField.Name] = new FieldEdit { Alias = layerField.Alias, Hidden = layerField.Hidden };
        }
    }

    private Task SaveFieldAsync(string fieldName)
    {
        if (string.IsNullOrWhiteSpace(fieldName) || !_fieldEdits.TryGetValue(fieldName, out var edit))
        {
            return Task.CompletedTask;
        }

        _fieldResult = null;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                _fieldResult = await LayerFields.SetFieldConfigurationAsync(
                    _exposures[0].Layer.LayerId,
                    fieldName,
                    edit.Alias,
                    edit.Hidden);
                if (_fieldResult.Succeeded)
                {
                    await LoadFieldsAsync();
                }
            },
            setBusy: busy => { _savingField = busy; StateHasChanged(); },
            failureMessage: "Couldn't save field settings");
    }

    private Task SaveDomainAsync()
    {
        if (string.IsNullOrWhiteSpace(_domainField))
        {
            return Task.CompletedTask;
        }

        // A "Clear default value" check wins over typed text; otherwise typed text sets the default, and an
        // untouched/empty box leaves the persisted default alone.
        var defaultIntent = _clearDefaultValue
            ? ConsoleDefaultValueIntent.Clear
            : string.IsNullOrWhiteSpace(_defaultValueText)
                ? ConsoleDefaultValueIntent.Unchanged
                : ConsoleDefaultValueIntent.Set;

        var authoring = new ConsoleDomainAuthoring
        {
            FieldName = _domainField,
            DomainName = _domainName,
            Kind = _domainKind,
            CodedValues = _domainKind == ConsoleDomainKind.CodedValue ? ParseCodedValues(_domainCodes) : [],
            RangeMin = _domainKind == ConsoleDomainKind.Range ? _domainRangeMin : null,
            RangeMax = _domainKind == ConsoleDomainKind.Range ? _domainRangeMax : null,
            MergePolicy = _domainMergePolicy,
            SplitPolicy = _domainSplitPolicy,
            DefaultValueIntent = defaultIntent,
            DefaultValueText = _defaultValueText,
        };

        // Edits made while the save is pending stay counted as unsaved.
        var submittedDraft = DomainDraft;
        _domainResult = null;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                _domainResult = await LayerFields.SetDomainAsync(_exposures[0].Layer.LayerId, authoring);
                if (_domainResult.Succeeded)
                {
                    await LoadFieldsAsync();
                    _savedDomainDraft = submittedDraft;
                }
            },
            setBusy: busy => { _savingDomain = busy; StateHasChanged(); },
            failureMessage: "Couldn't save domain");
    }

    // Parses "code=label" lines into coded values; lines without "=" use the whole line as both code and label.
    private static IReadOnlyList<ConsoleCodedValue> ParseCodedValues(string text)
    {
        var values = new List<ConsoleCodedValue>();
        foreach (var rawLine in (text ?? string.Empty).Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length == 0)
            {
                continue;
            }

            var idx = line.IndexOf('=');
            if (idx > 0)
            {
                values.Add(new ConsoleCodedValue(line[..idx].Trim(), line[(idx + 1)..].Trim()));
            }
            else
            {
                values.Add(new ConsoleCodedValue(line, line));
            }
        }

        return values;
    }
}
