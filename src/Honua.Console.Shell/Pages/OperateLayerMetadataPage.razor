@page "/operate/layers/{ResourceId}/metadata"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IOperateTransitionDataSource OperateData
@inject IConsoleLayerMetadataOperation LayerMetadata
@inject IConsoleNotificationService Notifications
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page" data-layer-metadata-page>
    @if (_loading)
    {
        <p role="status">Loading layer…</p>
    }
    else if (_exposures.Count == 0)
    {
        <MissingItemView Kind="layer" AreaLabel="Operate / Layers" />
    }
    else
    {
        @if (V4Enabled)
        {
            <ConsolePageHeading Title="@($"{Layer.Name} · editing")">
                <ChildContent><p>Set the editing policy for this layer’s FeatureServer service.</p></ChildContent>
                <Actions><LayerBackLink CanonicalResourceId="@Layer.CanonicalResourceId" /></Actions>
            </ConsolePageHeading>
        }
        else
        {
            <div class="console-page-heading">
                <p class="console-kicker">Operate / Layers</p>
                <h1>@Layer.Name · editing</h1>
                <p>Set the editing policy of layer @Layer.LayerId in one of its FeatureServer services. Fields left unchanged keep their current server value.</p>
                <div class="console-detail-actions">
                    <a class="console-button-link" href="@Navigation.ToConsoleHref(ConsoleAgentLayerTool.LayerRoute(Layer.CanonicalResourceId))" data-layer-detail-link>Back to layer</a>
                </div>
            </div>
        }

        @if (_editableExposures.Count == 0)
        {
            <div class="@(V4Enabled ? "console-state console-state-warning" : "console-panel console-state-warning")" role="status" data-editing-unavailable>
                <p>Editing policy applies to FeatureServer services, and no FeatureServer service exposes this layer.</p>
            </div>
        }
        else
        {
            @if (V4Enabled)
            {
                <ConsolePanel Title="Editing policy" HeadingId="layer-editing-heading" Class="console-section">@EditingFields</ConsolePanel>
            }
            else
            {
                <section class="console-section">@EditingFields</section>
            }
        }
    }
</section>

@code {
    private bool V4Enabled => ServiceProvider.GetService<ConsoleV4Options>()?.Enabled == true;
    private RenderFragment EditingFields => @<div data-editing-panel>
        <div class="console-field-grid">
            <label class="console-field">
                <span>Service</span>
                <select class="console-input" @bind="_edit.ServiceName" aria-label="Service" data-editing-service>
                    @foreach (var exposure in _editableExposures)
                    {
                        <option value="@exposure.Service.Name">@exposure.Service.DisplayName</option>
                    }
                </select>
            </label>
            <label class="console-field">
                <span>Global id field</span>
                <input class="console-input" @bind="_edit.GlobalIdField" aria-label="Global id field" data-editing-globalid placeholder="(unchanged)" />
            </label>
            <TriStateSelect Label="Supports attachments" @bind-Value="_edit.SupportsAttachments" data-editing-attachments />
            <TriStateSelect Label="Allow create" @bind-Value="_edit.AllowCreate" data-editing-create />
            <TriStateSelect Label="Allow update" @bind-Value="_edit.AllowUpdate" data-editing-update />
            <TriStateSelect Label="Allow delete" @bind-Value="_edit.AllowDelete" data-editing-delete />
        </div>
        <div class="console-action-row">
            <button class="console-button" type="button" disabled="@_saving" @onclick="SaveEditingAsync" data-editing-save>
                @(_saving ? "Saving…" : "Save editing policy")
            </button>
        </div>
        @if (_result is { } result)
        {
            <div class="@(V4Enabled ? "console-state" : "console-panel") @(result.Succeeded ? "console-state-success" : "console-state-danger")" role="status" data-editing-result>
                <p class="@(V4Enabled ? null : "console-kicker")">@result.State</p>
                <p>@result.Detail</p>
            </div>
        }
    </div>;

    private ConsoleLayerEditingChange? _baseline;
    private long _generation;
    private bool _loading;
    private ConsoleAgentPageContext AgentContext =>
        ConsoleAgentLayerTool.Context((_exposures.Count == 0 ? null : Layer), ResourceId, "metadata", ChangedFields, _loading || _saving);
    private int ChangedFields
    {
        get
        {
            if (_baseline is null || _exposures.Count == 0) return 0;
            var current = _edit.ToChange(Layer.LayerId);
            return (current.ServiceName == _baseline.ServiceName ? 0 : 1)
                + (current.GlobalIdField == _baseline.GlobalIdField ? 0 : 1)
                + (current.SupportsAttachments == _baseline.SupportsAttachments ? 0 : 1)
                + (current.AllowCreate == _baseline.AllowCreate ? 0 : 1)
                + (current.AllowUpdate == _baseline.AllowUpdate ? 0 : 1)
                + (current.AllowDelete == _baseline.AllowDelete ? 0 : 1);
        }
    }

    [CascadingParameter] public ConsolePublicationLayerContext? PublicationContext { get; set; }

    [Parameter]
    public string ResourceId { get; set; } = string.Empty;

    private IReadOnlyList<OperateLayerExposure> _exposures = [];
    private IReadOnlyList<OperateLayerExposure> _editableExposures = [];
    private string? _loadedResourceId;
    private EditingForm _edit = new();
    private bool _saving;
    private ConsoleSetLayerMetadataResult? _result;

    private OperateServiceLayerProjection Layer => _exposures[0].Layer;

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedResourceId, ResourceId, StringComparison.Ordinal)) return;
        _loadedResourceId = ResourceId;
        var generation = ++_generation;
        var resourceId = ResourceId;
        _exposures = [];
        _editableExposures = [];
        _baseline = null;
        _result = null;
        _saving = false;
        _loading = true;
        var attempt = PublicationContext?.BeginRead(resourceId);
        try
        {
            var view = await OperateData.GetLayersViewAsync();
            if (generation != _generation) return;
            _exposures = view.FindExposures(resourceId);
            if (attempt is { } read) PublicationContext!.CompleteRead(read, _exposures);
            _editableExposures = _exposures
                .Where(exposure => exposure.Service.Serves(PublishProtocolCatalog.Protocols.FeatureServer))
                .ToArray();
            _edit = new EditingForm { ServiceName = _editableExposures.FirstOrDefault()?.Service.Name ?? string.Empty };
            if (_exposures.Count > 0) _baseline = _edit.ToChange(Layer.LayerId);
        }
        finally
        {
            if (generation == _generation) _loading = false;
        }
    }

    private Task SaveEditingAsync()
    {
        if (_saving || _exposures.Count == 0) return Task.CompletedTask;
        var generation = _generation;
        var change = _edit.ToChange(Layer.LayerId);
        _result = null;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                var result = await LayerMetadata.SetEditingAsync(change);
                if (generation == _generation)
                {
                    _result = result;
                    if (result.Succeeded) _baseline = change;
                }
            },
            setBusy: busy => { if (generation == _generation) { _saving = busy; StateHasChanged(); } },
            failureMessage: "Couldn't save the editing policy");
    }

    private sealed class EditingForm
    {
        public string ServiceName { get; set; } = string.Empty;
        public string? GlobalIdField { get; set; }
        public bool? SupportsAttachments { get; set; }
        public bool? AllowCreate { get; set; }
        public bool? AllowUpdate { get; set; }
        public bool? AllowDelete { get; set; }

        public ConsoleLayerEditingChange ToChange(int layerId) => new()
        {
            ServiceName = ServiceName,
            LayerId = layerId,
            GlobalIdField = string.IsNullOrWhiteSpace(GlobalIdField) ? null : GlobalIdField.Trim(),
            SupportsAttachments = SupportsAttachments,
            AllowCreate = AllowCreate,
            AllowUpdate = AllowUpdate,
            AllowDelete = AllowDelete,
        };
    }
}
