@page "/operate/layers/{ResourceId}/metadata"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IOperateTransitionDataSource OperateData
@inject IConsoleLayerMetadataOperation LayerMetadata
@inject IConsoleNotificationService Notifications

<section class="console-page" data-layer-metadata-page>
    @if (_exposures.Count == 0)
    {
        <MissingItemView Kind="layer" AreaLabel="Operate / Layers" />
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Operate / Layers</p>
            <h1>@Layer.Name · editing</h1>
            <p>Set the editing policy of layer @Layer.LayerId in one of its FeatureServer services. Fields left unchanged keep their current server value.</p>
            <div class="console-detail-actions">
                <a class="console-button-link" href="@($"/operate/layers/{Layer.CanonicalResourceId}")" data-layer-detail-link>Back to layer</a>
            </div>
        </div>

        <section class="console-section" data-editing-panel>
            <div class="console-field-grid">
                <label class="console-field">
                    <span>Service</span>
                    <select class="console-input" @bind="_edit.ServiceName" aria-label="Service" data-editing-service>
                        @foreach (var exposure in _exposures)
                        {
                            <option value="@exposure.Service.Name">@exposure.Service.DisplayName</option>
                        }
                    </select>
                </label>
                <label class="console-field">
                    <span>Global id field</span>
                    <input class="console-input" @bind="_edit.GlobalIdField" aria-label="Global id field" data-editing-globalid placeholder="(unchanged)" />
                </label>
                <TriStateSelect Label="Supports attachments" @bind-Value="_edit.SupportsAttachments" data-editing-attachments />
                <TriStateSelect Label="Allow create" @bind-Value="_edit.AllowCreate" data-editing-create />
                <TriStateSelect Label="Allow update" @bind-Value="_edit.AllowUpdate" data-editing-update />
                <TriStateSelect Label="Allow delete" @bind-Value="_edit.AllowDelete" data-editing-delete />
            </div>
            <div class="console-action-row">
                <button class="console-button" type="button" disabled="@_saving" @onclick="SaveEditingAsync" data-editing-save>
                    @(_saving ? "Saving…" : "Save editing policy")
                </button>
            </div>
            @if (_result is { } result)
            {
                <div class="console-panel @(result.Succeeded ? "console-state-success" : "console-state-danger")" role="status" data-editing-result>
                    <p class="console-kicker">@result.State</p>
                    <p>@result.Detail</p>
                </div>
            }
        </section>
    }
</section>

@code {
    [Parameter]
    public string ResourceId { get; set; } = string.Empty;

    private IReadOnlyList<OperateLayerExposure> _exposures = [];
    private readonly EditingForm _edit = new();
    private bool _saving;
    private ConsoleSetLayerMetadataResult? _result;

    private OperateServiceLayerProjection Layer => _exposures[0].Layer;

    protected override async Task OnParametersSetAsync()
    {
        var view = await OperateData.GetLayersViewAsync();
        _exposures = view.FindExposures(ResourceId);
        if (_exposures.Count > 0)
        {
            _edit.ServiceName = _exposures[0].Service.Name;
        }
    }

    private Task SaveEditingAsync()
    {
        _result = null;
        return Notifications.RunGuardedAsync(
            async () => _result = await LayerMetadata.SetEditingAsync(_edit.ToChange(Layer.LayerId)),
            setBusy: busy => { _saving = busy; StateHasChanged(); },
            failureMessage: "Couldn't save the editing policy");
    }

    private sealed class EditingForm
    {
        public string ServiceName { get; set; } = string.Empty;
        public string? GlobalIdField { get; set; }
        public bool? SupportsAttachments { get; set; }
        public bool? AllowCreate { get; set; }
        public bool? AllowUpdate { get; set; }
        public bool? AllowDelete { get; set; }

        public ConsoleLayerEditingChange ToChange(int layerId) => new()
        {
            ServiceName = ServiceName,
            LayerId = layerId,
            GlobalIdField = string.IsNullOrWhiteSpace(GlobalIdField) ? null : GlobalIdField.Trim(),
            SupportsAttachments = SupportsAttachments,
            AllowCreate = AllowCreate,
            AllowUpdate = AllowUpdate,
            AllowDelete = AllowDelete,
        };
    }
}
