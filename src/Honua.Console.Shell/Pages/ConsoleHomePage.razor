@page "/"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IConsoleEnvironmentProfileStore Profiles
@inject IConsoleApprovalInboxClient Inbox
@inject IServiceProvider ServiceProvider
@inject IConsoleHostCapabilities Host
@implements IAsyncDisposable

@* CONSOLE HOME — the information + approval landing (#193). The console's job is to
   witness and authorize the work agents and APIs propose, so the landing leads with the
   approval inbox (pending agent-proposed operations the operator can act on) rather than a
   dead grid of links. The inbox band binds to live server data through the aggregator and
   renders an honest missing-binding / empty state when no work — never seeded data. The
   four area work surfaces follow as the entry points into the department's tools.

   The inbox band goes live (console#292 scope item 4): it subscribes to the same admin-hub
   proposals group the approval inbox uses (console#294's shared realtime seam), so a
   ProposalPending/ProposalResolved event updates the count here without a page reload. A
   failed connect degrades to the existing one-shot read (manual refresh via navigation) — the
   Live/Manual pill states this honestly rather than claiming a liveness that failed. The
   realtime client is resolved optionally (GetService, not a required inject): a host that has
   not registered the seam gets the same honest Manual state, never a render exception. *@

<section class="console-page">
    <div class="console-page-heading">
        <p class="console-kicker">Information + approval surface</p>
        <h1>Honua Console</h1>
        <p>
            Agents and APIs do the writing. The console is where you witness service status,
            review agent-proposed plans, and authorize the outcome. Studio, Catalog, Operate,
            and Share run in one route surface while preserving builder and operator boundaries.
        </p>
    </div>

    @* Ops-summary strip (console#292, founder decision 2026-07-07: ships on home, not hub-only):
       the landing's "is my server healthy, what needs me?" glance — overall health, awaiting
       approvals, open findings, and SLO breaches, each deep-linking to its actionable surface. *@
    <OpsSummaryStrip />

    <div class="console-home-band">
        @* ── Pending approvals (the work queue at a glance) ──────────────────── *@
        <section class="console-panel console-home-inbox" aria-labelledby="home-inbox-heading">
            <div>
                <p class="console-kicker">Human-in-the-loop</p>
                <h2 id="home-inbox-heading">Approval inbox</h2>
            </div>
            @* Freshness affordance (console#309): Live when the proposals hub is connected;
               otherwise an honest paused signal carrying the last good refresh time. Flips on
               reconnect without a reload via the shared realtime state-changed seam. *@
            @if (RealtimeConnected)
            {
                <span class="approval-inbox-live is-live" data-home-live-state="live"
                      data-fallback-engaged="@FallbackEngaged">
                    Live
                </span>
            }
            else
            {
                <span class="approval-inbox-live approval-inbox-paused" data-home-live-state="paused"
                      data-fallback-engaged="@FallbackEngaged">
                    Updates paused — last refreshed
                    <span data-home-inbox-paused-since>@ConsoleFreshness.LastRefreshedShort(_lastInboxSuccessUtc)</span>
                </span>
            }
            @if (!_inboxLoaded)
            {
                <p class="console-muted">Reading the work queue…</p>
            }
            else if (!_inbox.IsAllowed && ConsoleReadBudget.IsErrorState(_inbox.Status))
            {
                @* Bounded-loading error (console#308): the queue read failed or blew its budget.
                   Name the failing source, keep the last good refresh time, offer a working Retry —
                   distinct from the "nothing pending" empty state below. *@
                <div class="console-home-inbox-error" role="alert" data-home-inbox-error>
                    <p data-home-inbox-error-title>Couldn't read the approval queue from @ServerName</p>
                    @if (!string.IsNullOrWhiteSpace(_inbox.Message))
                    {
                        <p class="console-muted" data-home-inbox-error-detail>@_inbox.Message</p>
                    }
                    <p class="console-muted" data-home-inbox-last-refreshed>@ConsoleFreshness.LastRefreshed(_lastInboxSuccessUtc)</p>
                    <button type="button" class="console-button console-button-secondary"
                            disabled="@_inboxBusy" data-home-inbox-retry @onclick="RefreshInboxAsync">
                        Retry
                    </button>
                </div>
            }
            else if (!_inbox.IsAllowed)
            {
                <p class="console-muted">
                    @(string.IsNullOrWhiteSpace(_inbox.Message)
                        ? OperateSectionPresentation.FallbackMessage(_inbox.Status)
                        : _inbox.Message)
                </p>
            }
            else
            {
                var snapshot = _inbox.Value ?? ApprovalInboxSnapshot.Empty;
                <div class="console-home-inbox-metrics" role="status" aria-live="polite">
                    <span class="approval-inbox-metric @(snapshot.AwaitingApprovalCount > 0 ? "is-actionable" : null)"
                          data-home-awaiting-count>
                        <strong>@snapshot.AwaitingApprovalCount</strong>
                        <span class="console-muted">awaiting approval</span>
                    </span>
                    <span class="approval-inbox-metric" data-home-total-count>
                        <strong>@snapshot.TotalCount</strong>
                        <span class="console-muted">in the queue</span>
                    </span>
                </div>
                <p class="console-muted">
                    @if (snapshot.AwaitingApprovalCount > 0)
                    {
                        <text>Agent-proposed operations are waiting for your decision.</text>
                    }
                    else
                    {
                        <text>No agent-proposed operations are awaiting a decision right now.</text>
                    }
                </p>
            }
            <a class="console-button-link console-home-inbox-cta" href="/inbox" data-open-inbox>Open inbox</a>
        </section>

        @* ── Recent activity (operation timeline) ────────────────────────────── *@
        <section class="console-panel console-home-inbox" aria-labelledby="home-activity-heading">
            <div>
                <p class="console-kicker">Information</p>
                <h2 id="home-activity-heading">Recent activity</h2>
            </div>
            <p class="console-muted">
                The agent-operation timeline — what agents proposed and did, with status from
                the deploy-control lifecycle — surfaces on the Operate observability surface and
                the release timeline. A single consolidated cross-source activity feed is on the
                roadmap.
            </p>
            <ConsoleDiagnostics DisclosureLabel="Roadmap" IssueRef="#193" />
            <a class="console-button-link console-home-inbox-cta" href="/operate/observability" data-open-activity>
                View observability
            </a>
        </section>
    </div>

    @if (_profiles.Count == 0)
    {
        <article class="console-panel console-state-info console-environment-summary" role="note" aria-labelledby="home-first-run">
            <div>
                <p class="console-kicker">Get started</p>
                <h2 id="home-first-run">Connect to a Honua Server</h2>
                <p class="console-muted">No environment is set up yet. Point this Console at your Honua Server over HTTPS and sign in to start working.</p>
            </div>
            <a class="console-button" href="/environments/new">@(Host.SupportsNativeTransports ? "Add environment" : "Connect to a server")</a>
        </article>
    }

    <div class="console-panel-grid console-panel-grid-wide">
        @foreach (var area in ConsoleRouteMap.Areas)
        {
            <a class="console-panel console-area-link" href="@area.Path">
                <span class="console-kicker">@area.WorkflowBoundary</span>
                <h2>@area.Name</h2>
                <p>@area.Description</p>
            </a>
        }
    </div>

    <section class="console-panel console-environment-summary" aria-labelledby="home-environments">
        <div>
            <p class="console-kicker">Environment profiles</p>
            <h2 id="home-environments">Native-ready profile state</h2>
            <p class="console-muted">The same shell can bind to browser HTTP flows or native gRPC and mTLS-capable environments.</p>
        </div>
        <div class="console-profile-count">@_profiles.Count</div>
        <a class="console-button-link" href="/environments">Manage</a>
    </section>
</section>

@code {
    /// <summary>
    /// The bounded-loading budget for the inbox-band read (console#308). A parameter so tests can
    /// drive the timeout path deterministically without waiting the full ~5s.
    /// </summary>
    [Parameter]
    public TimeSpan LoadBudget { get; set; } = ConsoleReadBudget.Default;

    private IReadOnlyList<ConsoleEnvironmentProfile> _profiles = Array.Empty<ConsoleEnvironmentProfile>();

    private bool _inboxLoaded;
    private bool _inboxBusy;
    private OperateSectionResult<ApprovalInboxSnapshot> _inbox =
        OperateSectionResult<ApprovalInboxSnapshot>.Allowed(ApprovalInboxSnapshot.Empty);

    // Last successful band read — persisted across failures so the paused pill / error card shows
    // the last good time rather than "never" (console#308/#309).
    private DateTimeOffset? _lastInboxSuccessUtc;
    private string? _serverName;

    // Resolved optionally (console#292): a host without the realtime seam registered renders
    // the honest Manual state instead of failing DI at render time. Never a required inject.
    private IConsoleProposalRealtimeClient? _realtime;

    // The concrete realtime client also implements the shared capability seam (console#293): its
    // state-changed event flips the freshness pill on reconnect without a reload (console#309).
    private IConsoleRealtimeCapabilityClient? _realtimeState;

    private bool RealtimeConnected => _realtime?.IsConnected == true;

    private bool FallbackEngaged => _realtime?.IsFallbackEngaged == true;

    private string ServerName =>
        string.IsNullOrWhiteSpace(_serverName) ? "the connected honua-server" : _serverName;

    protected override async Task OnInitializedAsync()
    {
        _profiles = await Profiles.ListProfilesAsync();
        await ResolveServerNameAsync();

        // The landing shows the queue at a glance; the inbox page is where operators filter and
        // act. Both read the same first-class server proposals API, under the same ~5s budget.
        await RefreshInboxAsync();

        // Console#292 scope item 4: subscribe to the same admin-hub proposals group the
        // approval inbox uses so a pending/resolved event refreshes this band live, with no
        // polling. Best-effort twice over: an unregistered client means Manual mode (no
        // subscription to open), and a failed connect leaves the band on its one-shot read.
        _realtime = ServiceProvider.GetService<IConsoleProposalRealtimeClient>();
        if (_realtime is not null)
        {
            _realtime.ProposalChanged += OnProposalEvent;
            if (_realtime is IConsoleRealtimeCapabilityClient capability)
            {
                _realtimeState = capability;
                _realtimeState.ConnectionStateChanged += OnConnectionStateChanged;
            }

            await _realtime.StartAsync();
        }
    }

    private async Task ResolveServerNameAsync()
    {
        try
        {
            var active = await Profiles.GetActiveProfileAsync();
            if (active is { DisplayName.Length: > 0 })
            {
                _serverName = active.DisplayName;
            }
        }
        catch
        {
            // The source name is a nicety, never a gate: fall back to the generic server label.
        }
    }

    private async Task RefreshInboxAsync()
    {
        if (_inboxBusy)
        {
            return;
        }

        _inboxBusy = true;
        try
        {
            // Bounded loading (console#308): a hung or failing read resolves to an explicit,
            // retryable Unavailable error rather than sticking on "Reading the work queue…".
            _inbox = await ConsoleReadBudget.RunAsync(
                token => Inbox.GetInboxAsync(cancellationToken: token),
                LoadBudget,
                $"The approval queue did not respond within {LoadBudget.TotalSeconds:0} seconds.");

            if (_inbox.IsAllowed)
            {
                _lastInboxSuccessUtc = DateTimeOffset.UtcNow;
            }
        }
        finally
        {
            _inboxBusy = false;
            _inboxLoaded = true;
        }
    }

    private void OnProposalEvent(ConsoleProposalEvent evt)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshInboxAsync();
            StateHasChanged();
        });
    }

    // A realtime connect / reconnect / degrade: re-render so the freshness pill reflects the true
    // connection state immediately, with no proposal event and no page reload (console#309).
    private void OnConnectionStateChanged(ConsoleRealtimeConnectionState state) =>
        _ = InvokeAsync(StateHasChanged);

    public ValueTask DisposeAsync()
    {
        // The realtime client is an app-lifetime singleton shared across circuits; only detach
        // this page's handler (mirrors ApprovalInboxPage's disposal note).
        if (_realtime is not null)
        {
            _realtime.ProposalChanged -= OnProposalEvent;
        }

        if (_realtimeState is not null)
        {
            _realtimeState.ConnectionStateChanged -= OnConnectionStateChanged;
        }

        return ValueTask.CompletedTask;
    }
}
