@page "/"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IConsoleEnvironmentProfileStore Profiles
@inject IServiceProvider Services
@implements IDisposable

<section class="console-page console-home-page">
    @if (!_loaded)
    {
        <div class="console-page-heading"><h1>Welcome</h1></div>
        <p role="status">Reading the selected environment…</p>
    }
    else if (_profile is { } profile)
    {
        <div class="console-page-heading">
            <h1>Welcome</h1>
            <p data-home-environment><strong>@profile.DisplayName</strong> · @profile.ServerBaseUri.GetLeftPart(UriPartial.Authority)</p>
            <p>Review pending decisions, inspect server health, or choose a service in the tree to browse its layers.</p>
        </div>
        @Operations
        <section class="console-panel console-home-administration" aria-labelledby="home-admin-heading">
            <h2 id="home-admin-heading">Administration</h2>
            <ConsoleHomeWorkAreas />
            <a href="/environments">Manage environments</a>
        </section>
        <details class="console-home-setup"><summary>Set up another deployment</summary><ConsoleHomeSetup /></details>
    }
    else
    {
        <div class="console-page-heading">
            <h1>Start with your data. Keep the conversation.</h1>
            <p>Connect Honua, add a dataset, and build a map. Work through the forms or ask in the shared conversation.</p>
        </div>
        <ConsoleHomeSetup />
        @if (!_environment.IsAllowed || _profileCount > 0)
        {
            <article class="console-panel console-state-info" data-home-connection-state role="status">
                <h2>Review the selected environment</h2>
                <p>The active environment could not be read. Choose a saved environment or review its connection.</p>
                <a class="console-button-link" href="/environments">Review connection</a>
                <button class="console-button console-button-secondary" type="button" @onclick="RefreshEnvironmentAsync">Retry</button>
            </article>
        }
        <details class="console-home-operations">
            <summary>Operations, approvals and work areas</summary>
            @Operations
            <h2>Work areas</h2>
            <ConsoleHomeWorkAreas />
        </details>
    }
</section>

@code {
    [Parameter] public TimeSpan LoadBudget { get; set; } = ConsoleReadBudget.Default;
    private readonly CancellationTokenSource _lifetime = new();
    private AuthenticationStateProvider? _authentication;
    private OperateSectionResult<HomeEnvironment> _environment =
        OperateSectionResult<HomeEnvironment>.Allowed(new(null, 0));
    private ConsoleEnvironmentProfile? _profile;
    private int _profileCount;
    private int _generation;
    private bool _loaded;
    private bool _disposed;

    private RenderFragment Operations => @<div class="console-home-workload" @key="ConsoleEnvironmentAuthority.From(_profile)">
        <ConsoleHomeWorkQueue LoadBudget="LoadBudget" ServerName="@(_profile?.DisplayName ?? "the selected server")" />
        <section aria-labelledby="home-health-heading">
            <h2 id="home-health-heading">Health and findings</h2>
            <OpsSummaryStrip LoadBudget="LoadBudget" />
        </section>
        <ConsoleHomeRecentVisits />
    </div>;

    protected override async Task OnInitializedAsync()
    {
        Profiles.ActiveProfileChanged += OnProfileChanged;
        _authentication = Services.GetService<AuthenticationStateProvider>();
        if (_authentication is not null) _authentication.AuthenticationStateChanged += OnAuthenticationChanged;
        await RefreshEnvironmentAsync();
    }

    private async Task RefreshEnvironmentAsync()
    {
        if (_disposed) return;
        var generation = ++_generation;
        _loaded = false;
        await InvokeAsync(StateHasChanged);
        var environment = await ConsoleReadBudget.RunAsync(ReadEnvironmentAsync, LoadBudget,
            "The selected environment could not be read.", _lifetime.Token);
        if (_disposed || generation != _generation) return;
        _environment = environment;
        _profile = environment.IsAllowed ? environment.Value?.Profile : null;
        _profileCount = environment.Value?.ProfileCount ?? 0;
        _loaded = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task<OperateSectionResult<HomeEnvironment>> ReadEnvironmentAsync(CancellationToken token)
    {
        var profiles = await Profiles.ListProfilesAsync(token);
        var active = await Profiles.GetActiveProfileAsync(token);
        return OperateSectionResult<HomeEnvironment>.Allowed(new(active, profiles.Count));
    }

    private void OnProfileChanged() => _ = InvokeAsync(RefreshEnvironmentAsync);

    private void OnAuthenticationChanged(Task<AuthenticationState> state)
    {
        if (_disposed) return;
        Profiles.ActiveProfileChanged -= OnProfileChanged;
        Profiles.ActiveProfileChanged += OnProfileChanged;
        _ = InvokeAsync(RefreshEnvironmentAsync);
    }

    private sealed record HomeEnvironment(ConsoleEnvironmentProfile? Profile, int ProfileCount);

    public void Dispose()
    {
        _disposed = true;
        Profiles.ActiveProfileChanged -= OnProfileChanged;
        if (_authentication is not null) _authentication.AuthenticationStateChanged -= OnAuthenticationChanged;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
