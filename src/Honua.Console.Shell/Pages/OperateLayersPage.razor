@page "/operate/layers"
@inject IOperateTransitionDataSource OperateData
@inject IServiceProvider Services
@inject NavigationManager Navigation

<section class="console-page">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Layers">
            <p>Browse layer geometry, service exposure and canonical resources.</p>
        </ConsolePageHeading>
        <ConsoleAgentContext Context="@AgentContext" />
        <ConsolePanel Title="Layers" HeadingId="layers-list-heading">@LayerList</ConsolePanel>
    }
    else
    {
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Layers</p>
        <h1>Layers</h1>
        <p>Layer rows show service exposure and point back to the canonical resource that owns metadata.</p>
    </div>

        @LayerList
    }
</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = "/operate/layers",
        Entities = _layers.Select(row => ConsoleAgentEntity.ForLayer(row.Layer)).Distinct().ToArray(),
        Unsaved = new() { PendingOperationCount = _loading ? 1 : 0 }
    };



    private RenderFragment LayerList => @<text>
    <OperateCapabilityStateList States="@_states" />

    @if (_layers.Count == 0 && _states.Count == 0)
    {
        <EmptyState Area="operate" Subject="layers" />
    }
    else
    {
        <ConsoleTableRegion Class="console-table-wrap" Label="Published service layers">
            <table class="console-table">
                <thead>
                    <tr>
                        <th>Layer ID</th>
                        <th>Name</th>
                        <th>Service</th>
                        <th>Geometry</th>
                        <th>Canonical resource</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _layers)
                    {
                        <tr data-layer-id="@row.Layer.LayerId" data-service-id="@row.Service.Name">
                            <td><a href="@Navigation.ToConsoleHref(ConsoleAgentRoutes.ForEntity(ConsoleAgentEntity.ForLayer(row.Layer)))">@row.Layer.LayerId</a></td>
                            <td>
                                @if (V4Enabled)
                                {
                                    <ConsoleNameIdentifier Name="@row.Layer.Name" Identifier="@row.Layer.CanonicalResourceId"
                                                           Href="@Navigation.ToConsoleHref(ConsoleAgentRoutes.ForEntity(ConsoleAgentEntity.ForLayer(row.Layer)))" />
                                }
                                else
                                {
                                    @row.Layer.Name
                                }
                            </td>
                            <td><a href="@Navigation.ToConsoleHref(ConsoleAgentRoutes.ForEntity(ConsoleAgentEntity.ForService(row.Service.Name)))">@row.Service.DisplayName</a></td>
                            <td>@row.Layer.Geometry</td>
                            <td>
                                <a href="@Navigation.ToConsoleHref($"/operate/resources/{Uri.EscapeDataString(row.Layer.CanonicalResourceId)}")">@row.Layer.CanonicalResourceName</a>
                                <small>@row.Layer.CanonicalResourceId</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </ConsoleTableRegion>
    }
</text>;

    private IReadOnlyList<(OperateServiceDetail Service, OperateServiceLayerProjection Layer)> _layers =
        Array.Empty<(OperateServiceDetail, OperateServiceLayerProjection)>();
    private bool _loading = true;
    private IReadOnlyList<OperateCapabilityState> _states = Array.Empty<OperateCapabilityState>();

    protected override async Task OnInitializedAsync()
    {
        var view = await OperateData.GetLayersViewAsync();
        _layers = view.Services
            .SelectMany(service => service.Layers.Select(layer => (service, layer)))
            .ToArray();
        _states = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Layers", "Services");
        _loading = false;
    }
}
