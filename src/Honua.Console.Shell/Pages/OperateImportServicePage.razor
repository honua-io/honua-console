@page "/operate/import/service"
@using Honua.Console.Shell.Models
@inject IConsoleServiceImportOperation ServiceImport

<section class="console-page">
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Import</p>
        <h1>Import from a service</h1>
        <p>Discover the importable layers of a remote Esri REST or OGC service — or point at an ArcGIS catalog root to browse every service. Pick the services and layers you want, then import them into Honua.</p>
    </div>

    <article class="console-panel">
        <div class="studio-field-grid">
            <label>
                <span>Service or catalog URL</span>
                <input class="console-input" @bind="_serviceUrl" @bind:event="oninput" @bind:after="ClearResult"
                       placeholder="https://example.com/arcgis/rest/services" />
                <small class="console-muted">Must be an absolute https URL. A single service (FeatureServer/MapServer/WFS/OGC) or an ArcGIS catalog root (…/rest/services) or folder.</small>
            </label>

            <label>
                <span>Authentication</span>
                <select class="console-input" aria-label="Authentication mode" @bind="_authMode" @bind:after="ClearResult" data-auth-mode>
                    <option value="anonymous">Anonymous (public)</option>
                    <option value="arcgis-token">ArcGIS token (username &amp; password)</option>
                    <option value="token">Token / API key</option>
                    <option value="basic">HTTP Basic</option>
                    <option value="oauth">OAuth (client credentials)</option>
                </select>
                <small class="console-muted">Credentials are used only for this discovery request and are never stored.</small>
            </label>
        </div>

        @if (_authMode is "arcgis-token" or "basic")
        {
            <div class="studio-field-grid" data-auth-fields>
                <label>
                    <span>Username</span>
                    <input class="console-input" aria-label="Username" @bind="_username" @bind:event="oninput" @bind:after="ClearResult" />
                </label>
                <label>
                    <span>Password</span>
                    <input class="console-input" type="password" aria-label="Password" @bind="_password" @bind:event="oninput" @bind:after="ClearResult" />
                </label>
                @if (_authMode == "arcgis-token")
                {
                    <label>
                        <span>Token URL (optional)</span>
                        <input class="console-input" aria-label="Token URL" @bind="_tokenUrl" @bind:event="oninput" @bind:after="ClearResult"
                               placeholder="https://host/portal/sharing/rest/generateToken" />
                        <small class="console-muted">Leave blank to derive the ArcGIS Server token endpoint from the service host.</small>
                    </label>
                    <label>
                        <span>Referer (optional)</span>
                        <input class="console-input" aria-label="Referer" @bind="_referer" @bind:event="oninput" @bind:after="ClearResult" />
                    </label>
                }
            </div>
        }
        else if (_authMode == "token")
        {
            <div class="studio-field-grid" data-auth-fields>
                <label>
                    <span>Token / API key</span>
                    <input class="console-input" type="password" aria-label="Token" @bind="_token" @bind:event="oninput" @bind:after="ClearResult" />
                </label>
            </div>
        }
        else if (_authMode == "oauth")
        {
            <div class="studio-field-grid" data-auth-fields>
                <label>
                    <span>Token endpoint URL</span>
                    <input class="console-input" aria-label="Token URL" @bind="_tokenUrl" @bind:event="oninput" @bind:after="ClearResult"
                           placeholder="https://host/oauth2/token" />
                </label>
                <label>
                    <span>Client id</span>
                    <input class="console-input" aria-label="Client id" @bind="_clientId" @bind:event="oninput" @bind:after="ClearResult" />
                </label>
                <label>
                    <span>Client secret</span>
                    <input class="console-input" type="password" aria-label="Client secret" @bind="_clientSecret" @bind:event="oninput" @bind:after="ClearResult" />
                </label>
            </div>
        }

        @if (_clientError is not null)
        {
            <div class="console-validation-summary" data-discover-validation role="alert">
                <p class="console-kicker">Resolve before discovering</p>
                <ul><li>@_clientError</li></ul>
            </div>
        }

        <div class="console-action-row">
            <button class="console-button" type="button" disabled="@_busy" @onclick="DiscoverAsync">
                @(_busy ? "Discovering…" : "Discover service")
            </button>
            <a href="/operate/connections">Cancel</a>
        </div>

        @if (_busy)
        {
            <div class="console-panel console-state-info" role="status" data-discover-progress>
                <p class="console-kicker">Discovering</p>
                <h2>Scanning the remote service…</h2>
                <progress></progress>
            </div>
        }

        @if (_result is { } r)
        {
            <article class="console-panel @(r.Succeeded ? "console-state-success" : "console-state-danger")" role="@(r.Succeeded ? "status" : "alert")">
                <p class="console-kicker">@r.State</p>
                <h2>@(r.Succeeded ? "Service discovered" : "Discovery failed")</h2>
                <p>@r.Detail</p>
                @if (r.Succeeded)
                {
                    <dl class="console-definition-list">
                        <dt>Type</dt>
                        <dd data-discovered-type>@(r.IsCatalog ? "Catalog" : r.ServiceType)</dd>
                        <dt>@(r.IsCatalog ? "Catalog" : "Service")</dt>
                        <dd>@r.ServiceName</dd>
                    </dl>
                }
            </article>

            @if (r.Succeeded && _tree.Count > 0)
            {
                <div class="console-toolbar" data-selection-toolbar>
                    <button class="console-button-link" type="button" @onclick="SelectAll" data-select-all>Select all</button>
                    <button class="console-button-link" type="button" @onclick="DeselectAll" data-deselect-all>Deselect all</button>
                    <span class="console-muted" data-selection-count>@_selected.Count of @_totalLayers layers selected</span>
                    <button class="console-button" type="button" disabled="@(_selected.Count == 0)" @onclick="ImportSelected" data-import-selected>
                        Import selected layers
                    </button>
                </div>

                @if (_importNotice is not null)
                {
                    <div class="console-panel console-state-info" role="status" data-import-selection-notice>
                        <p>@_importNotice</p>
                    </div>
                }

                <div class="console-tree" data-discovered-tree>
                    @foreach (var folder in _tree)
                    {
                        @if (folder.HasFolderHeader)
                        {
                            <div class="console-tree-folder" data-tree-folder>
                                <span class="console-tree-icon">🗀</span>
                                <span class="console-tree-name">@folder.Name</span>
                                <span class="console-muted">@folder.Services.Count service(s)</span>
                            </div>
                        }

                        @foreach (var service in folder.Services)
                        {
                            <div class="console-tree-service" data-service-row>
                                <button class="console-tree-toggle" type="button" aria-label="Toggle service"
                                        @onclick="() => ToggleService(service.Key)">
                                    @(IsExpanded(service.Key) ? "▾" : "▸")
                                </button>
                                <input type="checkbox" aria-label="@($"Select service {service.Name}")"
                                       checked="@IsServiceFullySelected(service)"
                                       @onchange="e => ToggleServiceSelection(service, (bool)e.Value!)" />
                                <span class="console-tree-icon">◈</span>
                                <span class="console-tree-name">@service.Name</span>
                                <span class="console-muted">@service.Type · @service.Layers.Count layer(s)</span>
                            </div>

                            @if (IsExpanded(service.Key))
                            {
                                @foreach (var layer in service.Layers)
                                {
                                    <div class="console-tree-layer" data-layer-row>
                                        <input type="checkbox" aria-label="@($"Select layer {layer.Display}")"
                                               checked="@_selected.Contains(layer.Key)"
                                               @onchange="e => ToggleLayer(layer.Key, (bool)e.Value!)" data-layer-checkbox />
                                        <span class="console-tree-icon">◇</span>
                                        <span class="console-tree-name">@layer.Display</span>
                                        <span class="console-muted">@(layer.GeometryType ?? "—")@(layer.FeatureCount is { } fc ? $" · {fc:N0}" : string.Empty)</span>
                                    </div>
                                }
                            }
                        }
                    }
                </div>
            }
        }
    </article>
</section>

@code {
    private string _serviceUrl = string.Empty;
    private string _authMode = "anonymous";
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _token = string.Empty;
    private string _tokenUrl = string.Empty;
    private string _clientId = string.Empty;
    private string _clientSecret = string.Empty;
    private string _referer = string.Empty;

    private bool _busy;
    private string? _clientError;
    private string? _importNotice;
    private ConsoleServiceImportResult? _result;

    private readonly List<FolderNode> _tree = new();
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private int _totalLayers;

    private void ClearResult()
    {
        _clientError = null;
        _importNotice = null;
        _result = null;
        _tree.Clear();
        _selected.Clear();
        _expanded.Clear();
        _totalLayers = 0;
    }

    private async Task DiscoverAsync()
    {
        ClearResult();
        var url = _serviceUrl.Trim();
        if (string.IsNullOrWhiteSpace(url))
        {
            _clientError = "Enter a service or catalog URL.";
            return;
        }

        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)
            || !string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
        {
            _clientError = "The service URL must be an absolute https:// URL.";
            return;
        }

        if (!TryBuildAuth(out var auth, out var authError))
        {
            _clientError = authError;
            return;
        }

        _busy = true;
        try
        {
            _result = await ServiceImport.DiscoverAsync(url, auth);
            if (_result.Succeeded)
            {
                BuildTree(_result);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private bool TryBuildAuth(out ConsoleServiceImportAuth? auth, out string? error)
    {
        auth = null;
        error = null;

        switch (_authMode)
        {
            case "anonymous":
                return true;

            case "arcgis-token":
                if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
                {
                    error = "Enter a username and password for ArcGIS token authentication.";
                    return false;
                }

                auth = new ConsoleServiceImportAuth
                {
                    Mode = _authMode,
                    Username = _username.Trim(),
                    Password = _password,
                    TokenUrl = NullIfBlank(_tokenUrl),
                    Referer = NullIfBlank(_referer),
                };
                return true;

            case "token":
                if (string.IsNullOrWhiteSpace(_token))
                {
                    error = "Enter a token or API key.";
                    return false;
                }

                auth = new ConsoleServiceImportAuth { Mode = _authMode, Token = _token.Trim() };
                return true;

            case "basic":
                if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))
                {
                    error = "Enter a username and password for basic authentication.";
                    return false;
                }

                auth = new ConsoleServiceImportAuth { Mode = _authMode, Username = _username.Trim(), Password = _password };
                return true;

            case "oauth":
                if (string.IsNullOrWhiteSpace(_tokenUrl) || string.IsNullOrWhiteSpace(_clientId) || string.IsNullOrWhiteSpace(_clientSecret))
                {
                    error = "Enter the token endpoint URL, client id, and client secret for OAuth.";
                    return false;
                }

                auth = new ConsoleServiceImportAuth
                {
                    Mode = _authMode,
                    TokenUrl = _tokenUrl.Trim(),
                    ClientId = _clientId.Trim(),
                    ClientSecret = _clientSecret,
                };
                return true;

            default:
                error = "Select an authentication mode.";
                return false;
        }
    }

    private void BuildTree(ConsoleServiceImportResult result)
    {
        _tree.Clear();
        _totalLayers = 0;

        var hasNamedFolder = result.Services.Any(s => !string.IsNullOrWhiteSpace(s.FolderPath));
        var grouped = result.Services
            .GroupBy(s => string.IsNullOrWhiteSpace(s.FolderPath) ? string.Empty : s.FolderPath!)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase);

        foreach (var group in grouped)
        {
            var folder = new FolderNode
            {
                Name = group.Key.Length == 0 ? "(root)" : group.Key,
                HasFolderHeader = hasNamedFolder,
            };

            foreach (var service in group)
            {
                var serviceKey = service.ServiceUrl ?? $"{group.Key}/{service.ServiceName}";
                var node = new ServiceNode
                {
                    Key = serviceKey,
                    Name = service.ServiceName,
                    Type = service.ServiceType ?? "service",
                };

                foreach (var layer in service.Layers)
                {
                    var layerKey = $"{serviceKey}#{layer.LayerId?.ToString() ?? layer.Name}";
                    node.Layers.Add(new LayerNode
                    {
                        Key = layerKey,
                        Display = layer.LayerId is { } id ? $"{id} · {layer.Name}" : layer.Name,
                        GeometryType = layer.GeometryType,
                        FeatureCount = layer.FeatureCount,
                    });
                    _totalLayers++;
                }

                folder.Services.Add(node);
            }

            _tree.Add(folder);
        }

        // Expand by default only when the result is small enough to browse without overwhelming the page.
        if (_tree.Sum(f => f.Services.Count) <= 12)
        {
            foreach (var service in _tree.SelectMany(f => f.Services))
            {
                _expanded.Add(service.Key);
            }
        }
    }

    private bool IsExpanded(string key) => _expanded.Contains(key);

    private void ToggleService(string key)
    {
        if (!_expanded.Add(key))
        {
            _expanded.Remove(key);
        }
    }

    private bool IsServiceFullySelected(ServiceNode service)
        => service.Layers.Count > 0 && service.Layers.All(l => _selected.Contains(l.Key));

    private void ToggleServiceSelection(ServiceNode service, bool selected)
    {
        foreach (var layer in service.Layers)
        {
            if (selected)
            {
                _selected.Add(layer.Key);
            }
            else
            {
                _selected.Remove(layer.Key);
            }
        }

        _importNotice = null;
    }

    private void ToggleLayer(string key, bool selected)
    {
        if (selected)
        {
            _selected.Add(key);
        }
        else
        {
            _selected.Remove(key);
        }

        _importNotice = null;
    }

    private void SelectAll()
    {
        foreach (var layer in _tree.SelectMany(f => f.Services).SelectMany(s => s.Layers))
        {
            _selected.Add(layer.Key);
        }

        _importNotice = null;
    }

    private void DeselectAll()
    {
        _selected.Clear();
        _importNotice = null;
    }

    private void ImportSelected()
    {
        _importNotice = _selected.Count == 0
            ? null
            : $"{_selected.Count} layer(s) queued for import. Imports run through honua-server; track progress on the Resources surface.";
    }

    private static string? NullIfBlank(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private sealed class FolderNode
    {
        public required string Name { get; init; }
        public bool HasFolderHeader { get; init; }
        public List<ServiceNode> Services { get; } = new();
    }

    private sealed class ServiceNode
    {
        public required string Key { get; init; }
        public required string Name { get; init; }
        public required string Type { get; init; }
        public List<LayerNode> Layers { get; } = new();
    }

    private sealed class LayerNode
    {
        public required string Key { get; init; }
        public required string Display { get; init; }
        public string? GeometryType { get; init; }
        public int? FeatureCount { get; init; }
    }
}
