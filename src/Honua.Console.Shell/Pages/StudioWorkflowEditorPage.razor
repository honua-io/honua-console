@page "/studio/workflows/new"
@page "/studio/workflows/{DraftId}"
@inject IStudioWorkflowPackageClient Workflows
@inject NavigationManager Navigation

<section class="console-page workflow-page">
    <div class="console-page-heading">
        <p class="console-kicker">Studio workflow.package</p>
        <h1>Workflow Editor</h1>
        <p>Author a unified GP/ETL workflow package, dry-run it through job contracts, save a versioned content item, and publish to job runner or an eligible process endpoint.</p>
    </div>

    @if (_binding is not null)
    {
        <article class="console-panel workflow-binding-state">
            <div class="console-panel-heading">
                <div>
                    <p class="console-kicker">@_binding.State</p>
                    <h2>@_binding.Surface</h2>
                </div>
            </div>
            <p class="console-muted">@_binding.Detail</p>
            <dl class="console-definition-list">
                <dt>Contract</dt>
                <dd>@_binding.Contract</dd>
            </dl>
            <a class="console-button-link console-button-secondary" href="/studio">Studio Home</a>
        </article>
    }
    else if (_loading)
    {
        <article class="console-panel">
            <h2>Loading workflow draft</h2>
            <p class="console-muted">Resolving the Studio workflow package projection.</p>
        </article>
    }
    else if (_draft is null)
    {
        <article class="console-panel">
            <h2>Workflow draft unavailable</h2>
            <p class="console-muted">The requested workflow draft was not found or cannot be opened in this workspace.</p>
            <a class="console-button-link" href="/studio/workflows/new">Create Workflow Draft</a>
        </article>
    }
    else
    {
        <header class="workflow-editor-header" aria-label="Workflow package header">
            <span class="workflow-editor-glyph" aria-hidden="true">⇋</span>
            <input class="console-input workflow-title-input" aria-label="Workflow name" @bind="_draft.Title" @bind:event="oninput" />
            <span class="console-status workflow-badge-draft">@DraftStatusBadge(_draft)</span>
            <span class="console-status @(IsGraphValid ? string.Empty : "console-status-warning") workflow-badge-dag">@(IsGraphValid ? "DAG valid · acyclic" : "DAG needs a sink")</span>
            <div class="workflow-editor-header-spacer"></div>
            <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="DryRunAsync">Run once</button>
            <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="SaveAsync">Save draft</button>
            <button class="console-button" type="button" disabled="@_busy" @onclick="PublishAsync">Publish…</button>
            <a class="console-button-link console-button-secondary" href="/studio">Studio Home</a>
        </header>

        <nav class="console-tab-row workflow-tab-row" aria-label="Workflow editor sections">
            <a href="#workflow-graph" class="active">Graph</a>
            <a href="#workflow-schedule">Schedule</a>
            <a href="#workflow-secrets">Secrets</a>
            <a href="#workflow-history">Run history</a>
            <a href="#workflow-package">Package · raw</a>
        </nav>

        <div class="workflow-editor-shell">
            <aside class="workflow-sidebar" aria-label="Node palette">
                <div class="workflow-section-heading">
                    <p class="console-kicker">Step palette</p>
                    <h2>Palette</h2>
                    <small class="console-muted">drag onto canvas</small>
                </div>
                <div class="workflow-palette">
                    @foreach (var definition in _nodeDefinitions)
                    {
                        <button class="workflow-palette-item workflow-palette-item-@definition.Category" type="button" @onclick="() => AddNode(definition.Type)">
                            <span class="workflow-step-glyph" aria-hidden="true">@StepGlyph(definition.Category, definition.Type)</span>
                            <strong>@definition.Label</strong>
                            <span>@definition.Category</span>
                            <small>@definition.Summary</small>
                        </button>
                    }
                </div>
            </aside>

            <main class="workflow-main">
                <section class="console-panel workflow-package-panel" aria-label="Package metadata">
                    <div class="workflow-form-grid">
                        <label>
                            <span>Title</span>
                            <input class="console-input" @bind="_draft.Title" @bind:event="oninput" />
                        </label>
                        <label>
                            <span>Summary</span>
                            <textarea class="console-input" rows="3" @bind="_draft.Summary" @bind:event="oninput"></textarea>
                        </label>
                        <dl class="console-definition-list">
                            <dt>Package</dt>
                            <dd>@_draft.PackageType</dd>
                            <dt>Schema</dt>
                            <dd>@_draft.SchemaVersion</dd>
                            <dt>Content item</dt>
                            <dd>@(string.IsNullOrWhiteSpace(_draft.ContentItemId) ? "not saved" : _draft.ContentItemId)</dd>
                            <dt>Current version</dt>
                            <dd>@DescribeCurrentVersion(_draft)</dd>
                        </dl>
                    </div>
                </section>

                <section id="workflow-graph" class="workflow-canvas-band" aria-label="Workflow graph">
                    <div class="workflow-section-heading">
                        <p class="console-kicker">Graph</p>
                        <h2>Sources, Transforms, Sinks</h2>
                    </div>
                    <div class="workflow-canvas" role="group" aria-label="Workflow DAG canvas">
                        <svg class="workflow-canvas-edges" viewBox="0 0 1000 340" preserveAspectRatio="none" aria-hidden="true">
                            <defs>
                                <marker id="workflow-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#141414"></path>
                                </marker>
                                <marker id="workflow-arrow-failure" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#c03b2b"></path>
                                </marker>
                                <pattern id="workflow-dotgrid" width="20" height="20" patternUnits="userSpaceOnUse">
                                    <circle cx="2" cy="2" r="1" fill="#dcdcdc"></circle>
                                </pattern>
                            </defs>
                            <rect width="1000" height="340" fill="url(#workflow-dotgrid)"></rect>
                            @foreach (var edge in _draft.Edges)
                            {
                                var path = EdgePath(edge);
                                if (path is not null)
                                {
                                    var failure = edge.Kind == StudioWorkflowContractValues.EdgeKindFailure;
                                    <path class="workflow-canvas-edge workflow-canvas-edge-@edge.Kind"
                                          d="@path"
                                          fill="none"
                                          stroke="@(failure ? "#c03b2b" : "#141414")"
                                          stroke-width="@(failure ? "1.4" : "1.6")"
                                          stroke-dasharray="@(failure ? "4 4" : null)"
                                          marker-end="@(failure ? "url(#workflow-arrow-failure)" : "url(#workflow-arrow)")"></path>
                                }
                            }
                        </svg>
                        <div class="workflow-canvas-nodes">
                            @foreach (var node in _draft.Nodes)
                            {
                                var selected = string.Equals(node.Id, SelectedNode?.Id, StringComparison.Ordinal);
                                <button class="workflow-node workflow-node-@node.Category @(node.Type.Contains("failure", StringComparison.Ordinal) ? "workflow-node-failure" : string.Empty) @(selected ? "workflow-node-selected" : string.Empty)"
                                        type="button"
                                        style="@NodeStyle(node)"
                                        @onclick="() => SelectNode(node.Id)">
                                    <span class="workflow-node-glyph" aria-hidden="true">@StepGlyph(node.Category, node.Type)</span>
                                    <strong>@node.Label</strong>
                                    <small>@node.Type</small>
                                </button>
                            }
                        </div>
                    </div>
                    <ol class="workflow-edge-list" aria-label="Workflow edges">
                        @foreach (var edge in _draft.Edges)
                        {
                            <li class="workflow-edge workflow-edge-@edge.Kind">
                                <span>@edge.Kind</span>
                                <strong>@GetNodeLabel(edge.FromNodeId) to @GetNodeLabel(edge.ToNodeId)</strong>
                                <small>@edge.FromPort -> @edge.ToPort: @edge.Label</small>
                            </li>
                        }
                    </ol>
                </section>

                <div class="workflow-lower-grid">
                    <section class="console-panel" aria-label="Node inspector">
                        <div class="workflow-section-heading">
                            <p class="console-kicker">Inspector</p>
                            <h2>@(SelectedNode?.Label ?? "No node selected")</h2>
                        </div>
                        @if (SelectedNode is not null)
                        {
                            <label>
                                <span>Node label</span>
                                <input class="console-input" @bind="SelectedNode.Label" @bind:event="oninput" />
                            </label>
                            <dl class="console-definition-list">
                                <dt>Type</dt>
                                <dd>@SelectedNode.Type</dd>
                                <dt>Inputs</dt>
                                <dd>@FormatPorts(SelectedNode.InputPorts)</dd>
                                <dt>Outputs</dt>
                                <dd>@FormatPorts(SelectedNode.OutputPorts)</dd>
                            </dl>
                            <ul class="workflow-compact-list">
                                @foreach (var entry in SelectedNode.Configuration)
                                {
                                    <li>
                                        <span>@entry.Key</span>
                                        <strong>@entry.Value</strong>
                                    </li>
                                }
                            </ul>
                        }
                    </section>

                    <section id="workflow-secrets" class="console-panel" aria-label="Parameters and invocation validation">
                        <div class="workflow-section-heading">
                            <p class="console-kicker">Parameters · secrets</p>
                            <h2>Invocation Contract</h2>
                        </div>
                        <div class="workflow-table">
                            @foreach (var parameter in _draft.Parameters)
                            {
                                <div class="workflow-table-row">
                                    <input class="console-input" aria-label="Parameter name" @bind="parameter.Name" @bind:event="oninput" />
                                    <select class="console-input" aria-label="Parameter type" @bind="parameter.Type">
                                        @foreach (var type in ParameterTypes)
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </select>
                                    <label class="workflow-checkbox">
                                        <input type="checkbox" @bind="parameter.Required" />
                                        <span>Required</span>
                                    </label>
                                    <input class="console-input" aria-label="Parameter default value" @bind="parameter.DefaultValue" @bind:event="oninput" />
                                </div>
                            }
                        </div>
                        <button class="console-button console-button-secondary" type="button" @onclick="AddParameter">Add Parameter</button>
                        <ul class="workflow-compact-list">
                            @foreach (var validation in ParameterValidationPreview)
                            {
                                <li>
                                    <span>@(validation.Valid ? "Ready" : "Blocked")</span>
                                    <strong>@validation.ParameterName</strong>
                                    <small>@validation.Message</small>
                                </li>
                            }
                        </ul>
                    </section>

                    <section id="workflow-schedule" class="console-panel" aria-label="Schedule and worker profile">
                        <div class="workflow-section-heading">
                            <p class="console-kicker">Runtime</p>
                            <h2>Schedule And Worker</h2>
                        </div>
                        <div class="workflow-form-grid workflow-form-grid-compact">
                            <label>
                                <span>Schedule mode</span>
                                <select class="console-input" @bind="_draft.Schedule.Mode">
                                    <option value="manual">manual</option>
                                    <option value="cron">cron</option>
                                    <option value="event">event</option>
                                </select>
                            </label>
                            <label>
                                <span>Cron</span>
                                <input class="console-input" @bind="_draft.Schedule.Cron" @bind:event="oninput" />
                            </label>
                            <label>
                                <span>Time zone</span>
                                <input class="console-input" @bind="_draft.Schedule.TimeZone" @bind:event="oninput" />
                            </label>
                            <label>
                                <span>Worker profile</span>
                                <select class="console-input" @bind="_draft.WorkerProfile.ProfileId">
                                    <option value="standard-geospatial">standard-geospatial</option>
                                    <option value="memory-optimized">memory-optimized</option>
                                    <option value="high-throughput">high-throughput</option>
                                </select>
                            </label>
                            <label>
                                <span>Runtime</span>
                                <input class="console-input" @bind="_draft.WorkerProfile.Runtime" @bind:event="oninput" />
                            </label>
                            <label>
                                <span>CPU</span>
                                <input class="console-input" type="number" min="1" max="32" @bind="_draft.WorkerProfile.Cpu" />
                            </label>
                            <label>
                                <span>Memory GB</span>
                                <input class="console-input" type="number" min="2" max="256" @bind="_draft.WorkerProfile.MemoryGb" />
                            </label>
                            <label>
                                <span>Max parallelism</span>
                                <input class="console-input" type="number" min="1" max="64" @bind="_draft.WorkerProfile.MaxParallelism" />
                            </label>
                        </div>
                    </section>

                    <section class="console-panel" aria-label="Retry and failure behavior">
                        <div class="workflow-section-heading">
                            <p class="console-kicker">Failure behavior</p>
                            <h2>Retries And Failure Edges</h2>
                        </div>
                        <div class="workflow-form-grid workflow-form-grid-compact">
                            <label>
                                <span>Attempts</span>
                                <input class="console-input" type="number" min="0" max="10" @bind="_draft.RetryPolicy.MaxAttempts" />
                            </label>
                            <label>
                                <span>Backoff seconds</span>
                                <input class="console-input" type="number" min="0" max="3600" @bind="_draft.RetryPolicy.BackoffSeconds" />
                            </label>
                            <label>
                                <span>Failure mode</span>
                                <select class="console-input" @bind="_draft.RetryPolicy.FailureMode">
                                    <option value="route-failure-edges">route-failure-edges</option>
                                    <option value="fail-fast">fail-fast</option>
                                    <option value="quarantine-artifacts">quarantine-artifacts</option>
                                </select>
                            </label>
                        </div>
                        <ul class="workflow-compact-list">
                            @foreach (var edge in _draft.Edges.Where(edge => edge.Kind == StudioWorkflowContractValues.EdgeKindFailure))
                            {
                                <li>
                                    <span>@edge.Label</span>
                                    <strong>@GetNodeLabel(edge.FromNodeId) to @GetNodeLabel(edge.ToNodeId)</strong>
                                </li>
                            }
                        </ul>
                    </section>
                </div>
            </main>

            <aside class="workflow-inspector" aria-label="Publish and dry-run review">
                <section class="console-panel">
                    <div class="workflow-section-heading">
                        <p class="console-kicker">Publication intent</p>
                        <h2>Review</h2>
                    </div>
                    <div class="workflow-form-grid workflow-form-grid-compact">
                        <label>
                            <span>Mode</span>
                            <select class="console-input" @bind="_draft.PublicationIntent.Mode">
                                <option value="@StudioWorkflowContractValues.PublicationModeBatchWorkflow">Batch workflow</option>
                                <option value="@StudioWorkflowContractValues.PublicationModeScheduledJob">Scheduled job</option>
                                <option value="@StudioWorkflowContractValues.PublicationModeProcessEndpoint">Process endpoint</option>
                            </select>
                        </label>
                        <label>
                            <span>Visibility</span>
                            <select class="console-input" @bind="_draft.PublicationIntent.Visibility">
                                <option value="private">private</option>
                                <option value="org">org</option>
                                <option value="group">group</option>
                            </select>
                        </label>
                        <label>
                            <span>Route slug</span>
                            <input class="console-input" @bind="_draft.PublicationIntent.RouteSlug" @bind:event="oninput" />
                        </label>
                        <label class="workflow-checkbox">
                            <input type="checkbox" @bind="_draft.PublicationIntent.ExposeInvocationEndpoint" />
                            <span>Expose invocation endpoint</span>
                        </label>
                        <label class="workflow-checkbox">
                            <input type="checkbox" @bind="_draft.PublicationIntent.RequiresApproval" />
                            <span>Require approval before publish</span>
                        </label>
                    </div>
                    <p class="console-status">@EndpointEligibilityText</p>
                    @if (_lastSave is not null)
                    {
                        @if (!string.IsNullOrWhiteSpace(_lastSave.VersionId))
                        {
                            <dl class="console-definition-list">
                                <dt>Saved version</dt>
                                <dd>@_lastSave.VersionId</dd>
                                <dt>Contract</dt>
                                <dd>@_lastSave.Contract</dd>
                            </dl>
                        }
                        else
                        {
                            <p class="console-status">Save blocked: server validation requires attention</p>
                        }
                        @if (_lastSave.ValidationIssues.Count > 0)
                        {
                            <ul class="workflow-compact-list">
                                @foreach (var issue in _lastSave.ValidationIssues)
                                {
                                    <li>
                                        <span>@issue.Severity</span>
                                        <strong>@issue.Scope</strong>
                                        <small>@issue.Message</small>
                                    </li>
                                }
                            </ul>
                        }
                    }
                </section>

                <section class="console-panel">
                    <div class="workflow-section-heading">
                        <p class="console-kicker">Output schema</p>
                        <h2>Before Publish</h2>
                    </div>
                    @foreach (var schema in _draft.OutputSchemas)
                    {
                        <div class="workflow-schema">
                            <strong>@schema.Name</strong>
                            <span>@GetNodeLabel(schema.SinkNodeId)</span>
                            <ul>
                                @foreach (var field in schema.Fields)
                                {
                                    <li>@field.Name <small>@field.Type@(field.Nullable ? "?" : string.Empty)</small></li>
                                }
                            </ul>
                        </div>
                    }
                </section>

                <section class="console-panel">
                    <div class="workflow-section-heading">
                        <p class="console-kicker">Dry run</p>
                        <h2>Sample Evidence</h2>
                    </div>
                    @if (_lastDryRun is null)
                    {
                        <p class="console-muted">Run a sample execution to inspect logs, artifacts, and output schema before publishing.</p>
                    }
                    else
                    {
                        <dl class="console-definition-list">
                            <dt>Status</dt>
                            <dd>@_lastDryRun.Status</dd>
                            @if (_lastDryRun.SampleRows > 0)
                            {
                                <dt>Rows</dt>
                                <dd>@_lastDryRun.SampleRows</dd>
                            }
                            @if (HasDryRunJobEvidence(_lastDryRun))
                            {
                                <dt>Job</dt>
                                <dd><a href="@_lastDryRun.OperateJobUrl">@_lastDryRun.JobId</a></dd>
                                <dt>Events</dt>
                                <dd><a href="@_lastDryRun.OperateEventsUrl">Open event evidence</a></dd>
                            }
                        </dl>
                        <ul class="workflow-compact-list">
                            @foreach (var log in _lastDryRun.Logs)
                            {
                                <li><span>log</span><strong>@log</strong></li>
                            }
                        </ul>
                        <ul class="workflow-compact-list">
                            @foreach (var artifact in _lastDryRun.Artifacts)
                            {
                                <li><span>artifact</span><strong>@artifact</strong></li>
                            }
                        </ul>
                    }
                </section>

                <section class="console-panel">
                    <div class="workflow-section-heading">
                        <p class="console-kicker">Publish</p>
                        <h2>Job Monitor</h2>
                    </div>
                    @if (_lastPublish is null)
                    {
                        <p class="console-muted">Publish after review to queue the server-owned job runner and publication record.</p>
                    }
                    else
                    {
                        @if (IsBlockedPublish(_lastPublish))
                        {
                            <p class="console-status">Publish blocked: package validation requires attention</p>
                        }
                        <dl class="console-definition-list">
                            <dt>Status</dt>
                            <dd>@_lastPublish.Status</dd>
                            <dt>Mode</dt>
                            <dd>@_lastPublish.Mode</dd>
                            @if (!string.IsNullOrWhiteSpace(_lastPublish.PublicationId))
                            {
                                <dt>Publication</dt>
                                <dd>@_lastPublish.PublicationId</dd>
                            }
                            @if (HasPublishJobEvidence(_lastPublish))
                            {
                                <dt>Job</dt>
                                <dd><a href="@_lastPublish.OperateJobUrl">@_lastPublish.JobId</a></dd>
                                <dt>Events</dt>
                                <dd><a href="@_lastPublish.OperateEventsUrl">Open event evidence</a></dd>
                            }
                            <dt>Endpoint</dt>
                            <dd>@(_lastPublish.InvocationEndpoint ?? "not exposed")</dd>
                        </dl>
                        @if (_lastPublish.ValidationIssues.Count > 0)
                        {
                            <ul class="workflow-compact-list">
                                @foreach (var issue in _lastPublish.ValidationIssues)
                                {
                                    <li>
                                        <span>@issue.Severity</span>
                                        <strong>@issue.Scope</strong>
                                        <small>@issue.Message</small>
                                    </li>
                                }
                            </ul>
                        }
                        @if (_lastPublish.ParameterValidation.Count > 0)
                        {
                            <ul class="workflow-compact-list">
                                @foreach (var validation in _lastPublish.ParameterValidation)
                                {
                                    <li>
                                        <span>@(validation.Valid ? "Ready" : "Blocked")</span>
                                        <strong>@validation.ParameterName</strong>
                                        <small>@validation.Message</small>
                                    </li>
                                }
                            </ul>
                        }
                    }
                </section>

                <section id="workflow-history" class="console-panel workflow-run-history" aria-label="Workflow run history">
                    <div class="workflow-section-heading">
                        <p class="console-kicker">Run history</p>
                        <h2>Queued, Running, Failed, Succeeded</h2>
                    </div>
                    @if (_runHistory?.BindingState is not null)
                    {
                        <p class="console-status">@_runHistory.BindingState.Detail</p>
                    }
                    else if (_runHistory is null || _runHistory.Runs.Count == 0)
                    {
                        <p class="console-muted">No runs yet. Dry-run or publish this workflow to record execution history, rejected rows, artifacts, and provenance links.</p>
                    }
                    else
                    {
                        <ol class="workflow-run-list">
                            @foreach (var run in _runHistory.Runs)
                            {
                                <li class="workflow-run-item workflow-run-@run.Status">
                                    <div class="workflow-run-row">
                                        <span class="workflow-run-status">@DescribeRunStatus(run)</span>
                                        <strong>@run.Trigger</strong>
                                        <small>@run.Mode</small>
                                    </div>
                                    <dl class="console-definition-list">
                                        <dt>Run</dt>
                                        <dd>@run.RunId</dd>
                                        @if (run.ProcessedRows > 0)
                                        {
                                            <dt>Processed rows</dt>
                                            <dd>@run.ProcessedRows</dd>
                                        }
                                        @if (run.RejectedRows > 0)
                                        {
                                            <dt>Rejected rows</dt>
                                            <dd>@run.RejectedRows</dd>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(run.OperateJobUrl))
                                        {
                                            <dt>Job</dt>
                                            <dd><a href="@run.OperateJobUrl">@(string.IsNullOrWhiteSpace(run.JobId) ? "Open job" : run.JobId)</a></dd>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(run.ProvenanceUrl))
                                        {
                                            <dt>Provenance</dt>
                                            <dd><a href="@run.ProvenanceUrl">Content item history</a></dd>
                                        }
                                    </dl>
                                    @if (run.Artifacts.Count > 0)
                                    {
                                        <ul class="workflow-compact-list">
                                            @foreach (var artifact in run.Artifacts)
                                            {
                                                <li><span>artifact</span><strong>@artifact</strong></li>
                                            }
                                        </ul>
                                    }
                                </li>
                            }
                        </ol>
                    }
                </section>

                <section id="workflow-package" class="console-panel workflow-package-raw" aria-label="Workflow package contract">
                    <div class="workflow-section-heading">
                        <p class="console-kicker">Package · raw</p>
                        <h2>Generated Contract</h2>
                    </div>
                    <p class="console-muted">Inspectable summary of the generated workflow package projection before save or publish.</p>
                    <dl class="console-definition-list">
                        <dt>Package</dt>
                        <dd>@_draft.PackageType</dd>
                        <dt>Schema</dt>
                        <dd>@_draft.SchemaVersion</dd>
                        <dt>Nodes</dt>
                        <dd>@_draft.Nodes.Count</dd>
                        <dt>Edges</dt>
                        <dd>@_draft.Edges.Count</dd>
                        <dt>Parameters</dt>
                        <dd>@_draft.Parameters.Count</dd>
                        <dt>Output schemas</dt>
                        <dd>@_draft.OutputSchemas.Count</dd>
                    </dl>
                </section>
            </aside>
        </div>
    }
</section>

@code {
    private static readonly string[] ParameterTypes = ["string", "date", "number", "boolean", "geometry"];

    [Parameter]
    public string? DraftId { get; set; }

    private bool _loading = true;
    private bool _busy;
    private StudioWorkflowPackageDraft? _draft;
    private StudioWorkflowBindingState? _binding;
    private IReadOnlyList<StudioWorkflowNodeDefinition> _nodeDefinitions = [];
    private string? _activeDraftRouteId;
    private string? _selectedNodeId;
    private StudioWorkflowSaveResult? _lastSave;
    private StudioWorkflowDryRunResult? _lastDryRun;
    private StudioWorkflowPublishResult? _lastPublish;
    private StudioWorkflowRunHistory? _runHistory;
    private string? _savedDraftFingerprint;

    private StudioWorkflowNode? SelectedNode =>
        _draft?.Nodes.FirstOrDefault(node => string.Equals(node.Id, _selectedNodeId, StringComparison.Ordinal)) ??
        _draft?.Nodes.FirstOrDefault();

    private IReadOnlyList<StudioWorkflowParameterValidation> ParameterValidationPreview =>
        _draft is null
            ? []
            : _draft.Parameters.Select(parameter => new StudioWorkflowParameterValidation
            {
                ParameterName = string.IsNullOrWhiteSpace(parameter.Name) ? "unnamed" : parameter.Name,
                Type = parameter.Type,
                Required = parameter.Required,
                Valid = !string.IsNullOrWhiteSpace(parameter.Name) && ParameterTypes.Contains(parameter.Type),
                Message = !string.IsNullOrWhiteSpace(parameter.Name) && ParameterTypes.Contains(parameter.Type)
                    ? "Valid for dry-run, scheduled job, and invocation endpoint binding."
                    : "Parameter must declare a name and supported type."
            }).ToArray();

    private string EndpointEligibilityText
    {
        get
        {
            if (_draft is null)
            {
                return "Endpoint eligibility unavailable";
            }

            var requested = _draft.PublicationIntent.ExposeInvocationEndpoint ||
                _draft.PublicationIntent.Mode == StudioWorkflowContractValues.PublicationModeProcessEndpoint;

            if (!requested)
            {
                return "Invocation endpoint not requested";
            }

            return ParameterValidationPreview.All(validation => validation.Valid)
                ? "Endpoint eligible: parameter validation passes"
                : "Endpoint blocked: parameter validation requires attention";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var draftRouteId = string.IsNullOrWhiteSpace(DraftId) ? "new" : DraftId;
        if (!string.Equals(_activeDraftRouteId, draftRouteId, StringComparison.Ordinal))
        {
            ClearOperationState();
            _activeDraftRouteId = draftRouteId;
        }

        // Single bound/blocked load: the server-backed client returns the node palette and the draft, or a
        // missing-binding state when workflow data cannot bind to honua-server (#1185).
        var context = await Workflows.OpenEditorAsync(DraftId);
        _binding = context.BindingState;
        _nodeDefinitions = context.NodeDefinitions;
        _draft = context.Draft;
        _selectedNodeId = _draft?.Nodes.FirstOrDefault()?.Id;
        _savedDraftFingerprint = _draft is null
            ? null
            : StudioWorkflowPackageDraftContent.CreateFingerprint(_draft);
        _loading = false;

        await RefreshRunHistoryAsync();
    }

    // Loads the execution history for the saved content item so the editor surfaces queued/running/failed/
    // succeeded runs, rejected rows, artifacts, and provenance links (#17). A never-saved draft has no content
    // item, so this short-circuits to an empty history rather than probing the server.
    private async Task RefreshRunHistoryAsync()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_draft.ContentItemId))
        {
            _runHistory = StudioWorkflowRunHistory.Empty;
            return;
        }

        _runHistory = await Workflows.ListRunHistoryAsync(_draft.ContentItemId);
    }

    private async Task SaveAsync()
    {
        if (_draft is null)
        {
            return;
        }

        _busy = true;
        try
        {
            _lastSave = await Workflows.SaveVersionAsync(_draft, "Saved from Studio workflow editor.");
            if (_lastSave.BindingState is not null)
            {
                _binding = _lastSave.BindingState;
                return;
            }

            // A save that fails server validation creates no version. Leave the draft dirty (do not refresh
            // the fingerprint or move the route) so a later publish cannot reuse a stale prior version and
            // silently drop the current edits; the validation issues render in-place from _lastSave.
            if (!SaveProducedVersion(_lastSave))
            {
                return;
            }

            _savedDraftFingerprint = StudioWorkflowPackageDraftContent.CreateFingerprint(_draft);
            NavigateToPersistedDraft();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DryRunAsync()
    {
        if (_draft is null)
        {
            return;
        }

        _busy = true;
        try
        {
            // Dry-run/publish operate on an immutable server version; snapshot dirty edits first so the run
            // reflects the current draft and reuses that version instead of creating a redundant one.
            if (NeedsSaveBeforePublish() && !await EnsureSavedAsync("Saved before workflow dry-run."))
            {
                return;
            }

            _lastDryRun = await Workflows.DryRunAsync(_draft);
            if (_lastDryRun.BindingState is not null)
            {
                _binding = _lastDryRun.BindingState;
                return;
            }

            await RefreshRunHistoryAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PublishAsync()
    {
        if (_draft is null)
        {
            return;
        }

        _busy = true;
        try
        {
            if (NeedsSaveBeforePublish() && !await EnsureSavedAsync("Saved before workflow publication."))
            {
                return;
            }

            _lastPublish = await Workflows.PublishAsync(_draft);
            if (_lastPublish.BindingState is not null)
            {
                _binding = _lastPublish.BindingState;
                return;
            }

            _savedDraftFingerprint = StudioWorkflowPackageDraftContent.CreateFingerprint(_draft);
            await RefreshRunHistoryAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // Saves a version before a dry-run/publish. Returns false when the save could not bind (surfaces the
    // blocked state) or failed server validation (no version created), so the caller stops before issuing
    // the dependent server call against a stale or non-existent version.
    private async Task<bool> EnsureSavedAsync(string changeNote)
    {
        _lastSave = await Workflows.SaveVersionAsync(_draft!, changeNote);
        if (_lastSave.BindingState is not null)
        {
            _binding = _lastSave.BindingState;
            return false;
        }

        // No version means the save failed server validation: keep the draft dirty (do not refresh the
        // fingerprint) and report failure so dry-run/publish do not proceed on a stale prior version.
        if (!SaveProducedVersion(_lastSave))
        {
            return false;
        }

        _savedDraftFingerprint = StudioWorkflowPackageDraftContent.CreateFingerprint(_draft!);
        return true;
    }

    // A save produced a durable immutable version only when the server returned a version id; a validation
    // failure carries issues with no version id (and no binding state) and must not be treated as clean.
    private static bool SaveProducedVersion(StudioWorkflowSaveResult save) =>
        save.BindingState is null && !string.IsNullOrWhiteSpace(save.VersionId);

    private void NavigateToPersistedDraft()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_draft.ContentItemId))
        {
            return;
        }

        // A new package gets its server id on the first save; move the route off "new" so refresh/bookmark
        // resolves the persisted draft. Existing drafts stay put.
        if (!string.Equals(_activeDraftRouteId, _draft.ContentItemId, StringComparison.Ordinal))
        {
            Navigation.NavigateTo($"/studio/workflows/{_draft.ContentItemId}", replace: true);
        }
    }

    private void ClearOperationState()
    {
        _lastSave = null;
        _lastDryRun = null;
        _lastPublish = null;
        _runHistory = null;
        _binding = null;
    }

    private static string DescribeRunStatus(StudioWorkflowRunHistoryEntry run) =>
        StudioWorkflowRunStatus.IsFailure(run.Status) ? "Failed" : run.Status;

    private static bool HasDryRunJobEvidence(StudioWorkflowDryRunResult dryRun) =>
        !string.IsNullOrWhiteSpace(dryRun.OperateJobUrl) &&
        !string.IsNullOrWhiteSpace(dryRun.OperateEventsUrl);

    private bool NeedsSaveBeforePublish() =>
        _draft is not null &&
        (string.IsNullOrWhiteSpace(_draft.CurrentVersionId) ||
            !string.Equals(
                _savedDraftFingerprint,
                StudioWorkflowPackageDraftContent.CreateFingerprint(_draft),
                StringComparison.Ordinal));

    // CurrentVersionId is set only by an in-session save (it pins the draft to a version known to match the
    // current graph). A draft just loaded from the server has no such pin, but it may already have committed
    // versions: show the precise pinned id when present, otherwise the latest committed version number, and
    // "draft only" for a never-saved local draft.
    private static string DescribeCurrentVersion(StudioWorkflowPackageDraft draft)
    {
        if (!string.IsNullOrWhiteSpace(draft.CurrentVersionId))
        {
            return draft.CurrentVersionId;
        }

        return draft.VersionNumber > 0
            ? $"v{draft.VersionNumber} (latest committed)"
            : "draft only";
    }

    private static bool IsBlockedPublish(StudioWorkflowPublishResult publish) =>
        string.Equals(publish.Status, "blocked", StringComparison.OrdinalIgnoreCase);

    private static bool HasPublishJobEvidence(StudioWorkflowPublishResult publish) =>
        !string.IsNullOrWhiteSpace(publish.JobId) &&
        !string.IsNullOrWhiteSpace(publish.OperateJobUrl) &&
        !string.IsNullOrWhiteSpace(publish.OperateEventsUrl);

    private void SelectNode(string nodeId)
    {
        _selectedNodeId = nodeId;
    }

    private void AddNode(string nodeType)
    {
        if (_draft is null)
        {
            return;
        }

        var definition = _nodeDefinitions.FirstOrDefault(item => item.Type == nodeType);
        if (definition is null)
        {
            return;
        }

        var existingCount = _draft.Nodes.Count(node => node.Type == nodeType) + 1;
        var node = new StudioWorkflowNode
        {
            Id = $"{definition.Category}-{existingCount}-{_draft.Nodes.Count + 1}",
            Type = definition.Type,
            Category = definition.Category,
            Label = definition.Label,
            Column = _draft.Nodes.Count == 0 ? 1 : _draft.Nodes.Max(item => item.Column) + 1,
            Row = definition.Category == StudioWorkflowContractValues.NodeCategorySink ? 2 : 1,
            InputPorts = definition.InputPorts.ToList(),
            OutputPorts = definition.OutputPorts.ToList(),
            Configuration = new Dictionary<string, string>(StringComparer.Ordinal)
            {
                ["source"] = "console-palette",
                ["status"] = "draft"
            }
        };

        var previous = _draft.Nodes.LastOrDefault(item => item.Category != StudioWorkflowContractValues.NodeCategorySink);
        _draft.Nodes.Add(node);
        _selectedNodeId = node.Id;

        if (previous is not null && node.Category != StudioWorkflowContractValues.NodeCategorySource)
        {
            _draft.Edges.Add(new StudioWorkflowEdge
            {
                Id = $"edge-{previous.Id}-{node.Id}",
                FromNodeId = previous.Id,
                ToNodeId = node.Id,
                FromPort = previous.OutputPorts.FirstOrDefault() ?? "out",
                ToPort = node.InputPorts.FirstOrDefault() ?? "in",
                Kind = node.Type.Contains("failure", StringComparison.Ordinal)
                    ? StudioWorkflowContractValues.EdgeKindFailure
                    : StudioWorkflowContractValues.EdgeKindSuccess,
                Label = node.Category
            });
        }

        if (node.Category == StudioWorkflowContractValues.NodeCategorySink &&
            !_draft.OutputSchemas.Any(schema => schema.SinkNodeId == node.Id))
        {
            _draft.OutputSchemas.Add(new StudioWorkflowOutputSchema
            {
                Name = $"{node.Id}_schema",
                SinkNodeId = node.Id,
                Fields =
                [
                    new() { Name = "id", Type = "string", Nullable = false },
                    new() { Name = "status", Type = "string", Nullable = false }
                ]
            });
        }
    }

    private void AddParameter()
    {
        _draft?.Parameters.Add(new StudioWorkflowParameter
        {
            Name = $"param_{(_draft.Parameters.Count + 1):00}",
            Type = "string",
            Required = false,
            Description = "Workflow parameter."
        });
    }

    // Canvas geometry mirrors the design mockup's DAG layout: nodes flow left-to-right by column with a
    // small vertical fan-out for sink rows, so the SVG edge layer can draw arrowed connectors and the
    // failure edge as a dashed redline. The viewBox is 1000x340 to match the wireframe canvas.
    private const int CanvasColumnStride = 130;
    private const int CanvasRowStride = 90;
    private const int CanvasOriginX = 30;
    private const int CanvasOriginY = 40;
    private const int CanvasNodeWidth = 110;
    private const int CanvasNodeHeight = 70;

    private static int NodeX(StudioWorkflowNode node) => CanvasOriginX + Math.Max(0, node.Column - 1) * CanvasColumnStride;

    private static int NodeY(StudioWorkflowNode node) => CanvasOriginY + Math.Max(0, node.Row - 1) * CanvasRowStride;

    private static string NodeStyle(StudioWorkflowNode node) =>
        $"left:{NodeX(node)}px;top:{NodeY(node)}px;";

    // Builds the SVG path for an edge between the two positioned nodes. Failure edges curve below the chain;
    // success edges are straight connectors. Returns null when an endpoint cannot be resolved.
    private string? EdgePath(StudioWorkflowEdge edge)
    {
        var from = _draft?.Nodes.FirstOrDefault(node => node.Id == edge.FromNodeId);
        var to = _draft?.Nodes.FirstOrDefault(node => node.Id == edge.ToNodeId);
        if (from is null || to is null)
        {
            return null;
        }

        var x1 = NodeX(from) + CanvasNodeWidth;
        var y1 = NodeY(from) + (CanvasNodeHeight / 2);
        var x2 = NodeX(to);
        var y2 = NodeY(to) + (CanvasNodeHeight / 2);

        if (edge.Kind == StudioWorkflowContractValues.EdgeKindFailure)
        {
            var midY = Math.Max(y1, y2) + 70;
            return $"M {x1} {y1} C {x1} {midY}, {x2} {midY}, {x2} {y2}";
        }

        return $"M {x1} {y1} L {x2} {y2}";
    }

    // The graph is considered DAG-valid for the badge when it has at least one sink node; the authoritative
    // acyclicity/schema check happens server-side on save (#1185). This drives only the header badge text.
    private bool IsGraphValid =>
        _draft is not null &&
        _draft.Nodes.Any(node => node.Category == StudioWorkflowContractValues.NodeCategorySink);

    private static string DraftStatusBadge(StudioWorkflowPackageDraft draft) =>
        draft.VersionNumber > 0 ? $"draft v{draft.VersionNumber}" : "draft";

    // Maps a step to its design-mockup glyph. Source/transform/sink fall back to a category glyph; common
    // node types get their specific icon from the wireframe palette.
    private static string StepGlyph(string category, string type)
    {
        var key = type.ToLowerInvariant();
        if (key.Contains("trigger", StringComparison.Ordinal)) return "⏱";
        if (key.Contains("pull", StringComparison.Ordinal) || key.Contains("sftp", StringComparison.Ordinal)) return "⤴";
        if (key.Contains("read", StringComparison.Ordinal)) return "📦";
        if (key.Contains("validate", StringComparison.Ordinal)) return "✓";
        if (key.Contains("geocode", StringComparison.Ordinal)) return "📍";
        if (key.Contains("transform", StringComparison.Ordinal) || key.Contains("sql", StringComparison.Ordinal) || key.Contains("script", StringComparison.Ordinal)) return "🔀";
        if (key.Contains("publish", StringComparison.Ordinal)) return "🚀";
        if (key.Contains("notify", StringComparison.Ordinal) || key.Contains("failure", StringComparison.Ordinal)) return "📢";
        if (key.Contains("write", StringComparison.Ordinal) || key.Contains("append", StringComparison.Ordinal)) return "➕";
        if (key.Contains("ai", StringComparison.Ordinal)) return "🤖";

        return category switch
        {
            StudioWorkflowContractValues.NodeCategorySource => "⤴",
            StudioWorkflowContractValues.NodeCategorySink => "🚀",
            _ => "🔀"
        };
    }

    private string GetNodeLabel(string nodeId) =>
        _draft?.Nodes.FirstOrDefault(node => node.Id == nodeId)?.Label ?? nodeId;

    private static string FormatPorts(IReadOnlyCollection<string> ports) =>
        ports.Count == 0 ? "none" : string.Join(", ", ports);
}
