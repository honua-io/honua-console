@page "/studio/report"
@using Honua.Console.Shell.Models
@inject IStudioReportPublicationDataSource ReportData

<section class="console-page studio-report-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>Report builder</h1>
        <p>Author a server-owned report package — narrative, data bindings, Vega-Lite charts, map panels, tables, filters, version pinning, and responsive preview — then publish, share, and embed through the honua-server content publication registry. Open an existing report to inspect its server-owned route, manage visibility/embed, and pin (roll back) to an immutable version.</p>
    </div>

    <div class="console-toolbar">
        <button class="console-button" type="button" disabled="@_busy" @onclick="NewReport">New report</button>
        <form class="console-toolbar-inline" @onsubmit="OpenPublication" @formname="open-report-publication">
            <label class="studio-form-label">
                <span>Publication id</span>
                <input class="console-input" @bind="_publicationIdInput" placeholder="pub-report-..." />
            </label>
            <button class="console-button console-button-secondary" type="submit" disabled="@_busy">Open report publication</button>
        </form>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Report builder"
                          Title="Loading report publication"
                          Message="Reading the content publication registry from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Report publication registry is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else
    {
        @if (_states.Count > 0)
        {
            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Report binding</p>
                    <h2>Server Capability States</h2>
                </div>
                <div class="console-panel-grid">
                    @foreach (var state in _states)
                    {
                        <article class="console-panel">
                            <div class="console-panel-heading">
                                <div>
                                    <p class="console-kicker">@state.State</p>
                                    <h2>@state.Surface</h2>
                                </div>
                            </div>
                            <p class="console-muted">@state.Detail</p>
                            <dl class="console-definition-list">
                                <dt>Contract</dt>
                                <dd>@state.Contract</dd>
                            </dl>
                        </article>
                    }
                </div>
            </section>
        }

        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
        }

        @if (_editor is { } editor)
        {
            var readiness = StudioReportPublishEvaluator.Evaluate(editor);

            <div class="studio-report-editor" data-report-builder="report.package" data-report-status="@(editor.IsPublished ? "published" : "draft")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">@(editor.IsPublished ? $"{editor.PublicationId} · r{editor.ActiveRevision}" : "New report draft")</p>
                        <h2>@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled report" : editor.Title)</h2>
                    </div>
                    <span class="console-status @(editor.IsPublished ? string.Empty : "console-status-warning")">@(editor.IsPublished ? "published" : "draft")</span>
                </div>

                <div class="console-action-row">
                    <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="CloseEditor">Close</button>
                    <button class="console-button" type="button" disabled="@(_busy || !readiness.CanPublish)" @onclick="Publish">@(editor.IsPublished ? "Republish new version" : "Publish report")</button>
                </div>

                @if (!readiness.CanPublish)
                {
                    <article class="console-panel" aria-labelledby="report-publish-readiness-heading">
                        <p class="console-kicker">Pre-publish gate</p>
                        <h3 id="report-publish-readiness-heading">Resolve before publish</h3>
                        <ul class="studio-compact-list">
                            @foreach (var requirement in readiness.UnmetRequirements)
                            {
                                <li>@requirement</li>
                            }
                        </ul>
                    </article>
                }

                <div class="console-panel-grid">
                    <article class="console-panel">
                        <p class="console-kicker">Details</p>
                        <h3>Report</h3>
                        <label class="studio-form-label">
                            <span>Title</span>
                            <input class="console-input" @bind="editor.Title" placeholder="Monthly infrastructure report" />
                        </label>
                        <label class="studio-form-label">
                            <span>Route slug</span>
                            <input class="console-input" @bind="editor.RouteSlug" placeholder="monthly-infrastructure" disabled="@editor.IsPublished" />
                        </label>
                        <label class="studio-form-label">
                            <span>Description</span>
                            <textarea class="console-input" rows="2" @bind="editor.Description"></textarea>
                        </label>
                        <label class="studio-form-label">
                            <span>Narrative</span>
                            <textarea class="console-input" rows="3" @bind="editor.Narrative" placeholder="Context shown above the layout."></textarea>
                        </label>
                    </article>

                    <article class="console-panel">
                        <p class="console-kicker">Publish policy</p>
                        <h3>Visibility &amp; embed</h3>
                        <label class="studio-form-label">
                            <span>Visibility</span>
                            <select class="console-input" @bind="editor.Visibility">
                                @foreach (var visibility in StudioReportVisibilities.All)
                                {
                                    <option value="@visibility">@visibility</option>
                                }
                            </select>
                        </label>
                        <label class="studio-form-label-inline">
                            <input type="checkbox" @bind="editor.Embeddable" />
                            <span>Allow embedding</span>
                        </label>
                        @if (editor.IsPublished)
                        {
                            <div class="console-action-row">
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="UpdatePolicy">Update policy</button>
                            </div>
                        }
                    </article>

                    <article class="console-panel">
                        <p class="console-kicker">Responsive preview</p>
                        <h3>Breakpoint</h3>
                        <p class="console-muted">Preview the layout at a desktop and a narrow breakpoint before publish.</p>
                        <label class="studio-form-label">
                            <span>Preview breakpoint</span>
                            <select class="console-input" @bind="editor.PreviewBreakpoint">
                                @foreach (var breakpoint in StudioReportBreakpoints.All)
                                {
                                    <option value="@breakpoint">@breakpoint</option>
                                }
                            </select>
                        </label>
                        <div class="studio-report-preview" data-report-breakpoint="@editor.PreviewBreakpoint">
                            <span class="console-muted">@editor.Panels.Count panel(s) · @editor.PreviewBreakpoint layout</span>
                        </div>
                    </article>
                </div>

                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Data bindings</p>
                            <h3>Bindings</h3>
                        </div>
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="AddBinding">Add binding</button>
                    </div>

                    @if (editor.Bindings.Count == 0)
                    {
                        <p class="console-muted">No data bindings yet. Add at least one source ref panels can read, with an optional version pin.</p>
                    }

                    @foreach (var binding in editor.Bindings)
                    {
                        <div class="console-panel-grid" @key="binding">
                            <label class="studio-form-label"><span>Alias</span><input class="console-input" @bind="binding.Alias" placeholder="incidents" /></label>
                            <label class="studio-form-label"><span>Content ref</span><input class="console-input" @bind="binding.ContentRef" placeholder="content:incidents" /></label>
                            <label class="studio-form-label"><span>Version pin</span><input class="console-input" @bind="binding.VersionPin" placeholder="latest" /></label>
                            <div class="console-action-row">
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => RemoveBinding(binding)">Remove</button>
                            </div>
                        </div>
                    }
                </article>

                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Layout</p>
                            <h3>Panels</h3>
                        </div>
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="AddPanel">Add panel</button>
                    </div>

                    @if (editor.Panels.Count == 0)
                    {
                        <p class="console-muted">No panels yet. Add a chart (Vega-Lite), map, table, or filter panel.</p>
                    }

                    @foreach (var panel in editor.Panels)
                    {
                        <fieldset class="studio-report-panel" @key="panel">
                            <div class="console-panel-grid">
                                <label class="studio-form-label"><span>Title</span><input class="console-input" @bind="panel.Title" placeholder="Incidents by district" /></label>
                                <label class="studio-form-label">
                                    <span>Kind</span>
                                    <select class="console-input" @bind="panel.Kind">
                                        @foreach (var kind in StudioReportPanelKinds.All)
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select>
                                </label>
                                <label class="studio-form-label"><span>Binding alias</span><input class="console-input" @bind="panel.BindingAlias" placeholder="incidents" /></label>
                            </div>

                            @if (panel.IsChart)
                            {
                                <label class="studio-form-label">
                                    <span>Vega-Lite spec (JSON)</span>
                                    <textarea class="console-input studio-code" rows="8" @bind="panel.VegaLiteSpec"></textarea>
                                </label>
                            }

                            <div class="console-action-row">
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => RemovePanel(panel)">Remove panel</button>
                            </div>
                        </fieldset>
                    }
                </article>
            </div>
        }

        @if (_publication is { } publication)
        {
            <section class="console-section" data-report-publication="@publication.PublicationId">
                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">@($"{publication.PublicationId} · {publication.ActiveVersionId}")</p>
                            <h2>@(string.IsNullOrWhiteSpace(publication.ActiveTitle) ? "Untitled report" : publication.ActiveTitle)</h2>
                        </div>
                        <span class="console-status @(IsActive(publication) ? string.Empty : "console-status-warning")">@publication.Lifecycle</span>
                    </div>
                    <dl class="console-definition-list">
                        <dt>Route</dt>
                        <dd>@publication.RoutePath</dd>
                        <dt>Active revision</dt>
                        <dd>@($"r{publication.ActiveRevision}")</dd>
                        <dt>Visibility</dt>
                        <dd>@publication.Visibility</dd>
                        <dt>Embeddable</dt>
                        <dd>@(publication.Embeddable ? "yes" : "no")</dd>
                        @if (!string.IsNullOrWhiteSpace(publication.RollbackTargetVersionId))
                        {
                            <dt>Rolled back to</dt>
                            <dd>@publication.RollbackTargetVersionId</dd>
                        }
                        <dt>Updated</dt>
                        <dd>@publication.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</dd>
                    </dl>
                    <div class="console-action-row">
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => EditPublished(publication)">Edit / republish</button>
                    </div>
                </article>

                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Version pinning</p>
                            <h3>Immutable versions</h3>
                        </div>
                    </div>
                    @if (publication.Versions.Count == 0)
                    {
                        <p class="console-muted">No published versions yet.</p>
                    }
                    else
                    {
                        <div class="console-table-wrap">
                            <table class="console-table">
                                <thead>
                                    <tr>
                                        <th>Revision</th>
                                        <th>Version id</th>
                                        <th>Title</th>
                                        <th>Dependencies</th>
                                        <th>Active</th>
                                        <th>Published by</th>
                                        <th>Published</th>
                                        <th>Pin</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var version in publication.Versions)
                                    {
                                        <tr>
                                            <td>@($"r{version.Revision}")</td>
                                            <td><small>@version.VersionId</small></td>
                                            <td>@(string.IsNullOrWhiteSpace(version.Title) ? "—" : version.Title)</td>
                                            <td>@version.DependencyCount</td>
                                            <td>@(version.IsActive ? "active" : "—")</td>
                                            <td>@version.CreatedBy</td>
                                            <td>@version.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                            <td>
                                                @if (!version.IsActive)
                                                {
                                                    <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => Rollback(publication, version)">Roll back to r@(version.Revision)</button>
                                                }
                                                else
                                                {
                                                    <span class="console-muted">current</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            </section>
        }
        else if (_editor is null && _attempted)
        {
            <EmptyState Area="studio" Subject="report publications" />
        }
    }
</section>

@code {
    private bool _loading;
    private bool _busy;
    private bool _attempted;
    private string? _publicationIdInput;
    private StudioReportPublicationView? _publication;
    private StudioReportEditorState? _editor;
    private StudioReportCapabilityState? _bindingState;
    private IReadOnlyList<StudioReportCapabilityState> _states = [];
    private string? _status;
    private bool _statusFailed;

    [SupplyParameterFromQuery(Name = "publicationId")]
    public string? PublicationId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(PublicationId) && !_attempted)
        {
            _publicationIdInput = PublicationId;
            await LoadAsync(PublicationId);
        }
    }

    private void NewReport()
    {
        _editor = new StudioReportEditorState();
        _publication = null;
        _status = null;
        _statusFailed = false;
        _bindingState = null;
        _states = [];
    }

    private async Task OpenPublication()
    {
        if (string.IsNullOrWhiteSpace(_publicationIdInput))
        {
            return;
        }

        await LoadAsync(_publicationIdInput);
    }

    private async Task LoadAsync(string publicationId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _loading = true;
        _attempted = true;
        _editor = null;
        _status = null;
        _statusFailed = false;
        try
        {
            var result = await ReportData.LoadAsync(publicationId);
            _publication = result.Publication;
            ApplyStates(result.CapabilityStates);
        }
        finally
        {
            _busy = false;
            _loading = false;
        }
    }

    private void CloseEditor()
    {
        _editor = null;
        _status = null;
        _statusFailed = false;
    }

    private void EditPublished(StudioReportPublicationView publication)
    {
        // Reopen the published report's route/policy into an editable authoring state. The next publish is a
        // republish that advances the active route pointer; earlier versions stay immutable for rollback.
        _editor = new StudioReportEditorState
        {
            PublicationId = publication.PublicationId,
            RouteSlug = publication.RouteSlug,
            ActiveRevision = publication.ActiveRevision,
            Title = publication.ActiveTitle ?? string.Empty,
            Visibility = publication.Visibility,
            Embeddable = publication.Embeddable
        };
        _status = null;
        _statusFailed = false;
    }

    private void AddBinding() => _editor?.Bindings.Add(new StudioReportBindingEditor());

    private void RemoveBinding(StudioReportBindingEditor binding) => _editor?.Bindings.Remove(binding);

    private void AddPanel() =>
        _editor?.Panels.Add(new StudioReportPanelEditor { VegaLiteSpec = StudioReportChartSpec.DefaultBarChart() });

    private void RemovePanel(StudioReportPanelEditor panel) => _editor?.Panels.Remove(panel);

    private Task Publish() => RunCommandAsync(() => ReportData.PublishAsync(_editor!), keepEditor: true);

    private Task UpdatePolicy() =>
        RunCommandAsync(
            () => ReportData.UpdatePolicyAsync(_editor!.PublicationId!, _editor.Visibility, _editor.Embeddable, _editor.ETag),
            keepEditor: true);

    private Task Rollback(StudioReportPublicationView publication, StudioReportPublicationVersionView version) =>
        RunCommandAsync(() => ReportData.RollbackAsync(publication.PublicationId, version.VersionId), keepEditor: false);

    private async Task RunCommandAsync(Func<Task<StudioReportCommandResult>> command, bool keepEditor)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await command();
            _status = result.Message;
            _statusFailed = !result.Succeeded;

            if (result.Publication is not null)
            {
                _publication = result.Publication;
                _attempted = true;

                if (keepEditor && _editor is not null)
                {
                    // Reflect the new server identity/revision back into the editor so the next publish is a
                    // republish against the freshly advanced route pointer.
                    _editor.PublicationId = result.Publication.PublicationId;
                    _editor.RouteSlug = result.Publication.RouteSlug;
                    _editor.ActiveRevision = result.Publication.ActiveRevision;
                    _editor.Visibility = result.Publication.Visibility;
                    _editor.Embeddable = result.Publication.Embeddable;
                }
                else
                {
                    _editor = null;
                }
            }

            ApplyStates(result.Issue is null ? [] : [result.Issue]);
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsActive(StudioReportPublicationView publication) =>
        string.Equals(publication.Lifecycle, "active", StringComparison.OrdinalIgnoreCase);

    private void ApplyStates(IReadOnlyList<StudioReportCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
        _states = states
            .Where(state => !ReferenceEquals(state, _bindingState))
            .ToArray();
    }
}
