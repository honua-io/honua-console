@page "/studio/report"
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Validation
@inject IStudioReportPublicationDataSource ReportData

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have unsaved report changes. Leave this page and discard them?" />

<section class="console-page studio-report-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>Report builder</h1>
        <p>Author a server-owned report package — narrative, data bindings, Vega-Lite charts, map panels, tables, filters, version pinning, and responsive preview — then publish, share, and embed through the honua-server content publication registry. Open an existing report to inspect its server-owned route, manage visibility/embed, and pin (roll back) to an immutable version.</p>
    </div>

    <div class="console-toolbar">
        <button class="console-button" type="button" disabled="@_busy" @onclick="NewReport">New report</button>
        <form class="console-toolbar-inline" @onsubmit="OpenPublication" @formname="open-report-publication">
            <label class="studio-form-label">
                <span>Publication id</span>
                <input class="console-input" @bind="_publicationIdInput" placeholder="pub-report-..." />
            </label>
            <button class="console-button console-button-secondary" type="submit" disabled="@_busy">Open report publication</button>
        </form>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Report builder"
                          Title="Loading report publication"
                          Message="Reading the content publication registry from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Report publication registry is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else
    {
        @if (_states.Count > 0)
        {
            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Report binding</p>
                    <h2>Server Capability States</h2>
                </div>
                <div class="console-panel-grid">
                    @foreach (var state in _states)
                    {
                        <article class="console-panel">
                            <div class="console-panel-heading">
                                <div>
                                    <p class="console-kicker">@state.State</p>
                                    <h2>@state.Surface</h2>
                                </div>
                            </div>
                            <p class="console-muted">@state.Detail</p>
                            <dl class="console-definition-list">
                                <dt>Contract</dt>
                                <dd>@state.Contract</dd>
                            </dl>
                        </article>
                    }
                </div>
            </section>
        }

        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
        }

        @if (_editor is { } editor)
        {
            var readiness = StudioReportPublishEvaluator.Evaluate(editor);
            var selectedPanel = SelectedPanel(editor);

            <div class="studio-report-editor" data-report-builder="report.package" data-report-status="@(editor.IsPublished ? "published" : "draft")">
                @* Editor header bar — mirrors the mockup's name/badge/meta + responsive-preview + Publish row.
                   The mockup's Print preview / Export PDF affordances have no server contract yet, so the bar
                   carries only the real lifecycle actions (Close / Update policy / Publish) plus the live
                   responsive-preview breakpoint control. *@
                <div class="studio-report-bar">
                    <span class="studio-report-bar-icon" aria-hidden="true">&#9249;</span>
                    <input class="console-input studio-report-name"
                           @bind="editor.Title"
                           @bind:event="oninput"
                           @bind:after="OnEdit"
                           placeholder="q3-public-works-overview"
                           aria-label="Report title" />
                    <span class="console-status @(editor.IsPublished ? string.Empty : "console-status-warning")" data-report-status-badge="@(editor.IsPublished ? "published" : "draft")">@(editor.IsPublished ? $"published · r{editor.ActiveRevision}" : "draft")</span>
                    <span class="studio-report-bar-meta console-muted">@editor.Panels.Count panel(s) · @editor.Bindings.Count binding(s) · @editor.PreviewBreakpoint preview</span>
                    <span class="studio-report-bar-spacer"></span>
                    <select class="console-input studio-report-breakpoint" @bind="editor.PreviewBreakpoint" aria-label="Preview breakpoint">
                        @foreach (var breakpoint in StudioReportBreakpoints.All)
                        {
                            <option value="@breakpoint">@breakpoint preview</option>
                        }
                    </select>
                    <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="CloseEditor">Close</button>
                    @if (editor.IsPublished)
                    {
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="UpdatePolicy">Update policy</button>
                    }
                    <button class="console-button" type="button" disabled="@(_busy || !readiness.CanPublish || _validation.HasBlockingClientErrors)" @onclick="Publish">@(editor.IsPublished ? "Republish…" : "Publish…")</button>
                </div>

                @if (_validation.HasBlockingClientErrors)
                {
                    <article class="console-panel studio-report-gate" aria-labelledby="report-validation-heading">
                        <p class="console-kicker">Validation</p>
                        <h3 id="report-validation-heading">Resolve before publish</h3>
                        <ul class="studio-compact-list">
                            @foreach (var error in _validation.Summary.Where(e => e.IsBlocking))
                            {
                                <li>@error.Message</li>
                            }
                        </ul>
                    </article>
                }

                @if (!readiness.CanPublish)
                {
                    <article class="console-panel studio-report-gate" aria-labelledby="report-publish-readiness-heading">
                        <p class="console-kicker">Pre-publish gate</p>
                        <h3 id="report-publish-readiness-heading">Resolve before publish</h3>
                        <ul class="studio-compact-list">
                            @foreach (var requirement in readiness.UnmetRequirements)
                            {
                                <li>@requirement</li>
                            }
                        </ul>
                    </article>
                }

                @* Three-pane editor: outline · long-form page · inspector — matches the StudioReportEditor mockup. *@
                <div class="studio-report-panes" data-report-breakpoint="@editor.PreviewBreakpoint">
                    @* ----- Outline (left) ----- *@
                    <div class="studio-report-outline" data-report-outline>
                        <div class="studio-report-outline-head">
                            <h3>Outline</h3>
                            <button class="console-button console-button-secondary console-button-small" type="button" disabled="@_busy" @onclick="AddPanel">+ Panel</button>
                        </div>
                        <button type="button"
                                class="studio-report-outline-row studio-report-outline-row--section @(selectedPanel is null ? "is-selected" : string.Empty)"
                                @onclick="() => SelectPanel(null)">
                            <span class="studio-report-outline-label">@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled report" : editor.Title)</span>
                            <span class="tag">report</span>
                        </button>
                        @if (editor.Panels.Count == 0)
                        {
                            <p class="studio-report-outline-empty console-muted">No panels yet.</p>
                        }
                        @foreach (var panel in editor.Panels)
                        {
                            <button type="button"
                                    class="studio-report-outline-row studio-report-outline-row--item @(ReferenceEquals(panel, selectedPanel) ? "is-selected" : string.Empty)"
                                    @key="panel"
                                    @onclick="() => SelectPanel(panel)">
                                <span class="studio-report-outline-label">@PanelLabel(panel)</span>
                                <span class="tag">@panel.Kind</span>
                            </button>
                        }
                    </div>

                    @* ----- Long-form page (center) ----- *@
                    <div class="studio-report-page-scroll">
                        <article class="studio-report-page" data-report-page>
                            <p class="studio-report-section-eyebrow">@(editor.IsPublished ? $"{editor.PublicationId} · r{editor.ActiveRevision}" : "draft report")</p>
                            <h1 class="studio-report-page-title">@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled report" : editor.Title)</h1>

                            @if (!string.IsNullOrWhiteSpace(editor.Narrative))
                            {
                                <p class="studio-report-narrative">@editor.Narrative</p>
                            }
                            else
                            {
                                <p class="studio-report-narrative console-muted">Add narrative copy in the inspector to introduce this report.</p>
                            }

                            @if (editor.Panels.Count == 0)
                            {
                                <p class="console-muted">No panels yet. Add a chart (Vega-Lite), map, table, or filter panel from the outline.</p>
                            }

                            @{ var figure = 0; }
                            @foreach (var panel in editor.Panels)
                            {
                                figure++;
                                var isSelected = ReferenceEquals(panel, selectedPanel);
                                <figure class="studio-report-embed studio-report-embed--@panel.Kind @(isSelected ? "is-selected" : string.Empty)"
                                        @key="panel"
                                        data-report-embed="@panel.Kind"
                                        @onclick="() => SelectPanel(panel)">
                                    <figcaption class="studio-report-embed-head">
                                        <span class="tag">embedded @panel.Kind</span>
                                        <span class="console-muted">@PanelLabel(panel)@(string.IsNullOrWhiteSpace(panel.BindingAlias) ? string.Empty : $" · {panel.BindingAlias}")</span>
                                    </figcaption>
                                    @if (panel.Kind == StudioReportPanelKinds.Table)
                                    {
                                        <div class="console-table-wrap">
                                            <table class="console-table">
                                                <thead><tr><th>Field</th><th>Value</th></tr></thead>
                                                <tbody>
                                                    <tr><td>binding</td><td>@(string.IsNullOrWhiteSpace(panel.BindingAlias) ? "—" : panel.BindingAlias)</td></tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="studio-report-embed-body" data-report-embed-kind="@panel.Kind">
                                            <span class="console-muted">@panel.Kind panel</span>
                                        </div>
                                    }
                                    <figcaption class="studio-report-embed-caption console-muted">Figure @figure. @PanelLabel(panel).</figcaption>
                                </figure>
                            }
                        </article>
                    </div>

                    @* ----- Inspector (right) ----- *@
                    <div class="studio-report-inspector" data-report-inspector="@(selectedPanel is null ? "report" : "panel")">
                        @if (selectedPanel is { } sel)
                        {
                            <div class="studio-report-inspector-head">
                                <h3>Embedded · @sel.Kind</h3>
                                <p class="console-muted">@PanelLabel(sel)</p>
                            </div>
                            <div class="studio-report-inspector-body">
                                <section class="studio-report-fieldgroup">
                                    <p class="console-kicker">Source binding</p>
                                    <FieldStateRow State="FieldState.Input" Label="Title">
                                        <input class="console-input" @bind="sel.Title" @bind:after="OnEdit" placeholder="Parcels overview" />
                                    </FieldStateRow>
                                    <FieldStateRow State="FieldState.Input" Label="Kind">
                                        <select class="console-input" @bind="sel.Kind" @bind:after="OnEdit">
                                            @foreach (var kind in StudioReportPanelKinds.All)
                                            {
                                                <option value="@kind">@kind</option>
                                            }
                                        </select>
                                    </FieldStateRow>
                                    <FieldStateRow State="@(string.IsNullOrWhiteSpace(sel.BindingAlias) ? FieldState.Input : FieldState.Discovered)"
                                                   Label="Binding alias"
                                                   Hint="@(string.IsNullOrWhiteSpace(sel.BindingAlias) ? null : "resolved from data bindings")"
                                                   Errors="_validation.Errors(StudioReportFieldKeys.PanelBindingAlias(editor.Panels.IndexOf(sel)))">
                                        <input class="console-input" @bind="sel.BindingAlias" @bind:after="OnEdit" placeholder="incidents" />
                                    </FieldStateRow>
                                </section>
                                @if (sel.IsChart)
                                {
                                    <section class="studio-report-fieldgroup">
                                        <p class="console-kicker">Vega-Lite spec</p>
                                        <label class="studio-form-label">
                                            <span>Spec (JSON)</span>
                                            <textarea class="console-input studio-code" rows="8" @bind="sel.VegaLiteSpec" @bind:after="OnEdit"></textarea>
                                        </label>
                                        <ValidationMessageInline FieldKey="@StudioReportFieldKeys.PanelVegaLiteSpec(editor.Panels.IndexOf(sel))" State="_validation" />
                                    </section>
                                }
                                <div class="console-action-row">
                                    <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => RemovePanel(sel)">Remove panel</button>
                                </div>
                                <p class="studio-report-callout studio-report-callout--info">Pinning a binding to a known version means newer publishes of its source won't change this report. Use a blank pin for live content, an explicit pin for archival reports.</p>
                            </div>
                        }
                        else
                        {
                            <div class="studio-report-inspector-head">
                                <h3>Report</h3>
                                <p class="console-muted">document settings</p>
                            </div>
                            <div class="studio-report-inspector-body">
                                <section class="studio-report-fieldgroup">
                                    <p class="console-kicker">Details</p>
                                    @if (editor.IsPublished && !string.IsNullOrWhiteSpace(editor.PublicationId))
                                    {
                                        <FieldStateRow State="FieldState.System" Label="Publication id" Value="@editor.PublicationId" Hint="@($"r{editor.ActiveRevision}")" />
                                    }
                                    <FieldStateRow State="FieldState.Input" Label="Title" Errors="_validation.Errors(StudioReportFieldKeys.Title)">
                                        <input class="console-input" @bind="editor.Title" @bind:after="OnEdit" placeholder="Monthly infrastructure report" />
                                    </FieldStateRow>
                                    <FieldStateRow State="FieldState.Input" Label="Route slug" Hint="@(editor.IsPublished ? "locked after publish" : null)" Errors="_validation.Errors(StudioReportFieldKeys.RouteSlug)">
                                        <input class="console-input" @bind="editor.RouteSlug" @bind:after="OnEdit" placeholder="monthly-infrastructure" disabled="@editor.IsPublished" />
                                    </FieldStateRow>
                                    <FieldStateRow State="FieldState.Input" Label="Description">
                                        <textarea class="console-input" rows="2" @bind="editor.Description"></textarea>
                                    </FieldStateRow>
                                    <FieldStateRow State="FieldState.Input" Label="Narrative">
                                        <textarea class="console-input" rows="3" @bind="editor.Narrative" placeholder="Context shown above the layout."></textarea>
                                    </FieldStateRow>
                                </section>

                                <section class="studio-report-fieldgroup">
                                    <p class="console-kicker">Presentation</p>
                                    <label class="studio-form-label">
                                        <span>Visibility</span>
                                        <select class="console-input" @bind="editor.Visibility" @bind:after="OnEdit">
                                            @foreach (var visibility in StudioReportVisibilities.All)
                                            {
                                                <option value="@visibility">@visibility</option>
                                            }
                                        </select>
                                    </label>
                                    <ValidationMessageInline FieldKey="@StudioReportFieldKeys.Visibility" State="_validation" />
                                    <label class="studio-form-label-inline">
                                        <input type="checkbox" @bind="editor.Embeddable" />
                                        <span>Allow embedding</span>
                                    </label>
                                    <label class="studio-form-label">
                                        <span>Preview breakpoint</span>
                                        <select class="console-input" @bind="editor.PreviewBreakpoint">
                                            @foreach (var breakpoint in StudioReportBreakpoints.All)
                                            {
                                                <option value="@breakpoint">@breakpoint</option>
                                            }
                                        </select>
                                    </label>
                                </section>

                                <ValidationMessageInline FieldKey="@StudioReportFieldKeys.Panels" State="_validation" />

                                <section class="studio-report-fieldgroup" data-report-bindings>
                                    <div class="studio-report-fieldgroup-head">
                                        <p class="console-kicker">Data bindings</p>
                                        <button class="console-button console-button-secondary console-button-small" type="button" disabled="@_busy" @onclick="AddBinding">Add binding</button>
                                    </div>
                                    @if (editor.Bindings.Count == 0)
                                    {
                                        <p class="console-muted">No data bindings yet. Add at least one source ref panels can read, with an optional version pin.</p>
                                    }
                                    @foreach (var binding in editor.Bindings)
                                    {
                                        var bindingIndex = editor.Bindings.IndexOf(binding);
                                        <div class="studio-report-binding" @key="binding">
                                            <FieldStateRow State="FieldState.Input" Label="Alias" Errors="_validation.Errors(StudioReportFieldKeys.BindingAlias(bindingIndex))">
                                                <input class="console-input" @bind="binding.Alias" @bind:after="OnEdit" placeholder="incidents" />
                                            </FieldStateRow>
                                            <FieldStateRow State="FieldState.Input" Label="Content ref" Errors="_validation.Errors(StudioReportFieldKeys.BindingContentRef(bindingIndex))">
                                                <input class="console-input" @bind="binding.ContentRef" @bind:after="OnEdit" placeholder="content:incidents" />
                                            </FieldStateRow>
                                            <FieldStateRow State="@(string.IsNullOrWhiteSpace(binding.VersionPin) ? FieldState.Discovered : FieldState.Input)"
                                                           Label="Version pin"
                                                           Hint="@(string.IsNullOrWhiteSpace(binding.VersionPin) ? "tracks latest publish" : "pinned")">
                                                <input class="console-input" @bind="binding.VersionPin" @bind:after="OnEdit" placeholder="latest" />
                                            </FieldStateRow>
                                            <div class="console-action-row">
                                                <button class="console-button console-button-secondary console-button-small" type="button" disabled="@_busy" @onclick="() => RemoveBinding(binding)">Remove</button>
                                            </div>
                                        </div>
                                    }
                                </section>

                                <p class="studio-report-callout studio-report-callout--info">Pinning a binding to a known version means newer publishes of its source won't change this report. Use a blank pin for live content, an explicit pin for archival reports.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (_publication is { } publication)
        {
            <section class="console-section" data-report-publication="@publication.PublicationId">
                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">@($"{publication.PublicationId} · {publication.ActiveVersionId}")</p>
                            <h2>@(string.IsNullOrWhiteSpace(publication.ActiveTitle) ? "Untitled report" : publication.ActiveTitle)</h2>
                        </div>
                        <span class="console-status @(IsActive(publication) ? string.Empty : "console-status-warning")">@publication.Lifecycle</span>
                    </div>
                    <dl class="console-definition-list">
                        <dt>Route</dt>
                        <dd>@publication.RoutePath</dd>
                        <dt>Active revision</dt>
                        <dd>@($"r{publication.ActiveRevision}")</dd>
                        <dt>Visibility</dt>
                        <dd>@publication.Visibility</dd>
                        <dt>Embeddable</dt>
                        <dd>@(publication.Embeddable ? "yes" : "no")</dd>
                        @if (!string.IsNullOrWhiteSpace(publication.RollbackTargetVersionId))
                        {
                            <dt>Rolled back to</dt>
                            <dd>@publication.RollbackTargetVersionId</dd>
                        }
                        <dt>Updated</dt>
                        <dd>@publication.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</dd>
                    </dl>
                    <div class="console-action-row">
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => EditPublished(publication)">Edit / republish</button>
                    </div>
                </article>

                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Version pinning</p>
                            <h3>Immutable versions</h3>
                        </div>
                    </div>
                    @if (publication.Versions.Count == 0)
                    {
                        <p class="console-muted">No published versions yet.</p>
                    }
                    else
                    {
                        <div class="console-table-wrap">
                            <table class="console-table">
                                <thead>
                                    <tr>
                                        <th>Revision</th>
                                        <th>Version id</th>
                                        <th>Title</th>
                                        <th>Dependencies</th>
                                        <th>Active</th>
                                        <th>Published by</th>
                                        <th>Published</th>
                                        <th>Pin</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var version in publication.Versions)
                                    {
                                        <tr>
                                            <td>@($"r{version.Revision}")</td>
                                            <td><small>@version.VersionId</small></td>
                                            <td>@(string.IsNullOrWhiteSpace(version.Title) ? "—" : version.Title)</td>
                                            <td>@version.DependencyCount</td>
                                            <td>@(version.IsActive ? "active" : "—")</td>
                                            <td>@version.CreatedBy</td>
                                            <td>@version.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                            <td>
                                                @if (!version.IsActive)
                                                {
                                                    <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => Rollback(publication, version)">Roll back to r@(version.Revision)</button>
                                                }
                                                else
                                                {
                                                    <span class="console-muted">current</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </article>
            </section>
        }
        else if (_editor is null && _attempted)
        {
            <EmptyState Area="studio" Subject="report publications" />
        }
    }
</section>

@code {
    private bool _loading;
    private bool _busy;
    private bool _attempted;
    private string? _publicationIdInput;
    private StudioReportPublicationView? _publication;
    private StudioReportEditorState? _editor;
    private StudioReportCapabilityState? _bindingState;
    private IReadOnlyList<StudioReportCapabilityState> _states = [];
    private string? _status;
    private bool _statusFailed;
    private StudioReportPanelEditor? _selectedPanel;
    private readonly ValidationState _validation = new();
    private readonly FormDirtyState _dirty = new();

    [SupplyParameterFromQuery(Name = "publicationId")]
    public string? PublicationId { get; set; }

    /// <summary>
    /// Re-runs the client cross-field/referential validator over the current editor and flags it dirty.
    /// Wired to every bound edit via <c>@bind:after</c> (cheap and synchronous). The server channel is
    /// dropped on edit because any change makes the last publish-time server findings stale; the next
    /// publish rebinds fresh ones.
    /// </summary>
    private void OnEdit()
    {
        _dirty.MarkDirty();
        RecomputeClientErrors();
        _validation.SetServerErrors(Array.Empty<ConsoleFieldError>());
    }

    private void RecomputeClientErrors() =>
        _validation.SetClientErrors(_editor is null
            ? Array.Empty<ConsoleFieldError>()
            : StudioReportValidator.Instance.Evaluate(_editor));

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(PublicationId) && !_attempted)
        {
            _publicationIdInput = PublicationId;
            await LoadAsync(PublicationId);
        }
    }

    private void NewReport()
    {
        _editor = new StudioReportEditorState();
        _selectedPanel = null;
        _publication = null;
        _status = null;
        _statusFailed = false;
        _bindingState = null;
        _states = [];
        _validation.Clear();
        _dirty.MarkClean();
        RecomputeClientErrors();
    }

    private async Task OpenPublication()
    {
        if (string.IsNullOrWhiteSpace(_publicationIdInput))
        {
            return;
        }

        await LoadAsync(_publicationIdInput);
    }

    private async Task LoadAsync(string publicationId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _loading = true;
        _attempted = true;
        _editor = null;
        _status = null;
        _statusFailed = false;
        try
        {
            var result = await ReportData.LoadAsync(publicationId);
            _publication = result.Publication;
            ApplyStates(result.CapabilityStates);

            // A fresh load is the clean baseline: any open editor's local edits/findings are dropped.
            _validation.Clear();
            _dirty.MarkClean();
            RecomputeClientErrors();
        }
        finally
        {
            _busy = false;
            _loading = false;
        }
    }

    private void CloseEditor()
    {
        _editor = null;
        _selectedPanel = null;
        _status = null;
        _statusFailed = false;
        _validation.Clear();
        _dirty.MarkClean();
    }

    private void EditPublished(StudioReportPublicationView publication)
    {
        // Reopen the published report's route/policy into an editable authoring state. The next publish is a
        // republish that advances the active route pointer; earlier versions stay immutable for rollback.
        _editor = new StudioReportEditorState
        {
            PublicationId = publication.PublicationId,
            RouteSlug = publication.RouteSlug,
            ActiveRevision = publication.ActiveRevision,
            Title = publication.ActiveTitle ?? string.Empty,
            Visibility = publication.Visibility,
            Embeddable = publication.Embeddable
        };
        _selectedPanel = null;
        _status = null;
        _statusFailed = false;
        // Reopening a published report into an editable state is a fresh baseline.
        _validation.Clear();
        _dirty.MarkClean();
        RecomputeClientErrors();
    }

    private void AddBinding()
    {
        _editor?.Bindings.Add(new StudioReportBindingEditor());
        OnEdit();
    }

    private void RemoveBinding(StudioReportBindingEditor binding)
    {
        _editor?.Bindings.Remove(binding);
        OnEdit();
    }

    private void AddPanel()
    {
        if (_editor is null)
        {
            return;
        }

        var panel = new StudioReportPanelEditor { VegaLiteSpec = StudioReportChartSpec.DefaultBarChart() };
        _editor.Panels.Add(panel);
        _selectedPanel = panel;
        OnEdit();
    }

    private void RemovePanel(StudioReportPanelEditor panel)
    {
        if (ReferenceEquals(panel, _selectedPanel))
        {
            _selectedPanel = null;
        }

        _editor?.Panels.Remove(panel);
        OnEdit();
    }

    private void SelectPanel(StudioReportPanelEditor? panel) => _selectedPanel = panel;

    private StudioReportPanelEditor? SelectedPanel(StudioReportEditorState editor) =>
        _selectedPanel is not null && editor.Panels.Contains(_selectedPanel) ? _selectedPanel : null;

    private static string PanelLabel(StudioReportPanelEditor panel) =>
        string.IsNullOrWhiteSpace(panel.Title) ? $"Untitled {panel.Kind}" : panel.Title;

    private Task Publish() => RunCommandAsync(() => ReportData.PublishAsync(_editor!), keepEditor: true);

    private Task UpdatePolicy() =>
        RunCommandAsync(
            () => ReportData.UpdatePolicyAsync(_editor!.PublicationId!, _editor.Visibility, _editor.Embeddable, _editor.ETag),
            keepEditor: true);

    private Task Rollback(StudioReportPublicationView publication, StudioReportPublicationVersionView version) =>
        RunCommandAsync(() => ReportData.RollbackAsync(publication.PublicationId, version.VersionId), keepEditor: false);

    private async Task RunCommandAsync(Func<Task<StudioReportCommandResult>> command, bool keepEditor)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await command();
            _status = result.Message;
            _statusFailed = !result.Succeeded;

            // Re-run the client validator against the current editor and bind any field-addressable server
            // findings (parsed from a 400 ProblemDetails errors[]) onto the same field keys so they surface
            // inline next to the offending input, merged with the client findings.
            RecomputeClientErrors();
            _validation.SetServerErrors(StudioReportServerErrorBinder.Map(result.FieldErrors));

            if (result.Succeeded)
            {
                _dirty.MarkClean();
            }

            if (result.Publication is not null)
            {
                _publication = result.Publication;
                _attempted = true;

                if (keepEditor && _editor is not null)
                {
                    // Reflect the new server identity/revision back into the editor so the next publish is a
                    // republish against the freshly advanced route pointer.
                    _editor.PublicationId = result.Publication.PublicationId;
                    _editor.RouteSlug = result.Publication.RouteSlug;
                    _editor.ActiveRevision = result.Publication.ActiveRevision;
                    _editor.Visibility = result.Publication.Visibility;
                    _editor.Embeddable = result.Publication.Embeddable;
                }
                else
                {
                    _editor = null;
                    _selectedPanel = null;
                }
            }

            ApplyStates(result.Issue is null ? [] : [result.Issue]);
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsActive(StudioReportPublicationView publication) =>
        string.Equals(publication.Lifecycle, "active", StringComparison.OrdinalIgnoreCase);

    private void ApplyStates(IReadOnlyList<StudioReportCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
        _states = states
            .Where(state => !ReferenceEquals(state, _bindingState))
            .ToArray();
    }
}
