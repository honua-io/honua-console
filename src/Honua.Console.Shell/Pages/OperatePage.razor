@inject NavigationManager ConsoleNavigation
@page "/operate"
@inject IOperateTransitionDataSource OperateData
@inject IConsoleCapabilityManifest Capabilities
@inject IServiceProvider Services

<section class="console-page @(V4Enabled ? "console-operate-overview-v4" : null)">
    @if (V4Enabled)
    {
        <link rel="stylesheet" href="_content/Honua.Console.Shell/css/operate-overview-v4.css" />
        <ConsolePageHeading Title="Operate">
            <p>Review health, approvals, connections, services and changes across your workspace.</p>
        </ConsolePageHeading>
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Operator workflow</p>
            <h1>Operate</h1>
            <p>Connections, datasets, services, layers, and control-plane settings live under Operate while Studio, Catalog, and Share keep their builder and end-user workflows separate.</p>
        </div>
    }

    @* Ops-summary strip (console#292, founder decision 2026-07-07): the hub's "is my server
       healthy, what needs me?" glance — overall health, awaiting approvals, open findings, and
       SLO breaches, each deep-linking to its actionable surface. *@
    <OpsSummaryStrip />

    @if (_workspace is null)
    {
        <p class="console-muted">Loading Operate workspace...</p>
    }
    else
    {
        <OperateCapabilityStateList States="@_workspace.CapabilityStates" />

        <div class="console-panel-grid console-panel-grid-wide">
            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/connections")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Connections</p>
                        <h2>Data Connections</h2>
                    </div>
                    <span class="console-profile-count">@_workspace.Connections.Count</span>
                </div>
                <p class="console-muted">Test connections and inspect operator-safe diagnostics.</p>
            </a>

            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/resources")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Datasets</p>
                        <h2>Dataset edits</h2>
                    </div>
                    <span class="console-profile-count">@_workspace.ResourceEdits.Count</span>
                </div>
                <p class="console-muted">Review validation state, blast radius, and publish impact before applying changes.</p>
            </a>

            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/services")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Services</p>
                        <h2>Services And Layers</h2>
                    </div>
                    <span class="console-profile-count">@_workspace.Services.Count</span>
                </div>
                <p class="console-muted">Manage services and layers while dataset metadata stays shared.</p>
            </a>

            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/publishing")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Publishing</p>
                        <h2>Publishing Workspace</h2>
                    </div>
                </div>
                <p class="console-muted">Publish datasets as layers and review services, endpoints, catalog registration, access, recovery, and provenance.</p>
            </a>

            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/settings")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Settings</p>
                        <h2>Operator Settings</h2>
                    </div>
                    <span class="console-profile-count">@_workspace.SettingsChanges.Count</span>
                </div>
                <p class="console-muted">Preview apply scope, policy requirements, and restart impact for settings changes.</p>
            </a>

            @* Capability-gated depth (first-release cut-line): these hub cards are hidden until the
               deployment advertises the capability, so the hub never routes to a surface that only
               renders the "unsupported" state. The gated page still renders that state if reached by URL. *@
            @if (Capabilities.IsAdvertised(ConsoleCapabilityKeys.Temporal))
            {
                <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/temporal")">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Temporal</p>
                            <h2>History And Sync Review</h2>
                        </div>
                    </div>
                    <p class="console-muted">Browse temporal data history, compare now-vs-as-of states, plan governed rollbacks, and review disconnected replica sync conflicts where the source supports it.</p>
                </a>
            }

            @if (Capabilities.IsAdvertised(ConsoleCapabilityKeys.DisconnectedSync))
            {
                <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/sync")">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Sync</p>
                            <h2>Disconnected Sync Review</h2>
                        </div>
                    </div>
                    <p class="console-muted">Review disconnected replica conflicts, compare base, client, and server revisions, and commit governed resolutions where the source supports it.</p>
                </a>
            }

            @if (Capabilities.IsAdvertised(ConsoleCapabilityKeys.RealtimeAlerting))
            {
                <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/alerts/rules")">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Alerts</p>
                            <h2>Alert Rules</h2>
                        </div>
                    </div>
                    <p class="console-muted">Author and review realtime, geofence, threshold, and dwell alert rules and their delivery channels.</p>
                </a>
            }

            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/releases")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Releases</p>
                        <h2>GitOps Metadata Releases</h2>
                    </div>
                </div>
                <p class="console-muted">Review release proposals, semantic diffs, and rollback readiness before creating a Git PR.</p>
            </a>

            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/geoprocessing")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Geoprocessing</p>
                        <h2>Geoprocessing Jobs</h2>
                    </div>
                </div>
                <p class="console-muted">Track durable geoprocessing runs: state, current phase, progress, requester, and per-job logs and artifacts.</p>
            </a>

            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/metrics")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Metrics</p>
                        <h2>Performance And Health</h2>
                    </div>
                </div>
                <p class="console-muted">Connection-pool and query-admission saturation, cache hit ratio, memory and GC pressure, the upload queue, database resilience, and the comprehensive health report at a glance.</p>
            </a>

            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/health")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Health</p>
                        <h2>Ops Health</h2>
                    </div>
                </div>
                <p class="console-muted">The consolidated at-a-glance snapshot: overall status, per-protocol serving latency, the geoprocessing queue, alert-dispatch backlog, coordinated-deploy readiness and platform-release skew, and database vitals.</p>
            </a>

            <a class="console-panel console-area-link" href="@ConsoleNavigation.ToConsoleHref("/operate/copilot")">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Copilot</p>
                        <h2>Copilot Findings</h2>
                    </div>
                </div>
                <p class="console-muted">Deterministic findings, governed proposals, graduated per-rule autonomy, a global kill switch, and the causal audit trail for every automatic outcome.</p>
            </a>
        </div>

        <section class="console-section">
            <div class="console-page-heading">
                <p class="console-kicker">Current attention</p>
                <h2>Actionable Items</h2>
            </div>

            <ul class="console-event-list">
                @foreach (var connection in _workspace.Connections.Where(connection => connection.LastDiagnostic is not null))
                {
                    var diagnostic = connection.LastDiagnostic!;
                    <li>
                        <strong>@connection.Name</strong>
                        <span>@diagnostic.FailureCode</span>
                        <small>@(diagnostic.OperatorActions.Count > 0 ? diagnostic.OperatorActions[0] : "No operator action recorded.")</small>
                    </li>
                }

                @foreach (var resource in _workspace.ResourceEdits)
                {
                    <li>
                        <strong>@resource.Name</strong>
                        <span>@resource.ValidationState</span>
                        <small>@resource.DraftChange</small>
                    </li>
                }
            </ul>
        </section>
    }
</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    private OperateTransitionWorkspace? _workspace;

    protected override async Task OnInitializedAsync()
    {
        await Capabilities.RefreshAsync();
        _workspace = await OperateData.GetWorkspaceAsync();
    }
}
