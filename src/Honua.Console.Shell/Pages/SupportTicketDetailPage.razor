@page "/support/tickets/{TicketId}"
@implements IDisposable
@inject IConsoleSupportTicketClient SupportClient
@inject IServiceProvider Services

<section class="console-page console-support-page">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="@($"Ticket {TicketId}")">
            <p class="console-muted">Track the diagnosis, access, and validation for this ticket.</p>
        </ConsolePageHeading>
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Support</p>
            <h1>Ticket @TicketId</h1>
            <p>
                This view polls honua-support for the live phase, the guided commands the diagnosis produced, and the
                validation steps, so the support loop closes in-product without leaving the Console.
            </p>
        </div>
    }

    @if (_ticket is null && !_loaded)
    {
        <article class="console-panel">
            <p class="console-muted">Loading ticket...</p>
        </article>
    }
    else if (_ticket is null)
    {
        <ConsoleStateView HeadingLevel="2" Kind="@StateKind"
                          Kicker="Support"
                          Title="@OperateSectionPresentation.Title(_status)"
                          Message="@(_message ?? OperateSectionPresentation.FallbackMessage(_status))"
                          ActionHref="/support"
                          ActionLabel="Back to support" />
        @if (_polling)
        {
            <p class="console-muted" role="status">Retrying automatically...</p>
        }
    }
    else
    {
        <article class="console-panel">
            <div class="console-panel-heading">
                <h2>Status</h2>
                <span class="support-phase-badge">@TicketLabel(PhaseLabel)</span>
            </div>
            <dl class="support-context-list">
                <ContextRow Label="Customer status" Value="@TicketLabel(_ticket.CustomerStatus)" />
                <ContextRow Label="Phase" Value="@TicketLabel(_ticket.Phase)" />
                <ContextRow Label="Severity" Value="@TicketLabel(_ticket.Severity)" />
                <ContextRow Label="Service" Value="@_ticket.Service" />
                <ContextRow Label="Environment" Value="@_ticket.Environment" />
                <ContextRow Label="Access mode" Value="@TicketLabel(_ticket.AllowedAccessMode)" />
                <ContextRow Label="Assigned operator" Value="@_ticket.AssignedOperatorId" />
                <ContextRow Label="Created" Value="@_ticket.CreatedAt.ToString("u")" />
                <ContextRow Label="Updated" Value="@_ticket.UpdatedAt.ToString("u")" />
                <ContextRow Label="Resolved" Value="@(_ticket.ResolvedAt?.ToString("u"))" />
            </dl>
            <p class="console-muted">@(_polling ? "Auto-refreshing every 5s..." : "Ticket reached a terminal phase; polling stopped.")</p>
        </article>

        @* trust-visibility (#166): escalation rationale + live remote-session banner.
           Both prefer the authoritative trust.* envelope (honua-support#23) and fall
           back to the loose ticket fields; they self-suppress when the ticket is not
           escalated / no session is implied. *@
        <SupportEscalationRationaleCard Ticket="_ticket" />
        <SupportRemoteSessionBanner Ticket="_ticket" />

        <article class="console-panel">
            <div class="console-panel-heading">
                <h2>Requested action</h2>
            </div>
            <p>@_ticket.RequestedAction</p>
            @if (!string.IsNullOrWhiteSpace(_ticket.ResolutionSummary))
            {
                <p class="console-kicker">Resolution</p>
                <p>@_ticket.ResolutionSummary</p>
            }
        </article>

        @if (_ticket.Diagnosis is { } diagnosis)
        {
            <article class="console-panel">
                <div class="console-panel-heading">
                    <h2>Diagnosis</h2>
                    <span class="console-muted">@diagnosis.Confidence confidence - @diagnosis.Mode</span>
                </div>
                <p>@diagnosis.Summary</p>

                @if (diagnosis.GuidedCommands.Count > 0)
                {
                    <p class="console-kicker">Guided commands</p>
                    <ol class="support-command-list">
                        @foreach (var command in diagnosis.GuidedCommands)
                        {
                            <li><code>@command</code></li>
                        }
                    </ol>
                }

                @if (diagnosis.ValidationSteps.Count > 0)
                {
                    <p class="console-kicker" id="audit">Validation steps</p>
                    <ul class="support-validation-list">
                        @foreach (var step in diagnosis.ValidationSteps)
                        {
                            <li>@step</li>
                        }
                    </ul>
                }
            </article>
        }

        @* trust-visibility (#166): pass/fail scorecard checklist. Prefers the
           authoritative trust.scorecard (honua-support#23) and falls back to the
           free-form diagnosis scorecard. Self-suppresses when neither is present. *@
        <SupportScorecardChecklist Trust="_ticket.Trust?.Scorecard"
                                   Scorecard="_ticket.Diagnosis?.Scorecard" />
    }
</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    [Parameter]
    public string TicketId { get; set; } = string.Empty;

    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);
    private static readonly TimeSpan MaxRetryInterval = TimeSpan.FromSeconds(60);

    private SupportTicketResponse? _ticket;
    private OperateSectionStatus _status = OperateSectionStatus.Unavailable;
    private string? _message;
    private bool _loaded;
    private bool _polling;

    private CancellationTokenSource? _cts;
    private string? _polledTicketId;
    private bool _disposed;

    private string StateKind => _status switch
    {
        OperateSectionStatus.Missing => "empty",
        OperateSectionStatus.Forbidden => "warning",
        _ => "info"
    };

    private string? TicketLabel(string? value) => V4Enabled ? SupportTicketLabels.Display(value) : value;

    private string PhaseLabel =>
        string.IsNullOrWhiteSpace(_ticket?.CustomerStatus) ? _ticket?.Phase ?? "unknown" : _ticket!.CustomerStatus;

    protected override async Task OnParametersSetAsync()
    {
        // Restart the poll loop when navigating between ticket ids.
        if (_disposed || string.Equals(_polledTicketId, TicketId, StringComparison.Ordinal))
        {
            return;
        }

        StopPolling();
        _polledTicketId = TicketId;
        _ticket = null;
        _loaded = false;

        if (string.IsNullOrWhiteSpace(TicketId))
        {
            _status = OperateSectionStatus.Missing;
            _message = "No ticket id was supplied.";
            _loaded = true;
            return;
        }

        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        var ticketId = TicketId;
        if (await RefreshAsync(ticketId, token))
        {
            StartPolling(ticketId, token);
        }
    }

    private async Task<bool> RefreshAsync(string ticketId, CancellationToken token)
    {
        SupportTicketResult result;
        try
        {
            result = await SupportClient.GetTicketAsync(ticketId, token);
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            return false;
        }
        if (token.IsCancellationRequested)
        {
            return false;
        }

        _loaded = true;
        _ticket = result.IsAllowed ? result.Value : null;
        _status = result.Status;
        _message = result.IsAllowed ? null : result.Message;
        return true;
    }

    private void StartPolling(string ticketId, CancellationToken token)
    {
        // Poll an open ticket, or retry a read that failed for a reason that may clear.
        if (!ShouldPoll())
        {
            _polling = false;
            return;
        }

        _polling = true;
        _ = PollAsync(ticketId, token);
    }

    private async Task PollAsync(string ticketId, CancellationToken token)
    {
        var delay = PollInterval;
        try
        {
            while (true)
            {
                await Task.Delay(delay, token).ConfigureAwait(false);
                await InvokeAsync(async () =>
                {
                    if (token.IsCancellationRequested || !await RefreshAsync(ticketId, token))
                    {
                        return;
                    }
                    _polling = ShouldPoll();
                    StateHasChanged();
                }).ConfigureAwait(false);

                if (token.IsCancellationRequested || !_polling)
                {
                    return;
                }

                // Back off while the read keeps failing, so a misconfigured endpoint is not hit every 5s forever.
                delay = _status == OperateSectionStatus.Unavailable
                    ? TimeSpan.FromTicks(Math.Min(delay.Ticks * 2, MaxRetryInterval.Ticks))
                    : PollInterval;
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Disposed or navigated away; stop quietly.
        }
    }

    private void StopPolling()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
        _polling = false;
    }

    // Unavailable (network, server error, timeout or unexpected response) may clear, so it is retried with
    // backoff; every other status will not, and a terminal ticket has nothing left to change.
    private bool ShouldPoll() =>
        _status == OperateSectionStatus.Unavailable || (_ticket is not null && !IsTerminal(_ticket.Phase));

    private static bool IsTerminal(string phase) =>
        phase is "resolved" or "cancelled" or "closed";

    public void Dispose()
    {
        _disposed = true;
        StopPolling();
    }
}
