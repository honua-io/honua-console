@inject NavigationManager ConsoleNavigation
@page "/operate/services/{ServiceName}/settings"
@using Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IOperateTransitionDataSource OperateData
@inject IServiceConfigurationOperation ServiceConfig
@inject IConsoleNotificationService Notifications
@inject IServiceProvider Services
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page" data-service-name="@ServiceName" data-service-loaded="@(_service is not null)">
    @if (_service is null && _loading)
    {
        <ConsoleStateView Kind="loading" HeadingLevel="2" Kicker="Operate / Services" Title="Loading service" Message="Reading service details from honua-server." />
    }
    else if (_service is null)
    {
        <OperateItemNotFoundOrUnreadable Kind="service" AreaLabel="Operate / Services" Failure="@_readFailure" OnRetry="OnParametersSetAsync" />
    }
    else
    {
        <fieldset disabled="@(!_interactiveReady)" aria-label="Service controls" class="console-data-controls">
            @if (V4Enabled)
            {
                <div data-service-detail="@_service.Name">
                    <ConsolePageHeading Title="@_service.DisplayName">
                        <p class="console-service-summary" data-service-summary>@ServiceSummary</p>
                        @if (ServiceDescription is { } description)
                        {
                            <p class="console-service-description">@description</p>
                        }
                    </ConsolePageHeading>
                </div>
                <ConsoleTabs Tabs="ServiceTabs" Label="Service settings" @bind-SelectedId="_selectedTab" />
                <section id="service-layers-panel" role="tabpanel" aria-labelledby="service-layers-tab" hidden="@(_selectedTab != "service-layers-tab")" tabindex="0">
                    @if (_service.IsLayerService)
                    {
                        <ServiceLayerTableV4 Service="_service" ServicePath="@ServicePath" />
                    }
                    else
                    {
                        <ServiceOperationsPanelV4 Service="_service" />
                    }
                    <ServiceWebServicesV4 Service="_service" ChangeProtocols="@(() => OpenTab("service-protocols-tab"))" />
                </section>
                <section id="service-protocols-panel" @ref="_protocolsPanel" role="tabpanel" aria-labelledby="service-protocols-tab" hidden="@(_selectedTab != "service-protocols-tab")" tabindex="0">
                    @Endpoints
                    @if (_selectedTab == "service-protocols-tab") { @ConfigurationState }
                    @if (_settings.Bound) { @ProtocolEditor }
                </section>
                <section id="service-access-panel" @ref="_accessPanel" role="tabpanel" aria-labelledby="service-access-tab" hidden="@(_selectedTab != "service-access-tab")" tabindex="0">
                    @if (_selectedTab == "service-access-tab") { @ConfigurationState }
                    @if (_settings.Bound) { @AccessEditor }
                </section>
                <section id="service-limits-panel" @ref="_limitsPanel" role="tabpanel" aria-labelledby="service-limits-tab" hidden="@(_selectedTab != "service-limits-tab")" tabindex="0">
                    @Runtime
                    @if (_selectedTab == "service-limits-tab" && !_settings.Bound) { @ConfigurationState }
                    @if (_settings.Bound) { @RenderingLimits }
                </section>
                @AdministrationV4
            }
            else
            {
                <div class="console-page-heading" data-service-detail="@_service.Name">
                    <p class="console-kicker">Operate / Services</p>
                    <h1>@_service.DisplayName</h1>
                    <p>@_service.MetadataOwnership</p>
                </div>
                <div class="console-panel-grid">
                    @Runtime
                    @Endpoints
                </div>
                @Administration
                @Configuration
                @if (_service.IsLayerService)
                {
                    @Layers
                }
                else
                {
                    <ServiceOperationsPanelV4 Service="_service" />
                }
            }
        </fieldset>
    }

    <OperateCapabilityStateList States="@_states" />
</section>

@code {
    [Parameter]
    public string ServiceName { get; set; } = string.Empty;

    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
    private string _selectedTab = "service-layers-tab";
    private IReadOnlyList<ConsoleTab> ServiceTabs =>
    [
        new("service-layers-tab", _service is { IsLayerService: false } ? ConsoleServiceKind.TabLabel(_service.ServiceCategory) : "Layers", "service-layers-panel")
        {
            Count = _service is { IsLayerService: true } ? _service.LayerCount : null
        },
        new("service-protocols-tab", "Protocols", "service-protocols-panel") { Count = ProtocolsReported ? ProtocolCount : null },
        new("service-access-tab", "Access", "service-access-panel"),
        new("service-limits-tab", "Limits and rendering", "service-limits-panel")
    ];

    private RenderFragment ServiceSummary => @<text>Service <code>@ServicePath</code> · @(_service!.IsLayerService ? ConsolePublicationTreeContext.FormatCount(_service!.LayerCount, "layer") : ConsoleServiceKind.SummaryLabel(_service!.ServiceCategory)) · @ProtocolSummary@if (AccessSummary is { } access) { <span data-service-access-summary> · @access</span> }@foreach (var connection in Connections) { <span data-service-connection> · connection <a href="@Navigation.ToConsoleHref($"/operate/connections/{Uri.EscapeDataString(connection.Id)}")">@connection.Name</a></span> }</text>;



    private RenderFragment AdministrationV4 => @<text>
        <ConsolePanel Title="Administration" HeadingId="service-administration-heading" Class="console-service-administration">
            <div class="console-action-row">
                <button type="button" class="console-button console-button-secondary" @onclick="@(() => OpenTab("service-access-tab"))" data-service-admin-access>Access</button>
                <button type="button" class="console-button console-button-secondary" @onclick="@(() => OpenTab("service-limits-tab"))">Limits and rendering</button>
                <a class="console-button console-button-secondary" href="@SectionHref("service-metadata-editor")" @onclick="() => FocusSection(_metadataEditor)">Edit metadata</a>
            </div>
            <dl class="console-service-kv">
                <dt>Folder</dt>
                <dd>@(_service!.FolderName ?? (_service.FolderId is null ? "No Folder" : "Folder name not reported")) · <a href="@SectionHref("service-folder-editor")" @onclick="() => FocusSection(_folderEditor)">Move…</a></dd>
                <dt>Access</dt>
                <dd>@AccessDetail</dd>
                <dt>Render limits</dt>
                <dd>@RenderLimits</dd>
                <dt>Connection</dt>
                <dd>@(Connections.Count == 0 ? "Not reported" : string.Join(", ", Connections.Select(connection => connection.Name)))</dd>
            </dl>
        </ConsolePanel>
        <div class="console-service-admin-editors">@Administration</div>
    </text>;

    private RenderFragment Runtime => @<text>
        @if (V4Enabled)
        {
            <ConsolePanel Title="Service controls" HeadingId="service-runtime-heading">
                <ChildContent>@RuntimeContent</ChildContent>
                <Actions><span class="console-status">@_service!.RuntimeStatus</span></Actions>
            </ConsolePanel>
        }
        else
        {
            <article class="console-panel">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Runtime settings</p>
                        <h2>Service controls</h2>
                    </div>
                    <span class="console-status">@_service!.RuntimeStatus</span>
                </div>
                @RuntimeContent
            </article>
        }
    </text>;

    private RenderFragment RuntimeContent => @<text>
        <ConsoleTableRegion Class="console-table-wrap" Label="@(V4Enabled ? "Runtime setting values" : "Service controls")">
            <table class="console-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Value</th>
                        <th scope="col">Apply scope</th>
                        <th scope="col">Restart</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var setting in _service!.RuntimeSettings)
                    {
                        <tr>
                            <td>@setting.Name</td>
                            <td>@setting.Value</td>
                            <td>@RuntimeSettingScope(setting)</td>
                            <td>@(setting.RequiresRestart ? "Required" : "Not required")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </ConsoleTableRegion>
    </text>;

    private RenderFragment Endpoints => @<text>
        @if (V4Enabled)
        {
            <ConsolePanel Title="Service endpoints" HeadingId="service-endpoints-heading">
                @EndpointsContent
            </ConsolePanel>
        }
        else
        {
            <article class="console-panel">
                <p class="console-kicker">Protocols</p>
                <h2>Service endpoints</h2>
                @EndpointsContent
            </article>
        }
    </text>;

    private RenderFragment EndpointsContent => @<text>
        <dl class="console-definition-list console-protocols">
            @foreach (var slot in _service!.Endpoints)
            {
                <div class="console-protocol-pill">
                    <dt title="@slot.Name">@slot.Name</dt>
                    <dd>
                        <strong title="@slot.Status">@slot.Status</strong>
                        <small title="@slot.Url">@(slot.Url ?? "No single service URL")</small>
                    </dd>
                </div>
            }
        </dl>
    </text>;

    private RenderFragment Administration => @<text>
        @foreach (var reason in _service!.FolderMutationIssues)
        {
            <p class="console-state-warning" role="status" data-folder-reconciliation>@reason</p>
        }
        <div id="service-folder-editor" tabindex="-1" @ref="_folderEditor">
            <Honua.Console.Shell.Components.Operate.FolderManagement ServiceName="@ServiceName" CurrentFolderId="@_service!.FolderId" OnSaved="OnParametersSetAsync" UnsavedChanged="@(summary => _folderUnsaved = summary)" />
        </div>
        <div id="service-metadata-editor" tabindex="-1" @ref="_metadataEditor">
            <DiscoveryMetadataEditor Address="@Honua.Console.Contracts.DiscoveryMetadataAddress.ForService(ServiceName)" UnsavedChanged="@(summary => _metadataUnsaved = summary)" />
        </div>
    </text>;

    private RenderFragment Configuration => @<text>
        <section class="console-section" data-service-config>
            <div class="console-page-heading">
                <p class="console-kicker">Protocols &amp; access</p>
                <h2>How this service is served</h2>
                <p>Enable the protocols this service exposes (FeatureServer, MapServer, WMS, WFS, WMTS, OGC API, OData, vector tiles, STAC) and set whether it is reachable anonymously.</p>
            </div>

            @ConfigurationState
            @if (_settings.Bound)
            {
                <div class="console-panel-grid">
                    @ProtocolEditor
                    @AccessEditor
                    @RenderingLimits
                </div>
            }
        </section>
    </text>;

    private RenderFragment ConfigurationState => @<text>
        @if (!_settings.Bound)
        {
            <div class="console-panel console-state-neutral" role="status">
                <p class="console-kicker">Missing binding</p>
                <p>@_settings.Detail</p>
            </div>
        }
        else if (_configResult is { } result)
        {
            <div class="console-panel @(result.Succeeded ? "console-state-success" : "console-state-danger")" role="status" data-config-result>
                <p class="console-kicker">@result.State</p>
                <p>@result.Detail</p>
            </div>
        }
    </text>;

    private RenderFragment ProtocolEditor => @<text>
        @if (V4Enabled)
        {
            <ConsolePanel Title="Enabled protocols" HeadingId="service-enabled-protocols-heading">
                @ProtocolEditorContent
            </ConsolePanel>
        }
        else
        {
            <article class="console-panel">
                <p class="console-kicker">Protocols</p>
                <h3>Enabled protocols</h3>
                @ProtocolEditorContent
            </article>
        }
    </text>;

    private RenderFragment ProtocolEditorContent => @<text>
        <div class="console-check-grid">
            @foreach (var protocol in _availableProtocols)
            {
                <label class="console-inline-check">
                    <input type="checkbox" checked="@_selectedProtocols.Contains(protocol)"
                           @onchange="e => ToggleProtocol(protocol, (bool)e.Value!)"
                           data-protocol="@protocol" />
                    <span>@protocol</span>
                </label>
            }
        </div>
        <div class="console-action-row">
            <button class="console-button" type="button" disabled="@(_savingProtocols || _savingAccess || _selectedProtocols.Count == 0)"
                    @onclick="SaveProtocolsAsync" data-save-protocols>
                @(_savingProtocols ? "Saving…" : "Save protocols")
            </button>
        </div>
    </text>;

    private RenderFragment AccessEditor => @<text>
        @if (V4Enabled)
        {
            <ConsolePanel Title="Access policy" HeadingId="service-access-heading">
                @AccessEditorContent
            </ConsolePanel>
        }
        else
        {
            <article class="console-panel">
                <p class="console-kicker">Access</p>
                <h3>Access policy</h3>
                @AccessEditorContent
            </article>
        }
    </text>;

    private RenderFragment AccessEditorContent => @<text>
        <label class="console-inline-check">
            <input type="checkbox" @bind="_allowAnonymous" data-allow-anonymous />
            <span>Allow anonymous read</span>
        </label>
        <label class="console-inline-check">
            <input type="checkbox" @bind="_allowAnonymousWrite" data-allow-anonymous-write />
            <span>Allow anonymous write</span>
        </label>
        <label class="console-field">
            <span>Allowed read roles</span>
            <input type="text" @bind="_allowedRoles" @bind:event="oninput" data-allowed-roles
                   placeholder="viewer, editor" />
            <small>Comma- or newline-separated role names granted read access. Leave blank to clear.</small>
        </label>
        <label class="console-field">
            <span>Allowed write roles</span>
            <input type="text" @bind="_allowedWriteRoles" @bind:event="oninput" data-allowed-write-roles
                   placeholder="editor, admin" />
            <small>Comma- or newline-separated role names granted write access. Leave blank to clear.</small>
        </label>
        <div class="console-action-row">
            <button class="console-button" type="button" disabled="@(_savingProtocols || _savingAccess)"
                    @onclick="RequestSaveAccessAsync" data-save-access>
                @(_savingAccess ? "Saving…" : "Save access policy")
            </button>
        </div>
        <ConsoleConfirmDialog @ref="_accessConfirm" />
    </text>;

    private RenderFragment RenderingLimits => @<text>
        <article class="console-panel" data-mapserver-unsupported>
            <h3>MapServer render settings</h3>
            <HonuaState Kind="unavailable" Title="Unsupported"
                        Message="This server does not support editing MapServer render settings. The settings read reports compatibility defaults." HeadingLevel="4" />
        </article>
    </text>;

    private RenderFragment Layers => @<text>
        <section class="console-section">
            <div class="console-page-heading">
                <p class="console-kicker">Layers</p>
                <h2>Layers</h2>
            </div>
            @LayersContent
        </section>
    </text>;

    private RenderFragment LayersContent => @<text>
        <ConsoleTableRegion Class="console-table-wrap" Label="Service layers">
            <table class="console-table">
                <thead>
                    <tr>
                        <th scope="col">Layer ID</th>
                        <th scope="col">Name</th>
                        <th scope="col">Geometry</th>
                        <th scope="col">Canonical metadata owner</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var layer in _service!.Layers)
                    {
                        <tr data-layer-id="@layer.LayerId">
                            <td>@layer.LayerId</td>
                            <td>@layer.Name</td>
                            <td>@layer.Geometry</td>
                            <td>
                                <a href="@Navigation.ToConsoleHref($"/operate/resources/{Uri.EscapeDataString(layer.CanonicalResourceId)}")">@layer.CanonicalResourceName</a>
                                <small>@layer.CanonicalResourceId</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </ConsoleTableRegion>
    </text>;
}
