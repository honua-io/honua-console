@page "/auth/signin"
@inject IConsoleEnvironmentProfileStore Profiles
@inject IConsoleAccountSessionStore Sessions
@inject NavigationManager Navigation
@inject IServiceProvider Services

<section class="console-page">
    <div class="console-page-heading">
        <p class="console-kicker">Environment session</p>
        <h1>Sign In</h1>
        <p>Continue with the active environment profile before opening authenticated Console routes.</p>
    </div>

    @if (_profile is null)
    {
        <ConsoleStateView HeadingLevel="2" Kind="empty" Kicker="Get started" Title="Add an environment first" Message="Sign-in needs an active environment. Point this Console at your Honua Server and bind an account, then continue here." ActionHref="/environments/new" ActionLabel="Add environment" />
    }
    else
    {

        @if (!string.IsNullOrWhiteSpace(_serverAuthMessage))
        {
            <article class="console-panel console-status-danger" role="alert">
                <h2>Server sign-in required</h2>
                <p class="console-muted">@_serverAuthMessage</p>
            </article>
        }

        <div class="console-panel">
            <div class="console-panel-heading">
                <div>
                    <p class="console-kicker">@_profile.EnvironmentKind</p>
                    <h2>@_profile.DisplayName</h2>
                </div>
                <span class="console-status">@_profile.Account.AuthMode</span>
            </div>

            <dl class="console-definition-list">
                <dt>Server</dt>
                <dd>@_profile.ServerBaseUri</dd>
                <dt>Account</dt>
                <dd>@AccountLabel(_profile)</dd>
                <dt>Return to</dt>
                <dd>@_returnTo</dd>
            </dl>

            <form @onsubmit="SignInAsync" @onsubmit:preventDefault>
                @if (_browserAuth?.SupportsPasswordSignIn == true)
                {
                    <label class="console-field">
                        <span>Password</span>
                        <input class="console-input" type="password" autocomplete="current-password" required
                               @bind="_password" disabled="@_signingIn" />
                    </label>
                }
                @if (_oidc?.IsAvailable == true)
                {
                    @foreach (var provider in _providers)
                    {
                        <button class="console-button" type="button" disabled="@_signingIn"
                                @onclick="() => BeginOidcAsync(provider.Key)">Continue with @provider.DisplayName</button>
                    }
                    @if (_providers.Count == 0)
                    {
                        <p role="status">No identity providers are available. Contact your deployment administrator.</p>
                    }
                }
                else if (_browserAuth is not null && !_browserAuth.SupportsPasswordSignIn)
                {
                    <p role="status">Identity provider sign-in is not available in this Console build yet.</p>
                }
                else
                {
                    <div class="console-detail-actions">
                        <button class="console-button" type="submit" disabled="@_signingIn">@(_signingIn ? "Signing in…" : "Continue")</button>
                        <a class="console-button-link" href="@Navigation.ToConsoleHref(_returnTo)">Cancel</a>
                    </div>
                }
            </form>
        </div>
    }
</section>

@code {
    private ConsoleEnvironmentProfile? _profile;
    private string _returnTo = "/";
    private string? _serverAuthMessage;
    private IConsoleBrowserAuthentication? _browserAuth;
    private string _password = string.Empty;
    private bool _signingIn;
    private IConsoleOidcAuthentication? _oidc;
    private IReadOnlyList<ConsoleIdentityProvider> _providers = [];

    protected override async Task OnParametersSetAsync()
    {
        _returnTo = SanitizeReturnTo(ConsoleUrlQuery.GetValue(Navigation.Uri, "returnTo"));
        _serverAuthMessage = ConsoleUrlQuery.GetValue(Navigation.Uri, "serverAuth") switch
        {
            "denied" => "The identity provider did not complete the honua-server session. Try again.",
            "unavailable" => "The honua-server sign-in bridge is unavailable. Verify the shared-origin auth routing and try again.",
            _ => null
        };
        _profile = await Profiles.GetActiveProfileAsync();
        _browserAuth = Services.GetService<IConsoleBrowserAuthentication>();
        _oidc = Services.GetService<IConsoleOidcAuthentication>();
        if (_oidc?.IsAvailable == true)
        {
            try
            {
                _providers = await _oidc.GetProvidersAsync();
            }
            catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException)
            {
                _serverAuthMessage = "Identity providers could not be loaded. Check the server connection and try again.";
            }
        }
    }

    private async Task SignInAsync()
    {
        if (_profile is null || _signingIn)
        {
            return;
        }

        if (_browserAuth is not null)
        {
            await SignInBrowserAsync();
            return;
        }

        if (_profile.Account.AuthMode == ConsoleAccountAuthMode.AccountRbac)
        {
            var current = await Sessions.GetSessionAsync(_profile.Id);
            if (!string.IsNullOrWhiteSpace(current?.AccessToken)
                && !Honua.Console.Shell.Security.ConsoleAuthConstants.IsSessionSentinel(current.AccessToken)
                && (current.AccessTokenExpiresAt is null || current.AccessTokenExpiresAt > DateTimeOffset.UtcNow.AddSeconds(30)))
            {
                Navigation.NavigateTo(_returnTo);
                return;
            }

            var loginUri = "/auth/server/login?profileId=" + Uri.EscapeDataString(_profile.Id)
                + "&returnTo=" + Uri.EscapeDataString(_returnTo);
            Navigation.NavigateTo(loginUri, forceLoad: true);
            return;
        }

        await Sessions.SaveSessionAsync(new ConsoleAccountSession
        {
            ProfileId = _profile.Id,
            AccountId = string.IsNullOrWhiteSpace(_profile.Account.AccountId) ? "console-user" : _profile.Account.AccountId,
            DisplayName = _profile.Account.DisplayName,
            TenantId = string.IsNullOrWhiteSpace(_profile.Account.TenantId) ? _profile.TenantId : _profile.Account.TenantId,
            PermissionIds = _profile.Account.PermissionHints,
            AccessToken = $"profile-session:{_profile.Id}"
        });

        Navigation.NavigateTo(_returnTo);
    }

    private async Task SignInBrowserAsync()
    {
        if (!_browserAuth!.SupportsPasswordSignIn || string.IsNullOrWhiteSpace(_password))
        {
            return;
        }
        _signingIn = true;
        _serverAuthMessage = null;
        try
        {
            await _browserAuth.SignInAsync(_password);
            Navigation.NavigateTo(Navigation.ToConsoleHref(_returnTo));
        }
        catch (HttpRequestException exception) when (exception.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
        {
            _serverAuthMessage = "The password was not accepted. Try again.";
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException or TaskCanceledException)
        {
            _serverAuthMessage = "Sign-in could not finish. Check the server connection and try again.";
        }
        finally
        {
            _password = string.Empty;
            _signingIn = false;
        }
    }

    private async Task BeginOidcAsync(string providerKey)
    {
        if (_signingIn || _oidc?.IsAvailable != true)
        {
            return;
        }
        _signingIn = true;
        _serverAuthMessage = null;
        try
        {
            var destination = await _oidc.BeginAsync(providerKey, _returnTo);
            Navigation.NavigateTo(destination.AbsoluteUri, forceLoad: true);
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException or Microsoft.JSInterop.JSException)
        {
            _serverAuthMessage = "Sign-in could not start. Check the server connection and try again.";
            _signingIn = false;
        }
    }

    private static string AccountLabel(ConsoleEnvironmentProfile profile) =>
        string.IsNullOrWhiteSpace(profile.Account.DisplayName)
            ? profile.Account.AccountId
            : profile.Account.DisplayName;

    private static string SanitizeReturnTo(string? value) =>
        Honua.Console.Shell.Security.ConsoleReturnUrl.Sanitize(value);
}
