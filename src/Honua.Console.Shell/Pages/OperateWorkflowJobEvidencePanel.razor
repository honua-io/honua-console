@inject IStudioWorkflowPackageClient Workflows

@* Non-routable component. The /operate/jobs/{jobRunId} route is owned solely by
   OperateObservabilityPage (docs/console-route-map.md §1/§6.5). This component preserves the
   "Workflow Job Monitor" workflow job-evidence surface (status/logs/artifacts/event evidence)
   bound to IStudioWorkflowPackageClient, rendered by the observability job-run detail for
   workflow-kind jobs. honua-server#1185 exposes no workflow job-evidence read, so the live
   server adapter returns null and this renders the missing-binding state; the in-memory demo
   adapter renders evidence inline. *@

<div class="console-page-heading">
    <p class="console-kicker">Operate job evidence</p>
    <h2>Workflow Job Monitor</h2>
    <p>Server-owned workflow dry-runs and publications deep-link into Operate for job state, logs, artifacts, output schemas, and event evidence.</p>
</div>

@if (_evidence is null)
{
    <article class="console-panel">
        <h3>Job evidence not projected to this route</h3>
        <p class="console-muted">
            Server-owned workflow job evidence is owned by honua-server's Operate job APIs
            (<code>/api/v1/admin/jobs/@JobId</code>); honua-server#1185 exposes no workflow
            job-evidence read, so the workflow editor links here with the live job id while a
            server job-evidence projection for this route is a pending follow-on. The in-memory
            demo adapter renders evidence inline.
        </p>
    </article>
}
else
{
    <div class="console-panel-grid">
        <article class="console-panel">
            <div class="console-panel-heading">
                <div>
                    <p class="console-kicker">@_evidence.JobKind</p>
                    <h3>@_evidence.JobId</h3>
                </div>
                <span class="console-status">@_evidence.Status</span>
            </div>
            <dl class="console-definition-list">
                <dt>Draft</dt>
                <dd>@_evidence.DraftId</dd>
                <dt>Content item</dt>
                <dd>@(string.IsNullOrWhiteSpace(_evidence.ContentItemId) ? "not saved" : _evidence.ContentItemId)</dd>
                <dt>Version</dt>
                <dd>@(string.IsNullOrWhiteSpace(_evidence.VersionId) ? "draft only" : _evidence.VersionId)</dd>
                <dt>Events</dt>
                <dd><a href="@_evidence.OperateEventsUrl">Open event evidence</a></dd>
            </dl>
        </article>

        <article class="console-panel">
            <h3>Logs</h3>
            <ol class="console-event-list">
                @foreach (var log in _evidence.Logs)
                {
                    <li>
                        <span>workflow</span>
                        <strong>@log</strong>
                    </li>
                }
            </ol>
        </article>

        <article class="console-panel">
            <h3>Artifacts</h3>
            <ul class="workflow-compact-list">
                @foreach (var artifact in _evidence.Artifacts)
                {
                    <li>
                        <span>artifact</span>
                        <strong>@artifact</strong>
                    </li>
                }
            </ul>
        </article>
    </div>
}

@code {
    [Parameter]
    public string JobId { get; set; } = string.Empty;

    private StudioWorkflowJobEvidence? _evidence;

    protected override async Task OnParametersSetAsync()
    {
        _evidence = string.IsNullOrWhiteSpace(JobId)
            ? null
            : await Workflows.GetJobEvidenceAsync(JobId);
    }
}
