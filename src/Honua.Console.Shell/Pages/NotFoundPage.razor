@inject IServiceProvider Services
@inject NavigationManager ConsoleNavigation
@page "/not-found"

<section class="console-page">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Page not found">
            <p>The requested Console route is not registered in the shared shell.</p>
        </ConsolePageHeading>
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Missing route</p>
            <h1>Page Not Found</h1>
            <p>The requested Console route is not registered in the shared shell.</p>
        </div>
    }
    <a class="console-button-link" href="@ConsoleNavigation.ToConsoleHref("/")">Return Home</a>
</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
}
