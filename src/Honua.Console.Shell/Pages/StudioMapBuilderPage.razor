@page "/studio/map"
@using System.Text.Json
@inject IStudioMapPackageDataSource MapData

<section class="console-page studio-map-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>Map builder</h1>
        <p>Author a server-owned map package — layers, filters, style, popup, legend, basemap, extent, and interactions — then review the publish, share, embed, and rollback settings before publishing to honua-server.</p>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Map builder"
                          Title="Loading map packages"
                          Message="Reading the map package lifecycle from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Map package lifecycle is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else if (_editor is null)
    {
        <div class="console-toolbar">
            <button class="console-button" type="button" disabled="@_busy" @onclick="NewMap">New map</button>
        </div>

        @if (_listNotice is not null)
        {
            <ConsoleStateView Kind="info"
                              Kicker="@_listNotice.State"
                              Title="Map packages cannot be listed yet"
                              Message="@($"{_listNotice.Detail} (contract: {_listNotice.Contract})")" />
        }

        @if (_workspace.Packages.Count == 0 && _listNotice is null)
        {
            <EmptyState Area="studio" Subject="map packages" />
        }
        else if (_workspace.Packages.Count > 0)
        {
            <div class="console-table-wrap">
                <table class="console-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Layers</th>
                            <th>Draft</th>
                            <th>Published</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var package in _workspace.Packages)
                        {
                            <tr>
                                <td>
                                    <button type="button" class="console-button console-button-secondary" disabled="@_busy" @onclick="() => OpenMap(package.MapId)">@package.Title</button>
                                    <small>@package.MapId</small>
                                </td>
                                <td>@package.LayerCount</td>
                                <td>@(package.DraftVersion?.ToString() ?? "—")</td>
                                <td>@(package.PublishedVersion?.ToString() ?? "—")</td>
                                <td>@package.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        var editor = _editor;
        var readiness = StudioMapPublishEvaluator.Evaluate(editor);
        var selectedLayer = SelectedLayer(editor);

        <div class="studio-map-editor studio-editor-page" data-map-builder="map.package" data-map-status="@editor.Status">
            @* Header strip — map glyph, title, lifecycle + validation badges, lifecycle actions. *@
            <div class="console-panel-heading studio-map-editor-bar">
                <div class="studio-map-editor-identity">
                    <span class="studio-map-glyph" aria-hidden="true">◐</span>
                    <div>
                        <p class="console-kicker">@(editor.IsExistingPackage ? $"{editor.MapId} · v{editor.Version}" : "New draft")</p>
                        <input class="console-input studio-map-title-input" @bind="editor.Title" placeholder="Public works map" aria-label="Map title" />
                    </div>
                </div>
                <div class="console-chip-row studio-map-status-chips">
                    <span class="console-status @(editor.IsPublished ? string.Empty : "console-status-warning")">@editor.Status</span>
                    <span class="console-status @(readiness.CanPublish ? string.Empty : "console-status-warning")">@(readiness.CanPublish ? "validation passed" : $"{readiness.UnmetRequirements.Count} to resolve")</span>
                </div>
                <div class="console-action-row studio-map-actions">
                    <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToList">Back to maps</button>
                    <button class="console-button" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="Save">Save draft</button>
                    <button class="console-button" type="button" disabled="@(_busy || editor.IsPublished || !readiness.CanPublish)" @onclick="Publish">Publish</button>
                    @if (editor.IsPublished)
                    {
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="Reopen">Reopen as draft</button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_status))
            {
                <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
            }

            @* Editor section tabs — Design / Data bindings / Interactions / Access / Package · raw. *@
            <nav class="console-tab-row studio-map-tabs" aria-label="Map editor sections">
                @foreach (var tab in EditorTabs)
                {
                    <button type="button"
                            class="@(string.Equals(_activeTab, tab.Id, StringComparison.Ordinal) ? "active" : null)"
                            aria-current="@(string.Equals(_activeTab, tab.Id, StringComparison.Ordinal) ? "true" : null)"
                            @onclick="() => SetTab(tab.Id)">
                        @tab.Label@(tab.Count is { } count ? $" · {count}" : null)
                    </button>
                }
            </nav>

            @if (string.Equals(_activeTab, "design", StringComparison.Ordinal))
            {
                @* Three-column design surface: layer list · live preview · selected-layer inspector. *@
                <div class="studio-map-design-grid">
                    @* LEFT — layer stack + per-layer filter. *@
                    <article class="console-panel studio-map-layer-rail">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Layers, filters, style, and popups</p>
                                <h3>Layer stack</h3>
                            </div>
                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="AddLayer">Add layer</button>
                        </div>

                        @if (editor.Layers.Count == 0)
                        {
                            <p class="console-muted">No layers yet. Add at least one layer before publishing. The first layer draws on top.</p>
                        }

                        <ol class="studio-map-layer-list">
                            @for (var index = 0; index < editor.Layers.Count; index++)
                            {
                                var layer = editor.Layers[index];
                                var position = index;
                                <li class="@(position == _selectedLayerIndex ? "studio-map-layer-item studio-map-layer-selected" : "studio-map-layer-item")" @key="layer">
                                    <div class="studio-map-layer-select">
                                        <input type="checkbox" @bind="layer.Visible" aria-label="Layer visible" />
                                        <button type="button" class="studio-map-layer-name" @onclick="() => SelectLayer(position)">
                                            @(string.IsNullOrWhiteSpace(layer.Title) ? (string.IsNullOrWhiteSpace(layer.SourceRef) ? "Untitled layer" : layer.SourceRef) : layer.Title)
                                        </button>
                                        <span class="console-muted studio-map-layer-kind">@(string.IsNullOrWhiteSpace(layer.Style) ? "unstyled" : layer.Style)</span>
                                    </div>
                                    <div class="console-action-row studio-map-layer-move">
                                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished || position == 0)" @onclick="() => MoveLayerUp(position)">Move up</button>
                                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished || position == editor.Layers.Count - 1)" @onclick="() => MoveLayerDown(position)">Move down</button>
                                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="() => RemoveLayer(layer)">Remove</button>
                                    </div>
                                </li>
                            }
                        </ol>
                    </article>

                    @* MIDDLE — live preview canvas + applied-state chips. *@
                    <article class="console-panel studio-map-canvas-panel">
                        <div class="studio-preview-toolbar">
                            <span class="console-kicker">Preview</span>
                            <span class="console-muted">Edits apply live · sampled features</span>
                        </div>
                        <div class="studio-map-preview" role="img" aria-label="Map preview">
                            <span>@(string.IsNullOrWhiteSpace(editor.Basemap) ? "basemap unset" : editor.Basemap)</span>
                            <strong>@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled map" : editor.Title)</strong>
                            <small>@editor.Layers.Count layer(s) · @(string.IsNullOrWhiteSpace(editor.InitialExtent) ? "extent unset" : editor.InitialExtent)</small>
                        </div>
                        <div class="console-chip-row studio-map-applied-chips">
                            @if (editor.ShowLegend)
                            {
                                <span>legend</span>
                            }
                            @if (editor.PopupsEnabled)
                            {
                                <span>popups</span>
                            }
                            @if (editor.InteractionsEnabled)
                            {
                                <span>pan/zoom</span>
                            }
                            <span>basemap: @(string.IsNullOrWhiteSpace(editor.Basemap) ? "unset" : editor.Basemap)</span>
                        </div>
                    </article>

                    @* RIGHT — inspector for the selected layer (style + filter + popup). *@
                    <aside class="studio-inspector studio-map-inspector">
                        @if (selectedLayer is null)
                        {
                            <p class="console-kicker">Inspector</p>
                            <p class="console-muted">Select a layer to edit its source, filter, style, and popup.</p>
                        }
                        else
                        {
                            <p class="console-kicker">@(string.IsNullOrWhiteSpace(selectedLayer.Title) ? "Layer" : selectedLayer.Title) · paint</p>
                            <h3>Layer style</h3>
                            <label class="studio-form-label"><span>Source ref</span><input class="console-input" @bind="selectedLayer.SourceRef" placeholder="content:hydrants@v12" /></label>
                            <label class="studio-form-label"><span>Title</span><input class="console-input" @bind="selectedLayer.Title" placeholder="Hydrants" /></label>
                            <label class="studio-form-label"><span>Style</span><input class="console-input" @bind="selectedLayer.Style" placeholder="style:point-red" /></label>

                            <div class="studio-inspector-section">
                                <h3>Filter</h3>
                                <label class="studio-form-label"><span>WHERE clause</span><input class="console-input" @bind="selectedLayer.Filter" placeholder="status = 'active'" /></label>
                            </div>

                            <div class="studio-inspector-section">
                                <h3>Popup template</h3>
                                <label class="studio-form-label"><span>Popup fields (comma-separated)</span><input class="console-input" @bind="selectedLayer.PopupFields" placeholder="asset_id, condition" /></label>
                            </div>
                        }
                    </aside>
                </div>

                @* Map frame — basemap + initial extent (the editor's spatial frame). *@
                <article class="console-panel">
                    <p class="console-kicker">Basemap and extent</p>
                    <h3>Frame</h3>
                    <div class="console-panel-grid">
                        <label class="studio-form-label">
                            <span>Basemap</span>
                            <input class="console-input" @bind="editor.Basemap" placeholder="basemap:streets" />
                        </label>
                        <label class="studio-form-label">
                            <span>Initial extent (minX,minY,maxX,maxY)</span>
                            <input class="console-input" @bind="editor.InitialExtent" placeholder="-158.3,21.2,-157.6,21.7" />
                        </label>
                    </div>
                    <label class="studio-form-label">
                        <span>Description</span>
                        <textarea class="console-input" rows="2" @bind="editor.Description"></textarea>
                    </label>
                </article>
            }
            else if (string.Equals(_activeTab, "interactions", StringComparison.Ordinal))
            {
                <article class="console-panel">
                    <p class="console-kicker">Interactions and legend</p>
                    <h3>Map behavior</h3>
                    <div class="console-chip-row studio-map-toggles">
                        <label><input type="checkbox" @bind="editor.ShowLegend" /> <span>Show legend</span></label>
                        <label><input type="checkbox" @bind="editor.PopupsEnabled" /> <span>Enable popups</span></label>
                        <label><input type="checkbox" @bind="editor.InteractionsEnabled" /> <span>Allow pan/zoom</span></label>
                    </div>
                </article>
            }
            else if (string.Equals(_activeTab, "package", StringComparison.Ordinal))
            {
                <article class="console-panel">
                    <p class="console-kicker">Package · raw</p>
                    <h3>Map package envelope</h3>
                    <p class="console-muted">Canonical authoring body saved to the honua-server map package version.</p>
                    <pre class="studio-code studio-package-json">@PackageJson(editor)</pre>
                </article>
            }
            else
            {
                @* Access — publish review (visibility, route, dependencies, sharing policy). *@
                <article class="console-panel studio-map-publish-review" aria-labelledby="map-publish-review-heading">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Publish review</p>
                            <h3 id="map-publish-review-heading">Review before publish</h3>
                        </div>
                        <span class="console-status @(readiness.CanPublish ? string.Empty : "console-status-warning")">@(readiness.CanPublish ? "ready" : $"{readiness.UnmetRequirements.Count} to resolve")</span>
                    </div>

                    <div class="studio-editor-shell">
                        <div class="studio-editor-main">
                            <section class="studio-editor-section">
                                <h3>Visibility</h3>
                                <p class="console-muted">Who can see this map after publish.</p>
                                <div class="studio-map-visibility-options">
                                    @foreach (var option in VisibilityOptions)
                                    {
                                        var tier = option.Value;
                                        <label class="@(string.Equals(editor.ShareTier, tier, StringComparison.Ordinal) ? "studio-map-visibility-option studio-map-visibility-selected" : "studio-map-visibility-option")">
                                            <input type="radio"
                                                   name="map-visibility"
                                                   value="@tier"
                                                   checked="@(string.Equals(editor.ShareTier, tier, StringComparison.Ordinal))"
                                                   disabled="@editor.IsPublished"
                                                   @onchange="() => editor.ShareTier = tier" />
                                            <span>
                                                <strong>@option.Label</strong>
                                                <small class="console-muted">@option.Description</small>
                                            </span>
                                        </label>
                                    }
                                </div>

                                <label class="studio-form-label studio-form-inline">
                                    <input type="checkbox" @bind="editor.EmbedAllowed" disabled="@editor.IsPublished" />
                                    <span>Allow embed</span>
                                </label>
                            </section>

                            <section class="studio-editor-section">
                                <h3>Route</h3>
                                <dl class="console-definition-list">
                                    <dt>Public URL</dt>
                                    <dd class="studio-code">/m/@StudioMapPackageMapper.BuildPackageKey(editor)</dd>
                                </dl>
                            </section>
                        </div>

                        <aside class="studio-editor-side">
                            <article class="console-panel">
                                <h3>Map summary</h3>
                                <dl class="console-definition-list">
                                    <dt>Basemap</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(editor.Basemap) ? "unset" : editor.Basemap)</dd>
                                    <dt>Layers</dt>
                                    <dd>@editor.Layers.Count layer(s)</dd>
                                    <dt>Initial extent</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(editor.InitialExtent) ? "unset" : editor.InitialExtent)</dd>
                                    <dt>Visibility</dt>
                                    <dd>@editor.ShareTier</dd>
                                    <dt>Embed</dt>
                                    <dd>@(editor.EmbedAllowed ? "allowed" : "blocked")</dd>
                                </dl>
                            </article>

                            <article class="console-panel">
                                <h3>Dependencies</h3>
                                @if (editor.Layers.Count == 0)
                                {
                                    <p class="console-muted">No layer sources bound yet.</p>
                                }
                                else
                                {
                                    <table class="console-table">
                                        <tbody>
                                            @foreach (var layer in editor.Layers)
                                            {
                                                <tr>
                                                    <td>@(string.IsNullOrWhiteSpace(layer.SourceRef) ? "unbound" : layer.SourceRef)</td>
                                                    <td>data source</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </article>

                            <p class="console-muted">Publish is a governed operation — it produces an audit event and a content version.</p>
                        </aside>
                    </div>

                    @if (!editor.IsPublished && !readiness.CanPublish)
                    {
                        <p class="console-kicker">Pre-publish gate</p>
                        <ul class="studio-compact-list">
                            @foreach (var requirement in readiness.UnmetRequirements)
                            {
                                <li>@requirement</li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private bool _busy;
    private StudioMapWorkspace _workspace = new([], []);
    private StudioMapCapabilityState? _bindingState;
    private StudioMapCapabilityState? _listNotice;
    private StudioMapEditorState? _editor;
    private string? _status;
    private bool _statusFailed;
    private string _activeTab = "design";
    private int _selectedLayerIndex;

    private static readonly JsonSerializerOptions PackageJsonOptions = new() { WriteIndented = true };

    private static readonly IReadOnlyList<(string Value, string Label, string Description)> VisibilityOptions =
    [
        ("public", "Public", "Anyone with the link; default for public-read data."),
        ("workspace", "Organisation", "Anyone signed in to this workspace."),
        ("private", "Private", "Only you and admins."),
    ];

    private IReadOnlyList<(string Id, string Label, int? Count)> EditorTabs =>
    [
        ("design", "Design", null),
        ("data", "Data bindings", _editor?.Layers.Count),
        ("interactions", "Interactions", null),
        ("access", "Access", null),
        ("package", "Package · raw", null),
    ];

    private void SetTab(string tab)
    {
        // "Data bindings" surfaces the same layer rail as Design (the layer list is the data-binding view),
        // so route it to the design surface rather than a blank tab.
        _activeTab = string.Equals(tab, "data", StringComparison.Ordinal) ? "design" : tab;
    }

    private void SelectLayer(int index) => _selectedLayerIndex = index;

    private StudioMapLayerEditor? SelectedLayer(StudioMapEditorState editor)
    {
        if (editor.Layers.Count == 0)
        {
            return null;
        }

        if (_selectedLayerIndex < 0 || _selectedLayerIndex >= editor.Layers.Count)
        {
            _selectedLayerIndex = 0;
        }

        return editor.Layers[_selectedLayerIndex];
    }

    private static string PackageJson(StudioMapEditorState editor) =>
        JsonSerializer.Serialize(StudioMapPackageMapper.BuildEnvelopeBody(editor), PackageJsonOptions);

    protected override Task OnInitializedAsync() => LoadWorkspaceAsync();

    private async Task LoadWorkspaceAsync()
    {
        _loading = true;
        _workspace = await MapData.GetWorkspaceAsync();
        ApplyStates(_workspace.CapabilityStates);
        // A non-blocking workspace state (e.g. the server exposes no map list verb) is shown on the list
        // view so operators know existing maps cannot be enumerated yet but a new map can still be authored.
        _listNotice = _bindingState is null
            ? _workspace.CapabilityStates.FirstOrDefault(state =>
                !string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase))
            : null;
        _loading = false;
    }

    private Task NewMap() => RunLoadAsync(() => MapData.LoadAsync(null));

    private Task OpenMap(string mapId) => RunLoadAsync(() => MapData.LoadAsync(mapId));

    private async Task RunLoadAsync(Func<Task<StudioMapEditorLoad>> load)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _status = null;
        _statusFailed = false;
        try
        {
            var result = await load();
            ApplyStates(result.CapabilityStates);
            _editor = result.State;
            _activeTab = "design";
            _selectedLayerIndex = 0;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackToList()
    {
        _editor = null;
        _status = null;
        _statusFailed = false;
        // Awaited so the HTTP-backed reload's completion runs inside the Blazor event task and rerenders
        // the list (a fire-and-forget reload is not guaranteed to trigger StateHasChanged).
        await LoadWorkspaceAsync();
    }

    private void AddLayer()
    {
        if (_editor is null)
        {
            return;
        }

        _editor.Layers.Add(new StudioMapLayerEditor());
        _selectedLayerIndex = _editor.Layers.Count - 1;
    }

    private void RemoveLayer(StudioMapLayerEditor layer)
    {
        if (_editor is null)
        {
            return;
        }

        _editor.Layers.Remove(layer);
        if (_selectedLayerIndex >= _editor.Layers.Count)
        {
            _selectedLayerIndex = Math.Max(0, _editor.Layers.Count - 1);
        }
    }

    private void MoveLayerUp(int index)
    {
        if (_editor is null || index <= 0 || index >= _editor.Layers.Count)
        {
            return;
        }

        (_editor.Layers[index - 1], _editor.Layers[index]) = (_editor.Layers[index], _editor.Layers[index - 1]);
    }

    private void MoveLayerDown(int index)
    {
        if (_editor is null || index < 0 || index >= _editor.Layers.Count - 1)
        {
            return;
        }

        (_editor.Layers[index + 1], _editor.Layers[index]) = (_editor.Layers[index], _editor.Layers[index + 1]);
    }

    private Task Save() => RunCommandAsync(() => MapData.SaveDraftAsync(_editor!));

    private Task Publish() => RunCommandAsync(() => MapData.PublishAsync(_editor!));

    private Task Reopen() => RunCommandAsync(() => MapData.ReopenAsync(_editor!));

    private async Task RunCommandAsync(Func<Task<StudioMapCommandResult>> command)
    {
        if (_busy || _editor is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await command();
            _status = result.Message;
            _statusFailed = !result.Succeeded;

            if (result.State is not null)
            {
                _editor = result.State;
            }

            ApplyStates(result.Issue is null ? [] : [result.Issue]);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyStates(IReadOnlyList<StudioMapCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
    }
}
