    // Builds the MapPreview popup from the selected/first layer's authored popup fields. Returns null when
    // popups are disabled or no fields are bound, so the preview shows no fabricated popup.
    private static MapPreviewPopup? BuildPreviewPopup(StudioMapEditorState editor)
    {
        if (!editor.PopupsEnabled || editor.Layers.Count == 0)
        {
            return null;
        }

        var layer = editor.Layers[0];
        var names = (layer.PopupFields ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (names.Length == 0)
        {
            return null;
        }

        var fields = names
            .Select(name => new MapPreviewPopupField(name, "—"))
            .ToList();
        var title = string.IsNullOrWhiteSpace(layer.Title) ? "Feature" : layer.Title;
        return new MapPreviewPopup(title, fields);
    }

    // Derives a small style legend from the authored layers (one row per styled layer). When no layer has
    // a style, returns an empty list so no legend is drawn.
    private static IReadOnlyList<MapPreviewLegendEntry> BuildPreviewLegend(StudioMapEditorState editor)
    {
        if (!editor.ShowLegend)
        {
            return [];
        }

        var swatches = new[] { "#d9a23a", "#b56b1c", "#612d0a", "#7ca7b3", "#4a8b6f" };
        var styled = editor.Layers
            .Where(layer => !string.IsNullOrWhiteSpace(layer.Style))
            .Select((layer, index) => new MapPreviewLegendEntry(
                string.IsNullOrWhiteSpace(layer.Title) ? layer.Style : layer.Title,
                swatches[index % swatches.Length],
                layer.Style))
            .ToList();
        return styled;
    }

    private List<PublishWizardStep> BuildPublishSteps(StudioMapEditorState editor, StudioMapPublishReadiness readiness)
    {
        return
        [
            new PublishWizardStep("Validate", BuildValidateStep(editor, readiness), IsValid: readiness.CanPublish && !_validation.HasBlockingClientErrors, ContinueLabel: "Continue · Dependencies →"),
            new PublishWizardStep("Dependencies", BuildDependenciesStep(editor), ContinueLabel: "Continue · Visibility →"),
            new PublishWizardStep("Visibility", BuildVisibilityStep(editor), ContinueLabel: "Continue · Embed →"),
            new PublishWizardStep("Embed", BuildEmbedStep(editor), ContinueLabel: "Continue · Rollback →"),
            new PublishWizardStep("Rollback", BuildRollbackStep(editor), ContinueLabel: "Continue · Confirm →"),
            new PublishWizardStep("Confirm", BuildConfirmStep(editor, readiness)),
        ];
    }

