@page "/studio/map"
@using System.Text.Json
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Validation
@inject IStudioMapPackageDataSource MapData
@inject IStudioMapStyleCatalogDataSource StyleCatalog

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have unsaved map changes. Leave this page and discard them?" />

<section class="console-page studio-map-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>Map builder</h1>
        <p>Author a server-owned map package — layers, filters, style, popup, legend, basemap, extent, and interactions — then review the publish, share, embed, and rollback settings before publishing to honua-server.</p>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Map builder"
                          Title="Loading map packages"
                          Message="Reading the map package lifecycle from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Map package lifecycle is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else if (_editor is null)
    {
        <div class="console-toolbar">
            <button class="console-button" type="button" disabled="@_busy" @onclick="NewMap">New from prompt</button>
        </div>

        @if (_listNotice is not null)
        {
            <ConsoleStateView Kind="info"
                              Kicker="@_listNotice.State"
                              Title="Map packages cannot be listed yet"
                              Message="@($"{_listNotice.Detail} (contract: {_listNotice.Contract})")" />
        }

        @if (_workspace.Packages.Count == 0 && _listNotice is null)
        {
            <EmptyState Area="studio" Subject="map packages" />
        }
        else if (_workspace.Packages.Count > 0)
        {
            <div class="console-table-wrap">
                <table class="console-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Layers</th>
                            <th>Draft</th>
                            <th>Published</th>
                            <th>Updated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var package in _workspace.Packages)
                        {
                            <tr>
                                <td>
                                    <button type="button" class="console-button console-button-secondary" disabled="@_busy" @onclick="() => OpenMap(package.MapId)">@package.Title</button>
                                    <small>@package.MapId</small>
                                </td>
                                <td>@package.LayerCount</td>
                                <td>@(package.DraftVersion?.ToString() ?? "—")</td>
                                <td>@(package.PublishedVersion?.ToString() ?? "—")</td>
                                <td>@package.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        var editor = _editor;
        var readiness = StudioMapPublishEvaluator.Evaluate(editor);
        // Publish is gated on BOTH the pre-publish presence gate and the client validator's blocking findings
        // (e.g. a present-but-inverted initial extent), so the inline validation gates publish consistently
        // with Save rather than falling through to the server.
        var canPublish = readiness.CanPublish && !_validation.HasBlockingClientErrors;
        var selectedLayer = SelectedLayer(editor);

        @if (_view == EditorView.FromPrompt)
        {
            @* StudioMapAI — conversation + clarification + right-side package inspector with a MapPreview. *@
            <div class="studio-map-ai" data-map-ai="map.package" data-map-status="@editor.Status">
                <StudioAiConversation ConversationTitle="Map from prompt"
                                      RefinePlaceholder="Refine, or ask a follow-up…"
                                      Turns="_turns"
                                      Clarifications="_clarifications"
                                      Busy="_busy"
                                      OnSend="OnPromptSend"
                                      OnAnswer="OnClarificationAnswered"
                                      OnEvidence="OnEvidenceRequested">
                    <SecondaryRefineActions>
                        <button type="button" class="console-button console-button-secondary studio-ai-attach" disabled="@_busy" @onclick="AttachData">Attach data</button>
                    </SecondaryRefineActions>
                    <PreviewHeader>
                        <span class="studio-map-glyph" aria-hidden="true">◐</span>
                        <input class="console-input studio-map-title-input" @bind="editor.Title" @bind:after="OnEdit" placeholder="parcels-use-map" aria-label="Map title" />
                        <span class="console-status @(editor.IsPublished ? string.Empty : "console-status-warning")">@editor.Status</span>
                        <span class="console-status @(canPublish ? string.Empty : "console-status-warning")">@(canPublish ? "validation passed" : $"{(readiness.UnmetRequirements.Count + (_validation.HasBlockingClientErrors ? _validation.Summary.Count(e => e.IsBlocking) : 0))} to resolve")</span>
                        <div class="studio-ai-preview-head-spacer"></div>
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToList">Save draft</button>
                        <button class="console-button" type="button" disabled="@_busy" @onclick="OpenEditorFromPrompt">Open editor →</button>
                        <button class="console-button" type="button" disabled="@(_busy || editor.IsPublished || !canPublish)" @onclick="OpenPublishWizard">Publish…</button>
                    </PreviewHeader>
                    <PreviewContent>
                        <div class="studio-map-ai-inspect">
                            @* LEFT — package inspector driven by the real authoring state (never fabricated). *@
                            <aside class="studio-map-ai-package" aria-label="Map package">
                                <div class="studio-map-ai-package-head">
                                    <p class="console-kicker">Map package</p>
                                    <p class="studio-map-ai-package-id">@(string.IsNullOrWhiteSpace(editor.Title) ? "new map" : StudioMapPackageMapper.BuildPackageKey(editor)) · v@(editor.Version) @editor.Status</p>
                                </div>

                                <p class="console-muted studio-map-ai-section">Data bindings · @editor.Layers.Count(layer => !string.IsNullOrWhiteSpace(layer.SourceRef))</p>
                                @if (editor.Layers.Count == 0)
                                {
                                    <p class="console-muted">No layers bound yet. Open the editor to bind sources, or describe the map you want on the left.</p>
                                }
                                else
                                {
                                    <p class="console-muted studio-map-ai-section">Layers · @editor.Layers.Count</p>
                                    <ul class="studio-map-ai-layer-list">
                                        @foreach (var layer in editor.Layers)
                                        {
                                            <li class="studio-map-ai-layer">
                                                <span class="studio-mono studio-map-ai-layer-name">@(string.IsNullOrWhiteSpace(layer.Title) ? (string.IsNullOrWhiteSpace(layer.SourceRef) ? "untitled layer" : layer.SourceRef) : layer.Title)</span>
                                                <span class="console-muted">@(string.IsNullOrWhiteSpace(layer.Style) ? "unstyled" : layer.Style)@(string.IsNullOrWhiteSpace(layer.SourceRef) ? " · unbound" : null)</span>
                                            </li>
                                        }
                                    </ul>
                                }

                                <p class="console-muted studio-map-ai-section">Initial extent</p>
                                <div class="studio-mono studio-map-ai-extent">@(string.IsNullOrWhiteSpace(editor.InitialExtent) ? "extent unset" : editor.InitialExtent)</div>

                                <p class="console-muted studio-map-ai-section">Pre-publish</p>
                                @if (readiness.CanPublish)
                                {
                                    <div class="studio-map-ai-validation studio-map-ai-validation-ok">All pre-publish requirements met.</div>
                                }
                                else
                                {
                                    <ul class="studio-compact-list studio-map-ai-validation">
                                        @foreach (var requirement in readiness.UnmetRequirements)
                                        {
                                            <li>@requirement</li>
                                        }
                                    </ul>
                                }

                                <details class="studio-map-ai-raw">
                                    <summary>View raw package JSON</summary>
                                    <pre class="studio-code studio-package-json">@PackageJson(editor)</pre>
                                </details>
                            </aside>

                            @* RIGHT — preview with a preview/mobile toggle over the shared MapPreview. *@
                            <div class="studio-map-ai-preview">
                                <div class="studio-preview-toolbar">
                                    <div class="studio-map-ai-device" role="group" aria-label="Preview device">
                                        <button type="button"
                                                class="@(_previewDevice == PreviewDevice.Preview ? "active" : null)"
                                                aria-pressed="@(_previewDevice == PreviewDevice.Preview)"
                                                @onclick="() => SetPreviewDevice(PreviewDevice.Preview)">Preview</button>
                                        <button type="button"
                                                class="@(_previewDevice == PreviewDevice.Mobile ? "active" : null)"
                                                aria-pressed="@(_previewDevice == PreviewDevice.Mobile)"
                                                @onclick="() => SetPreviewDevice(PreviewDevice.Mobile)">Mobile</button>
                                    </div>
                                    <div class="studio-preview-toolbar-spacer"></div>
                                    <span class="console-muted">sampled features</span>
                                </div>
                                <div class="@(_previewDevice == PreviewDevice.Mobile ? "studio-map-ai-canvas studio-map-ai-canvas-mobile" : "studio-map-ai-canvas")">
                                    <MapPreview Mode="MapPreviewMode.Layer"
                                                Height="@(_previewDevice == PreviewDevice.Mobile ? 460 : 420)"
                                                ScaleText="1:1,000,000"
                                                ShowPopup="editor.PopupsEnabled"
                                                ShowLabels="true"
                                                Popup="BuildPreviewPopup(editor)"
                                                Legend="BuildPreviewLegend(editor)"
                                                LegendTitle="@(editor.ShowLegend ? "Use code" : null)"
                                                AriaLabel="Map package preview" />
                                </div>
                            </div>
                        </div>
                    </PreviewContent>
                </StudioAiConversation>
            </div>
        }
        else
        {
        <div class="studio-map-editor studio-editor-page" data-map-builder="map.package" data-map-status="@editor.Status">
            @* Header strip — map glyph, title, lifecycle + validation badges, lifecycle actions. *@
            <div class="console-panel-heading studio-map-editor-bar">
                <div class="studio-map-editor-identity">
                    <span class="studio-map-glyph" aria-hidden="true">◐</span>
                    <div>
                        <p class="console-kicker">@(editor.IsExistingPackage ? $"{editor.MapId} · v{editor.Version}" : "New draft")</p>
                        <input class="console-input studio-map-title-input" @bind="editor.Title" @bind:after="OnEdit" placeholder="Public works map" aria-label="Map title" />
                        <ValidationMessageInline FieldKey="@StudioMapFieldKeys.Title" State="_validation" />
                    </div>
                </div>
                <div class="console-chip-row studio-map-status-chips">
                    <span class="console-status @(editor.IsPublished ? string.Empty : "console-status-warning")">@editor.Status</span>
                    <span class="console-status @(canPublish ? string.Empty : "console-status-warning")">@(canPublish ? "validation passed" : $"{(readiness.UnmetRequirements.Count + (_validation.HasBlockingClientErrors ? _validation.Summary.Count(e => e.IsBlocking) : 0))} to resolve")</span>
                    @* Presence affordance — opens the live Activity rail. Collaboration is unbound until
                       honua-server#1278 ships, so this advertises the surface without fabricating a count. *@
                    <button type="button" class="console-status studio-map-collab-presence-chip" data-collab-presence-chip @onclick='() => SetTab("activity")'>Collaborators</button>
                </div>
                <div class="console-action-row studio-map-actions">
                    @if (_cameFromPrompt)
                    {
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToChat">← Back to chat</button>
                    }
                    <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToList">Back to maps</button>
                    <button class="console-button" type="button" disabled="@(_busy || editor.IsPublished || _validation.HasBlockingClientErrors)" @onclick="Save">Save draft</button>
                    <button class="console-button" type="button" disabled="@(_busy || editor.IsPublished || !canPublish)" @onclick="OpenPublishWizard">Publish…</button>
                    @if (editor.IsPublished)
                    {
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="Reopen">Reopen as draft</button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_status))
            {
                <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
            }

            @if (_validation.HasBlockingClientErrors)
            {
                <article class="console-panel" aria-labelledby="map-validation-blocking-heading" data-validation-summary="blocking">
                    <p class="console-kicker">Validation</p>
                    <h3 id="map-validation-blocking-heading">Resolve before saving</h3>
                    <ul class="studio-compact-list">
                        @foreach (var error in _validation.Summary.Where(e => e.IsBlocking))
                        {
                            <li>@error.Message</li>
                        }
                    </ul>
                </article>
            }

            @* Editor section tabs — Design / Data bindings / Interactions / Access / Package · raw. *@
            <nav class="console-tab-row studio-map-tabs" aria-label="Map editor sections">
                @foreach (var tab in EditorTabs)
                {
                    <button type="button"
                            class="@(string.Equals(_activeTab, tab.Id, StringComparison.Ordinal) ? "active" : null)"
                            aria-current="@(string.Equals(_activeTab, tab.Id, StringComparison.Ordinal) ? "true" : null)"
                            @onclick="() => SetTab(tab.Id)">
                        @tab.Label@(tab.Count is { } count ? $" · {count}" : null)
                    </button>
                }
            </nav>

            @if (string.Equals(_activeTab, "design", StringComparison.Ordinal))
            {
                @* Three-column design surface: layer list · live preview · selected-layer inspector. *@
                <div class="studio-map-design-grid">
                    @* LEFT — layer stack + per-layer filter. *@
                    <article class="console-panel studio-map-layer-rail">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Layers, filters, style, and popups</p>
                                <h3>Layer stack</h3>
                            </div>
                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="AddLayer">Add layer</button>
                        </div>

                        @if (editor.Layers.Count == 0)
                        {
                            <p class="console-muted">No layers yet. Add at least one layer before publishing. The first layer draws on top.</p>
                        }

                        <ol class="studio-map-layer-list">
                            @for (var index = 0; index < editor.Layers.Count; index++)
                            {
                                var layer = editor.Layers[index];
                                var position = index;
                                <li class="@(position == _selectedLayerIndex ? "studio-map-layer-item studio-map-layer-selected" : "studio-map-layer-item")" @key="layer">
                                    <div class="studio-map-layer-select">
                                        <input type="checkbox" @bind="layer.Visible" @bind:after="OnEdit" aria-label="Layer visible" />
                                        <button type="button" class="studio-map-layer-name" @onclick="() => SelectLayer(position)">
                                            @(string.IsNullOrWhiteSpace(layer.Title) ? (string.IsNullOrWhiteSpace(layer.SourceRef) ? "Untitled layer" : layer.SourceRef) : layer.Title)
                                        </button>
                                        <span class="console-muted studio-map-layer-kind">@(string.IsNullOrWhiteSpace(layer.Style) ? "unstyled" : layer.Style)</span>
                                    </div>
                                    <div class="console-action-row studio-map-layer-move">
                                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished || position == 0)" @onclick="() => MoveLayerUp(position)">Move up</button>
                                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished || position == editor.Layers.Count - 1)" @onclick="() => MoveLayerDown(position)">Move down</button>
                                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="() => RemoveLayer(layer)">Remove</button>
                                    </div>
                                </li>
                            }
                        </ol>
                    </article>

                    @* MIDDLE — live preview canvas + applied-state chips. *@
                    <article class="console-panel studio-map-canvas-panel">
                        <div class="studio-preview-toolbar">
                            <span class="console-kicker">Preview</span>
                            <span class="console-muted">Edits apply live · sampled features</span>
                        </div>
                        <div class="studio-map-preview" role="img" aria-label="Map preview">
                            <span>@(string.IsNullOrWhiteSpace(editor.Basemap) ? "basemap unset" : editor.Basemap)</span>
                            <strong>@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled map" : editor.Title)</strong>
                            <small>@editor.Layers.Count layer(s) · @(string.IsNullOrWhiteSpace(editor.InitialExtent) ? "extent unset" : editor.InitialExtent)</small>
                        </div>
                        <div class="console-chip-row studio-map-applied-chips">
                            @if (editor.ShowLegend)
                            {
                                <span>legend</span>
                            }
                            @if (editor.PopupsEnabled)
                            {
                                <span>popups</span>
                            }
                            @if (editor.InteractionsEnabled)
                            {
                                <span>pan/zoom</span>
                            }
                            <span>basemap: @(string.IsNullOrWhiteSpace(editor.Basemap) ? "unset" : editor.Basemap)</span>
                        </div>
                    </article>

                    @* RIGHT — inspector for the selected layer (style + filter + popup). *@
                    <aside class="studio-inspector studio-map-inspector">
                        @if (selectedLayer is null)
                        {
                            <p class="console-kicker">Inspector</p>
                            <p class="console-muted">Select a layer to edit its source, filter, style, and popup.</p>
                        }
                        else
                        {
                            <p class="console-kicker">@(string.IsNullOrWhiteSpace(selectedLayer.Title) ? "Layer" : selectedLayer.Title) · paint</p>
                            <h3>Layer style</h3>
                            <label class="studio-form-label"><span>Source ref</span><input class="console-input" @bind="selectedLayer.SourceRef" @bind:after="OnEdit" placeholder="content:hydrants@v12" /></label>
                            <ValidationMessageInline FieldKey="@StudioMapFieldKeys.LayerSourceRef(_selectedLayerIndex)" State="_validation" />
                            <label class="studio-form-label"><span>Title</span><input class="console-input" @bind="selectedLayer.Title" @bind:after="OnEdit" placeholder="Hydrants" /></label>
                            <label class="studio-form-label">
                                <span>Style</span>
                                <StyleReferencePicker Value="@selectedLayer.Style"
                                                      ValueChanged="@(value => selectedLayer.Style = value)"
                                                      Catalog="_styleCatalog"
                                                      OnChanged="OnEdit" />
                            </label>

                            <div class="studio-inspector-section">
                                <h3>Filter</h3>
                                <label class="studio-form-label"><span>WHERE clause</span><input class="console-input" @bind="selectedLayer.Filter" @bind:after="OnEdit" placeholder="status = 'active'" /></label>
                            </div>

                            <div class="studio-inspector-section">
                                <h3>Popup template</h3>
                                <label class="studio-form-label"><span>Popup fields (comma-separated)</span><input class="console-input" @bind="selectedLayer.PopupFields" @bind:after="OnEdit" placeholder="asset_id, condition" /></label>
                            </div>
                        }
                    </aside>
                </div>

                @* Map frame — basemap + initial extent (the editor's spatial frame). *@
                <article class="console-panel">
                    <p class="console-kicker">Basemap and extent</p>
                    <h3>Frame</h3>
                    <div class="console-panel-grid">
                        <label class="studio-form-label">
                            <span>Basemap</span>
                            <input class="console-input" @bind="editor.Basemap" @bind:after="OnEdit" placeholder="basemap:streets" />
                            <ValidationMessageInline FieldKey="@StudioMapFieldKeys.Basemap" State="_validation" />
                        </label>
                        <label class="studio-form-label">
                            <span>Initial extent (minX,minY,maxX,maxY)</span>
                            <input class="console-input" @bind="editor.InitialExtent" @bind:after="OnEdit" placeholder="-158.3,21.2,-157.6,21.7" />
                            <ValidationMessageInline FieldKey="@StudioMapFieldKeys.InitialExtent" State="_validation" />
                        </label>
                    </div>
                    <label class="studio-form-label">
                        <span>Description</span>
                        <textarea class="console-input" rows="2" @bind="editor.Description" @bind:after="OnEdit"></textarea>
                    </label>
                    <ValidationMessageInline FieldKey="@StudioMapFieldKeys.Layers" State="_validation" />
                </article>
            }
            else if (string.Equals(_activeTab, "comments", StringComparison.Ordinal)
                || string.Equals(_activeTab, "activity", StringComparison.Ordinal))
            {
                @* Collaboration — multiplayer presence, named cursors, the per-draft markup layer,
                   feature-pinned comment pins + thread drawer, follow-mode, and the live activity feed.
                   Live collaboration data has no honua-server contract yet (honua-server#1278), so the
                   live slots render an explicit missing-binding state — never fabricated presence/comments. *@
                <article class="console-panel studio-map-collab-panel" data-collab-section="@_activeTab">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Multiplayer collaboration</p>
                            <h3>@(string.Equals(_activeTab, "comments", StringComparison.Ordinal) ? "Comments" : "Activity")</h3>
                        </div>
                    </div>
                    <StudioMapCollaboration MapId="@editor.MapId" Section="@_activeTab">
                        <div class="studio-map-preview" role="img" aria-label="Map preview">
                            <span>@(string.IsNullOrWhiteSpace(editor.Basemap) ? "basemap unset" : editor.Basemap)</span>
                            <strong>@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled map" : editor.Title)</strong>
                            <small>@editor.Layers.Count layer(s) · @(string.IsNullOrWhiteSpace(editor.InitialExtent) ? "extent unset" : editor.InitialExtent)</small>
                        </div>
                    </StudioMapCollaboration>
                </article>
            }
            else if (string.Equals(_activeTab, "interactions", StringComparison.Ordinal))
            {
                <article class="console-panel">
                    <p class="console-kicker">Interactions and legend</p>
                    <h3>Map behavior</h3>
                    <div class="console-chip-row studio-map-toggles">
                        <label><input type="checkbox" @bind="editor.ShowLegend" @bind:after="OnEdit" /> <span>Show legend</span></label>
                        <label><input type="checkbox" @bind="editor.PopupsEnabled" @bind:after="OnEdit" /> <span>Enable popups</span></label>
                        <label><input type="checkbox" @bind="editor.InteractionsEnabled" @bind:after="OnEdit" /> <span>Allow pan/zoom</span></label>
                    </div>
                </article>
            }
            else if (string.Equals(_activeTab, "package", StringComparison.Ordinal))
            {
                <article class="console-panel">
                    <p class="console-kicker">Package · raw</p>
                    <h3>Map package envelope</h3>
                    <p class="console-muted">Canonical authoring body saved to the honua-server map package version.</p>
                    <pre class="studio-code studio-package-json">@PackageJson(editor)</pre>
                </article>
            }
            else
            {
                @* Access — multi-step publish review wizard (Validate · Dependencies · Visibility · Embed · Rollback · Confirm). *@
                <article class="console-panel studio-map-publish-review" aria-labelledby="map-publish-review-heading">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Publish review</p>
                            <h3 id="map-publish-review-heading">Review before publish</h3>
                        </div>
                        <span class="console-status @(canPublish ? string.Empty : "console-status-warning")">@(canPublish ? "ready" : $"{(readiness.UnmetRequirements.Count + (_validation.HasBlockingClientErrors ? _validation.Summary.Count(e => e.IsBlocking) : 0))} to resolve")</span>
                    </div>

                    @{
                        var wizardSteps = BuildPublishSteps(editor, readiness);
                    }
                    <PublishWizard Steps="wizardSteps"
                                   Current="_publishStep"
                                   CurrentChanged="OnPublishStepChanged"
                                   Kicker="Publish map package"
                                   Title="@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled map" : editor.Title)"
                                   FinishLabel="Publish →"
                                   OnFinish="Publish">
                        <ExtraFooterActions>
                            <button type="button" class="console-button console-button-secondary" disabled="@(_busy || editor.IsPublished)" @onclick="Save">Save as draft</button>
                        </ExtraFooterActions>
                    </PublishWizard>
                </article>
            }
        </div>
        }
    }
</section>

@code {
    private enum EditorView
    {
        FromPrompt,
        Editor,
    }

    private enum PreviewDevice
    {
        Preview,
        Mobile,
    }

    private bool _loading = true;
    private bool _busy;
    private StudioMapWorkspace _workspace = new([], []);
    private StudioMapStyleCatalog _styleCatalog = StudioMapStyleCatalog.Empty;
    private StudioMapCapabilityState? _bindingState;
    private StudioMapCapabilityState? _listNotice;
    private StudioMapEditorState? _editor;
    private string? _status;
    private bool _statusFailed;
    private string _activeTab = "design";
    private int _selectedLayerIndex;
    private int _publishStep;

    private EditorView _view = EditorView.Editor;
    private bool _cameFromPrompt;
    private PreviewDevice _previewDevice = PreviewDevice.Preview;

    private readonly ValidationState _validation = new();
    private readonly FormDirtyState _dirty = new();

    private readonly List<StudioConversationTurn> _turns = [];
    private readonly List<StudioConversationClarification> _clarifications = [];

    private static readonly JsonSerializerOptions PackageJsonOptions = new() { WriteIndented = true };

    private static readonly IReadOnlyList<(string Value, string Label, string Description)> VisibilityOptions =
    [
