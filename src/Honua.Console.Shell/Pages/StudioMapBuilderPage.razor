    protected override Task OnInitializedAsync() => LoadWorkspaceAsync();

    /// <summary>
    /// Re-runs the client cross-field/bounds validator over the current editor and flags the editor dirty.
    /// Called from the markup's <c>@bind:after</c> wiring on every bound edit (cheap and synchronous). Server
    /// findings in <see cref="_validation"/> are dropped on edit so a fixed server-reported issue never keeps
    /// Save gated (mirrors the Wave-1 form builder); the next save rebinds fresh diagnostics.
    /// </summary>
    private void OnEdit()
    {
        _dirty.MarkDirty();
        RecomputeClientErrors();
        _validation.SetServerErrors(Array.Empty<ConsoleFieldError>());
    }

    private void RecomputeClientErrors() =>
        _validation.SetClientErrors(_editor is null
            ? Array.Empty<ConsoleFieldError>()
            : StudioMapValidator.Instance.Evaluate(_editor));

    private async Task LoadWorkspaceAsync()
    {
        _loading = true;
        _workspace = await MapData.GetWorkspaceAsync();
        // The per-layer style picker (#161) binds to the styleIds the server advertises on /ogc/styles.
        // A capability issue (no server bound, missing permission, unsupported) is carried on the catalog so
        // the inspector picker degrades to the legacy free-form style input rather than blocking the load.
        _styleCatalog = await StyleCatalog.GetStyleCatalogAsync();
        ApplyStates(_workspace.CapabilityStates);
        // A non-blocking workspace state (e.g. the server exposes no map list verb) is shown on the list
        // view so operators know existing maps cannot be enumerated yet but a new map can still be authored.
        _listNotice = _bindingState is null
            ? _workspace.CapabilityStates.FirstOrDefault(state =>
                !string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase))
            : null;
        _loading = false;
    }

    private Task NewMap() => RunLoadAsync(() => MapData.LoadAsync(null), EditorView.FromPrompt);

    private Task OpenMap(string mapId) => RunLoadAsync(() => MapData.LoadAsync(mapId), EditorView.Editor);

    private async Task RunLoadAsync(Func<Task<StudioMapEditorLoad>> load, EditorView view)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _status = null;
        _statusFailed = false;
        try
        {
            var result = await load();
            ApplyStates(result.CapabilityStates);
            _editor = result.State;
            _activeTab = "design";
            _selectedLayerIndex = 0;
            _publishStep = 0;
            _view = view;
            _cameFromPrompt = view == EditorView.FromPrompt;
            _previewDevice = PreviewDevice.Preview;
            ResetConversation();

            // A fresh load is the clean baseline: drop local edits/dirty state and recompute client findings
            // against the loaded editor.
            _validation.Clear();
            _dirty.MarkClean();
            RecomputeClientErrors();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetConversation()
    {
        _turns.Clear();
        _clarifications.Clear();

        // The conversation log is Console-local authoring UX — it echoes the author's intent and Honua's
        // guidance, never fabricated package state. The right-side inspector/preview reflects the real
        // StudioMapEditorState. Until the author describes the map there are no turns and no clarifications.
        _turns.Add(new StudioConversationTurn(
            StudioConversationRole.Honua,
            "Describe the map you want — the layers, how features should be coloured, and what a popup should show — and I'll propose a map you can review and refine. Every proposal is grounded in the real catalog and validated on the server before it appears; nothing is fabricated.",
            "just now",
            StudioConversationTone.Neutral));
    }

    // A prompt/refine turn calls the server's natural-language map generation contract
    // (POST /api/v1/studio/map-packages/generate). The server grounds the proposal in the catalog and
    // validates it before returning, so the page only ever renders a server-produced map (status==generated,
    // the editor hydrates from the returned MapPackage), a structured clarification request, or an honest
    // unavailable/refused/blocked state — never a fabricated map (no-mock, Charter §11).
    private Task OnPromptSend(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt))
        {
            return Task.CompletedTask;
        }

        _turns.Add(new StudioConversationTurn(StudioConversationRole.You, prompt, "just now"));
        return GenerateAsync(new StudioMapGenerationRequest
        {
            Prompt = prompt,
            Conversation = SnapshotConversation()
        });
    }

    private Task OnClarificationAnswered((StudioConversationClarification Question, StudioConversationChoice Choice) answer)
    {
        _clarifications.RemoveAll(question => string.Equals(question.Id, answer.Question.Id, StringComparison.Ordinal));
        _turns.Add(new StudioConversationTurn(
            StudioConversationRole.You,
            $"{answer.Question.Label}: {answer.Choice.Label}",
            "just now"));

        return GenerateAsync(new StudioMapGenerationRequest
        {
            Prompt = string.Empty,
            Conversation = SnapshotConversation(),
            Answers = [new StudioMapGenerationAnswer(answer.Question.Id, answer.Choice.Id)]
        });
    }

    // The conversation context sent to the server is the turn log mapped to the server's user/assistant roles.
    private IReadOnlyList<StudioMapGenerationTurn> SnapshotConversation() =>
        _turns
            .Select(turn => new StudioMapGenerationTurn(
                turn.Role == StudioConversationRole.You ? "user" : "assistant",
                turn.Body))
            .ToArray();

    private async Task GenerateAsync(StudioMapGenerationRequest request)
    {
        if (_editor is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var outcome = await MapData.GenerateAsync(_editor, request);

            if (outcome.BindingState is not null)
            {
                // A missing binding blocks the whole surface; other capability issues surface as a chat note.
                if (string.Equals(outcome.BindingState.State, "Missing binding", StringComparison.OrdinalIgnoreCase))
                {
                    _bindingState = outcome.BindingState;
                    return;
                }

                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    $"{outcome.BindingState.Detail} (contract: {outcome.BindingState.Contract})",
                    "just now",
                    StudioConversationTone.Neutral));
                return;
            }

            var notes = outcome.Warnings.ToList();
            if (outcome.CapabilityState is { } capability
                && !string.Equals(capability.State, "supported", StringComparison.OrdinalIgnoreCase))
            {
                notes.Insert(0, $"{capability.Name}: {capability.State}{(string.IsNullOrWhiteSpace(capability.Reason) ? string.Empty : $" — {capability.Reason}")}");
            }

            if (outcome.IsGenerated)
            {
                if (outcome.State is not null)
                {
                    _editor = outcome.State;
                }

                _clarifications.Clear();
                _selectedLayerIndex = 0;
                _dirty.MarkDirty();
                RecomputeClientErrors();

                var summary = string.IsNullOrWhiteSpace(outcome.Rationale)
                    ? $"Proposed a map · {_editor.Layers.Count} layer(s). Refine by chatting, or open the editor."
                    : outcome.Rationale;
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(summary, notes),
                    "just now",
                    StudioConversationTone.Ready,
                    "view evidence"));
            }
            else if (outcome.NeedsClarification)
            {
                _clarifications.Clear();
                _clarifications.AddRange(outcome.Clarifications);
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(
                        string.IsNullOrWhiteSpace(outcome.Rationale)
                            ? "I need a little more detail before I can propose the map."
                            : outcome.Rationale,
                        notes),
                    "just now",
                    StudioConversationTone.Clarification));
            }
            else
            {
                // unsupported / refused / error
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(
                        string.IsNullOrWhiteSpace(outcome.Rationale)
                            ? "I couldn't turn that into a map."
                            : outcome.Rationale,
                        notes),
                    "just now",
                    StudioConversationTone.Neutral));
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string AppendNotes(string body, IReadOnlyList<string> notes) =>
        notes.Count == 0 ? body : $"{body}\n\nNotes:\n- {string.Join("\n- ", notes)}";

