    private async Task BackToList()
    {
        _editor = null;
        _status = null;
        _statusFailed = false;
        _view = EditorView.Editor;
        _cameFromPrompt = false;
        _validation.Clear();
        _dirty.MarkClean();
        // Awaited so the HTTP-backed reload's completion runs inside the Blazor event task and rerenders
        // the list (a fire-and-forget reload is not guaranteed to trigger StateHasChanged).
        await LoadWorkspaceAsync();
    }

    private void AddLayer()
    {
        if (_editor is null)
        {
            return;
        }

        _editor.Layers.Add(new StudioMapLayerEditor());
        _selectedLayerIndex = _editor.Layers.Count - 1;
        OnEdit();
    }

    private void RemoveLayer(StudioMapLayerEditor layer)
    {
        if (_editor is null)
        {
            return;
        }

        _editor.Layers.Remove(layer);
        if (_selectedLayerIndex >= _editor.Layers.Count)
        {
            _selectedLayerIndex = Math.Max(0, _editor.Layers.Count - 1);
        }

        OnEdit();
    }

    private void MoveLayerUp(int index)
    {
        if (_editor is null || index <= 0 || index >= _editor.Layers.Count)
        {
            return;
        }

        (_editor.Layers[index - 1], _editor.Layers[index]) = (_editor.Layers[index], _editor.Layers[index - 1]);
        OnEdit();
    }

    private void MoveLayerDown(int index)
    {
        if (_editor is null || index < 0 || index >= _editor.Layers.Count - 1)
        {
            return;
        }

        (_editor.Layers[index + 1], _editor.Layers[index]) = (_editor.Layers[index], _editor.Layers[index + 1]);
        OnEdit();
    }

    private Task Save() => RunCommandAsync(() => MapData.SaveDraftAsync(_editor!));

    private Task Publish()
    {
        // Defence in depth: never let a publish fall through to the server while the client validator has a
        // blocking finding (e.g. a present-but-inverted initial extent that passes the presence-only gate).
        if (_validation.HasBlockingClientErrors)
        {
            _status = "Resolve the blocking validation findings before publishing.";
            _statusFailed = true;
            return Task.CompletedTask;
        }

        return RunCommandAsync(() => MapData.PublishAsync(_editor!));
    }

    private Task Reopen() => RunCommandAsync(() => MapData.ReopenAsync(_editor!));

    private async Task RunCommandAsync(Func<Task<StudioMapCommandResult>> command)
    {
        if (_busy || _editor is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await command();
            _status = result.Message;
            _statusFailed = !result.Succeeded;

            if (result.State is not null)
            {
                _editor = result.State;
            }

            // Re-run the client validator against the post-command editor and bind any server validation
            // diagnostics the command surfaced onto their fields (JSON-Pointer → console field key). A
            // successful command leaves the editor on a clean, server-synced baseline.
            RecomputeClientErrors();
            _validation.SetServerErrors(result.FieldErrors);
            if (result.Succeeded)
            {
                _dirty.MarkClean();
            }

            ApplyStates(result.Issue is null ? [] : [result.Issue]);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyStates(IReadOnlyList<StudioMapCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
    }
