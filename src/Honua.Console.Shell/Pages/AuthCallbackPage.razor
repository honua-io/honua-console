@page "/admin/auth/callback"
@page "/auth/callback"
@inject NavigationManager Navigation
@inject IServiceProvider Services

<section class="console-page">
    <div class="console-panel" role="status">
        <h1>Complete sign-in</h1>
        @if (_failed)
        {
            <p>Sign-in could not finish. Start again to request a new sign-in session.</p>
            <a class="console-button-link" href="@Navigation.ToConsoleHref("/auth/signin")">Return to sign-in</a>
        }
        else
        {
            <p>Confirming your environment session…</p>
        }
    </div>
</section>

@code {
    private bool _failed;

    protected override async Task OnInitializedAsync()
    {
        var code = ConsoleUrlQuery.GetValue(Navigation.Uri, "code");
        var state = ConsoleUrlQuery.GetValue(Navigation.Uri, "state");
        var error = ConsoleUrlQuery.GetValue(Navigation.Uri, "error");
        // Remove authorization material from browser history before contacting the API.
        Navigation.NavigateTo(Navigation.ToConsoleHref("/admin/auth/callback"), replace: true);
        var authentication = Services.GetService<IConsoleOidcAuthentication>();
        if (authentication?.IsAvailable != true || !string.IsNullOrEmpty(error)
            || string.IsNullOrWhiteSpace(code) || string.IsNullOrWhiteSpace(state))
        {
            _failed = true;
            return;
        }
        try
        {
            var returnTo = await authentication.CompleteAsync(code, state);
            Navigation.NavigateTo(Navigation.ToConsoleHref(Honua.Console.Shell.Security.ConsoleReturnUrl.Sanitize(returnTo)), replace: true);
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or InvalidOperationException or Microsoft.JSInterop.JSException)
        {
            _failed = true;
        }
    }
}
