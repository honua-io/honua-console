@page "/operate/layers/{ResourceId}/relationships"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IOperateTransitionDataSource OperateData
@inject IConsoleLayerRelationshipsOperation LayerRelationships
@inject IConsoleNotificationService Notifications
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page" data-relationships-page>
    @if (_loading)
    {
        <p role="status">Loading layer…</p>
    }
    else if (_layer is null)
    {
        <MissingItemView Kind="layer" AreaLabel="Operate / Layers" />
    }
    else
    {
        @if (V4Enabled)
        {
            <ConsolePageHeading Title="@($"{_layer.Name} · relationships")">
                <ChildContent><p>Connect this layer to related records.</p></ChildContent>
                <Actions><LayerBackLink CanonicalResourceId="@_layer!.CanonicalResourceId" /></Actions>
            </ConsolePageHeading>
        }
        else
        {
            <div class="console-page-heading">
                <p class="console-kicker">Operate / Layers</p>
                <h1>@_layer.Name · relationships</h1>
                <p>Author origin/destination relationships on layer @_layer.LayerId. honua-server emits these as <code>relationships[]</code> on FeatureServer layer metadata and uses them to drive related-records / <code>$expand</code> / relationshipQuery.</p>
                <div class="console-detail-actions">
                    <a class="console-button-link" href="@Navigation.ToConsoleHref(ConsoleAgentLayerTool.LayerRoute(_layer!.CanonicalResourceId))" data-layer-detail-link>Back to layer</a>
                </div>
            </div>
        }

        @if (V4Enabled)
        {
            <ConsolePanel Title="Relationships" HeadingId="layer-relationships-heading" Class="console-section">@Editor</ConsolePanel>
        }
        else
        {
            <section class="console-section">@Editor</section>
        }
    }
</section>

@code {
    private bool V4Enabled => ServiceProvider.GetService<ConsoleV4Options>()?.Enabled == true;
    private RenderFragment Editor => @<div data-relationships-panel>
            @if (!_relationships.Bound)
            {
                <div class="@(V4Enabled ? "console-state console-state-warning" : "console-panel console-state-warning")" role="status" data-relationships-unbound>
                    <p class="@(V4Enabled ? null : "console-kicker")">Unavailable</p>
                    <p>@_relationships.Detail</p>
                </div>
            }
            else
            {
                <ConsoleTableRegion Class="console-table-wrap" Label="Layer relationships">
                    <table class="console-table" aria-label="Relationships">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Related layer</th>
                                <th>Role</th>
                                <th>Cardinality</th>
                                <th>Origin field</th>
                                <th>Destination field</th>
                                <th>GeoServices rel id</th>
                                <th aria-label="Actions">@(V4Enabled ? "Actions" : null)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_rows.Count == 0)
                            {
                                <tr data-relationships-empty><td colspan="8" class="console-muted">No relationships are authored on this layer yet.</td></tr>
                            }
                            else
                            {
                                @for (var i = 0; i < _rows.Count; i++)
                                {
                                    var row = _rows[i];
                                    <tr data-relationship-row>
                                        <td><input class="console-input" @bind="row.Name" aria-label="Relationship name" data-rel-name placeholder="parcels_owner" /></td>
                                        <td><input class="console-input console-input-narrow" type="number" @bind="row.RelatedLayerId" aria-label="Related layer id" data-rel-related /></td>
                                        <td>
                                            <select class="console-input" @bind="row.Role" aria-label="Role" data-rel-role>
                                                <option value="origin">origin</option>
                                                <option value="destination">destination</option>
                                            </select>
                                        </td>
                                        <td>
                                            <select class="console-input" @bind="row.Cardinality" aria-label="Cardinality" data-rel-cardinality>
                                                <option value="one-to-many">one-to-many</option>
                                                <option value="one-to-one">one-to-one</option>
                                                <option value="many-to-many">many-to-many</option>
                                            </select>
                                        </td>
                                        <td><input class="console-input" @bind="row.OriginField" aria-label="Origin field" data-rel-origin placeholder="id" /></td>
                                        <td><input class="console-input" @bind="row.DestinationField" aria-label="Destination field" data-rel-destination placeholder="parcel_id" /></td>
                                        <td><input class="console-input console-input-narrow" type="number" @bind="row.EsriRelationshipId" aria-label="GeoServices relationship id" data-rel-esri /></td>
                                        <td>
                                            <button class="console-button console-button-secondary" type="button"
                                                    @onclick="() => RemoveRow(row)" data-rel-remove aria-label="Remove relationship">Remove</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </ConsoleTableRegion>

                <div class="console-action-row">
                    <button class="console-button console-button-secondary" type="button" @onclick="AddRow" data-rel-add>Add relationship</button>
                    <button class="console-button" type="button" disabled="@_saving" @onclick="SaveAsync" data-rel-save>
                        @(_saving ? "Saving…" : "Save relationships")
                    </button>
                </div>

                @if (_result is { } r)
                {
                    <div class="@(V4Enabled ? "console-state" : "console-panel") @(r.Succeeded ? "console-state-success" : "console-state-danger")" role="status" data-relationships-result>
                        <p class="@(V4Enabled ? null : "console-kicker")">@r.State</p>
                        <p>@r.Detail</p>
                    </div>
                }
            }
    </div>;
    private string? _loadedResourceId;
    private long _generation;
    private bool _loading;
    private ConsoleAgentPageContext AgentContext =>
        ConsoleAgentLayerTool.Context(_layer, ResourceId, "relationships", ChangedFields, _loading || _saving);

    [CascadingParameter] public ConsolePublicationLayerContext? PublicationContext { get; set; }

    [Parameter]
    public string ResourceId { get; set; } = string.Empty;

    private OperateServiceLayerProjection? _layer;
    private ConsoleLayerRelationships _relationships = ConsoleLayerRelationships.Unbound("Loading…");
    private readonly List<RelationshipRow> _rows = new();
    private bool _saving;
    private ConsoleSetRelationshipsResult? _result;

    private ConsoleLayerRelationship[] _baseline = [];
    private int ChangedFields
    {
        get
        {
            var current = _rows.Select(row => row.ToModel()).ToArray();
            var changed = Math.Abs(current.Length - _baseline.Length);
            for (var i = 0; i < Math.Min(current.Length, _baseline.Length); i++)
            {
                var row = current[i];
                var original = _baseline[i];
                changed += (row.Name == original.Name ? 0 : 1)
                    + (row.RelatedLayerId == original.RelatedLayerId ? 0 : 1)
                    + (row.Role == original.Role ? 0 : 1)
                    + (row.Cardinality == original.Cardinality ? 0 : 1)
                    + (row.OriginField == original.OriginField ? 0 : 1)
                    + (row.DestinationField == original.DestinationField ? 0 : 1)
                    + (row.EsriRelationshipId == original.EsriRelationshipId ? 0 : 1);
            }
            return changed;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedResourceId, ResourceId, StringComparison.Ordinal)) return;
        _loadedResourceId = ResourceId;
        var generation = ++_generation;
        var resourceId = ResourceId;
        _layer = null;
        _result = null;
        _saving = false;
        _rows.Clear();
        _baseline = [];
        _relationships = ConsoleLayerRelationships.Unbound("Loading…");
        _loading = true;
        var attempt = PublicationContext?.BeginRead(resourceId);
        try
        {
            var view = await OperateData.GetLayersViewAsync();
            if (generation != _generation) return;
            var exposures = view.FindExposures(resourceId);
            if (attempt is { } read) PublicationContext!.CompleteRead(read, exposures);
            _layer = exposures.FirstOrDefault()?.Layer;
            if (_layer is null) return;
            var relationships = await LayerRelationships.GetRelationshipsAsync(_layer.LayerId);
            if (generation != _generation) return;
            _relationships = relationships;
            if (!relationships.Bound) return;
            _rows.AddRange(relationships.Relationships.Select(RelationshipRow.From));
            _baseline = _rows.Select(row => row.ToModel()).ToArray();
        }
        finally
        {
            if (generation == _generation) _loading = false;
        }
    }

    private void AddRow() => _rows.Add(new RelationshipRow());

    private void RemoveRow(RelationshipRow row) => _rows.Remove(row);

    private Task SaveAsync()
    {
        if (_layer is null || _saving) return Task.CompletedTask;
        var generation = _generation;
        var layerId = _layer.LayerId;
        var payload = _rows.Select(row => row.ToModel()).ToArray();
        _result = null;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                var result = await LayerRelationships.SetRelationshipsAsync(layerId, payload);
                if (generation != _generation) return;
                _result = result;
                if (!result.Succeeded) return;
                var relationships = await LayerRelationships.GetRelationshipsAsync(layerId);
                if (generation != _generation) return;
                _relationships = relationships;
                if (!relationships.Bound) return;
                var savedRows = relationships.Relationships.Select(RelationshipRow.From).ToArray();
                // Server normalization replaces the draft only when no newer edits exist.
                if (_rows.Select(row => row.ToModel()).SequenceEqual(payload))
                {
                    _rows.Clear();
                    _rows.AddRange(savedRows);
                }
                _baseline = savedRows.Select(row => row.ToModel()).ToArray();
            },
            setBusy: busy => { if (generation == _generation) { _saving = busy; StateHasChanged(); } },
            failureMessage: "Couldn't save relationships");
    }

    // Mutable per-row edit model bound to the inputs (the domain record is immutable).
    private sealed class RelationshipRow
    {
        public string? Id { get; set; }
        public string? Name { get; set; }
        public int? RelatedLayerId { get; set; }
        public string Role { get; set; } = "origin";
        public string Cardinality { get; set; } = "one-to-many";
        public string? OriginField { get; set; }
        public string? DestinationField { get; set; }
        public int? EsriRelationshipId { get; set; }

        public static RelationshipRow From(ConsoleLayerRelationship rel) => new()
        {
            Id = rel.Id,
            Name = rel.Name,
            RelatedLayerId = rel.RelatedLayerId,
            Role = string.IsNullOrWhiteSpace(rel.Role) ? "origin" : rel.Role,
            Cardinality = string.IsNullOrWhiteSpace(rel.Cardinality) ? "one-to-many" : rel.Cardinality,
            OriginField = rel.OriginField,
            DestinationField = rel.DestinationField,
            EsriRelationshipId = rel.EsriRelationshipId,
        };

        public ConsoleLayerRelationship ToModel() => new()
        {
            Id = Id,
            Name = Name,
            RelatedLayerId = RelatedLayerId,
            Role = Role,
            Cardinality = Cardinality,
            OriginField = OriginField,
            DestinationField = DestinationField,
            EsriRelationshipId = EsriRelationshipId,
        };
    }
}
