@page "/environments/new"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Validation
@inject IConsoleEnvironmentProfileStore Profiles
@inject NavigationManager Nav
@inject IServiceProvider Services

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have an unsaved environment profile. Leave this page and discard it?" />

<section class="console-page @(V4Enabled ? "console-environments-v4" : null)">
    @if (V4Enabled)
    {
        <link rel="stylesheet" href="_content/Honua.Console.Shell/css/environments-v4.css" />
        <ConsolePageHeading Title="Add environment">
            <p>Name your environment and enter its server's HTTPS address. You will sign in before accessing its data.</p>
        </ConsolePageHeading>
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Environments</p>
            <h1>Add environment</h1>
            <p>Name your environment and enter its server's HTTPS address. You will sign in before accessing its data.</p>
        </div>
    }

    <article class="console-panel">
        <div class="studio-field-grid">
            <label>
                <span>Display name</span>
                <input class="console-input" @bind="_displayName" @bind:after="OnEdit" id="environment-display-name" placeholder="My Honua server" />
                <ValidationMessageInline FieldKey="@EnvironmentProfileFieldKeys.DisplayName" State="_validation" />
            </label>
            <label>
                <span>Server URL</span>
                <input class="console-input" @bind="_serverBaseUri" @bind:after="OnEdit" id="environment-server-url" placeholder="https://gis.example.com" />
                <ValidationMessageInline FieldKey="@EnvironmentProfileFieldKeys.ServerBaseUri" State="_validation" />
            </label>
            <label>
                <span>Environment kind</span>
                <select class="console-input" @bind="_environmentKind" @bind:after="OnEdit">
                    <option value="development">development</option>
                    <option value="staging">staging</option>
                    <option value="production">production</option>
                </select>
            </label>
        </div>

        <details class="console-connection-details">
            <summary>Account settings</summary>
            <p class="console-muted">Choose your sign-in method and account. Sign-in determines your access.</p>
            <div class="studio-field-grid">
                <label>
                    <span>Access method</span>
                    <select class="console-input" @bind="_authMode" @bind:after="OnEdit">
                        <option value="@nameof(ConsoleAccountAuthMode.AccountRbac)">Sign in with an account</option>
                        <option value="@nameof(ConsoleAccountAuthMode.Anonymous)">Anonymous</option>
                    </select>
                </label>
                <label>
                    <span>Account ID</span>
                    <input class="console-input" @bind="_accountId" @bind:after="OnEdit" placeholder="operator.prod" />
                </label>
            </div>
        </details>

        @if (_validation.HasBlockingClientErrors)
        {
            <div class="console-validation-summary" data-environment-validation="blocking" role="alert">
                <p class="console-kicker">Resolve before creating</p>
                <ul>
                    @foreach (var error in _validation.Summary.Where(e => e.IsBlocking))
                    {
                        <li>@error.Message</li>
                    }
                </ul>
            </div>
        }

        <div class="console-action-row">
            <button class="console-button" type="button" disabled="@(_busy || _validation.HasBlockingClientErrors)" @onclick="CreateAsync">Connect and continue</button>
            <a href="@Nav.ToConsoleHref("/environments")">Cancel</a>
        </div>
    </article>
</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
    private string _displayName = string.Empty;
    private string _serverBaseUri = "https://";
    private string _environmentKind = "production";
    private string _accountId = string.Empty;
    private string _authMode = nameof(ConsoleAccountAuthMode.AccountRbac);
    private bool _busy;

    // The former ad-hoc CreateAsync presence/format checks now run through the shared validator so they render
    // inline with the same ConsoleFieldError/severity vocabulary as the Studio waves.
    private readonly ValidationState _validation = new();
    private readonly FormDirtyState _dirty = new();

    private void Revalidate() =>
        _validation.SetClientErrors(EnvironmentProfileValidator.Instance.Evaluate(
            new EnvironmentProfileState(_displayName, _serverBaseUri)));

    /// <summary>Marks the form dirty and re-runs the validator on every bound edit.</summary>
    private void OnEdit()
    {
        _dirty.MarkDirty();
        Revalidate();
    }

    private async Task CreateAsync()
    {
        Revalidate();
        if (_validation.HasBlockingClientErrors)
        {
            return;
        }

        // ServerBaseUri passed the absolute-https rule, so this parse always succeeds here.
        var serverUri = new Uri(_serverBaseUri.Trim(), UriKind.Absolute);

        _busy = true;

        var profileId = await ResolveUniqueIdAsync(Slugify(_displayName));
        var authMode = Enum.TryParse<ConsoleAccountAuthMode>(_authMode, out var parsedAuth)
            ? parsedAuth
            : ConsoleAccountAuthMode.AccountRbac;

        var profile = new ConsoleEnvironmentProfile
        {
            Id = profileId,
            DisplayName = _displayName.Trim(),
            ServerBaseUri = serverUri,
            EnvironmentKind = _environmentKind,
            Account = new ConsoleAccountBinding
            {
                AuthMode = authMode,
                AccountId = _accountId.Trim(),
                DisplayName = _displayName.Trim()
            }
        };

        await Profiles.UpsertProfileAsync(profile);

        // A successful save clears the dirty flag so the navigation guard lets the redirect through.
        _dirty.MarkClean();

        await Profiles.ActivateProfileAsync(profileId);
        Nav.NavigateTo(Nav.ToConsoleHref("/auth/signin"));
    }

    private async Task<string> ResolveUniqueIdAsync(string candidate)
    {
        var baseId = string.IsNullOrWhiteSpace(candidate) ? Guid.NewGuid().ToString("N")[..8] : candidate;
        var existing = await Profiles.ListProfilesAsync();
        var taken = existing.Select(profile => profile.Id).ToHashSet(StringComparer.Ordinal);
        if (!taken.Contains(baseId))
        {
            return baseId;
        }

        for (var suffix = 2; suffix < 100; suffix++)
        {
            var next = $"{baseId}-{suffix}";
            if (!taken.Contains(next))
            {
                return next;
            }
        }

        return $"{baseId}-{Guid.NewGuid():N}"[..16];
    }

    private static string Slugify(string value)
    {
        var slug = new string(value.Trim().ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : '-')
            .ToArray());
        slug = string.Join('-', slug.Split('-', StringSplitOptions.RemoveEmptyEntries));
        return slug;
    }
}
