@page "/share/public/items/{IdOrSlug}"
@page "/public/items/{IdOrSlug}"
@* Public surface (honua-console#233 S1 #2): open-data / public-link landing pages render for anonymous
   open-web visitors. The server-owned "public" projection (GetOpenDataItemAsync) still decides what is
   public; the attribute only opts this route out of the fail-closed operator-auth fallback. *@
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IConsoleCatalogClient Catalog
@inject IServiceProvider Services
@inject NavigationManager Navigation

<CatalogAvailabilityGate>
<section class="console-page share-opendata">
    @if (_result is null)
    {
        <ConsoleStateView Kind="loading" Kicker="Loading" Title="Loading public item" Message="The open-data item is loading." />
    }
    else if (_result.Status == CatalogReadStatus.Unavailable)
    {
        <ConsoleStateView Kind="error"
                          Kicker="Missing binding"
                          Title="Open data is not bound to honua-server"
                          Message="@(string.IsNullOrWhiteSpace(_result.Message) ? MissingBindingMessage : _result.Message)" />
    }
    else if (_result.Status != CatalogReadStatus.Allowed || _result.Item is null)
    {
        <ConsoleStateView Kind="missing" Kicker="Not public" Title="Public item not found" Message="This item is not available as public open data." ActionHref="/share/public" ActionLabel="Back To Open Data" />
    }
    else
    {
        var item = _result.Item;
        <article class="@(V4Enabled ? "share-opendata-landing share-opendata-v4" : "console-panel share-opendata-landing")" data-share-opendata-landing>
            @if (V4Enabled)
            {
                <a class="share-opendata-back" href="@Navigation.ToConsoleHref("/share/public")">Back to open data</a>
                <ConsolePageHeading Title="@item.Summary.Title">
                    <p class="console-muted">Open data · @CatalogContentTypes.LabelFor(item.Summary.Type)</p>
                </ConsolePageHeading>
                <div class="console-chip-row">
                    @foreach (var tag in item.Summary.Tags)
                    {
                        <span>#@tag</span>
                    }
                </div>
            }
            else
            {
                <header class="share-opendata-hero">
                    <p class="console-kicker">Open-data page <span class="console-crumb-sep">/</span> @CatalogContentTypes.LabelFor(item.Summary.Type)</p>
                    <h1>@item.Summary.Title</h1>
                    <div class="console-chip-row">
                        <span class="console-status console-state-success">public</span>
                        <span class="console-status console-state-info">open data</span>
                        @foreach (var tag in item.Summary.Tags)
                        {
                            <span>#@tag</span>
                        }
                    </div>
                </header>
            }

            <p class="share-opendata-intro">@item.Description</p>

            @if (V4Enabled)
            {
                <div data-share-opendata-downloads>
                    <ConsolePanel Title="Download" HeadingId="public-download-heading">
                        @DownloadContent(item)
                    </ConsolePanel>
                </div>
                @if (item.Publications.Any())
                {
                    <div data-share-opendata-routes>
                        <ConsolePanel Title="Routes" HeadingId="public-routes-heading">
                            @RoutesContent(item)
                        </ConsolePanel>
                    </div>
                }
            }
            else
            {
                <section class="share-opendata-downloads" data-share-opendata-downloads>
                    <p class="console-kicker">Download</p>
                    @DownloadContent(item)
                </section>
                @if (item.Publications.Any())
                {
                    <section class="share-opendata-routes" data-share-opendata-routes>
                        <p class="console-kicker">Routes</p>
                        @RoutesContent(item)
                    </section>
                }
            }

            <footer class="share-opendata-footer" data-share-opendata-footer>
                <p class="console-muted">Owner: @item.Summary.Owner</p>
                <p class="console-muted share-opendata-poweredby">Powered by Honua · public open-data</p>
            </footer>
        </article>
    }
</section>
</CatalogAvailabilityGate>

@code {
    internal const string MissingBindingMessage =
        "Configure Honua:Server:BaseUrl or HONUA_SERVER_BASE_URL so Console can bind the server-owned "
        + "open-data projection from honua-server. The merged runtime never renders seeded open-data content "
        + "(Console Patterns Charter section 11).";

    [Parameter]
    public string IdOrSlug { get; set; } = string.Empty;

    private CatalogItemReadResult? _result;
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    private RenderFragment DownloadContent(ConsoleContentDetail item) => @<text>
                @if (!item.Summary.Formats.Any())
                {
                    <p class="console-muted">No downloadable formats are published for this item.</p>
                }
                else
                {
                    <ul class="share-opendata-download-list">
                        @foreach (var format in item.Summary.Formats)
                        {
                            <li>
                                <span class="share-opendata-download-name">@DownloadFormatLabel(format)</span>
                                <span class="console-muted">download ↓</span>
                            </li>
                        }
                    </ul>
                }
    </text>;

    private string DownloadFormatLabel(string format) => V4Enabled ? format switch
    {
        "GeoServices:FeatureService" => "GeoServices feature service",
        "GeoServices:MapServer" => "GeoServices map service",
        "OGC:API:Features" => "OGC API Features",
        _ => format
    } : format;

    private static RenderFragment RoutesContent(ConsoleContentDetail item) => @<text>
                    <dl class="console-definition-list">
                        @foreach (var publication in item.Publications)
                        {
                            <dt>Route</dt>
                            <dd><code class="console-inline-code">@publication.Route</code></dd>
                        }
                    </dl>
    </text>;

    protected override async Task OnParametersSetAsync()
    {
        _result = await Catalog.GetOpenDataItemAsync(IdOrSlug);
    }
}
