@page "/share/public/items/{IdOrSlug}"
@page "/public/items/{IdOrSlug}"
@* Public surface (honua-console#233 S1 #2): open-data / public-link landing pages render for anonymous
   open-web visitors. The server-owned "public" projection (GetOpenDataItemAsync) still decides what is
   public; the attribute only opts this route out of the fail-closed operator-auth fallback. *@
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject IConsoleCatalogClient Catalog
@inject IServiceProvider Services
@inject NavigationManager Navigation

<CatalogAvailabilityGate>
<section class="console-page share-opendata">
    @if (_result is null)
    {
        <ConsoleStateView Kind="loading" Kicker="Loading" Title="Loading public item" Message="The open-data item is loading." />
    }
    else if (_result.Status == CatalogReadStatus.Unavailable)
    {
        <ConsoleStateView Kind="error"
                          Kicker="Missing binding"
                          Title="Open data is not bound to honua-server"
                          Message="@(string.IsNullOrWhiteSpace(_result.Message) ? MissingBindingMessage : _result.Message)" />
    }
    else if (_result.Status != CatalogReadStatus.Allowed || _result.Item is null)
    {
        <ConsoleStateView Kind="missing" Kicker="Not public" Title="Public item not found" Message="This item is not available as public open data." ActionHref="/share/public" ActionLabel="Back To Open Data" />
    }
    else
    {
        var item = _result.Item;
        @if (V4Enabled)
        {
            var summary = item.Summary;
            var viewer = ConsoleCatalogActionPolicy.Resolve(summary, isAuthenticated: false)
                .FirstOrDefault(action => action.Id == "viewer");
            <article class="share-opendata-landing share-opendata-v4" data-share-opendata-landing>
                <nav aria-label="Breadcrumb">
                    <a class="share-opendata-back" href="@Navigation.ToConsoleHref("/share/public")">Open-data catalog</a>
                    <span aria-hidden="true"> / </span>
                    <span aria-current="page">@summary.Title</span>
                </nav>
                @if (!string.IsNullOrWhiteSpace(summary.Type))
                {
                    <span class="console-status console-state-info">@CatalogContentTypes.LabelFor(summary.Type)</span>
                }
                <h1>@summary.Title</h1>
                <div class="public-item-meta console-muted">
                    @if (summary.Modified > DateTimeOffset.UnixEpoch)
                    {
                        <span>Updated <time datetime="@summary.Modified.ToString("O")">@summary.Modified.ToString("d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</time></span>
                    }
                    @if (!string.IsNullOrWhiteSpace(summary.Owner))
                    {
                        <span>Published by @summary.Owner</span>
                    }
                </div>
                <p class="share-opendata-intro console-muted">@item.Description</p>
                @if (viewer is not null)
                {
                    <a class="console-button console-button-primary" href="@Navigation.ToConsoleHref(viewer.Href)">@viewer.Label</a>
                }

                <div class="public-item-grid">
                    <div>
                        <div data-share-opendata-downloads>
                            <ConsolePanel Title="Download" HeadingId="public-download-heading">
                                @PublicDownloads(item)
                            </ConsolePanel>
                        </div>
                        @if (item.Publications.Length > 0)
                        {
                            <div data-share-opendata-routes>
                                <ConsolePanel Title="Public routes" HeadingId="public-routes-heading">
                                    <ul class="public-item-routes">
                                        @foreach (var publication in item.Publications)
                                        {
                                            var route = PublicRoute(publication.Route);
                                            <li>
                                                <code class="console-inline-code" title="@route">@route</code>
                                                <ConsoleCopyButton Text="@route" />
                                            </li>
                                        }
                                    </ul>
                                </ConsolePanel>
                            </div>
                        }
                    </div>
                    <aside aria-label="Item information">
                        <ConsolePanel Title="Usage" HeadingId="public-usage-heading">
                            <p class="console-muted">@(string.IsNullOrWhiteSpace(item.License) ? "Notice of usage terms is unavailable for this item." : item.License)</p>
                        </ConsolePanel>
                        <ConsolePanel Title="Details" HeadingId="public-details-heading">
                            @if (summary.Tags.Length > 0)
                            {
                                <ul class="console-chip-row public-item-tags" aria-label="Tags">
                                    @foreach (var tag in summary.Tags)
                                    {
                                        <li>#@tag</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <p class="console-muted">No tags published.</p>
                            }
                        </ConsolePanel>
                    </aside>
                </div>
                <footer class="share-opendata-footer" data-share-opendata-footer>
                    <p class="console-muted share-opendata-poweredby">Powered by Honua · public open data</p>
                </footer>
            </article>
        }
        else
        {
            <article class="console-panel share-opendata-landing" data-share-opendata-landing>
                <header class="share-opendata-hero">
                    <p class="console-kicker">Open-data page <span class="console-crumb-sep">/</span> @CatalogContentTypes.LabelFor(item.Summary.Type)</p>
                    <h1>@item.Summary.Title</h1>
                    <div class="console-chip-row">
                        <span class="console-status console-state-success">public</span>
                        <span class="console-status console-state-info">open data</span>
                        @foreach (var tag in item.Summary.Tags)
                        {
                            <span>#@tag</span>
                        }
                    </div>
                </header>
                <p class="share-opendata-intro">@item.Description</p>
                <section class="share-opendata-downloads" data-share-opendata-downloads>
                    <p class="console-kicker">Download</p>
                    @DownloadContent(item)
                </section>
                @if (item.Publications.Any())
                {
                    <section class="share-opendata-routes" data-share-opendata-routes>
                        <p class="console-kicker">Routes</p>
                        @RoutesContent(item)
                    </section>
                }
                <footer class="share-opendata-footer" data-share-opendata-footer>
                    <p class="console-muted">Owner: @item.Summary.Owner</p>
                    <p class="console-muted share-opendata-poweredby">Powered by Honua · public open-data</p>
                </footer>
            </article>
        }
    }
</section>
</CatalogAvailabilityGate>

@code {
    internal const string MissingBindingMessage =
        "Configure Honua:Server:BaseUrl or HONUA_SERVER_BASE_URL so Console can bind the server-owned "
        + "open-data projection from honua-server. The merged runtime never renders seeded open-data content "
        + "(Console Patterns Charter section 11).";

    [Parameter]
    public string IdOrSlug { get; set; } = string.Empty;

    private CatalogItemReadResult? _result;
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    private static RenderFragment PublicDownloads(ConsoleContentDetail item) => @<text>
        @{ var downloads = item.Publications.Where(publication => !string.IsNullOrWhiteSpace(publication.Format)).ToArray(); }
        @if (downloads.Length == 0)
        {
            <p class="console-muted">No download links are published for this item.</p>
        }
        else
        {
            <ul class="share-opendata-download-list">
                @foreach (var download in downloads)
                {
                    <li><a href="@download.Route">@ConsoleDownloadFormatLabels.Display(download.Format!)</a></li>
                }
            </ul>
        }
    </text>;

    private static RenderFragment DownloadContent(ConsoleContentDetail item) => @<text>
                @if (!item.Summary.Formats.Any())
                {
                    <p class="console-muted">No downloadable formats are published for this item.</p>
                }
                else
                {
                    <ul class="share-opendata-download-list">
                        @foreach (var format in item.Summary.Formats)
                        {
                            <li>
                                <span class="share-opendata-download-name">@format</span>
                                <span class="console-muted">download ↓</span>
                            </li>
                        }
                    </ul>
                }
    </text>;

    private static RenderFragment RoutesContent(ConsoleContentDetail item) => @<text>
                    <dl class="console-definition-list">
                        @foreach (var publication in item.Publications)
                        {
                            <dt>Route</dt>
                            <dd><code class="console-inline-code">@publication.Route</code></dd>
                        }
                    </dl>
    </text>;

    private string PublicRoute(string route) =>
        route.StartsWith("/", StringComparison.Ordinal) && !route.StartsWith("//", StringComparison.Ordinal)
            ? Navigation.ToAbsoluteUri(Navigation.ToConsoleHref(route)).AbsoluteUri
            : route;

    protected override async Task OnParametersSetAsync()
    {
        _result = await Catalog.GetOpenDataItemAsync(IdOrSlug);
    }
}
