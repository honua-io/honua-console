@page "/operate/publishing"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Validation
@using Honua.Console.Shell.Services
@inject IPublishingWorkspaceDataSource PublishingData
@inject IConsoleNotificationService Notifications
@inject IServiceProvider Services

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Publishing"><ChildContent><p>@Intro</p></ChildContent></ConsolePageHeading>
    }
    else
    {
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Publishing</p>
        <h1>Publishing</h1>
        <p>@Intro</p>
    </div>
    }

    <PublishWizardWorkspace />

    @if (_workspace is null)
    {
        <p class="console-muted">Reading publishing options…</p>
    }
    else
    {
        <OperateCapabilityStateList States="@_states" />

        <PublishFlowMap />

        @if (_states.Count == 0 || _showLookup)
        {
            <div data-publication-lookup>
            @if (V4Enabled)
            {
                <ConsolePanel Title="Look up released content" HeadingId="publishing-lookup">@LookupContent</ConsolePanel>
            }
            else
            {
                <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Review</p>
                    <h2>Look up released content</h2>
                    <p>Enter a release ID to review its route, release a new version, or restore a previous version.</p>
                </div>
                    @LookupContent
                </section>
            }
            </div>
        }

        @if (_workspace.Matrix.Count == 0 && _workspace.Reviews.Count == 0)
        {
            @if (_states.Count == 0)
            {
                <EmptyState Area="operate" Subject="released content" />
            }
        }
        else
        {
            @if (V4Enabled)
            {
                <ConsolePanel Title="Publishing formats" HeadingId="publishing-formats">@FormatContent</ConsolePanel>
            }
            else
            {
                <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Matrix</p>
                    <h2>Publishing formats</h2>
                    <p>Supported output and catalog formats for each object. Review any unsupported or blocked format before publishing.</p>
                </div>
                    @FormatContent
                </section>
            }

            @if (V4Enabled)
            {
                <ConsolePanel Title="Publishing review" HeadingId="publishing-review">@ReviewContent</ConsolePanel>
            }
            else
            {
                <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Review</p>
                    <h2>Publishing review</h2>
                </div>
                    @ReviewContent
                </section>
            }
        }
    }
</section>

<ConsoleConfirmDialog @ref="_confirm" />

@code {
    private const string Intro = "Publish datasets as layers, review service endpoints, and manage released Studio content. Check supported formats, catalog registration, access, recovery, and provenance before applying a change.";
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = "/operate/publishing",
        Unsaved = new()
        {
            ChangedFieldCount = string.IsNullOrWhiteSpace(_republishTitle) ? 0 : 1,
            PendingOperationCount = (!_loaded ? 1 : 0) + (_busy ? 1 : 0)
        }
    };
    private RenderFragment LookupContent => @<text>


                <div class="console-form-row">
                    <input class="console-input"
                           placeholder="release ID"
                           aria-label="Release ID"
                           @bind="_lookupId"
                           @bind:event="oninput"
                           @bind:after="OnLookupEdit"
                           disabled="@_busy" />
                    <button class="console-button"
                            type="button"
                            @onclick="LookupAsync"
                            disabled="@(_busy || _validation.Errors(PublishingLookupFieldKeys.LookupId).Any(e => e.IsBlocking))">
                        Review
                    </button>
                </div>
                <ValidationMessageInline FieldKey="@PublishingLookupFieldKeys.LookupId" State="_validation" />

                @if (_lookup is not null)
                {
                    <OperateCapabilityStateList States="@_lookup.CapabilityStates" />

                    @if (_lookup.HasReview)
                    {
                        <PublishingReviewCard Review="@(_lookup.Review!)" />

                        <section class="console-section">
                            <div class="console-page-heading">
                                <p class="console-kicker">Actions</p>
                                @if (V4Enabled) { <h3>Lifecycle</h3> } else { <h2>Lifecycle</h2> }
                            </div>

                            <div class="console-form-row">
                                <input class="console-input"
                                       placeholder="new version title (optional)"
                                       aria-label="Republish title"
                                       @bind="_republishTitle"
                                       @bind:event="oninput"
                                       disabled="@_busy" />
                                <button class="console-button"
                                        type="button"
                                        @onclick="ConfirmRepublish"
                                        disabled="@_busy">
                                    Republish
                                </button>
                            </div>

                            @if (_lookup.Versions.Count > 1)
                            {
                                <p class="console-kicker">Version history</p>
                                <ConsoleTableRegion Class="console-table-wrap" Label="Released versions">
                                    <table class="console-table">
                                        <thead>
                                            <tr>
                                                <th>Revision</th>
                                                <th>Version</th>
                                                <th>Title</th>
                                                <th>Created by</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var version in _lookup.Versions)
                                            {
                                                <tr>
                                                    <td>@version.Revision</td>
                                                    <td><small>@version.VersionId</small></td>
                                                    <td>@(version.Title ?? "—")</td>
                                                    <td>@version.CreatedBy</td>
                                                    <td>
                                                        @if (version.IsActive)
                                                        {
                                                            <span class="console-status">active</span>
                                                        }
                                                        else
                                                        {
                                                            <button class="console-button console-button-secondary"
                                                                    type="button"
                                                                    @onclick="() => ConfirmRollback(version.VersionId, version.Revision)"
                                                                    disabled="@_busy">
                                                                Roll back to rev @version.Revision
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </ConsoleTableRegion>
                            }
                        </section>
                    }
                }

    </text>;
    private RenderFragment FormatContent => @<text>


                <ConsoleTableRegion Class="console-table-wrap" Label="Supported publishing formats">
                    <table class="console-table">
                        <thead>
                            <tr>
                                <th>Object</th>
                                <th>Kind</th>
                                <th>Target</th>
                                <th>Support</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _workspace.Matrix)
                            {
                                @foreach (var target in row.Targets)
                                {
                                    <tr>
                                        <td>@row.ResourceName <small>@row.ResourceId</small></td>
                                        <td>@ConsoleVocabulary.PublishingKindName(row.ResourceKind)</td>
                                        <td>@target.Format</td>
                                        <td>
                                            <span class="console-status @SupportStateClass(target.Support)">@target.Support</span>
                                            @if (!string.IsNullOrWhiteSpace(target.Blocker))
                                            {
                                                <small class="console-muted">@target.Blocker</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </ConsoleTableRegion>

    </text>;
    private RenderFragment ReviewContent => @<text>


                <div class="console-panel-grid">
                    @foreach (var review in _workspace.Reviews)
                    {
                        <PublishingReviewCard Review="@review" />
                    }
                </div>

    </text>;

    private ConsoleConfirmDialog? _confirm;
    private PublishingWorkspace? _workspace;
    private IReadOnlyList<OperateCapabilityState> _states = Array.Empty<OperateCapabilityState>();
    private PublishingLookupResult? _lookup;
    private string _lookupId = string.Empty;
    private string _republishTitle = string.Empty;
    private bool _busy;
    private bool _loaded;
    private bool _deepLinkAttempted;

    // Client-side validation of the publication lookup id. The publication registry has no field-addressable
    // body-validator for the lookup id, so this is purely client-side and surfaced inline.
    private readonly ValidationState _validation = new();

    private void OnLookupEdit() =>
        _validation.SetClientErrors(PublishingLookupValidator.Instance.Evaluate(
            new PublishingLookupState(_lookupId, _republishTitle)));

    private static string SupportStateClass(PublishingTargetSupport support) => support switch
    {
        PublishingTargetSupport.Supported => "console-state-success",
        PublishingTargetSupport.Blocked => "console-state-danger",
        _ => "console-state-warning"
    };

    private bool _showLookup => _workspace is not null
        && (_workspace.Matrix.Count > 0 || _workspace.Reviews.Count > 0 || _states.Count > 0);

    [SupplyParameterFromQuery(Name = "publicationId")]
    public string? PublicationId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!_loaded)
        {
            _workspace = await PublishingData.GetWorkspaceAsync();
            _states = OperateCapabilityStateFilters.ForSurface(_workspace.CapabilityStates, "Publishing");
            _loaded = true;
        }

        // Deep link: /operate/publishing?publicationId=... pre-fills and runs the lookup once.
        if (!_deepLinkAttempted && !string.IsNullOrWhiteSpace(PublicationId))
        {
            _deepLinkAttempted = true;
            _lookupId = PublicationId;
            await LookupAsync();
        }
    }

    private async Task LookupAsync()
    {
        if (string.IsNullOrWhiteSpace(_lookupId) || _busy)
        {
            return;
        }

        // Gate on the client-side identifier-format rule before issuing the lookup; never fabricate server state.
        OnLookupEdit();
        if (_validation.Errors(PublishingLookupFieldKeys.LookupId).Any(e => e.IsBlocking))
        {
            return;
        }

        _busy = true;
        try
        {
            _lookup = await PublishingData.LookupAsync(_lookupId.Trim());
        }
        finally
        {
            _busy = false;
        }
    }

    // Republish and rollback are destructive lifecycle actions against the live registry, so each is gated
    // behind a confirm step (ConsoleConfirmDialog) — a single click previously rolled back / republished a
    // live publication with no confirmation. The confirmed work runs through RunGuardedAsync so a server
    // failure surfaces as a toast (and disables the controls while in flight) instead of vanishing silently.
    private void ConfirmRepublish()
    {
        if (_lookup?.Review is null || _busy || _confirm is null)
        {
            return;
        }

        var resourceName = string.IsNullOrWhiteSpace(_lookup.Review.ResourceName)
            ? _lookup.Review.ResourceId
            : _lookup.Review.ResourceName;
        _confirm.Open(
            title: "Release a new version?",
            onConfirm: RepublishAsync,
            body: $"This creates a new live version of \"{resourceName}\" in the registry. Consumers will see the new version.",
            confirmLabel: "Republish");
    }

    private void ConfirmRollback(string targetVersionId, long revision)
    {
        if (_lookup?.Review is null || _busy || _confirm is null)
        {
            return;
        }

        var resourceName = string.IsNullOrWhiteSpace(_lookup.Review.ResourceName)
            ? _lookup.Review.ResourceId
            : _lookup.Review.ResourceName;
        _confirm.Open(
            title: $"Roll back to rev {revision}?",
            onConfirm: () => RollbackAsync(targetVersionId),
            body: $"This makes revision {revision} the live version of \"{resourceName}\" again. The current live version is superseded.",
            confirmLabel: $"Roll back to rev {revision}");
    }

    private Task RepublishAsync()
    {
        if (_lookup?.Review is null || _busy)
        {
            return Task.CompletedTask;
        }

        var resourceId = _lookup.Review.ResourceId;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                var command = new PublishingRepublishCommand(
                    Title: string.IsNullOrWhiteSpace(_republishTitle) ? null : _republishTitle.Trim());
                _lookup = await PublishingData.RepublishAsync(resourceId, command);
                _republishTitle = string.Empty;
            },
            setBusy: busy => { _busy = busy; StateHasChanged(); },
            failureMessage: "Couldn't release the new version",
            onSuccess: "New version released.");
    }

    private Task RollbackAsync(string targetVersionId)
    {
        if (_lookup?.Review is null || _busy)
        {
            return Task.CompletedTask;
        }

        var resourceId = _lookup.Review.ResourceId;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                var command = new PublishingRollbackCommand(TargetVersionId: targetVersionId);
                _lookup = await PublishingData.RollbackAsync(resourceId, command);
            },
            setBusy: busy => { _busy = busy; StateHasChanged(); },
            failureMessage: "Couldn't restore the previous version",
            onSuccess: "Previous version restored.");
    }
}
