@page "/operate/settings/api-keys"
@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager Navigation

<section class="console-page">
    <ConsolePageHeading Title="API keys">
        <p><a href="@Navigation.ToConsoleHref("/operate/settings")">Settings</a> / API keys</p>
        <p>Create and revoke credentials for the connected server. Full administrator authority is required for changes.</p>
    </ConsolePageHeading>
    @if (_issue is not null)
    {
        <ConsoleStateView Kind="error" HeadingLevel="2" Title="@_issue.State" Message="@_issue.Detail" />
    }
    @if (_loading)
    {
        <ConsoleStateView Kind="loading" HeadingLevel="2" Title="Loading API keys" Message="Reading the connected server." />
    }
    <p><button type="button" class="console-button console-button-secondary" disabled="@_busy" @onclick="LoadAsync">Refresh keys</button></p>
    @if (_binding is not null)
    {
        @if (_secret is not null)
        {
            <ConsolePanel Title="Save your API key" HeadingId="api-key-secret-heading">
                <p>This secret is shown once. Save it securely before dismissing it.</p>
                <label for="api-key-secret">New API key</label>
                <input id="api-key-secret" class="console-input" type="text" readonly value="@_secret" autocomplete="off" spellcheck="false" />
                <button type="button" class="console-button" @onclick="DismissSecret">I saved the key</button>
            </ConsolePanel>
        }
        @if (_keys.Count == 0)
        {
            <ConsoleStateView HeadingLevel="2" Title="No API keys" Message="Create a key when an application needs access to this server." />
        }
        else
        {
            <ConsolePanel Title="Server API keys" HeadingId="api-key-list-heading">
                <ConsoleTableRegion Class="console-table-wrap" Label="API keys">
                    <table class="console-table">
                        <thead><tr><th>Name</th><th>Prefix</th><th>Permissions</th><th>Status</th><th>Expires</th><th>Actions</th></tr></thead>
                        <tbody>
                            @foreach (var key in _keys)
                            {
                                <tr @key="key.Id"><td>@key.Name</td><td><code>@key.KeyPrefix</code></td><td>@string.Join(", ", key.Permissions)</td><td>@key.Status</td><td>@Expiry(key.ExpiresAt)</td>
                                    <td><button type="button" class="console-button console-button-secondary" disabled="@(_busy || _needsRefresh || key.RevokedAt is not null || string.Equals(key.Status, "revoked", StringComparison.OrdinalIgnoreCase))" aria-label="@($"Revoke {key.Name}")" @onclick="() => ConfirmRevoke(key)">Revoke</button></td></tr>
                            }
                        </tbody>
                    </table>
                </ConsoleTableRegion>
            </ConsolePanel>
        }
        <ConsolePanel Title="Create API key" HeadingId="api-key-create-heading">
            <form @onsubmit="CreateAsync" @onsubmit:preventDefault>
                <p>Grant only the permissions the application needs. Separate permissions with commas. An empty expiry means the key does not expire.</p>
                <p><label for="api-key-name">Name</label><input id="api-key-name" class="console-input" @bind="_name" required maxlength="120" disabled="@_busy" autocomplete="off" /></p>
                <p><label for="api-key-permissions">Permissions</label><input id="api-key-permissions" class="console-input" @bind="_permissions" required disabled="@_busy" placeholder="admin:read" autocomplete="off" /></p>
                <p><label for="api-key-expiry">Expiry (UTC)</label><input id="api-key-expiry" class="console-input" type="datetime-local" @bind="_expiry" disabled="@_busy" /></p>
                <button type="submit" class="console-button" disabled="@(_busy || _needsRefresh || _secret is not null)">Create key</button>
            </form>
        </ConsolePanel>
    }
    <ConsoleConfirmDialog @ref="_confirm" />
</section>
