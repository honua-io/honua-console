@page "/studio"
@page "/studio/proof"
@page "/studio/drafts"
@page "/studio/apps/{ItemId}/preview"
@inject NavigationManager Navigation
@inject IServiceProvider WorkspaceServices

@if (IsRetiredRoute)
{
    <section class="console-page" data-legacy-studio-retired>
        <p class="console-kicker">Studio</p>
        <h1>This view has moved to the Studio workspace</h1>
        <p>Edit maps with visual controls and your Console conversation.</p>
        <a class="console-button-link" href="/studio">Open Studio workspace</a>
        <a class="console-button-link console-button-secondary" href="/catalog">Browse saved content</a>
    </section>
}
else if (EmbedEnabled)
{
    <section class="console-page" data-studio-embed>
        <h1>Studio</h1>
        <p>Edit maps with visual controls and your Console conversation.</p>
        <p><a href="/studio/processes">Open Processes</a></p>
        <p role="status" data-studio-status>Connecting the realtime Studio workspace…</p>
        <div data-studio-mount></div>
    </section>
}
else
{
    <section class="console-page" data-studio-unavailable>
        <p class="console-kicker">Studio</p>
        <h1>Studio is unavailable on this deployment</h1>
        <p>Connect a deployment that supports the realtime Console and Studio workspace, or ask your administrator to enable it.</p>
        <a class="console-button-link" href="/environments">Review connection</a>
        <a class="console-button-link console-button-secondary" href="/setup/local">Set up Honua locally</a>
    </section>
}

@code {
    [Parameter] public string? ItemId { get; set; }
    private bool EmbedEnabled => bool.TryParse(
        WorkspaceServices.GetService<Microsoft.Extensions.Configuration.IConfiguration>()?["Studio:EmbedJsStudio"], out var enabled) && enabled;
    private bool IsRetiredRoute
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            return path.Equals("studio/proof", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("studio/apps/", StringComparison.OrdinalIgnoreCase);
        }
    }
}
