@page "/operate/versions/{ServiceId}/{VersionGuid}/conflicts"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IVersionManagementOperation VersionOps
@inject IConsoleNotificationService Notifications
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page operate-version-conflicts" data-version-conflicts>
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Conflict resolution">
            <ChildContent><p>Review conflicting edits before posting this version to DEFAULT.</p></ChildContent>
            <Actions>
                <a class="console-button-link" href="@Navigation.ToConsoleHref("/operate/versions")">Back to versions</a>
                <button class="console-button console-button-secondary" type="button" @onclick="LoadAsync" disabled="@(_loading || _busy)">Refresh conflicts</button>
            </Actions>
        </ConsolePageHeading>
    }
    else
    {
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Versions</p>
        <h1>Conflict resolution</h1>
        <p>Review the pending conflicts for this branch version as a three-way diff (base vs DEFAULT vs version) for attributes and geometry. Pick a per-feature resolution — take the version edit, take the DEFAULT edit, or revert to the common-ancestor base — then submit. Post to DEFAULT stays disabled until no conflicts remain.</p>
        <p class="console-muted">Service <code>@ServiceId</code> · version <code>@VersionGuid</code></p>
    </div>

    <div class="console-action-row">
        <a class="console-button-link" href="@Navigation.ToConsoleHref("/operate/versions")">Back to versions</a>
        <button class="console-button console-button-secondary" type="button" @onclick="LoadAsync" disabled="@(_loading || _busy)">
            @(_loading ? "Loading…" : "Refresh conflicts")
        </button>
    </div>

    }

    @if (_loading)
    {
        <ConsoleStateView HeadingLevel="2" Kind="loading"
                          Kicker="Conflict resolution"
                          Title="Loading conflicts"
                          Message="Reading the pending conflict set from honua-server." />
    }
    else if (_conflicts is { Bound: false } unbound)
    {
        <ConsoleStateView HeadingLevel="2" Kind="missing"
                          Kicker="@(unbound.State ?? "Missing binding")"
                          Title="Conflict resolution is not bound"
                          Message="@DescribeBinding(unbound.Detail, unbound.Contract)" />
    }
    else if (_conflicts is { } conflicts)
    {
        @if (V4Enabled)
        {
            <ConsolePanel Title="Version conflicts" HeadingId="version-conflicts-heading">
                <ConsoleMetricTile Label="Conflicts" Value="@conflicts.Conflicts.Count" />
                @ConflictWorkflow
            </ConsolePanel>
        }
        else
        {
            @ConflictWorkflow
        }

    }

    <ConsoleConfirmDialog @ref="_confirm" />
</section>

@code {
    private bool V4Enabled => ServiceProvider.GetService<ConsoleV4Options>()?.Enabled == true;
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = $"/operate/versions/{Uri.EscapeDataString(ServiceId)}/{Uri.EscapeDataString(VersionGuid)}/conflicts",
        Entities = ServiceSelection,
        Selection = ServiceSelection,
        Unsaved = new() { ChangedFieldCount = _choices.Count, PendingOperationCount = _loading || _busy ? 1 : 0 }
    };
    private IReadOnlyList<ConsoleAgentEntity> ServiceSelection => string.IsNullOrWhiteSpace(ServiceId) ? [] :
        [new() { Kind = ConsoleAgentEntityKind.Service, Id = ServiceId, ServiceName = ServiceId }];

    private RenderFragment ConflictWorkflow => @<div>
        @if (_conflicts is { } conflicts)
        {
        @if (_resolveResult is { } resolve)
        {
            <div class="@(V4Enabled ? "console-state" : "console-panel") @(resolve.Operation.Succeeded ? "console-state-success" : "console-state-danger")"
                     role="status" data-resolve-result>
                <p class="console-kicker">@resolve.Operation.State</p>
                <p>@resolve.Operation.Detail</p>
            </div>
        }

        @if (_postResult is { } post)
        {
            <div class="@(V4Enabled ? "console-state" : "console-panel") @(post.Succeeded ? "console-state-success" : "console-state-danger")"
                     role="status" data-post-result>
                <p class="console-kicker">@post.State</p>
                <p>@post.Detail</p>
            </div>
        }

        @if (!conflicts.HasConflicts)
        {
            <div class="@(V4Enabled ? "console-state" : "console-panel") console-state-success" role="status" data-no-conflicts>
                <p class="console-kicker">Clean</p>
                <p>No conflicts remain for this version. It can be posted to DEFAULT.</p>
            </div>
        }
        else
        {
            <section class="console-section" aria-label="Pending conflicts">
                @foreach (var conflict in conflicts.Conflicts)
                {
                    <VersionConflictDiff Conflict="conflict"
                                         Choice="@GetChoice(conflict.Key)"
                                         ChoiceChanged="OnChoiceChanged" />
                }
            </section>

            <section class="console-section" aria-label="Submit resolutions">
                <div class="console-action-row">
                    <button class="console-button" type="button" @onclick="ResolveAsync"
                            disabled="@(_busy || _choices.Count == 0)" data-submit-resolutions>
                        @(_busy ? "Submitting…" : $"Resolve selected ({_choices.Count})")
                    </button>
                    <span class="console-muted">@_choices.Count of @conflicts.Conflicts.Count conflict(s) chosen.</span>
                </div>
            </section>
        }

        <section class="console-section" aria-label="Post to DEFAULT">
            <div class="console-page-heading">
                <p class="console-kicker">Publish</p>
                <h2>Post to DEFAULT</h2>
                <p>Replays this version's net changes onto DEFAULT. Disabled while conflicts remain.</p>
            </div>
            <div class="console-action-row">
                <button class="console-button" type="button" @onclick="ConfirmPost"
                        disabled="@(_busy || conflicts.HasConflicts)" data-post>
                    @(_busy ? "Posting…" : "Post to DEFAULT")
                </button>
                @if (conflicts.HasConflicts)
                {
                    <span class="console-muted" data-post-blocked>Resolve all conflicts to enable post.</span>
                }
            </div>
        </section>
        }
    </div>;

    [Parameter]
    public string ServiceId { get; set; } = string.Empty;

    [Parameter]
    public string VersionGuid { get; set; } = string.Empty;

    private VersionConflictsView? _conflicts;
    private bool _loading;
    private bool _busy;

    // Per-conflict resolution choices keyed by "layerId:objectId".
    private readonly Dictionary<string, string> _choices = new(StringComparer.Ordinal);

    private ResolveConflictsResultView? _resolveResult;
    private VersionOperationResult? _postResult;
    private ConsoleConfirmDialog? _confirm;

    private (string Service, string Version)? _loadedVersion;
    private int _generation;
    private int _readGeneration;

    protected override async Task OnParametersSetAsync()
    {
        var version = (ServiceId, VersionGuid);
        if (_loadedVersion == version) return;
        _loadedVersion = version;
        _generation++;
        _choices.Clear();
        _conflicts = null;
        _resolveResult = null;
        _postResult = null;
        _busy = false;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var generation = _generation;
        var readGeneration = ++_readGeneration;
        var serviceId = ServiceId;
        var versionGuid = VersionGuid;
        _loading = true;
        try
        {
            var conflicts = await VersionOps.InspectConflictsAsync(serviceId, versionGuid);
            if (generation != _generation || readGeneration != _readGeneration) return;
            _conflicts = conflicts;
            // Drop any stale choices for conflicts that are no longer present.
            if (_conflicts is { Bound: true })
            {
                var present = _conflicts.Conflicts.Select(c => c.Key).ToHashSet(StringComparer.Ordinal);
                foreach (var key in _choices.Keys.Where(k => !present.Contains(k)).ToArray())
                {
                    _choices.Remove(key);
                }
            }
        }
        finally
        {
            if (generation == _generation && readGeneration == _readGeneration) _loading = false;
        }
    }

    private string? GetChoice(string key) => _choices.TryGetValue(key, out var choice) ? choice : null;

    private void OnChoiceChanged((string Key, string Choice) selection)
    {
        _choices[selection.Key] = selection.Choice;
        _resolveResult = null;
        _postResult = null;
    }

    private Task ResolveAsync()
    {
        if (_busy || _loading || _conflicts is not { Bound: true } || _choices.Count == 0)
        {
            return Task.CompletedTask;
        }

        var generation = _generation;
        var serviceId = ServiceId;
        var versionGuid = VersionGuid;
        var choices = _choices.ToArray();
        _postResult = null;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                var resolutions = choices
                    .Select(pair =>
                    {
                        var parts = pair.Key.Split(':', 2);
                        var layerId = int.Parse(parts[0], System.Globalization.CultureInfo.InvariantCulture);
                        var objectId = long.Parse(parts[1], System.Globalization.CultureInfo.InvariantCulture);
                        return new ConflictResolutionChoice(layerId, objectId, pair.Value);
                    })
                    .ToArray();

                var result = await VersionOps.ResolveConflictsAsync(serviceId, versionGuid, resolutions);
                if (generation != _generation) return;
                _resolveResult = result;
                if (_resolveResult.Operation.Succeeded)
                {
                    await LoadAsync();
                }
            },
            setBusy: busy => { if (generation == _generation) { _busy = busy; StateHasChanged(); } },
            failureMessage: "Couldn't submit conflict resolutions");
    }

    private void ConfirmPost()
    {
        if (_confirm is null) return;
        var generation = _generation;
        _confirm.Open(
            title: "Post version to DEFAULT?",
            onConfirm: () => generation == _generation ? PostAsync() : Task.CompletedTask,
            body: "This posts all edits in this branch version to the DEFAULT version. This action is irreversible and affects all users reading from DEFAULT.",
            confirmLabel: "Post to DEFAULT");
    }

    private Task PostAsync()
    {
        if (_busy || _loading || _conflicts is not { Bound: true, HasConflicts: false }) return Task.CompletedTask;
        var generation = _generation;
        var serviceId = ServiceId;
        var versionGuid = VersionGuid;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                var result = await VersionOps.PostAsync(serviceId, versionGuid);
                if (generation == _generation) _postResult = result;
            },
            setBusy: busy => { if (generation == _generation) { _busy = busy; StateHasChanged(); } },
            failureMessage: "Couldn't post the version to DEFAULT");
    }

    private static string DescribeBinding(string? detail, string? contract) =>
        string.IsNullOrWhiteSpace(contract)
            ? detail ?? "No server binding is configured."
            : $"{detail} (contract: {contract})";
}
