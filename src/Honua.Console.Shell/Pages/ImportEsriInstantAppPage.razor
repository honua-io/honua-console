@page "/operate/import/esri/instant-app"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@using Honua.Console.Shell.Validation
@implements IDisposable

@* #158 · Import Esri Instant App configuration → app package (honua.app-package.v1).
   Instant App JSON intake → template + capability inventory → capability → Console app element mapping with
   per-capability fidelity badges, target app-shell preview, "Create app package →" CTA. The Esri-JSON parse
   is deterministic Console-side work; the app's primary web map imports via the Web Map surface, so it shows
   as a binding row (Console Patterns Charter §11). *@

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have an unsaved Instant App import. Leave this page and discard it?" />

<section class="console-page esri-import" data-esri-import="instant-app">
    <div class="console-detail-heading">
        <div>
            <p class="console-kicker">Operate <span class="console-crumb-sep">/</span> Import from Esri <span class="console-crumb-sep">/</span> Instant App</p>
            <h1>Import Esri Instant App</h1>
            <p class="console-muted">
                Convert an ArcGIS Instant App configuration (Sidebar / Basic template) into a Honua app package
                (<code>honua.app-package.v1</code>). Capability-by-capability fidelity is shown before commit.
            </p>
        </div>
        <div class="console-button-row">
            <a class="console-button-ghost" href="/operate/import/esri">Discard</a>
            <a class="console-button" href="/operate/publishing">Create app package →</a>
        </div>
    </div>

    <EsriImportIntake Noun="Instant App"
                      Kind="EsriContentKind.InstantApp"
                      Result="_result"
                      Parse="ParseInstantApp"
                      OnParsed="OnParsed"
                      Dirty="_dirty"
                      SampleJson="@EsriImportSampleDocuments.InstantApp"
                      SampleFileName="@EsriImportSampleDocuments.InstantAppFileName" />

    @if (_result is { } result)
    {
        <div class="esri-import__split">
            <div class="esri-import__mapping">
                <SourceTargetMappingTable Rows="result.Rows"
                                          Heading="Capability → app element mapping"
                                          Subhead="Esri Instant App capability → Honua app panel / tool"
                                          SourceHeader="Esri capability"
                                          SourceTypeHeader="Kind"
                                          TargetHeader="→ Honua app element"
                                          BoundHeader="Binding"
                                          ShowBoundColumn="true"
                                          CarryOver="result.CarryOver" />
            </div>

            <aside class="esri-import__preview" data-esri-target-preview>
                <div class="esri-import__preview-head">
                    <span class="console-kicker">Target app shell</span>
                    <strong><code>@result.TargetSchema</code></strong>
                </div>
                <div class="esri-app-preview" aria-label="Approximated app shell layout">
                    <div class="esri-app-preview__header">@result.SuggestedName</div>
                    <div class="esri-app-preview__body">
                        <div class="esri-app-preview__panel">panel</div>
                        <div class="esri-app-preview__map">
                            <span class="esri-app-preview__tool">search</span>
                            <span class="esri-app-preview__tool">zoom</span>
                        </div>
                    </div>
                </div>
                <dl class="esri-import__facts">
                    <dt>Name</dt>
                    <dd><code>@result.SuggestedName</code></dd>
                    <dt>Capabilities in</dt>
                    <dd>@result.MappedCount of @result.Rows.Count (@result.DropCount dropped)</dd>
                    <dt>Primary map</dt>
                    <dd>@(result.FirstUnbound is { } u ? $"bind · {u.SourceName}" : "bound")</dd>
                </dl>
                <p class="esri-callout esri-callout--warn" data-esri-summary>
                    <strong>@result.MappedCount of @result.Rows.Count elements convert.</strong>
                    The app's primary map imports via <a href="/operate/import/esri/web-map">Import Web Map</a> —
                    bind it after import. @result.DropCount unsupported capabilit@(result.DropCount == 1 ? "y" : "ies") dropped.
                </p>
            </aside>
        </div>

        @if (result.FirstUnbound is { } unbound)
        {
            <div class="esri-binding-banner" data-esri-binding-banner>
                <span class="console-status console-state-info">binding required</span>
                <span class="esri-binding-banner__text">
                    The app's primary content <strong>@unbound.SourceName</strong> imports separately. Import its
                    web map first, then bind it here, or create the app package as a draft.
                </span>
                <div class="console-button-row">
                    <a class="console-button console-button-sm" href="/operate/import/esri/web-map">Import Web Map first</a>
                    <a class="console-button-ghost console-button-sm" href="/operate/publishing">Create draft</a>
                </div>
            </div>
        }
    }
    else
    {
        <ConsoleStateView Kind="empty"
                          Kicker="Import from Esri"
                          Title="Paste or upload an Instant App configuration"
                          Message="Choose an intake mode above to convert an ArcGIS Instant App into a honua.app-package.v1 preview." />
    }
</section>

@code {
    private static readonly EsriContentImportParser Parser = new();

    private EsriConversionResult? _result;
    private readonly FormDirtyState _dirty = new();

    // The dirty flag is flipped by the child intake; re-render so the hosted <UnsavedChangesGuard/> sees it.
    protected override void OnInitialized() => _dirty.Changed += StateHasChanged;

    public void Dispose() => _dirty.Changed -= StateHasChanged;

    private static EsriParseOutcome ParseInstantApp(string json, string? fileName) => Parser.ParseInstantApp(json, fileName);

    private void OnParsed(EsriConversionResult result) => _result = result;
}
