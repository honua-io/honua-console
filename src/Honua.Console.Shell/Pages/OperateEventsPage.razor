@page "/operate/events"
@inject IStudioWorkflowPackageClient Workflows

<section class="console-page">
    <div class="console-page-heading">
        <p class="console-kicker">Operate events</p>
        <h1>Workflow Event Evidence</h1>
        <p>Workflow dry-run and publication events stay connected to the server-owned job id and package version they came from.</p>
    </div>

    @if (_evidence is null)
    {
        <article class="console-panel" data-events-dead-end>
            <h2>Open this from a workflow run</h2>
            <ConsoleDiagnostics Summary="Workflow event evidence stays tied to the job that produced it. Open this route from a workflow's publish or dry-run result so its job id comes along — a direct visit has no run to show yet."
                                Detail="Workflow event evidence is owned by honua-server's Operate job/event APIs; projecting it into this route without a supplied job id is a pending follow-on. The in-memory demo adapter renders evidence inline."
                                Contract="GET /api/v1/admin/jobs/{jobId}"
                                IssueRef="honua-server#1185" />
            <div class="console-toolbar">
                <a class="console-button-link" href="/studio/workflows/new" data-events-exit-workflows>Open workflow editors</a>
                <a class="console-button-link" href="/operate/observability" data-events-exit-jobs>View workflow jobs</a>
            </div>
        </article>
    }
    else
    {
        <article class="console-panel">
            <div class="console-panel-heading">
                <div>
                    <p class="console-kicker">@_evidence.JobKind</p>
                    <h2>@_evidence.JobId</h2>
                </div>
                <span class="console-status">@_evidence.Status</span>
            </div>
            <ol class="console-event-list">
                @foreach (var log in _evidence.Logs)
                {
                    <li>
                        <span>@_evidence.CreatedAt.ToString("HH:mm:ss")</span>
                        <strong>@log</strong>
                        <small>@_evidence.VersionId</small>
                    </li>
                }
            </ol>
        </article>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "jobId")]
    private string? JobId { get; set; }

    private StudioWorkflowJobEvidence? _evidence;

    protected override async Task OnParametersSetAsync()
    {
        _evidence = string.IsNullOrWhiteSpace(JobId)
            ? null
            : await Workflows.GetJobEvidenceAsync(JobId);
    }
}
