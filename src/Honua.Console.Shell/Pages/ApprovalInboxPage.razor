@page "/inbox"
@page "/approvals"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IConsoleApprovalInboxClient Inbox
@inject IConsoleProposalRealtimeClient Realtime
@implements IAsyncDisposable

@* APPROVAL INBOX (#193) — the GIS department's work queue as one human-in-the-loop surface.
   The console's job is not form-work: it WITNESSES and AUTHORIZES the operations agents and
   APIs propose. This page reads the first-class honua-server proposals API (#1694), classifies
   each proposal onto a GIS-desk ticket type, and lets an operator review the plan / diff /
   dry-run / risk / blockers and approve or reject (reason required) — all through the server's
   governed endpoints (the RBAC approve gate stays the only real gate; this surface never
   bypasses it). It subscribes to the admin realtime hub's proposals group (#1695) so pending /
   resolved events update the queue live, with a manual refresh fallback.

   Server-owned data only (Console Patterns Charter section 11): a missing / unsupported /
   forbidden / unavailable read renders the shared status surface, never seeded data. *@

<section class="console-page console-operate-page approval-inbox-page">
    <div class="console-page-heading operate-heading">
        <p class="console-kicker">Human-in-the-loop</p>
        <h1>Approval inbox</h1>
        <p>
            The work queue for agent-proposed operations. Agents and APIs do the writing; you
            review the plan, diff, dry-run, and risk here and authorize the outcome. Approve or
            reject through the server's governed, audited approval endpoints.
        </p>
    </div>

    <div class="approval-inbox-toolbar" role="group" aria-label="Inbox controls">
        <span class="approval-inbox-live @(Realtime.IsConnected ? "is-live" : null)" data-live-state>
            @(Realtime.IsConnected ? "Live" : "Manual")
        </span>
        <button type="button" class="console-button console-button-secondary"
                disabled="@_busy" data-refresh-inbox @onclick="RefreshAsync">
            Refresh
        </button>
    </div>

    @if (!_loaded)
    {
        <OperateSectionStatusPanel Heading="Approval inbox" Loading="true" />
    }
    else if (!_result.IsAllowed)
    {
        <OperateSectionStatusPanel Heading="Approval inbox" Status="_result.Status" Message="@_result.Message" />
    }
    else
    {
        var snapshot = _result.Value ?? ApprovalInboxSnapshot.Empty;
        var multiSource = snapshot.PresentSources.Count > 1;

        <div class="approval-inbox-summary" role="status" aria-live="polite">
            <span class="approval-inbox-metric @(snapshot.AwaitingApprovalCount > 0 ? "is-actionable" : null)"
                  data-awaiting-count>
                <strong>@snapshot.AwaitingApprovalCount</strong>
                <span class="console-muted">awaiting approval</span>
            </span>
            <span class="approval-inbox-metric" data-total-count>
                <strong>@snapshot.TotalCount</strong>
                <span class="console-muted">in the queue</span>
            </span>
        </div>

        @if (_result.PartialResult && !string.IsNullOrWhiteSpace(_result.Message))
        {
            <p class="console-muted approval-inbox-partial" role="note">@_result.Message</p>
        }

        @if (snapshot.TotalCount > 0)
        {
            <div class="approval-inbox-filters" role="group" aria-label="Filter the queue by ticket type">
                <button type="button"
                        class="console-chip @(_filter is null ? "is-selected" : null)"
                        aria-pressed="@(_filter is null ? "true" : "false")"
                        data-filter="all"
                        @onclick="() => SetFilter(null)">
                    All <span class="console-muted">@snapshot.TotalCount</span>
                </button>
                @foreach (var type in snapshot.PresentTicketTypes)
                {
                    var count = snapshot.ForTicketType(type).Count;
                    <button type="button"
                            class="console-chip @(_filter == type ? "is-selected" : null)"
                            aria-pressed="@(_filter == type ? "true" : "false")"
                            data-filter="@type"
                            title="@ApprovalTicketPresentation.Description(type)"
                            @onclick="() => SetFilter(type)">
                        @ApprovalTicketPresentation.Label(type) <span class="console-muted">@count</span>
                    </button>
                }
            </div>
        }

        <div class="approval-inbox-layout">
            <div class="approval-inbox-queue">
                @if (VisibleItems.Count == 0)
                {
                    <OperateSectionStatusPanel Heading="Approval inbox" Empty="true"
                        EmptyTitle="No work in the queue"
                        EmptyMessage="No agent-proposed operations are awaiting a decision. Wait for an agent or API to propose one." />
                }
                else
                {
                    <ul class="approval-inbox-list" aria-label="Pending agent-proposed operations">
                        @foreach (var item in VisibleItems)
                        {
                            <li class="approval-inbox-row @(IsSelected(item) ? "is-selected" : null)">
                                <button type="button"
                                        class="approval-inbox-select"
                                        aria-pressed="@(IsSelected(item) ? "true" : "false")"
                                        data-proposal-id="@item.ProposalId"
                                        data-proposal-source="@item.Source"
                                        @onclick="() => Select(item)">
                                    <span class="approval-inbox-row-head">
                                        <span class="console-chip approval-inbox-ticket" data-ticket-type="@item.TicketType">
                                            @ApprovalTicketPresentation.Label(item.TicketType)
                                        </span>
                                        @if (multiSource)
                                        {
                                            <span class="console-chip approval-inbox-source" data-proposal-source-chip="@item.Source">
                                                @ConsoleProposalPresentation.SourceLabel(item.Source)
                                            </span>
                                        }
                                        <span class="console-status @ConsoleProposalPresentation.StatusClass(item.Proposal.Status)">
                                            @ConsoleProposalPresentation.StatusLabel(item.Proposal.Status)
                                        </span>
                                        <span class="console-status @ConsoleProposalPresentation.RiskClass(item.Proposal.RiskLevel)">
                                            @ConsoleProposalPresentation.RiskLabel(item.Proposal.RiskLevel)
                                        </span>
                                    </span>
                                    <span class="approval-inbox-row-summary">@item.Proposal.Summary</span>
                                    <span class="console-muted approval-inbox-row-sub">
                                        <span class="console-mono">@item.ProposalId</span>
                                        @if (!string.IsNullOrWhiteSpace(item.Proposal.RequestedBy))
                                        {
                                            <text> &middot; @item.Proposal.RequestedBy</text>
                                        }
                                    </span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="approval-inbox-detail" aria-live="polite">
                @if (_selectedProposalId is { Length: > 0 } proposalId)
                {
                    <ProposalApprovalPanel ProposalId="@proposalId"
                        ReloadToken="_detailReloadToken"
                        OnActioned="OnProposalActioned" />
                }
                else
                {
                    <OperateSectionStatusPanel Heading="Review" Empty="true"
                        EmptyTitle="Select a work item"
                        EmptyMessage="Choose a proposal from the queue to review its plan, diff, dry-run, and risk before you authorize it." />
                }
            </div>
        </div>
    }
</section>

@code {
    private bool _loaded;
    private bool _busy;
    private OperateSectionResult<ApprovalInboxSnapshot> _result =
        OperateSectionResult<ApprovalInboxSnapshot>.Allowed(ApprovalInboxSnapshot.Empty);

    private ApprovalTicketType? _filter;
    private string? _selectedProposalId;
    private int _detailReloadToken;

    private IReadOnlyList<ApprovalInboxItem> VisibleItems
    {
        get
        {
            var snapshot = _result.Value ?? ApprovalInboxSnapshot.Empty;
            return _filter is { } type ? snapshot.ForTicketType(type) : snapshot.Items;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Realtime.ProposalChanged += OnProposalEvent;
        await RefreshAsync();
        // Best-effort: open the live subscription. A failure leaves the inbox on manual refresh.
        await Realtime.StartAsync();
    }

    private async Task RefreshAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _result = await Inbox.GetInboxAsync();

            // Drop a stale selection / filter that no longer maps onto a queue item.
            if (_selectedProposalId is { Length: > 0 } selected
                && _result.Value?.Items.All(item => !string.Equals(item.ProposalId, selected, StringComparison.Ordinal)) == true)
            {
                _selectedProposalId = null;
            }

            if (_filter is { } filter && _result.Value?.PresentTicketTypes.Contains(filter) != true)
            {
                _filter = null;
            }
        }
        finally
        {
            _busy = false;
            _loaded = true;
        }
    }

    // A live ProposalPending / ProposalResolved event: refresh the queue (and the open detail
    // if the resolved proposal is the selected one) without polling.
    private void OnProposalEvent(ConsoleProposalEvent evt)
    {
        _ = InvokeAsync(async () =>
        {
            if (evt.EventKind == ConsoleProposalEventKind.Resolved
                && string.Equals(evt.ProposalId, _selectedProposalId, StringComparison.Ordinal))
            {
                _detailReloadToken++;
            }

            await RefreshAsync();
            StateHasChanged();
        });
    }

    private void SetFilter(ApprovalTicketType? type) => _filter = type;

    private bool IsSelected(ApprovalInboxItem item) =>
        string.Equals(item.ProposalId, _selectedProposalId, StringComparison.Ordinal);

    private void Select(ApprovalInboxItem item) => _selectedProposalId = item.ProposalId;

    private async Task OnProposalActioned(ConsoleProposalDetail detail)
    {
        // After an approve / reject, refresh the queue so a now-resolved proposal drops out of
        // the pending set.
        await RefreshAsync();
    }

    public ValueTask DisposeAsync()
    {
        // The realtime client is an app-lifetime singleton shared across circuits; only detach
        // this page's handler. The connection is torn down by the DI container on shutdown, not
        // when one operator navigates away.
        Realtime.ProposalChanged -= OnProposalEvent;
        return ValueTask.CompletedTask;
    }
}
