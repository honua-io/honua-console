@page "/studio/query"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Validation
@inject IStudioQueryPackageDataSource QueryData
@inject IConsoleCapabilityManifest Capabilities

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have unsaved query changes. Leave this page and discard them?" />

@* Studio spatial query builder (honua-console#52). Binds to the server-owned saved-query content lifecycle
   (honua-server#1182, AnalysisContentKind.SavedQuery): the missing-binding surface when no honua-server is
   configured, otherwise the authoring editor (source binding, predicate builder, generated SQL/filter
   readout, projection, parameter editor, save-as-content) and the live map/table preview. *@

@* SHELVED (studio-builders capability). The Console's non-realtime Studio builder surfaces are gated
   OFF by default: "Studio" is now the realtime, SDK-driven app builder, which lives outside the Console.
   The page, its services, and its generation clients are untouched behind this gate, so advertising
   studio-builders in Honua:Console:Capabilities / HONUA_CONSOLE_CAPABILITIES restores it unchanged. *@
<ConsoleCapabilityGate Capability="@ConsoleCapabilityKeys.StudioBuilders"
                       Kicker="Shelved"
                       Title="The Studio query builder is shelved"
                       Message="Authoring saved query packages in the Console is shelved: Honua Studio is now the realtime, SDK-driven app builder, which is not a Console surface. The Console keeps its back-office roles — Catalog, Operate, Share, support, and the publish/approval flows. Nothing was deleted: this builder returns as-is once the deployment advertises the studio-builders capability.">
<section class="console-page studio-query-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>Query builder</h1>
        <p>Author a server-owned spatial query package — source binding, predicate builder, generated SQL/filter readout, projection, parameters, and map/table preview — then save it as a reusable content version on honua-server. A saved query can be reopened and reused as input to map, dashboard, report, app, and workflow editors.</p>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Query builder"
                          Title="Loading query packages"
                          Message="Reading the saved query content lifecycle from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Query content lifecycle is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else
    {
        @if (_states.Count > 0)
        {
            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Query binding</p>
                    <h2>Server Capability States</h2>
                </div>
                <div class="console-panel-grid">
                    @foreach (var state in _states)
                    {
                        <article class="console-panel">
                            <div class="console-panel-heading">
                                <div>
                                    <p class="console-kicker">@state.State</p>
                                    <h2>@state.Surface</h2>
                                </div>
                            </div>
                            <ConsoleDiagnostics Summary="@(state.Summary ?? StudioCapabilityCopy.Summary(state.Surface, state.State))"
                                                Detail="@state.Detail"
                                                State="@state.State"
                                                Contract="@state.Contract"
                                                StatusCode="@state.StatusCode"
                                                IssueRef="@state.IssueRef" />
                        </article>
                    }
                </div>
            </section>
        }

        @if (_query is null)
        {
            <div class="console-toolbar">
                <button class="console-button" type="button" disabled="@_busy" @onclick="NewFromPrompt">New from prompt</button>
                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="NewQuery">New blank query</button>
            </div>

            <div class="studio-query-workspace" data-query-builder="query.package">
                @if (_workspace.Packages.Count == 0)
                {
                    <EmptyState Area="studio" Subject="query packages" />
                }
                else
                {
                    <div class="console-table-wrap">
                        <table class="console-table">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Source binding</th>
                                    <th>Draft</th>
                                    <th>Published</th>
                                    <th>Updated</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var package in _workspace.Packages)
                                {
                                    <tr>
                                        <td>
                                            <button type="button" class="console-button console-button-secondary" disabled="@_busy" @onclick="() => OpenQuery(package.QueryId)">@package.Title</button>
                                            <small>@package.QueryId</small>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(package.SourceBinding) ? "unset" : package.SourceBinding)</td>
                                        <td>@(package.DraftVersion?.ToString() ?? "—")</td>
                                        <td>@(package.PublishedVersion?.ToString() ?? "—")</td>
                                        <td>@package.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else if (_view == EditorView.FromPrompt)
        {
            @* StudioQueryAI — conversation + clarification on the left, a live query inspector on the right
               driven by the real authoring state (never fabricated). A prompt/refine turn calls the
               server's natural-language query generation contract; the page only ever renders a
               server-produced query, a structured clarification request, or an honest
               unavailable/refused/blocked state. *@
            <div class="studio-query-ai" data-query-ai="query.package">
                <StudioAiConversation ConversationTitle="Query from prompt"
                                      RefinePlaceholder="Describe the query — the source layer, the filter predicates, and what fields to return…"
                                      Turns="_turns"
                                      Clarifications="_clarifications"
                                      Busy="_busy"
                                      OnSend="OnPromptSend"
                                      OnAnswer="OnClarificationAnswered"
                                      OnCancel="HandleCancelAsync">
                    <PreviewHeader>
                        <span class="studio-query-bar-glyph" aria-hidden="true">◇</span>
                        <input class="console-input studio-query-title-input" @bind="_query.Title" @bind:after="OnEdit" placeholder="Flood-zone permits" aria-label="Query title" />
                        <span class="console-status console-status-warning">@(_query.IsExistingQuery ? $"draft v{_query.Version}" : "draft")</span>
                        <div class="studio-ai-preview-head-spacer"></div>
                        <button class="console-button" type="button" disabled="@_busy" @onclick="OpenEditorFromPrompt">Open editor →</button>
                    </PreviewHeader>
                    <PreviewContent>
                        <div class="studio-query-ai-inspect">
                            <aside class="studio-query-ai-package" aria-label="Saved query">
                                <div class="studio-query-ai-package-head">
                                    <p class="console-kicker">Saved query</p>
                                    <p class="studio-query-ai-package-id">@(string.IsNullOrWhiteSpace(_query.Title) ? "new query" : _query.Title) · @QuerySummary(_query)</p>
                                </div>

                                <p class="console-muted studio-query-ai-section">Source</p>
                                <div class="studio-mono">@(string.IsNullOrWhiteSpace(_query.ServiceName) ? "unbound service" : _query.ServiceName)/layer @_query.LayerId · @_query.OutputFormat</div>

                                <p class="console-muted studio-query-ai-section">Predicates · @_query.Predicates.Count (@_query.Combinator.ToUpperInvariant())</p>
                                @if (_query.Predicates.Count == 0)
                                {
                                    <p class="console-muted">No predicates yet. An empty filter selects every feature; describe the filter on the left.</p>
                                }
                                else
                                {
                                    <ul class="studio-query-ai-predicate-list">
                                        @foreach (var predicate in _query.Predicates)
                                        {
                                            <li class="studio-mono">@PredicateSummary(predicate)</li>
                                        }
                                    </ul>
                                }

                                <p class="console-muted studio-query-ai-section">Projection · @_query.OutFields.Count(f => !string.IsNullOrWhiteSpace(f))</p>
                                @if (_query.OutFields.Count(f => !string.IsNullOrWhiteSpace(f)) == 0)
                                {
                                    <p class="console-muted">All fields returned.</p>
                                }
                                else
                                {
                                    <ul class="studio-query-ai-field-list">
                                        @foreach (var field in _query.OutFields.Where(f => !string.IsNullOrWhiteSpace(f)))
                                        {
                                            <li class="studio-mono">@field</li>
                                        }
                                    </ul>
                                }

                                @if (_query.Parameters.Count > 0)
                                {
                                    <p class="console-muted studio-query-ai-section">Parameters · @_query.Parameters.Count</p>
                                    <ul class="studio-query-ai-param-list">
                                        @foreach (var parameter in _query.Parameters)
                                        {
                                            <li class="studio-mono">@parameter.Name = @parameter.Value</li>
                                        }
                                    </ul>
                                }

                                <p class="console-muted studio-query-ai-section">Generated SQL</p>
                                <pre class="console-code studio-query-sql" data-query-ai-readout="true">@StudioQueryReadoutGenerator.Generate(_query)</pre>

                                @* The query RESULT — the live graph of the bound layer's real rows (count by
                                   the projected field). Renders only when the query is bound to a real
                                   service+layer; an unbound draft shows no result (no fabricated data). *@
                                @if (StudioQueryResultChart.IsBound(_query))
                                {
                                    <p class="console-muted studio-query-ai-section" data-query-ai-result="true">Result · live (@_query.ServiceName/layer @_query.LayerId)</p>
                                    <ChartPreview Title="@("Features by " + StudioQueryResultChart.DimensionField(_query))"
                                                  Spec="@StudioQueryResultChart.BuildSpec(_query)"
                                                  FeaturesUrl="@StudioQueryResultChart.FeaturesUrl(_query)"
                                                  Height="200"
                                                  AriaLabel="Query result chart" />
                                }
                            </aside>
                        </div>
                    </PreviewContent>
                </StudioAiConversation>
            </div>
        }
        else
        {
            var query = _query;
            var readout = StudioQueryReadoutGenerator.Generate(query);

            <div class="studio-query-editor" data-query-editor="query.package">
                <div class="studio-query-bar" data-query-editor-bar="true">
                    <span class="studio-query-bar-glyph" aria-hidden="true">◇</span>
                    <div class="studio-query-bar-identity">
                        <p class="console-kicker">@(query.IsExistingQuery ? $"{query.QueryId} · v{query.Version}" : "New draft")</p>
                        <h2>@(string.IsNullOrWhiteSpace(query.Title) ? "Untitled query" : query.Title)</h2>
                    </div>
                    <span class="console-status console-status-warning studio-query-bar-badge">@(query.IsExistingQuery ? $"draft v{query.Version}" : "draft")</span>
                    <span class="console-muted studio-query-bar-summary" data-query-summary="true">@QuerySummary(query)</span>
                    <div class="studio-query-bar-actions">
                        @if (_cameFromPrompt)
                        {
                            <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToChat">← Back to chat</button>
                        }
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToList">Back to queries</button>
                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || !query.IsExistingQuery)" @onclick="Preview">Run preview</button>
                        <button class="console-button" type="button" disabled="@(_busy || _validation.HasBlockingClientErrors)" @onclick="Save">Save query</button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_status))
                {
                    <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
                }

                @if (_validation.HasBlockingClientErrors)
                {
                    <article class="console-panel" aria-labelledby="query-validation-blocking-heading" data-validation-summary="blocking">
                        <p class="console-kicker">Validation</p>
                        <h3 id="query-validation-blocking-heading">Resolve before saving</h3>
                        <ul class="studio-compact-list">
                            @foreach (var error in _validation.Summary.Where(e => e.IsBlocking))
                            {
                                <li>@error.Message</li>
                            }
                        </ul>
                    </article>
                }

                <div class="studio-query-workbench" data-query-workbench="true">
                <div class="studio-query-build" data-query-build="true">
                <div class="console-panel-grid">
                    <article class="console-panel">
                        <p class="console-kicker">Source</p>
                        <h3>Source binding</h3>
                        @if (query.IsExistingQuery && !string.IsNullOrWhiteSpace(query.QueryId))
                        {
                            <FieldStateRow State="FieldState.System" Label="Query id" Value="@query.QueryId" Hint="@($"v{query.Version}")" />
                        }
                        <FieldStateRow State="FieldState.Input" Label="Title">
                            <input class="console-input" @bind="query.Title" @bind:after="OnEdit" placeholder="Flood-zone permits" />
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Description">
                            <textarea class="console-input" rows="2" @bind="query.Description" @bind:after="OnEdit"></textarea>
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Natural-language query">
                            <textarea class="console-input" rows="2" @bind="query.NaturalLanguageQuery" @bind:after="OnEdit" placeholder="Permits in flood zones issued after 2024"></textarea>
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Service name" Errors="_validation.Errors(StudioQueryFieldKeys.ServiceName)">
                            <input class="console-input" @bind="query.ServiceName" @bind:after="OnEdit" placeholder="permits" />
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Layer id" Errors="_validation.Errors(StudioQueryFieldKeys.LayerId)">
                            <input class="console-input" type="number" @bind="query.LayerId" @bind:after="OnEdit" />
                        </FieldStateRow>
                    </article>

                    <article class="console-panel">
                        <p class="console-kicker">Output</p>
                        <h3>Projection and format</h3>
                        <label class="studio-form-label">
                            <span>Output format</span>
                            <select class="console-input" @bind="query.OutputFormat" @bind:after="OnEdit">
                                @foreach (var format in StudioQueryOutputFormats.All)
                                {
                                    <option value="@format">@format</option>
                                }
                            </select>
                        </label>
                        <label class="studio-form-label">
                            <span>Output SRID (optional)</span>
                            <input class="console-input" type="number" @bind="_outputSridInput" @bind:after="OnEdit" placeholder="4326" />
                            <ValidationMessageInline FieldKey="@StudioQueryFieldKeys.OutputSrid" State="_validation" />
                        </label>
                        <label class="studio-form-label">
                            <span>Preview limit</span>
                            <input class="console-input" type="number" min="1" @bind="query.PreviewLimit" @bind:after="OnEdit" />
                            <ValidationMessageInline FieldKey="@StudioQueryFieldKeys.PreviewLimit" State="_validation" />
                        </label>

                        <div class="console-panel-heading">
                            <div><p class="console-kicker">Fields</p><h4>Attribute projection</h4></div>
                            <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="AddOutField">Add field</button>
                        </div>
                        @if (query.OutFields.Count == 0)
                        {
                            <p class="console-muted">All fields are returned. Add a field to restrict the projection.</p>
                        }
                        @for (var i = 0; i < query.OutFields.Count; i++)
                        {
                            var index = i;
                            <div class="console-action-row" @key="index">
                                <input class="console-input" value="@query.OutFields[index]" @onchange="e => SetOutField(index, e)" placeholder="permit_id" />
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => RemoveOutField(index)">Remove</button>
                            </div>
                        }
                    </article>
                </div>

                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Predicate builder</p>
                            <h3>Filter predicates</h3>
                        </div>
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="AddPredicate">Add predicate</button>
                    </div>

                    <label class="studio-form-label">
                        <span>Combine clauses with</span>
                        <select class="console-input" @bind="query.Combinator" @bind:after="OnEdit">
                            @foreach (var combinator in StudioQueryCombinators.All)
                            {
                                <option value="@combinator">@combinator.ToUpperInvariant()</option>
                            }
                        </select>
                    </label>

                    @if (query.Predicates.Count == 0)
                    {
                        <p class="console-muted">No predicates yet. An empty filter selects every feature in the source layer.</p>
                    }

                    @for (var p = 0; p < query.Predicates.Count; p++)
                    {
                        var predicateIndex = p;
                        var predicate = query.Predicates[predicateIndex];
                        <div class="console-panel-grid" @key="predicate">
                            <label class="studio-form-label">
                                <span>Kind</span>
                                <select class="console-input" value="@predicate.Kind" @onchange="e => SetPredicateKind(predicate, e)">
                                    @foreach (var kind in StudioQueryPredicateKinds.All)
                                    {
                                        <option value="@kind">@kind</option>
                                    }
                                </select>
                            </label>

                            @if (predicate.Kind == StudioQueryPredicateKinds.Spatial)
                            {
                                <label class="studio-form-label">
                                    <span>Operator</span>
                                    <select class="console-input" @bind="predicate.Operator" @bind:after="OnEdit">
                                        @foreach (var op in StudioQuerySpatialOperators.All)
                                        {
                                            <option value="@op">@op</option>
                                        }
                                    </select>
                                </label>
                                <label class="studio-form-label"><span>Geometry (GeoJSON)</span><input class="console-input" @bind="predicate.Geometry" @bind:after="OnEdit" placeholder='{"type":"Point","coordinates":[0,0]}' /></label>
                                <ValidationMessageInline FieldKey="@StudioQueryFieldKeys.PredicateGeometry(predicateIndex)" State="_validation" />
                                @if (predicate.Operator == "dwithin")
                                {
                                    <label class="studio-form-label"><span>Distance</span><input class="console-input" @bind="predicate.Value" @bind:after="OnEdit" placeholder="500" /></label>
                                    <label class="studio-form-label"><span>Unit</span><input class="console-input" @bind="predicate.DistanceUnit" @bind:after="OnEdit" placeholder="meters" /></label>
                                    <ValidationMessageInline FieldKey="@StudioQueryFieldKeys.PredicateDistance(predicateIndex)" State="_validation" />
                                }
                            }
                            else if (predicate.Kind == StudioQueryPredicateKinds.Temporal)
                            {
                                <label class="studio-form-label"><span>Field</span><input class="console-input" @bind="predicate.Field" @bind:after="OnEdit" placeholder="issued_at" /></label>
                                <label class="studio-form-label">
                                    <span>Operator</span>
                                    <select class="console-input" @bind="predicate.Operator" @bind:after="OnEdit">
                                        @foreach (var op in StudioQueryTemporalOperators.All)
                                        {
                                            <option value="@op">@op</option>
                                        }
                                    </select>
                                </label>
                                <label class="studio-form-label"><span>Start (ISO 8601)</span><input class="console-input" @bind="predicate.Start" @bind:after="OnEdit" placeholder="2024-01-01" /></label>
                                <label class="studio-form-label"><span>End (ISO 8601)</span><input class="console-input" @bind="predicate.End" @bind:after="OnEdit" placeholder="2024-12-31" /></label>
                                <ValidationMessageInline FieldKey="@StudioQueryFieldKeys.PredicateRange(predicateIndex)" State="_validation" />
                            }
                            else
                            {
                                <label class="studio-form-label"><span>Field</span><input class="console-input" @bind="predicate.Field" @bind:after="OnEdit" placeholder="status" /></label>
                                <label class="studio-form-label">
                                    <span>Operator</span>
                                    <select class="console-input" @bind="predicate.Operator" @bind:after="OnEdit">
                                        @foreach (var op in StudioQueryComparisonOperators.All)
                                        {
                                            <option value="@op">@op</option>
                                        }
                                    </select>
                                </label>
                                <label class="studio-form-label"><span>Value</span><input class="console-input" @bind="predicate.Value" @bind:after="OnEdit" placeholder="approved" /></label>
                            }

                            <div class="console-action-row">
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => RemovePredicate(predicate)">Remove</button>
                            </div>
                        </div>
                    }
                </article>

                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div><p class="console-kicker">Parameters</p><h3>Query parameters</h3></div>
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="AddParameter">Add parameter</button>
                    </div>
                    @if (query.Parameters.Count == 0)
                    {
                        <p class="console-muted">No parameters set.</p>
                    }
                    @foreach (var parameter in query.Parameters)
                    {
                        <div class="console-panel-grid" @key="parameter">
                            <FieldStateRow State="FieldState.Input" Label="Name">
                                <input class="console-input" @bind="parameter.Name" @bind:after="OnEdit" placeholder="minYear" />
                            </FieldStateRow>
                            <FieldStateRow State="FieldState.Input" Label="Value">
                                <input class="console-input" @bind="parameter.Value" @bind:after="OnEdit" placeholder="2024" />
                            </FieldStateRow>
                            <div class="console-action-row">
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => RemoveParameter(parameter)">Remove</button>
                            </div>
                        </div>
                    }
                </article>
                </div>

                <div class="studio-query-readout-pane" data-query-readout-pane="true">
                <article class="console-panel studio-query-readout" aria-labelledby="query-readout-heading">
                    <p class="console-kicker">Generated SQL</p>
                    <h3 id="query-readout-heading">SQL / filter readout</h3>
                    <p class="console-muted">Read-only · regenerates on edit. A SQL-shaped view of the source binding and predicates for review before save. honua-server owns the compiled query plan.</p>
                    <pre class="console-code studio-query-sql" data-query-readout="true">@readout</pre>
                </article>

                @if (query.Preview is { } preview)
                {
                    <article class="console-panel studio-query-preview" data-query-preview="true" aria-labelledby="query-preview-heading">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Preview · @preview.FeatureCount@(preview.TotalCount is { } t ? $" of {t:N0} matching" : " matching")</p>
                                <h3 id="query-preview-heading">Map / table preview</h3>
                            </div>
                            @if (query.Parameters.Count > 0)
                            {
                                <span class="console-muted studio-query-preview-params" data-query-preview-params="true">@ParameterReadout(query)</span>
                            }
                        </div>
                        <dl class="console-definition-list">
                            <dt>Layer</dt>
                            <dd>@preview.LayerId</dd>
                            <dt>Features</dt>
                            <dd>@preview.FeatureCount.ToString("N0")@(preview.TotalCount is { } total ? $" of {total:N0}" : string.Empty)@(preview.ExceededPreviewLimit ? " (preview limit exceeded)" : string.Empty)</dd>
                            <dt>Geometry</dt>
                            <dd>@(preview.HasGeometry ? "yes" : "no")</dd>
                        </dl>

                        @if (preview.FeatureCount == 0)
                        {
                            <p class="console-muted">The query returned no features for the current predicates.</p>
                        }
                        else
                        {
                            <div class="console-table-wrap">
                                <table class="console-table" data-query-preview-table="true">
                                    <thead>
                                        <tr>
                                            <th>id</th>
                                            @foreach (var column in preview.Columns)
                                            {
                                                <th>@column</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var feature in preview.Features)
                                        {
                                            <tr @key="feature.Id">
                                                <td>@feature.Id</td>
                                                @foreach (var column in preview.Columns)
                                                {
                                                    <td>@(feature.Attributes.GetValueOrDefault(column, string.Empty))</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <p class="console-kicker">Reuse this query as</p>
                        <ul class="studio-compact-list" data-query-downstream="true">
                            @foreach (var target in preview.DownstreamTargets)
                            {
                                <li>@DownstreamLabel(target)</li>
                            }
                        </ul>

                        <p class="console-muted studio-query-explain" data-query-explain="true">
                            EXPLAIN · preview artifact <code>@preview.PreviewArtifactId</code> · layer @preview.LayerId@(preview.ExceededPreviewLimit ? " · preview limit reached" : string.Empty)
                        </p>
                    </article>
                }
                else
                {
                    <article class="console-panel studio-query-preview studio-query-preview-empty" data-query-preview-empty="true">
                        <p class="console-kicker">Preview</p>
                        <h3>Map / table preview</h3>
                        <p class="console-muted">@(query.IsExistingQuery ? "Run preview to pull the live map/table result and EXPLAIN readout from honua-server." : "Save this draft, then run preview to pull the live map/table result from honua-server.")</p>
                    </article>
                }
                </div>
                </div>
            </div>
        }
    }
</section>
</ConsoleCapabilityGate>

@code {
    private enum EditorView
    {
        FromPrompt,
        Editor,
    }

    private bool _loading = true;
    private bool _busy;
    private CancellationTokenSource _cts = new();
    private StudioQueryWorkspace _workspace = new([], []);
    private StudioQueryCapabilityState? _bindingState;
    private IReadOnlyList<StudioQueryCapabilityState> _states = [];
    private StudioQueryEditor? _query;
    private string? _status;
    private bool _statusFailed;
    private readonly ValidationState _validation = new();
    private readonly FormDirtyState _dirty = new();

    private EditorView _view = EditorView.Editor;
    private bool _cameFromPrompt;
    private readonly List<StudioConversationTurn> _turns = [];
    private readonly List<StudioConversationClarification> _clarifications = [];

    private int? _outputSridInput
    {
        get => _query?.OutputSrid;
        set
        {
            if (_query is not null)
            {
                _query.OutputSrid = value;
            }
        }
    }

    protected override Task OnInitializedAsync()
    {
        // Shelved surface: ConsoleCapabilityGate renders the shelved state instead of this
        // builder, so there is nothing to read from honua-server.
        if (!Capabilities.IsAdvertised(ConsoleCapabilityKeys.StudioBuilders))
        {
            return Task.CompletedTask;
        }

        return LoadWorkspaceAsync();
    }

    /// <summary>
    /// Re-runs the client cross-field/bounds validator over the current query and flags the editor dirty.
    /// Called from the markup's <c>@bind:after</c> wiring on every bound edit (cheap and synchronous).
    /// </summary>
    private void OnEdit()
    {
        _dirty.MarkDirty();
        RecomputeClientErrors();
    }

    private void RecomputeClientErrors() =>
        _validation.SetClientErrors(_query is null
            ? Array.Empty<ConsoleFieldError>()
            : StudioQueryValidator.Instance.Evaluate(_query));

    private async Task LoadWorkspaceAsync()
    {
        _loading = true;
        _workspace = await QueryData.GetWorkspaceAsync();
        ApplyStates(_workspace.CapabilityStates);
        _loading = false;
    }

    private Task NewFromPrompt() => RunLoadAsync(() => QueryData.LoadAsync(null), EditorView.FromPrompt);

    private Task NewQuery() => RunLoadAsync(() => QueryData.LoadAsync(null), EditorView.Editor);

    private Task OpenQuery(string queryId) => RunLoadAsync(() => QueryData.LoadAsync(queryId), EditorView.Editor);

    private async Task RunLoadAsync(Func<Task<StudioQueryEditorLoad>> load, EditorView view)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _status = null;
        _statusFailed = false;
        try
        {
            var result = await load();
            ApplyStates(result.CapabilityStates);
            _query = result.Query;
            _view = view;
            _cameFromPrompt = view == EditorView.FromPrompt;
            ResetConversation();

            // A fresh load is the clean baseline: drop local edits/dirty state and recompute client findings.
            _validation.Clear();
            _dirty.MarkClean();
            RecomputeClientErrors();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ResetConversation()
    {
        _turns.Clear();
        _clarifications.Clear();

        // The conversation log is Console-local authoring UX — it echoes the author's intent and Honua's
        // proposal rationale, never fabricated query state. The right-side inspector reflects the real
        // StudioQueryEditor. Until the author describes the query there is just an opening prompt.
        _turns.Add(new StudioConversationTurn(
            StudioConversationRole.Honua,
            "Describe the query you want — the source layer, the filter predicates (attribute, spatial, or temporal), and which fields to return — and I'll propose a saved query you can review and refine. Every proposal is grounded in the real layer/field catalog and validated on the server before it appears; nothing is fabricated.",
            "just now",
            StudioConversationTone.Neutral));
    }

    private void OpenEditorFromPrompt()
    {
        _view = EditorView.Editor;
        _cameFromPrompt = true;
    }

    private void BackToChat()
    {
        if (_query is null)
        {
            return;
        }

        _view = EditorView.FromPrompt;
    }

    // A prompt/refine turn calls the server's natural-language query generation contract
    // (POST /api/v1/analysis/content/queries/generate). The server grounds the proposal in the layer/field
    // catalog and validates it before returning, so the page only ever renders a server-produced query
    // (status == generated, the editor hydrates from the returned SavedQueryContent), a structured
    // clarification request, or an honest unavailable/refused/blocked state — never a fabricated query
    // (Charter §11).
    private Task OnPromptSend(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt))
        {
            return Task.CompletedTask;
        }

        _turns.Add(new StudioConversationTurn(StudioConversationRole.You, prompt, "just now"));
        return GenerateAsync(new StudioQueryGenerationRequest
        {
            Prompt = prompt,
            Conversation = SnapshotConversation()
        });
    }

    private Task OnClarificationAnswered((StudioConversationClarification Question, StudioConversationChoice Choice) answer)
    {
        _clarifications.RemoveAll(question => string.Equals(question.Id, answer.Question.Id, StringComparison.Ordinal));
        _turns.Add(new StudioConversationTurn(
            StudioConversationRole.You,
            $"{answer.Question.Label}: {answer.Choice.Label}",
            "just now"));

        return GenerateAsync(new StudioQueryGenerationRequest
        {
            Prompt = string.Empty,
            Conversation = SnapshotConversation(),
            Answers = [new StudioQueryGenerationAnswer(answer.Question.Id, answer.Choice.Id)]
        });
    }

    private IReadOnlyList<StudioQueryGenerationTurn> SnapshotConversation() =>
        _turns
            .Select(turn => new StudioQueryGenerationTurn(
                turn.Role == StudioConversationRole.You ? "user" : "assistant",
                turn.Body))
            .ToArray();

    // Cancels the in-flight generation request and resets busy state so the user can send a revised prompt.
    // A cancelled request surfaces as a "Request cancelled" turn rather than an error, keeping the
    // conversation usable. Mirrors the identical pattern in StudioFormAiPage.
    private Task HandleCancelAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        _cts = new CancellationTokenSource();
        _busy = false;
        _turns.Add(new StudioConversationTurn(
            StudioConversationRole.Honua,
            "Request cancelled — refine your prompt and send again.",
            "just now",
            StudioConversationTone.Neutral));
        return Task.CompletedTask;
    }

    private async Task GenerateAsync(StudioQueryGenerationRequest request)
    {
        if (_query is null || _busy)
        {
            return;
        }

        _busy = true;
        var ct = _cts.Token;
        try
        {
            var outcome = await QueryData.GenerateAsync(_query, request, ct);

            if (outcome.BindingState is not null)
            {
                if (string.Equals(outcome.BindingState.State, "Missing binding", StringComparison.OrdinalIgnoreCase))
                {
                    _bindingState = outcome.BindingState;
                    return;
                }

                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    $"{outcome.BindingState.Detail} (contract: {outcome.BindingState.Contract})",
                    "just now",
                    StudioConversationTone.Neutral));
                return;
            }

            var notes = outcome.Warnings.ToList();
            if (outcome.CapabilityState is { } capability
                && !string.Equals(capability.State, "supported", StringComparison.OrdinalIgnoreCase))
            {
                notes.Insert(0, $"{capability.Name}: {capability.State}{(string.IsNullOrWhiteSpace(capability.Reason) ? string.Empty : $" — {capability.Reason}")}");
            }

            if (outcome.IsGenerated)
            {
                if (outcome.Query is not null)
                {
                    _query = outcome.Query;
                }

                _clarifications.Clear();
                _dirty.MarkDirty();
                RecomputeClientErrors();

                var summary = string.IsNullOrWhiteSpace(outcome.Rationale)
                    ? $"Proposed a query · {(string.IsNullOrWhiteSpace(_query.ServiceName) ? "unbound" : _query.ServiceName)}/layer {_query.LayerId} · {_query.Predicates.Count} predicate(s). Refine by chatting, or open the editor."
                    : outcome.Rationale;
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(summary, notes),
                    "just now",
                    StudioConversationTone.Ready,
                    "view evidence"));
            }
            else if (outcome.NeedsClarification)
            {
                _clarifications.Clear();
                _clarifications.AddRange(outcome.Clarifications);
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(
                        string.IsNullOrWhiteSpace(outcome.Rationale)
                            ? "I need a little more detail before I can propose the query."
                            : outcome.Rationale,
                        notes),
                    "just now",
                    StudioConversationTone.Clarification));
            }
            else
            {
                // unsupported / refused / error
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(
                        string.IsNullOrWhiteSpace(outcome.Rationale)
                            ? "I couldn't turn that into a query."
                            : outcome.Rationale,
                        notes),
                    "just now",
                    StudioConversationTone.Neutral));
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelled by the user via HandleCancelAsync — the cancel turn and _busy=false are already
            // set there; suppress the exception so the conversation stays in a good state.
        }
        finally
        {
            _busy = false;
        }
    }

    private static string AppendNotes(string body, IReadOnlyList<string> notes) =>
        notes.Count == 0 ? body : $"{body}\n\nNotes:\n- {string.Join("\n- ", notes)}";

    private async Task BackToList()
    {
        _query = null;
        _status = null;
        _statusFailed = false;
        _view = EditorView.Editor;
        _cameFromPrompt = false;
        _validation.Clear();
        _dirty.MarkClean();
        await LoadWorkspaceAsync();
    }

    private void AddPredicate()
    {
        _query?.Predicates.Add(new StudioQueryPredicateEditor());
        OnEdit();
    }

    private void RemovePredicate(StudioQueryPredicateEditor predicate)
    {
        _query?.Predicates.Remove(predicate);
        OnEdit();
    }

    private void SetPredicateKind(StudioQueryPredicateEditor predicate, ChangeEventArgs args)
    {
        predicate.Kind = args.Value?.ToString() ?? StudioQueryPredicateKinds.Comparison;
        predicate.Operator = predicate.Kind switch
        {
            StudioQueryPredicateKinds.Spatial => StudioQuerySpatialOperators.All[0],
            StudioQueryPredicateKinds.Temporal => StudioQueryTemporalOperators.All[0],
            _ => StudioQueryComparisonOperators.All[0]
        };
        OnEdit();
    }

    private void AddParameter()
    {
        _query?.Parameters.Add(new StudioQueryParameterEditor());
        OnEdit();
    }

    private void RemoveParameter(StudioQueryParameterEditor parameter)
    {
        _query?.Parameters.Remove(parameter);
        OnEdit();
    }

    private void AddOutField()
    {
        _query?.OutFields.Add(string.Empty);
        OnEdit();
    }

    private void SetOutField(int index, ChangeEventArgs args)
    {
        if (_query is not null && index >= 0 && index < _query.OutFields.Count)
        {
            _query.OutFields[index] = args.Value?.ToString() ?? string.Empty;
        }

        OnEdit();
    }

    private void RemoveOutField(int index)
    {
        if (_query is not null && index >= 0 && index < _query.OutFields.Count)
        {
            _query.OutFields.RemoveAt(index);
        }

        OnEdit();
    }

    private Task Save() => RunCommandAsync(() => QueryData.SaveAsync(_query!));

    private Task Preview() => RunCommandAsync(() => QueryData.PreviewAsync(_query!));

    private async Task RunCommandAsync(Func<Task<StudioQueryCommandResult>> command)
    {
        if (_busy || _query is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await command();
            _status = result.Message;
            _statusFailed = !result.Succeeded;

            if (result.Query is not null)
            {
                _query = result.Query;
            }

            // Re-run the client validator against the post-command query. A successful command leaves the
            // editor on a clean, server-synced baseline.
            RecomputeClientErrors();
            if (result.Succeeded)
            {
                _dirty.MarkClean();
            }

            ApplyStates(result.Issue is null ? [] : [result.Issue]);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string QuerySummary(StudioQueryEditor query)
    {
        var sourceCount = string.IsNullOrWhiteSpace(query.ServiceName) ? 0 : 1;
        var fieldCount = query.OutFields.Count(field => !string.IsNullOrWhiteSpace(field));
        var fields = fieldCount == 0 ? "all fields" : $"{fieldCount} field{(fieldCount == 1 ? string.Empty : "s")}";
        return $"{sourceCount} source · {query.Predicates.Count} predicate{(query.Predicates.Count == 1 ? string.Empty : "s")} · {query.Parameters.Count} param{(query.Parameters.Count == 1 ? string.Empty : "s")} · {fields}";
    }

    private static string PredicateSummary(StudioQueryPredicateEditor predicate) => predicate.Kind switch
    {
        StudioQueryPredicateKinds.Spatial => string.Equals(predicate.Operator, "dwithin", StringComparison.OrdinalIgnoreCase)
            ? $"geometry {predicate.Operator} {predicate.Value} {predicate.DistanceUnit}"
            : $"geometry {predicate.Operator}",
        StudioQueryPredicateKinds.Temporal => string.IsNullOrWhiteSpace(predicate.End)
            ? $"{predicate.Field} {predicate.Operator} {predicate.Start}"
            : $"{predicate.Field} {predicate.Operator} {predicate.Start}..{predicate.End}",
        _ => $"{predicate.Field} {predicate.Operator} {predicate.Value}"
    };

    private static string ParameterReadout(StudioQueryEditor query) =>
        string.Join(" · ", query.Parameters
            .Where(parameter => !string.IsNullOrWhiteSpace(parameter.Name))
            .Select(parameter => $"${parameter.Name}={(string.IsNullOrWhiteSpace(parameter.Value) ? "—" : parameter.Value)}"));

    private static string DownstreamLabel(string target) => target switch
    {
        "map" => "Map layer",
        "dashboard" => "Dashboard input",
        "report" => "Report input",
        "app" => "App input",
        "workflow" => "Workflow input",
        _ => target
    };

    private void ApplyStates(IReadOnlyList<StudioQueryCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
        _states = states
            .Where(state => !ReferenceEquals(state, _bindingState))
            .ToArray();
    }
}
