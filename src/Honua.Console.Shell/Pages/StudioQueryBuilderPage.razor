@page "/studio/query"
@inject IStudioQueryPackageDataSource QueryData

@* Studio spatial query builder (honua-console#52). Binds to the server-owned saved-query content lifecycle
   (honua-server#1182, AnalysisContentKind.SavedQuery): the missing-binding surface when no honua-server is
   configured, otherwise the authoring editor (source binding, predicate builder, generated SQL/filter
   readout, projection, parameter editor, save-as-content) and the live map/table preview. *@

<section class="console-page studio-query-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>Query builder</h1>
        <p>Author a server-owned spatial query package — source binding, predicate builder, generated SQL/filter readout, projection, parameters, and map/table preview — then save it as a reusable content version on honua-server. A saved query can be reopened and reused as input to map, dashboard, report, app, and workflow editors.</p>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Query builder"
                          Title="Loading query packages"
                          Message="Reading the saved query content lifecycle from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Query content lifecycle is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else
    {
        @if (_states.Count > 0)
        {
            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Query binding</p>
                    <h2>Server Capability States</h2>
                </div>
                <div class="console-panel-grid">
                    @foreach (var state in _states)
                    {
                        <article class="console-panel">
                            <div class="console-panel-heading">
                                <div>
                                    <p class="console-kicker">@state.State</p>
                                    <h2>@state.Surface</h2>
                                </div>
                            </div>
                            <p class="console-muted">@state.Detail</p>
                            <dl class="console-definition-list">
                                <dt>Contract</dt>
                                <dd>@state.Contract</dd>
                            </dl>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_query is null)
        {
            <div class="console-toolbar">
                <button class="console-button" type="button" disabled="@_busy" @onclick="NewQuery">New query</button>
            </div>

            <div class="studio-query-workspace" data-query-builder="query.package">
                @if (_workspace.Packages.Count == 0)
                {
                    <EmptyState Area="studio" Subject="query packages" />
                }
                else
                {
                    <div class="console-table-wrap">
                        <table class="console-table">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Source binding</th>
                                    <th>Draft</th>
                                    <th>Published</th>
                                    <th>Updated</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var package in _workspace.Packages)
                                {
                                    <tr>
                                        <td>
                                            <button type="button" class="console-button console-button-secondary" disabled="@_busy" @onclick="() => OpenQuery(package.QueryId)">@package.Title</button>
                                            <small>@package.QueryId</small>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(package.SourceBinding) ? "unset" : package.SourceBinding)</td>
                                        <td>@(package.DraftVersion?.ToString() ?? "—")</td>
                                        <td>@(package.PublishedVersion?.ToString() ?? "—")</td>
                                        <td>@package.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
        else
        {
            var query = _query;
            var readout = StudioQueryReadoutGenerator.Generate(query);

            <div class="studio-query-editor" data-query-editor="query.package">
                <div class="studio-query-bar" data-query-editor-bar="true">
                    <span class="studio-query-bar-glyph" aria-hidden="true">◇</span>
                    <div class="studio-query-bar-identity">
                        <p class="console-kicker">@(query.IsExistingQuery ? $"{query.QueryId} · v{query.Version}" : "New draft")</p>
                        <h2>@(string.IsNullOrWhiteSpace(query.Title) ? "Untitled query" : query.Title)</h2>
                    </div>
                    <span class="console-status console-status-warning studio-query-bar-badge">@(query.IsExistingQuery ? $"draft v{query.Version}" : "draft")</span>
                    <span class="console-muted studio-query-bar-summary" data-query-summary="true">@QuerySummary(query)</span>
                    <div class="studio-query-bar-actions">
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToList">Back to queries</button>
                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || !query.IsExistingQuery)" @onclick="Preview">Run preview</button>
                        <button class="console-button" type="button" disabled="@_busy" @onclick="Save">Save query</button>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_status))
                {
                    <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
                }

                <div class="studio-query-workbench" data-query-workbench="true">
                <div class="studio-query-build" data-query-build="true">
                <div class="console-panel-grid">
                    <article class="console-panel">
                        <p class="console-kicker">Source</p>
                        <h3>Source binding</h3>
                        @if (query.IsExistingQuery && !string.IsNullOrWhiteSpace(query.QueryId))
                        {
                            <FieldStateRow State="FieldState.System" Label="Query id" Value="@query.QueryId" Hint="@($"v{query.Version}")" />
                        }
                        <FieldStateRow State="FieldState.Input" Label="Title">
                            <input class="console-input" @bind="query.Title" placeholder="Flood-zone permits" />
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Description">
                            <textarea class="console-input" rows="2" @bind="query.Description"></textarea>
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Natural-language query">
                            <textarea class="console-input" rows="2" @bind="query.NaturalLanguageQuery" placeholder="Permits in flood zones issued after 2024"></textarea>
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Service name">
                            <input class="console-input" @bind="query.ServiceName" placeholder="permits" />
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Layer id">
                            <input class="console-input" type="number" @bind="query.LayerId" />
                        </FieldStateRow>
                    </article>

                    <article class="console-panel">
                        <p class="console-kicker">Output</p>
                        <h3>Projection and format</h3>
                        <label class="studio-form-label">
                            <span>Output format</span>
                            <select class="console-input" @bind="query.OutputFormat">
                                @foreach (var format in StudioQueryOutputFormats.All)
                                {
                                    <option value="@format">@format</option>
                                }
                            </select>
                        </label>
                        <label class="studio-form-label">
                            <span>Output SRID (optional)</span>
                            <input class="console-input" type="number" @bind="_outputSridInput" placeholder="4326" />
                        </label>
                        <label class="studio-form-label">
                            <span>Preview limit</span>
                            <input class="console-input" type="number" min="1" @bind="query.PreviewLimit" />
                        </label>

                        <div class="console-panel-heading">
                            <div><p class="console-kicker">Fields</p><h4>Attribute projection</h4></div>
                            <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="AddOutField">Add field</button>
                        </div>
                        @if (query.OutFields.Count == 0)
                        {
                            <p class="console-muted">All fields are returned. Add a field to restrict the projection.</p>
                        }
                        @for (var i = 0; i < query.OutFields.Count; i++)
                        {
                            var index = i;
                            <div class="console-action-row" @key="index">
                                <input class="console-input" value="@query.OutFields[index]" @onchange="e => SetOutField(index, e)" placeholder="permit_id" />
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => RemoveOutField(index)">Remove</button>
                            </div>
                        }
                    </article>
                </div>

                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Predicate builder</p>
                            <h3>Filter predicates</h3>
                        </div>
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="AddPredicate">Add predicate</button>
                    </div>

                    <label class="studio-form-label">
                        <span>Combine clauses with</span>
                        <select class="console-input" @bind="query.Combinator">
                            @foreach (var combinator in StudioQueryCombinators.All)
                            {
                                <option value="@combinator">@combinator.ToUpperInvariant()</option>
                            }
                        </select>
                    </label>

                    @if (query.Predicates.Count == 0)
                    {
                        <p class="console-muted">No predicates yet. An empty filter selects every feature in the source layer.</p>
                    }

                    @foreach (var predicate in query.Predicates)
                    {
                        <div class="console-panel-grid" @key="predicate">
                            <label class="studio-form-label">
                                <span>Kind</span>
                                <select class="console-input" value="@predicate.Kind" @onchange="e => SetPredicateKind(predicate, e)">
                                    @foreach (var kind in StudioQueryPredicateKinds.All)
                                    {
                                        <option value="@kind">@kind</option>
                                    }
                                </select>
                            </label>

                            @if (predicate.Kind == StudioQueryPredicateKinds.Spatial)
                            {
                                <label class="studio-form-label">
                                    <span>Operator</span>
                                    <select class="console-input" @bind="predicate.Operator">
                                        @foreach (var op in StudioQuerySpatialOperators.All)
                                        {
                                            <option value="@op">@op</option>
                                        }
                                    </select>
                                </label>
                                <label class="studio-form-label"><span>Geometry (GeoJSON)</span><input class="console-input" @bind="predicate.Geometry" placeholder='{"type":"Point","coordinates":[0,0]}' /></label>
                                @if (predicate.Operator == "dwithin")
                                {
                                    <label class="studio-form-label"><span>Distance</span><input class="console-input" @bind="predicate.Value" placeholder="500" /></label>
                                    <label class="studio-form-label"><span>Unit</span><input class="console-input" @bind="predicate.DistanceUnit" placeholder="meters" /></label>
                                }
                            }
                            else if (predicate.Kind == StudioQueryPredicateKinds.Temporal)
                            {
                                <label class="studio-form-label"><span>Field</span><input class="console-input" @bind="predicate.Field" placeholder="issued_at" /></label>
                                <label class="studio-form-label">
                                    <span>Operator</span>
                                    <select class="console-input" @bind="predicate.Operator">
                                        @foreach (var op in StudioQueryTemporalOperators.All)
                                        {
                                            <option value="@op">@op</option>
                                        }
                                    </select>
                                </label>
                                <label class="studio-form-label"><span>Start (ISO 8601)</span><input class="console-input" @bind="predicate.Start" placeholder="2024-01-01" /></label>
                                <label class="studio-form-label"><span>End (ISO 8601)</span><input class="console-input" @bind="predicate.End" placeholder="2024-12-31" /></label>
                            }
                            else
                            {
                                <label class="studio-form-label"><span>Field</span><input class="console-input" @bind="predicate.Field" placeholder="status" /></label>
                                <label class="studio-form-label">
                                    <span>Operator</span>
                                    <select class="console-input" @bind="predicate.Operator">
                                        @foreach (var op in StudioQueryComparisonOperators.All)
                                        {
                                            <option value="@op">@op</option>
                                        }
                                    </select>
                                </label>
                                <label class="studio-form-label"><span>Value</span><input class="console-input" @bind="predicate.Value" placeholder="approved" /></label>
                            }

                            <div class="console-action-row">
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => RemovePredicate(predicate)">Remove</button>
                            </div>
                        </div>
                    }
                </article>

                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div><p class="console-kicker">Parameters</p><h3>Query parameters</h3></div>
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="AddParameter">Add parameter</button>
                    </div>
                    @if (query.Parameters.Count == 0)
                    {
                        <p class="console-muted">No parameters set.</p>
                    }
                    @foreach (var parameter in query.Parameters)
                    {
                        <div class="console-panel-grid" @key="parameter">
                            <FieldStateRow State="FieldState.Input" Label="Name">
                                <input class="console-input" @bind="parameter.Name" placeholder="minYear" />
                            </FieldStateRow>
                            <FieldStateRow State="FieldState.Input" Label="Value">
                                <input class="console-input" @bind="parameter.Value" placeholder="2024" />
                            </FieldStateRow>
                            <div class="console-action-row">
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="() => RemoveParameter(parameter)">Remove</button>
                            </div>
                        </div>
                    }
                </article>
                </div>

                <div class="studio-query-readout-pane" data-query-readout-pane="true">
                <article class="console-panel studio-query-readout" aria-labelledby="query-readout-heading">
                    <p class="console-kicker">Generated SQL</p>
                    <h3 id="query-readout-heading">SQL / filter readout</h3>
                    <p class="console-muted">Read-only · regenerates on edit. A SQL-shaped view of the source binding and predicates for review before save. honua-server owns the compiled query plan.</p>
                    <pre class="console-code studio-query-sql" data-query-readout="true">@readout</pre>
                </article>

                @if (query.Preview is { } preview)
                {
                    <article class="console-panel studio-query-preview" data-query-preview="true" aria-labelledby="query-preview-heading">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Preview · @preview.FeatureCount@(preview.TotalCount is { } t ? $" of {t:N0} matching" : " matching")</p>
                                <h3 id="query-preview-heading">Map / table preview</h3>
                            </div>
                            @if (query.Parameters.Count > 0)
                            {
                                <span class="console-muted studio-query-preview-params" data-query-preview-params="true">@ParameterReadout(query)</span>
                            }
                        </div>
                        <dl class="console-definition-list">
                            <dt>Layer</dt>
                            <dd>@preview.LayerId</dd>
                            <dt>Features</dt>
                            <dd>@preview.FeatureCount.ToString("N0")@(preview.TotalCount is { } total ? $" of {total:N0}" : string.Empty)@(preview.ExceededPreviewLimit ? " (preview limit exceeded)" : string.Empty)</dd>
                            <dt>Geometry</dt>
                            <dd>@(preview.HasGeometry ? "yes" : "no")</dd>
                        </dl>

                        @if (preview.FeatureCount == 0)
                        {
                            <p class="console-muted">The query returned no features for the current predicates.</p>
                        }
                        else
                        {
                            <div class="console-table-wrap">
                                <table class="console-table" data-query-preview-table="true">
                                    <thead>
                                        <tr>
                                            <th>id</th>
                                            @foreach (var column in preview.Columns)
                                            {
                                                <th>@column</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var feature in preview.Features)
                                        {
                                            <tr @key="feature.Id">
                                                <td>@feature.Id</td>
                                                @foreach (var column in preview.Columns)
                                                {
                                                    <td>@(feature.Attributes.GetValueOrDefault(column, string.Empty))</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <p class="console-kicker">Reuse this query as</p>
                        <ul class="studio-compact-list" data-query-downstream="true">
                            @foreach (var target in preview.DownstreamTargets)
                            {
                                <li>@DownstreamLabel(target)</li>
                            }
                        </ul>

                        <p class="console-muted studio-query-explain" data-query-explain="true">
                            EXPLAIN · preview artifact <code>@preview.PreviewArtifactId</code> · layer @preview.LayerId@(preview.ExceededPreviewLimit ? " · preview limit reached" : string.Empty)
                        </p>
                    </article>
                }
                else
                {
                    <article class="console-panel studio-query-preview studio-query-preview-empty" data-query-preview-empty="true">
                        <p class="console-kicker">Preview</p>
                        <h3>Map / table preview</h3>
                        <p class="console-muted">@(query.IsExistingQuery ? "Run preview to pull the live map/table result and EXPLAIN readout from honua-server." : "Save this draft, then run preview to pull the live map/table result from honua-server.")</p>
                    </article>
                }
                </div>
                </div>
            </div>
        }
    }
</section>

@code {
    private bool _loading = true;
    private bool _busy;
    private StudioQueryWorkspace _workspace = new([], []);
    private StudioQueryCapabilityState? _bindingState;
    private IReadOnlyList<StudioQueryCapabilityState> _states = [];
    private StudioQueryEditor? _query;
    private string? _status;
    private bool _statusFailed;

    private int? _outputSridInput
    {
        get => _query?.OutputSrid;
        set
        {
            if (_query is not null)
            {
                _query.OutputSrid = value;
            }
        }
    }

    protected override Task OnInitializedAsync() => LoadWorkspaceAsync();

    private async Task LoadWorkspaceAsync()
    {
        _loading = true;
        _workspace = await QueryData.GetWorkspaceAsync();
        ApplyStates(_workspace.CapabilityStates);
        _loading = false;
    }

    private Task NewQuery() => RunLoadAsync(() => QueryData.LoadAsync(null));

    private Task OpenQuery(string queryId) => RunLoadAsync(() => QueryData.LoadAsync(queryId));

    private async Task RunLoadAsync(Func<Task<StudioQueryEditorLoad>> load)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _status = null;
        _statusFailed = false;
        try
        {
            var result = await load();
            ApplyStates(result.CapabilityStates);
            _query = result.Query;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackToList()
    {
        _query = null;
        _status = null;
        _statusFailed = false;
        await LoadWorkspaceAsync();
    }

    private void AddPredicate() => _query?.Predicates.Add(new StudioQueryPredicateEditor());

    private void RemovePredicate(StudioQueryPredicateEditor predicate) => _query?.Predicates.Remove(predicate);

    private void SetPredicateKind(StudioQueryPredicateEditor predicate, ChangeEventArgs args)
    {
        predicate.Kind = args.Value?.ToString() ?? StudioQueryPredicateKinds.Comparison;
        predicate.Operator = predicate.Kind switch
        {
            StudioQueryPredicateKinds.Spatial => StudioQuerySpatialOperators.All[0],
            StudioQueryPredicateKinds.Temporal => StudioQueryTemporalOperators.All[0],
            _ => StudioQueryComparisonOperators.All[0]
        };
    }

    private void AddParameter() => _query?.Parameters.Add(new StudioQueryParameterEditor());

    private void RemoveParameter(StudioQueryParameterEditor parameter) => _query?.Parameters.Remove(parameter);

    private void AddOutField() => _query?.OutFields.Add(string.Empty);

    private void SetOutField(int index, ChangeEventArgs args)
    {
        if (_query is not null && index >= 0 && index < _query.OutFields.Count)
        {
            _query.OutFields[index] = args.Value?.ToString() ?? string.Empty;
        }
    }

    private void RemoveOutField(int index)
    {
        if (_query is not null && index >= 0 && index < _query.OutFields.Count)
        {
            _query.OutFields.RemoveAt(index);
        }
    }

    private Task Save() => RunCommandAsync(() => QueryData.SaveAsync(_query!));

    private Task Preview() => RunCommandAsync(() => QueryData.PreviewAsync(_query!));

    private async Task RunCommandAsync(Func<Task<StudioQueryCommandResult>> command)
    {
        if (_busy || _query is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await command();
            _status = result.Message;
            _statusFailed = !result.Succeeded;

            if (result.Query is not null)
            {
                _query = result.Query;
            }

            ApplyStates(result.Issue is null ? [] : [result.Issue]);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string QuerySummary(StudioQueryEditor query)
    {
        var sourceCount = string.IsNullOrWhiteSpace(query.ServiceName) ? 0 : 1;
        var fieldCount = query.OutFields.Count(field => !string.IsNullOrWhiteSpace(field));
        var fields = fieldCount == 0 ? "all fields" : $"{fieldCount} field{(fieldCount == 1 ? string.Empty : "s")}";
        return $"{sourceCount} source · {query.Predicates.Count} predicate{(query.Predicates.Count == 1 ? string.Empty : "s")} · {query.Parameters.Count} param{(query.Parameters.Count == 1 ? string.Empty : "s")} · {fields}";
    }

    private static string ParameterReadout(StudioQueryEditor query) =>
        string.Join(" · ", query.Parameters
            .Where(parameter => !string.IsNullOrWhiteSpace(parameter.Name))
            .Select(parameter => $"${parameter.Name}={(string.IsNullOrWhiteSpace(parameter.Value) ? "—" : parameter.Value)}"));

    private static string DownstreamLabel(string target) => target switch
    {
        "map" => "Map layer",
        "dashboard" => "Dashboard input",
        "report" => "Report input",
        "app" => "App input",
        "workflow" => "Workflow input",
        _ => target
    };

    private void ApplyStates(IReadOnlyList<StudioQueryCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
        _states = states
            .Where(state => !ReferenceEquals(state, _bindingState))
            .ToArray();
    }
}
