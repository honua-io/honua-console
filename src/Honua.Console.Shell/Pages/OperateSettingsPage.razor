@page "/operate/settings"
@inject IOperateTransitionDataSource OperateData

<section class="console-page">
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Settings</p>
        <h1>Server Runtime &amp; Policy</h1>
        <p>A read-only summary of the connected honua-server's effective runtime configuration and policy: admin API and metadata-schema compatibility, license edition and entitlements, and identity (admin API keys, OIDC providers). Each row shows the current value and the admin endpoint it was read from. Server-level settings are changed through honua-server's own configuration; per-service runtime settings (protocols, access tier) live on each service's Settings tab.</p>
    </div>

    <OperateCapabilityStateList States="@_states" />

    @if (_settingsChanges.Count == 0 && _states.Count == 0)
    {
        <EmptyState Area="operate" Subject="runtime settings" />
    }
    else if (_settingsChanges.Count > 0)
    {
        <div class="console-table-wrap">
            <table class="console-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Setting</th>
                        <th>Current value</th>
                        <th>Scope</th>
                        <th>Read from</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var setting in _settingsChanges)
                    {
                        <tr>
                            <td>@setting.Category</td>
                            <td>@setting.Name</td>
                            <td>@setting.ProposedChange</td>
                            <td>@setting.ApplyScope</td>
                            <td><span class="console-mono">@setting.PolicyState</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private IReadOnlyList<OperateSettingsChange> _settingsChanges = Array.Empty<OperateSettingsChange>();
    private IReadOnlyList<OperateCapabilityState> _states = Array.Empty<OperateCapabilityState>();

    protected override async Task OnInitializedAsync()
    {
        var view = await OperateData.GetSettingsViewAsync();
        _settingsChanges = view.SettingsChanges;
        _states = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Settings");
    }
}
