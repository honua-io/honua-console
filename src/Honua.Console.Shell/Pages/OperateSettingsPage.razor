@page "/operate/settings"
@implements IDisposable
@inject IOperateTransitionDataSource OperateData
@inject IServiceProvider Services
@inject NavigationManager Navigation

<section class="console-page">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Settings">
            <p>Runtime configuration and policy from the connected honua-server.</p>
            <p><a href="@Navigation.ToConsoleHref("/operate/settings/api-keys")">Manage API keys</a></p>
        </ConsolePageHeading>
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Operate / Settings</p>
            <h1>Settings</h1>
            <p>A read-only summary of the connected honua-server's effective runtime configuration and policy: admin API and metadata-schema compatibility, license edition and entitlements, and identity (admin API keys, OIDC providers). Each row shows the current value and the admin endpoint it was read from. Server-level settings are changed through honua-server's own configuration; per-service runtime settings (protocols, access tier) live on each service's Settings tab.</p>
        </div>
    }
    <OperateCapabilityStateList States="@_states" />

    <ConsoleConnectionNotice Heading="Could not read settings" Error="@_loadError" Busy="@_loading" OnRetry="LoadAsync" />
    @if (_loading)
    {
        <p role="status">Reading settings…</p>
    }
    else if (_loadError is null && _settingsChanges.Count == 0 && _states.Count == 0)
    {
        <EmptyState Area="operate" Subject="runtime settings" />
    }
    else if (_settingsChanges.Count > 0)
    {
        @if (V4Enabled)
        {
            <ConsolePanel Title="Server configuration" HeadingId="server-configuration-heading">
                <p>Read-only. Each setting shows its current value and source endpoint.</p>
                @SettingsTable
                <p>Change server-level settings in honua-server configuration. Change protocols and access on each service's Settings tab.</p>
            </ConsolePanel>
        }
        else
        {
            @SettingsTable
        }
    }
</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
    private RenderFragment SettingsTable => @<text>
        <ConsoleTableRegion Class="console-table-wrap" Label="Server settings">
            <table class="console-table">
                <thead>
                    <tr>
                        <th scope="col">Category</th>
                        <th scope="col">Setting</th>
                        <th scope="col">Current value</th>
                        <th scope="col">Scope</th>
                        <th scope="col">Read from</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var setting in _settingsChanges)
                    {
                        <tr>
                            <td>@setting.Category</td>
                            <td>@setting.Name</td>
                            <td>@setting.ProposedChange</td>
                            <td>@setting.ApplyScope</td>
                            <td><span class="console-mono">@setting.PolicyState</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </ConsoleTableRegion>
    </text>;
    private IReadOnlyList<OperateSettingsChange> _settingsChanges = Array.Empty<OperateSettingsChange>();
    private IReadOnlyList<OperateCapabilityState> _states = Array.Empty<OperateCapabilityState>();

    private readonly CancellationTokenSource _lifetime = new();
    private bool _disposed;
    private bool _loading;
    private string? _loadError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_loading || _disposed) return;
        _loading = true;
        try
        {
            var view = await OperateData.GetSettingsViewAsync(_lifetime.Token);
            if (_disposed) return;
            _settingsChanges = view.SettingsChanges;
            _states = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Settings");
            _loadError = null;
            if (_settingsChanges.Count == 0 && _states.Count > 0 && _states.All(IsReadFailure))
            {
                _states = Array.Empty<OperateCapabilityState>();
                _loadError = ReadFailedMessage;
            }
        }
        catch (Exception) when (_disposed) { }
        catch (Exception)
        {
            _loadError = ReadFailedMessage;
        }
        finally
        {
            if (!_disposed) _loading = false;
        }
    }

    private const string ReadFailedMessage = "The settings request did not complete. Retry to read the current configuration.";

    // A transport failure carries no HTTP status; a malformed success body is "Unsupported" with a 2xx
    // status. Both mean the read did not complete, so show the retry notice instead of raw client text.
    private static bool IsReadFailure(OperateCapabilityState state) =>
        (string.Equals(state.State, "Unavailable", StringComparison.OrdinalIgnoreCase) && state.StatusCode is null)
        || (string.Equals(state.State, "Unsupported", StringComparison.OrdinalIgnoreCase) && state.StatusCode is >= 200 and < 300);

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
