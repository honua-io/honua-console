@page "/operate/services"
@inject IOperateTransitionDataSource OperateData
@inject IServiceProvider Services

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Services">
            <p>Browse services and open their protocol and access settings.</p>
        </ConsolePageHeading>
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Operate / Services</p>
            <h1>Services</h1>
            <p>Browse services and open their protocol and access settings.</p>
        </div>
    }

    @if (V4Enabled)
    {
        <ConsolePanel Title="Services" HeadingId="services-list-heading">
            @ServiceList
        </ConsolePanel>
    }
    else
    {
        @ServiceList
    }
    <Honua.Console.Shell.Components.Operate.FolderManagement OnSaved="LoadAsync" UnsavedChanged="@(summary => _folderUnsaved = summary)" SelectionChanged="@(entity => _selectedFolder = entity)" />
</section>

@code {
    private ConsoleAgentUnsavedSummary _folderUnsaved = new();
    private ConsoleAgentEntity? _selectedFolder;
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = "/operate/services",
        Entities = _selectedFolder is { } entity ? [entity] : [],
        Selection = _selectedFolder is { } selected ? [selected] : [],
        Unsaved = _folderUnsaved
    };

    private static ConsoleAgentEntity ServiceEntity(OperateServiceDetail service) => new()
    {
        Kind = ConsoleAgentEntityKind.Service,
        Id = service.Name,
        ServiceName = service.Name
    };

    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    private RenderFragment ServiceList => @<text>

    @if (_loading)
    {
        <p role="status">Reading services…</p>
    }
    <ConsoleConnectionNotice Heading="Could not read services" States="_states" Error="@_loadError" OnRetry="LoadAsync" Busy="_loading" />

    @if (_services.Count > 0)
    {
        <ConsoleTableRegion Class="console-table-wrap" Label="@(V4Enabled ? "Service inventory" : "Services")">
            <table class="console-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Protocols</th>
                        <th>Layers</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var service in _services)
                    {
                        <tr>
                            <td>
                                @if (V4Enabled)
                                {
                                    <ConsoleNameIdentifier Name="@service.DisplayName" Identifier="@service.Name"
                                                           Href="@ConsoleAgentRoutes.ForEntity(ServiceEntity(service))" />
                                }
                                else
                                {
                                    <a href="@($"/operate/services/{Uri.EscapeDataString(service.Name)}/settings")">@service.DisplayName</a>
                                }
                            </td>
                            <td>
                                @if (V4Enabled)
                                {
                                    <ConsoleProtocolList Protocols="@service.Protocols" />
                                }
                                else
                                {
                                    @service.ServiceType
                                }
                            </td>
                            <td>@if (_states.Count > 0) { <span>Unknown</span> } else { @service.Layers.Count }</td>
                            <td>@service.RuntimeStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        </ConsoleTableRegion>
    }
    else if (!_loading && _states.Count == 0 && _loadError is null)
    {
        <EmptyState Area="operate" Subject="services" />
    }
    </text>;

    private IReadOnlyList<OperateServiceDetail> _services = [];
    private IReadOnlyList<OperateCapabilityState> _states = [];
    private string? _loadError;
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _services = [];
        _states = [];
        try
        {
            var view = await OperateData.GetServicesViewAsync();
            _services = view.Services;
            _states = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Services", "Layers", "Connections");
        }
        catch (Exception)
        {
            _loadError = "The services request did not complete. Check the environment and try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
