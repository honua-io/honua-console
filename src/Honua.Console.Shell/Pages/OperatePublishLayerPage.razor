@page "/operate/publishing/quick"
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@using Honua.Console.Shell.Components.Operate
@using Honua.Sdk.Admin.Models
@inject IOperateTransitionDataSource OperateData
@inject IServiceLayerPublishOperation PublishOperation
@inject NavigationManager Nav
@inject IConsoleNotificationService Notifications
@inject IServiceProvider Services
@using Honua.Console.Contracts

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page" data-workspace-publish-form>
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Publish a layer"><ChildContent><p>@Intro</p></ChildContent></ConsolePageHeading>
    }
    else
    {
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Publishing</p>
        <h1>Publish a layer</h1>
        <p>@Intro</p>
    </div>
    }

    <ConsoleConnectionNotice Heading="Could not read data connections" States="_connectionStates" OnRetry="LoadConnectionsAsync" />
    @if (_connections.Count == 0 && _connectionStates.Count == 0)
    {
        <article class="console-panel console-state-warning" role="note">
            <p class="console-kicker">No connections</p>
            <h2>No data connections are available</h2>
            <p>Create and test a data connection first, then return here to publish a table from it.</p>
            <a class="console-button" href="@Nav.ToConsoleHref("/operate/connections/new")">Add Connection</a>
        </article>
    }
    else if (_connections.Count > 0)
    {
        @if (V4Enabled)
        {
            <ConsolePanel Title="Source and service" HeadingId="quick-publish-source">@PublishForm</ConsolePanel>
        }
        else
        {
            <article class="console-panel">@PublishForm</article>
        }
    }
</section>

@if (_unverifiedCommand is { } pendingPublish)
{
    <PublishOutcomeVerification @key="_publishAttempt" AuthorityBinding="@pendingPublish.AuthorityBinding" ServiceName="@pendingPublish.ServiceName" LayerName="@pendingPublish.LayerName" OnVerified="@(() => { _requiresCatalogRead = false; _result = null; })" />
}

@code {
    private const string Intro = "Publish an existing table from a data connection as a queryable Service Layer. Choose its Service identity and Folder separately; public paths use the Folder and public Service name.";
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
    private bool _loadingConnections = true;
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = "/operate/publishing/quick",
        Unsaved = new()
        {
            ChangedFieldCount = _result?.Succeeded == true ? 0 : new[] { _connectionId, _tableKey, _serviceName, _layerName, _geometryTypeOverride, _publicName }.Count(value => !string.IsNullOrWhiteSpace(value)) + (_folderId.IsSpecified ? 1 : 0),
            PendingOperationCount = (_loadingConnections ? 1 : 0) + (_loadingTables ? 1 : 0) + (_busy ? 1 : 0)
        }
    };
    private RenderFragment PublishForm => @<text>
            <div class="studio-field-grid @(V4Enabled ? "console-data-controls" : null)">
                <label>
                    <span>Connection</span>
                    <select class="console-input" aria-label="Connection" data-workspace-field="connectionId" @bind="_connectionId" @bind:after="OnConnectionChanged" disabled="@(!_interactive)">
                        <option value="">Select a connection…</option>
                        @foreach (var connection in _connections)
                        {
                            <option value="@connection.Id">@connection.Name (@connection.Provider)</option>
                        }
                    </select>
                </label>
                <label>
                    <span>Table</span>
                    <select class="console-input" aria-label="Table" data-workspace-field="table" @bind="_tableKey" @bind:after="OnTableChanged" disabled="@(_tables.Count == 0)">
                        <option value="">@(_loadingTables ? "Loading tables…" : _tables.Count == 0 ? "No publishable tables" : "Select a table…")</option>
                        @foreach (var table in _tables)
                        {
                            <option value="@table.QualifiedName" data-schema="@table.Schema" data-table="@table.Table">@table.QualifiedName @(table.GeometryType is { } gt ? $"· {gt}" : "")</option>
                        }
                    </select>
                </label>
                @if (_selectedTable is { } selected && RequiresGeometryChoice(selected))
                {
                    <label>
                        <span>Geometry type</span>
                        <select class="console-input" aria-label="Geometry type" data-publish-generic-geometry @bind="_geometryTypeOverride">
                            <option value="">Select geometry type…</option>
                            <option value="Point">Point</option>
                            <option value="MultiPoint">Multi-point</option>
                            <option value="LineString">Line</option>
                            <option value="MultiLineString">Multi-line</option>
                            <option value="Polygon">Polygon</option>
                            <option value="MultiPolygon">Multi-polygon</option>
                        </select>
                        <small>The column is generic. Choose the type used by the dataset; mixed types need separate layers.</small>
                    </label>
                }
                <label>
                    <span>Service name</span>
                    <input class="console-input" data-workspace-field="serviceName" @bind="_serviceName" @bind:event="oninput" @bind:after="ClearResult" placeholder="parcels-fs" />
                    <small class="console-muted">The logical Service identity stays the same when its Folder changes.</small>
                </label>
                <label>
                    <span>Layer name</span>
                    <input class="console-input" data-workspace-field="layerName" @bind="_layerName" @bind:event="oninput" @bind:after="ClearResult" placeholder="Parcels" />
                </label>
            </div>

            <FolderPublishSelection @bind-Value="_folderId" AuthorityBindingChanged="binding => _folderAuthority = binding" />
            <label class="console-field">
                <span>Public Service name (optional)</span>
                <input class="console-input" @bind="_publicName" data-service-public-name />
                <small>Immutable after assignment. Leave blank to use the Service identity.</small>
            </label>

            @if (_selectedTable is { } t)
            {
                <dl class="console-definition-list">
                    <dt>Geometry</dt>
                    <dd>@(t.GeometryType ?? "—") @(t.GeometryColumn is { } gc ? $"({gc})" : "")</dd>
                    <dt>SRID</dt>
                    <dd>@(t.Srid?.ToString() ?? "—")</dd>
                    <dt>Columns</dt>
                    <dd>@(t.Columns.Count > 0 ? string.Join(", ", t.Columns) : "—")</dd>
                    <dt>Rows (estimated)</dt>
                    <dd>@(t.EstimatedRows?.ToString() ?? "—")</dd>
                </dl>
            }

            @if (_clientError is not null)
            {
                <div class="console-validation-summary" data-publish-validation="blocking" role="alert">
                    <p class="console-kicker">Resolve before publishing</p>
                    <ul><li>@_clientError</li></ul>
                </div>
            }

            @if (_result is { } r)
            {
                <div class="console-panel @(r.Succeeded ? "console-state-success" : "console-state-danger")" role="@(r.Succeeded ? "status" : "alert")">
                    <p class="console-kicker">@r.State</p>
                    <OperateSectionHeading Text="@(r.Succeeded ? "Layer published" : r.State == ConsoleWriteOutcome.UnverifiedState ? "Publication outcome unverified" : "Layer not published")" />
                    <p>@r.Detail</p>
                    @if (r.Succeeded)
                    {
                        <dl class="console-definition-list">
                            <dt>Layer id</dt>
                            <dd data-published-layer-id>@r.LayerId</dd>
                            <dt>Service</dt>
                            <dd data-published-service>@r.ServiceName</dd>
                            <dt>Endpoints</dt>
                            <dd><a href="@Nav.ToConsoleLinkHref($"/operate/services/{Uri.EscapeDataString(r.ServiceName ?? _serviceName)}/settings")">Read current Service endpoints</a></dd>
                            <dt>Geometry / SRID</dt>
                            <dd>@r.GeometryType / @r.Srid</dd>
                        </dl>
                    }
                    @if (r.FieldErrors.Count > 0)
                    {
                        <ul>
                            @foreach (var error in r.FieldErrors)
                            {
                                <li>@(string.IsNullOrWhiteSpace(error.Path) ? error.Message : $"{error.Path}: {error.Message}")</li>
                            }
                        </ul>
                    }
                </div>
            }

            <section class="console-panel console-state-warning" data-workspace-publication-review hidden>
                <p role="status" data-workspace-publication-state></p>
                <button class="console-button console-button-secondary" type="button" data-workspace-publication-check>Check original publication</button>
                <button class="console-button console-button-secondary" type="button" data-workspace-publication-acknowledge hidden>I reviewed the previous result and current draft</button>
                <a href="@Nav.ToConsoleHref("/inbox")">Review approvals</a>
            </section>
            <div class="console-action-row">
                <button class="console-button console-button-secondary" type="button" disabled="@_busy" data-workspace-save>Save draft</button>
                <button class="console-button" type="button" disabled="@(_busy || _requiresCatalogRead)" data-workspace-publish @onclick="PublishAsync">
                    @(_busy ? "Publishing…" : "Publish layer")
                </button>
                <a href="@Nav.ToConsoleHref("/operate/services")">View services</a>
            </div>
    </text>;

    private IReadOnlyList<OperateConnectionSummary> _connections = Array.Empty<OperateConnectionSummary>();
    private IReadOnlyList<ServiceLayerPublishTable> _tables = Array.Empty<ServiceLayerPublishTable>();
    private ServiceLayerPublishTable? _selectedTable;

    private string _connectionId = string.Empty;
    private string _tableKey = string.Empty;
    private string _geometryTypeOverride = string.Empty;
    private string _serviceName = string.Empty;
    private string _layerName = string.Empty;
    private OptionalString _folderId;
    private string _publicName = "";
    private string? _folderAuthority;

    private bool _loadingTables;
    private bool _interactive;
    private bool _busy;
    private bool _requiresCatalogRead;
    private ServiceLayerPublishCommand? _unverifiedCommand;
    private int _publishAttempt;
    private string? _clientError;
    private ServiceLayerPublishResult? _result;

    private IReadOnlyList<OperateCapabilityState> _connectionStates = [];

    protected override Task OnInitializedAsync() => LoadConnectionsAsync();

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactive = true;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private async Task LoadConnectionsAsync()
    {
        _loadingConnections = true;
        try
        {
            var view = await OperateData.GetConnectionsViewAsync();
            _connections = view.Connections;
            _connectionStates = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Connections");
        }
        finally
        {
            _loadingConnections = false;
        }
    }

    private async Task OnConnectionChanged()
    {
        ClearResult();
        _tables = Array.Empty<ServiceLayerPublishTable>();
        _tableKey = string.Empty;
        _selectedTable = null;
        if (string.IsNullOrWhiteSpace(_connectionId))
        {
            return;
        }

        _loadingTables = true;
        try
        {
            _tables = await PublishOperation.ListTablesAsync(_connectionId);
        }
        finally
        {
            _loadingTables = false;
        }
    }

    private void OnTableChanged()
    {
        ClearResult();
        _geometryTypeOverride = string.Empty;
        _selectedTable = _tables.FirstOrDefault(table =>
            string.Equals(table.QualifiedName, _tableKey, StringComparison.Ordinal));
        if (_selectedTable is { } t && string.IsNullOrWhiteSpace(_layerName))
        {
            _layerName = t.Table;
        }
    }

    private void ClearResult()
    {
        _clientError = null;
        _result = null;
    }

    private async Task PublishAsync()
    {
        if (_requiresCatalogRead) return;
        _clientError = Validate();
        if (_clientError is not null) return;

        var target = await ConsolePublishAuthority.CaptureAsync(Services, _folderId, _folderAuthority);
        if (target.Error is { } error)
        {
            _clientError = error;
            return;
        }
        var table = _selectedTable!;
        var command = new ServiceLayerPublishCommand
        {
            ConnectionId = _connectionId,
            Schema = table.Schema,
            Table = table.Table,
            LayerName = _layerName.Trim(),
            ServiceName = _serviceName.Trim(),
            FolderId = _folderId,
            PublicName = string.IsNullOrWhiteSpace(_publicName) ? null : _publicName.Trim(),
            AuthorityBinding = target.Binding,
            GeometryColumn = table.GeometryColumn,
            GeometryType = RequiresGeometryChoice(table) ? _geometryTypeOverride : table.GeometryType,
            Srid = table.Srid,
            Fields = table.Columns,
            Enabled = true
        };

        _unverifiedCommand = null;
        _publishAttempt++;
        _result = null;
        await Notifications.RunGuardedAsync(
            async () =>
            {
                _result = await PublishOperation.PublishAsync(command);
                _requiresCatalogRead = _result.State == ConsoleWriteOutcome.UnverifiedState;
                _unverifiedCommand = _requiresCatalogRead ? command : null;
            },
            setBusy: busy => { _busy = busy; StateHasChanged(); },
            failureMessage: "Couldn't publish layer");
    }

    private string? Validate()
    {
        if (string.IsNullOrWhiteSpace(_connectionId)) return "Select a connection.";
        if (_selectedTable is null) return "Select a table.";
        if (RequiresGeometryChoice(_selectedTable) && string.IsNullOrWhiteSpace(_geometryTypeOverride))
            return "Select the geometry type used by this dataset.";
        if (string.IsNullOrWhiteSpace(_serviceName)) return "Enter a service name.";
        if (string.IsNullOrWhiteSpace(_layerName)) return "Enter a layer name.";
        return null;
    }

    private static bool RequiresGeometryChoice(ServiceLayerPublishTable table) =>
        !string.IsNullOrWhiteSpace(table.GeometryColumn) &&
        string.Equals(table.GeometryType, "GEOMETRY", StringComparison.OrdinalIgnoreCase);
}
