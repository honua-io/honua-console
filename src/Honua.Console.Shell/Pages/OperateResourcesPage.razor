@page "/operate/resources"
@inject IOperateTransitionDataSource OperateData

<section class="console-page">
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Resources</p>
        <h1>Data Resources</h1>
        <p>Resource edits are validated before publication and show the dependent services, layers, maps, share links, and generated apps affected by the change.</p>
    </div>

    <div class="console-toolbar">
        <a class="console-button-link" href="/operate/resources/new">Create Resource</a>
    </div>

    <OperateCapabilityStateList States="@_states" />

    @if (_resources.Count == 0 && _states.Count == 0)
    {
        <EmptyState Area="operate" Subject="resources" ActionHref="/operate/resources/new" ActionText="Create Resource" />
    }
    else
    {
        <div class="console-panel-grid">
            @foreach (var resource in _resources)
            {
                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">@resource.Source</p>
                            <h2><a href="@($"/operate/resources/{resource.ResourceId}")">@resource.Name</a></h2>
                        </div>
                        <span class="console-status console-status-warning">@resource.ValidationState</span>
                    </div>
                    <p class="console-muted">@resource.DraftChange</p>
                    <dl class="console-definition-list">
                        <dt>Services</dt>
                        <dd>@FormatCount(resource.BlastRadius.Services)</dd>
                        <dt>Layers</dt>
                        <dd>@FormatCount(resource.BlastRadius.Layers)</dd>
                        <dt>Saved maps</dt>
                        <dd>@FormatCount(resource.BlastRadius.SavedMaps)</dd>
                        <dt>Share links</dt>
                        <dd>@FormatCount(resource.BlastRadius.ShareLinks)</dd>
                    </dl>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<OperateResourceEditPreview> _resources = Array.Empty<OperateResourceEditPreview>();
    private IReadOnlyList<OperateCapabilityState> _states = Array.Empty<OperateCapabilityState>();

    protected override async Task OnInitializedAsync()
    {
        var view = await OperateData.GetResourcesViewAsync();
        _resources = view.ResourceEdits;
        _states = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Resources", "Layers");
    }

    private static string FormatCount(IReadOnlyCollection<string> items) =>
        $"{items.Count}: {string.Join(", ", items)}";
}
