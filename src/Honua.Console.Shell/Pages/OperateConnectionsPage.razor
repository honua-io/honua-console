@page "/operate/connections"
@inject IOperateTransitionDataSource OperateData
@inject IServiceProvider Services
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page">
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Data connections">
            <ChildContent><p>Connection tests report structured checks and safe evidence before datasets or services use the source.</p></ChildContent>
            <Actions>@ConnectionActions</Actions>
        </ConsolePageHeading>
    }
    else
    {
        <div class="console-page-heading">
            <p class="console-kicker">Operate / Connections</p>
            <h1>Data Connections</h1>
            <p>Connection tests report structured checks and safe evidence for operators before datasets or services use the source.</p>
        </div>
        @ConnectionActions
    }

    <ConsoleConnectionNotice Heading="Could not read data connections" States="_states" OnRetry="LoadAsync" />

    @if (_connections.Count == 0 && _states.Count == 0)
    {
        <EmptyState Area="operate" Subject="connections" ActionHref="/operate/connections/new" ActionText="Add Connection" />
    }
    else if (_connections.Count > 0)
    {
        @if (V4Enabled)
        {
            <ConsolePanel Title="Connections" HeadingId="connections-heading">@ConnectionTable</ConsolePanel>
        }
        else
        {
            @ConnectionTable
        }
    }
</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = "/operate/connections",
        Entities = _connections.Select(connection => ConsoleAgentEntity.ForConnection(connection.Id)).ToArray(),
        Unsaved = new() { PendingOperationCount = _loading ? 1 : 0 }
    };
    private RenderFragment ConnectionActions => @<text>
<div class="@(V4Enabled ? "console-panel-actions" : "console-toolbar")">
        <a class="console-button-link" href="operate/connections/new">Add Connection</a>
        <a class="console-button-link @(V4Enabled ? "console-button-secondary" : null)" href="operate/publishing/quick">Publish a layer</a>
        <a class="console-button-link @(V4Enabled ? "console-button-secondary" : null)" href="operate/resources/import">Import a file</a>
        <a class="console-button-link @(V4Enabled ? "console-button-secondary" : null)" href="operate/import/service">Import from a service</a>
    </div></text>;
    private RenderFragment ConnectionTable => @<text>
        <ConsoleTableRegion Class="console-table-wrap" Label="@(V4Enabled ? "Connection table" : "Connections")">
            <table class="console-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Provider</th>
                        <th>Target</th>
                        <th>Status</th>
                        <th>Last tested</th>
                        <th>Diagnostics</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var connection in _connections)
                    {
                        <tr>
                            <td>
                                <a href="@Navigation.ToConsoleHref(ConsoleAgentRoutes.ForEntity(ConsoleAgentEntity.ForConnection(connection.Id)))">@connection.Name</a>
                                <small>@connection.Principal</small>
                            </td>
                            <td>@connection.Provider</td>
                            <td>@connection.Target</td>
                            <td><span class="@StatusClass(connection.Status)">@connection.Status</span></td>
                            <td>@connection.LastTested</td>
                            <td>
                                @if (connection.LastDiagnostic is null)
                                {
                                    <span class="console-muted">No active diagnostic</span>
                                }
                                else
                                {
                                    <a href="@Navigation.ToConsoleHref(ConsoleAgentRoutes.ForEntity(ConsoleAgentEntity.ForConnection(connection.Id)) + "/diagnostics")">@connection.LastDiagnostic.FailureCode</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </ConsoleTableRegion></text>;

    private bool _loading = true;
    private IReadOnlyList<OperateConnectionSummary> _connections = Array.Empty<OperateConnectionSummary>();
    private IReadOnlyList<OperateCapabilityState> _states = Array.Empty<OperateCapabilityState>();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var view = await OperateData.GetConnectionsViewAsync();
            _connections = view.Connections;
            _states = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Connections");
        }
        finally
        {
            _loading = false;
        }
    }

    private static string StatusClass(string status) =>
        string.Equals(status, "Failed", StringComparison.OrdinalIgnoreCase)
            ? "console-status console-status-danger"
            : string.Equals(status, "Warning", StringComparison.OrdinalIgnoreCase)
                ? "console-status console-status-warning"
                : "console-status";
}
