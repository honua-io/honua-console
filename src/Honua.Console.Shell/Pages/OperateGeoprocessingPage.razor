@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager ConsoleNavigation
@page "/operate/geoprocessing"
@page "/operate/geoprocessing/{SelectedJobRunId}"
@using Honua.Console.Shell.Components
@implements IDisposable
@inject IConsoleOperateObservabilityClient OperateClient
@inject IServiceProvider Services

<section class="console-page console-operate-page @(V4Enabled ? "console-jobs-v4" : null)">
    @if (V4Enabled)
    {
        <ConsoleAgentContext Context="@AgentContext" />
        <link rel="stylesheet" href="_content/Honua.Console.Shell/css/operate-jobs-v4.css" />
        <ConsolePageHeading Title="Geoprocessing jobs">
            <p>Follow job progress, review evidence, and manage runs on the connected Honua server.</p>
            <p class="console-jobs-refresh">Jobs refresh every four seconds. An open job stops refreshing when it reaches a terminal state.</p>
        </ConsolePageHeading>
    }
    else
    {
        <div class="console-page-heading operate-heading">
            <p class="console-kicker">Operator workflow</p>
            <h1>Geoprocessing Jobs</h1>
            <p>
                Live durable geoprocessing jobs from the connected honua-server: state, current phase,
                progress, who requested each run, and per-job logs/artifacts. Bound to the admin jobs
                contract filtered to the <span class="console-mono">Geoprocessing</span> kind; the surface
                polls the server (no realtime stream is exposed) and stops once the open job is terminal.
            </p>
        </div>
    }

    @if (!HasSelectedJobRoute)
    {
        <section class="operate-section" aria-labelledby="gp-jobs-heading">
            <div class="operate-section-heading">
                <div>
                    @if (!V4Enabled)
                    {
                        <p class="console-kicker">Geoprocessing</p>
                    }
                    <h2 id="gp-jobs-heading">@(V4Enabled ? "Jobs" : "Job board")</h2>
                </div>
                <div class="operate-action-row" role="group" aria-label="Filter by state">
                    @foreach (var option in StateFilters)
                    {
                        var active = string.Equals(_stateFilter, option.Value, StringComparison.Ordinal);
                        <button type="button"
                            class="console-button @(active ? "" : "console-button-secondary")"
                            aria-pressed="@(active ? "true" : "false")"
                            @onclick="() => SetStateFilter(option.Value)">
                            @option.Label
                            @if (option.Value.Length > 0)
                            {
                                <span class="console-chip-row"><span>@CountForState(option.Value)</span></span>
                            }
                        </button>
                    }
                </div>
            </div>

            @if (!_listLoaded || _jobs is null)
            {
                <OperateSectionStatusPanel Heading="Geoprocessing jobs" Loading="true" />
            }
            else if (!_jobs.IsAllowed)
            {
                <OperateSectionStatusPanel Heading="Geoprocessing jobs" Status="_jobs.Status" Message="@_jobs.Message" Detail="@_jobs.Detail" />
            }
            else if (AllJobs.Count == 0)
            {
                <OperateSectionStatusPanel Heading="Geoprocessing jobs" Empty="true"
                    EmptyTitle="No geoprocessing jobs"
                    EmptyMessage="The connected server reported no Geoprocessing jobs." />
            }
            else if (FilteredJobs.Count == 0)
            {
                <OperateSectionStatusPanel Heading="Geoprocessing jobs" Empty="true"
                    EmptyTitle="No matching jobs"
                    EmptyMessage="No Geoprocessing jobs match the selected state filter." />
            }
            else
            {
                @if (_jobs.PartialResult && !string.IsNullOrWhiteSpace(_jobs.Message))
                {
                    <p class="console-usage-callout console-state-warning" role="status">@_jobs.Message</p>
                }

                @if (!string.IsNullOrWhiteSpace(_actionMessage))
                {
                    <p class="operate-deploy-action-message @_actionMessageClass" role="status">@_actionMessage</p>
                    @if (!string.IsNullOrWhiteSpace(_actionDetail))
                    {
                        <ConsoleDiagnostics Detail="@_actionDetail" />
                    }
                }

                <div class="console-panel operate-table-panel">
                    <ConsoleTableRegion Class="operate-table-scroll" Label="Geoprocessing jobs">
                        <table class="operate-table">
                            <thead>
                                <tr>
                                    <th scope="col">Job</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Phase</th>
                                    <th scope="col">Progress</th>
                                    <th scope="col">Requested by</th>
                                    <th scope="col">Created</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in FilteredJobs)
                                {
                                    <tr>
                                        <td><a href="@ConsoleNavigation.ToConsoleLinkHref(OperateObservabilityRoutes.GeoprocessingJobDetail(job.JobRunId))">@job.JobRunId</a></td>
                                        <td><span class="console-status @job.Status.CssClass">@job.Status.Label</span></td>
                                        <td>@(string.IsNullOrWhiteSpace(job.Status.Description) ? "—" : job.Status.Description)</td>
                                        <td>
                                            <div class="operate-progress" role="progressbar" aria-label="@($"{job.JobRunId} progress")"
                                                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@job.ProgressPercent">
                                                <span style="@($"width: {job.ProgressPercent}%")"></span>
                                            </div>
                                        </td>
                                        <td>@job.SubmittedBy</td>
                                        <td>@job.SubmittedAt</td>
                                        <td>
                                            <div class="operate-action-row">
                                                @if (job.CanCancel)
                                                {
                                                    <button type="button"
                                                        class="console-button console-button-secondary"
                                                        disabled="@_actionBusy"
                                                        @onclick="() => ConfirmCancelJob(job.JobRunId)">
                                                        Cancel
                                                    </button>
                                                }
                                                @if (job.CanRetry)
                                                {
                                                    <button type="button"
                                                        class="console-button console-button-secondary"
                                                        disabled="@_actionBusy"
                                                        @onclick="() => RetryJobAsync(job.JobRunId)">
                                                        Retry
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </ConsoleTableRegion>
                </div>
            }
        </section>
    }
    else
    {
        <div class="operate-release-detail-head">
            <p class="console-kicker">
                <a class="console-link" href="@ConsoleNavigation.ToConsoleLinkHref(OperateObservabilityRoutes.Geoprocessing)">Geoprocessing jobs</a>
                <span class="operate-crumb-sep">/</span>
            </p>
            <div class="operate-release-title-row">
                <h2>Job @SelectedJobRunId?.Trim()</h2>
                <a class="console-link" href="@ConsoleNavigation.ToConsoleLinkHref(OperateObservabilityRoutes.Geoprocessing)">Back to jobs</a>
            </div>
        </div>

        @if (!_detailLoaded || _detail is null)
        {
            <OperateSectionStatusPanel Heading="Job detail" Loading="true" />
        }
        else if (!_detail.IsAllowed || _detail.Value is null)
        {
            <OperateSectionStatusPanel Heading="Job detail" Status="_detail.Status" Message="@_detail.Message" Detail="@_detail.Detail" />
        }
        else
        {
            var job = _detail.Value;
            @if (!_diagnosticsLoaded || _diagnostics is null)
            {
                <OperateSectionStatusPanel Heading="Timeline" Loading="true" />
            }
            else if (!_diagnostics.IsAllowed || _diagnostics.Value is null)
            {
                <OperateSectionStatusPanel Heading="Timeline" Status="_diagnostics.Status" Message="@_diagnostics.Message" Detail="@_diagnostics.Detail" />
            }
            else
            {
                <JobDiagnosticsTimeline View="_diagnostics.Value"
                    CancelAllowed="job.CanCancel"
                    Busy="_actionBusy"
                    ReadingEarlier="_diagnosticsReadingEarlier"
                    OnCancel="() => ConfirmCancelJob(job.JobRunId)"
                    OnRetry="() => RetryJobAsync(job.JobRunId)"
                    OnReadEarlier="ReadEarlierDiagnosticsAsync"
                    OnReadNext="ReadNextDiagnosticsAsync" />
            }
            @if (!string.IsNullOrWhiteSpace(_actionMessage))
            {
                <section class="operate-section" aria-label="Job controls">
                    <p class="operate-deploy-action-message @_actionMessageClass" role="status">@_actionMessage</p>
                    @if (!string.IsNullOrWhiteSpace(_actionDetail))
                    {
                        <ConsoleDiagnostics Detail="@_actionDetail" />
                    }
                    <p class="console-state-danger">
                        Governed action &middot; routed through the server's Execute + destructive-approval gate;
                        the console never bypasses it.
                    </p>
                </section>
            }

            <div class="operate-detail-grid">
                <JobDetailPanel Job="job" />
            </div>

            @if (!_stepsLoaded || _steps is null)
            {
                <OperateSectionStatusPanel Heading="Steps" Loading="true" />
            }
            else if (!_steps.IsAllowed || _steps.Value is null)
            {
                <OperateSectionStatusPanel Heading="Steps" Status="_steps.Status" Message="@_steps.Message" Detail="@_steps.Detail" />
            }
            else
            {
                <JobStepsPanel View="_steps.Value" />
            }
        }
    }
<ConsoleConfirmDialog @ref="_confirm" />
</section>

@code {
    private ConsoleAgentPageContext AgentContext
    {
        get
        {
            IReadOnlyList<ConsoleAgentEntity> selection = string.IsNullOrWhiteSpace(SelectedJobRunId)
                ? [] : [new() { Kind = ConsoleAgentEntityKind.Job, Id = SelectedJobRunId.Trim() }];
            return new()
            {
                Route = new Uri(ConsoleNavigation.Uri).AbsolutePath,
                Entities = selection,
                Selection = selection,
                Filters = new Dictionary<string, string> { ["state"] = _stateFilter },
                Unsaved = new() { PendingOperationCount = _actionBusy ? 1 : 0 }
            };
        }
    }

    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;

    // Poll cadence for the live list/detail. No realtime stream is exposed by the
    // server (admin job reads are no-store poll-only), so the surface re-reads on a
    // short interval and stops once the open job is terminal.
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(4);

    private static readonly (string Value, string Label)[] StateFilters =
    [
        ("", "All"),
        (OperateJobStatuses.Running, "Running"),
        (OperateJobStatuses.Queued, "Queued"),
        (OperateJobStatuses.Succeeded, "Succeeded"),
        (OperateJobStatuses.Failed, "Failed"),
        (OperateJobStatuses.Cancelled, "Cancelled"),
    ];

    [Parameter]
    public string? SelectedJobRunId { get; set; }

    // Tests shorten the live poll. The operate surface keeps the four-second cadence.
    [Parameter]
    public int PollIntervalMilliseconds { get; set; }

    private bool _listLoaded;
    private bool _detailLoaded;
    private bool _stepsLoaded;
    private bool _diagnosticsLoaded;
    private bool _diagnosticsReadingEarlier;
    private OperateSectionResult<IReadOnlyList<OperateJobRun>>? _jobs;
    private OperateSectionResult<OperateJobRun>? _detail;
    private OperateSectionResult<OperateJobStepsView>? _steps;
    private OperateSectionResult<OperateJobDiagnosticsView>? _diagnostics;
    private string? _loadedDetailFor;
    private long _viewRequest;
    private string _stateFilter = string.Empty;

    // Tracks whether the current render is the list or detail surface so a return
    // to the board triggers an immediate reload (the poll loop alone leaves the
    // pre-navigation list visible for up to one interval).
    private bool _wasDetailRoute;

    // Live cancel/retry action state. The server gate is the authority; the page
    // only invokes the action and surfaces the result (incl. "approval required").
    private bool _actionBusy;
    private string? _actionMessage;
    private string? _actionDetail;
    private string _actionMessageClass = string.Empty;
    private ConsoleConfirmDialog? _confirm;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _pollCts;

    private bool HasSelectedJobRoute => !string.IsNullOrWhiteSpace(SelectedJobRunId);

    private IReadOnlyList<OperateJobRun> AllJobs => _jobs?.Value ?? [];

    private IReadOnlyList<OperateJobRun> FilteredJobs =>
        string.IsNullOrEmpty(_stateFilter)
            ? AllJobs
            : AllJobs.Where(job => StatusMatches(job, _stateFilter)).ToArray();

    private int CountForState(string state) => AllJobs.Count(job => StatusMatches(job, state));

    private static bool StatusMatches(OperateJobRun job, string state) =>
        string.Equals(job.Status.State, state, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        var jobId = HasSelectedJobRoute ? SelectedJobRunId!.Trim() : null;
        if (jobId is not null)
        {
            if (!string.Equals(_loadedDetailFor, jobId, StringComparison.Ordinal) || _detail is null)
            {
                var request = BeginView(jobId);
                _wasDetailRoute = true;
                if (!await LoadDetailAsync(jobId, request)) return;
            }
        }
        else if (!_listLoaded || _wasDetailRoute)
        {
            var request = BeginView(null);
            _wasDetailRoute = false;
            var jobs = await OperateClient.GetGeoprocessingJobsAsync();
            if (request != _viewRequest) return;
            _jobs = jobs;
            _listLoaded = true;
        }

        StartPolling();
    }

    private long BeginView(string? jobId)
    {
        StopPolling();
        _loadedDetailFor = jobId;
        _detail = null;
        _steps = null;
        _diagnostics = null;
        _detailLoaded = false;
        _stepsLoaded = false;
        _diagnosticsLoaded = false;
        _diagnosticsReadingEarlier = false;
        _actionMessage = null;
        _actionDetail = null;
        return ++_viewRequest;
    }

    private async Task<bool> LoadDetailAsync(string jobId, long request)
    {
        var detail = await OperateClient.GetJobDetailAsync(jobId);
        if (request != _viewRequest) return false;
        _detail = detail;
        _detailLoaded = true;

        var steps = await OperateClient.GetJobStepsAsync(jobId);
        if (request != _viewRequest) return false;
        _steps = steps;
        _stepsLoaded = true;

        var diagnostics = await OperateClient.GetJobDiagnosticsAsync(jobId);
        if (request != _viewRequest) return false;
        ApplyDiagnostics(diagnostics);
        return true;
    }

    private void ConfirmCancelJob(string jobRunId)
    {
        if (_confirm is null) return;
        _confirm.Open(
            title: "Cancel this job?",
            onConfirm: () => CancelJobAsync(jobRunId),
            body: "This will abort the running job. Work completed so far may be partially applied. This cannot be undone.",
            confirmLabel: "Cancel job");
    }

    private Task CancelJobAsync(string jobRunId) =>
        RunJobActionAsync(jobRunId, OperateClient.CancelJobAsync, "Cancel requested.");

    private Task RetryJobAsync(string jobRunId) =>
        RunJobActionAsync(jobRunId, OperateClient.RetryJobAsync, "Retry requested.");

    private async Task RunJobActionAsync(
        string jobRunId,
        Func<string, CancellationToken, Task<OperateSectionResult<OperateJobControlOutcome>>> action,
        string successFallback)
    {
        if (_actionBusy)
        {
            return;
        }

        var request = _viewRequest;
        _actionBusy = true;
        _actionMessage = null;
        _actionDetail = null;
        StateHasChanged();
        try
        {
            var result = await action(jobRunId, CancellationToken.None);
            if (request != _viewRequest) return;
            if (result.IsAllowed && result.Value is not null)
            {
                _actionMessage = string.IsNullOrWhiteSpace(result.Value.Message)
                    ? successFallback
                    : result.Value.Message;
                _actionMessageClass = "console-state-success";

                // Reflect the transition: refresh the open detail and its diagnostics
                // together. A terminal detail stops polling, so the timeline cannot
                // wait for a later tick to drop Cancel or offer Retry.
                if (HasSelectedJobRoute && string.Equals(_loadedDetailFor, jobRunId.Trim(), StringComparison.Ordinal))
                {
                    var detail = await OperateClient.GetJobDetailAsync(jobRunId);
                    if (request != _viewRequest) return;
                    var diagnostics = await OperateClient.GetJobDiagnosticsAsync(jobRunId);
                    if (request != _viewRequest) return;
                    _detail = detail;
                    ApplyDiagnostics(diagnostics);
                }
                else
                {
                    var jobs = await OperateClient.GetGeoprocessingJobsAsync();
                    if (request != _viewRequest) return;
                    _jobs = jobs;
                }

                StartPolling();
            }
            else
            {
                _actionMessage = string.IsNullOrWhiteSpace(result.Message)
                    ? OperateSectionPresentation.FallbackMessage(result.Status)
                    : result.Message;
                _actionMessageClass = "console-state-danger";
                _actionDetail = result.Detail;
            }
        }
        finally
        {
            _actionBusy = false;
            // Explicitly re-render the page: RunJobActionAsync may be invoked from the
            // ConsoleConfirmDialog's confirm callback (a child component), so Blazor's implicit
            // post-event re-render of the parent page doesn't fire automatically.
            StateHasChanged();
        }
    }

    private Task ReadEarlierDiagnosticsAsync(string cursor)
    {
        if (_diagnostics?.Value is not null) _diagnosticsReadingEarlier = true;
        return ReadDiagnosticsPageAsync(cursor);
    }

    private Task ReadNextDiagnosticsAsync(string cursor) => ReadDiagnosticsPageAsync(cursor);

    private async Task ReadDiagnosticsPageAsync(string cursor)
    {
        var jobId = _loadedDetailFor;
        if (string.IsNullOrWhiteSpace(jobId) || _diagnostics?.Value is null) return;

        var request = _viewRequest;
        var page = await OperateClient.GetJobDiagnosticsAsync(jobId, cursor);
        if (request != _viewRequest) return;
        if (page.IsAllowed && page.Value is not null && _diagnostics?.Value is { } current)
        {
            _diagnostics = OperateSectionResult<OperateJobDiagnosticsView>.Allowed(current.AppendEvents(page.Value));
        }
        else
        {
            _diagnostics = page;
        }
    }

    private void ApplyDiagnostics(OperateSectionResult<OperateJobDiagnosticsView> incoming)
    {
        if (_diagnosticsReadingEarlier
            && _diagnostics is { IsAllowed: true, Value: { } held }
            && incoming is { IsAllowed: true, Value: { } fresh })
        {
            _diagnostics = OperateSectionResult<OperateJobDiagnosticsView>.Allowed(fresh.HoldingEventsFrom(held));
        }
        else
        {
            _diagnostics = incoming;
        }

        _diagnosticsLoaded = true;
    }

    private void SetStateFilter(string state) => _stateFilter = state;

    private void StartPolling()
    {
        StopPolling();

        // Detail mode: stop once the open job is terminal (nothing further changes).
        if (HasSelectedJobRoute && _detail is { IsAllowed: true, Value: { } job } && OperateJobStatuses.IsTerminal(job.Status.State))
        {
            return;
        }

        _pollCts = new CancellationTokenSource();
        var interval = PollIntervalMilliseconds > 0
            ? TimeSpan.FromMilliseconds(PollIntervalMilliseconds)
            : PollInterval;
        _timer = new PeriodicTimer(interval);
        _ = PollLoopAsync(_timer, _pollCts.Token);
    }

    private async Task PollLoopAsync(PeriodicTimer timer, CancellationToken cancellationToken)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var request = _viewRequest;
                var jobId = _loadedDetailFor;
                if (HasSelectedJobRoute)
                {
                    if (string.IsNullOrWhiteSpace(jobId))
                    {
                        break;
                    }

                    var detail = await OperateClient.GetJobDetailAsync(jobId, cancellationToken);
                    if (request != _viewRequest || cancellationToken.IsCancellationRequested) return;
                    // Refresh the per-step glass-box alongside the detail so a running
                    // job's newly emitted steps appear on the same poll cadence.
                    var steps = await OperateClient.GetJobStepsAsync(jobId, cancellationToken);
                    if (request != _viewRequest || cancellationToken.IsCancellationRequested) return;
                    var diagnostics = await OperateClient.GetJobDiagnosticsAsync(jobId, cancellationToken: cancellationToken);
                    await InvokeAsync(() =>
                    {
                        if (request != _viewRequest || cancellationToken.IsCancellationRequested) return;
                        _detail = detail;
                        _steps = steps;
                        _stepsLoaded = true;
                        ApplyDiagnostics(diagnostics);
                        StateHasChanged();
                    });

                    // Terminal jobs no longer change; stop polling.
                    if (detail is { IsAllowed: true, Value: { } job } && OperateJobStatuses.IsTerminal(job.Status.State))
                    {
                        break;
                    }
                }
                else
                {
                    var jobs = await OperateClient.GetGeoprocessingJobsAsync(cancellationToken);
                    await InvokeAsync(() =>
                    {
                        if (request != _viewRequest || cancellationToken.IsCancellationRequested) return;
                        _jobs = jobs;
                        StateHasChanged();
                    });
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed or navigated away; expected.
        }
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;
        _timer?.Dispose();
        _timer = null;
    }

    public void Dispose()
    {
        ++_viewRequest;
        StopPolling();
    }
}
