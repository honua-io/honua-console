@page "/operate/health"
@inject IOpsHealthDataSource HealthData
@inject IServiceProvider ServiceProvider
@implements IAsyncDisposable

@* OPS HEALTH (ADR-0060 WS4) — the GIS-aware at-a-glance operational view. One consolidated
   snapshot from honua-server (GET /api/v1/admin/observability/ops-health): overall status,
   per-protocol serving latency, geoprocessing queue depth, alert-dispatch backlog, coordinated-
   deploy readiness + platform-release skew, and database vitals. Bound to the connected server's
   admin observability API; a missing / unsupported / forbidden / unavailable read renders the
   shared status surface, never seeded data (Console Patterns Charter section 11). *@

<section class="console-page console-operate-page">
    <div class="console-page-heading operate-heading">
        <p class="console-kicker">Operator workflow</p>
        <h1>Ops Health</h1>
        <p>
            The consolidated operational-health snapshot at a glance: overall status, per-protocol
            serving latency, the geoprocessing queue, alert-dispatch backlog, coordinated-deploy
            readiness and platform-release skew, and database vitals. Bound to the connected
            honua-server admin observability API; renders an honest missing-binding state when
            unavailable.
        </p>
    </div>

    <div class="approval-inbox-toolbar" role="group" aria-label="Ops health controls">
        @if (_loaded && _view is not null)
        {
            <span class="console-status @_view.Overall.CssClass">Overall: @_view.Overall.Label</span>
            <span class="console-muted">Generated @_view.GeneratedAt</span>
        }
        <button type="button" class="console-button console-button-secondary"
                disabled="@_busy" data-refresh-health @onclick="RefreshAsync">
            Refresh
        </button>
    </div>

    @if (!_loaded)
    {
        <OperateSectionStatusPanel Heading="Ops health" Loading="true" />
    }
    else if (_view is null)
    {
        <OperateSectionStatusPanel Heading="Ops health" Status="_status" Message="@_message" />
    }
    else
    {
        <nav class="operate-section-nav" aria-label="Ops health sections">
            <a href="#serving-latency">Serving latency</a>
            <a href="#geoprocessing">Geoprocessing</a>
            <a href="#alert-dispatch">Alert dispatch</a>
            <a href="#deploy">Deploy readiness</a>
            <a href="#database">Database</a>
            <a href="#health-checks">Health checks</a>
            <a href="#trends">Trends</a>
        </nav>

        <section id="serving-latency" class="operate-section" aria-labelledby="serving-latency-heading">
            <div class="operate-section-heading">
                <div>
                    <p class="console-kicker">Serving latency · @_view.ServingLatency.WindowLabel</p>
                    <h2 id="serving-latency-heading">Per-Protocol Latency And Error Rate</h2>
                </div>
                @if (_view.ServingLatency.HasBreach)
                {
                    <span class="console-status console-state-warning">SLO breach on one or more protocols</span>
                    <a class="console-button-link" href="/operate/copilot" data-health-drilldown="serving-latency">
                        Investigate in Copilot Findings
                    </a>
                }
            </div>

            @if (_view.ServingLatency.Rows.Count == 0)
            {
                <p class="console-muted">No serving-latency samples in the current window.</p>
            }
            else
            {
                <div class="console-panel operate-table-panel">
                    <div class="operate-table-scroll">
                        <table class="operate-table">
                            <thead>
                                <tr>
                                    <th scope="col">Protocol</th>
                                    <th scope="col">Requests</th>
                                    <th scope="col">Errors</th>
                                    <th scope="col">Error rate</th>
                                    <th scope="col">p50</th>
                                    <th scope="col">p95</th>
                                    <th scope="col">p99</th>
                                    <th scope="col">Max</th>
                                    <th scope="col">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _view.ServingLatency.Rows)
                                {
                                    <tr>
                                        <td>@row.Protocol</td>
                                        <td>@row.RequestCount</td>
                                        <td>@row.ErrorCount</td>
                                        <td>@row.ErrorRateLabel</td>
                                        <td>@row.P50Label</td>
                                        <td>@row.P95Label</td>
                                        <td>@row.P99Label</td>
                                        <td>@row.MaxLabel</td>
                                        <td><span class="console-status @row.Status.CssClass">@row.Status.Label</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>

        <section id="geoprocessing" class="operate-section" aria-labelledby="geoprocessing-heading">
            <div class="operate-section-heading">
                <div>
                    <p class="console-kicker">Geoprocessing queue</p>
                    <h2 id="geoprocessing-heading">Active Jobs By Status And Backend</h2>
                </div>
                <span class="console-status @_view.Geoprocessing.Status.CssClass">@_view.Geoprocessing.Status.Label</span>
                @if (_view.Geoprocessing.Status.IsBreach)
                {
                    <a class="console-button-link" href="@OperateObservabilityRoutes.Geoprocessing" data-health-drilldown="geoprocessing">
                        Open geoprocessing queue
                    </a>
                }
            </div>

            <article class="console-panel operate-metric-card">
                <div class="console-panel-heading">
                    <div>
                        <h3>@_view.Geoprocessing.TotalActive active job(s)</h3>
                        <p class="console-muted">@_view.Geoprocessing.Status.Description</p>
                    </div>
                </div>

                @if (!_view.Geoprocessing.Available)
                {
                    <p class="console-muted">Geoprocessing queue telemetry is unavailable on the connected server.</p>
                }
                else if (_view.Geoprocessing.Buckets.Count == 0)
                {
                    <p class="console-muted">No active geoprocessing jobs.</p>
                }
                else
                {
                    <div class="operate-table-scroll">
                        <table class="operate-table">
                            <thead>
                                <tr>
                                    <th scope="col">Status</th>
                                    <th scope="col">Backend</th>
                                    <th scope="col">Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bucket in _view.Geoprocessing.Buckets)
                                {
                                    <tr>
                                        <td>@bucket.Status</td>
                                        <td>@bucket.Backend</td>
                                        <td>@bucket.Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </article>
        </section>

        <section id="alert-dispatch" class="operate-section" aria-labelledby="alert-dispatch-heading">
            <div class="operate-section-heading">
                <div>
                    <p class="console-kicker">Alert dispatch</p>
                    <h2 id="alert-dispatch-heading">Backlog And Dead-Letters</h2>
                </div>
                <span class="console-status @_view.AlertDispatch.Status.CssClass">@_view.AlertDispatch.Status.Label</span>
                @if (_view.AlertDispatch.Status.IsBreach)
                {
                    <a class="console-button-link" href="/operate/copilot" data-health-drilldown="alert-dispatch">
                        Investigate in Copilot Findings
                    </a>
                }
            </div>

            <article class="console-panel operate-metric-card @(_view.AlertDispatch.HasDeadLetters ? "operate-metric-alerts" : null)">
                <p class="console-muted">@_view.AlertDispatch.Status.Description</p>
                <dl class="console-definition-list">
                    <dt>Dispatcher</dt>
                    <dd>@(_view.AlertDispatch.DispatcherEnabled ? "enabled" : "disabled"), @(_view.AlertDispatch.DispatcherRunning ? "running" : "stopped")</dd>
                    <dt>Storage poll</dt>
                    <dd>@(_view.AlertDispatch.StoragePollFailing ? "failing" : "healthy")</dd>
                    <dt>Last successful poll</dt>
                    <dd>@_view.AlertDispatch.LastPollLabel</dd>
                    <dt>Pending</dt>
                    <dd>@_view.AlertDispatch.PendingLabel</dd>
                    <dt>Dead-lettered</dt>
                    <dd>@_view.AlertDispatch.DeadLetteredLabel</dd>
                </dl>
            </article>
        </section>

        <section id="deploy" class="operate-section" aria-labelledby="deploy-heading">
            <div class="operate-section-heading">
                <div>
                    <p class="console-kicker">Coordinated deploy</p>
                    <h2 id="deploy-heading">Deploy Readiness And Platform Release</h2>
                </div>
                <span class="console-status @_view.Deploy.Status.CssClass">@_view.Deploy.Status.Label</span>
                @if (_view.Deploy.Status.IsBreach)
                {
                    <a class="console-button-link" href="/operate/deploy#deploy-approvals" data-health-drilldown="deploy">
                        Open deploy approvals
                    </a>
                }
            </div>

            <div class="console-panel-grid">
                <article class="console-panel operate-metric-card">
                    <div class="console-panel-heading">
                        <div>
                            <h3>Readiness</h3>
                            <p class="console-muted">@_view.Deploy.Status.Description</p>
                        </div>
                    </div>
                    <dl class="console-definition-list">
                        <dt>Ready for coordinated deploy</dt>
                        <dd>@(_view.Deploy.ReadyForCoordinatedDeploy ? "yes" : "no")</dd>
                        <dt>Pending migrations</dt>
                        <dd>@_view.Deploy.PendingMigrationsCount</dd>
                        <dt>Pending contract scripts</dt>
                        <dd>@_view.Deploy.PendingContractScriptsCount</dd>
                    </dl>
                </article>

                <article class="console-panel operate-metric-card">
                    <div class="console-panel-heading">
                        <div>
                            <h3>Platform release</h3>
                            <p class="console-muted">@_view.Deploy.PlatformRelease.ReleaseLabel</p>
                        </div>
                        <span class="console-status @_view.Deploy.PlatformRelease.CoVersionStatus.CssClass">
                            @(_view.Deploy.PlatformRelease.IsCoVersioned ? "co-versioned" : "skewed")
                        </span>
                    </div>
                    <p class="console-muted">@_view.Deploy.PlatformRelease.CoVersionStatus.Description</p>
                    @if (_view.Deploy.PlatformRelease.SkewedIds.Count > 0)
                    {
                        <dl class="console-definition-list">
                            <dt>Skewed planes</dt>
                            <dd>@string.Join(", ", _view.Deploy.PlatformRelease.SkewedIds)</dd>
                        </dl>
                    }
                </article>
            </div>
        </section>

        <section id="database" class="operate-section" aria-labelledby="database-heading">
            <div class="operate-section-heading">
                <div>
                    <p class="console-kicker">Database vitals</p>
                    <h2 id="database-heading">Connection Pool, Cache, And Errors</h2>
                </div>
            </div>

            <div class="console-panel-grid">
                <article class="console-panel operate-metric-card">
                    <div class="console-panel-heading">
                        <div><h3>Connection pool</h3></div>
                        <span class="console-status @_view.Database.PoolUtilization.Status.CssClass">@_view.Database.PoolUtilization.Status.Label</span>
                        @if (_view.Database.PoolUtilization.Status.IsBreach)
                        {
                            <a class="console-button-link" href="/operate/metrics" data-health-drilldown="database-pool">
                                Open performance metrics
                            </a>
                        }
                    </div>
                    <MetricBar Bar="_view.Database.PoolUtilization" Label="Pool utilization" />
                    <dl class="console-definition-list">
                        <dt>Active connections</dt>
                        <dd>@_view.Database.ActiveConnections</dd>
                        <dt>Acquisition timeouts</dt>
                        <dd>@_view.Database.ConnectionAcquisitionTimeouts</dd>
                        <dt>Acquisition failures</dt>
                        <dd>@_view.Database.ConnectionAcquisitionFailures</dd>
                    </dl>
                </article>

                <article class="console-panel operate-metric-card">
                    <div class="console-panel-heading">
                        <div><h3>Cache hit ratio</h3></div>
                        <span class="console-status @_view.Database.CacheHitRatio.Status.CssClass">@_view.Database.CacheHitRatio.Status.Label</span>
                        @if (_view.Database.CacheHitRatio.Status.IsBreach)
                        {
                            <a class="console-button-link" href="/operate/metrics" data-health-drilldown="database-cache">
                                Open performance metrics
                            </a>
                        }
                    </div>
                    <MetricBar Bar="_view.Database.CacheHitRatio" Label="Hit ratio" />
                    <MetricBar Bar="_view.Database.ErrorRate" Label="Server error rate" />
                </article>
            </div>
        </section>

        <section id="health-checks" class="operate-section" aria-labelledby="health-checks-heading">
            <div class="operate-section-heading">
                <div>
                    <p class="console-kicker">Dependency health</p>
                    <h2 id="health-checks-heading">Comprehensive Health Checks</h2>
                </div>
                <span class="console-status @_view.Health.Status.CssClass">@_view.Health.Status.Label</span>
            </div>

            <div class="console-panel operate-table-panel">
                <div class="console-panel-heading">
                    <div>
                        <h3>Overall: <span class="console-status @_view.Health.Status.CssClass">@_view.Health.Status.Label</span></h3>
                        <p class="console-muted">Total duration @_view.Health.DurationLabel</p>
                    </div>
                </div>

                @if (_view.Health.Entries.Count == 0)
                {
                    <p class="console-muted">The server reported no individual health-check entries.</p>
                }
                else
                {
                    <div class="operate-table-scroll">
                        <table class="operate-table">
                            <thead>
                                <tr>
                                    <th scope="col">Check</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Duration</th>
                                    <th scope="col">Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in _view.Health.Entries)
                                {
                                    <tr>
                                        <td>@entry.Name</td>
                                        <td><span class="console-status @entry.Status.CssClass">@entry.Status.Label</span></td>
                                        <td>@entry.DurationLabel</td>
                                        <td>@(string.IsNullOrWhiteSpace(entry.Description) ? "—" : entry.Description)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>

        <section id="trends" class="operate-section" aria-labelledby="trends-heading">
            <div class="operate-section-heading">
                <div>
                    <p class="console-kicker">Trend charts &middot; @CurrentRangeSelection.Label</p>
                    <h2 id="trends-heading">Serving Latency, Error Rate, Queue, And Backlog Over Time</h2>
                </div>
                <span class="console-status @TrendRealtimeStateClass" data-realtime-pill title="@TrendRealtimeStateTitle">
                    @TrendRealtimeStateLabel
                </span>
            </div>

            @* Reconnect seam (console#288 addendum item 3, pinned choice): the history read
               (honua-server PR #2576) is the sole gap-fill contract. Live pushes from the
               ops-health hub group (PR #2591) are held in a SEPARATE live band at their native
               30-60s cadence rather than appended onto the downsampled 5-min/hourly window; a
               chart marks the boundary with a dashed rule instead of blending the two silently.
               The live band is idempotent-appended (OpsHealthLiveBand.Append, keyed on the flush
               timestamp) and cleared whenever a fresh history fetch subsumes it
               (OpsHealthLiveBand.TrimToAfter). *@
            <form class="console-panel operate-filter-bar" aria-label="Ops health trend controls"
                  @onsubmit="ApplyTrendRangeAsync" @onsubmit:preventDefault="true">
                <label>
                    <span>Range</span>
                    <select class="console-input" data-trend-range @bind="_selectedRangeLabel">
                        @foreach (var option in OpsHealthTrendRangeSelection.Options)
                        {
                            <option value="@option.Label">@option.Label (@option.Resolution resolution)</option>
                        }
                    </select>
                </label>
                <label class="console-field">
                    <input type="checkbox" data-per-replica-toggle @bind="_perReplica" />
                    <span>Per-replica breakdown</span>
                </label>
                <button class="console-button" type="submit" data-refresh-trends>Apply</button>
            </form>

            @if (_trendResult is null)
            {
                <OperateSectionStatusPanel Heading="Trend charts" Loading="true" />
            }
            else if (!_trendResult.IsAllowed)
            {
                @if (_trendResult.Status == OperateSectionStatus.Unsupported)
                {
                    <OperateSectionStatusPanel Heading="Trend charts" Status="OperateSectionStatus.Unsupported"
                        Message="The connected server does not yet expose ops-health history (honua-server PR #2576). Trend charts are unavailable; the at-a-glance snapshot above stays live." />
                }
                else
                {
                    <OperateSectionStatusPanel Heading="Trend charts" Status="_trendResult.Status" Message="@_trendResult.Message" />
                }
            }
            else if (IsTrendFirstRun)
            {
                <OperateSectionStatusPanel Heading="Trend charts" Empty="true"
                    EmptyTitle="Collecting baseline"
                    EmptyMessage="Collecting baseline — first signal in ~60s; history fills over 24h." />
            }
            else
            {
                <div class="console-panel-grid operate-trend-grid" data-trend-grid>
                    @foreach (var series in LatencyTrendSeries)
                    {
                        <article class="console-panel operate-metric-card">
                            <div class="console-panel-heading">
                                <div>
                                    <h3>@series.SeriesLabel latency (p50/p95/p99)</h3>
                                </div>
                                @if (series.HasBreach)
                                {
                                    <a class="console-chip correlation-id-chip" data-trend-breach-chip
                                       href="/operate/copilot" data-health-drilldown="serving-latency-trend"
                                       title="Investigate this SLO breach in Copilot Findings">
                                        SLO breach
                                    </a>
                                }
                            </div>
                            <ChartPreview Title="p50 / p95 / p99" Spec="@LatencySpec(series)"
                                          AriaLabel="@($"{series.SeriesLabel} latency trend")" />
                        </article>

                        <article class="console-panel operate-metric-card">
                            <div class="console-panel-heading">
                                <div>
                                    <h3>@series.SeriesLabel error rate</h3>
                                </div>
                            </div>
                            <ChartPreview Title="Error rate" Spec="@ErrorRateSpec(series)"
                                          AriaLabel="@($"{series.SeriesLabel} error rate trend")" />
                        </article>
                    }

                    <article class="console-panel operate-metric-card">
                        <div class="console-panel-heading">
                            <div>
                                <h3>Geoprocessing queue</h3>
                            </div>
                        </div>
                        <ChartPreview Title="Active jobs" Spec="@GpQueueSpec" AriaLabel="Geoprocessing queue trend" />
                    </article>

                    <article class="console-panel operate-metric-card">
                        <div class="console-panel-heading">
                            <div>
                                <h3>Alert-dispatch backlog</h3>
                            </div>
                        </div>
                        <ChartPreview Title="Pending / dead-lettered" Spec="@AlertBacklogSpec" AriaLabel="Alert-dispatch backlog trend" />
                    </article>
                </div>
            }
        </section>
    }
</section>

@code {
    // Re-fetch the trend history on this cadence so the live band (held at native 30-60s cadence
    // per the pinned reconnect-seam choice) never grows without bound and is regularly subsumed
    // back into the confirmed, downsampled history window.
    private static readonly TimeSpan TrendRefreshInterval = TimeSpan.FromMinutes(5);

    private bool _loaded;
    private bool _busy;
    private OpsHealthView? _view;
    private OperateSectionStatus _status = OperateSectionStatus.Unavailable;
    private string _message = string.Empty;

    private OperateSectionResult<OpsHealthTrendView>? _trendResult;
    private string _selectedRangeLabel = OpsHealthTrendRangeSelection.LastHour.Label;
    private bool _perReplica;
    private IReadOnlyList<OpsHealthSnapshotResponse> _liveBand = [];
    private DateTimeOffset _historyCutoff = DateTimeOffset.MinValue;

    private IConsoleOpsHealthRealtimeClient? _realtimeClient;
    private PeriodicTimer? _trendRefreshTimer;
    private CancellationTokenSource? _trendRefreshCts;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAsync(), LoadTrendAsync());

        _realtimeClient = ServiceProvider.GetService<IConsoleOpsHealthRealtimeClient>();
        if (_realtimeClient is not null)
        {
            _realtimeClient.SnapshotReceived += OnSnapshotReceived;
            if (_realtimeClient is IConsoleRealtimeCapabilityClient capability)
            {
                capability.ConnectionStateChanged += OnRealtimeConnectionStateChanged;
            }

            await _realtimeClient.StartAsync();
        }

        StartTrendRefreshTimer();
    }

    private async Task RefreshAsync()
    {
        if (_busy)
        {
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            var result = await HealthData.GetSnapshotAsync();
            if (result.IsAllowed)
            {
                _view = result.Value;
            }
            else
            {
                _view = null;
                _status = result.Status;
                _message = result.Message;
            }
        }
        finally
        {
            _loaded = true;
            _busy = false;
        }
    }

    private OpsHealthTrendRangeSelection CurrentRangeSelection =>
        (OpsHealthTrendRangeSelection.Options.FirstOrDefault(o => o.Label == _selectedRangeLabel)
            ?? OpsHealthTrendRangeSelection.LastHour)
        .WithPerReplica(_perReplica);

    private OpsHealthTrendView Trend =>
        _trendResult?.Value ?? OpsHealthTrendView.Empty(CurrentRangeSelection.Label, CurrentRangeSelection.Resolution, _perReplica);

    private bool IsTrendFirstRun => Trend.IsFirstRun && _liveBand.Count == 0;

    // The seam annotation only renders once the live band is actually contributing points past
    // the confirmed history window (console#288 addendum item 3) — a chart with no live band yet
    // has nothing to mark a boundary against.
    private DateTimeOffset? SeamAt => _liveBand.Count > 0 ? _historyCutoff : null;

    private IReadOnlyList<OpsHealthVitalsTrendPointView> VitalsTrendPoints =>
        Trend.VitalsPoints.Concat(OpsHealthLiveBand.ToVitalsPoints(_liveBand)).ToArray();

    private string? GpQueueSpec => OpsHealthTrendCharts.BuildGpQueueSpec(VitalsTrendPoints, SeamAt);

    private string? AlertBacklogSpec => OpsHealthTrendCharts.BuildAlertBacklogSpec(VitalsTrendPoints, SeamAt);

    private string? LatencySpec(OpsHealthLatencyTrendSeriesView series) =>
        OpsHealthTrendCharts.BuildLatencySpec(series, SeamAt);

    private string? ErrorRateSpec(OpsHealthLatencyTrendSeriesView series) =>
        OpsHealthTrendCharts.BuildErrorRateSpec(series, SeamAt);

    // Extends each history-derived series with the matching live-band points (idempotent-appended
    // and cutoff-filtered already by OpsHealthLiveBand), and re-tests the SLO breach heuristic over
    // the combined points so a live-only breach is not missed between history refreshes. Also
    // surfaces a protocol the live band has seen but the current history window predates (a
    // brand-new protocol, or the very first samples after boot).
    private IReadOnlyList<OpsHealthLatencyTrendSeriesView> LatencyTrendSeries
    {
        get
        {
            var result = new List<OpsHealthLatencyTrendSeriesView>();
            foreach (var series in Trend.LatencySeries)
            {
                var livePoints = OpsHealthLiveBand.ToLatencyPoints(_liveBand, series.Protocol);
                var points = livePoints.Count == 0 ? series.Points : series.Points.Concat(livePoints).ToArray();
                result.Add(series with { Points = points, HasBreach = OpsHealthTrendMapper.HasBreach(points) });
            }

            foreach (var protocol in OpsHealthLiveBand.DistinctProtocols(_liveBand))
            {
                if (result.Any(r => r.ReplicaId is null && string.Equals(r.Protocol, protocol, StringComparison.OrdinalIgnoreCase)))
                {
                    continue;
                }

                var livePoints = OpsHealthLiveBand.ToLatencyPoints(_liveBand, protocol);
                if (livePoints.Count == 0)
                {
                    continue;
                }

                result.Add(new OpsHealthLatencyTrendSeriesView(protocol, null, livePoints, OpsHealthTrendMapper.HasBreach(livePoints)));
            }

            return result;
        }
    }

    private async Task ApplyTrendRangeAsync() => await LoadTrendAsync();

    private async Task LoadTrendAsync()
    {
        var selection = CurrentRangeSelection;
        var result = await HealthData.GetHistoryAsync(selection);
        _trendResult = result;

        if (result is { IsAllowed: true, Value: { } trend })
        {
            // The history read just re-confirmed everything up to trend.To: drop any live-band
            // point it now covers so nothing renders twice across the refresh (the pinned
            // reconnect-seam contract, console#288 addendum item 3).
            _historyCutoff = trend.To;
            _liveBand = OpsHealthLiveBand.TrimToAfter(_liveBand, _historyCutoff);
        }

        await InvokeAsync(StateHasChanged);
    }

    private void OnSnapshotReceived(OpsHealthSnapshotResponse snapshot)
    {
        _liveBand = OpsHealthLiveBand.Append(_liveBand, snapshot, _historyCutoff);
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnRealtimeConnectionStateChanged(ConsoleRealtimeConnectionState state) => InvokeAsync(StateHasChanged);

    private void StartTrendRefreshTimer()
    {
        _trendRefreshCts = new CancellationTokenSource();
        _trendRefreshTimer = new PeriodicTimer(TrendRefreshInterval);
        _ = TrendRefreshLoopAsync(_trendRefreshTimer, _trendRefreshCts.Token);
    }

    private async Task TrendRefreshLoopAsync(PeriodicTimer timer, CancellationToken cancellationToken)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadTrendAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed; expected.
        }
    }

    private ConsoleRealtimeConnectionState TrendRealtimeConnectionState =>
        _realtimeClient is IConsoleRealtimeCapabilityClient capability ? capability.ConnectionState : ConsoleRealtimeConnectionState.NotConfigured;

    private string TrendRealtimeStateClass => TrendRealtimeConnectionState switch
    {
        ConsoleRealtimeConnectionState.Connected => "console-state-success",
        ConsoleRealtimeConnectionState.Connecting => "console-state-info",
        ConsoleRealtimeConnectionState.FallbackEngaged => "console-state-neutral",
        _ => "console-state-neutral",
    };

    private string TrendRealtimeStateLabel => TrendRealtimeConnectionState switch
    {
        ConsoleRealtimeConnectionState.Connected => "Live",
        ConsoleRealtimeConnectionState.Connecting => "Connecting…",
        ConsoleRealtimeConnectionState.FallbackEngaged => "Manual (poll)",
        _ => "Manual",
    };

    private string TrendRealtimeStateTitle => TrendRealtimeConnectionState switch
    {
        ConsoleRealtimeConnectionState.Connected => "Live ops-health updates via the admin realtime hub.",
        ConsoleRealtimeConnectionState.Connecting => "Connecting to the admin realtime hub.",
        ConsoleRealtimeConnectionState.FallbackEngaged =>
            "The ops-health realtime group is unavailable (honua-server PR #2591 not on this server, or no Redis backplane); trend charts refresh every 5 minutes.",
        _ => "No environment is bound; trend charts refresh every 5 minutes.",
    };

    public async ValueTask DisposeAsync()
    {
        _trendRefreshCts?.Cancel();
        _trendRefreshCts?.Dispose();
        _trendRefreshTimer?.Dispose();

        // The realtime client is an app-lifetime singleton shared across circuits (mirrors
        // OperateDeployOperationsList): only detach this component's handlers, never dispose it.
        if (_realtimeClient is not null)
        {
            _realtimeClient.SnapshotReceived -= OnSnapshotReceived;
            if (_realtimeClient is IConsoleRealtimeCapabilityClient capability)
            {
                capability.ConnectionStateChanged -= OnRealtimeConnectionStateChanged;
            }
        }

        await ValueTask.CompletedTask;
    }
}
