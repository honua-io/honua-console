@page "/embed/maps/{MapId}"
@layout EmbedLayout
@inject IConsoleCatalogClient Catalog
@inject NavigationManager Navigation

<section class="console-embed-page @( _options.Chrome ? "with-chrome" : "shellless" )">
    @if (_result is null)
    {
        <ConsoleStateView Kind="loading" Kicker="Loading" Title="Loading embed" Message="The embedded map is loading." />
    }
    else if (_result.Status != CatalogReadStatus.Allowed || _result.MapPackage is null)
    {
        @RenderReadState(_result.Status, _result.Message)
    }
    else
    {
        var map = _result.MapPackage;
        @if (_options.Chrome)
        {
            <header class="console-embed-header">
                <strong>@map.Summary.Title</strong>
                <span>Honua map embed</span>
            </header>
        }
        <div class="console-embed-map" aria-label="Embedded map">
            <div class="console-map-canvas">
                <span>@map.Summary.Title</span>
                <small>@(string.IsNullOrWhiteSpace(_options.Extent) ? $"Extent {map.InitialExtent}" : $"Extent {_options.Extent}")</small>
            </div>
            @if (_options.Zoom)
            {
                <div class="console-embed-zoom" aria-label="Zoom controls">
                    <button type="button">+</button>
                    <button type="button">-</button>
                </div>
            }
            @if (_options.Legend)
            {
                <aside class="console-embed-legend" aria-label="Legend">
                    <strong>Legend</strong>
                    @foreach (var layer in map.Layers)
                    {
                        <span>@layer</span>
                    }
                </aside>
            }
        </div>
    }
</section>

@code {
    [Parameter]
    public string MapId { get; set; } = string.Empty;

    private EmbedRouteOptions _options = new();
    private MapPackageReadResult? _result;

    protected override async Task OnParametersSetAsync()
    {
        _options = EmbedRouteOptions.FromUri(Navigation.Uri);
        _result = await Catalog.AuthorizeEmbedAsync(MapId, _options);
    }

    private RenderFragment RenderReadState(CatalogReadStatus status, string message) => builder =>
    {
        var (kind, kicker, title, body) = status switch
        {
            CatalogReadStatus.Missing => ("missing", "Missing map", "Embedded map not found", "The embedded map is not available."),
            CatalogReadStatus.UnsupportedPackageBinding => ("unsupported-package", "Unsupported package", "Unsupported map package", message),
            _ => ("unavailable", "Unavailable", "Embed unavailable", "This embed is private, expired, missing a valid fragment token, or no longer allowed.")
        };

        builder.OpenComponent<ConsoleStateView>(0);
        builder.AddAttribute(1, "Kind", kind);
        builder.AddAttribute(2, "Kicker", kicker);
        builder.AddAttribute(3, "Title", title);
        builder.AddAttribute(4, "Message", body);
        builder.CloseComponent();
    };
}
