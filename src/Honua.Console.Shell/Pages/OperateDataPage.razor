@page "/operate/data"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IOperateTransitionDataSource OperateData
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page operate-data-page" data-operate-data>
    @if (V4Enabled)
    {
        <ConsolePageHeading Title="Layer preview">
            <ChildContent><p>Browse every dataset and open it as a map or through its served routes.</p></ChildContent>
            <Actions><a class="console-button" href="@Navigation.ToConsoleHref("/operate/data/new")">Add data</a></Actions>
        </ConsolePageHeading>
    }
    else
    {
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Datasets</p>
        <h1>Datasets</h1>
        <p>Datasets and the services that expose them. Expand a dataset to see its layers, then select a layer to preview its endpoint.</p>
        <div class="console-action-row">
            <a class="console-button" href="@Navigation.ToConsoleHref("/operate/data/new")">+ Add data</a>
        </div>
    </div>

    }

    @if (!_loaded)
    {
        <p role="status">Reading datasets…</p>
    }
    <ConsoleConnectionNotice Heading="Could not read all datasets" States="_states" Error="@_loadError" OnRetry="LoadAsync" Busy="@(!_loaded)" />
    @if (_loaded && (_states.Count == 0 && _loadError is null || _nodes.Count > 0))
    {

        @if (V4Enabled)
        {
            <ConsolePanel Title="Layers" HeadingId="data-publications-heading">
                <LayerPreviewCatalog Rows="@_catalogRows" SelectedResourceId="@_selectedResource?.ResourceId" SelectedProtocolId="@_preview?.ProtocolId"
                                     OnPublicationSelected="OnPublicationSelected" />
            </ConsolePanel>
            @if (_selectedResource is not null)
            {
                <LayerPreviewPane Selection="@_preview"
                                  Layer="@PreviewLayer"
                                  EnvironmentId="@_environmentId"
                                  Protocols="@_previewProtocols"
                                  EmptyText="This dataset is not published yet. Publish it, or pick Map on a published layer."
                                  OnProtocolSelected="OnPreviewProtocolChanged" />
            }
        }
        else
        {
            @DatasetBrowser
        }

    }
</section>

@code {
    private bool V4Enabled => ServiceProvider.GetService<ConsoleV4Options>()?.Enabled == true;
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = "/operate/data",
        Entities = _nodes.Select(ResourceEntity).ToArray(),
        Selection = _selectedResource is { } selected ? [ResourceEntity(selected)] : [],
        Unsaved = new() { PendingOperationCount = _loaded ? 0 : 1 }
    };

    private static ConsoleAgentEntity ResourceEntity(ResourceTreeNode node) => new()
    {
        Kind = ConsoleAgentEntityKind.Item, Id = node.ResourceId, ResourceId = node.ResourceId
    };

    private RenderFragment DatasetBrowser => @<div>
    <div class="operate-data-page__split">
        <ResourcePublicationsTree Nodes="@_nodes"
                                  FocusResourceId="@Focus"
                                  OnPublicationSelected="OnPublicationSelected"
                                  OnResourceSelected="OnResourceSelected" />
        <LayerPreviewPane Selection="@_preview"
                          Layer="@PreviewLayer"
                          EnvironmentId="@_environmentId"
                          Protocols="@_previewProtocols"
                          OnProtocolSelected="OnPreviewProtocolChanged" />
    </div>
    </div>;

    [SupplyParameterFromQuery(Name = "focus")]
    public string? Focus { get; set; }

    private IReadOnlyList<ResourceTreeNode> _nodes = [];
    private IReadOnlyList<OperateCapabilityState> _states = [];
    private LayerPreviewPane.PreviewSelection? _preview;
    private IReadOnlyList<LayerPreviewPane.PreviewSelection> _previewProtocols = [];
    private ResourceTreeNode? _selectedResource;
    private OperateServicesView? _servicesView;
    private string? _environmentId;

    private IReadOnlyList<LayerPreviewCatalog.Row> _catalogRows = [];

    private OperateServiceLayer? PreviewLayer => _preview is { } preview ? _servicesView?.FindLayer(preview.ResourceId) : null;

    private bool _loaded;
    private string? _loadError;

    private string? _appliedFocus;
    private int _loadGeneration;

    private Task? _initialLoad;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded)
        {
            ApplyFocus();
            return;
        }

        // Parameter updates during the first read share it; ApplyFocus at its end uses the latest Focus.
        _initialLoad ??= LoadAsync();
        try { await _initialLoad; }
        finally { _initialLoad = null; }
    }

    private void ApplyFocus()
    {
        if (string.Equals(_appliedFocus, Focus, StringComparison.Ordinal)) return;
        _appliedFocus = Focus;
        _selectedResource = _nodes.FirstOrDefault(node => string.Equals(node.ResourceId, Focus, StringComparison.Ordinal));
        _preview = null;
        _previewProtocols = [];
        if (_selectedResource is { Publications.Count: > 0 } node) SetPreviewFromResource(node, node.Publications[0]);
    }

    private async Task LoadAsync()
    {
        var generation = ++_loadGeneration;
        _loaded = false;
        _loadError = null;
        _nodes = [];
        _catalogRows = [];
        _states = [];
        _preview = null;
        _previewProtocols = [];
        _selectedResource = null;
        _servicesView = null;
        _environmentId = null;
        _appliedFocus = null;
        try
        {
        var resourcesView = await OperateData.GetResourcesViewAsync();
        var servicesView = await OperateData.GetServicesViewAsync();
        if (generation != _loadGeneration) return;
        _servicesView = servicesView;
        var environmentId = await ConsoleProxyRoutes.ResolveActiveEnvironmentIdAsync(
            ServiceProvider.GetService<IConsoleEnvironmentProfileStore>());
        if (generation != _loadGeneration) return;
        _environmentId = environmentId;

        _nodes = ResourcePublicationsTreeBuilder.Build(resourcesView.ResourceEdits, servicesView.Services);
        if (V4Enabled) _catalogRows = CatalogRows(_nodes, servicesView);
        _states = OperateCapabilityStateFilters.ForSurface(
            resourcesView.CapabilityStates.Concat(servicesView.CapabilityStates).ToArray(),
            "Resources", "Layers", "Services");

        ApplyFocus();
        }
        catch (Exception)
        {
            if (generation != _loadGeneration) return;
            _loadError = "The dataset request did not complete. Check the environment and try again.";
        }
        finally { if (generation == _loadGeneration) _loaded = true; }
    }

    private void OnResourceSelected(ResourceTreeNode node) => _selectedResource = node;

    private void OnPublicationSelected(LayerPreviewPane.PreviewSelection selection)
    {
        _preview = selection;
        var node = _nodes.FirstOrDefault(n => string.Equals(n.ResourceId, selection.ResourceId, StringComparison.Ordinal));
        _selectedResource = node;
        _previewProtocols = node is null ? [] : ProtocolsFor(node);
    }

    private void OnPreviewProtocolChanged(string protocolId)
    {
        var match = _previewProtocols.FirstOrDefault(p => string.Equals(p.ProtocolId, protocolId, StringComparison.Ordinal));
        if (match is not null)
        {
            _preview = match;
        }
    }

    private void SetPreviewFromResource(ResourceTreeNode node, PublicationTreeNode publication)
    {
        if (LayerPreviewPane.PreviewSelection.For(node, publication) is not { } selection) return;
        _preview = selection;
        _previewProtocols = ProtocolsFor(node);
    }

    private static IReadOnlyList<LayerPreviewCatalog.Row> CatalogRows(IReadOnlyList<ResourceTreeNode> nodes, OperateServicesView servicesView)
    {
        var geometry = servicesView.GeometryByCanonicalResourceId();
        return nodes.Select(node => new LayerPreviewCatalog.Row(node, geometry.GetValueOrDefault(node.ResourceId))).ToArray();
    }

    private static IReadOnlyList<LayerPreviewPane.PreviewSelection> ProtocolsFor(ResourceTreeNode node) =>
        node.Publications
            .Select(publication => LayerPreviewPane.PreviewSelection.For(node, publication))
            .OfType<LayerPreviewPane.PreviewSelection>()
            .ToArray();
}
