@page "/operate/data"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Components.Operate
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IOperateTransitionDataSource OperateData

@*
    The GeoServer-style "Data & Layers" spine (redesign §5.2 NEW /operate/data, §5.3). Merges the old
    Resources / Layers / Services flat lists into one resource→publications treeview with a Layer Preview.
    The tree is built from the Operate workspace projections (resources + services-with-layers grouped by
    canonical resource); missing-binding states render as first-class capability states, never fabricated.
*@
<section class="console-page operate-data-page" data-operate-data>
    <div class="console-page-heading">
        <p class="console-kicker">Operate / Data &amp; Layers</p>
        <h1>Data &amp; Layers</h1>
        <p>Resources, and the services/protocols each is published on. Expand a resource to see its publications; pick one to preview its served endpoint.</p>
        @if (_loaded && !HasMissingBinding)
        {
            <div class="console-action-row">
                <a class="console-button" href="/operate/data/new">+ Add data</a>
            </div>
        }
    </div>

    @if (!_loaded)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Loading"
                          Title="Loading data and layers"
                          Message="Reading resources and their live publications from the connected environment." />
    }
    else if (_nodes.Count == 0 && HasMissingBinding)
    {
        <ConsoleStateView Kind="missing"
                          Kicker="Environment required"
                          Title="Connect an environment to browse data and layers"
                          Message="Choose the Honua environment whose resources and published endpoints you want to manage."
                          ActionHref="/environments/new"
                          ActionLabel="Connect environment" />
        <details class="console-panel">
            <summary>Technical details</summary>
            @foreach (var state in _states)
            {
                <p><strong>@state.State:</strong> @state.Detail</p>
            }
        </details>
    }
    else if (_nodes.Count == 0 && _states.Count > 0)
    {
        <OperateCapabilityStateList States="@_states" />
    }
    else
    {
        <OperateCapabilityStateList States="@_states" />

        <div class="operate-data-page__split">
            <ResourcePublicationsTree Nodes="@_nodes"
                                      FocusResourceId="@Focus"
                                      OnPublicationSelected="OnPublicationSelected"
                                      OnResourceSelected="OnResourceSelected" />
            <LayerPreviewPane Selection="@_preview"
                              Protocols="@_previewProtocols"
                              OnProtocolSelected="OnPreviewProtocolChanged" />
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "focus")]
    public string? Focus { get; set; }

    private IReadOnlyList<ResourceTreeNode> _nodes = [];
    private IReadOnlyList<OperateCapabilityState> _states = [];
    private LayerPreviewPane.PreviewSelection? _preview;
    private IReadOnlyList<LayerPreviewPane.PreviewSelection> _previewProtocols = [];
    private ResourceTreeNode? _selectedResource;
    private bool _loaded;

    private bool HasMissingBinding =>
        _states.Any(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var resourcesView = await OperateData.GetResourcesViewAsync();
        var servicesView = await OperateData.GetServicesViewAsync();

        _nodes = ResourcePublicationsTreeBuilder.Build(resourcesView.ResourceEdits, servicesView.Services);
        _states = OperateCapabilityStateFilters.ForSurface(
            resourcesView.CapabilityStates.Concat(servicesView.CapabilityStates).ToArray(),
            "Resources", "Layers", "Services");
        _loaded = true;

        if (!string.IsNullOrWhiteSpace(Focus))
        {
            var focused = _nodes.FirstOrDefault(node => string.Equals(node.ResourceId, Focus, StringComparison.Ordinal));
            if (focused is { } node && node.Publications.Count > 0)
            {
                SetPreviewFromResource(node, node.Publications[0]);
            }
        }
    }

    private void OnResourceSelected(ResourceTreeNode node) => _selectedResource = node;

    private void OnPublicationSelected(LayerPreviewPane.PreviewSelection selection)
    {
        _preview = selection;
        var node = _nodes.FirstOrDefault(n => string.Equals(n.ResourceId, selection.ResourceId, StringComparison.Ordinal));
        _previewProtocols = node is null ? [] : ProtocolsFor(node);
    }

    private void OnPreviewProtocolChanged(string protocolId)
    {
        var match = _previewProtocols.FirstOrDefault(p => string.Equals(p.ProtocolId, protocolId, StringComparison.Ordinal));
        if (match is not null)
        {
            _preview = match;
        }
    }

    private void SetPreviewFromResource(ResourceTreeNode node, PublicationTreeNode publication)
    {
        _preview = new LayerPreviewPane.PreviewSelection(
            node.ResourceId, node.Name, publication.ProtocolId, publication.ProtocolLabel, publication.Route);
        _previewProtocols = ProtocolsFor(node);
    }

    private static IReadOnlyList<LayerPreviewPane.PreviewSelection> ProtocolsFor(ResourceTreeNode node) =>
        node.Publications
            .Select(publication => new LayerPreviewPane.PreviewSelection(
                node.ResourceId, node.Name, publication.ProtocolId, publication.ProtocolLabel, publication.Route))
            .ToArray();
}
