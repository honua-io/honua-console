@page "/studio/app"
@using System.Text.Json
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Validation
@inject IStudioAppPackageDataSource AppData

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have unsaved app changes. Leave this page and discard them?" />

@* Studio app builder (honua-console#58). Three-pane editor matching the StudioAppEditor design handoff
   (docs/design-handoff/console-canvas/screens-studio-rest.jsx): an app-identity toolbar, a page tree +
   component palette rail, a responsive page canvas, and a component-binding inspector. Binds the
   server-owned Studio app package lifecycle (honua-server#1180/#1183) through the
   Honua.Console.Contracts shim; renders the missing-binding surface (not mock data) when no server base
   URL is configured. Reopened edits create new content versions rather than mutating published state. *@

<section class="console-page studio-page studio-app-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>App builder</h1>
        <p>Assemble a server-owned app package — pages, components, navigation, bound actions, and permissions — review the share/embed policy, then save versions and publish to honua-server. Reopened edits create new content versions rather than mutating the published app.</p>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="App builder"
                          Title="Loading app builder"
                          Message="Reading the Studio app package lifecycle from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="App package lifecycle is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else if (_editor is { } editor)
    {
        var readiness = StudioAppPackageMapper.EvaluatePublishReadiness(editor);
        var selectedPage = SelectedPage;

        @if (_view == EditorView.FromPrompt)
        {
            @* StudioAppAI — conversation + clarification on the left, a live app-package inspector on the
               right driven by the real authoring state (never fabricated). A prompt/refine turn calls the
               server's natural-language app generation contract (POST /api/v1/studio/app-packages/generate).
               The server grounds the proposal in the catalog/saved-content and validates it before returning,
               so the page only ever renders a server-produced app (status==generated, the editor hydrates from
               the returned studio-app/v1 body), a structured clarification request, or an honest
               unavailable/refused/blocked state — never a fabricated app (no-mock, Charter §11). *@
            <div class="studio-app-ai" data-app-builder="app.package" data-app-view="ai" data-app-status="@(editor.IsPublished ? "published" : "draft")">
                <StudioAiConversation ConversationTitle="App from prompt"
                                      RefinePlaceholder="Describe the app — its pages, what each binds to, and the actions and permissions…"
                                      Turns="_turns"
                                      Clarifications="_clarifications"
                                      Busy="_busy"
                                      OnSend="OnPromptSend"
                                      OnAnswer="OnClarificationAnswered">
                    <PreviewHeader>
                        <span class="studio-app-glyph" aria-hidden="true">❒</span>
                        <input class="console-input studio-app-name" @bind="editor.Title" @bind:after="OnEdit" placeholder="field-operations-app" aria-label="App title" />
                        <span class="console-status @(editor.IsPublished ? string.Empty : "console-status-warning")">@(editor.IsPublished ? $"published v{editor.PublishedVersion}" : (editor.IsExistingDraft ? "server draft" : "new draft"))</span>
                        <span class="console-status @(readiness.CanPublish ? string.Empty : "console-status-warning")">@(readiness.CanPublish ? "ready to publish" : $"{readiness.UnmetRequirements.Count} to resolve")</span>
                        <div class="studio-ai-preview-head-spacer"></div>
                        <button class="console-button" type="button" disabled="@_busy" @onclick="OpenEditorFromPrompt">Open editor →</button>
                        <button class="console-button" type="button" disabled="@(_busy || editor.IsPublished || !readiness.CanPublish || _validation.HasBlockingClientErrors)" @onclick="Publish">Publish…</button>
                    </PreviewHeader>
                    <PreviewContent>
                        @* The RESULT: a live preview of the generated app shell — the real pages laid out as
                           panels (map → MapPreview, dashboard/report → ChartPreview, table → structural table,
                           form → bound form), driven entirely by the real authoring state. The package
                           summary, actions/permissions, pre-publish, and raw JSON stay available below as
                           structural detail, but the headline is the shell — not apppackage chrome. *@
                        <div class="studio-app-ai-inspect" data-app-preview="true">
                            <StudioAppPreview App="editor" />

                            <aside class="studio-app-ai-package" aria-label="App package detail">
                                <p class="console-muted studio-app-ai-section">Actions &amp; permissions · @editor.Actions.Count</p>
                                @if (editor.Actions.Count > 0)
                                {
                                    <ul class="studio-app-ai-action-list">
                                        @foreach (var aiAction in editor.Actions)
                                        {
                                            <li class="studio-mono" @key="aiAction">@(string.IsNullOrWhiteSpace(aiAction.Name) ? "action" : aiAction.Name) · @aiAction.PageRoute · @aiAction.RequiredPermission</li>
                                        }
                                    </ul>
                                }

                                <p class="console-muted studio-app-ai-section">Pre-publish</p>
                                @if (readiness.CanPublish)
                                {
                                    <div class="studio-app-ai-validation studio-app-ai-validation-ok">All pre-publish requirements met.</div>
                                }
                                else
                                {
                                    <ul class="studio-compact-list studio-app-ai-validation">
                                        @foreach (var requirement in readiness.UnmetRequirements)
                                        {
                                            <li>@requirement</li>
                                        }
                                    </ul>
                                }

                                <details class="studio-app-ai-raw">
                                    <summary>View raw package JSON</summary>
                                    <pre class="studio-code studio-package-json">@PackageJson(editor)</pre>
                                </details>
                            </aside>
                        </div>
                    </PreviewContent>
                </StudioAiConversation>
            </div>
        }
        else
        {
        <div class="studio-app-editor" data-app-builder="app.package" data-app-view="editor" data-app-published="@editor.IsPublished.ToString().ToLowerInvariant()">
            @* App-identity toolbar: glyph, name, lifecycle badge, summary stats, then preview/lifecycle actions. *@
            <div class="studio-app-toolbar" data-app-toolbar="true">
                <span class="studio-app-glyph" aria-hidden="true">❒</span>
                <input class="console-input studio-app-name" readonly
                       value="@(string.IsNullOrWhiteSpace(editor.Title) ? "untitled-app" : editor.Title)"
                       aria-label="App identity" />
                <span class="console-status @(editor.IsPublished ? string.Empty : "console-status-warning")">
                    @(editor.IsPublished ? $"published v{editor.PublishedVersion}" : (editor.IsExistingDraft ? "server draft" : "new draft"))
                </span>
                <span class="console-muted studio-app-stats" data-app-stats="true">
                    @editor.Pages.Count page@(editor.Pages.Count == 1 ? string.Empty : "s") · @editor.Actions.Count action@(editor.Actions.Count == 1 ? string.Empty : "s") · @editor.Visibility@(editor.EmbedEnabled ? " · embeddable" : string.Empty)
                </span>
                <div class="studio-app-toolbar-spacer"></div>
                @if (_cameFromPrompt)
                {
                    <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToChat">← Back to chat</button>
                }
                else
                {
                    <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="NewFromPrompt">New from prompt</button>
                }
                <button class="console-button console-button-secondary" type="button" disabled="@(_busy || !editor.IsExistingDraft)" @onclick="Preview">Live preview ↗</button>
                <button class="console-button console-button-secondary" type="button" disabled="@(_busy || !editor.IsExistingDraft)" @onclick="Validate">Validate</button>
                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="Save">Save draft</button>
                <button class="console-button" type="button" disabled="@(_busy || !readiness.CanPublish || _validation.HasBlockingClientErrors)" @onclick="Publish">Publish…</button>
            </div>

            @if (!string.IsNullOrEmpty(_status))
            {
                <p class="@(_statusFailed ? "console-warning" : "console-status") studio-app-status" role="status" aria-live="polite">@_status</p>
            }

            @if (_validation.HasBlockingClientErrors)
            {
                <div class="console-warning studio-app-validation-summary" role="alert" data-app-validation="blocking">
                    <p>Resolve these before publishing:</p>
                    <ul class="studio-compact-list">
                        @foreach (var error in _validation.Summary.Where(e => e.IsBlocking))
                        {
                            <li>@error.Message</li>
                        }
                    </ul>
                </div>
            }

            @* Three panes: page tree + component palette · responsive canvas · component-binding inspector. *@
            <div class="studio-app-panes">
                <aside class="studio-app-rail" data-app-rail="true">
                    <div class="studio-app-rail-head">
                        <h3>Pages</h3>
                        <button class="console-button console-button-secondary console-button-sm" type="button" disabled="@_busy" @onclick="AddPage">+ Page</button>
                    </div>

                    <ValidationMessageInline FieldKey="@StudioAppFieldKeys.Pages" State="_validation" />

                    @if (editor.Pages.Count == 0)
                    {
                        <p class="console-muted studio-app-rail-empty">No pages yet. Add at least one page bound to a saved content version.</p>
                    }
                    else
                    {
                        <ul class="studio-app-page-tree" data-app-page-tree="true">
                            @foreach (var appPage in editor.Pages)
                            {
                                <li @key="appPage">
                                    <button type="button"
                                            class="studio-app-page-node @(ReferenceEquals(appPage, selectedPage) ? "studio-app-page-node-selected" : string.Empty)"
                                            aria-pressed="@ReferenceEquals(appPage, selectedPage)"
                                            @onclick="() => SelectPage(appPage)">
                                        <span class="studio-app-page-icon" aria-hidden="true">@ComponentGlyph(appPage.ComponentKind)</span>
                                        <span class="studio-app-page-label">@(string.IsNullOrWhiteSpace(appPage.Title) ? appPage.Route : appPage.Title)</span>
                                        <span class="console-muted studio-app-page-route">@appPage.Route</span>
                                    </button>
                                </li>
                            }
                        </ul>
                    }

                    <div class="studio-app-palette" data-app-palette="true">
                        <h3>Components</h3>
                        <div class="console-chip-row studio-app-palette-list">
                            @foreach (var kind in StudioAppComponentKinds.All)
                            {
                                <span class="studio-app-palette-item">@kind</span>
                            }
                        </div>
                    </div>
                </aside>

                <div class="studio-app-canvas" data-app-canvas="true">
                    @if (selectedPage is { } canvasPage)
                    {
                        <div class="studio-app-frame" data-app-frame="true">
                            <div class="studio-app-frame-chrome">
                                <span class="studio-app-frame-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                                <span class="studio-app-frame-url mono">@AppUrl(editor, canvasPage)</span>
                            </div>
                            <div class="studio-app-frame-titlebar">@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled app" : editor.Title)</div>
                            <nav class="studio-app-frame-nav" aria-label="App navigation">
                                @foreach (var navItem in editor.Pages.Where(p => !string.IsNullOrWhiteSpace(p.Route)))
                                {
                                    <span class="studio-app-frame-navitem @(ReferenceEquals(navItem, canvasPage) ? "studio-app-frame-navitem-active" : string.Empty)">@(string.IsNullOrWhiteSpace(navItem.Title) ? navItem.Route : navItem.Title)</span>
                                }
                            </nav>
                            <div class="studio-app-frame-stage">
                                <span class="studio-app-frame-tag">@canvasPage.ComponentKind · selected</span>
                                @if (string.IsNullOrWhiteSpace(canvasPage.ContentBinding))
                                {
                                    <p class="console-muted">No content binding yet. Bind this @canvasPage.ComponentKind component to a saved content version in the inspector.</p>
                                }
                                else
                                {
                                    <p class="studio-app-frame-binding mono">@canvasPage.ContentBinding</p>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="console-muted">Select or add a page to preview its component on the responsive canvas.</p>
                    }
                </div>

                <aside class="studio-app-inspector" data-app-inspector="true">
                    @if (_states.Count > 0)
                    {
                        <section class="studio-inspector-section" data-app-states="true">
                            <h3>Server capability states</h3>
                            @foreach (var state in _states)
                            {
                                <article class="console-panel">
                                    <p class="console-kicker">@state.State</p>
                                    <h4>@state.Surface</h4>
                                    <p class="console-muted">@state.Detail</p>
                                    <dl class="console-definition-list">
                                        <dt>Contract</dt>
                                        <dd>@state.Contract</dd>
                                    </dl>
                                </article>
                            }
                        </section>
                    }

                    @if (selectedPage is { } inspected)
                    {
                        <section class="studio-inspector-section" data-app-page-inspector="true" @key="inspected">
                            <div class="studio-app-inspector-head">
                                <div>
                                    <h3>@(string.IsNullOrWhiteSpace(inspected.Title) ? "Page" : inspected.Title)</h3>
                                    <p class="console-muted">page component</p>
                                </div>
                                <button class="console-button console-button-secondary console-button-sm" type="button" disabled="@_busy" @onclick="() => RemovePage(inspected)">Remove page</button>
                            </div>
                            <FieldStateRow State="FieldState.Input" Label="Route" Errors="_validation.Errors(StudioAppFieldKeys.PageRoute(editor.Pages.IndexOf(inspected)))">
                                <input class="console-input" @bind="inspected.Route" @bind:after="OnEdit" placeholder="/map" />
                            </FieldStateRow>
                            <FieldStateRow State="FieldState.Input" Label="Title">
                                <input class="console-input" @bind="inspected.Title" @bind:after="OnEdit" placeholder="Map" />
                            </FieldStateRow>
                            <FieldStateRow State="FieldState.Input" Label="Component">
                                <select class="console-input" @bind="inspected.ComponentKind" @bind:after="OnEdit">
                                    @foreach (var kind in StudioAppComponentKinds.All)
                                    {
                                        <option value="@kind">@kind</option>
                                    }
                                </select>
                            </FieldStateRow>
                            <FieldStateRow State="@(string.IsNullOrWhiteSpace(inspected.ContentBinding) ? FieldState.Discovered : FieldState.Input)"
                                           Label="Content binding"
                                           Hint="@(string.IsNullOrWhiteSpace(inspected.ContentBinding) ? "resolved from catalog content" : null)"
                                           Errors="_validation.Errors(StudioAppFieldKeys.PageBinding(editor.Pages.IndexOf(inspected)))">
                                <input class="console-input" @bind="inspected.ContentBinding" @bind:after="OnEdit" placeholder="content:permits@@v3" />
                            </FieldStateRow>
                        </section>
                    }

                    <section class="studio-inspector-section" data-app-details="true">
                        <h3>App</h3>
                        <FieldStateRow State="FieldState.Input" Label="Title" Errors="_validation.Errors(StudioAppFieldKeys.Title)">
                            <input class="console-input" @bind="editor.Title" @bind:after="OnEdit" placeholder="Field operations app" />
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Summary">
                            <textarea class="console-input" rows="2" @bind="editor.Summary" @bind:after="OnEdit"></textarea>
                        </FieldStateRow>
                    </section>

                    <section class="studio-inspector-section" data-app-actions="true">
                        <div class="studio-app-inspector-head">
                            <h3>Actions &amp; permissions</h3>
                            <button class="console-button console-button-secondary console-button-sm" type="button" disabled="@_busy" @onclick="AddAction">+ Action</button>
                        </div>
                        @if (editor.Actions.Count == 0)
                        {
                            <p class="console-muted">No actions yet. Bound actions declare a permission requirement for the generated-app runtime.</p>
                        }
                        @foreach (var action in editor.Actions)
                        {
                            <fieldset class="studio-app-action" @key="action">
                                <FieldStateRow State="FieldState.Input" Label="Name">
                                    <input class="console-input" @bind="action.Name" @bind:after="OnEdit" placeholder="submit inspection" />
                                </FieldStateRow>
                                <FieldStateRow State="FieldState.Input" Label="Page route" Errors="_validation.Errors(StudioAppFieldKeys.ActionPageRoute(editor.Actions.IndexOf(action)))">
                                    <input class="console-input" @bind="action.PageRoute" @bind:after="OnEdit" placeholder="/form" />
                                </FieldStateRow>
                                <FieldStateRow State="FieldState.Admin" Label="Required permission" Hint="enforced by server RBAC" Errors="_validation.Errors(StudioAppFieldKeys.ActionPermission(editor.Actions.IndexOf(action)))">
                                    <select class="console-input" @bind="action.RequiredPermission" @bind:after="OnEdit">
                                        @foreach (var permission in StudioAppPermissions.All)
                                        {
                                            <option value="@permission">@permission</option>
                                        }
                                    </select>
                                </FieldStateRow>
                                <div class="console-action-row">
                                    <button class="console-button console-button-secondary console-button-sm" type="button" disabled="@_busy" @onclick="() => RemoveAction(action)">Remove</button>
                                </div>
                            </fieldset>
                        }
                    </section>

                    <section class="studio-inspector-section studio-app-share" data-app-share="true" aria-labelledby="app-share-heading">
                        <h3 id="app-share-heading">Share/embed policy</h3>
                        <p class="console-muted">The share visibility and embed policy must be an explicit, reviewed decision before publish.</p>
                        <label class="studio-form-label">
                            <span>Visibility</span>
                            <select class="console-input" @bind="editor.Visibility" @bind:after="OnEdit">
                                @foreach (var visibility in StudioAppVisibilityModes.All)
                                {
                                    <option value="@visibility">@visibility</option>
                                }
                            </select>
                        </label>
                        <ValidationMessageInline FieldKey="@StudioAppFieldKeys.Visibility" State="_validation" />
                        <div class="console-chip-row studio-form-toggles">
                            <label><input type="checkbox" @bind="editor.EmbedEnabled" @bind:after="OnEdit" /> <span>Embeddable</span></label>
                        </div>
                        <label class="studio-form-review">
                            <input type="checkbox" @bind="editor.ShareEmbedPolicyReviewed" @bind:after="OnEdit" />
                            <span>I reviewed the share/embed policy for this app (required before publish).</span>
                        </label>
                    </section>

                    @if (!readiness.CanPublish)
                    {
                        <section class="studio-inspector-section studio-app-gate" data-app-gate="true" aria-labelledby="app-publish-readiness-heading">
                            <h3 id="app-publish-readiness-heading">Resolve before publish</h3>
                            <ul class="studio-compact-list">
                                @foreach (var requirement in readiness.UnmetRequirements)
                                {
                                    <li>@requirement</li>
                                }
                            </ul>
                        </section>
                    }

                    @if (_serverValidation is { } validation)
                    {
                        <section class="studio-inspector-section" data-app-validation="true" aria-labelledby="app-validation-heading">
                            <div class="studio-app-inspector-head">
                                <h3 id="app-validation-heading">@(validation.IsValid ? "Validation · valid" : "Validation · issues reported")</h3>
                                <span class="console-status @(validation.IsValid ? string.Empty : "console-status-danger")">@(validation.IsValid ? "valid" : $"{validation.Issues.Count} issue(s)")</span>
                            </div>
                            @if (validation.Issues.Count > 0)
                            {
                                <ul class="studio-compact-list">
                                    @foreach (var issue in validation.Issues)
                                    {
                                        <li><strong>@issue.Severity</strong> @issue.Message @(string.IsNullOrWhiteSpace(issue.Path) ? string.Empty : $"({issue.Path})")</li>
                                    }
                                </ul>
                            }
                        </section>
                    }

                    @if (editor.ItemId is { } itemId)
                    {
                        <section class="studio-inspector-section studio-app-history" data-app-history="true" aria-labelledby="app-history-heading">
                            <div class="studio-app-inspector-head">
                                <h3 id="app-history-heading">Version history</h3>
                                <button class="console-button console-button-secondary console-button-sm" type="button" disabled="@_busy" @onclick="RefreshHistory">Refresh</button>
                            </div>
                            <p class="console-muted">Reopening a published version starts a new editable draft; saving it creates a new content version rather than mutating the published app. Rollback repoints the published app to an earlier version.</p>

                            @if (_history?.Issue is { } historyIssue)
                            {
                                <p class="console-warning">@historyIssue.Detail</p>
                            }
                            else if (_history is { HasVersions: false })
                            {
                                <p class="console-muted">No content versions yet. Publish to create the first immutable version.</p>
                            }
                            else if (_history is { } history)
                            {
                                <ul class="studio-compact-list">
                                    @foreach (var version in history.Versions)
                                    {
                                        <li @key="version.VersionId">
                                            <strong>v@version.VersionNumber</strong>
                                            @(version.IsPublished ? " (published)" : string.Empty)
                                            @(string.IsNullOrWhiteSpace(version.ChangeNote) ? string.Empty : $" — {version.ChangeNote}")
                                            <button class="console-button console-button-secondary console-button-sm" type="button" disabled="@_busy" @onclick="() => Reopen(itemId, version.VersionId)">Reopen as draft</button>
                                            @if (!version.IsPublished)
                                            {
                                                <button class="console-button console-button-secondary console-button-sm" type="button" disabled="@_busy" @onclick="() => Rollback(itemId, version.VersionId)">Roll back to this</button>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </section>
                    }
                </aside>
            </div>
        </div>
        }
    }
</section>

@code {
    private enum EditorView
    {
        FromPrompt,
        Editor,
    }

    private bool _loading = true;
    private bool _busy;
    private StudioAppEditorState? _editor;
    private StudioAppPageState? _selectedPage;
    private StudioAppCapabilityState? _bindingState;
    private IReadOnlyList<StudioAppCapabilityState> _states = [];
    private StudioAppValidationView? _serverValidation;
    private StudioAppVersionHistory? _history;
    private string? _status;
    private bool _statusFailed;
    private readonly ValidationState _validation = new();
    private readonly FormDirtyState _dirty = new();

    private EditorView _view = EditorView.Editor;
    private bool _cameFromPrompt;
    private readonly List<StudioConversationTurn> _turns = [];
    private readonly List<StudioConversationClarification> _clarifications = [];

    private static readonly JsonSerializerOptions PackageJsonOptions = new() { WriteIndented = true };

    private static string PackageJson(StudioAppEditorState editor) =>
        JsonSerializer.Serialize(StudioAppPackageMapper.BuildEnvelopeBody(editor), PackageJsonOptions);

    /// <summary>
    /// Re-runs the client cross-field/referential validator over the current editor and flags it dirty.
    /// Wired to every bound edit via <c>@bind:after</c>. The server channel is dropped on edit because any
    /// change makes the last validate/publish-time server findings stale; the next call rebinds fresh ones.
    /// </summary>
    private void OnEdit()
    {
        _dirty.MarkDirty();
        RecomputeClientErrors();
        _validation.SetServerErrors(Array.Empty<ConsoleFieldError>());
    }

    private void RecomputeClientErrors() =>
        _validation.SetClientErrors(_editor is null
            ? Array.Empty<ConsoleFieldError>()
            : StudioAppValidator.Instance.Evaluate(_editor));

    private StudioAppPageState? SelectedPage
    {
        get
        {
            if (_editor is null || _editor.Pages.Count == 0)
            {
                return null;
            }

            if (_selectedPage is not null && _editor.Pages.Contains(_selectedPage))
            {
                return _selectedPage;
            }

            _selectedPage = _editor.Pages[0];
            return _selectedPage;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var load = await AppData.LoadAsync(null);
        ApplyStates(load.CapabilityStates);
        _editor = load.State;
        _selectedPage = _editor?.Pages.FirstOrDefault();
        _loading = false;

        // A fresh load is the clean baseline.
        _validation.Clear();
        _dirty.MarkClean();
        RecomputeClientErrors();

        if (_editor?.ItemId is { } itemId)
        {
            await LoadHistoryAsync(itemId);
        }
    }

    private void SelectPage(StudioAppPageState page) => _selectedPage = page;

    private static string ComponentGlyph(string kind) => kind switch
    {
        "map" => "◐",
        "dashboard" => "▦",
        "form" => "☱",
        "report" => "⊟",
        "table" => "▤",
        _ => "❒"
    };

    private static string AppUrl(StudioAppEditorState editor, StudioAppPageState page)
    {
        var slug = string.IsNullOrWhiteSpace(editor.Title) ? "app" : editor.Title.Trim().ToLowerInvariant().Replace(' ', '-');
        var route = string.IsNullOrWhiteSpace(page.Route) ? "/" : page.Route;
        return $"honua.example/a/{slug}{route}";
    }

    // Save/Publish persist the in-memory edits as a new server version; Reopen/Rollback replace the editor
    // with a fresh clean server version. All four make the local edits durable, so they clear the dirty
    // flag. Validate/Preview only operate on the existing server draft and do NOT persist the current edits,
    // so they must leave the draft dirty (the unsaved-changes guard must still warn).
    private Task Save() => RunCommandAsync(() => AppData.SaveDraftAsync(_editor!), reloadHistory: true, clearsDirty: true);

    private Task Validate() => RunCommandAsync(() => AppData.ValidateAsync(_editor!));

    private Task Preview() => RunCommandAsync(() => AppData.PreviewAsync(_editor!));

    private Task Publish() => RunCommandAsync(() => AppData.PublishAsync(_editor!), reloadHistory: true, clearsDirty: true);

    private Task Reopen(Guid itemId, Guid versionId) =>
        RunCommandAsync(() => AppData.ReopenAsync(itemId, versionId), reloadHistory: true, clearsDirty: true);

    private Task Rollback(Guid itemId, Guid versionId) =>
        RunCommandAsync(() => AppData.RollbackAsync(itemId, versionId, reason: null), reloadHistory: true, clearsDirty: true);

    private async Task RefreshHistory()
    {
        if (_editor?.ItemId is { } itemId)
        {
            await LoadHistoryAsync(itemId);
        }
    }

    private async Task LoadHistoryAsync(Guid itemId)
    {
        _history = await AppData.LoadVersionHistoryAsync(itemId);
        StateHasChanged();
    }

    private void AddPage()
    {
        if (_editor is null)
        {
            return;
        }

        var page = new StudioAppPageState();
        _editor.Pages.Add(page);
        _selectedPage = page;
        OnEdit();
    }

    private void RemovePage(StudioAppPageState page)
    {
        if (_editor is null)
        {
            return;
        }

        _editor.Pages.Remove(page);
        if (ReferenceEquals(_selectedPage, page))
        {
            _selectedPage = _editor.Pages.FirstOrDefault();
        }

        OnEdit();
    }

    private void AddAction()
    {
        _editor?.Actions.Add(new StudioAppActionState());
        OnEdit();
    }

    private void RemoveAction(StudioAppActionState action)
    {
        _editor?.Actions.Remove(action);
        OnEdit();
    }

    // ---- From-prompt (AI app generation) ------------------------------------------------------------

    private void NewFromPrompt()
    {
        _view = EditorView.FromPrompt;
        _cameFromPrompt = true;
        ResetConversation();
    }

    private void OpenEditorFromPrompt()
    {
        _view = EditorView.Editor;
        _cameFromPrompt = true;
    }

    private void BackToChat() => _view = EditorView.FromPrompt;

    private void ResetConversation()
    {
        _turns.Clear();
        _clarifications.Clear();

        // The conversation log is Console-local authoring UX — it echoes the author's intent and Honua's
        // guidance, never fabricated package state. The right-side inspector reflects the real
        // StudioAppEditorState. Until the author describes the app there are no turns and no clarifications.
        _turns.Add(new StudioConversationTurn(
            StudioConversationRole.Honua,
            "Describe the app you want — the pages, what each binds to, and the actions and permissions it needs — and I'll propose an app you can review and refine. Every proposal is grounded in the real catalog and validated on the server before it appears; nothing is fabricated.",
            "just now",
            StudioConversationTone.Neutral));
    }

    // A prompt/refine turn calls the server's natural-language app generation contract
    // (POST /api/v1/studio/app-packages/generate). The server grounds the proposal and validates it before
    // returning, so the page only ever renders a server-produced app (status==generated, the editor hydrates
    // from the returned studio-app/v1 body), a structured clarification request, or an honest
    // unavailable/refused/blocked state — never a fabricated app (no-mock, Charter §11).
    private Task OnPromptSend(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt))
        {
            return Task.CompletedTask;
        }

        _turns.Add(new StudioConversationTurn(StudioConversationRole.You, prompt, "just now"));
        return GenerateAsync(new StudioAppGenerationRequest
        {
            Prompt = prompt,
            Conversation = SnapshotConversation()
        });
    }

    private Task OnClarificationAnswered((StudioConversationClarification Question, StudioConversationChoice Choice) answer)
    {
        _clarifications.RemoveAll(question => string.Equals(question.Id, answer.Question.Id, StringComparison.Ordinal));
        _turns.Add(new StudioConversationTurn(
            StudioConversationRole.You,
            $"{answer.Question.Label}: {answer.Choice.Label}",
            "just now"));

        return GenerateAsync(new StudioAppGenerationRequest
        {
            Prompt = string.Empty,
            Conversation = SnapshotConversation(),
            Answers = [new StudioAppGenerationAnswer(answer.Question.Id, answer.Choice.Id)]
        });
    }

    // The conversation context sent to the server is the turn log mapped to the server's user/assistant roles.
    private IReadOnlyList<StudioAppGenerationTurn> SnapshotConversation() =>
        _turns
            .Select(turn => new StudioAppGenerationTurn(
                turn.Role == StudioConversationRole.You ? "user" : "assistant",
                turn.Body))
            .ToArray();

    private async Task GenerateAsync(StudioAppGenerationRequest request)
    {
        if (_editor is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var outcome = await AppData.GenerateAsync(_editor, request);

            if (outcome.BindingState is not null)
            {
                // A missing binding blocks the whole surface; other capability issues surface as a chat note.
                if (string.Equals(outcome.BindingState.State, "Missing binding", StringComparison.OrdinalIgnoreCase))
                {
                    _bindingState = outcome.BindingState;
                    return;
                }

                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    $"{outcome.BindingState.Detail} (contract: {outcome.BindingState.Contract})",
                    "just now",
                    StudioConversationTone.Neutral));
                return;
            }

            var notes = outcome.Warnings.ToList();
            if (outcome.CapabilityState is { } capability
                && !string.Equals(capability.State, "supported", StringComparison.OrdinalIgnoreCase))
            {
                notes.Insert(0, $"{capability.Name}: {capability.State}{(string.IsNullOrWhiteSpace(capability.Reason) ? string.Empty : $" — {capability.Reason}")}");
            }

            if (outcome.IsGenerated)
            {
                if (outcome.State is not null)
                {
                    _editor = outcome.State;
                    _selectedPage = _editor.Pages.FirstOrDefault();
                }

                _clarifications.Clear();
                // A generated proposal is unsaved authoring intent — mark dirty so the unsaved-changes guard
                // warns and Save persists it (the guard arms a beforeunload JS call; bUnit needs Loose mode).
                _dirty.MarkDirty();
                RecomputeClientErrors();
                _validation.SetServerErrors(Array.Empty<ConsoleFieldError>());

                var summary = string.IsNullOrWhiteSpace(outcome.Rationale)
                    ? $"Proposed an app · {_editor.Pages.Count} page(s), {_editor.Actions.Count} action(s). Refine by chatting, or open the editor."
                    : outcome.Rationale;
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(summary, notes),
                    "just now",
                    StudioConversationTone.Ready,
                    "view evidence"));
            }
            else if (outcome.NeedsClarification)
            {
                _clarifications.Clear();
                _clarifications.AddRange(outcome.Clarifications);
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(
                        string.IsNullOrWhiteSpace(outcome.Rationale)
                            ? "I need a little more detail before I can propose the app."
                            : outcome.Rationale,
                        notes),
                    "just now",
                    StudioConversationTone.Clarification));
            }
            else
            {
                // unsupported / refused / error
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(
                        string.IsNullOrWhiteSpace(outcome.Rationale)
                            ? "I couldn't turn that into an app."
                            : outcome.Rationale,
                        notes),
                    "just now",
                    StudioConversationTone.Neutral));
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string AppendNotes(string body, IReadOnlyList<string> notes) =>
        notes.Count == 0 ? body : $"{body}\n\nNotes:\n- {string.Join("\n- ", notes)}";

    private async Task RunCommandAsync(Func<Task<StudioAppCommandResult>> command, bool reloadHistory = false, bool clearsDirty = false)
    {
        if (_busy || _editor is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await command();
            _status = result.Message;
            _statusFailed = !result.Succeeded;
            _serverValidation = result.Validation ?? _serverValidation;

            if (result.State is not null)
            {
                _editor = result.State;
                _selectedPage = _editor.Pages.FirstOrDefault();
            }

            // Re-run the client validator against the current editor and bind any field-addressable server
            // diagnostics (the app.package validate items) onto the same field keys so they surface inline
            // next to the offending input, merged with the client findings.
            RecomputeClientErrors();
            _validation.SetServerErrors(StudioAppServerErrorBinder.Map(result.Validation?.Issues));

            // Only a command that persisted/replaced the editor state clears the dirty flag; Validate/Preview
            // leave unsaved edits dirty so the guard still warns on navigation.
            if (result.Succeeded && clearsDirty)
            {
                _dirty.MarkClean();
            }

            ApplyStates(result.Issue is null ? [] : [result.Issue]);

            if (reloadHistory && result.Succeeded && _editor?.ItemId is { } itemId)
            {
                _history = await AppData.LoadVersionHistoryAsync(itemId);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyStates(IReadOnlyList<StudioAppCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
        _states = states
            .Where(state => !ReferenceEquals(state, _bindingState))
            .ToArray();
    }
}
