@page "/operate/connections/{ConnectionId}"
@page "/operate/connections/{ConnectionId}/diagnostics"
@using Honua.Console.Shell.Models
@inject IOperateTransitionDataSource OperateData
@inject IConsoleConnectionCreateOperation ConnectionOps
@inject IServiceProvider Services
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page" data-connection-id="@ConnectionId" data-connection-loaded="@(_connection is not null)">
    @if (_connection is null)
    {
        <MissingItemView Kind="connection" AreaLabel="Operate / Connections" />
    }
    else
    {
        @if (V4Enabled)
        {
            <ConsolePageHeading Title="@_connection.Name">
                <ChildContent><p>@_connection.Provider connection for @_connection.Target.</p></ChildContent>
                <Actions>@TestAction</Actions>
            </ConsolePageHeading>
        }
        else
        {
            <div class="console-page-heading">
                <p class="console-kicker">Operate / Connections</p>
                <h1>@_connection.Name</h1>
                <p>@_connection.Provider connection for @_connection.Target.</p>
            </div>
            <div class="console-action-row">@TestAction</div>
        }

        @if (_testOutcome is { } test)
        {
            <article class="console-panel @(test.Tested && test.IsHealthy ? "console-state-success" : "console-state-warning")" role="status">
                <p class="console-kicker">@test.State</p>
                <h2>@(test.Tested && test.IsHealthy ? "Connection test passed" : "Connection test")</h2>
                <p>@test.Detail</p>
            </article>
        }

        <div class="console-panel-grid">
            @if (V4Enabled)
            {
                <ConsolePanel Title="Overview" HeadingId="connection-overview">
                    <Actions><span class="@StatusClass(_connection.Status)">@_connection.Status</span></Actions>
                    <ChildContent>@Overview</ChildContent>
                </ConsolePanel>
                <ConsolePanel Title="Diagnostics" HeadingId="connection-diagnostics">@Diagnostics</ConsolePanel>
            }
            else
            {
                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div><p class="console-kicker">Connection</p><h2>Overview</h2></div>
                        <span class="@StatusClass(_connection.Status)">@_connection.Status</span>
                    </div>
                    @Overview
                </article>
                <article class="console-panel">
                    <p class="console-kicker">Diagnostics</p>
                    @Diagnostics
                </article>
            }
        </div>

        @if (_safeDiagnostic is not null)
        {
            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Structured Checks</p>
                    <h2>Test Breakdown</h2>
                </div>
                <ConsoleTableRegion Class="console-table-wrap" Label="Connection test checks">
                    <table class="console-table">
                        <thead>
                            <tr>
                                <th>Check</th>
                                <th>Severity</th>
                                <th>Message</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var signal in _safeDiagnostic.Signals)
                            {
                                <tr>
                                    <td>@signal.Check</td>
                                    <td><span class="@StatusClass(signal.Severity)">@signal.Severity</span></td>
                                    <td>@signal.Message</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </ConsoleTableRegion>
            </section>

            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Next Steps</p>
                    <h2>Operator Actions</h2>
                </div>
                <ol class="console-action-list">
                    @foreach (var action in _safeDiagnostic.OperatorActions)
                    {
                        <li>@action</li>
                    }
                </ol>
            </section>
        }
    }

    <OperateCapabilityStateList States="@_states" />
</section>

@code {
    private bool V4Enabled => Services.GetService<ConsoleV4Options>()?.Enabled == true;
    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = ConsoleAgentRoutes.ForEntity(ConsoleAgentEntity.ForConnection(_connection?.Id ?? ConnectionId)) + (new Uri(Navigation.Uri).AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries).Length == 4 ? "/diagnostics" : string.Empty),
        Entities = _connection is { } connection ? [ConsoleAgentEntity.ForConnection(connection.Id)] : [],
        Unsaved = new() { PendingOperationCount = (_loading ? 1 : 0) + (_testing ? 1 : 0) }
    };
    private RenderFragment TestAction => @<button class="console-button console-button-secondary" type="button" disabled="@_testing" @onclick="TestConnectionAsync">
        @(_testing ? "Testing…" : "Test connection")
    </button>;
    private RenderFragment Overview => @<text>
                <dl class="console-definition-list">
                    <dt>Provider</dt>
                    <dd>@_connection!.Provider</dd>
                    <dt>Target</dt>
                    <dd>@_connection!.Target</dd>
                    <dt>Principal</dt>
                    <dd>@_connection!.Principal</dd>
                    <dt>Last tested</dt>
                    <dd>@_connection!.LastTested</dd>
                </dl>
    </text>;
    private RenderFragment Diagnostics => @<text>
                @if (_safeDiagnostic is null)
                {
                    @if (V4Enabled) { <h3>No Active Diagnostic</h3> } else { <h2>No Active Diagnostic</h2> }
                    <p class="console-muted">The latest connection test passed without an operator action.</p>
                }
                else
                {
                    @if (V4Enabled) { <h3>@_safeDiagnostic.FailureCode</h3> } else { <h2>@_safeDiagnostic.FailureCode</h2> }
                    <p class="console-muted">@_safeDiagnostic.Summary</p>
                    <dl class="console-definition-list">
                        <dt>Outcome</dt>
                        <dd>@_safeDiagnostic.Outcome</dd>
                        @foreach (var evidence in _safeDiagnostic.Evidence)
                        {
                            <dt>@evidence.Key</dt>
                            <dd>@evidence.Value</dd>
                        }
                    </dl>
                }
    </text>;
    private bool _loading = true;

    [Parameter]
    public string ConnectionId { get; set; } = string.Empty;

    private OperateConnectionSummary? _connection;
    private OperateConnectionDiagnostic? _safeDiagnostic;
    private IReadOnlyList<OperateCapabilityState> _states = Array.Empty<OperateCapabilityState>();
    private ConsoleConnectionTestOutcome? _testOutcome;
    private bool _testing;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var view = await OperateData.GetConnectionsViewAsync();
            _connection = view.Connections.FirstOrDefault(
                connection => string.Equals(connection.Id, ConnectionId, StringComparison.OrdinalIgnoreCase));
            _safeDiagnostic = _connection?.LastDiagnostic;
            _states = OperateCapabilityStateFilters.ForSurface(view.CapabilityStates, "Connections");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        _testing = true;
        try
        {
            // The server-side test persists the connection's health, so reload afterwards to refresh the
            // status badge, last-tested time, and diagnostic from the canonical server read.
            _testOutcome = await ConnectionOps.TestExistingAsync(ConnectionId);
            await LoadAsync();
        }
        finally
        {
            _testing = false;
        }
    }

    private static string StatusClass(string status) =>
        string.Equals(status, "Failed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Error", StringComparison.OrdinalIgnoreCase)
            ? "console-status console-status-danger"
            : string.Equals(status, "Warning", StringComparison.OrdinalIgnoreCase)
                ? "console-status console-status-warning"
                : "console-status";
}
