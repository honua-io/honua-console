@page "/operate/alerts/rules/{RuleId}"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Services
@inject IOperateAlertRulesDataSource RulesData
@inject IConsoleCapabilityManifest Capabilities
@inject IConsoleNotificationService Notifications

<ConsoleCapabilityGate Capability="@ConsoleCapabilityKeys.RealtimeAlerting"
                       Title="Realtime / geofence alerting is not available in this release"
                       Message="Realtime, geofence, threshold, and dwell alert-rule authoring is a capability-gated depth feature. It is not advertised by the connected environment for this release and lights up here once enabled for your account.">
<section class="console-page operate-alert-rule" data-alert-rule-detail="@RuleId">
    <div class="console-page-heading">
        <p class="console-kicker">Operator workflow / Alert rules</p>
        <h1>Alert rule</h1>
        <p><a href="@OperateAlertRulesRoutes.List">Back to alert rules</a></p>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Alert rule"
                          Title="Loading rule"
                          Message="Reading the server-owned alert rule definition from honua-server." />
    }
    else if (_view.BindingState is { } binding)
    {
        <ConsoleStateView Kind="@StateKind(binding.State)"
                          Kicker="@binding.State"
                          Title="Alert rule editor is not bound"
                          Message="@(binding.Detail + " (contract: " + binding.Contract + ")")" />
    }
    else if (_rule is null)
    {
        <MissingItemView Kind="alert rule" AreaLabel="Operate / Alert rules" />
    }
    else
    {
        <article class="console-panel">
            <div class="console-panel-heading">
                <div>
                    <p class="console-kicker">@_rule.RuleType</p>
                    <h2>@_rule.Name</h2>
                </div>
                <span class="console-status @StatusClass(_rule)">@_rule.Status.State</span>
            </div>
            <p class="console-muted">@_rule.Description</p>
            <dl class="console-definition-list">
                <dt>Rule ID</dt>
                <dd class="console-mono">@_rule.RuleId</dd>
                <dt>Last evaluated</dt>
                <dd>@_rule.LastEvaluatedAt</dd>
                <dt>Active incidents</dt>
                <dd>@_rule.ActiveIncidentCount</dd>
                <dt>Delivery failures</dt>
                <dd>@_rule.DeliveryFailureCount</dd>
            </dl>
            @if (_rule.ValidationMessages.Count > 0)
            {
                <ul class="console-state-warning">
                    @foreach (var message in _rule.ValidationMessages)
                    {
                        <li>@message</li>
                    }
                </ul>
            }
        </article>

        <article class="console-panel" data-alert-rule-editor>
            <p class="console-kicker">Condition</p>
            <h2>Condition builder</h2>
            <div class="studio-field-grid">
                <label>
                    <span>Name</span>
                    <input class="console-input" @bind="_name" data-rule-name />
                </label>
                <label>
                    <span>Subject</span>
                    <input class="console-input" @bind="_subject" data-rule-subject placeholder="metric, layer, or geofence subject" />
                </label>
                <label>
                    <span>Operator</span>
                    <input class="console-input" @bind="_operator" data-rule-operator placeholder="gte, lte, enters, dwells" />
                </label>
                <label>
                    <span>Threshold</span>
                    <input class="console-input" @bind="_threshold" data-rule-threshold />
                </label>
                <label>
                    <span>Window</span>
                    <input class="console-input" @bind="_window" data-rule-window placeholder="5m, 1h" />
                </label>
                <label>
                    <span>Geofence zone (geofence/dwell)</span>
                    <input class="console-input" @bind="_geofenceZoneId" data-rule-zone />
                </label>
                <label>
                    <span>Dwell minutes (dwell)</span>
                    <input class="console-input" type="number" @bind="_dwellMinutes" data-rule-dwell />
                </label>
                <label>
                    <span>Delivery channels (comma separated)</span>
                    <input class="console-input" @bind="_deliveryChannels" data-rule-channels />
                </label>
            </div>

            <div class="console-action-row">
                <button class="console-button" type="button" disabled="@_saving" @onclick="SaveAsync" data-rule-save>
                    @(_saving ? "Saving..." : "Save rule")
                </button>
                <button class="console-button-secondary" type="button" disabled="@_testing" @onclick="TestAsync" data-rule-test>
                    @(_testing ? "Testing..." : "Test rule")
                </button>
                <button class="console-button-secondary" type="button"
                        disabled="@(_enabling || (!_rule.Enabled && !_explicitTestPassed))"
                        @onclick="ToggleEnabledAsync" data-rule-enable>
                    @(_enabling ? "Updating..." : _rule.Enabled ? "Disable rule" : "Enable tested rule")
                </button>
            </div>

            @if (_testResult is { } test)
            {
                <div class="console-panel @(test.Succeeded ? "console-state-success" : "console-state-warning")" role="status" data-rule-test-result>
                    <p class="console-kicker">Non-production test</p>
                    <p>@(test.Succeeded ? "Draft validation passed. No event was emitted and the rule remains disabled." : "Draft validation failed. The rule was not enabled.")</p>
                    @foreach (var error in test.Errors) { <p>@error</p> }
                    @foreach (var warning in test.Warnings) { <p>@warning</p> }
                </div>
            }

            @if (_saveResult is { } result)
            {
                @if (result.BindingState is { } saveBinding)
                {
                    <ConsoleStateView Kind="@StateKind(saveBinding.State)"
                                      Kicker="@saveBinding.State"
                                      Title="Rule save is not bound"
                                      Message="@(saveBinding.Detail + " (contract: " + saveBinding.Contract + ")")" />
                }
                else if (result.Succeeded)
                {
                    <div class="console-panel console-state-success" role="status" data-rule-saved>
                        <p class="console-kicker">Saved</p>
                        <p>The alert rule was saved on honua-server.</p>
                    </div>
                }
            }
        </article>
    }
</section>
</ConsoleCapabilityGate>

@code {
    [Parameter]
    public string RuleId { get; set; } = string.Empty;

    private bool _loading = true;
    private OperateAlertRuleDetailView _view = new(Rule: null);
    private OperateAlertRuleDefinition? _rule;

    private bool _saving;
    private bool _testing;
    private bool _enabling;
    private bool _explicitTestPassed;
    private OperateAlertRuleSaveResult? _saveResult;
    private OperateAlertRuleTestResult? _testResult;

    private bool _enabled;
    private string _name = string.Empty;
    private string _subject = string.Empty;
    private string _operator = string.Empty;
    private string _threshold = string.Empty;
    private string _window = string.Empty;
    private string _geofenceZoneId = string.Empty;
    private int? _dwellMinutes;
    private string _deliveryChannels = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        // Capability-manifest gate: when realtime/geofence alerting is not advertised for this release
        // the page renders the first-class "unsupported" state, so skip the server read entirely.
        if (!Capabilities.IsAdvertised(ConsoleCapabilityKeys.RealtimeAlerting))
        {
            _loading = false;
            return;
        }

        _loading = true;
        _saveResult = null;
        _view = await RulesData.GetRuleAsync(RuleId);
        _rule = _view.Rule;
        if (_rule is not null)
        {
            _enabled = _rule.Enabled;
            _name = _rule.Name;
            _subject = _rule.Condition.Subject;
            _operator = _rule.Condition.Operator;
            _threshold = _rule.Condition.Threshold;
            _window = _rule.Condition.Window;
            _geofenceZoneId = _rule.Condition.GeofenceZoneId ?? string.Empty;
            _dwellMinutes = _rule.Condition.DwellMinutes;
            _deliveryChannels = string.Join(", ", _rule.DeliveryChannels);
        }

        _loading = false;
    }

    private Task SaveAsync()
    {
        _saveResult = null;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                var channels = _deliveryChannels
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                var condition = new OperateAlertRuleCondition(
                    _subject, _operator, _threshold, _window,
                    string.IsNullOrWhiteSpace(_geofenceZoneId) ? null : _geofenceZoneId,
                    _dwellMinutes);
                var edit = new OperateAlertRuleEdit(RuleId, _name, _enabled, condition, channels);
                _saveResult = await RulesData.SaveRuleAsync(edit);
                _explicitTestPassed = false;
                if (_saveResult.Succeeded)
                {
                    _rule = _saveResult.Rule;
                }
            },
            setBusy: busy => { _saving = busy; StateHasChanged(); },
            failureMessage: "Couldn't save alert rule");
    }

    private OperateAlertRuleEdit CurrentEdit() => new(
        RuleId, _name, _rule?.Enabled ?? false,
        new OperateAlertRuleCondition(_subject, _operator, _threshold, _window,
            string.IsNullOrWhiteSpace(_geofenceZoneId) ? null : _geofenceZoneId, _dwellMinutes),
        _deliveryChannels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    private Task TestAsync() => Notifications.RunGuardedAsync(async () =>
    {
        _testResult = await RulesData.TestRuleAsync(CurrentEdit());
        _explicitTestPassed = _testResult.Succeeded;
    }, busy => { _testing = busy; StateHasChanged(); }, "Couldn't test alert rule");

    private Task ToggleEnabledAsync() => Notifications.RunGuardedAsync(async () =>
    {
        var result = await RulesData.SetRuleEnabledAsync(RuleId, !_rule!.Enabled);
        _saveResult = result;
        if (result.Succeeded)
        {
            _rule = result.Rule;
            _enabled = _rule!.Enabled;
            _explicitTestPassed = false;
        }
    }, busy => { _enabling = busy; StateHasChanged(); }, "Couldn't update alert rule state");

    private static string StateKind(string state) => state switch
    {
        OperateAlertRulesBindingState.Forbidden => "forbidden",
        OperateAlertRulesBindingState.Unsupported => "unsupported",
        _ => "missing"
    };

    private static string StatusClass(OperateAlertRuleDefinition rule) =>
        rule.Enabled ? "console-status console-state-success" : "console-status console-state-neutral";
}
