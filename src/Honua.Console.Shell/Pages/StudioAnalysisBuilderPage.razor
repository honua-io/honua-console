@page "/studio/analysis"
@using Honua.Console.Shell.Validation
@inject IStudioAnalysisPackageDataSource AnalysisData

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have unsaved analysis changes. Leave this page and discard them?" />

<section class="console-page studio-analysis-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>Analysis builder</h1>
        <p>Author a server-owned spatial analysis plan — method, inputs, parameters, output schema, and compute profile — then review the runtime/cost estimate and DAG/pipeline view before previewing or submitting a job to honua-server. The result artifact can become a content item, layer, report/dashboard input, or workflow input.</p>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Analysis builder"
                          Title="Loading analysis packages"
                          Message="Reading the analysis content lifecycle from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Analysis content lifecycle is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else
    {
        @if (_states.Count > 0)
        {
            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Analysis binding</p>
                    <h2>Server Capability States</h2>
                </div>
                <div class="console-panel-grid">
                    @foreach (var state in _states)
                    {
                        <article class="console-panel" data-analysis-capability="@state.Contract">
                            <div class="console-panel-heading">
                                <div>
                                    <p class="console-kicker">@state.State</p>
                                    <h2>@state.Surface</h2>
                                </div>
                            </div>
                            <p class="console-muted">@state.Detail</p>
                            <dl class="console-definition-list">
                                <dt>Contract</dt>
                                <dd>@state.Contract</dd>
                            </dl>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_plan is null)
        {
            <div class="console-toolbar">
                <button class="console-button" type="button" disabled="@_busy" @onclick="NewPlan">New analysis</button>
            </div>

            @if (_workspace.Plans.Count == 0)
            {
                <EmptyState Area="studio" Subject="analysis packages" />
            }
            else
            {
                <div class="console-table-wrap">
                    <table class="console-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Method</th>
                                <th>Compute</th>
                                <th>Draft</th>
                                <th>Published</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var plan in _workspace.Plans)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="console-button console-button-secondary" disabled="@_busy" @onclick="() => OpenPlan(plan.AnalysisId)">@plan.Title</button>
                                        <small>@plan.AnalysisId</small>
                                    </td>
                                    <td>@plan.Method</td>
                                    <td>@plan.ComputeProfile</td>
                                    <td>@(plan.DraftVersion?.ToString() ?? "—")</td>
                                    <td>@(plan.PublishedVersion?.ToString() ?? "—")</td>
                                    <td>@plan.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            var plan = _plan;
            var readiness = StudioAnalysisPlanEvaluator.Evaluate(plan);
            var pipeline = StudioAnalysisPlanEvaluator.BuildPipeline(plan);

            <div class="studio-analysis-editor" data-analysis-builder="analysis.package" data-analysis-status="@plan.Status">
                <header class="studio-analysis-editor-bar">
                    <span class="studio-analysis-editor-glyph" aria-hidden="true">∑</span>
                    <div class="studio-analysis-editor-identity">
                        <p class="console-kicker">@(plan.IsExistingPackage ? $"{plan.AnalysisId} · v{plan.Version}" : "New draft")</p>
                        <h2>@(string.IsNullOrWhiteSpace(plan.Title) ? "Untitled analysis" : plan.Title)</h2>
                    </div>
                    <span class="console-status @(plan.IsPublished ? string.Empty : "console-status-warning")">@plan.Status</span>
                    <span class="console-muted studio-analysis-editor-meta" data-analysis-step-count="@pipeline.Count">@pipeline.Count @(pipeline.Count == 1 ? "step" : "steps")</span>
                    <div class="studio-analysis-editor-bar-spacer"></div>
                    <div class="console-action-row studio-analysis-editor-actions">
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToList">Back to analyses</button>
                        <button class="console-button" type="button" disabled="@(_busy || plan.IsPublished || _validation.HasBlockingClientErrors)" @onclick="Save">Save draft</button>
                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || !plan.IsExistingPackage || plan.IsPublished)" @onclick="Estimate">Estimate</button>
                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || !plan.IsExistingPackage || plan.IsPublished)" @onclick="Preview">Preview job</button>
                        <button class="console-button" type="button" disabled="@(_busy || !readiness.CanSubmit || _validation.HasBlockingClientErrors)" @onclick="Submit">Submit job</button>
                    </div>
                </header>

                @if (!string.IsNullOrEmpty(_status))
                {
                    <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
                }

                @if (_validation.HasBlockingClientErrors)
                {
                    <div class="console-warning studio-analysis-validation-summary" role="alert" data-analysis-validation="blocking">
                        <p>Resolve these before saving or submitting:</p>
                        <ul class="studio-compact-list">
                            @foreach (var error in _validation.Summary.Where(e => e.IsBlocking))
                            {
                                <li>@error.Message</li>
                            }
                        </ul>
                    </div>
                }

                <div class="studio-analysis-editor-body">
                    <aside class="studio-analysis-steps" aria-label="Pipeline steps">
                        <p class="console-kicker">Steps</p>
                        <ol class="studio-analysis-step-list" data-analysis-step-list="true">
                            @{
                                var stepIndex = 0;
                            }
                            @foreach (var node in pipeline)
                            {
                                stepIndex++;
                                <li class="studio-analysis-step" @key="node">
                                    <span class="studio-analysis-step-index" aria-hidden="true">@stepIndex</span>
                                    <span class="studio-analysis-step-body">
                                        <span class="studio-analysis-step-name">@node.Label</span>
                                        <span class="console-muted studio-analysis-step-method">@node.Method</span>
                                    </span>
                                </li>
                            }
                        </ol>
                    </aside>

                    <div class="studio-analysis-canvas">
                        <article class="console-panel studio-analysis-pipeline" aria-labelledby="analysis-pipeline-heading">
                            <p class="console-kicker">DAG / pipeline</p>
                            <h3 id="analysis-pipeline-heading">Pipeline view</h3>
                            <p class="console-muted">The execution plan honua-server runs. Load nodes feed the analysis method node.</p>
                            <div class="studio-analysis-pipeline-flow" data-analysis-pipeline="true" role="list">
                                @{
                                    var flowFirst = true;
                                }
                                @foreach (var node in pipeline)
                                {
                                    @if (!flowFirst)
                                    {
                                        <span class="studio-analysis-pipeline-edge" aria-hidden="true">→</span>
                                    }
                                    flowFirst = false;
                                    <div class="studio-analysis-pipeline-node" role="listitem" @key="node">
                                        <strong>@node.Label</strong>
                                        <span class="console-muted">@node.Method</span>
                                        @if (node.DependsOn.Count > 0)
                                        {
                                            <span class="console-muted studio-analysis-pipeline-deps">← @string.Join(", ", node.DependsOn)</span>
                                        }
                                    </div>
                                }
                            </div>
                        </article>

                        <article class="console-panel studio-analysis-run-preview" data-analysis-run-preview="true">
                            <div class="console-panel-heading">
                                <div>
                                    <p class="console-kicker">Run preview</p>
                                    <h3>Preview &amp; submit</h3>
                                </div>
                                <button class="console-button console-button-secondary" type="button" disabled="@(_busy || !plan.IsExistingPackage || plan.IsPublished)" @onclick="Preview">Re-run preview</button>
                            </div>
                            @if (plan.Estimate is { } previewEstimate)
                            {
                                <p class="console-muted">Estimated @previewEstimate.EstimatedRuntimeSeconds.ToString("0.#") s over @previewEstimate.EstimatedInputFeatures.ToString("N0") input features on the @previewEstimate.ComputeProfile profile.</p>
                            }
                            else
                            {
                                <p class="console-muted">Run Estimate to project runtime and cost before previewing or submitting.</p>
                            }

                            @if (!plan.IsPublished && !readiness.CanSubmit)
                            {
                                <div class="studio-analysis-gate" aria-labelledby="analysis-submit-readiness-heading">
                                    <p class="console-kicker">Pre-submit gate</p>
                                    <h4 id="analysis-submit-readiness-heading">Resolve before submit</h4>
                                    <ul class="studio-compact-list">
                                        @foreach (var requirement in readiness.UnmetRequirements)
                                        {
                                            <li>@requirement</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </article>

                        @if (plan.SubmittedJob is { } job)
                        {
                            <article class="console-panel studio-analysis-result" data-analysis-result="true" aria-labelledby="analysis-result-heading">
                                <p class="console-kicker">Result</p>
                                <h3 id="analysis-result-heading">Job and result artifact</h3>
                                <dl class="console-definition-list">
                                    <dt>Job</dt>
                                    <dd>@job.JobId</dd>
                                    <dt>Status</dt>
                                    <dd><span class="console-status @(job.HasFailure ? "console-status-warning" : string.Empty)">@job.Status</span></dd>
                                </dl>

                                @if (job.HasFailure)
                                {
                                    <p class="console-warning" role="alert" data-analysis-result-failure="true">
                                        @job.Failure!.Classification: @job.Failure.Message
                                    </p>
                                }
                                else if (job.HasArtifact)
                                {
                                    var artifact = job.Artifact!;
                                    <dl class="console-definition-list" data-analysis-artifact="true">
                                        <dt>Artifact</dt>
                                        <dd>@artifact.Label <small>(@artifact.ArtifactId)</small></dd>
                                        <dt>Kind</dt>
                                        <dd>@artifact.Kind</dd>
                                        <dt>Retention</dt>
                                        <dd>@artifact.RetentionState</dd>
                                        @if (!string.IsNullOrWhiteSpace(artifact.ContentType))
                                        {
                                            <dt>Media type</dt>
                                            <dd>@artifact.ContentType</dd>
                                        }
                                        @if (artifact.ByteSize is { } bytes)
                                        {
                                            <dt>Size</dt>
                                            <dd>@bytes.ToString("N0") bytes</dd>
                                        }
                                    </dl>
                                    <p class="console-kicker">Use this result as</p>
                                    <ul class="studio-compact-list" data-analysis-downstream="true">
                                        @foreach (var target in artifact.DownstreamTargets)
                                        {
                                            <li>@DownstreamLabel(target)</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="console-muted">The job is running on the execution engine. Once it finishes, resolve its result artifact by id to bind the output downstream.</p>
                                    <div class="console-action-row" data-analysis-resolve-artifact="true">
                                        <label class="studio-form-label">
                                            <span>Result artifact id</span>
                                            <input class="console-input" @bind="_artifactId" placeholder="artifact-…" />
                                        </label>
                                        <button class="console-button" type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_artifactId))" @onclick="ResolveArtifact">Resolve artifact</button>
                                    </div>
                                }
                            </article>
                        }
                    </div>

                    <aside class="studio-analysis-inspector" aria-label="Plan inspector">
                    <article class="console-panel">
                        <p class="console-kicker">Plan card</p>
                        <h3>Method</h3>
                        @if (plan.IsExistingPackage && !string.IsNullOrWhiteSpace(plan.AnalysisId))
                        {
                            <FieldStateRow State="FieldState.System" Label="Analysis id" Value="@plan.AnalysisId" Hint="@($"v{plan.Version}")" />
                        }
                        <FieldStateRow State="FieldState.Input" Label="Title">
                            <input class="console-input" @bind="plan.Title" @bind:after="OnEdit" placeholder="Hydrant proximity buffer" />
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Description">
                            <textarea class="console-input" rows="2" @bind="plan.Description" @bind:after="OnEdit"></textarea>
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Goal (analysis intent)">
                            <textarea class="console-input" rows="2" @bind="plan.Goal" @bind:after="OnEdit" placeholder="Find every parcel within 250m of a hydrant"></textarea>
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Method" Errors="_validation.Errors(StudioAnalysisFieldKeys.Method)">
                            <select class="console-input" @bind="plan.Method" @bind:after="OnEdit">
                                @foreach (var method in StudioAnalysisMethods.All)
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </FieldStateRow>
                    </article>

                    <article class="console-panel">
                        <p class="console-kicker">Compute</p>
                        <h3>Profile and output</h3>
                        <FieldStateRow State="FieldState.Input" Label="Compute profile">
                            <select class="console-input" @bind="plan.ComputeProfile" @bind:after="OnEdit">
                                @foreach (var profile in StudioAnalysisComputeProfiles.All)
                                {
                                    <option value="@profile">@profile</option>
                                }
                            </select>
                        </FieldStateRow>
                        <FieldStateRow State="FieldState.Input" Label="Output becomes">
                            <select class="console-input" @bind="plan.OutputContentType" @bind:after="OnEdit">
                                @foreach (var contentType in StudioAnalysisOutputContentTypes.All)
                                {
                                    <option value="@contentType">@contentType</option>
                                }
                            </select>
                        </FieldStateRow>

                        @if (plan.Estimate is { } estimate)
                        {
                            <div data-analysis-estimate="true">
                                <FieldStateRow State="FieldState.Calculated"
                                               Label="Estimated runtime"
                                               Value="@($"{estimate.EstimatedRuntimeSeconds.ToString("0.#")} s")"
                                               DerivedFrom="method · inputs · profile" />
                                <FieldStateRow State="FieldState.Calculated"
                                               Label="Estimated input features"
                                               Value="@estimate.EstimatedInputFeatures.ToString("N0")"
                                               DerivedFrom="input bindings" />
                                <FieldStateRow State="FieldState.Calculated"
                                               Label="Compute profile"
                                               Value="@estimate.ComputeProfile"
                                               DerivedFrom="profile selection" />
                                @if (!string.IsNullOrWhiteSpace(estimate.CostNote))
                                {
                                    <FieldStateRow State="FieldState.Calculated"
                                                   Label="Cost"
                                                   Value="@estimate.CostNote"
                                                   DerivedFrom="runtime · profile" />
                                }
                            </div>
                        }
                        else
                        {
                            <p class="console-muted">Run Estimate to review runtime and cost before submit.</p>
                        }
                    </article>

                    <article class="console-panel">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Inputs</p>
                                <h3>Input bindings</h3>
                            </div>
                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || plan.IsPublished)" @onclick="AddInput">Add input</button>
                        </div>

                        @if (plan.Inputs.Count == 0)
                        {
                            <p class="console-muted">No inputs yet. Bind at least one input service/layer before submit.</p>
                        }

                        @foreach (var input in plan.Inputs)
                        {
                            <div class="studio-analysis-row" @key="input">
                                <FieldStateRow State="FieldState.Input" Label="Role">
                                    <input class="console-input" @bind="input.Role" @bind:after="OnEdit" placeholder="primary" />
                                </FieldStateRow>
                                <FieldStateRow State="FieldState.Input" Label="Service id">
                                    <input class="console-input" @bind="input.ServiceId" @bind:after="OnEdit" placeholder="hydrants" />
                                </FieldStateRow>
                                <FieldStateRow State="FieldState.Input" Label="Layer id" Errors="_validation.Errors(StudioAnalysisFieldKeys.InputLayerId(plan.Inputs.IndexOf(input)))">
                                    <input class="console-input" type="number" @bind="input.LayerId" @bind:after="OnEdit" />
                                </FieldStateRow>
                                <div class="console-action-row">
                                    <button class="console-button console-button-secondary" type="button" disabled="@(_busy || plan.IsPublished)" @onclick="() => RemoveInput(input)">Remove</button>
                                </div>
                            </div>
                        }
                    </article>

                    <article class="console-panel">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Parameters</p>
                                <h3>Method parameters</h3>
                            </div>
                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || plan.IsPublished)" @onclick="AddParameter">Add parameter</button>
                        </div>

                        @if (plan.Parameters.Count == 0)
                        {
                            <p class="console-muted">No parameters set.</p>
                        }

                        @foreach (var parameter in plan.Parameters)
                        {
                            <div class="studio-analysis-row" @key="parameter">
                                <FieldStateRow State="FieldState.Input" Label="Name" Errors="_validation.Errors(StudioAnalysisFieldKeys.ParameterName(plan.Parameters.IndexOf(parameter)))">
                                    <input class="console-input" @bind="parameter.Name" @bind:after="OnEdit" placeholder="distanceMeters" />
                                </FieldStateRow>
                                <FieldStateRow State="FieldState.Input" Label="Value">
                                    <input class="console-input" @bind="parameter.Value" @bind:after="OnEdit" placeholder="250" />
                                </FieldStateRow>
                                <div class="console-action-row">
                                    <button class="console-button console-button-secondary" type="button" disabled="@(_busy || plan.IsPublished)" @onclick="() => RemoveParameter(parameter)">Remove</button>
                                </div>
                            </div>
                        }
                    </article>

                    <article class="console-panel">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Output schema</p>
                                <h3>Result fields</h3>
                            </div>
                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || plan.IsPublished)" @onclick="AddOutputField">Add field</button>
                        </div>

                        @if (plan.OutputSchema.Count == 0)
                        {
                            <p class="console-muted">No output fields yet. Define at least one before submit.</p>
                        }

                        @foreach (var field in plan.OutputSchema)
                        {
                            <div class="studio-analysis-row" @key="field">
                                <FieldStateRow State="FieldState.Input" Label="Name" Errors="_validation.Errors(StudioAnalysisFieldKeys.OutputFieldName(plan.OutputSchema.IndexOf(field)))">
                                    <input class="console-input" @bind="field.Name" @bind:after="OnEdit" placeholder="buffer_distance" />
                                </FieldStateRow>
                                <FieldStateRow State="FieldState.Input" Label="Type">
                                    <select class="console-input" @bind="field.Type" @bind:after="OnEdit">
                                        @foreach (var type in StudioAnalysisFieldTypes.All)
                                        {
                                            <option value="@type">@type</option>
                                        }
                                    </select>
                                </FieldStateRow>
                                <div class="console-action-row">
                                    <button class="console-button console-button-secondary" type="button" disabled="@(_busy || plan.IsPublished)" @onclick="() => RemoveOutputField(field)">Remove</button>
                                </div>
                            </div>
                        }
                    </article>
                    </aside>
                </div>
            </div>
        }
    }
</section>

@code {
    private bool _loading = true;
    private bool _busy;
    private StudioAnalysisWorkspace _workspace = new([], []);
    private StudioAnalysisCapabilityState? _bindingState;
    private IReadOnlyList<StudioAnalysisCapabilityState> _states = [];
    private StudioAnalysisPlanEditor? _plan;
    private string? _status;
    private bool _statusFailed;
    private string _artifactId = string.Empty;
    private readonly ValidationState _validation = new();
    private readonly FormDirtyState _dirty = new();

    /// <summary>
    /// Re-runs the client validator over the current plan and flags it dirty. Wired to every bound edit via
    /// <c>@bind:after</c> (cheap and synchronous). The server channel is dropped on edit because any change
    /// makes the last submit-time server findings stale; the next save/submit rebinds fresh ones.
    /// </summary>
    private void OnEdit()
    {
        _dirty.MarkDirty();
        RecomputeClientErrors();
        _validation.SetServerErrors(Array.Empty<ConsoleFieldError>());
    }

    private void RecomputeClientErrors() =>
        _validation.SetClientErrors(_plan is null
            ? Array.Empty<ConsoleFieldError>()
            : StudioAnalysisValidator.Instance.Evaluate(_plan));

    protected override Task OnInitializedAsync() => LoadWorkspaceAsync();

    private async Task LoadWorkspaceAsync()
    {
        _loading = true;
        _workspace = await AnalysisData.GetWorkspaceAsync();
        ApplyStates(_workspace.CapabilityStates);
        _loading = false;
    }

    private Task NewPlan() => RunLoadAsync(() => AnalysisData.LoadAsync(null));

    private Task OpenPlan(string analysisId) => RunLoadAsync(() => AnalysisData.LoadAsync(analysisId));

    private async Task RunLoadAsync(Func<Task<StudioAnalysisEditorLoad>> load)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _status = null;
        _statusFailed = false;
        try
        {
            var result = await load();
            ApplyStates(result.CapabilityStates);
            _plan = result.Plan;
            // A fresh load is the clean baseline.
            _validation.Clear();
            _dirty.MarkClean();
            RecomputeClientErrors();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackToList()
    {
        _plan = null;
        _status = null;
        _statusFailed = false;
        _validation.Clear();
        _dirty.MarkClean();
        // Awaited so the HTTP-backed reload's completion runs inside the Blazor event task and rerenders
        // the list (a fire-and-forget reload is not guaranteed to trigger StateHasChanged).
        await LoadWorkspaceAsync();
    }

    private void AddInput()
    {
        _plan?.Inputs.Add(new StudioAnalysisInputEditor());
        OnEdit();
    }

    private void RemoveInput(StudioAnalysisInputEditor input)
    {
        _plan?.Inputs.Remove(input);
        OnEdit();
    }

    private void AddParameter()
    {
        _plan?.Parameters.Add(new StudioAnalysisParameterEditor());
        OnEdit();
    }

    private void RemoveParameter(StudioAnalysisParameterEditor parameter)
    {
        _plan?.Parameters.Remove(parameter);
        OnEdit();
    }

    private void AddOutputField()
    {
        _plan?.OutputSchema.Add(new StudioAnalysisOutputFieldEditor());
        OnEdit();
    }

    private void RemoveOutputField(StudioAnalysisOutputFieldEditor field)
    {
        _plan?.OutputSchema.Remove(field);
        OnEdit();
    }

    private Task Save() => RunCommandAsync(() => AnalysisData.SaveDraftAsync(_plan!));

    private Task Estimate() => RunCommandAsync(() => AnalysisData.EstimateAsync(_plan!));

    private Task Preview() => RunCommandAsync(() => AnalysisData.PreviewAsync(_plan!));

    private Task Submit() => RunCommandAsync(() => AnalysisData.SubmitAsync(_plan!));

    private Task ResolveArtifact() =>
        RunCommandAsync(() => AnalysisData.ResolveArtifactAsync(_artifactId.Trim(), _plan!));

    private async Task RunCommandAsync(Func<Task<StudioAnalysisCommandResult>> command)
    {
        if (_busy || _plan is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await command();
            _status = result.Message;
            _statusFailed = !result.Succeeded;

            if (result.Plan is not null)
            {
                _plan = result.Plan;
            }

            // Re-run the client validator against the current plan and bind any field-addressable server
            // findings (parsed from a 400 ProblemDetails errors[]) onto the same field keys so they surface
            // inline next to the offending input, merged with the client findings.
            RecomputeClientErrors();
            _validation.SetServerErrors(StudioAnalysisServerErrorBinder.Map(result.FieldErrors));

            if (result.Succeeded)
            {
                _dirty.MarkClean();
            }

            ApplyStates(result.Issue is null ? [] : [result.Issue]);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string DownstreamLabel(string target) => target switch
    {
        "content" => "Content item",
        "layer" => "Map layer",
        "report" => "Report input",
        "dashboard" => "Dashboard input",
        "workflow" => "Workflow input",
        _ => target
    };

    private void ApplyStates(IReadOnlyList<StudioAnalysisCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
        _states = states
            .Where(state => !ReferenceEquals(state, _bindingState))
            .ToArray();
    }
}
