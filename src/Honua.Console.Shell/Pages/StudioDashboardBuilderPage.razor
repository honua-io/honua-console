    private RenderFragment InfoStep(string id, string title, string body, IReadOnlyList<(string Label, string Value)> rows) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "studio-publish-step");
        builder.AddAttribute(seq++, "data-publish-step", id);

        builder.OpenElement(seq++, "h3");
        builder.AddContent(seq++, title);
        builder.CloseElement();

        builder.OpenElement(seq++, "p");
        builder.AddAttribute(seq++, "class", "console-muted");
        builder.AddContent(seq++, body);
        builder.CloseElement();

        builder.OpenElement(seq++, "dl");
        builder.AddAttribute(seq++, "class", "console-definition-list");
        foreach (var (label, value) in rows)
        {
            builder.OpenElement(seq++, "dt");
            builder.AddContent(seq++, label);
            builder.CloseElement();
            builder.OpenElement(seq++, "dd");
            builder.AddContent(seq++, value);
