@page "/studio/dashboard"
@inject IStudioDashboardPackageDataSource DashboardData

<section class="console-page studio-dashboard-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>Dashboard builder</h1>
        <p>Author a server-owned dashboard package — data bindings, layout panels, Vega-Lite charts, map and table panels, filters, and narrative — pin source versions, preview responsively, then publish to honua-server.</p>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Dashboard builder"
                          Title="Loading dashboard packages"
                          Message="Reading the dashboard package lifecycle from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Dashboard package lifecycle is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else
    {
        @if (_states.Count > 0)
        {
            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Dashboard binding</p>
                    <h2>Server Capability States</h2>
                </div>
                <div class="console-panel-grid">
                    @foreach (var state in _states)
                    {
                        <article class="console-panel">
                            <div class="console-panel-heading">
                                <div>
                                    <p class="console-kicker">@state.State</p>
                                    <h2>@state.Surface</h2>
                                </div>
                            </div>
                            <p class="console-muted">@state.Detail</p>
                            <dl class="console-definition-list">
                                <dt>Contract</dt>
                                <dd>@state.Contract</dd>
                            </dl>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_editor is null)
        {
            <div class="console-toolbar">
                <button class="console-button" type="button" disabled="@_busy" @onclick="NewDashboard">New dashboard</button>
            </div>

            @if (_workspace.Packages.Count == 0)
            {
                <EmptyState Area="studio" Subject="dashboard packages" />
            }
            else
            {
                <div class="console-table-wrap">
                    <table class="console-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Panels</th>
                                <th>Draft</th>
                                <th>Published</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var package in _workspace.Packages)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="console-button console-button-secondary" disabled="@_busy" @onclick="() => OpenDashboard(package.DashboardId)">@package.Title</button>
                                        <small>@package.DashboardId</small>
                                    </td>
                                    <td>@package.PanelCount</td>
                                    <td>@(package.DraftVersion?.ToString() ?? "—")</td>
                                    <td>@(package.PublishedVersion?.ToString() ?? "—")</td>
                                    <td>@package.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            var editor = _editor;
            var readiness = StudioDashboardPublishEvaluator.Evaluate(editor);
            var selected = SelectedPanel(editor);

            <div class="studio-dashboard-editor" data-dashboard-builder="dashboard.package" data-dashboard-status="@editor.Status">
                @* Editor header bar: identifier, lifecycle badge, responsive-preview toggle, lifecycle actions. *@
                <div class="studio-dashboard-bar">
                    <span class="studio-dashboard-glyph" aria-hidden="true">▤</span>
                    <div class="studio-dashboard-identity">
                        <p class="console-kicker">@(editor.IsExistingPackage ? editor.DashboardId : "New draft")</p>
                        <h2>@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled dashboard" : editor.Title)</h2>
                    </div>
                    <span class="console-status @(editor.IsPublished ? "console-state-success" : "console-state-warning")">@editor.Status v@(editor.Version)</span>

                    <div class="studio-breakpoint-toggle" role="group" aria-label="Responsive preview breakpoint">
                        @foreach (var breakpoint in StudioDashboardBreakpoints.All)
                        {
                            <button type="button"
                                    class="@($"studio-breakpoint-option{(IsActiveBreakpoint(editor, breakpoint) ? " studio-breakpoint-active" : string.Empty)}")"
                                    aria-pressed="@(IsActiveBreakpoint(editor, breakpoint))"
                                    data-breakpoint="@breakpoint"
                                    @onclick="() => SetBreakpoint(breakpoint)">@CapitalizeBreakpoint(breakpoint)</button>
                        }
                    </div>

                    <div class="studio-dashboard-bar-actions">
                        <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToList">Back to dashboards</button>
                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="Save">Save draft</button>
                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || !editor.IsExistingPackage || editor.IsPublished)" @onclick="Validate">Validate</button>
                        <button class="console-button" type="button" disabled="@(_busy || editor.IsPublished || !readiness.CanPublish)" @onclick="Publish">Publish…</button>
                        @if (editor.IsPublished)
                        {
                            <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="Reopen">Reopen as draft</button>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(_status))
                {
                    <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
                }

                @if (!editor.IsPublished && !readiness.CanPublish)
                {
                    <article class="console-panel console-panel-warning" aria-labelledby="dashboard-publish-readiness-heading">
                        <p class="console-kicker">Pre-publish gate</p>
                        <h3 id="dashboard-publish-readiness-heading">Resolve before publish</h3>
                        <ul class="studio-compact-list">
                            @foreach (var requirement in readiness.UnmetRequirements)
                            {
                                <li>@requirement</li>
                            }
                        </ul>
                    </article>
                }

                @* Three-region editor: panel list + filters · layout canvas · inspector. *@
                <div class="studio-dashboard-workbench">
                    <div class="studio-dashboard-rail" data-dashboard-region="panels">
                        <div class="studio-dashboard-rail-head">
                            <h3>Panels</h3>
                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="AddPanel">+ Panel</button>
                        </div>

                        @if (editor.Panels.Count == 0)
                        {
                            <p class="console-muted studio-dashboard-rail-empty">No panels yet. Add a chart, map, table, or filter panel.</p>
                        }

                        <ul class="studio-panel-list">
                            @foreach (var panel in editor.Panels)
                            {
                                var isSelected = ReferenceEquals(panel, selected);
                                <li @key="panel">
                                    <button type="button"
                                            class="@($"studio-panel-item{(isSelected ? " studio-panel-selected" : string.Empty)}")"
                                            aria-pressed="@isSelected"
                                            @onclick="() => SelectPanel(panel)">
                                        <span class="studio-panel-glyph" aria-hidden="true">@PanelGlyph(panel.Kind)</span>
                                        <span class="studio-panel-text">
                                            <span class="studio-panel-name">@PanelLabel(panel)</span>
                                            <span class="studio-panel-kind">@PanelSubtitle(panel)</span>
                                        </span>
                                    </button>
                                </li>
                            }
                        </ul>

                        <div class="studio-dashboard-rail-section">
                            <div class="studio-dashboard-rail-head">
                                <h3>Data bindings</h3>
                                <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="AddBinding">+ Binding</button>
                            </div>

                            @if (editor.Bindings.Count == 0)
                            {
                                <p class="console-muted studio-dashboard-rail-empty">No data bindings yet. Add at least one source ref panels can read.</p>
                            }

                            @foreach (var binding in editor.Bindings)
                            {
                                <fieldset class="studio-binding-card" @key="binding">
                                    <label class="studio-form-label"><span>Alias</span><input class="console-input" @bind="binding.Alias" placeholder="requests" /></label>
                                    <label class="studio-form-label"><span>Content ref</span><input class="console-input" @bind="binding.ContentRef" placeholder="content:service-requests" /></label>
                                    <label class="studio-form-label"><span>Version pin</span><input class="console-input" @bind="binding.VersionPin" placeholder="latest" /></label>
                                    <div class="console-action-row">
                                        <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="() => RemoveBinding(binding)">Remove</button>
                                    </div>
                                </fieldset>
                            }
                        </div>
                    </div>

                    <div class="studio-dashboard-canvas" data-dashboard-region="canvas" data-dashboard-breakpoint="@editor.PreviewBreakpoint">
                        <p class="console-kicker">Layout canvas · @CapitalizeBreakpoint(editor.PreviewBreakpoint) preview</p>
                        @if (!string.IsNullOrWhiteSpace(editor.Narrative))
                        {
                            <p class="studio-dashboard-narrative">@editor.Narrative</p>
                        }

                        @if (editor.Panels.Count == 0)
                        {
                            <p class="console-muted">Add a panel to start composing the layout.</p>
                        }
                        else
                        {
                            <div class="studio-canvas-grid">
                                @foreach (var panel in editor.Panels)
                                {
                                    var isSelected = ReferenceEquals(panel, selected);
                                    <button type="button"
                                            class="@($"studio-canvas-panel studio-canvas-{panel.Kind.ToLowerInvariant()}{(isSelected ? " studio-canvas-selected" : string.Empty)}")"
                                            data-panel-kind="@panel.Kind"
                                            @key="panel"
                                            @onclick="() => SelectPanel(panel)">
                                        <span class="studio-canvas-panel-head">
                                            <span class="studio-canvas-panel-title">@PanelLabel(panel)</span>
                                            @if (panel.IsChart)
                                            {
                                                <span class="studio-vega-tag">Vega-Lite</span>
                                            }
                                        </span>
                                        <span class="studio-canvas-placeholder">@PanelSubtitle(panel)</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="studio-dashboard-inspector" data-dashboard-region="inspector">
                        @if (selected is null)
                        {
                            <p class="console-kicker">Inspector</p>
                            <p class="console-muted">Select a panel to edit its binding, encoding, and chart spec.</p>
                        }
                        else
                        {
                            var panel = selected;
                            <div class="studio-inspector-head">
                                <h3>@PanelLabel(panel)</h3>
                                <p class="console-muted">@PanelSubtitle(panel)</p>
                            </div>

                            <label class="studio-form-label"><span>Title</span><input class="console-input" @bind="panel.Title" placeholder="Requests by district" /></label>
                            <label class="studio-form-label">
                                <span>Kind</span>
                                <select class="console-input" @bind="panel.Kind">
                                    @foreach (var kind in StudioDashboardPanelKinds.All)
                                    {
                                        <option value="@kind">@kind</option>
                                    }
                                </select>
                            </label>
                            <label class="studio-form-label">
                                <span>Data binding</span>
                                <input class="console-input" @bind="panel.BindingAlias" placeholder="requests" />
                            </label>

                            @if (panel.IsChart)
                            {
                                <details class="studio-vega-spec" open>
                                    <summary>Vega-Lite spec (JSON)</summary>
                                    <textarea class="console-input studio-code" rows="10" @bind="panel.VegaLiteSpec"></textarea>
                                </details>
                            }

                            <div class="console-action-row">
                                <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="() => RemovePanel(panel)">Remove panel</button>
                            </div>
                        }

                        <div class="studio-inspector-section">
                            <h3>Dashboard</h3>
                            <label class="studio-form-label"><span>Title</span><input class="console-input" @bind="editor.Title" placeholder="Operations dashboard" /></label>
                            <label class="studio-form-label"><span>Description</span><textarea class="console-input" rows="2" @bind="editor.Description"></textarea></label>
                            <label class="studio-form-label"><span>Narrative</span><textarea class="console-input" rows="3" @bind="editor.Narrative" placeholder="Context shown above the layout."></textarea></label>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</section>

@code {
    private bool _loading = true;
    private bool _busy;
    private StudioDashboardWorkspace _workspace = new([], []);
    private StudioDashboardCapabilityState? _bindingState;
    private IReadOnlyList<StudioDashboardCapabilityState> _states = [];
    private StudioDashboardEditorState? _editor;
    private StudioDashboardPanelEditor? _selectedPanel;
    private string? _status;
    private bool _statusFailed;

    protected override Task OnInitializedAsync() => LoadWorkspaceAsync();

    private async Task LoadWorkspaceAsync()
    {
        _loading = true;
        _workspace = await DashboardData.GetWorkspaceAsync();
        ApplyStates(_workspace.CapabilityStates);
        _loading = false;
    }

    private Task NewDashboard() => RunLoadAsync(() => DashboardData.LoadAsync(null));

    private Task OpenDashboard(string dashboardId) => RunLoadAsync(() => DashboardData.LoadAsync(dashboardId));

    private async Task RunLoadAsync(Func<Task<StudioDashboardEditorLoad>> load)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _status = null;
        _statusFailed = false;
        try
        {
            var result = await load();
            ApplyStates(result.CapabilityStates);
            _editor = result.State;
            _selectedPanel = result.State?.Panels.FirstOrDefault();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackToList()
    {
        _editor = null;
        _selectedPanel = null;
        _status = null;
        _statusFailed = false;
        // Awaited so the HTTP-backed reload's completion runs inside the Blazor event task and rerenders
        // the list (a fire-and-forget reload is not guaranteed to trigger StateHasChanged).
        await LoadWorkspaceAsync();
    }

    private void AddBinding() => _editor?.Bindings.Add(new StudioDashboardBindingEditor());

    private void RemoveBinding(StudioDashboardBindingEditor binding) => _editor?.Bindings.Remove(binding);

    private void AddPanel()
    {
        if (_editor is null)
        {
            return;
        }

        var panel = new StudioDashboardPanelEditor { VegaLiteSpec = StudioDashboardChartSpec.DefaultBarChart() };
        _editor.Panels.Add(panel);
        _selectedPanel = panel;
    }

    private void RemovePanel(StudioDashboardPanelEditor panel)
    {
        _editor?.Panels.Remove(panel);
        if (ReferenceEquals(_selectedPanel, panel))
        {
            _selectedPanel = null;
        }
    }

    private void SelectPanel(StudioDashboardPanelEditor panel) => _selectedPanel = panel;

    private void SetBreakpoint(string breakpoint)
    {
        if (_editor is not null)
        {
            _editor.PreviewBreakpoint = breakpoint;
        }
    }

    private StudioDashboardPanelEditor? SelectedPanel(StudioDashboardEditorState editor)
    {
        if (_selectedPanel is not null && editor.Panels.Contains(_selectedPanel))
        {
            return _selectedPanel;
        }

        _selectedPanel = editor.Panels.FirstOrDefault();
        return _selectedPanel;
    }

    private static bool IsActiveBreakpoint(StudioDashboardEditorState editor, string breakpoint) =>
        string.Equals(editor.PreviewBreakpoint, breakpoint, StringComparison.OrdinalIgnoreCase)
        // Legacy "narrow" drafts highlight the closest current breakpoint (tablet).
        || (string.Equals(editor.PreviewBreakpoint, StudioDashboardBreakpoints.Narrow, StringComparison.OrdinalIgnoreCase)
            && string.Equals(breakpoint, StudioDashboardBreakpoints.Tablet, StringComparison.OrdinalIgnoreCase));

    private static string CapitalizeBreakpoint(string breakpoint) =>
        string.IsNullOrEmpty(breakpoint)
            ? breakpoint
            : char.ToUpperInvariant(breakpoint[0]) + breakpoint[1..];

    private static string PanelLabel(StudioDashboardPanelEditor panel) =>
        string.IsNullOrWhiteSpace(panel.Title) ? $"Untitled {panel.Kind}" : panel.Title;

    private static string PanelSubtitle(StudioDashboardPanelEditor panel)
    {
        var kind = panel.Kind switch
        {
            StudioDashboardPanelKinds.Chart => "Vega-Lite chart",
            StudioDashboardPanelKinds.Map => "Map panel",
            StudioDashboardPanelKinds.Table => "Table",
            StudioDashboardPanelKinds.Filter => "Filter",
            _ => panel.Kind
        };

        return string.IsNullOrWhiteSpace(panel.BindingAlias) ? kind : $"{kind} · {panel.BindingAlias}";
    }

    private static string PanelGlyph(string kind) => kind switch
    {
        StudioDashboardPanelKinds.Chart => "∼",
        StudioDashboardPanelKinds.Map => "◐",
        StudioDashboardPanelKinds.Table => "▦",
        StudioDashboardPanelKinds.Filter => "⛁",
        _ => "▤"
    };

    private Task Save() => RunCommandAsync(() => DashboardData.SaveDraftAsync(_editor!));

    private Task Validate() => RunCommandAsync(() => DashboardData.ValidateAsync(_editor!));

    private Task Publish() => RunCommandAsync(() => DashboardData.PublishAsync(_editor!));

    private Task Reopen() => RunCommandAsync(() => DashboardData.ReopenAsync(_editor!.DashboardId!, _editor.Version));

    private async Task RunCommandAsync(Func<Task<StudioDashboardCommandResult>> command)
    {
        if (_busy || _editor is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await command();
            _status = result.Message;
            _statusFailed = !result.Succeeded;

            if (result.State is not null)
            {
                _editor = result.State;
            }

            ApplyStates(result.Issue is null ? [] : [result.Issue]);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyStates(IReadOnlyList<StudioDashboardCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
        _states = states
            .Where(state => !ReferenceEquals(state, _bindingState))
            .ToArray();
    }
}
