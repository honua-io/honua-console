    private RenderFragment ConfirmStep(StudioDashboardEditorState editor, StudioDashboardPublishReadiness readiness) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "studio-publish-confirm");
        builder.AddAttribute(seq++, "data-publish-step", "confirm");

        // "Publishing as" summary, mirroring the design-handoff confirmation card.
        builder.OpenElement(seq++, "article");
        builder.AddAttribute(seq++, "class", "console-panel");
        builder.AddAttribute(seq++, "data-publish-summary", "publishing-as");
        builder.OpenElement(seq++, "h3");
        builder.AddContent(seq++, "Publishing as");
        builder.CloseElement();

        builder.OpenElement(seq++, "dl");
        builder.AddAttribute(seq++, "class", "console-definition-list");
        AddDefinition(builder, ref seq, "Content type", "Dashboard");
        AddDefinition(builder, ref seq, "Title", string.IsNullOrWhiteSpace(editor.Title) ? "Untitled dashboard" : editor.Title);
        AddDefinition(builder, ref seq, "Identifier", editor.DashboardId ?? "new draft");
        AddDefinition(builder, ref seq, "Version", $"v{editor.Version}");
        AddDefinition(builder, ref seq, "Panels", editor.Panels.Count.ToString());
        AddDefinition(builder, ref seq, "Status", editor.Status);
        builder.CloseElement(); // dl
        builder.CloseElement(); // article

        // Ready-to-publish checklist.
        builder.OpenElement(seq++, "article");
        builder.AddAttribute(seq++, "class", readiness.CanPublish ? "console-panel console-panel-success" : "console-panel console-panel-warning");
        builder.OpenElement(seq++, "h3");
        builder.AddContent(seq++, readiness.CanPublish ? "Ready to publish" : "Not ready to publish");
        builder.CloseElement();
        builder.OpenElement(seq++, "ul");
        builder.AddAttribute(seq++, "class", "studio-compact-list");
        if (readiness.CanPublish)
        {
            foreach (var line in new[] { "Validation passed", "Dependencies resolved", "Visibility set", "Embed policy set", "Rollback plan confirmed" })
            {
                builder.OpenElement(seq++, "li");
                builder.AddContent(seq++, line);
                builder.CloseElement();
            }
        }
        else
        {
            foreach (var requirement in readiness.UnmetRequirements)
            {
                builder.OpenElement(seq++, "li");
                builder.AddContent(seq++, requirement);
                builder.CloseElement();
            }
        }

        builder.CloseElement(); // ul
        builder.CloseElement(); // article

        builder.OpenElement(seq++, "p");
        builder.AddAttribute(seq++, "class", "console-muted");
        builder.AddContent(seq++, "Publishing emits a governed operational event and freezes content version v" + editor.Version + ". An evidence link is attached and surfaced in Operate → Event Viewer.");
        builder.CloseElement();

        builder.CloseElement(); // confirm
    };

    private static void AddDefinition(RenderTreeBuilder builder, ref int seq, string label, string value)
    {
        builder.OpenElement(seq++, "dt");
        builder.AddContent(seq++, label);
        builder.CloseElement();
        builder.OpenElement(seq++, "dd");
        builder.AddContent(seq++, value);
        builder.CloseElement();
    }

