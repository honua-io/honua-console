@page "/studio/dashboard"
@using Microsoft.AspNetCore.Components.Rendering
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Validation
@inject IStudioDashboardPackageDataSource DashboardData

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have unsaved dashboard changes. Leave this page and discard them?" />

<section class="console-page studio-dashboard-builder">
    <div class="console-page-heading">
        <p class="console-kicker">Builder workflow</p>
        <h1>Dashboard builder</h1>
        <p>Author a server-owned dashboard package — data bindings, layout panels, Vega-Lite charts, map and table panels, filters, and narrative — pin source versions, preview responsively, then publish to honua-server.</p>
    </div>

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Dashboard builder"
                          Title="Loading dashboard packages"
                          Message="Reading the dashboard package lifecycle from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Dashboard package lifecycle is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else
    {
        @if (_states.Count > 0)
        {
            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Dashboard binding</p>
                    <h2>Server Capability States</h2>
                </div>
                <div class="console-panel-grid">
                    @foreach (var state in _states)
                    {
                        <article class="console-panel">
                            <div class="console-panel-heading">
                                <div>
                                    <p class="console-kicker">@state.State</p>
                                    <h2>@state.Surface</h2>
                                </div>
                            </div>
                            <p class="console-muted">@state.Detail</p>
                            <dl class="console-definition-list">
                                <dt>Contract</dt>
                                <dd>@state.Contract</dd>
                            </dl>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_editor is null)
        {
            <div class="console-toolbar">
                <button class="console-button" type="button" disabled="@_busy" @onclick="NewDashboardFromPrompt">New from prompt</button>
                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="NewDashboard">Open blank editor</button>
            </div>

            @if (_workspace.Packages.Count == 0)
            {
                <EmptyState Area="studio" Subject="dashboard packages" />
            }
            else
            {
                <div class="console-table-wrap">
                    <table class="console-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Panels</th>
                                <th>Draft</th>
                                <th>Published</th>
                                <th>Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var package in _workspace.Packages)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="console-button console-button-secondary" disabled="@_busy" @onclick="() => OpenDashboard(package.DashboardId)">@package.Title</button>
                                        <small>@package.DashboardId</small>
                                    </td>
                                    <td>@package.PanelCount</td>
                                    <td>@(package.DraftVersion?.ToString() ?? "—")</td>
                                    <td>@(package.PublishedVersion?.ToString() ?? "—")</td>
                                    <td>@package.UpdatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else
        {
            var editor = _editor;
            var readiness = StudioDashboardPublishEvaluator.Evaluate(editor);
            var selected = SelectedPanel(editor);

            @if (_view == DashboardView.Ai)
            {
                @* StudioDashboardAI: conversation-from-prompt with a live dashboard package preview. *@
                <div class="studio-dashboard-ai" data-dashboard-builder="dashboard.package" data-dashboard-view="ai" data-dashboard-status="@editor.Status">
                    @if (!string.IsNullOrEmpty(_status))
                    {
                        <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
                    }

                    <StudioAiConversation ConversationTitle="Dashboard from prompt"
                                          RefinePlaceholder="Describe the dashboard — the data to bind, the charts, maps, tables, filters, and narrative…"
                                          Turns="_turns"
                                          Clarifications="_clarifications"
                                          Busy="_busy"
                                          OnSend="HandlePrompt"
                                          OnAnswer="HandleClarificationAnswered">
                        <PreviewHeader>
                            <div class="studio-ai-preview-titlebar">
                                <span class="studio-dashboard-glyph" aria-hidden="true">▤</span>
                                <span class="studio-ai-preview-name">@(string.IsNullOrWhiteSpace(editor.Title) ? "untitled-dashboard" : editor.DashboardId ?? "new draft")</span>
                                <span class="console-status @(editor.IsPublished ? "console-state-success" : "console-state-warning")">@editor.Status</span>
                                @if (readiness.CanPublish)
                                {
                                    <span class="console-status console-state-success">validation passed</span>
                                }
                                else
                                {
                                    <span class="console-status console-state-warning">@(readiness.UnmetRequirements.Count) to resolve</span>
                                }
                                <div class="studio-ai-preview-titlebar-spacer"></div>
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="OpenEditorView">Open editor →</button>
                                <button class="console-button" type="button" disabled="@(_busy || editor.IsPublished || !readiness.CanPublish)" @onclick="OpenPublishView">Publish…</button>
                            </div>
                        </PreviewHeader>
                        <PreviewContent>
                            @DashboardPreview(editor)
                        </PreviewContent>
                    </StudioAiConversation>
                </div>
            }
            else if (_view == DashboardView.Publish)
            {
                @* StudioDashboardPublish: 6-step publish wizard with a "Publishing as" confirmation. *@
                <div class="studio-dashboard-publish" data-dashboard-builder="dashboard.package" data-dashboard-view="publish" data-dashboard-status="@editor.Status">
                    <div class="studio-dashboard-publish-bar">
                        <span class="studio-dashboard-glyph" aria-hidden="true">▤</span>
                        <b>@(string.IsNullOrWhiteSpace(editor.Title) ? "untitled dashboard" : editor.Title)</b>
                        <span class="console-status console-state-warning">v@(editor.Version) @editor.Status</span>
                        <span class="console-muted">→ dashboard content item</span>
                        <div class="studio-dashboard-publish-bar-spacer"></div>
                        @if (readiness.CanPublish)
                        {
                            <span class="console-status console-state-success">all checks passed</span>
                        }
                        else
                        {
                            <span class="console-status console-state-warning">@(readiness.UnmetRequirements.Count) check(s) open</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_status))
                    {
                        <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
                    }

                    <PublishWizard Kicker="Publish dashboard"
                                   Title="@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled dashboard" : editor.Title)"
                                   Steps="BuildPublishSteps(editor, readiness)"
                                   Current="_publishStep"
                                   CurrentChanged="SetPublishStep"
                                   FinishLabel="Publish dashboard"
                                   OnFinish="PublishFromWizard">
                        <ExtraFooterActions>
                            <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="OpenEditorView">Open editor</button>
                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="Save">Save as draft</button>
                        </ExtraFooterActions>
                    </PublishWizard>
                </div>
            }
            else
            {
                @* StudioDashboardEditor: three-region authoring workbench. *@
                <div class="studio-dashboard-editor" data-dashboard-builder="dashboard.package" data-dashboard-view="editor" data-dashboard-status="@editor.Status">
                    @* Editor header bar: identifier, lifecycle badge, responsive-preview toggle, lifecycle actions. *@
                    <div class="studio-dashboard-bar">
                        <span class="studio-dashboard-glyph" aria-hidden="true">▤</span>
                        <div class="studio-dashboard-identity">
                            <p class="console-kicker">@(editor.IsExistingPackage ? editor.DashboardId : "New draft")</p>
                            <h2>@(string.IsNullOrWhiteSpace(editor.Title) ? "Untitled dashboard" : editor.Title)</h2>
                        </div>
                        <span class="console-status @(editor.IsPublished ? "console-state-success" : "console-state-warning")">@editor.Status v@(editor.Version)</span>

                        <div class="studio-breakpoint-toggle" role="group" aria-label="Responsive preview breakpoint">
                            @foreach (var breakpoint in StudioDashboardBreakpoints.All)
                            {
                                <button type="button"
                                        class="@($"studio-breakpoint-option{(IsActiveBreakpoint(editor, breakpoint) ? " studio-breakpoint-active" : string.Empty)}")"
                                        aria-pressed="@(IsActiveBreakpoint(editor, breakpoint))"
                                        data-breakpoint="@breakpoint"
                                        @onclick="() => SetBreakpoint(breakpoint)">@CapitalizeBreakpoint(breakpoint)</button>
                            }
                        </div>

                        <div class="studio-dashboard-bar-actions">
                            <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="OpenAiView">From prompt</button>
                            <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="BackToList">Back to dashboards</button>
                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished || _validation.HasBlockingClientErrors)" @onclick="Save">Save draft</button>
                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || !editor.IsExistingPackage || editor.IsPublished)" @onclick="Validate">Validate</button>
                            <button class="console-button" type="button" disabled="@(_busy || editor.IsPublished || !readiness.CanPublish || _validation.HasBlockingClientErrors)" @onclick="OpenPublishView">Publish…</button>
                            @if (editor.IsPublished)
                            {
                                <button class="console-button console-button-secondary" type="button" disabled="@_busy" @onclick="Reopen">Reopen as draft</button>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(_status))
                    {
                        <p class="@(_statusFailed ? "console-warning" : "console-status")" role="status" aria-live="polite">@_status</p>
                    }

                    @if (_validation.HasBlockingClientErrors)
                    {
                        <article class="console-panel console-panel-warning" aria-labelledby="dashboard-validation-heading">
                            <p class="console-kicker">Validation</p>
                            <h3 id="dashboard-validation-heading">Resolve before publish</h3>
                            <ul class="studio-compact-list">
                                @foreach (var error in _validation.Summary.Where(e => e.IsBlocking))
                                {
                                    <li>@error.Message</li>
                                }
                            </ul>
                        </article>
                    }

                    @if (!editor.IsPublished && !readiness.CanPublish)
                    {
                        <article class="console-panel console-panel-warning" aria-labelledby="dashboard-publish-readiness-heading">
                            <p class="console-kicker">Pre-publish gate</p>
                            <h3 id="dashboard-publish-readiness-heading">Resolve before publish</h3>
                            <ul class="studio-compact-list">
                                @foreach (var requirement in readiness.UnmetRequirements)
                                {
                                    <li>@requirement</li>
                                }
                            </ul>
                        </article>
                    }

                    @* Three-region editor: panel list + filters · layout canvas · inspector. *@
                    <div class="studio-dashboard-workbench">
                        <div class="studio-dashboard-rail" data-dashboard-region="panels">
                            <div class="studio-dashboard-rail-head">
                                <h3>Panels</h3>
                                <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="AddPanel">+ Panel</button>
                            </div>

                            @if (editor.Panels.Count == 0)
                            {
                                <p class="console-muted studio-dashboard-rail-empty">No panels yet. Add a chart, map, table, or filter panel.</p>
                            }

                            <ul class="studio-panel-list">
                                @foreach (var panel in editor.Panels)
                                {
                                    var isSelected = ReferenceEquals(panel, selected);
                                    <li @key="panel">
                                        <button type="button"
                                                class="@($"studio-panel-item{(isSelected ? " studio-panel-selected" : string.Empty)}")"
                                                aria-pressed="@isSelected"
                                                @onclick="() => SelectPanel(panel)">
                                            <span class="studio-panel-glyph" aria-hidden="true">@PanelGlyph(panel.Kind)</span>
                                            <span class="studio-panel-text">
                                                <span class="studio-panel-name">@PanelLabel(panel)</span>
                                                <span class="studio-panel-kind">@PanelSubtitle(panel)</span>
                                            </span>
                                        </button>
                                    </li>
                                }
                            </ul>

                            <div class="studio-dashboard-rail-section">
                                <div class="studio-dashboard-rail-head">
                                    <h3>Data bindings</h3>
                                    <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="AddBinding">+ Binding</button>
                                </div>

                                @if (editor.Bindings.Count == 0)
                                {
                                    <p class="console-muted studio-dashboard-rail-empty">No data bindings yet. Add at least one source ref panels can read.</p>
                                }

                                @foreach (var binding in editor.Bindings)
                                {
                                    var bindingIndex = editor.Bindings.IndexOf(binding);
                                    <fieldset class="studio-binding-card" @key="binding">
                                        <label class="studio-form-label"><span>Alias</span><input class="console-input" @bind="binding.Alias" @bind:after="OnEdit" placeholder="requests" /></label>
                                        <ValidationMessageInline FieldKey="@StudioDashboardFieldKeys.BindingAlias(bindingIndex)" State="_validation" />
                                        <label class="studio-form-label"><span>Content ref</span><input class="console-input" @bind="binding.ContentRef" @bind:after="OnEdit" placeholder="content:service-requests" /></label>
                                        <ValidationMessageInline FieldKey="@StudioDashboardFieldKeys.BindingContentRef(bindingIndex)" State="_validation" />
                                        <label class="studio-form-label"><span>Version pin</span><input class="console-input" @bind="binding.VersionPin" @bind:after="OnEdit" placeholder="latest" /></label>
                                        <div class="console-action-row">
                                            <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="() => RemoveBinding(binding)">Remove</button>
                                        </div>
                                    </fieldset>
                                }
                            </div>
                        </div>

                        <div class="studio-dashboard-canvas" data-dashboard-region="canvas" data-dashboard-breakpoint="@editor.PreviewBreakpoint">
                            <p class="console-kicker">Layout canvas · @CapitalizeBreakpoint(editor.PreviewBreakpoint) preview</p>
                            @if (!string.IsNullOrWhiteSpace(editor.Narrative))
                            {
                                <p class="studio-dashboard-narrative">@editor.Narrative</p>
                            }

                            @if (editor.Panels.Count == 0)
                            {
                                <p class="console-muted">Add a panel to start composing the layout.</p>
                            }
                            else
                            {
                                <div class="studio-canvas-grid">
                                    @foreach (var panel in editor.Panels)
                                    {
                                        var isSelected = ReferenceEquals(panel, selected);
                                        <button type="button"
                                                class="@($"studio-canvas-panel studio-canvas-{panel.Kind.ToLowerInvariant()}{(isSelected ? " studio-canvas-selected" : string.Empty)}")"
                                                data-panel-kind="@panel.Kind"
                                                @key="panel"
                                                @onclick="() => SelectPanel(panel)">
                                            <span class="studio-canvas-panel-head">
                                                <span class="studio-canvas-panel-title">@PanelLabel(panel)</span>
                                                @if (panel.IsChart)
                                                {
                                                    <span class="studio-vega-tag">Vega-Lite</span>
                                                }
                                            </span>
                                            <span class="studio-canvas-placeholder">@PanelSubtitle(panel)</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="studio-dashboard-inspector" data-dashboard-region="inspector">
                            @if (selected is null)
                            {
                                <p class="console-kicker">Inspector</p>
                                <p class="console-muted">Select a panel to edit its binding, encoding, and chart spec.</p>
                            }
                            else
                            {
                                var panel = selected;
                                var panelIndex = editor.Panels.IndexOf(panel);
                                <div class="studio-inspector-head">
                                    <h3>@PanelLabel(panel)</h3>
                                    <p class="console-muted">@PanelSubtitle(panel)</p>
                                </div>

                                <label class="studio-form-label"><span>Title</span><input class="console-input" @bind="panel.Title" @bind:after="OnEdit" placeholder="Requests by district" /></label>
                                <label class="studio-form-label">
                                    <span>Kind</span>
                                    <select class="console-input" @bind="panel.Kind" @bind:after="OnEdit">
                                        @foreach (var kind in StudioDashboardPanelKinds.All)
                                        {
                                            <option value="@kind">@kind</option>
                                        }
                                    </select>
                                </label>
                                <label class="studio-form-label">
                                    <span>Data binding</span>
                                    <input class="console-input" @bind="panel.BindingAlias" @bind:after="OnEdit" placeholder="requests" />
                                </label>
                                <ValidationMessageInline FieldKey="@StudioDashboardFieldKeys.PanelBindingAlias(panelIndex)" State="_validation" />

                                @if (panel.IsChart)
                                {
                                    <details class="studio-vega-spec" open>
                                        <summary>Vega-Lite spec (JSON)</summary>
                                        <textarea class="console-input studio-code" rows="10" @bind="panel.VegaLiteSpec" @bind:after="OnEdit"></textarea>
                                    </details>
                                    <ValidationMessageInline FieldKey="@StudioDashboardFieldKeys.PanelVegaLiteSpec(panelIndex)" State="_validation" />
                                }

                                <div class="console-action-row">
                                    <button class="console-button console-button-secondary" type="button" disabled="@(_busy || editor.IsPublished)" @onclick="() => RemovePanel(panel)">Remove panel</button>
                                </div>
                            }

                            <div class="studio-inspector-section">
                                <h3>Dashboard</h3>
                                <label class="studio-form-label"><span>Title</span><input class="console-input" @bind="editor.Title" @bind:after="OnEdit" placeholder="Operations dashboard" /></label>
                                <ValidationMessageInline FieldKey="@StudioDashboardFieldKeys.Title" State="_validation" />
                                <label class="studio-form-label"><span>Description</span><textarea class="console-input" rows="2" @bind="editor.Description" @bind:after="OnEdit"></textarea></label>
                                <label class="studio-form-label"><span>Narrative</span><textarea class="console-input" rows="3" @bind="editor.Narrative" @bind:after="OnEdit" placeholder="Context shown above the layout."></textarea></label>
                                <ValidationMessageInline FieldKey="@StudioDashboardFieldKeys.Panels" State="_validation" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</section>

@code {
    private enum DashboardView
    {
        Editor,
        Ai,
        Publish,
    }

    private bool _loading = true;
    private bool _busy;
    private StudioDashboardWorkspace _workspace = new([], []);
    private StudioDashboardCapabilityState? _bindingState;
    private IReadOnlyList<StudioDashboardCapabilityState> _states = [];
    private StudioDashboardEditorState? _editor;
    private StudioDashboardPanelEditor? _selectedPanel;
    private string? _status;
    private bool _statusFailed;
    private DashboardView _view = DashboardView.Editor;
    private int _publishStep;
    private readonly List<StudioConversationTurn> _turns = [];
    private readonly List<StudioConversationClarification> _clarifications = [];
    private readonly ValidationState _validation = new();
    private readonly FormDirtyState _dirty = new();

    protected override Task OnInitializedAsync() => LoadWorkspaceAsync();

    /// <summary>
    /// Re-runs the client cross-field/referential validator over the current editor and flags it dirty.
    /// Wired to every bound edit via <c>@bind:after</c>. The server channel is dropped on edit because any
    /// change makes the last validate-time diagnostics stale; the next Validate/Save rebinds fresh ones.
    /// </summary>
    private void OnEdit()
    {
        _dirty.MarkDirty();
        RecomputeClientErrors();
        _validation.SetServerErrors(Array.Empty<ConsoleFieldError>());
    }

    private void RecomputeClientErrors() =>
        _validation.SetClientErrors(_editor is null
            ? Array.Empty<ConsoleFieldError>()
            : StudioDashboardValidator.Instance.Evaluate(_editor));

    private async Task LoadWorkspaceAsync()
    {
        _loading = true;
        _workspace = await DashboardData.GetWorkspaceAsync();
        ApplyStates(_workspace.CapabilityStates);
        _loading = false;
    }

    private Task NewDashboard() => RunLoadAsync(() => DashboardData.LoadAsync(null), DashboardView.Editor);

    private Task NewDashboardFromPrompt() => RunLoadAsync(() => DashboardData.LoadAsync(null), DashboardView.Ai);

    private Task OpenDashboard(string dashboardId) => RunLoadAsync(() => DashboardData.LoadAsync(dashboardId), DashboardView.Editor);

    private async Task RunLoadAsync(Func<Task<StudioDashboardEditorLoad>> load, DashboardView view)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _status = null;
        _statusFailed = false;
        try
        {
            var result = await load();
            ApplyStates(result.CapabilityStates);
            _editor = result.State;
            _selectedPanel = result.State?.Panels.FirstOrDefault();
            _publishStep = 0;
            _turns.Clear();
            _clarifications.Clear();

            // A fresh load is the clean baseline: drop local edits/findings and recompute against the load.
            _validation.Clear();
            _dirty.MarkClean();
            RecomputeClientErrors();
            if (_editor is not null)
            {
                _view = view;
                if (view == DashboardView.Ai)
                {
                    SeedConversation(_editor);
                }
            }
            else
            {
                _view = DashboardView.Editor;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackToList()
    {
        _editor = null;
        _selectedPanel = null;
        _status = null;
        _statusFailed = false;
        _view = DashboardView.Editor;
        _turns.Clear();
        _clarifications.Clear();
        _validation.Clear();
        _dirty.MarkClean();
        // Awaited so the HTTP-backed reload's completion runs inside the Blazor event task and rerenders
        // the list (a fire-and-forget reload is not guaranteed to trigger StateHasChanged).
        await LoadWorkspaceAsync();
    }

    private void OpenEditorView() => _view = DashboardView.Editor;

    private void OpenAiView()
    {
        if (_editor is null)
        {
            return;
        }

        if (_turns.Count == 0)
        {
            SeedConversation(_editor);
        }

        _view = DashboardView.Ai;
    }

    private void OpenPublishView()
    {
        if (_editor is null)
        {
            return;
        }

        _publishStep = 0;
        _view = DashboardView.Publish;
    }

    private void SetPublishStep(int step) => _publishStep = step;

    // The conversation is presentational + event-forwarding only: it never fabricates package state. A
    // prompt/refine turn calls the server's natural-language dashboard generation contract (POST
    // /api/v1/console/publications/generate, kind=dashboard); the server grounds the proposal in the
    // available content bindings and validates it before returning, so the page only ever renders a
    // server-produced dashboard (the editor preview hydrates from the returned honua.dashboard-document.v1),
    // a structured clarification request, or an honest unsupported/refused/missing-binding state — never a
    // fabricated dashboard (Console Patterns Charter section 11).
    private void SeedConversation(StudioDashboardEditorState editor)
    {
        _turns.Clear();
        _clarifications.Clear();
        _turns.Add(new StudioConversationTurn(
            StudioConversationRole.Honua,
            "Describe the dashboard you want — the data it should bind, the charts, maps, tables, and filters, and any narrative — and I'll propose a dashboard you can review and refine. Every proposal is grounded in the real content bindings and validated on the server before it appears; nothing is fabricated.",
            "just now",
            StudioConversationTone.Neutral));
    }

    private static string DescribeDraft(StudioDashboardEditorState editor)
    {
        var charts = editor.Panels.Count(panel => panel.IsChart);
        var panelText = editor.Panels.Count switch
        {
            0 => "no panels yet",
            1 => "1 panel",
            _ => $"{editor.Panels.Count} panels"
        };
        var bindingText = editor.Bindings.Count == 1 ? "1 data binding" : $"{editor.Bindings.Count} data bindings";
        var chartText = charts == 0 ? string.Empty : $" · {charts} Vega-Lite chart{(charts == 1 ? string.Empty : "s")}";
        return $"This draft has {panelText} and {bindingText}{chartText}. Charts use Vega-Lite. Refine below or open the editor to adjust bindings and specs.";
    }

    // A prompt turn forwards to the server's natural-language dashboard generation contract. The page only
    // ever renders a server-produced dashboard, a structured clarification request, or an honest
    // unsupported/refused/missing-binding state — never fabricated panels.
    private Task HandlePrompt(string prompt)
    {
        if (_busy || _editor is null || string.IsNullOrWhiteSpace(prompt))
        {
            return Task.CompletedTask;
        }

        _turns.Add(new StudioConversationTurn(StudioConversationRole.You, prompt, "just now"));
        return GenerateAsync(new StudioDashboardGenerationRequest
        {
            Prompt = prompt,
            Conversation = SnapshotConversation()
        });
    }

    // Answering a clarification removes the card and forwards the choice back to the server as a refine turn.
    private Task HandleClarificationAnswered((StudioConversationClarification Question, StudioConversationChoice Choice) answer)
    {
        if (_busy || _editor is null)
        {
            return Task.CompletedTask;
        }

        _clarifications.RemoveAll(question => string.Equals(question.Id, answer.Question.Id, StringComparison.Ordinal));
        _turns.Add(new StudioConversationTurn(
            StudioConversationRole.You,
            $"{answer.Question.Label}: {answer.Choice.Label}",
            "just now"));

        return GenerateAsync(new StudioDashboardGenerationRequest
        {
            Prompt = string.Empty,
            Conversation = SnapshotConversation(),
            Answers = [new StudioDashboardGenerationAnswer(answer.Question.Id, answer.Choice.Id)]
        });
    }

    private IReadOnlyList<StudioDashboardGenerationTurn> SnapshotConversation() =>
        _turns
            .Select(turn => new StudioDashboardGenerationTurn(
                turn.Role == StudioConversationRole.You ? "user" : "assistant",
                turn.Body))
            .ToArray();

    private async Task GenerateAsync(StudioDashboardGenerationRequest request)
    {
        if (_editor is null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var outcome = await DashboardData.GenerateAsync(_editor, request);

            if (outcome.BindingState is not null)
            {
                // A true missing-binding kicks the whole surface to the blocked state; any other capability
                // issue is reported as a conversation note (the editor stays open for hand-authoring).
                if (string.Equals(outcome.BindingState.State, "Missing binding", StringComparison.OrdinalIgnoreCase))
                {
                    _bindingState = outcome.BindingState;
                    return;
                }

                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    $"{outcome.BindingState.Detail} (contract: {outcome.BindingState.Contract})",
                    "just now",
                    StudioConversationTone.Neutral));
                return;
            }

            var notes = outcome.Warnings.ToList();
            if (outcome.CapabilityState is { } capability
                && !string.Equals(capability.State, "supported", StringComparison.OrdinalIgnoreCase))
            {
                notes.Insert(0, $"{capability.Name}: {capability.State}{(string.IsNullOrWhiteSpace(capability.Reason) ? string.Empty : $" — {capability.Reason}")}");
            }

            if (outcome.IsGenerated)
            {
                // The generated honua.dashboard-document.v1 becomes a fresh, unsaved draft the operator
                // reviews and publishes from the editor/publish views.
                if (outcome.State is not null)
                {
                    _editor = outcome.State;
                    _selectedPanel = _editor.Panels.FirstOrDefault();
                }

                _clarifications.Clear();
                _dirty.MarkDirty();
                RecomputeClientErrors();

                var summary = string.IsNullOrWhiteSpace(outcome.Rationale)
                    ? $"Proposed a dashboard. {DescribeDraft(_editor!)}"
                    : outcome.Rationale;
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(summary, notes),
                    "just now",
                    StudioConversationTone.Ready,
                    "view evidence"));
            }
            else if (outcome.NeedsClarification)
            {
                _clarifications.Clear();
                _clarifications.AddRange(outcome.Clarifications);
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(
                        string.IsNullOrWhiteSpace(outcome.Rationale)
                            ? "I need a little more detail before I can propose the dashboard."
                            : outcome.Rationale,
                        notes),
                    "just now",
                    StudioConversationTone.Clarification));
            }
            else
            {
                // unsupported / refused / error
                _turns.Add(new StudioConversationTurn(
                    StudioConversationRole.Honua,
                    AppendNotes(
                        string.IsNullOrWhiteSpace(outcome.Rationale)
                            ? "I couldn't turn that into a dashboard."
                            : outcome.Rationale,
                        notes),
                    "just now",
                    StudioConversationTone.Neutral));
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private static string AppendNotes(string body, IReadOnlyList<string> notes) =>
        notes.Count == 0 ? body : $"{body}\n\nNotes:\n- {string.Join("\n- ", notes)}";

    private RenderFragment DashboardPreview(StudioDashboardEditorState editor) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "studio-dashboard-preview");
        builder.AddAttribute(seq++, "data-dashboard-preview", "true");

        if (editor.Panels.Count == 0)
        {
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "class", "console-muted");
            builder.AddContent(seq++, "No panels yet. Refine the prompt or open the editor to add a chart, map, table, or filter.");
            builder.CloseElement();
        }
        else
        {
            // KPI strip from filter/KPI-style panels (design handoff: a KPI strip above the chart + map).
            var charts = editor.Panels.Where(panel => panel.IsChart).ToList();
            var maps = editor.Panels.Where(panel => string.Equals(panel.Kind, StudioDashboardPanelKinds.Map, StringComparison.OrdinalIgnoreCase)).ToList();
            var tables = editor.Panels.Where(panel => string.Equals(panel.Kind, StudioDashboardPanelKinds.Table, StringComparison.OrdinalIgnoreCase)).ToList();

            // Chart + map row.
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "studio-dashboard-preview-row");

            foreach (var chart in charts)
            {
                builder.OpenElement(seq++, "article");
                builder.AddAttribute(seq++, "class", "studio-dashboard-preview-panel studio-dashboard-preview-chart");
                builder.AddAttribute(seq++, "data-preview-kind", "chart");
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "studio-dashboard-preview-panel-head");
                builder.OpenElement(seq++, "b");
                builder.AddContent(seq++, PanelLabel(chart));
                builder.CloseElement();
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "studio-vega-tag");
                builder.AddContent(seq++, "Vega-Lite");
                builder.CloseElement();
                builder.CloseElement();
                // The chart panel's live graph: ChartPreview renders the panel's Vega-Lite spec when the
                // server emitted one with chartable data, falling back to the schematic placeholder otherwise
                // (no fabricated data). The dashboard binds data via content refs rather than a direct layer,
                // so no features URL is supplied here — the chart plots the spec's own data.
                builder.OpenComponent<ChartPreview>(seq++);
                builder.AddComponentParameter(seq++, nameof(ChartPreview.Spec), chart.VegaLiteSpec);
                builder.AddComponentParameter(seq++, nameof(ChartPreview.Height), 200);
                builder.AddComponentParameter(seq++, nameof(ChartPreview.AriaLabel), $"{PanelLabel(chart)} chart");
                builder.CloseComponent();
                builder.CloseElement();
            }

            foreach (var map in maps)
            {
                builder.OpenElement(seq++, "article");
                builder.AddAttribute(seq++, "class", "studio-dashboard-preview-panel studio-dashboard-preview-map");
                builder.AddAttribute(seq++, "data-preview-kind", "map");
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "studio-dashboard-preview-panel-head");
                builder.OpenElement(seq++, "b");
                builder.AddContent(seq++, PanelLabel(map));
                builder.CloseElement();
                builder.CloseElement();
                builder.OpenComponent<MapPreview>(seq++);
                builder.AddComponentParameter(seq++, nameof(MapPreview.Mode), MapPreviewMode.Layer);
                builder.AddComponentParameter(seq++, nameof(MapPreview.Height), 200);
                builder.AddComponentParameter(seq++, nameof(MapPreview.ShowPopup), false);
                builder.AddComponentParameter(seq++, nameof(MapPreview.AriaLabel), $"{PanelLabel(map)} preview");
                builder.CloseComponent();
                builder.CloseElement();
            }

            builder.CloseElement(); // preview-row

            foreach (var table in tables)
            {
                builder.OpenElement(seq++, "article");
                builder.AddAttribute(seq++, "class", "studio-dashboard-preview-panel studio-dashboard-preview-table");
                builder.AddAttribute(seq++, "data-preview-kind", "table");
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "studio-dashboard-preview-panel-head");
                builder.OpenElement(seq++, "b");
                builder.AddContent(seq++, PanelLabel(table));
                builder.CloseElement();
                builder.CloseElement();
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "studio-canvas-placeholder");
                builder.AddContent(seq++, "table preview");
                builder.CloseElement();
                builder.CloseElement();
            }
        }

        builder.CloseElement(); // preview
    };

    private IReadOnlyList<PublishWizardStep> BuildPublishSteps(StudioDashboardEditorState editor, StudioDashboardPublishReadiness readiness) =>
    [
        new PublishWizardStep("Validate", ValidateStep(readiness), IsValid: readiness.CanPublish, ContinueLabel: "Continue · Dependencies →"),
        new PublishWizardStep("Dependencies", DependenciesStep(editor), ContinueLabel: "Continue · Visibility →"),
        new PublishWizardStep("Visibility", VisibilityStep(), ContinueLabel: "Continue · Embed →"),
        new PublishWizardStep("Embed", EmbedStep(), ContinueLabel: "Continue · Rollback →"),
        new PublishWizardStep("Rollback", RollbackStep(), ContinueLabel: "Continue · Confirm →"),
        new PublishWizardStep("Confirm", ConfirmStep(editor, readiness), IsValid: readiness.CanPublish && !editor.IsPublished),
    ];

    private RenderFragment ValidateStep(StudioDashboardPublishReadiness readiness) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "studio-publish-step");
        builder.AddAttribute(seq++, "data-publish-step", "validate");

        builder.OpenElement(seq++, "h3");
        builder.AddContent(seq++, "Validation");
        builder.CloseElement();

        if (readiness.CanPublish)
        {
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "class", "console-status console-state-success");
            builder.AddContent(seq++, "All pre-publish checks passed. Vega-Lite specs and panel bindings are resolved.");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "class", "console-warning");
            builder.AddContent(seq++, "Resolve these before publishing:");
            builder.CloseElement();
            builder.OpenElement(seq++, "ul");
            builder.AddAttribute(seq++, "class", "studio-compact-list");
            foreach (var requirement in readiness.UnmetRequirements)
            {
                builder.OpenElement(seq++, "li");
