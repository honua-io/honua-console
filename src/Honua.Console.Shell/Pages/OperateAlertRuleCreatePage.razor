@page "/operate/alerts/rules/new"
@using Honua.Console.Shell.Components
@inject IOperateAlertRulesDataSource RulesData
@inject IConsoleCapabilityManifest Capabilities
@inject IConsoleNotificationService Notifications
@inject NavigationManager Navigation

<ConsoleCapabilityGate Capability="@ConsoleCapabilityKeys.RealtimeAlerting"
                       Title="Realtime / geofence alerting is not available in this release"
                       Message="Alert-rule authoring is not advertised by the connected environment.">
<section class="console-page operate-alert-rule" data-alert-rule-create-page>
    <div class="console-page-heading">
        <p class="console-kicker">Operator workflow / Alert rules</p>
        <h1>Create alert rule</h1>
        <p>Creation always persists a disabled rule. Open it next to run an explicit test before enabling delivery.</p>
        <p><a href="@OperateAlertRulesRoutes.List">Back to alert rules</a></p>
    </div>

    <article class="console-panel">
        @if (_loading)
        {
            <ConsoleStateView Kind="loading" Kicker="Alert rules" Title="Checking alert-rule binding" Message="Checking the connected honua-server before opening the authoring form." />
        }
        else if (_binding is { } binding)
        {
            <ConsoleStateView Kind="@StateKind(binding.State)"
                              Kicker="@binding.State"
                              Title="Alert-rule creation is not bound"
                              Message="@(binding.Detail + " (contract: " + binding.Contract + ")")" />
        }
        else
        {
            <div class="studio-field-grid">
                <label><span>Service ID</span><input class="console-input" @bind="_serviceId" data-rule-service /></label>
                <label><span>Layer ID</span><input class="console-input" type="number" @bind="_layerId" data-rule-layer /></label>
                <label><span>Name</span><input class="console-input" @bind="_name" data-rule-name /></label>
                <label><span>Trigger type</span>
                    <select class="console-input" @bind="_triggerType" data-rule-trigger>
                        <option value="threshold">Threshold</option><option value="enter">Enter</option>
                        <option value="exit">Exit</option><option value="dwell">Dwell</option>
                    </select>
                </label>
                <label><span>Subject field</span><input class="console-input" @bind="_subject" data-rule-subject /></label>
                <label><span>Operator</span><input class="console-input" @bind="_operator" data-rule-operator /></label>
                <label><span>Threshold</span><input class="console-input" @bind="_threshold" data-rule-threshold /></label>
                <label><span>Geofence zone ID</span><input class="console-input" @bind="_zone" data-rule-zone /></label>
                <label><span>Dwell minutes</span><input class="console-input" type="number" @bind="_dwell" data-rule-dwell /></label>
                <label><span>Delivery channels</span><input class="console-input" @bind="_channels" data-rule-channels /></label>
            </div>
            <div class="console-action-row">
                <button class="console-button" type="button" disabled="@_saving" @onclick="CreateAsync" data-rule-create-submit>
                    @(_saving ? "Creating..." : "Create disabled rule")
                </button>
            </div>
            @if (_result?.BindingState is { } resultBinding)
            {
                <ConsoleStateView Kind="@StateKind(resultBinding.State)"
                                  Kicker="@resultBinding.State"
                                  Title="Rule was not created"
                                  Message="@(resultBinding.Detail + " (contract: " + resultBinding.Contract + ")")" />
            }
        }
    </article>
</section>
</ConsoleCapabilityGate>

@code {
    private string _serviceId = string.Empty;
    private int _layerId;
    private string _name = string.Empty;
    private string _triggerType = "threshold";
    private string _subject = string.Empty;
    private string _operator = ">";
    private string _threshold = string.Empty;
    private string _zone = string.Empty;
    private int? _dwell;
    private string _channels = "webhook";
    private bool _saving;
    private bool _loading = true;
    private OperateAlertRulesBindingState? _binding;
    private OperateAlertRuleSaveResult? _result;

    protected override async Task OnInitializedAsync()
    {
        if (Capabilities.IsAdvertised(ConsoleCapabilityKeys.RealtimeAlerting))
        {
            _binding = (await RulesData.GetRulesAsync()).BindingState;
        }

        _loading = false;
    }

    private OperateAlertRuleDraft Draft() => new(
        _serviceId, _layerId, _name, _triggerType,
        new OperateAlertRuleCondition(_subject, _operator, _threshold, string.Empty,
            string.IsNullOrWhiteSpace(_zone) ? null : _zone, _dwell),
        _channels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));

    private Task CreateAsync() => Notifications.RunGuardedAsync(async () =>
    {
        _result = await RulesData.CreateRuleAsync(Draft());
        if (_result.Succeeded)
        {
            Navigation.NavigateTo(OperateAlertRulesRoutes.Detail(_result.Rule!.RuleId));
        }
    }, busy => { _saving = busy; StateHasChanged(); }, "Couldn't create alert rule");

    private static string StateKind(string state) => state switch
    {
        OperateAlertRulesBindingState.Forbidden => "forbidden",
        OperateAlertRulesBindingState.Unsupported => "unsupported",
        _ => "missing"
    };
}
