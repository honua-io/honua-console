@page "/operate/connections/new/object-storage"
@inject IConsoleExportsClient Exports
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<UnsavedChangesGuard IsDirty="IsDirty" Message="You have an unsaved bucket connection. Leave this page and discard it?" />

<section class="console-page" data-object-storage-new>
    <ConsolePageHeading Title="Add object storage">
        <ChildContent>
            <p>Connect a bucket the way you connect a database. Honua reads it through a role you create in your own account, so no access keys are stored and Honua never edits your bucket policy.</p>
        </ChildContent>
        <Actions>
            <a class="console-button-link console-button-secondary" href="@Navigation.ToConsoleHref("/operate/connections/new")">Add a database instead</a>
        </Actions>
    </ConsolePageHeading>

    <ConsolePanel Title="Storage location" HeadingId="object-storage-bucket-heading">
        <div class="studio-field-grid">
            <label>
                <span>Connection name</span>
                <input class="console-input" disabled="@IsLocked" @bind="_name" @bind:event="oninput" @bind:after="OnEdit" placeholder="county-imagery" data-object-storage-field="name" />
            </label>
            <label>
                <span>Bucket</span>
                <input class="console-input" disabled="@IsLocked" @bind="_bucket" @bind:event="oninput" @bind:after="OnBucketEdit" placeholder="county-imagery-2026" data-object-storage-field="bucket" />
            </label>
            <label>
                <span>Prefix (optional)</span>
                <input class="console-input" disabled="@IsLocked" @bind="_prefix" @bind:event="oninput" @bind:after="OnBucketEdit" placeholder="orthophotos/" data-object-storage-field="prefix" />
            </label>
            <label>
                <span>Region</span>
                <input class="console-input" disabled="@IsLocked" @bind="_region" @bind:event="oninput" @bind:after="OnEdit" placeholder="us-west-2" data-object-storage-field="region" />
            </label>
            <label>
                <span>Description (optional)</span>
                <input class="console-input" disabled="@IsLocked" @bind="_description" @bind:event="oninput" @bind:after="OnEdit" data-object-storage-field="description" />
            </label>
        </div>
    </ConsolePanel>

    <ConsolePanel Title="Access role" HeadingId="object-storage-role-heading">
        <p>Create a read-only role named <code>@(_setup?.Value?.RoleNamePrefix ?? "honua-connection-")…</code> on this bucket. The quick-create link opens a template with the bucket, prefix and this installation's external id filled in.</p>
        <div class="console-action-row">
            <button type="button" class="console-button console-button-secondary" disabled="@(!HasBucket || _setupPending)" data-object-storage-setup @onclick="LoadSetupAsync">
                @(_setupPending ? "Preparing…" : "Get the quick-create link")
            </button>
        </div>
        @if (_setup is { IsAllowed: true, Value: { } setup })
        {
            <dl class="console-definition-list" data-object-storage-setup-result>
                <dt>External id</dt>
                <dd><code>@setup.ExternalId</code> <ConsoleCopyButton Text="@setup.ExternalId" Label="Copy external id" /></dd>
                @if (QuickCreateHref(setup) is { } quickCreate)
                {
                    <dt>Quick-create link</dt>
                    <dd><a href="@quickCreate" target="_blank" rel="noopener noreferrer" data-object-storage-quick-create>Create the role in your account</a></dd>
                }
            </dl>
        }
        else if (_setup is { } failed)
        {
            <OperateSectionStatusPanel Heading="Access role" Status="failed.Status" Message="@failed.Message" Detail="@failed.Detail" />
        }
        <div class="studio-field-grid">
            <label>
                <span>Role ARN</span>
                <input class="console-input" disabled="@IsLocked" @bind="_roleArn" @bind:event="oninput" @bind:after="OnEdit" placeholder="arn:aws:iam::123456789012:role/honua-connection-imagery" data-object-storage-field="role" />
            </label>
        </div>
    </ConsolePanel>

    <div class="console-action-row">
        <button type="button" class="console-button console-button-secondary" disabled="@(!IsComplete || _busy)" data-object-storage-test @onclick="TestAsync">Test</button>
        <button type="button" class="console-button" disabled="@(!IsComplete || _busy || IsCreated)" data-object-storage-create @onclick="CreateAsync">@(_busy ? "Working…" : "Add connection")</button>
        <a href="@Navigation.ToConsoleHref("/operate/connections")">Cancel</a>
    </div>

    @if (_test is { } test)
    {
        <div class="console-panel @(test.IsAllowed && test.Value!.IsHealthy ? "console-state-success" : "console-state-warning")" role="status" data-object-storage-test-result>
            <OperateSectionHeading Text="@(test.IsAllowed && test.Value!.IsHealthy ? "Bucket reachable" : "Bucket not reachable")" />
            <p>@(test.IsAllowed ? test.Value!.Message ?? "Honua listed one key in the bucket." : test.Message)</p>
        </div>
    }

    @if (_created is { } created)
    {
        @if (created.IsAllowed)
        {
            <div class="console-panel console-state-success" role="status" data-object-storage-created>
                <OperateSectionHeading Text="Connection added" />
                <a href="@Navigation.ToConsoleHref($"/operate/connections/{created.Value!.Id:D}/objects")">Browse @created.Value.Name</a>
            </div>
        }
        else
        {
            <div role="alert" data-object-storage-create-failed>
                <OperateSectionStatusPanel Heading="Connection not added" Status="created.Status" Message="@created.Message" Detail="@created.Detail" />
            </div>
        }
    }
</section>

@code {
    private string _name = string.Empty;
    private string _bucket = string.Empty;
    private string _prefix = string.Empty;
    private string _region = string.Empty;
    private string _roleArn = string.Empty;
    private string _description = string.Empty;
    private bool _busy;
    private bool _setupPending;
    private int _draftVersion;
    private int _bucketVersion;
    private OperateSectionResult<ObjectStorageSetupResponse>? _setup;
    private OperateSectionResult<ObjectStorageTestResponse>? _test;
    private OperateSectionResult<ObjectStorageConnectionResponse>? _created;

    private bool HasBucket => !string.IsNullOrWhiteSpace(_bucket);
    private bool IsComplete => HasBucket && !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_region)
        && !string.IsNullOrWhiteSpace(_roleArn) && _setup is { IsAllowed: true };
    private bool IsCreated => _created is { IsAllowed: true };
    // A create has a server-side effect, so the fields stay read-only while it runs and after it succeeds.
    private bool IsLocked => _busy || IsCreated;
    private bool IsDirty => !IsCreated
        && new[] { _name, _bucket, _prefix, _region, _roleArn, _description }.Any(value => !string.IsNullOrWhiteSpace(value));

    private ConsoleAgentPageContext AgentContext => new()
    {
        Route = "/operate/connections/new/object-storage",
        Unsaved = new()
        {
            ChangedFieldCount = IsCreated ? 0
                : new[] { _name, _bucket, _prefix, _region, _roleArn, _description }.Count(value => !string.IsNullOrWhiteSpace(value)),
            PendingOperationCount = (_busy ? 1 : 0) + (_setupPending ? 1 : 0)
        }
    };

    // Every edit starts a new draft, so a reply for the previous draft is dropped rather than shown.
    private void OnEdit()
    {
        _draftVersion++;
        _test = null;
        _created = null;
    }

    // The external id and quick-create link are bound to the bucket and prefix, so a change asks for a new link.
    private void OnBucketEdit()
    {
        _bucketVersion++;
        _setup = null;
        OnEdit();
    }

    private async Task LoadSetupAsync()
    {
        _setupPending = true;
        var version = _bucketVersion;
        try
        {
            var setup = await Exports.GetObjectStorageSetupAsync(_bucket.Trim(), _prefix.Trim());
            if (version == _bucketVersion)
            {
                _setup = setup;
            }
        }
        finally
        {
            _setupPending = false;
        }
    }

    private ObjectStorageConnectionRequest Draft() => new()
    {
        Name = _name.Trim(),
        Bucket = _bucket.Trim(),
        Prefix = _prefix.Trim(),
        Region = _region.Trim(),
        RoleArn = _roleArn.Trim(),
        ExternalId = _setup?.Value?.ExternalId ?? string.Empty,
        Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim()
    };

    private async Task TestAsync()
    {
        if (!IsComplete || _busy)
        {
            return;
        }

        _busy = true;
        var version = _draftVersion;
        try
        {
            var test = await Exports.TestObjectStorageAsync(Draft(), CancellationToken.None);
            if (version == _draftVersion)
            {
                _test = test;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // The create reply is always kept: the server may have created the connection even if the draft changed.
    private async Task CreateAsync()
    {
        if (IsCreated || !IsComplete || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            _created = await Exports.CreateObjectStorageAsync(Draft(), CancellationToken.None);
        }
        finally
        {
            _busy = false;
        }
    }


    // Only an absolute https link is offered; anything else from the server is not rendered as a link.
    private static string? QuickCreateHref(ObjectStorageSetupResponse setup) =>
        Uri.TryCreate(setup.QuickCreateUrl, UriKind.Absolute, out var uri) && uri.Scheme == Uri.UriSchemeHttps
            ? uri.AbsoluteUri
            : null;
}
