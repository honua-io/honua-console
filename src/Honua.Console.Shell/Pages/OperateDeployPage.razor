@page "/operate/deploy"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IConsoleDeployApprovalClient ApprovalClient
@inject IConsoleGitOpsReleaseClient ReleaseClient

@* OPERATE → DEPLOY — one governed flow for two capabilities, both hiding the gitops
   plumbing behind an approval + outcome surface (matching the AI-mode direction in #193/#200):

     1. Server version upgrade — detect the target environment's running Honua version,
        show the upgrade path, gate a no-op / downgrade, and approve the outcome of the
        governed deploy-control operation.
     2. Cross-environment metadata promotion — promote metadata/service+layer changes
        dev -> staging -> prod as an ordered, approved, rollback-able operation (the
        GitOps metadata release lifecycle, surfaced in full on the Releases page).

   console#290 (deploy cockpit completion): the honua-server deploy-control surface now
   exposes a paged, newest-first list endpoint (GET /api/v1/admin/deploy/operations, honua-
   server PR #2577) — the "All deploy operations" section below consumes it directly, so an
   operation no longer needs to be discovered only by hand-copying a deployOperationId off a
   release. The release-derived + operator-tracked id projection is kept as a documented
   fallback for an older server where the list route is unsupported (feature-detected: a
   404/501 there degrades this page to exactly its pre-#290 behavior). Raw PR/gitops
   mechanics live behind a Details toggle on each card, never on the primary surface. *@

<section class="console-page console-operate-page operate-deploy-page">
    <div class="console-page-heading operate-heading">
        <p class="console-kicker">Operator workflow</p>
        <h1>Deploy</h1>
        <p>
            Upgrade the target Honua server and promote metadata across environments as governed,
            approved, rollback-able operations. The gitops plumbing stays hidden — you approve the
            outcome here; the PR and reconcile details live behind a Details toggle.
        </p>
    </div>

    <nav class="operate-section-nav" aria-label="Deploy sections">
        <a href="#all-operations">All operations</a>
        <a href="#server-upgrade">Server upgrade</a>
        <a href="#cross-env-promote">Cross-environment promotion</a>
        <a href="#platform-release">Platform release</a>
        <a href="#deploy-approvals">Approvals queue</a>
    </nav>

    @* ── ALL DEPLOY OPERATIONS (console#290 AC1) ────────────────────────────── *@
    <section id="all-operations" class="operate-section" aria-labelledby="all-operations-heading">
        <div class="operate-section-heading">
            <div>
                <p class="console-kicker">Deploy cockpit</p>
                <h2 id="all-operations-heading">All deploy operations</h2>
                <p class="console-muted">
                    Every durable deploy-control operation the connected server reports, newest-first, with live
                    transitions when the realtime group is available and manual refresh otherwise. Selecting a row
                    binds its outcome below (server upgrade or cross-environment promotion).
                </p>
            </div>
        </div>
        <OperateDeployOperationsList SelectedOperationId="@_selectedOperationId" OnSelect="OnTrackedSelected" />
    </section>

    @* ── SERVER VERSION UPGRADE ─────────────────────────────────────────────── *@
    <section id="server-upgrade" class="operate-section" aria-labelledby="server-upgrade-heading">
        <div class="operate-section-heading">
            <div>
                <p class="console-kicker">Capability 1</p>
                <h2 id="server-upgrade-heading">Server version upgrade</h2>
                <p class="console-muted">
                    Detect this environment's running version (including when it is on an older Honua version)
                    and upgrade it to a newer container version. The upgrade is gated unless the target is behind
                    the requested version.
                </p>
            </div>
        </div>

        <OperateServerUpgradeCard UpgradeOperationId="@_upgradeOperationId"
            OnUpgradeActioned="OnApprovalActioned" />
    </section>

    @* ── CROSS-ENVIRONMENT METADATA PROMOTION ───────────────────────────────── *@
    @* Capability-gated depth (first-release cut-line): dev → staging → prod fleet promotion renders the
       first-class "unsupported" state until the deployment advertises cross-environment-promotion. The
       server-version upgrade capability above stays live (operate floor). *@
    <ConsoleCapabilityGate Capability="@ConsoleCapabilityKeys.CrossEnvironmentPromotion"
                           Title="Cross-environment promotion is not available in this release"
                           Message="Promoting metadata / service + layer changes across a dev → staging → prod fleet is a capability-gated depth feature. It is not advertised by the connected environment for this release and lights up here once enabled for your account.">
    <section id="cross-env-promote" class="operate-section" aria-labelledby="cross-env-heading">
        <div class="operate-section-heading">
            <div>
                <p class="console-kicker">Capability 2</p>
                <h2 id="cross-env-heading">Cross-environment promotion</h2>
                <p class="console-muted">
                    Promote metadata / service + layer changes across environments (dev → staging → prod) as an
                    ordered, approved, rollback-able operation. The full semantic diff, environment matrix, and
                    rollback readiness live on the release surface.
                </p>
            </div>
            <a class="console-button-link" href="@GitOpsReleaseRoutes.Releases" data-open-releases>
                Open releases
            </a>
        </div>

        @* AVAILABLE TO PROMOTE — the dev → staging → prod release proposals the operator can
           start, surfaced directly on the Deploy page so the promotion entry point is not hidden
           behind a separate page (information-rich approval surface, forms-light). Each row shows
           source → targets and the change count, and links into the governed release detail where
           the promotion is reviewed and approved. Server-owned proposals only; a missing/empty read
           renders the honest shared state, never seeded data. *@
        @if (!_promotionLoaded)
        {
            <OperateSectionStatusPanel Heading="Available to promote" Loading="true" />
        }
        else if (!_promotionProposals.IsAllowed)
        {
            <OperateSectionStatusPanel Heading="Available to promote"
                Status="_promotionProposals.Status" Message="@_promotionProposals.Message" />
        }
        else if (PromotionProposals.Count == 0)
        {
            <OperateSectionStatusPanel Heading="Available to promote" Empty="true"
                EmptyTitle="No promotions available"
                EmptyMessage="The connected server reported no metadata release proposals to promote across environments." />
        }
        else
        {
            <ul class="operate-deploy-promote-list" data-promote-available aria-label="Release proposals available to promote">
                @foreach (var proposal in PromotionProposals)
                {
                    <li class="operate-deploy-promote-row" data-promote-proposal="@proposal.ReleasePackageId">
                        <a class="operate-deploy-promote-link" href="@GitOpsReleaseRoutes.ReleaseDetail(proposal.ReleasePackageId)">
                            <span class="operate-deploy-promote-head">
                                <strong>@proposal.Title</strong>
                                <span class="console-status @(proposal.HasBlockingFindings ? "console-state-danger" : "console-state-success")">
                                    @(proposal.HasBlockingFindings ? "blocked" : "ready")
                                </span>
                            </span>
                            <span class="console-muted operate-deploy-promote-route">
                                <span class="console-mono">@proposal.SourceEnvironmentId</span>
                                <span aria-hidden="true">&rarr;</span>
                                <span class="console-mono">@(proposal.TargetEnvironmentIds.Count == 0 ? "none" : string.Join(", ", proposal.TargetEnvironmentIds))</span>
                                <span>&middot; @proposal.ChangedResources.Count semantic change@(proposal.ChangedResources.Count == 1 ? "" : "s")</span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }

        @* IN-FLIGHT PROMOTIONS — the governed deploy-control operations already promoting across
           environments (projected from release-derived + operator-tracked ids; this narrower,
           promotion-scoped view still uses the tracked-id projection rather than the unscoped
           "All deploy operations" list above). Selecting one binds its approve / outcome /
           rollback surface. *@
        @if (!_promotionLoaded)
        {
            <OperateSectionStatusPanel Heading="In-flight promotions" Loading="true" />
        }
        else
        {
            <OperateDeploymentProposalList Result="_promotions"
                SelectedOperationId="@_selectedOperationId"
                OnSelect="OnPromotionSelected" />

            @if (_selectedPromotionOperationId is { Length: > 0 } promotionOperationId)
            {
                <div class="operate-deploy-selected-outcome" data-promotion-outcome>
                    <OperateDeploymentApprovalPanel OperationId="@promotionOperationId"
                        OnActioned="OnApprovalActioned" />
                </div>
            }
        }
    </section>
    </ConsoleCapabilityGate>

    @* ── PLATFORM RELEASE (console#290 AC5) ─────────────────────────────────── *@
    <section id="platform-release" class="operate-section" aria-labelledby="platform-release-heading">
        <div class="operate-section-heading">
            <div>
                <p class="console-kicker">Capability 3</p>
                <h2 id="platform-release-heading">Platform release</h2>
                <p class="console-muted">
                    The declared platform release, co-versioning across serving/execution planes, and a Converge
                    action to actuate any skew. Approval-mediated — a created convergence lands in the approval
                    inbox, never a direct-execute bypass.
                </p>
            </div>
        </div>
        <OperatePlatformReleaseConvergeCard />
    </section>

    @* ── APPROVALS QUEUE (TRACK BY ID, FALLBACK) ────────────────────────────── *@
    @* Kept as a documented fallback: when the connected server does not yet expose the
       deploy-operations list (older build), "All deploy operations" above degrades to its
       Unsupported state and this manual/tracked path remains the only way to bind an
       operation's approval surface. *@
    <section id="deploy-approvals" class="operate-section" aria-labelledby="deploy-approvals-heading">
        <div class="operate-section-heading">
            <div>
                <p class="console-kicker">Human-in-the-loop</p>
                <h2 id="deploy-approvals-heading">Approvals queue</h2>
                <p class="console-muted">
                    Fallback for an older connected server that does not yet expose the deploy-operations list
                    above: track a paused deploy-control operation by its durable id (for example, the upgrade
                    operation id from devops actuation) to bind its approve / outcome / rollback surface here.
                </p>
            </div>
        </div>

        <div class="console-action-row operate-deploy-track">
            <label class="console-field">
                <span class="console-field-label">Deploy operation id</span>
                <input class="console-input" type="text" placeholder="e.g. deploy-op-2f8c"
                       data-track-operation-id
                       @bind="_trackOperationIdInput" />
            </label>
            <button class="console-button console-button-secondary" type="button"
                    disabled="@(string.IsNullOrWhiteSpace(_trackOperationIdInput))"
                    data-track-operation
                    @onclick="TrackOperationAsync">
                Track operation
            </button>
        </div>

        @if (!_promotionLoaded)
        {
            <OperateSectionStatusPanel Heading="Approvals queue" Loading="true" />
        }
        else
        {
            <OperateDeploymentProposalList Result="_tracked"
                SelectedOperationId="@_selectedOperationId"
                OnSelect="OnTrackedSelected" />
        }
    </section>
</section>

@code {
    /// <summary>
    /// A deploy-control operation id to pre-track on load (console#292 correlation-id chip deep
    /// link, e.g. <c>CorrelationIdRoutes.Resolve(CorrelationIdKind.OperationId, id)</c>). Kept
    /// as the tracked-id fallback path (console#290): a deep link tracks the id the same way the
    /// manual "Track operation" input does, for an older server where the deploy-operations
    /// list is unsupported.
    /// </summary>
    [SupplyParameterFromQuery(Name = "operationId")]
    public string? OperationId { get; set; }

    // The operator-tracked deploy-control operation ids — the tracked-id fallback path
    // (console#290) for an older server where the deploy-operations list is unsupported.
    private readonly List<string> _trackedOperationIds = new();
    private string _trackOperationIdInput = string.Empty;
    private bool _queryOperationIdTracked;

    private bool _promotionLoaded;

    // The dev → staging → prod release proposals available to promote, surfaced as the
    // promotion entry point. Read from the GitOps release client; a missing/empty read renders
    // the honest shared state. Captured from the same read that resolves release-derived deploy
    // operation ids so the page does not double-fetch the proposal list.
    private OperateSectionResult<IReadOnlyList<GitOpsReleaseProposal>> _promotionProposals =
        OperateSectionResult<IReadOnlyList<GitOpsReleaseProposal>>.Allowed([]);

    private OperateSectionResult<IReadOnlyList<DeployOperationProposal>> _promotions =
        OperateSectionResult<IReadOnlyList<DeployOperationProposal>>.Allowed([]);
    private OperateSectionResult<IReadOnlyList<DeployOperationProposal>> _tracked =
        OperateSectionResult<IReadOnlyList<DeployOperationProposal>>.Allowed([]);

    private string? _selectedOperationId;
    private string? _selectedPromotionOperationId;

    // The in-flight server-upgrade operation (a Deploy/Rollback-kind operation), bound into
    // the upgrade card so the governed outcome surface is shown there. Resolved from the
    // tracked operation set; null until an upgrade operation is being tracked.
    private string? _upgradeOperationId;

    protected override async Task OnInitializedAsync()
    {
        // A deep-linked operation id (console#292) tracks and selects it up front, exactly as
        // the manual "Track operation" input does, so the golden path from a correlation-id chip
        // lands directly on the operation's approval panel.
        if (!string.IsNullOrWhiteSpace(OperationId) && !_queryOperationIdTracked)
        {
            var id = OperationId.Trim();
            if (!_trackedOperationIds.Contains(id, StringComparer.Ordinal))
            {
                _trackedOperationIds.Add(id);
            }

            _queryOperationIdTracked = true;
        }

        await RefreshQueuesAsync();

        if (_queryOperationIdTracked && OperationId is { Length: > 0 })
        {
            var id = OperationId.Trim();
            var match = _tracked.Value?.FirstOrDefault(p => string.Equals(p.OperationId, id, StringComparison.Ordinal))
                ?? _promotions.Value?.FirstOrDefault(p => string.Equals(p.OperationId, id, StringComparison.Ordinal));
            if (match is not null)
            {
                OnTrackedSelected(match);
            }
        }
    }

    private async Task TrackOperationAsync()
    {
        var id = _trackOperationIdInput.Trim();
        if (id.Length == 0)
        {
            return;
        }

        if (!_trackedOperationIds.Contains(id, StringComparer.Ordinal))
        {
            _trackedOperationIds.Add(id);
        }

        _trackOperationIdInput = string.Empty;
        await RefreshQueuesAsync();
    }

    // Projects the in-flight queues from the deploy operation ids discovered on the release
    // operations in view, plus any operator-tracked ids. Classifies each operation into the
    // server-upgrade capability (Deploy/Rollback kind) or the cross-env promotion capability
    // (MetadataRelease kind). Keeps the queue honest (server-owned, no list endpoint) without
    // fabricating ids.
    private async Task RefreshQueuesAsync()
    {
        try
        {
            var releaseDerivedIds = await ResolveReleaseDeployOperationIdsAsync();
            var allIds = releaseDerivedIds
                .Concat(_trackedOperationIds)
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .Select(id => id.Trim())
                .Distinct(StringComparer.Ordinal)
                .ToArray();

            var pending = await ApprovalClient.ListPendingAsync(allIds);

            if (!pending.IsAllowed)
            {
                _promotions = pending;
                _tracked = pending;
                _upgradeOperationId = null;
                return;
            }

            var all = pending.Value ?? [];

            _promotions = OperateSectionResult<IReadOnlyList<DeployOperationProposal>>.Allowed(
                all.Where(p => p.IsMetadataPromotion).ToArray(),
                pending.PartialResult,
                pending.Message);

            _tracked = OperateSectionResult<IReadOnlyList<DeployOperationProposal>>.Allowed(
                all,
                pending.PartialResult,
                pending.Message);

            // Bind the most-recent in-flight server-upgrade operation into the upgrade card.
            _upgradeOperationId = all
                .Where(p => p.IsServerUpgrade)
                .OrderByDescending(p => p.IsAwaitingApproval)
                .ThenByDescending(p => p.UpdatedAt)
                .Select(p => p.OperationId)
                .FirstOrDefault();
        }
        finally
        {
            _promotionLoaded = true;
        }
    }

    private IReadOnlyList<GitOpsReleaseProposal> PromotionProposals => _promotionProposals.Value ?? [];

    private async Task<IReadOnlyList<string>> ResolveReleaseDeployOperationIdsAsync()
    {
        var proposals = await ReleaseClient.GetReleaseProposalsAsync();
        // Capture the proposal read for the "available to promote" surface. A denied read
        // (missing/unsupported/unavailable) is preserved so the section renders that state
        // honestly rather than an empty list.
        _promotionProposals = proposals;
        if (proposals is not { IsAllowed: true, Value: { } list } || list.Count == 0)
        {
            return [];
        }

        var details = await Task.WhenAll(list.Select(p => ReleaseClient.GetReleaseDetailAsync(p.ReleasePackageId)));
        return details
            .Where(d => d.IsAllowed && d.Value?.Operation is { DeployOperationId: { Length: > 0 } })
            .Select(d => d.Value!.Operation!.DeployOperationId!)
            .Distinct(StringComparer.Ordinal)
            .ToArray();
    }

    private void OnPromotionSelected(DeployOperationProposal proposal)
    {
        _selectedOperationId = proposal.OperationId;
        _selectedPromotionOperationId = proposal.OperationId;
    }

    private void OnTrackedSelected(DeployOperationProposal proposal)
    {
        _selectedOperationId = proposal.OperationId;
        if (proposal.IsMetadataPromotion)
        {
            _selectedPromotionOperationId = proposal.OperationId;
        }
        else if (proposal.IsServerUpgrade)
        {
            _upgradeOperationId = proposal.OperationId;
        }
    }

    private async Task OnApprovalActioned(DeployOperationProposal proposal)
    {
        // After an approve/rollback, refresh the queues so a now-terminal/submitted operation
        // drops out of the pending set.
        await RefreshQueuesAsync();
    }
}
