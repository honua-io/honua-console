@page "/operate/layers/{ResourceId}/filter"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@inject IOperateTransitionDataSource OperateData
@inject IConsoleLayerFilterOperation LayerFilter
@inject IConsoleNotificationService Notifications
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation

<ConsoleAgentContext Context="@AgentContext" />

<section class="console-page" data-filter-page>
    @if (_loading)
    {
        <p role="status">Loading layer…</p>
    }
    else if (_layer is null)
    {
        <MissingItemView Kind="layer" AreaLabel="Operate / Layers" />
    }
    else
    {
        @if (V4Enabled)
        {
            <ConsolePageHeading Title="@($"{_layer.Name} · permanent filter")">
                <ChildContent><p>Set the query filter applied to every read of this layer.</p></ChildContent>
                <Actions><LayerBackLink CanonicalResourceId="@_layer!.CanonicalResourceId" /></Actions>
            </ConsolePageHeading>
        }
        else
        {
            <div class="console-page-heading">
                <p class="console-kicker">Operate / Layers</p>
                <h1>@_layer.Name · permanent filter</h1>
                <p>Author the server-enforced query filter on layer @_layer.LayerId. honua-server applies the <strong>permanent filter</strong> to every read of this layer (queries, exports, map renders) and validates the expression against the layer schema. Send a bad expression and the server rejects it with a reason; clearing removes the constraint entirely.</p>
                <div class="console-detail-actions">
                    <a class="console-button-link" href="@Navigation.ToConsoleHref(ConsoleAgentLayerTool.LayerRoute(_layer!.CanonicalResourceId))" data-layer-detail-link>Back to layer</a>
                </div>
            </div>
        }

        @if (V4Enabled)
        {
            <ConsolePanel Title="Permanent filter" HeadingId="layer-filter-heading" Class="console-section">@Editor</ConsolePanel>
        }
        else
        {
            <section class="console-section">@Editor</section>
        }
    }
    <ConsoleConfirmDialog @ref="_confirm" />
</section>

@code {
    private bool V4Enabled => ServiceProvider.GetService<ConsoleV4Options>()?.Enabled == true;
    private RenderFragment Editor => @<div data-filter-panel>
            @if (!_filter.Bound)
            {
                <div class="@(V4Enabled ? "console-state console-state-warning" : "console-panel console-state-warning")" role="status" data-filter-unbound>
                    <p class="@(V4Enabled ? null : "console-kicker")">Unavailable</p>
                    <p>@_filter.Detail</p>
                </div>
            }
            else
            {
                <div class="@(V4Enabled ? null : "console-panel")" data-filter-current>
                    @if (!V4Enabled) { <p class="console-kicker">Current</p> }
                    @if (_filter.HasFilter)
                    {
                        <p>A permanent filter (<code>@_filter.Language</code>) is enforced on this layer.</p>
                    }
                    else
                    {
                        <p class="console-muted" data-filter-none>No permanent filter is saved on this layer — reads are unconstrained.</p>
                    }
                </div>

                <div class="console-field">
                    <label class="console-label" for="filter-language">Language</label>
                    <select id="filter-language" class="console-input" @bind="_editLanguage" aria-label="Filter language" data-filter-language>
                        <option value="arcgis-sql">arcgis-sql</option>
                        <option value="cql2-text">cql2-text</option>
                        <option value="cql2-json">cql2-json</option>
                    </select>
                </div>

                <div class="console-field">
                    <label class="console-label" for="filter-expression">Filter expression</label>
                    <textarea id="filter-expression" class="console-input console-textarea" rows="5"
                              @bind="_editExpression" aria-label="Filter expression" data-filter-expression
                              placeholder="status = 'active'"></textarea>
                    <p class="console-muted">Max 4096 characters. Validated server-side against the layer schema.</p>
                </div>

                <div class="console-action-row">
                    <button class="console-button" type="button" disabled="@_busy" @onclick="SaveAsync" data-filter-save>
                        @(_busy ? "Saving…" : "Save filter")
                    </button>
                    <button class="console-button console-button-secondary" type="button"
                            disabled="@(_busy || !_filter.HasFilter)" @onclick="ConfirmClear" data-filter-clear>
                        Clear filter
                    </button>
                </div>

                @if (_result is { } r)
                {
                    <div class="@(V4Enabled ? "console-state" : "console-panel") @(r.Succeeded ? "console-state-success" : "console-state-danger")" role="status" data-filter-result>
                        <p class="@(V4Enabled ? null : "console-kicker")">@r.State</p>
                        <p>@r.Detail</p>
                    </div>
                }
            }
    </div>;
    private string? _loadedResourceId;
    private long _generation;
    private bool _loading;
    private ConsoleAgentPageContext AgentContext =>
        ConsoleAgentLayerTool.Context(_layer, ResourceId, "filter", ChangedFields, _loading || _busy);

    [CascadingParameter] public ConsolePublicationLayerContext? PublicationContext { get; set; }

    [Parameter]
    public string ResourceId { get; set; } = string.Empty;

    private OperateServiceLayerProjection? _layer;
    private ConsoleLayerFilter _filter = ConsoleLayerFilter.Unbound("Loading…");
    private string _editExpression = string.Empty;
    private string _editLanguage = "arcgis-sql";
    private bool _busy;
    private ConsoleSetLayerFilterResult? _result;
    private ConsoleConfirmDialog? _confirm;

    private string _baselineExpression = string.Empty;
    private string _baselineLanguage = "arcgis-sql";
    private int ChangedFields => (_editExpression == _baselineExpression ? 0 : 1)
        + (_editLanguage == _baselineLanguage ? 0 : 1);

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedResourceId, ResourceId, StringComparison.Ordinal)) return;
        _loadedResourceId = ResourceId;
        var generation = ++_generation;
        var resourceId = ResourceId;
        _layer = null;
        _result = null;
        _busy = false;
        _editExpression = _baselineExpression = string.Empty;
        _editLanguage = _baselineLanguage = "arcgis-sql";
        _filter = ConsoleLayerFilter.Unbound("Loading…");
        _loading = true;
        var attempt = PublicationContext?.BeginRead(resourceId);
        try
        {
            var view = await OperateData.GetLayersViewAsync();
            if (generation != _generation) return;
            var exposures = view.FindExposures(resourceId);
            if (attempt is { } read) PublicationContext!.CompleteRead(read, exposures);
            _layer = exposures.FirstOrDefault()?.Layer;
            if (_layer is null) return;
            var filter = await LayerFilter.GetFilterAsync(_layer.LayerId);
            if (generation != _generation) return;
            _filter = filter;
            if (filter.Bound)
            {
                _editExpression = _baselineExpression = filter.Expression;
                _editLanguage = _baselineLanguage = filter.Language;
            }
        }
        finally
        {
            if (generation == _generation) _loading = false;
        }
    }

    private enum FilterWriteOperation { Save, Clear }

    private Task SaveAsync() => WriteFilterAsync(FilterWriteOperation.Save);

    private Task WriteFilterAsync(FilterWriteOperation operation)
    {
        if (_layer is null || _busy) return Task.CompletedTask;
        var layerId = _layer.LayerId;
        var generation = _generation;
        var expression = _editExpression;
        var language = _editLanguage;
        _result = null;
        return Notifications.RunGuardedAsync(
            async () =>
            {
                var result = operation == FilterWriteOperation.Clear
                    ? await LayerFilter.ClearFilterAsync(layerId)
                    : await LayerFilter.SaveFilterAsync(layerId, expression, language);
                if (generation != _generation) return;
                _result = result;
                if (!result.Succeeded) return;
                var filter = await LayerFilter.GetFilterAsync(layerId);
                if (generation != _generation) return;
                _filter = filter;
                if (!filter.Bound) return;
                // Preserve edits made while the submitted request was in flight.
                if (_editExpression == expression) _editExpression = filter.Expression;
                if (_editLanguage == language) _editLanguage = filter.Language;
                _baselineExpression = filter.Expression;
                _baselineLanguage = filter.Language;
            },
            setBusy: busy => { if (generation == _generation) { _busy = busy; StateHasChanged(); } },
            failureMessage: operation == FilterWriteOperation.Clear ? "Couldn't clear the filter" : "Couldn't save the filter");
    }

    private void ConfirmClear()
    {
        if (_confirm is null) return;
        var generation = _generation;
        _confirm.Open(
            title: "Clear the permanent filter?",
            onConfirm: () => generation == _generation ? ClearAsync() : Task.CompletedTask,
            body: "This removes the server-enforced query filter from this layer. All reads will be unrestricted until a new filter is set. This cannot be undone.",
            confirmLabel: "Clear filter");
    }

    private Task ClearAsync() => WriteFilterAsync(FilterWriteOperation.Clear);
}
