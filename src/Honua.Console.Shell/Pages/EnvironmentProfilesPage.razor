@page "/environments"
@inject IConsoleEnvironmentProfileStore Profiles
@inject IConsoleCapabilityManifest Capabilities

<section class="console-page">
    <div class="console-page-heading">
        <p class="console-kicker">Workspace settings</p>
        <h1>Environments</h1>
        <p>Choose the Honua Server you want to work with. Each environment keeps its own connection and saved workspace.</p>
    </div>

    <div class="console-toolbar">
        <a class="console-button" href="/environments/new">Connect to a server</a>
    </div>

    @if (_profiles.Count == 0)
    {
        <article class="console-panel">
            <h2>Connect to your first server</h2>
            <p class="console-muted">Add your server address, then sign in to access your data and maps.</p>
            <a class="console-button" href="/environments/new">Connect to a server</a>
        </article>
    }
    else
    {
        <div class="console-panel-grid">
            @foreach (var profile in _profiles)
            {
                var isActive = string.Equals(profile.Id, _activeProfile?.Id, StringComparison.Ordinal);
                var state = _states.GetValueOrDefault(profile.Id);

                <article class="console-panel @(isActive ? "console-panel-active" : string.Empty)">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">@profile.EnvironmentKind</p>
                            <h2>@profile.DisplayName</h2>
                        </div>
                        <div class="console-chip-row">
                            @if (state?.Trust is not null || state?.TrustBlocked == true)
                            {
                                <EnvironmentTrustBadge State="state" />
                            }
                            @if (isActive)
                            {
                                <span class="console-status">Active</span>
                            }
                        </div>
                    </div>

                    @if (profile.IsTenantScoped())
                    {
                        <TenancyPreviewNotice />
                    }

                    <dl class="console-definition-list">
                        <dt>Server</dt>
                        <dd>@profile.ServerBaseUri</dd>
                        <dt>Last used</dt>
                        <dd>@FormatLastConnected(state, isActive)</dd>
                    </dl>

                    <details class="console-connection-details">
                        <summary>Connection details</summary>
                        <dl class="console-definition-list">
                            @if (!string.IsNullOrWhiteSpace(profile.TenantId))
                            {
                                <dt>Tenant</dt>
                                <dd>@profile.TenantId</dd>
                            }
                            <dt>Access method</dt>
                            <dd>@(profile.Account.AuthMode == ConsoleAccountAuthMode.AccountRbac ? "Account sign-in" : profile.Account.AuthMode.ToString())</dd>
                            @if (profile.ClientCertificate.Enabled)
                            {
                                <dt>Certificate</dt>
                                <dd>@FormatCertificate(profile)</dd>
                            }
                        </dl>
                        <EnvironmentTransportIndicators Profile="profile" />
                    </details>

                    @if (state?.TrustBlocked == true)
                    {
                        <div class="console-panel console-status-danger" role="alert">
                            <strong>Connection blocked</strong>
                            <p class="console-muted">@(state.Trust?.SanitizedMessage ?? "The certificate changed and must be acknowledged or revalidated.")</p>
                        </div>
                    }

                    <div class="console-action-row">
                        <button class="console-button console-button-secondary" type="button" disabled="@isActive" @onclick="() => ActivateAsync(profile.Id)">Use Environment</button>
                        <span class="console-muted" data-browser-alt-note>
                            @(isActive
                                ? "Selected for this browser session. Server access depends on your sign-in and permissions."
                                : "Select this environment to use it in Console.")
                        </span>
                        <a href="@($"/environments/{profile.Id}")">Diagnostics</a>
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private IReadOnlyList<ConsoleEnvironmentProfile> _profiles = Array.Empty<ConsoleEnvironmentProfile>();
    private ConsoleEnvironmentProfile? _activeProfile;
    private readonly Dictionary<string, ConsoleEnvironmentState?> _states = new(StringComparer.Ordinal);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task ActivateAsync(string profileId)
    {
        await Profiles.ActivateProfileAsync(profileId);
        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(5));
        try
        {
            await Capabilities.RefreshAsync(timeout.Token);
        }
        catch (OperationCanceledException) when (timeout.IsCancellationRequested)
        {
            // The manifest is fail-closed during and after a timed-out environment switch.
        }
        catch
        {
            // A binding failure is rendered as unavailable by the capability gate; activation itself succeeded.
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _profiles = await Profiles.ListProfilesAsync();
        _activeProfile = await Profiles.GetActiveProfileAsync();
        _states.Clear();

        foreach (var profile in _profiles)
        {
            _states[profile.Id] = await Profiles.GetStateAsync(profile.Id);
        }
    }

    private static string FormatCertificate(ConsoleEnvironmentProfile profile)
    {
        if (!profile.ClientCertificate.Enabled)
        {
            return "No client certificate";
        }

        var reference = profile.ClientCertificate.Reference;
        return reference is null ? "Client certificate bound" : $"{reference.Kind}: {reference.Value}";
    }

    // A selected browser profile is not evidence of a successful server connection.
    // Prefer a recorded connection timestamp; otherwise describe selection only.
    private static string FormatLastConnected(ConsoleEnvironmentState? state, bool isActive)
    {
        if (state?.LastConnectedAt is { } connectedAt)
        {
            return connectedAt.ToString("yyyy-MM-dd HH:mm 'UTC'");
        }

        return isActive ? "Selected in this browser session" : "never";
    }
}
