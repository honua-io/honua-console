@inject NavigationManager ConsoleNavigation
@page "/operate/import/esri/storymap"
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@using Honua.Console.Shell.Validation
@implements IDisposable

@* #104 · Import StoryMap / Hub site → report content (screens-import-esri.jsx ImportStoryMap). P4.
   StoryMap/Hub intake (URL/export) → section/page → content-block mapping with fidelity badges, target
   content preview, "Create content →" CTA. The source-format JSON parse is deterministic Console-side work. *@

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have an unsaved StoryMap import. Leave this page and discard it?" />

<section class="console-page esri-import" data-esri-import="storymap">
    <EsriImportHeading Title="Import StoryMap / Hub site" Crumb="StoryMap / Hub">
        <Description>
            Convert a source story map or Hub / Open-Data site into Console content (a report + linked
            maps). P4 · lowest priority of the four.
        </Description>
        <Actions>
        <div class="console-button-row">
            <a class="console-button-ghost" href="@ConsoleNavigation.ToConsoleHref("/operate/import/esri")">Discard</a>
            <a class="console-button" href="@ConsoleNavigation.ToConsoleHref("/operate/publishing")">Create content →</a>
        </div>
        </Actions>
    </EsriImportHeading>

    <EsriImportPanel Title="Source StoryMap" HeadingId="esri-intake-heading">
        <EsriImportIntake Noun="StoryMap"
                          Kind="EsriContentKind.StoryMap"
                          Result="_result"
                          Parse="ParseStoryMap"
                          OnParsed="OnParsed"
                          Dirty="_dirty"
                          SampleJson="@EsriImportSampleDocuments.StoryMap"
                          SampleFileName="@EsriImportSampleDocuments.StoryMapFileName" />
    </EsriImportPanel>

    @if (_result is { } result)
    {
        <div class="esri-import__split">
            <div class="esri-import__mapping">
                <SourceTargetMappingTable AsPanel="true" Rows="result.Rows"
                                          Heading="Section → content mapping"
                                          Subhead="StoryMap section → Console report block"
                                          SourceHeader="Section"
                                          SourceTypeHeader="StoryMap block"
                                          TargetHeader="→ Console block" />
            </div>

            <EsriImportPreview Title="Target content preview">
                <div class="esri-story-preview" aria-label="Report content preview">
                    <div class="esri-story-preview__hero">
                        <span class="esri-story-preview__hero-title">@result.SuggestedName</span>
                    </div>
                    <p class="esri-story-preview__intro">Intro paragraph converted from the StoryMap text block…</p>
                    <div class="esri-story-preview__map">embedded map</div>
                    <div class="esri-story-preview__gallery">
                        <span></span><span></span>
                    </div>
                </div>
                <dl class="esri-import__facts">
                    <dt>Type</dt>
                    <dd>Report</dd>
                    <dt>Blocks in</dt>
                    <dd>@result.MappedCount of @result.Rows.Count (@result.DropCount dropped)</dd>
                    <dt>Linked maps</dt>
                    <dd>@LinkedMaps → map packages</dd>
                </dl>
                <p class="esri-callout esri-callout--warn">
                    Scroll-driven sidecar + swipe degrade to stepped / static.
                    @result.DropCount external embed@(result.DropCount == 1 ? string.Empty : "s") dropped (link kept in notes).
                </p>
            </EsriImportPreview>
        </div>
    }
    else
    {
        <ConsoleStateView HeadingLevel="2" Kind="empty"
                          Kicker="Import source content"
                          Title="Paste an export or enter a StoryMap URL"
                          Message="Choose an intake mode above to convert a source story map / Hub site into report content." />
    }
</section>

@code {
    private static readonly EsriContentImportParser Parser = new();

    private EsriConversionResult? _result;
    private readonly FormDirtyState _dirty = new();

    // The dirty flag is flipped by the child intake; re-render so the hosted <UnsavedChangesGuard/> sees it.
    protected override void OnInitialized() => _dirty.Changed += StateHasChanged;

    public void Dispose() => _dirty.Changed -= StateHasChanged;

    private int LinkedMaps => _result?.Rows.Count(r => r.SourceType.Contains("map", StringComparison.OrdinalIgnoreCase)) ?? 0;

    private static EsriParseOutcome ParseStoryMap(string json, string? sourceLabel) => Parser.ParseStoryMap(json, sourceLabel);

    private void OnParsed(EsriConversionResult result) => _result = result;
}
