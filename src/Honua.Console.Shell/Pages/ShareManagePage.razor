@page "/share/manage"
@using Honua.Console.Contracts
@using Honua.Console.Shell.Components
@using Honua.Console.Shell.Models
@using Honua.Console.Shell.Services
@using Honua.Console.Shell.Validation
@inject IShareAccessDataSource ShareData
@inject IConsoleCatalogClient Catalog

<UnsavedChangesGuard IsDirty="_dirty.IsDirty" Message="You have unsaved share configuration changes. Leave this page and discard them?" />

<section class="console-page share-manage" data-share-config>
    <div class="console-detail-heading">
        <div>
            <p class="console-kicker">Share <span class="console-crumb-sep">/</span> Link &amp; embed configuration</p>
            <h1>@(_share?.DisplayTitle ?? "Share access")</h1>
            <div class="console-chip-row" data-share-status-row>
                @if (_share is { } headerShare)
                {
                    <span class="console-status @(headerShare.IsPublic ? "console-state-success" : "console-state-neutral")" data-share-header-tier="@headerShare.AccessTier">@TierLabel(headerShare.AccessTier)</span>
                    @if (headerShare.EmbedEnabled)
                    {
                        <span class="console-status console-state-info" data-share-header-embed>embed enabled</span>
                    }
                    @if (headerShare.OpenDataEligible)
                    {
                        <span class="console-status console-state-success" data-share-header-opendata>open-data eligible</span>
                    }
                    <span class="console-muted">@(headerShare.IsPublic ? "reachable by anyone with the link" : "membership-scoped read")</span>
                }
                else
                {
                    <span class="console-muted">Open a content item to manage its public link, embed, open-data page, and exports.</span>
                }
            </div>
        </div>
        <div class="console-detail-actions">
            <form class="console-action-row" @onsubmit="OpenItem" @formname="open-share-item">
                <label class="studio-form-label">
                    <span>Content item id</span>
                    <input class="console-input" @bind="_itemIdInput" @bind:after="OnItemIdEdit" placeholder="item-..." />
                    <ValidationMessageInline FieldKey="@ShareManageFieldKeys.ItemId" State="_validation" />
                </label>
                <button class="console-button" type="submit" disabled="@(_busy || _validation.Errors(ShareManageFieldKeys.ItemId).Any(e => e.IsBlocking))">Open share access</button>
            </form>
        </div>
    </div>

    <p class="console-muted share-manage-lede">Manage a content item's server-owned Share access: public/private visibility, public-link tokens with expiration, embed enablement and embed tokens, dependency-closure safety, and open-data eligibility. State is authored on honua-server's Console Share access API and is never resolved client-side.</p>

    @if (_share is not null)
    {
        <nav class="console-tab-row" data-share-tabs aria-label="Share configuration tabs">
            @foreach (var tab in Tabs)
            {
                <button type="button"
                        class="@TabClass(tab.Id)"
                        data-share-tab="@tab.Id"
                        @onclick="() => SetTab(tab.Id)">
                    @tab.Label
                </button>
            }
        </nav>
    }

    @if (_loading)
    {
        <ConsoleStateView Kind="loading"
                          Kicker="Share access"
                          Title="Loading share access"
                          Message="Reading the Console Share access projection from honua-server." />
    }
    else if (_bindingState is not null)
    {
        <ConsoleStateView Kind="error"
                          Kicker="@_bindingState.State"
                          Title="Share access API is not bound"
                          Message="@($"{_bindingState.Detail} (contract: {_bindingState.Contract})")" />
    }
    else if (_notFoundState is not null)
    {
        <ConsoleStateView Kind="missing"
                          Kicker="@_notFoundState.State"
                          Title="Share access not found"
                          Message="@($"{_notFoundState.Detail} (contract: {_notFoundState.Contract})")" />
    }
    else if (_share is null && !_attempted)
    {
        <EmptyState Area="share" Subject="share access" />
    }
    else
    {
        <div class="share-config-layout" data-share-layout>
        <div class="share-config-main">
        @if (_commandStates.Count > 0)
        {
            <section class="console-section">
                <div class="console-page-heading">
                    <p class="console-kicker">Share binding</p>
                    <h2>Server Capability States</h2>
                </div>
                <div class="console-panel-grid">
                    @foreach (var state in _commandStates)
                    {
                        <article class="console-panel" data-share-capability="@state.State">
                            <div class="console-panel-heading">
                                <div>
                                    <p class="console-kicker">@state.State</p>
                                    <h2>@state.Surface</h2>
                                </div>
                            </div>
                            <p class="console-muted">@state.Detail</p>
                            <dl class="console-definition-list">
                                <dt>Contract</dt>
                                <dd>@state.Contract</dd>
                            </dl>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_blockedBy is { } blocked)
        {
            <section class="console-section" data-share-blocked="@blocked.TargetTier">
                <article class="console-panel console-panel-warning">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Dependency closure</p>
                            <h2>@($"Cannot share by '{blocked.TargetTier}'")</h2>
                        </div>
                        <span class="console-status console-status-warning">blocked</span>
                    </div>
                    <p class="console-muted">The item's provenance closure has dependencies that are not shareable by the target audience. Resolve or override the conflicts below before sharing.</p>
                    <div class="console-table-wrap">
                        <table class="console-table">
                            <thead>
                                <tr>
                                    <th>Dependency</th>
                                    <th>Type</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var conflict in blocked.Conflicts)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrWhiteSpace(conflict.ItemName) ? conflict.ItemId : conflict.ItemName)</td>
                                        <td>@(conflict.ItemType ?? "—")</td>
                                        <td>@conflict.BlockingReason</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            </section>
        }

        @if (_mintedSecret is { } secret)
        {
            <section class="console-section" data-share-minted="@secret.Kind">
                <article class="console-panel console-panel-emphasis">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">@(secret.Kind == "embed" ? "Embed token" : "Public-link token")</p>
                            <h2>Copy this token now</h2>
                        </div>
                    </div>
                    <p class="console-muted">This value is shown only once — honua-server never re-discloses it. Store it now; reference the token later by its id (@secret.TokenId).</p>
                    <pre class="console-code" data-share-secret-value>@secret.Token</pre>
                    @if (secret.ExpiresAt is { } expiry)
                    {
                        <p class="console-muted">Expires @expiry.ToString("yyyy-MM-dd HH:mm 'UTC'").</p>
                    }
                </article>
            </section>
        }

        @if (_share is { } share)
        {
            <section class="console-section" data-share-access="@share.ItemId">
                <article class="console-panel">
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">@($"{share.ItemType} · {share.ItemId}")</p>
                            <h2>@share.DisplayTitle</h2>
                        </div>
                        <span class="console-status @(share.IsPublic ? "console-status-public" : string.Empty)" data-share-tier="@share.AccessTier">@TierLabel(share.AccessTier)</span>
                    </div>
                    <dl class="console-definition-list">
                        <dt>Visibility</dt>
                        <dd data-share-visibility>@(share.IsPublic ? "Public" : "Private / membership-scoped")</dd>
                        <dt>Anonymous access</dt>
                        <dd>@(share.AnonymousEligible ? "An anonymous caller can read this item" : "No anonymous access")</dd>
                        <dt>Open data</dt>
                        <dd>@(share.OpenDataEligible ? "Eligible for open-data distribution" : "Not open-data eligible")</dd>
                        <dt>Embedding</dt>
                        <dd>@(share.EmbedEnabled ? $"Enabled ({share.EmbedAudience})" : "Disabled")</dd>
                        @if (share.OwnerId is not null)
                        {
                            <dt>Owner</dt>
                            <dd>@share.OwnerId</dd>
                        }
                        @if (share.UpdatedAt is { } updated)
                        {
                            <dt>Updated</dt>
                            <dd>@updated.ToString("yyyy-MM-dd HH:mm 'UTC'") @(share.UpdatedById is null ? string.Empty : $"by {share.UpdatedById}")</dd>
                        }
                    </dl>
                </article>

                @if (share.CanShare && _tab == "link")
                {
                    <article class="console-panel" data-share-panel="access-tier">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Access tier</p>
                                <h3>Public / private state</h3>
                            </div>
                        </div>
                        <p class="console-muted">Changing to public-link or public-indexed is dependency-closure validated. public-indexed makes the item publicly readable and open-data eligible.</p>
                        <div class="console-button-row">
                            @foreach (var tier in AccessTiers)
                            {
                                <button class="console-button @(string.Equals(tier, share.AccessTier, StringComparison.Ordinal) ? "console-button-active" : string.Empty)"
                                        type="button"
                                        disabled="@_busy"
                                        @onclick="() => ChangeTier(share.ItemId, tier)">
                                    @TierLabel(tier)
                                </button>
                            }
                        </div>
                        <div class="console-button-row">
                            @foreach (var tier in PublicTiers)
                            {
                                <button class="console-button console-button-ghost"
                                        type="button"
                                        disabled="@_busy"
                                        @onclick="() => PreviewDependencies(share.ItemId, tier)">
                                    Preview closure for @TierLabel(tier)
                                </button>
                            }
                        </div>
                        @if (_lastClosure is { } closure && closure.IsCompatible)
                        {
                            <p class="console-success" data-share-closure-ok="@closure.TargetTier">Provenance closure is shareable by @TierLabel(closure.TargetTier).</p>
                        }
                    </article>
                }

                @if (share.IsPublic && share.CanShare && _tab == "link")
                {
                    <article class="console-panel" data-share-panel="public-link">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Public links</p>
                                <h3>Token links @(share.PublicLinkEnabled ? "(active)" : "(none active)")</h3>
                            </div>
                        </div>
                        <form class="console-toolbar" @onsubmit="() => MintPublicLink(share.ItemId)" @formname="mint-public-link">
                            <label class="studio-form-label">
                                <span>Expires (UTC, optional)</span>
                                <input class="console-input" type="datetime-local" @bind="_expiresAtInput" @bind:after="OnExpiresEdit" />
                                <ValidationMessageInline FieldKey="@ShareManageFieldKeys.ExpiresAt" State="_validation" />
                            </label>
                            <button class="console-button" type="submit" disabled="@(_busy || _validation.Errors(ShareManageFieldKeys.ExpiresAt).Any(e => e.IsBlocking))">Mint public-link token</button>
                        </form>
                        @if (share.PublicLinkTokens.Count == 0)
                        {
                            <p class="console-muted">No public-link tokens minted yet.</p>
                        }
                        else
                        {
                            <div class="console-table-wrap">
                                <table class="console-table">
                                    <thead>
                                        <tr>
                                            <th>Token id</th>
                                            <th>Created</th>
                                            <th>Expires</th>
                                            <th>Status</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var token in share.PublicLinkTokens)
                                        {
                                            <tr data-share-token="@token.TokenId">
                                                <td><small>@token.TokenId</small></td>
                                                <td>@token.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</td>
                                                <td>@(token.ExpiresAt is { } e ? e.ToString("yyyy-MM-dd HH:mm 'UTC'") : "never")</td>
                                                <td>@(token.IsExpired ? "expired/revoked" : "active")</td>
                                                <td>
                                                    @if (!token.IsExpired)
                                                    {
                                                        <button class="console-button console-button-ghost"
                                                                type="button"
                                                                disabled="@_busy"
                                                                @onclick="() => RevokePublicLink(share.ItemId, token.TokenId)">
                                                            Revoke
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </article>
                }

                @if (share.CanEmbed && _tab == "embed")
                {
                    <article class="console-panel" data-share-panel="embed">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Embed</p>
                                <h3>Embed status @(share.EmbedEnabled ? "(enabled)" : "(disabled)")</h3>
                            </div>
                        </div>
                        <p class="console-muted">Enabling embedding exposes the item to an external surface and is dependency-closure validated at public-link strength. Embed tokens always carry a TTL and travel in the iframe URL fragment (#embedToken=), never the query string.</p>
                        @if (!share.EmbedEnabled)
                        {
                            <div class="console-button-row">
                                <button class="console-button" type="button" disabled="@_busy" @onclick="() => SetEmbed(share.ItemId, true, HonuaConsoleEmbedAudiences.Map)">Enable map embed</button>
                                <button class="console-button" type="button" disabled="@_busy" @onclick="() => SetEmbed(share.ItemId, true, HonuaConsoleEmbedAudiences.Content)">Enable content embed</button>
                            </div>
                        }
                        else
                        {
                            <div class="console-button-row">
                                <button class="console-button console-button-ghost" type="button" disabled="@_busy" @onclick="() => SetEmbed(share.ItemId, false, null)">Disable embedding</button>
                                <button class="console-button" type="button" disabled="@_busy" @onclick="() => MintEmbedToken(share.ItemId, share.EmbedAudience!)">Mint embed token</button>
                            </div>
                        }
                    </article>
                }

                @if (_tab == "opendata")
                {
                    <article class="console-panel" data-share-panel="opendata">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Open-data page</p>
                                <h3>Public landing @(share.OpenDataEligible ? "(eligible)" : "(not eligible)")</h3>
                            </div>
                            <span class="console-status @(share.OpenDataEligible ? "console-state-success" : "console-state-neutral")">@(share.OpenDataEligible ? "live" : "off")</span>
                        </div>
                        <p class="console-muted">When the item is public-indexed, honua-server serves a public open-data landing page with description, license, contact, download links, DCAT metadata, and schema.org/Dataset JSON-LD. Eligibility, downloads, license, and discoverability are server-owned and follow the access tier — Console authors them here and never fabricates open-data content.</p>

                        @if (!share.OpenDataEligible)
                        {
                            <p class="console-muted">Set the access tier to <strong>public-indexed</strong> on the Public link tab to enable the open-data landing page editor.</p>
                        }
                        else if (_detailMissingBinding)
                        {
                            <ConsoleStateView Kind="error"
                                              Kicker="Missing binding"
                                              Title="Open-data metadata is not bound to honua-server"
                                              Message="@OpenDataMissingBindingMessage" />
                        }
                        else if (_detail is null)
                        {
                            <ConsoleStateView Kind="loading"
                                              Kicker="Open data"
                                              Title="Loading open-data metadata"
                                              Message="Reading the server-owned content metadata projection for this item." />
                        }
                        else
                        {
                            var detail = _detail;
                            var summary = detail.Summary;
                            <div class="share-opendata-editor" data-share-opendata-editor>
                                <div class="share-opendata-editor-pane" data-share-opendata-fields>
                                    <section class="console-field-group" data-share-opendata-section="identity">
                                        <p class="console-kicker">Page identity</p>
                                        <span class="console-muted">From canonical metadata</span>
                                        <dl class="console-definition-list">
                                            <dt>Title</dt>
                                            <dd data-share-opendata-title>@summary.Title</dd>
                                            <dt>Slug</dt>
                                            <dd><code class="console-inline-code">@SlugOrId(summary)</code></dd>
                                            <dt>Description</dt>
                                            <dd>@(string.IsNullOrWhiteSpace(detail.Description) ? "—" : detail.Description)</dd>
                                        </dl>
                                        <label class="studio-form-label" data-share-opendata-hero>
                                            <span>Page hero</span>
                                            <div class="console-button-row">
                                                <button class="console-button console-button-ghost" type="button" disabled
                                                        title="Open-data page hero authoring is not bound yet; no honua-server contract is exposed.">Upload…</button>
                                                <button class="console-button console-button-ghost" type="button" disabled
                                                        title="Open-data page hero authoring is not bound yet; no honua-server contract is exposed.">Use map preview</button>
                                            </div>
                                        </label>
                                        <label class="studio-form-label" data-share-opendata-intro>
                                            <span>Page intro (markdown · 1–2 paragraphs)</span>
                                            <textarea class="console-input" rows="3" readonly>@detail.Description</textarea>
                                        </label>
                                    </section>

                                    <section class="console-field-group" data-share-opendata-section="downloads">
                                        <p class="console-kicker">Downloads</p>
                                        <span class="console-muted">Formats consumers can grab</span>
                                        <div class="share-opendata-format-list" data-share-opendata-formats>
                                            @foreach (var format in OpenDataFormats)
                                            {
                                                var published = IsFormatPublished(summary, format.Key);
                                                <label class="share-opendata-format" data-share-opendata-format="@format.Key">
                                                    <input type="checkbox" checked="@published" disabled />
                                                    <span class="share-opendata-format-name">@format.Label</span>
                                                    <span class="console-muted">@format.Hint</span>
                                                </label>
                                            }
                                        </div>
                                        <dl class="console-definition-list">
                                            <dt>Generate strategy</dt>
                                            <dd>On-demand · cache for 7 days</dd>
                                            <dt>Last regenerated</dt>
                                            <dd>@summary.Modified.ToString("yyyy-MM-dd HH:mm 'UTC'")</dd>
                                        </dl>
                                    </section>

                                    <section class="console-field-group" data-share-opendata-section="license">
                                        <p class="console-kicker">License &amp; contact</p>
                                        <span class="console-muted">From canonical metadata · editable here</span>
                                        <dl class="console-definition-list">
                                            <dt>License</dt>
                                            <dd>@LicenseFor(detail)</dd>
                                            <dt>Attribution</dt>
                                            <dd>@AttributionFor(detail, summary)</dd>
                                            <dt>Contact</dt>
                                            <dd>@ContactFor(detail)</dd>
                                        </dl>
                                    </section>

                                    <section class="console-field-group" data-share-opendata-section="discoverability">
                                        <p class="console-kicker">Discoverability</p>
                                        <div class="console-chip-row" data-share-opendata-tags>
                                            @foreach (var tag in summary.Tags)
                                            {
                                                <span class="console-status console-state-neutral">#@tag</span>
                                            }
                                            @if (summary.Tags.Length == 0)
                                            {
                                                <span class="console-muted">No tags published.</span>
                                            }
                                        </div>
                                        <label class="console-checkbox-row" data-share-opendata-dcat>
                                            <input type="checkbox" checked="@share.OpenDataEligible" disabled />
                                            <span>Register in DCAT catalog</span>
                                        </label>
                                        <label class="console-checkbox-row" data-share-opendata-jsonld>
                                            <input type="checkbox" checked="@share.OpenDataEligible" disabled />
                                            <span>Embed JSON-LD · schema.org/Dataset (helps Google Dataset Search)</span>
                                        </label>
                                        <label class="console-checkbox-row" data-share-opendata-stac>
                                            <input type="checkbox" checked="@share.OpenDataEligible" disabled />
                                            <span>Publish STAC item / collection (SpatioTemporal Asset Catalog)</span>
                                        </label>
                                        <p class="console-muted">DCAT, schema.org/Dataset JSON-LD, and STAC publication are server-owned and emitted by honua-server when the item is public-indexed. Toggles reflect the server projection.</p>
                                    </section>

                                    <div class="console-action-row">
                                        <a class="console-button console-button-secondary" data-share-opendata-link href="/share/public/items/@share.ItemId">Open public landing ↗</a>
                                    </div>
                                </div>

                                <aside class="share-opendata-editor-pane share-opendata-preview" data-share-opendata-preview>
                                    <p class="console-kicker">Live preview</p>
                                    <div class="share-opendata-preview-card">
                                        <div class="share-opendata-preview-head">
                                            <div class="console-muted">honua / data / @SlugOrId(summary)</div>
                                            <div class="share-opendata-preview-title">@summary.Title</div>
                                            <div class="console-chip-row">
                                                @foreach (var tag in summary.Tags)
                                                {
                                                    <span class="console-status console-state-neutral">#@tag</span>
                                                }
                                            </div>
                                        </div>
                                        <p class="share-opendata-preview-intro">@(string.IsNullOrWhiteSpace(detail.Description) ? "—" : detail.Description)</p>
                                        <div class="share-opendata-preview-downloads">
                                            <p class="console-kicker">Download</p>
                                            @if (summary.Formats.Length == 0)
                                            {
                                                <p class="console-muted">No downloadable formats published.</p>
                                            }
                                            else
                                            {
                                                <ul class="share-opendata-download-list">
                                                    @foreach (var format in summary.Formats)
                                                    {
                                                        <li>
                                                            <span class="share-opendata-download-name">@format</span>
                                                            <span class="console-muted">↓</span>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                        <div class="share-opendata-preview-foot console-muted">
                                            License: @LicenseFor(detail) · Contact: @ContactFor(detail)<br />
                                            powered by Honua · public open-data
                                        </div>
                                    </div>
                                </aside>
                            </div>
                        }
                    </article>
                }

                @if (_tab == "exports")
                {
                    <article class="console-panel" data-share-panel="exports">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Exports</p>
                                <h3>Scheduled exports</h3>
                            </div>
                            <div class="console-button-row">
                                <button class="console-button console-button-ghost" type="button" disabled
                                        title="Scheduled exports are authored on honua-server; the export registry contract is not bound yet.">Run now</button>
                                <button class="console-button" type="button" disabled
                                        title="Scheduled exports are authored on honua-server; the export registry contract is not bound yet.">+ New export</button>
                            </div>
                        </div>
                        <p class="console-muted">Scheduled exports to S3, SFTP, webhook targets, and audit snapshots run as honua-server jobs. They are authored and monitored on the unified Console runtime; export runs and history surface in Operate jobs and the Event viewer. The scheduled-export registry is server-owned — Console renders it from honua-server and never fabricates export rows.</p>

                        <div class="console-table-wrap" data-share-exports-table>
                            <table class="console-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col">Target</th>
                                        <th scope="col">Format</th>
                                        <th scope="col">Filter</th>
                                        <th scope="col">Schedule</th>
                                        <th scope="col">Last run</th>
                                        <th scope="col">State</th>
                                        <th scope="col"><span class="console-visually-hidden">Actions</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_exports.Count == 0)
                                    {
                                        <tr data-share-exports-empty>
                                            <td colspan="8" class="console-muted">No scheduled exports are registered on honua-server for this item. Use “+ New export” to create one once the export registry contract is bound.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var export in _exports)
                                        {
                                            <tr data-share-export="@export.Id" data-share-export-target-kind="@export.TargetKind">
                                                <td><strong>@export.Name</strong></td>
                                                <td><code class="console-inline-code">@export.Target</code></td>
                                                <td>@export.Format</td>
                                                <td class="console-muted">@export.Filter</td>
                                                <td><code class="console-inline-code">@export.Schedule</code></td>
                                                <td class="console-muted">@export.LastRun</td>
                                                <td><span class="console-status @StateClass(export.State)" data-share-export-state="@export.State">@StateLabel(export.State)</span></td>
                                                <td><button class="console-button console-button-ghost" type="button" disabled
                                                        title="Scheduled exports are authored on honua-server; the export registry contract is not bound yet.">Edit</button></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="console-action-row">
                            <a class="console-button console-button-secondary" data-share-exports-link href="/operate/jobs?itemId=@share.ItemId">View export jobs in Operate ↗</a>
                        </div>
                        <p class="console-muted">Exports run as scheduled jobs · token rotations and connection failures surface as alerts in the Event viewer.</p>
                    </article>
                }

                @if (_tab == "audit")
                {
                    <article class="console-panel" data-share-panel="audit">
                        <div class="console-panel-heading">
                            <div>
                                <p class="console-kicker">Audit &amp; traffic</p>
                                <h3>Governed surface</h3>
                            </div>
                        </div>
                        <p class="console-muted">Share is a governed surface: every visibility, embed, and token change emits an audit event, and token links log the issuer. Request and traffic counters for shared content are server-owned and stream from honua-server.</p>
                        <div class="console-action-row">
                            <a class="console-button console-button-secondary" data-share-audit-link href="/operate/events?itemId=@share.ItemId">Open audit events ↗</a>
                        </div>
                    </article>
                }
            </section>
        }
        </div>

        <aside class="share-config-side" data-share-sidebar>
            <article class="console-panel console-panel-emphasis">
                <div class="console-panel-heading">
                    <div>
                        <p class="console-kicker">Governance</p>
                        <h3>Share is a governed surface</h3>
                    </div>
                </div>
                <p class="console-muted">Every change here emits an audit event and propagates immediately. Token links log the issuer and reason. Disable search-engine indexing by moving below the public-indexed tier to deindex on the next crawl.</p>
            </article>

            @if (_share is { } sideShare)
            {
                <article class="console-panel" data-share-side-summary>
                    <div class="console-panel-heading">
                        <div>
                            <p class="console-kicker">Public visibility</p>
                            <h3>What external users see</h3>
                        </div>
                    </div>
                    <dl class="console-definition-list">
                        <dt>Audience</dt>
                        <dd>@(sideShare.IsPublic ? "Anyone with the link" : "Workspace members only")</dd>
                        <dt>Anonymous read</dt>
                        <dd>@(sideShare.AnonymousEligible ? "Allowed" : "Blocked")</dd>
                        <dt>Embed</dt>
                        <dd>@(sideShare.EmbedEnabled ? $"Enabled ({sideShare.EmbedAudience})" : "Disabled")</dd>
                        <dt>Open data</dt>
                        <dd>@(sideShare.OpenDataEligible ? "Published" : "Not published")</dd>
                    </dl>
                </article>
            }
        </aside>
        </div>
    }
</section>

@code {
    private static readonly string[] AccessTiers =
    [
        HonuaConsoleShareAccessTiers.Private,
        HonuaConsoleShareAccessTiers.Organization,
        HonuaConsoleShareAccessTiers.PublicLink,
        HonuaConsoleShareAccessTiers.PublicIndexed
    ];

    private static readonly string[] PublicTiers =
    [
        HonuaConsoleShareAccessTiers.PublicLink,
        HonuaConsoleShareAccessTiers.PublicIndexed
    ];

    private static readonly (string Id, string Label)[] Tabs =
    [
        ("link", "Public link"),
        ("embed", "Embed"),
        ("opendata", "Open-data page"),
        ("exports", "Exports"),
        ("audit", "Audit & traffic")
    ];

    // Canonical open-data download formats per the screens-share.jsx ShareOpenDataPage editor. A format's
    // checkbox is checked only when the server-owned content projection actually publishes it; Console never
    // invents downloads (Console Patterns Charter section 11).
    private static readonly (string Key, string Label, string Hint)[] OpenDataFormats =
    [
        ("geojson", "GeoJSON", "whole dataset"),
        ("geopackage", "GeoPackage", "OGC standard"),
        ("shapefile", "Shapefile (zip)", "legacy"),
        ("csv", "CSV (WKT)", "tabular"),
        ("pmtiles", "PMTiles", "web map tiles"),
        ("kml", "KML/KMZ", "Google Earth")
    ];

    internal const string OpenDataMissingBindingMessage =
        "Configure Honua:Server:BaseUrl or HONUA_SERVER_BASE_URL so Console can read the server-owned "
        + "content metadata projection that drives the open-data page editor (Console Patterns Charter section 11).";

    private ConsoleContentDetail? _detail;
    private bool _detailMissingBinding;
    private string? _detailItemId;
    private IReadOnlyList<ShareExportRow> _exports = [];

    private bool _loading;
    private bool _busy;
    private bool _attempted;
    private string _tab = "link";
    private string? _itemIdInput;
    private DateTime? _expiresAtInput;

    // Client-side validation (item-id format + future-dated expiry) and unsaved-changes tracking. Share has no
    // server body-validator (catalog), so the findings are purely client-side and surfaced inline.
    private readonly ValidationState _validation = new();
    private readonly FormDirtyState _dirty = new();

    private ShareManageState BuildValidationState()
    {
        DateTimeOffset? expires = _expiresAtInput is { } local
            ? new DateTimeOffset(DateTime.SpecifyKind(local, DateTimeKind.Utc))
            : null;
        return new ShareManageState(_itemIdInput, expires, DateTimeOffset.UtcNow);
    }

    private void Revalidate() =>
        _validation.SetClientErrors(ShareManageValidator.Instance.Evaluate(BuildValidationState()));

    private void OnItemIdEdit()
    {
        _dirty.MarkDirty();
        Revalidate();
    }

    private void OnExpiresEdit()
    {
        _dirty.MarkDirty();
        Revalidate();
    }
    private ShareAccessView? _share;
    private ShareMintedSecret? _mintedSecret;
    private ShareDependencyClosureView? _blockedBy;
    private ShareDependencyClosureView? _lastClosure;
    private ShareCapabilityState? _bindingState;
    private ShareCapabilityState? _notFoundState;
    private IReadOnlyList<ShareCapabilityState> _commandStates = [];

    [SupplyParameterFromQuery(Name = "itemId")]
    public string? ItemId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(ItemId) && !_attempted)
        {
            _itemIdInput = ItemId;
            await LoadAsync(ItemId);
        }
    }

    private async Task OpenItem()
    {
        if (!string.IsNullOrWhiteSpace(_itemIdInput))
        {
            await LoadAsync(_itemIdInput);
        }
    }

    private async Task SetTab(string tab)
    {
        _tab = tab;
        if (string.Equals(tab, "opendata", StringComparison.Ordinal))
        {
            await EnsureDetailAsync();
        }
    }

    private async Task EnsureDetailAsync()
    {
        if (_share is not { } share || !share.OpenDataEligible)
        {
            return;
        }

        // Already loaded for the current item.
        if (string.Equals(_detailItemId, share.ItemId, StringComparison.Ordinal))
        {
            return;
        }

        _detail = null;
        _detailMissingBinding = false;
        _detailItemId = share.ItemId;

        if (Catalog is UnsupportedConsoleCatalogClient)
        {
            _detailMissingBinding = true;
            return;
        }

        var result = await Catalog.GetOpenDataItemAsync(share.ItemId);
        if (result.Status == CatalogReadStatus.Unavailable)
        {
            _detailMissingBinding = true;
        }
        else if (result.Status == CatalogReadStatus.Allowed && result.Item is not null)
        {
            _detail = result.Item;
        }
    }

    private string TabClass(string tab) =>
        string.Equals(tab, _tab, StringComparison.Ordinal) ? "active" : string.Empty;

    private async Task LoadAsync(string itemId)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _loading = true;
        _attempted = true;
        ResetTransient();
        try
        {
            var load = await ShareData.LoadAsync(itemId);
            _share = load.Share;
            ApplyStates(load.CapabilityStates);

            // A freshly loaded item is the clean baseline; recompute findings against the opened id.
            _dirty.MarkClean();
            Revalidate();

            // A newly loaded item invalidates any cached open-data detail; reload if the editor tab is open.
            _detail = null;
            _detailItemId = null;
            _detailMissingBinding = false;
            if (string.Equals(_tab, "opendata", StringComparison.Ordinal))
            {
                await EnsureDetailAsync();
            }
        }
        finally
        {
            _busy = false;
            _loading = false;
        }
    }

    private Task ChangeTier(string itemId, string tier) =>
        RunCommandAsync(() => ShareData.UpdateAccessTierAsync(itemId, tier, allowDependencyConflicts: false));

    private Task PreviewDependencies(string itemId, string tier) =>
        RunCommandAsync(() => ShareData.PreviewDependenciesAsync(itemId, tier));

    private async Task MintPublicLink(string itemId)
    {
        // Gate on the client-side future-date rule before issuing the mint; never fabricate server state.
        Revalidate();
        if (_validation.Errors(ShareManageFieldKeys.ExpiresAt).Any(e => e.IsBlocking))
        {
            return;
        }

        DateTimeOffset? expiresAt = _expiresAtInput is { } local
            ? new DateTimeOffset(DateTime.SpecifyKind(local, DateTimeKind.Utc))
            : null;
        await RunCommandAsync(() => ShareData.MintPublicLinkAsync(itemId, expiresAt));

        // A successful mint consumes the staged expiry; the form returns to a clean baseline.
        _dirty.MarkClean();
    }

    private Task RevokePublicLink(string itemId, string tokenId) =>
        RunCommandAsync(() => ShareData.RevokePublicLinkAsync(itemId, tokenId));

    private Task SetEmbed(string itemId, bool enabled, string? audience) =>
        RunCommandAsync(() => ShareData.SetEmbedAsync(itemId, enabled, audience, allowDependencyConflicts: false));

    private Task MintEmbedToken(string itemId, string audience) =>
        RunCommandAsync(() => ShareData.MintEmbedTokenAsync(itemId, audience, ttlSeconds: null));

    private async Task RunCommandAsync(Func<Task<ShareCommandResult>> command)
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        ResetTransient();
        try
        {
            var result = await command();
            if (result.Share is not null)
            {
                _share = result.Share;
            }

            _mintedSecret = result.MintedSecret;

            // A closure result (from a preview or a blocked change) is compatible => OK banner; incompatible
            // => blocking-dependency table. Both arrive on BlockedBy from the data source.
            if (result.BlockedBy is { } closure)
            {
                if (closure.IsCompatible)
                {
                    _lastClosure = closure;
                }
                else
                {
                    _blockedBy = closure;
                }
            }

            ApplyStates(result.CapabilityStates);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ApplyStates(IReadOnlyList<ShareCapabilityState> states)
    {
        _bindingState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Missing binding", StringComparison.OrdinalIgnoreCase));
        _notFoundState = states.FirstOrDefault(state =>
            string.Equals(state.State, "Unsupported", StringComparison.OrdinalIgnoreCase)
            && state.Detail.Contains("not found", StringComparison.OrdinalIgnoreCase));
        _commandStates = states
            .Where(state => !ReferenceEquals(state, _bindingState) && !ReferenceEquals(state, _notFoundState))
            .ToArray();
    }

    private void ResetTransient()
    {
        _mintedSecret = null;
        _blockedBy = null;
        _lastClosure = null;
        _bindingState = null;
        _notFoundState = null;
        _commandStates = [];
    }

    private static string TierLabel(string tier) => tier switch
    {
        HonuaConsoleShareAccessTiers.Private => "Private",
        HonuaConsoleShareAccessTiers.Organization => "Organization",
        HonuaConsoleShareAccessTiers.PublicLink => "Public link",
        HonuaConsoleShareAccessTiers.PublicIndexed => "Public indexed",
        _ => tier
    };

    private static string SlugOrId(ConsoleContentSummary summary) =>
        string.IsNullOrWhiteSpace(summary.Slug) ? summary.Id : summary.Slug;

    private static bool IsFormatPublished(ConsoleContentSummary summary, string formatKey) =>
        summary.Formats.Any(format =>
            format.Replace(" ", string.Empty, StringComparison.Ordinal)
                .Replace("(", string.Empty, StringComparison.Ordinal)
                .Replace(")", string.Empty, StringComparison.Ordinal)
                .StartsWith(formatKey, StringComparison.OrdinalIgnoreCase)
            || format.Contains(formatKey, StringComparison.OrdinalIgnoreCase));

    private static string LicenseFor(ConsoleContentDetail detail) =>
        MetadataValue(detail, "license", "License") ?? "Not specified";

    private static string ContactFor(ConsoleContentDetail detail) =>
        MetadataValue(detail, "contact", "Contact") ?? "Not specified";

    private static string AttributionFor(ConsoleContentDetail detail, ConsoleContentSummary summary) =>
        MetadataValue(detail, "attribution", "Rights", "Attribution") ?? (string.IsNullOrWhiteSpace(summary.Owner) ? "Not specified" : summary.Owner);

    // License/contact/attribution live in the server-owned content metadata. They are surfaced through the
    // content bindings projection when present; otherwise the editor shows "Not specified" rather than
    // inventing values.
    private static string? MetadataValue(ConsoleContentDetail detail, params string[] keys)
    {
        foreach (var key in keys)
        {
            var match = detail.Bindings.FirstOrDefault(binding =>
                string.Equals(binding.Name, key, StringComparison.OrdinalIgnoreCase)
                || string.Equals(binding.Kind, key, StringComparison.OrdinalIgnoreCase));
            if (match is not null && !string.IsNullOrWhiteSpace(match.Target))
            {
                return match.Target;
            }
        }

        return null;
    }

    private static string StateClass(string state) => state switch
    {
        "success" => "console-state-success",
        "slow" or "warn" => "console-status-warning",
        "failed" => "console-state-danger",
        _ => "console-state-neutral"
    };

    private static string StateLabel(string state) => state switch
    {
        "success" => "success",
        "slow" => "slow",
        "warn" => "warning",
        "failed" => "failed",
        _ => state
    };

    /// <summary>
    /// A scheduled-export row projected from honua-server's export registry. The merged runtime carries no
    /// standing export rows; this list is populated only from a bound server contract (Console Patterns
    /// Charter section 11).
    /// </summary>
    private sealed record ShareExportRow(
        string Id,
        string Name,
        string Target,
        string TargetKind,
        string Format,
        string Filter,
        string Schedule,
        string LastRun,
        string State);
}
