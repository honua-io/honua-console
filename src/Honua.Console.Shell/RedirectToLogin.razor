@inject NavigationManager Navigation
@inject IServiceProvider Services

@code {
    protected override void OnInitialized()
    {
        if (Services.GetService<IConsoleBrowserAuthentication>() is not null)
        {
            var route = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
            Navigation.NavigateTo(Navigation.ToConsoleHref($"/auth/signin?returnTo={Uri.EscapeDataString(route)}"));
            return;
        }
        var returnTo = Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery);
        Navigation.NavigateTo($"/auth/login?returnTo={returnTo}", forceLoad: true);
    }
}
