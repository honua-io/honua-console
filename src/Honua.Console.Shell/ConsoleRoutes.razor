@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

@* Fail-closed routing: every page requires a signed-in operator through Pages/_Imports.razor unless it
   declares [AllowAnonymous]. AuthorizeRouteView refuses anonymous access before a page is created, and
   the layout shows no menu or inventory without a session. A server host's fallback policy, where one
   exists, is a second gate in front of this one. *@
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(ConsoleRoutes).Assembly" NotFoundPage="@typeof(NotFoundPage)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(ConsoleLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <p role="status">Authorizing…</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
