@using Honua.Console.Web.Runtime
@inject NavigationManager Navigation

<ErrorBoundary>
    <ChildContent>
        <ConsoleTheme />
        <Routes />
        @if (!ConsoleEmbedRoutes.IsEmbed(Navigation))
        {
            <Honua.Console.Shell.Layout.ConsoleConversationDrawer />
        }
    </ChildContent>
    <ErrorContent>
        <main role="alert">
            <h1>Console could not load</h1>
            <p>Check the API connection and your sign-in session, then reload.</p>
            <a href=".">Reload Console</a>
        </main>
    </ErrorContent>
</ErrorBoundary>
