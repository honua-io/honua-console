<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Honua.Console.Shell/honua-console.css"]" />
    @* No Honua.Console.Web.styles.css link: the host project has no scoped component CSS (.razor.css),
       so that bundle is never emitted and linking it 404s on every page. All real styling lives in
       honua-console.css above. Re-add the bundle link if a scoped *.razor.css is ever introduced. *@
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    @* Visible reconnect/error banner. app.css previously hid #blazor-error-ui outright, so a dropped
       circuit silently froze the page with no feedback. The markup is restored here and styled (visible,
       fixed to the bottom) in honua-console.css so a lost connection / unhandled error is surfaced with a
       reload affordance. *@
    <div id="blazor-error-ui" data-nosnippet>
        <span class="blazor-error-ui-text">The connection to Honua Console was interrupted.</span>
        <a href="." class="reload">Reload</a>
        <button type="button"
                class="dismiss"
                data-blazor-error-dismiss
                aria-label="Dismiss connection error">
            🗙
        </button>
    </div>

    <script src="@Assets["_content/Honua.Console.Shell/console-accessibility.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        // In-page section navigation: Blazor's interactive router intercepts same-page
        // "#id" links and does not scroll to the fragment, so handle pure-fragment anchors
        // here. Only acts when a matching element exists; otherwise leaves the link alone.
        // Capture phase so this runs before Blazor's delegated router handler.
        document.addEventListener('click', function (e) {
            var anchor = e.target.closest && e.target.closest('a[href^="#"]');
            if (!anchor) { return; }
            var id = anchor.getAttribute('href').slice(1);
            if (!id) { return; }
            var target = document.getElementById(id);
            if (target) {
                e.preventDefault();
                e.stopPropagation();
                var reduceMotion = window.matchMedia &&
                    window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
                if (history.replaceState) { history.replaceState(null, '', '#' + id); }
            }
        }, true);
    </script>
</body>

</html>
