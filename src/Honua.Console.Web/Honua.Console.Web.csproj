<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Honua.Console.Shell\Honua.Console.Shell.csproj" />
  </ItemGroup>

  <!-- OpenTelemetry (honua-console#279 PA-234): distributed traces + metrics for the console web host.
       AspNetCore + HttpClient instrumentation, exported over OTLP. Default-safe: with no
       OTEL_EXPORTER_OTLP_ENDPOINT configured no exporter is wired and the SDK is a no-op. Versions
       align with honua-server's ServiceDefaults. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Honua.Console.IntegrationTests" />
  </ItemGroup>

  <!-- Cesium is intentionally gitignored, but every supported Web build path must still produce a
       complete same-origin 3D runtime. The script verifies an existing tree and fetches it when a
       checkout has not populated it yet. Keeping this target here covers dotnet run, build, and
       publish without making the large runtime part of the repository. -->
  <Target Name="FetchCesiumAssets" BeforeTargets="Build;Publish">
    <Exec Command="node &quot;scripts/fetch-cesium.mjs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>

</Project>
