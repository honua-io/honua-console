# Honua Console environment configuration.
#
# All variables are read at build time via import.meta.env. Copy this file to
# .env.local for development and override per deployment environment otherwise.

# Base URL of the operator-facing admin app. The "Open admin" link surfaces in
# the user menu only for users whose session reports an operator/admin scope.
# When unset the link is hidden even for operators.
VITE_ADMIN_BASE_URL=https://admin.honua.example

# Default session driver. "fixture" returns a deterministic session for local
# development and smoke tests. "whoami" issues a real probe to the configured
# server endpoint.
VITE_SESSION_DRIVER=fixture

# Inline JSON session payload consumed by the fixture driver. When unset the
# fixture driver starts unauthenticated. Useful for previewing operator vs
# member nav variants without standing up an auth server. The payload must
# include "status":"authenticated"; payloads without it are ignored.
# VITE_FAKE_SESSION={"status":"authenticated","user":{"id":"u-1","displayName":"Demo User","email":"demo@example.com"},"workspace":{"id":"w-1","name":"Demo Workspace"},"scopes":["member"]}

# Endpoint hit by the whoami driver to hydrate the session.
VITE_WHOAMI_URL=/api/console/whoami

# Base URL for server-backed Console API clients. The legacy Portal API base is
# preserved during the transition; tooling MAY override this per deployment.
VITE_CONSOLE_API_BASE_URL=/api/v1/portal
